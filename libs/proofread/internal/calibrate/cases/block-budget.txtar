A rule block whose comments, summed, outrun its size.
-- hit/stylesheet whole --
/* The tile frame, drawn once for every app.
   Each app mounts it as a pane. */
.tile {
  /* The ring is drawn inside the box. */
  outline-offset: -2px;
  /* The grid keeps the header and body apart. */
  display: grid;
  /* A gap rather than a margin, so wrapping stays even. */
  gap: 1rem;
  /* Padding comes from the spacer scale. */
  padding: 1rem;
  /* Inherit the pane's colour. */
  /* Nothing here sets a width. */
  color: inherit;
}
-- pass/stylesheet whole --
.tile {
  /* The ring is drawn inside the box, so a neighbour never clips it. */
  outline-offset: -2px;
  display: grid;
  gap: 1rem;
  padding: 1rem;
  margin: 0;
  color: inherit;
}
