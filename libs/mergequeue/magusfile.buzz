// magusfile.buzz for mergequeue, the speculative, partitioned merge queue at
// libs/mergequeue that `magus queue` runs. It is a package tree of the magus module and
// no module of its own: magus ships as one binary that holds what it needs, so the
// queue is compiled in the way gopherbuzz is. The root package takes magus's version
// control capability interfaces as they are; the client package wires in the backend
// and, through the Go SDK, the affected sets and declared outputs; cmd/magus/queue.go
// is the command.
//
//   magus run lint libs/mergequeue    go vet
//   magus run test libs/mergequeue    the Go suite, which also runs the Buzz provider's
//                                     test blocks through gopherbuzz
//   magus run ci libs/mergequeue      lint, build, and test
//
// Like libs/pricing, no go.mod: it earns its project status with a magusfile, so its
// own suite runs when it is affected.

import "magus";

// go spell claims **/*.go. This file's own export-fun targets need no declaration:
// magus binds the magusfile driver to every project.
import "magus/spell/go";

import "fs";
import "proc";

magus\project({
    "spells": [go],
    // The GitHub provider is Buzz, compiled in with go:embed and run by the Go tests, so
    // it keys build and test like any Go source. No spell claims .buzz. The fuzz seeds
    // are inputs of the suite that runs them.
    "sources": ["provider/*.buzz", "testdata/fuzz/**", ".mockery.yaml"],
    // MAGUS.md is declared per-target on index_generate, not here: see the root magusfile.
    "targets": {
        // Regenerates MAGUS.md, which the engine drift-gates as a declared output.
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
        // index-generate renders `magus describe graph -o markdown`, a function of the
        // WHOLE knowledge graph, which no input glob can key. Every other library carries
        // the same opt-out.
        "index-generate": {"skip_cache": "output derives from the entire knowledge graph, which no input glob can key"},
    },
});

export fun preflight(ctx: magus\Context, args: [str]) > void {}

// Regenerates the mocks and MAGUS.md and fails on drift. Use the rw charm to keep the
// result.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(preflight);
    ctx.needs(mocks_generate, index_generate);
}

// Regenerates the testify mocks of the queue's contract (.mockery.yaml) into
// types/gen/mocks. The root's mocks_generate cannot write them: its globs stop at this
// project's directory, and writing here from there is a cross-project write.
export fun mocks_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("types/gen/mocks/*.go");
    proc\exec("go", ["tool", "mockery"]);
    // The assertions that each mock still satisfies its interface, as the root writes
    // for its own mocks. mockassert resolves package paths from the module root.
    proc\exec("go", ["run", "./cmd/magus-utils", "mockassert", "--config", "libs/mergequeue/.mockery.yaml"], "../..");
}

// Renders MAGUS.md (target catalog plus graph) from this magusfile.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    // Declared so `magus vcs resolve` can find the target that settles a conflict here.
    ctx.writesFiles("MAGUS.md");
    // A routing change anywhere rewrites the originating project's index, so a sibling
    // MAGUS.md moving is the keyable signal; see libs/coldread for the full reasoning.
    ctx.readsFiles("../../**/MAGUS.md");
    final doc = magus\describe(["graph", "-o", "markdown"], {"quiet": true}).stdout;
    fs\writeFile("MAGUS.md", doc + "\n");
}

// No go-mod-tidy: this package has no go.mod, so tidy here would rewrite the ROOT
// module's from a descendant project, the cross-project write magus rejects as MGS3001.
export fun format(ctx: magus\Context, args: [str]) > void {
    // Not writesFiles: gofmt amends authored code rather than producing it.
    ctx.modifiesExistingFiles("**/*.go");
    ctx.needs(generate);
    go["go-fmt"](ctx);
}

// go vet only. golangci-lint runs over the whole root module from the root project,
// which already reaches this package.
export fun lint(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-vet"](ctx); }
export fun build(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-build"](ctx); }

// No coverage profile: this package is part of the root module, so the root's `go test
// ./...` already records it in coverage.out.
export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    go["go-test"](ctx, {"args": ["./..."]});
}

// The anchor `magus affected ci` keys off; fans out lint/build/test after format.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, build, test);
}
