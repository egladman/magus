// magusfile.buzz for mergequeue, a standalone Go module
// (github.com/egladman/magus/libs/mergequeue) at libs/mergequeue: a speculative,
// partitioned merge queue with its own CLI. Its own module, and nothing in the magus
// module imports it, because a queue owns checkouts (staging commits, landing) and magus
// never does; magus only supplies it facts through `magus affected ... --plan`.
//
//   magus run build libs/mergequeue   compile the library and cmd/mergequeue
//   magus run test libs/mergequeue    run the Go suite, which also runs the Buzz
//                                     provider's test blocks through gopherbuzz
//   magus run ci libs/mergequeue      lint, build, and test

import "magus";

// go spell claims **/*.go and the module files. This file's own export-fun targets
// need no declaration: magus binds the magusfile driver to every project.
import "magus/spell/go";
import "../../spells/golang/gomod" as gomod;

import "fs";

magus\project({
    "spells": [go],
    // The GitHub provider is Buzz, compiled in with go:embed and run by the Go tests, so
    // it keys build and test like any Go source. No spell claims .buzz.
    "sources": ["provider/*.buzz"],
    // MAGUS.md is declared per-target on index_generate, not here: see the root magusfile.
    "targets": {
        // Regenerates MAGUS.md, which the engine drift-gates as a declared output.
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
        // index-generate renders `magus describe graph -o markdown`, a function of the
        // WHOLE knowledge graph, which no input glob can key. Every other library carries
        // the same opt-out.
        "index-generate": {"skip_cache": "output derives from the entire knowledge graph, which no input glob can key"},
    },
});

export fun preflight(ctx: magus\Context, args: [str]) > void {}

// Regenerates MAGUS.md and fails on drift. Use the rw charm to keep the result.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(preflight);
    gomod\replaceWorkspaceModules(ctx, go, "libs/mergequeue");
    ctx.needs(index_generate);
}

// Renders MAGUS.md (target catalog plus graph) from this magusfile.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    // Declared so `magus vcs resolve` can find the target that settles a conflict here.
    ctx.writesFiles("MAGUS.md");
    // A routing change anywhere rewrites the originating project's index, so a sibling
    // MAGUS.md moving is the keyable signal; see libs/coldread for the full reasoning.
    ctx.readsFiles("../../**/MAGUS.md");
    final doc = magus\describe(["graph", "-o", "markdown"], {"quiet": true}).stdout;
    fs\writeFile("MAGUS.md", doc + "\n");
}

export fun format(ctx: magus\Context, args: [str]) > void { ctx.needs(generate); go["go-fmt"](ctx); go["go-mod-tidy"](ctx); }
export fun lint(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-vet"](ctx); }
export fun build(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-build"](ctx); }
// The profile is a declared output: the root's coverage badge is one figure over every
// Go module, merged from each module's own run rather than re-measured.
export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    ctx.writesFiles("coverage.out");
    go["go-test"](ctx, {"args": ["-covermode=atomic", "-coverprofile=coverage.out", "./..."]});
}

// The anchor `magus affected ci` keys off; fans out lint/build/test after format.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, build, test);
}
