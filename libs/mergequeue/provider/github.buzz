// GitHub provider for the merge queue: `mergequeue --provider github`. It carries the
// provider contract (see the provider package): describe, list_changes, approval_at,
// list_green, post_status, retarget, merge_change, kick_back and list_artifacts. The
// queue decides what to validate and merge; this file only speaks GitHub's REST and
// GraphQL APIs.
//
// # Merge intent
//
// A pull request is queued when its author (or a maintainer) enables GitHub's native
// auto-merge, and merges with the method chosen there. GitHub offers no auto-merge on a
// stacked pull request, so a stack is queued by the label "queue: <method>" (squash,
// merge or rebase) on its top pull request, applied by someone with write access; that
// queues every pull request of the stack, bottom first. Kicking a change back disables
// its auto-merge or removes the label from its stack's top, so queuing it again is how
// a fixed change re-enters.
//
// # Credentials
//
// Two environment variables. The reads (describe, list_changes, approval_at,
// list_artifacts) use MERGEQUEUE_TOKEN when the environment carries it, else
// GITHUB_TOKEN: the validation side runs pull-request code and holds only a read-only
// Actions token. The writes use MERGEQUEUE_TOKEN and nothing else, so a job that does
// not hold the write credential cannot write by accident. It needs contents, pull
// requests and commit statuses write; the apply job's own Actions token is enough, and
// no bypass of any rule is needed.
//
// # Who merges
//
// The queue posts success on its required status right before a merge. For a pull
// request with auto-merge on, GitHub then merges it on behalf of whoever enabled
// auto-merge, which starts the base branch's workflows; merge_change waits for that and
// reports it (by_provider). Only when GitHub has not merged it in time does
// merge_change merge it through the API itself, with the job's token, whose merges start
// no workflow, so the caller dispatches the base branch's runs then. A stack, queued by
// label with no auto-merge, is always merged by merge_change, which is not yet verified
// on a real repository.
//
// # Listings
//
// Every listing pages to completion or fails: a cut listing would read as fewer pull
// requests, fewer merged changes or a stale labeler, each a wrong fact the queue would
// act on.
//
// # What is NOT verified here
//
// The pure halves (reading pull requests, stacks, approvals, rulesets, merged changes,
// run artifacts, the merge payload) are tested at the bottom, run by the provider
// package's Go tests. The HTTP calls are not: verifying them means merging a real pull
// request.

import "assert";
import "os";
import "serialize";
import "std";
import "mergequeue";

final DEFAULT_API = "https://api.github.com";
final API_ENV = "GITHUB_API_URL";
final READ_REF = "GITHUB_TOKEN";
final WRITE_REF = "MERGEQUEUE_TOKEN";
// The label on a stack's top pull request that queues the stack, followed by a method.
final QUEUE_LABEL = "queue: ";
// Who commits what the queue pushes to a pull request's branch: the Actions bot.
final COMMITTER = {"name": "github-actions[bot]", "email": "41898282+github-actions[bot]@users.noreply.github.com"};
// Roles whose label queues a stack: the ones that can enable auto-merge.
final QUEUE_ROLES = ["admin", "maintain", "write"];
// How many pages of an issue timeline the labeler check reads before it gives up and
// treats the label as unproven.
final TIMELINE_PAGES = 30;
// How long merge_change waits for an asynchronous stack merge to finish.
final ASYNC_POLLS = 60;
final ASYNC_POLL_MS = 5000.0;
// How long merge_change waits for GitHub's auto-merge to merge a pull request whose
// status just went green before merging it itself: 12 reads of the pull request, each
// one request against the job token's hourly limit.
final AUTO_MERGE_POLLS = 12;
final AUTO_MERGE_POLL_MS = 5000.0;

fun getenv(name: str) > str {
    final v = os\env(name);
    return v ?? "";
}

fun apiBase() > str {
    var base = getenv(API_ENV);
    if (base == "") {
        return DEFAULT_API;
    }
    while (base.endsWith("/")) {
        base = base.sub(0, len: base.len() - 1);
    }
    return base;
}

fun apiHost(base: str) > str {
    var h = base;
    if (h.startsWith("https://")) {
        h = h.sub(8);
    } else if (h.startsWith("http://")) {
        h = h.sub(7);
    }
    final cut = h.indexOf("/");
    if (cut != null) {
        h = h.sub(0, len: cut ?? 0);
    }
    if (h.startsWith("api.")) {
        h = h.sub(4);
    }
    return h;
}

fun slug(remote: str, host: str) > str {
    var s = remote;
    if (s.startsWith("git@" + host + ":")) {
        s = s.sub(("git@" + host + ":").len());
    } else if (s.startsWith("https://" + host + "/")) {
        s = s.sub(("https://" + host + "/").len());
    } else if (s.startsWith("ssh://git@" + host + "/")) {
        s = s.sub(("ssh://git@" + host + "/").len());
    } else {
        return "";
    }
    if (s.endsWith(".git")) {
        s = s.sub(0, len: s.len() - 4);
    }
    final parts = s.split("/");
    if (parts.len() != 2 or parts[0] == "" or parts[1] == "") {
        return "";
    }
    return parts[0] + "/" + parts[1];
}

fun repoOf(io: {str: any}) > str !> any {
    final remote = "{io["remote_url"] ?? ""}";
    final repo = slug(remote, host: apiHost(apiBase()));
    if (repo == "") {
        throw "github: the remote '{remote}' is not a {apiHost(apiBase())} repository";
    }
    return repo;
}

// escape percent-encodes s for a URL path segment or query value.
fun escape(s: str) > str {
    final hex = s.hex();
    var encoded = "";
    var i = 0;
    while (i < s.len()) {
        final b = s.byte(i);
        if ((b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 45 or b == 46 or b == 95 or b == 126) {
            encoded = encoded + s.sub(i, len: 1);
        } else {
            encoded = encoded + "%" + hex.sub(2 * i, len: 2);
        }
        i = i + 1;
    }
    return encoded;
}

// readRef prefers the write credential where the job holds it, so apply reads with the
// token it merges with.
fun readRef() > str {
    if (getenv(WRITE_REF) != "") {
        return WRITE_REF;
    }
    return READ_REF;
}

fun headers(ref: str) > {str: str} {
    return {
        "Authorization": "Bearer " + getenv(ref),
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    };
}

// reading and writing fail with the variable's name when the credential is missing, and
// return the headers to call with.
fun reading(op: str) > {str: str} !> any {
    final ref = readRef();
    if (getenv(ref) == "") {
        throw "github: {op} needs {READ_REF} or {WRITE_REF}, and neither is set";
    }
    return headers(ref);
}

fun writing(op: str) > {str: str} !> any {
    if (getenv(WRITE_REF) == "") {
        throw "github: {op} writes, and needs {WRITE_REF}, the apply job's credential; it is not set";
    }
    return headers(WRITE_REF);
}

fun get(url: str, hdrs: {str: str}) > {str: any} !> any {
    return mergequeue\request("GET", url: url, body: "", headers: hdrs);
}

fun post(url: str, body: str, hdrs: {str: str}) > {str: any} !> any {
    return mergequeue\request("POST", url: url, body: body, headers: hdrs);
}

fun expect(res: {str: any}, status: int, what: str) > str !> any {
    if (res["status"] != status) {
        throw "github: {what}: HTTP {res["status"]}: {res["body"]}";
    }
    return "{res["body"]}";
}

// graphqlURL derives the GraphQL endpoint from the REST one: github.com serves it beside
// the REST root, an Enterprise appliance at /api/graphql beside /api/v3.
fun graphqlURL(base: str) > str {
    if (base.endsWith("/api/v3")) {
        return base.sub(0, len: base.len() - 2) + "graphql";
    }
    return base + "/graphql";
}

fun graphql(query: str, variables: any, hdrs: {str: str}) > str !> any {
    final body = expect(post(graphqlURL(apiBase()), body: serialize\jsonEncode({"query": query, "variables": variables}), hdrs: hdrs), status: 200, what: "GraphQL");
    final errs = serialize\jsonDecode(body).q("errors").listValue();
    if (errs.len() > 0) {
        throw "github: GraphQL: {errs[0].q("message").stringValue()}";
    }
    return body;
}

// pages reads a paged REST listing to its end: GitHub signals the end with a short page.
fun pages(url: str, what: str, hdrs: {str: str}) > [str] !> any {
    final bodies = mut [<str>];
    var page = 1;
    while (true) {
        final body = expect(get(url + "&per_page=100&page={page}", hdrs: hdrs), status: 200, what: what);
        bodies.append(body);
        if (serialize\jsonDecode(body).listValue().len() < 100) {
            break;
        }
        page = page + 1;
    }
    return bodies;
}

// describeFrom reads the merge methods a repository allows, narrowed by every active
// ruleset rule the base branch's rules carry: a "pull_request" rule's
// allowed_merge_methods intersects the settings, and a "required_linear_history" rule
// rules out "merge". GitHub merges a stack in one call and needs each stacked branch
// linear on the one below.
//
// GitHub sends the allow_* settings only to a token with push access, so a read-only
// token's describe starts from every method and needs a ruleset to name the allowed ones.
fun describeFrom(body: str, rules: str, setup: any) > any !> any {
    final r = serialize\jsonDecode(body);
    final settingsKnown = r.q("allow_squash_merge").boolean() != null;
    var methods = mut [<str>];
    if (!settingsKnown or r.q("allow_merge_commit").booleanValue()) {
        methods.append("merge");
    }
    if (!settingsKnown or r.q("allow_squash_merge").booleanValue()) {
        methods.append("squash");
    }
    if (!settingsKnown or r.q("allow_rebase_merge").booleanValue()) {
        methods.append("rebase");
    }
    var named = false;
    var linear = false;
    foreach (rule in serialize\jsonDecode(rules).listValue()) {
        final kind = rule.q("type").stringValue();
        if (kind == "required_linear_history") {
            linear = true;
        } else if (kind == "pull_request") {
            final allowed = rule.q("parameters").q("allowed_merge_methods").listValue();
            if (allowed.len() > 0) {
                named = true;
                final names = mut [<str>];
                foreach (m in allowed) {
                    names.append(m.stringValue().lower());
                }
                final kept = mut [<str>];
                foreach (m in methods) {
                    if (names.indexOf(m) != null) {
                        kept.append(m);
                    }
                }
                methods = kept;
            }
        }
    }
    if (linear) {
        final kept = mut [<str>];
        foreach (m in methods) {
            if (m != "merge") {
                kept.append(m);
            }
        }
        methods = kept;
    }
    if (!settingsKnown and !named) {
        throw "github: describe: the token cannot read the repository's merge settings (they need push access), and no ruleset on the base branch names the allowed merge methods";
    }
    if (methods.len() == 0) {
        throw "github: describe: the repository settings and its rulesets on the base branch allow no merge method in common";
    }
    return {"stack_merge": "atomic", "linear_stacks": true, "methods": methods, "queue_label": QUEUE_LABEL, "committer": COMMITTER, "setup": setup};
}

// describe reads the setup only when asked for a status context: planning asks for none,
// and its token reads nothing more than it needs. The steps cost three more reads, one
// of them needing checks read, which the apply job's token does not hold.
export fun describe(io: {str: any}) > any !> any {
    final hdrs = reading("describe");
    final repo = repoOf(io);
    final body = expect(get(apiBase() + "/repos/" + repo, hdrs: hdrs), status: 200, what: "describe {repo}");
    final base = "{io["base"] ?? ""}";
    final rules = readFor(apiBase() + "/repos/" + repo + "/rules/branches/" + escape(base), what: "read the rules on {base}",
        needs: "metadata read on {repo}", hdrs: hdrs);
    final context = "{io["status_context"] ?? ""}";
    if (context == "") {
        return describeFrom(body, rules: rules, setup: null);
    }
    final branch = readFor(apiBase() + "/repos/" + repo + "/branches/" + escape(base), what: "read the protection of {base}",
        needs: "contents read on {repo}", hdrs: hdrs);
    final slug = "{io["app"] ?? ""}";
    var app = {<str: str>};
    if (slug != "") {
        app = appFrom(readFor(apiBase() + "/apps/" + escape(slug), what: "read the app {slug}",
            needs: "to see the app: a private app is visible only to a token of its owner or of one of its installations", hdrs: hdrs));
    }
    final steps = "{io["setup_steps"] ?? false}" == "true";
    var reports = [<{str: str}>];
    var rulesets = {<str: str>};
    if (steps) {
        final checks = requiredChecksFrom(rules, branch: branch);
        reports = reportsOn(repo, base: base, wanted: checks, hdrs: hdrs);
        rulesets = rulesetNames(repo, checks: checks, hdrs: hdrs);
    }
    final at = {"repo": repo, "base": base, "context": context, "web": "https://" + apiHost(apiBase())};
    return describeFrom(body, rules: rules, setup: setupFrom(at, repoBody: body, checks: requiredChecksFrom(rules, branch: branch),
        reports: reports, rulesets: rulesets, app: app, steps: steps));
}

// The app GITHUB_TOKEN belongs to: GitHub counts a status it posts as integration 15368's.
final ACTIONS_APP = {"id": "15368", "name": "GitHub Actions"};
// Where queue-apply.yaml reads the queue app's credential from, which setup-magus's
// queue-app-client-id and queue-app-private-key inputs take.
final APP_ENVIRONMENT = "magus-queue";
final APP_VARIABLE = "MAGUS_QUEUE_APP_CLIENT_ID";
final APP_SECRET = "MAGUS_QUEUE_APP_PRIVATE_KEY";
// The queue app's permissions, as the registration URL names them: merge, push update
// commits, post the status, follow validation runs, and merge changes to workflow files.
final APP_PERMISSIONS = "contents=write&pull_requests=write&statuses=write&actions=write&workflows=write";
// The ruleset the printed setup creates. describe updates it in place only while it
// still holds nothing but the queue's own rule.
final RULESET_NAME = "magus merge queue";

// readFor reads url for describe's setup. A 403 or 404 names the permission the read
// needs: a token without it reads the same as a missing resource.
fun readFor(url: str, what: str, needs: str, hdrs: {str: str}) > str !> any {
    final res = get(url, hdrs: hdrs);
    if (res["status"] == 403 or res["status"] == 404) {
        throw "github: {what}: HTTP {res["status"]}: either it does not exist or the token lacks {needs}: {res["body"]}";
    }
    return expect(res, status: 200, what: what);
}

// appFrom reads an app's integration id, client id and name.
fun appFrom(body: str) > {str: str} !> any {
    final a = serialize\jsonDecode(body);
    return {"slug": a.q("slug").stringValue(), "id": id(a.q("id")), "client_id": a.q("client_id").stringValue(), "name": a.q("name").stringValue()};
}

// requiredChecksFrom reads the checks the base requires from its rulesets (rules, which
// name the ruleset each came from) and its classic branch protection (branch), once per
// context, integration and ruleset: each ruleset holding the queue's context needs its
// own pin. An integration of "" accepts a status from anyone.
fun requiredChecksFrom(rules: str, branch: str) > [{str: str}] !> any {
    final seen = mut {<str: bool>};
    final checks = mut [<{str: str}>];
    foreach (rule in serialize\jsonDecode(rules).listValue()) {
        if (rule.q("type").stringValue() != "required_status_checks") {
            continue;
        }
        foreach (c in rule.q("parameters").q("required_status_checks").listValue()) {
            final check = {"context": c.q("context").stringValue(), "integration": id(c.q("integration_id")), "ruleset": id(rule.q("ruleset_id"))};
            final key = "{check["context"] ?? ""} {check["integration"] ?? ""} {check["ruleset"] ?? ""}";
            if (seen[key] == null) {
                seen[key] = true;
                checks.append(check);
            }
        }
    }
    final classic = serialize\jsonDecode(branch).q("protection").q("required_status_checks");
    final pinned = classic.q("checks").listValue();
    foreach (c in pinned) {
        var integration = id(c.q("app_id"));
        if (integration == "-1") {
            integration = "";
        }
        final key = "{c.q("context").stringValue()} {integration} ";
        if (seen[key] == null) {
            seen[key] = true;
            checks.append({"context": c.q("context").stringValue(), "integration": integration, "ruleset": ""});
        }
    }
    if (pinned.len() == 0) {
        foreach (c in classic.q("contexts").listValue()) {
            final key = "{c.stringValue()}  ";
            if (seen[key] == null) {
                seen[key] = true;
                checks.append({"context": c.stringValue(), "integration": "", "ruleset": ""});
            }
        }
    }
    return checks;
}

// reportsFrom pairs each check run on a commit with the event of the workflow run that
// reported it. A check run another app reports belongs to no workflow run and is left out.
fun reportsFrom(checkRuns: str, runs: str) > [{str: str}] !> any {
    final suites = mut {<str: str>};
    foreach (r in serialize\jsonDecode(runs).q("workflow_runs").listValue()) {
        suites[id(r.q("check_suite_id"))] = r.q("event").stringValue();
    }
    final seen = mut {<str: bool>};
    final reports = mut [<{str: str}>];
    foreach (c in serialize\jsonDecode(checkRuns).q("check_runs").listValue()) {
        final event = suites[id(c.q("check_suite").q("id"))] ?? "";
        final name = c.q("name").stringValue();
        if (event != "" and seen[name + " " + event] == null) {
            seen[name + " " + event] = true;
            reports.append({"name": name, "event": event});
        }
    }
    return reports;
}

// SAMPLED_HEADS bounds how many recent pull request heads describe reads the checks of
// before it settles for having seen none: a head pushed a moment ago has no runs yet.
final SAMPLED_HEADS = 5;

// sampleHeads lists the heads of the most recently updated pull requests from this
// repository into base, newest first: their checks are the ones a pull request here
// reports. A fork's runs are the fork's.
fun sampleHeads(body: str, repo: str) > [str] !> any {
    final heads = mut [<str>];
    foreach (pr in serialize\jsonDecode(body).listValue()) {
        if (pr.q("head").q("repo").q("full_name").stringValue() == repo and heads.len() < SAMPLED_HEADS) {
            heads.append(pr.q("head").q("sha").stringValue());
        }
    }
    return heads;
}

// reportsOn reads which events report which checks on the newest pull request head that
// carries one of the required checks (wanted), else on the newest that carries any: a
// head whose runs have not finished carries only some of them.
fun reportsOn(repo: str, base: str, wanted: [{str: str}], hdrs: {str: str}) > [{str: str}] !> any {
    final prefix = apiBase() + "/repos/" + repo;
    final heads = sampleHeads(readFor(prefix + "/pulls?state=all&base=" + escape(base) + "&sort=updated&direction=desc&per_page=20",
        what: "list pull requests into {base}", needs: "pull requests read on {repo}", hdrs: hdrs), repo: repo);
    var chosen = "";
    var chosenRuns = "";
    foreach (head in heads) {
        final checkRuns = readFor(prefix + "/commits/" + head + "/check-runs?per_page=100", what: "list the checks on {head}",
            needs: "checks read on {repo}", hdrs: hdrs);
        final carries = carriesRequired(checkRuns, wanted: wanted);
        if (carries or (chosen == "" and serialize\jsonDecode(checkRuns).q("check_runs").listValue().len() > 0)) {
            chosen = head;
            chosenRuns = checkRuns;
        }
        if (carries) {
            break;
        }
    }
    if (chosen == "") {
        return [<{str: str}>];
    }
    final runs = readFor(prefix + "/actions/runs?head_sha=" + chosen + "&per_page=100", what: "list the workflow runs on {chosen}",
        needs: "actions read on {repo}", hdrs: hdrs);
    return reportsFrom(chosenRuns, runs: runs);
}

// carriesRequired reports whether a commit's check runs include one of the required checks.
fun carriesRequired(checkRuns: str, wanted: [{str: str}]) > bool !> any {
    foreach (c in serialize\jsonDecode(checkRuns).q("check_runs").listValue()) {
        foreach (w in wanted) {
            if (c.q("name").stringValue() == (w["context"] ?? "")) {
                return true;
            }
        }
    }
    return false;
}

// rulesetNames maps each ruleset a required check comes from to its name, and "" when it
// holds anything beyond one required-status-checks rule of one check.
fun rulesetNames(repo: str, checks: [{str: str}], hdrs: {str: str}) > {str: str} !> any {
    final names = mut {<str: str>};
    foreach (c in checks) {
        final ruleset = c["ruleset"] ?? "";
        if (ruleset != "" and names[ruleset] == null) {
            names[ruleset] = ownRuleset(readFor(apiBase() + "/repos/" + repo + "/rulesets/" + ruleset, what: "read ruleset {ruleset}",
                needs: "metadata read on {repo}", hdrs: hdrs));
        }
    }
    return names;
}

// ownRuleset returns the ruleset's name when it holds only the queue's rule, else "".
fun ownRuleset(body: str) > str !> any {
    final r = serialize\jsonDecode(body);
    final rules = r.q("rules").listValue();
    if (rules.len() != 1 or rules[0].q("type").stringValue() != "required_status_checks"
        or rules[0].q("parameters").q("required_status_checks").listValue().len() != 1) {
        return "";
    }
    return r.q("name").stringValue();
}

fun eventsOf(reports: [{str: str}], context: str) > [str] {
    final events = mut [<str>];
    foreach (r in reports) {
        if ((r["name"] ?? "") == context) {
            events.append(r["event"] ?? "");
        }
    }
    return events;
}

fun reportedOn(reports: [{str: str}], context: str, event: str) > bool {
    foreach (e in eventsOf(reports, context: context)) {
        if (e == event) {
            return true;
        }
    }
    return false;
}

// statusRule is the required-status-checks rule requiring context from integration, with
// strict up-to-date off: the queue validates each change on the base it merges onto.
fun statusRule(context: str, integration: str) > any {
    return {"type": "required_status_checks", "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [{"context": context, "integration_id": std\parseInt(integration) ?? 0}],
    }};
}

fun heredoc(command: str, body: any) > str {
    return command + " --input - <<'EOF'\n" + serialize\jsonEncode(body) + "\nEOF";
}

// pinSteps are the steps that make base require context from credential: a ruleset of
// its own when nothing requires it yet, a rewrite of that ruleset while it holds only
// the queue's rule, else a link to where a person edits it. With the Actions token a
// context required from anyone already works, so it is left alone; with an app, pinning
// it is the point.
fun pinSteps(at: {str: str}, checks: [{str: str}], rulesets: {str: str}, credential: {str: str}, app: bool) > [any] !> any {
    final repo = at["repo"] ?? "";
    final context = at["context"] ?? "";
    final want = credential["id"] ?? "";
    final who = "{want} ({credential["name"] ?? ""})";
    final steps = mut [<any>];
    var required = false;
    foreach (c in checks) {
        if ((c["context"] ?? "") != context) {
            continue;
        }
        required = true;
        final integration = c["integration"] ?? "";
        if (integration == want or (integration == "" and !app)) {
            continue;
        }
        final ruleset = c["ruleset"] ?? "";
        final title = "Pin {context} to {who}";
        if (ruleset == "") {
            steps.append({"title": title + " in the branch protection of {at["base"] ?? ""}", "url": "{at["web"] ?? ""}/{repo}/settings/branches"});
        } else if ((rulesets[ruleset] ?? "") == RULESET_NAME) {
            steps.append({"title": title + " in ruleset {ruleset} ({RULESET_NAME})",
                "command": heredoc("gh api -X PUT repos/{repo}/rulesets/{ruleset}", body: {"rules": [statusRule(context, integration: want)]})});
        } else {
            steps.append({"title": title + " in ruleset {ruleset}", "url": "{at["web"] ?? ""}/{repo}/rules/{ruleset}"});
        }
    }
    if (!required) {
        steps.append({"title": "Require {context} from {who} on {at["base"] ?? ""}, in a ruleset of its own (your other rulesets stay as they are)",
            "command": heredoc("gh api -X POST repos/{repo}/rulesets", body: {
                "name": RULESET_NAME, "target": "branch", "enforcement": "active",
                "conditions": {"ref_name": {"include": ["refs/heads/{at["base"] ?? ""}"], "exclude": [<str>]}},
                "rules": [statusRule(context, integration: want)],
            })});
    }
    return steps;
}

// registrationURL pre-fills a GitHub App registration for the queue: private, no webhook,
// the queue's permissions. An organization registers its apps under its own settings.
fun registrationURL(web: str, repo: str, org: bool) > str {
    final owner = repo.split("/")[0];
    var page = web + "/settings/apps/new";
    if (org) {
        page = web + "/organizations/" + owner + "/settings/apps/new";
    }
    return page + "?name=" + escape(owner + "-magus-queue") + "&url=" + escape(web + "/" + repo) + "&public=false&webhook_active=false&" + APP_PERMISSIONS;
}

// setupFrom builds describe's setup from what GitHub answered. at carries repo, base,
// context and the web host; app is the queue app's record, empty for the Actions token.
fun setupFrom(at: {str: str}, repoBody: str, checks: [{str: str}], reports: [{str: str}], rulesets: {str: str}, app: {str: str}, steps: bool) > any !> any {
    final repo = at["repo"] ?? "";
    final web = at["web"] ?? "";
    final r = serialize\jsonDecode(repoBody);
    final org = r.q("owner").q("type").stringValue() == "Organization";
    final hasApp = app["id"] != null;
    var credential = ACTIONS_APP;
    if (hasApp) {
        credential = {"id": app["id"] ?? "", "name": app["name"] ?? ""};
    }
    final required = mut [<any>];
    foreach (c in checks) {
        required.append({"context": c["context"] ?? "", "integration": c["integration"] ?? "", "events": eventsOf(reports, context: c["context"] ?? "")});
    }
    final autoMerge = r.q("allow_auto_merge").booleanValue();
    final settings = [{"name": "allow_auto_merge", "value": "{autoMerge}", "want": "true"}];
    final todo = mut [<any>];
    if (!steps) {
        return {"status_context": at["context"] ?? "", "credential": credential, "required_checks": required, "settings": settings, "steps": todo};
    }
    if (!autoMerge) {
        todo.append({"title": "Allow auto-merge (Settings > General > Pull Requests > Allow auto-merge)",
            "command": "gh api -X PATCH repos/{repo} -F allow_auto_merge=true"});
    }
    var appRecord: any = null;
    if (hasApp) {
        final slug = app["slug"] ?? "";
        var appPage = web + "/settings/apps/" + slug;
        if (org) {
            appPage = web + "/organizations/" + repo.split("/")[0] + "/settings/apps/" + slug;
        }
        appRecord = {"slug": slug, "id": app["id"] ?? "", "client_id": app["client_id"] ?? "",
            "registration_url": registrationURL(web, repo: repo, org: org), "install_url": web + "/apps/" + slug + "/installations/new",
            "environment": APP_ENVIRONMENT, "variable": APP_VARIABLE, "secret": APP_SECRET};
        todo.append({"title": "Install {slug} on {repo} only", "url": web + "/apps/" + slug + "/installations/new"});
        todo.append({"title": "Create the {APP_ENVIRONMENT} environment, whose secrets only {at["base"] ?? ""} can read, so pull request runs never see the key",
            "command": "gh api -X PUT repos/{repo}/environments/{APP_ENVIRONMENT} -F 'deployment_branch_policy[protected_branches]=false' -F 'deployment_branch_policy[custom_branch_policies]=true'\n" +
                "gh api -X POST repos/{repo}/environments/{APP_ENVIRONMENT}/deployment-branch-policies -f name={at["base"] ?? ""} -f type=branch"});
        todo.append({"title": "Store the app's client id", "command": "gh variable set {APP_VARIABLE} --repo {repo} --body '{app["client_id"] ?? ""}'"});
        todo.append({"title": "Generate a private key on {appPage} (a .pem downloads), store it in the environment alone, and delete the download",
            "command": "gh secret set {APP_SECRET} --repo {repo} --env {APP_ENVIRONMENT} < ~/Downloads/{slug}.*.private-key.pem\nrm ~/Downloads/{slug}.*.private-key.pem"});
    }
    foreach (s in pinSteps(at, checks: checks, rulesets: rulesets, credential: credential, app: hasApp)) {
        todo.append(s);
    }
    if (!hasApp) {
        final unreported = mut [<str>];
        foreach (c in checks) {
            if ((c["context"] ?? "") != (at["context"] ?? "") and reportedOn(reports, context: c["context"] ?? "", event: "pull_request")) {
                unreported.append("\"{c["context"] ?? ""}\"");
            }
        }
        if (unreported.len() > 0) {
            todo.append({"title": "Required {unreported.join(", ")}: reported by pull_request runs, which the queue's own pushes start only once someone approves them, so a change needing an update commit waits on them. Take them out of the required set, or add the queue's own app below",
                "url": "{web}/{repo}/rules"});
        }
        todo.append({"title": "Optional, later: register the queue's own GitHub App (Create GitHub App), then run this again with --app <its slug>",
            "url": registrationURL(web, repo: repo, org: org)});
    }
    return {"status_context": at["context"] ?? "", "credential": credential, "required_checks": required, "settings": settings, "app": appRecord, "steps": todo};
}

// id reads an identifier GitHub may send as a number or a string.
fun id(b: serialize\Boxed) > str {
    final s = b.stringValue();
    if (s != "") {
        return s;
    }
    final n = b.integerValue();
    if (n == 0) {
        return "";
    }
    return "{n}";
}

// queueLabel returns the exact name of the "queue: <method>" label on pr, or "".
fun queueLabel(pr: serialize\Boxed) > str {
    foreach (l in pr.q("labels").listValue()) {
        final name = l.q("name").stringValue();
        if (name.startsWith(QUEUE_LABEL)) {
            return name;
        }
    }
    return "";
}

fun methodOf(label: str) > str {
    return label.sub(QUEUE_LABEL.len()).trim().lower();
}

// stackTops lists the stacks whose top pull request carries a queue label, on base:
// {stack, number, label, method}. Whoever applied the label is checked separately.
fun stackTops(pages: [str], base: str) > [{str: str}] !> any {
    final tops = mut [<{str: str}>];
    foreach (page in pages) {
        foreach (pr in serialize\jsonDecode(page).listValue()) {
            final stack = pr.q("stack");
            final sid = id(stack.q("id"));
            if (sid == "" or stack.q("position").integerValue() != stack.q("size").integerValue()) {
                continue;
            }
            if (stack.q("base").q("ref").stringValue() != base) {
                continue;
            }
            final label = queueLabel(pr);
            if (label == "") {
                continue;
            }
            tops.append({"stack": sid, "number": "{pr.q("number").integerValue()}", "label": label, "method": methodOf(label)});
        }
    }
    return tops;
}

// stackTopIn finds, in listing pages, the top pull request of stack sid: {number, label},
// both "" when the stack has no open top.
fun stackTopIn(pages: [str], sid: str) > {str: str} !> any {
    foreach (page in pages) {
        foreach (pr in serialize\jsonDecode(page).listValue()) {
            final stack = pr.q("stack");
            if (id(stack.q("id")) == sid and stack.q("position").integerValue() == stack.q("size").integerValue()) {
                return {"number": "{pr.q("number").integerValue()}", "label": queueLabel(pr)};
            }
        }
    }
    return {"number": "", "label": ""};
}

fun openPulls(repo: str, hdrs: {str: str}) > [str] !> any {
    return pages(apiBase() + "/repos/" + repo + "/pulls?state=open&sort=created&direction=asc", what: "list pull requests", hdrs: hdrs);
}

// changesFrom reads the open pull requests into change records: every non-draft one
// with auto-merge enabled against base, and every member of a stack in stacks (stack id
// to method), each naming the member below it as its parent. A fork is listed with fork
// set and no branch, so the queue refuses it by name instead of skipping it silently.
fun changesFrom(pages: [str], repo: str, base: str, stacks: {str: str}) > [any] !> any {
    // stack id + "/" + position -> number, to name each member's parent
    final positions = mut {<str: str>};
    foreach (page in pages) {
        foreach (pr in serialize\jsonDecode(page).listValue()) {
            final sid = id(pr.q("stack").q("id"));
            if (sid != "") {
                positions["{sid}/{pr.q("stack").q("position").integerValue()}"] = "{pr.q("number").integerValue()}";
            }
        }
    }
    final queued = mut [<any>];
    foreach (page in pages) {
        foreach (pr in serialize\jsonDecode(page).listValue()) {
            if (pr.q("draft").booleanValue()) {
                continue;
            }
            final number = pr.q("number").integerValue();
            final sid = id(pr.q("stack").q("id"));
            var method = pr.q("auto_merge").q("merge_method").stringValue();
            var target = pr.q("base").q("ref").stringValue();
            var parent = "";
            if (sid != "" and stacks[sid] != null) {
                method = stacks[sid] ?? "";
                target = pr.q("stack").q("base").q("ref").stringValue();
                parent = positions["{sid}/{pr.q("stack").q("position").integerValue() - 1}"] ?? "";
            } else if (method == "" or target != base) {
                continue;
            }
            final sameRepo = pr.q("head").q("repo").q("full_name").stringValue() == repo;
            queued.append({
                "id": "{number}",
                "repo": repo,
                "head": pr.q("head").q("sha").stringValue(),
                "ref": "refs/pull/{number}/head",
                "branch": if (sameRepo) pr.q("head").q("ref").stringValue() else "",
                "base": target,
                "title": pr.q("title").stringValue(),
                "fork": !sameRepo,
                "method": method.lower(),
                "parent": parent,
            });
        }
    }
    return queued;
}

// unqueuedFrom lists every open pull request queued leaves out, drafts and forks
// included, by id and head: a queued change carrying one of their heads waits.
fun unqueuedFrom(pages: [str], queued: [any]) > [any] !> any {
    final listed = mut {<str: bool>};
    foreach (c in queued) {
        listed["{serialize\Boxed.init(c).q("id").stringValue()}"] = true;
    }
    final unqueued = mut [<any>];
    foreach (page in pages) {
        foreach (pr in serialize\jsonDecode(page).listValue()) {
            final number = "{pr.q("number").integerValue()}";
            if (listed[number] == null) {
                unqueued.append({"id": number, "head": pr.q("head").q("sha").stringValue()});
            }
        }
    }
    return unqueued;
}

// labelerFrom reads, from a page of an issue's timeline, who last applied label.
fun labelerFrom(body: str, label: str) > str !> any {
    var who = "";
    foreach (e in serialize\jsonDecode(body).listValue()) {
        if (e.q("event").stringValue() == "labeled" and e.q("label").q("name").stringValue() == label) {
            who = e.q("actor").q("login").stringValue();
        }
    }
    return who;
}

// labeledByWriter reports whether the last to apply label to pull request number holds
// a role that may queue. A label is triage-level, so the label alone proves nothing. A
// timeline longer than it reads, or a role it cannot look up, proves nothing either, and
// affects that stack alone.
fun labeledByWriter(repo: str, number: str, label: str, hdrs: {str: str}) > bool !> any {
    var who = "";
    var page = 1;
    while (true) {
        if (page > TIMELINE_PAGES) {
            return false;
        }
        final body = expect(get(apiBase() + "/repos/" + repo + "/issues/" + number + "/timeline?per_page=100&page={page}", hdrs: hdrs), status: 200, what: "timeline of #{number}");
        final found = labelerFrom(body, label: label);
        if (found != "") {
            who = found;
        }
        if (serialize\jsonDecode(body).listValue().len() < 100) {
            break;
        }
        page = page + 1;
    }
    if (who == "") {
        return false;
    }
    final res = get(apiBase() + "/repos/" + repo + "/collaborators/" + escape(who) + "/permission", hdrs: hdrs);
    if (res["status"] != 200) {
        return false;
    }
    return QUEUE_ROLES.indexOf(serialize\jsonDecode("{res["body"]}").q("role_name").stringValue()) != null;
}

final MERGED_QUERY = `query($owner: String!, $name: String!, $number: Int!, $after: String) { repository(owner: $owner, name: $name) { pullRequest(number: $number) { commits(first: 100, after: $after) { pageInfo { hasNextPage endCursor } nodes { commit { oid associatedPullRequests(first: 20) { pageInfo { hasNextPage } nodes { number state baseRefName headRefOid mergeCommit { oid parents { totalCount } } } } } } } } } }`;

// mergedFrom reads one page of a pull request's commits into the pull requests merged
// into base whose head is one of those commits. A merge commit has two parents; anything
// else is read as a squash, since a rebase of one commit looks the same from here.
fun mergedFrom(body: str, base: str) > [any] !> any {
    final commits = serialize\jsonDecode(body).q("data").q("repository").q("pullRequest").q("commits");
    final merged = mut [<any>];
    foreach (n in commits.q("nodes").listValue()) {
        final c = n.q("commit");
        final prs = c.q("associatedPullRequests");
        if (prs.q("pageInfo").q("hasNextPage").booleanValue()) {
            throw "github: commit {c.q("oid").stringValue()} belongs to more pull requests than one page lists";
        }
        foreach (pr in prs.q("nodes").listValue()) {
            final commit = pr.q("mergeCommit").q("oid").stringValue();
            if (pr.q("state").stringValue() != "MERGED" or pr.q("baseRefName").stringValue() != base or commit == "" or pr.q("headRefOid").stringValue() != c.q("oid").stringValue()) {
                continue;
            }
            merged.append({
                "id": "{pr.q("number").integerValue()}",
                "head": pr.q("headRefOid").stringValue(),
                "commit": commit,
                "method": if (pr.q("mergeCommit").q("parents").q("totalCount").integerValue() > 1) "merge" else "squash",
            });
        }
    }
    return merged;
}

// nextPage is the cursor of the page after the one in body, "" at the end.
fun nextPage(body: str) > str !> any {
    final info = serialize\jsonDecode(body).q("data").q("repository").q("pullRequest").q("commits").q("pageInfo");
    if (info.q("hasNextPage").booleanValue()) {
        return info.q("endCursor").stringValue();
    }
    return "";
}

// mergedUnder lists the pull requests merged into base whose head a queued change
// carries, each once.
fun mergedUnder(repo: str, base: str, queued: [any], hdrs: {str: str}) > [any] !> any {
    final parts = repo.split("/");
    final seen = mut {<str: bool>};
    final found = mut [<any>];
    foreach (c in queued) {
        final change = serialize\Boxed.init(c);
        if (change.q("fork").booleanValue()) {
            continue;
        }
        var after = "";
        while (true) {
            final vars = mut {<str: any>};
            vars["owner"] = parts[0];
            vars["name"] = parts[1];
            vars["number"] = std\parseInt(change.q("id").stringValue()) ?? 0;
            if (after != "") {
                vars["after"] = after;
            }
            final body = graphql(MERGED_QUERY, variables: vars, hdrs: hdrs);
            foreach (m in mergedFrom(body, base: base)) {
                final key = "{serialize\Boxed.init(m).q("id").stringValue()}";
                if (seen[key] == null) {
                    seen[key] = true;
                    found.append(m);
                }
            }
            after = nextPage(body);
            if (after == "") {
                break;
            }
        }
    }
    return found;
}

// list_changes returns the queued pull requests against the base branch, oldest first,
// the merged ones a queued one carries the head of, and every other open pull request.
export fun list_changes(io: {str: any}) > any !> any {
    final hdrs = reading("list_changes");
    final repo = repoOf(io);
    final base = "{io["base"] ?? ""}";
    final pulls = openPulls(repo, hdrs: hdrs);
    final stacks = mut {<str: str>};
    foreach (top in stackTops(pulls, base: base)) {
        if (labeledByWriter(repo, number: top["number"] ?? "", label: top["label"] ?? "", hdrs: hdrs)) {
            stacks[top["stack"] ?? ""] = top["method"] ?? "";
        }
    }
    final changes = changesFrom(pulls, repo: repo, base: base, stacks: stacks);
    return {"changes": changes, "merged": mergedUnder(repo, base: base, queued: changes, hdrs: hdrs), "unqueued": unqueuedFrom(pulls, queued: changes)};
}

// requiredFrom reads the approvals the base branch's rulesets require.
fun requiredFrom(body: str) > int !> any {
    var need = 0;
    foreach (rule in serialize\jsonDecode(body).listValue()) {
        if (rule.q("type").stringValue() == "pull_request") {
            final n = rule.q("parameters").q("required_approving_review_count").integerValue();
            if (n > need) {
                need = n;
            }
        }
    }
    return need;
}

// approvalFrom decides approval AT commit from a GraphQL pull-request answer.
//
// Each reviewer's latest decisive review counts, as on GitHub, but an approval counts only
// when it was given on commit itself: approving an older commit does not approve what the
// queue tested. When commit lacks them, approved_commit names an older commit that holds
// enough approvals, the one approved most recently (by commit id when two tie), and the
// queue decides whether commit is that one rebased with its diff unchanged.
// reviewDecision covers what rulesets do not show (classic protection, code owners), so
// any requirement it signals needs at least one approval.
fun approvalFrom(body: str, commit: str, required: int) > {str: any} !> any {
    final pr = serialize\jsonDecode(body).q("data").q("repository").q("pullRequest");
    final head = pr.q("headRefOid").stringValue();
    if (head == "") {
        throw "github: approval_at: the pull request was not found";
    }
    final decision = pr.q("reviewDecision").stringValue();
    final latest = mut {<str: str>};
    final commits = mut {<str: str>};
    final times = mut {<str: str>};
    foreach (r in pr.q("reviews").q("nodes").listValue()) {
        final state = r.q("state").stringValue();
        if (state != "APPROVED" and state != "CHANGES_REQUESTED" and state != "DISMISSED") {
            continue;
        }
        final who = r.q("author").q("login").stringValue();
        latest[who] = state;
        commits[who] = r.q("commit").q("oid").stringValue();
        times[who] = r.q("submittedAt").stringValue();
    }
    var changes = decision == "CHANGES_REQUESTED";
    final at = mut {<str: int>};
    final newestAt = mut {<str: str>};
    foreach (who, state in latest) {
        if (state == "CHANGES_REQUESTED") {
            changes = true;
        }
        if (state == "APPROVED") {
            final oid = commits[who] ?? "";
            at[oid] = (at[oid] ?? 0) + 1;
            final when = times[who] ?? "";
            if (when > (newestAt[oid] ?? "")) {
                newestAt[oid] = when;
            }
        }
    }
    final approvals = at[commit] ?? 0;
    var need = required;
    if (decision != "" and need < 1) {
        need = 1;
    }
    var reason = "";
    if (changes) {
        reason = "changes requested";
    } else if (approvals < need) {
        reason = "{approvals} of {need} approvals at this commit";
    } else if (decision == "REVIEW_REQUIRED") {
        reason = "a required review is missing";
    }
    var approvedCommit = "";
    if (!changes and approvals < need) {
        var best = "";
        foreach (oid, n in at) {
            if (oid == commit or n < need) {
                continue;
            }
            final when = newestAt[oid] ?? "";
            final bestWhen = newestAt[best] ?? "";
            if (best == "" or when > bestWhen or (when == bestWhen and oid > best)) {
                best = oid;
            }
        }
        approvedCommit = best;
    }
    return {"approved": reason == "", "head": head, "reason": reason, "approved_commit": approvedCommit};
}

// targetFrom reads where a pull request merges and how: a stack member merges on the
// stack's base, and a pull request with auto-merge with the method chosen there, else
// with the one it was queued with.
fun targetFrom(body: str, method: str) > {str: str} !> any {
    final pr = serialize\jsonDecode(body);
    var base = pr.q("stack").q("base").q("ref").stringValue();
    if (base == "") {
        base = pr.q("base").q("ref").stringValue();
    }
    var m = pr.q("auto_merge").q("merge_method").stringValue().lower();
    if (m == "") {
        m = method;
    }
    return {"base": base, "method": m};
}

// intent reports whether the pull request in body still carries merge intent: its own
// auto-merge, or, for a stack member, a queue label on its stack's open top.
fun intent(body: str, repo: str, hdrs: {str: str}) > bool !> any {
    final pr = serialize\jsonDecode(body);
    if (pr.q("auto_merge").q("merge_method").stringValue() != "") {
        return true;
    }
    final sid = id(pr.q("stack").q("id"));
    if (sid == "") {
        return false;
    }
    return (stackTopIn(openPulls(repo, hdrs: hdrs), sid: sid)["label"] ?? "") != "";
}

// sharedFrom lists the open pull requests in pages other than number: the ones sharing
// its head branch, when pages is that branch's listing.
fun sharedFrom(pages: [str], number: str) > [str] !> any {
    final shared = mut [<str>];
    foreach (page in pages) {
        foreach (pr in serialize\jsonDecode(page).listValue()) {
            final n = "{pr.q("number").integerValue()}";
            if (n != number) {
                shared.append(n);
            }
        }
    }
    return shared;
}

// Backquoted: GraphQL's braces would read as interpolation in a double-quoted string.
final APPROVAL_QUERY = `query($owner: String!, $name: String!, $number: Int!) { repository(owner: $owner, name: $name) { pullRequest(number: $number) { headRefOid reviewDecision reviews(last: 100) { nodes { state submittedAt author { login } commit { oid } } } } } }`;

export fun approval_at(io: {str: any}) > any !> any {
    final hdrs = reading("approval_at");
    final repo = "{io["repo"] ?? ""}";
    final parts = repo.split("/");
    if (parts.len() != 2) {
        throw "github: approval_at needs an owner/name repo, got '{repo}'";
    }
    final number = "{io["id"] ?? ""}";
    final prBody = expect(get(apiBase() + "/repos/" + repo + "/pulls/" + number, hdrs: hdrs), status: 200, what: "read #{number}");
    final target = targetFrom(prBody, method: "{io["method"] ?? ""}");
    final rules = expect(get(apiBase() + "/repos/" + repo + "/rules/branches/" + escape(target["base"] ?? ""), hdrs: hdrs), status: 200, what: "read the rules on {target["base"] ?? ""}");
    final answer = graphql(APPROVAL_QUERY, variables: {"owner": parts[0], "name": parts[1], "number": std\parseInt(number) ?? 0}, hdrs: hdrs);
    final a = approvalFrom(answer, commit: "{io["commit"] ?? ""}", required: requiredFrom(rules));
    final pr = serialize\jsonDecode(prBody);
    var shared = [<str>];
    final branch = pr.q("head").q("ref").stringValue();
    final owner = pr.q("head").q("repo").q("owner").q("login").stringValue();
    if (pr.q("head").q("repo").q("full_name").stringValue() == repo and branch != "") {
        shared = sharedFrom(pages(apiBase() + "/repos/" + repo + "/pulls?state=open&head=" + escape(owner + ":" + branch), what: "pull requests from {branch}", hdrs: hdrs), number: number);
    }
    return {
        "approved": a["approved"], "head": a["head"], "reason": a["reason"], "approved_commit": a["approved_commit"],
        "base": target["base"], "method": target["method"], "queued": intent(prBody, repo: repo, hdrs: hdrs), "shared_with": shared,
    };
}

final GREEN_QUERY = `query($owner: String!, $name: String!, $context: String!, $after: String) { repository(owner: $owner, name: $name) { pullRequests(states: OPEN, first: 100, after: $after) { pageInfo { hasNextPage endCursor } nodes { number headRefOid commits(last: 1) { nodes { commit { oid status { context(name: $context) { state } } } } } } } } }`;

// greenFrom reads one page of open pull requests into the ones whose head carries the
// queried status at success: {id, repo, head}.
fun greenFrom(body: str, repo: str) > [any] !> any {
    final green = mut [<any>];
    foreach (pr in serialize\jsonDecode(body).q("data").q("repository").q("pullRequests").q("nodes").listValue()) {
        final head = pr.q("headRefOid").stringValue();
        foreach (n in pr.q("commits").q("nodes").listValue()) {
            final c = n.q("commit");
            if (c.q("oid").stringValue() == head and c.q("status").q("context").q("state").stringValue() == "SUCCESS") {
                green.append({"id": "{pr.q("number").integerValue()}", "repo": repo, "head": head});
            }
        }
    }
    return green;
}

// greenNext is the cursor of the page of pull requests after the one in body, "" at
// the end.
fun greenNext(body: str) > str !> any {
    final info = serialize\jsonDecode(body).q("data").q("repository").q("pullRequests").q("pageInfo");
    if (info.q("hasNextPage").booleanValue()) {
        return info.q("endCursor").stringValue();
    }
    return "";
}

// list_green lists every open pull request whose head carries the status at success,
// whatever it targets: a stacked one is retargeted onto the base once the one beneath it
// merges, and a success it carried then would count.
export fun list_green(io: {str: any}) > any !> any {
    final hdrs = reading("list_green");
    final repo = repoOf(io);
    final parts = repo.split("/");
    final green = mut [<any>];
    var after = "";
    while (true) {
        final vars = mut {<str: any>};
        vars["owner"] = parts[0];
        vars["name"] = parts[1];
        vars["context"] = "{io["context"] ?? ""}";
        if (after != "") {
            vars["after"] = after;
        }
        final body = graphql(GREEN_QUERY, variables: vars, hdrs: hdrs);
        foreach (g in greenFrom(body, repo: repo)) {
            green.append(g);
        }
        after = greenNext(body);
        if (after == "") {
            break;
        }
    }
    return {"changes": green};
}

// statusBody is GitHub's commit-status payload. GitHub rejects a description over 140
// bytes, so a long reason is cut rather than losing the status.
fun statusBody(state: str, context: str, description: str) > any {
    var desc = description;
    if (desc.len() > 140) {
        desc = desc.sub(0, len: 137) + "...";
    }
    return {"state": state, "context": context, "description": desc};
}

export fun post_status(io: {str: any}) > bool !> any {
    final hdrs = writing("post_status");
    final url = apiBase() + "/repos/{io["repo"] ?? ""}/statuses/{io["commit"] ?? ""}";
    final payload = statusBody("{io["state"] ?? ""}", context: "{io["context"] ?? ""}", description: "{io["description"] ?? ""}");
    expect(post(url, body: serialize\jsonEncode(payload), hdrs: hdrs), status: 201, what: "post_status");
    return true;
}

export fun retarget(io: {str: any}) > bool !> any {
    final hdrs = writing("retarget");
    final url = apiBase() + "/repos/{io["repo"] ?? ""}/pulls/{io["id"] ?? ""}";
    final res = mergequeue\request("PATCH", url: url, body: serialize\jsonEncode({"base": "{io["base"] ?? ""}"}), headers: hdrs);
    expect(res, status: 200, what: "retarget");
    return true;
}

// mergeBody builds the merge payload: the method the change was queued and validated
// with, and the title and message its author chose when enabling auto-merge. Pinned to
// commit, so GitHub refuses when the head moved.
//
// A squash always carries an explicit title and message. GitHub's default message lists
// every commit on the branch, which would include an update commit the queue pushed and
// credit its committer as a co-author; message is the change's own commits instead.
fun mergeBody(pr: str, commit: str, method: str, message: str) > any !> any {
    if (method == "") {
        throw "github: merge_change: the change carries no merge method";
    }
    final decoded = serialize\jsonDecode(pr);
    final am = decoded.q("auto_merge");
    final body = mut {<str: any>};
    body["sha"] = commit;
    body["merge_method"] = method;
    var title = am.q("commit_title").stringValue();
    var text = am.q("commit_message").stringValue();
    if (method == "squash") {
        if (title == "") {
            title = "{decoded.q("title").stringValue()} (#{decoded.q("number").integerValue()})";
        }
        if (text == "") {
            text = message;
        }
    }
    if (title != "") {
        body["commit_title"] = title;
    }
    if (text != "") {
        body["commit_message"] = text;
    }
    return body;
}

// merged reports whether the pull request at url merged with commit as its head: a
// merge whose answer was lost to a retried request, not a refusal.
fun merged(url: str, commit: str, hdrs: {str: str}) > bool !> any {
    final after = get(url, hdrs: hdrs);
    if (after["status"] != 200) {
        return false;
    }
    final now = serialize\jsonDecode("{after["body"]}");
    return now.q("merged").booleanValue() and now.q("head").q("sha").stringValue() == commit;
}

// movedFrom names the first pinned member of a stack whose head is no longer the one
// it was validated at, "" when none moved.
fun movedFrom(repo: str, through: [serialize\Boxed], hdrs: {str: str}) > str !> any {
    foreach (p in through) {
        final number = p.q("id").stringValue();
        final pr = serialize\jsonDecode(expect(get(apiBase() + "/repos/" + repo + "/pulls/" + number, hdrs: hdrs), status: 200, what: "read #{number}"));
        if (pr.q("head").q("sha").stringValue() != p.q("commit").stringValue()) {
            return number;
        }
    }
    return "";
}

// awaitFrom decides, from one read of a pull request GitHub's auto-merge should merge at
// commit, what merge_change does next: {next, reason}, next being "merged" once it
// merged there, "wait" while it is open at commit with auto-merge on, and "refuse"
// otherwise, since then neither GitHub nor the queue may merge it.
fun awaitFrom(body: str, commit: str) > {str: str} !> any {
    final pr = serialize\jsonDecode(body);
    if (pr.q("head").q("sha").stringValue() != commit) {
        return {"next": "refuse", "reason": "head moved to {pr.q("head").q("sha").stringValue()} before GitHub merged it"};
    }
    if (pr.q("merged").booleanValue()) {
        return {"next": "merged", "reason": ""};
    }
    if (pr.q("state").stringValue() != "open") {
        return {"next": "refuse", "reason": "closed before GitHub merged it"};
    }
    if (pr.q("auto_merge").q("merge_method").stringValue() == "") {
        return {"next": "refuse", "reason": "auto-merge was disabled before GitHub merged it"};
    }
    return {"next": "wait", "reason": ""};
}

// mergedByOther reports whether anyone but the Actions token merged the pull request in
// body: GitHub's auto-merge, on behalf of whoever enabled it, or a person. Either starts
// the base branch's workflows, which the token's own merges do not. It tells a merge the
// token's call raced apart from one whose answer was lost.
fun mergedByOther(body: str) > bool !> any {
    return serialize\jsonDecode(body).q("merged_by").q("login").stringValue() != (COMMITTER["name"] ?? "");
}

// mergeFailure reads GitHub's refusal of a merge call.
fun mergeFailure(res: {str: any}) > any !> any {
    return {"merged": false, "reason": "HTTP {res["status"]}: {serialize\jsonDecode("{res["body"]}").q("message").stringValue()}"};
}

// merge_change merges through the API, never by pushing, so branch protection and
// authorship stay GitHub's: a squash is authored by the pull request's author.
//
// A pull request with auto-merge on is GitHub's to merge once the queue's status went
// green, on behalf of whoever enabled auto-merge, so merge_change first waits for that
// (by_provider). If GitHub has not merged it in time, it merges it itself, pinned to
// commit; a merge GitHub made in the meantime still reads as GitHub's.
//
// A stack run (through set) goes through merge-async, which merges every pull request of
// the stack up to this one; GitHub pins only the top's head, so every member's head is
// read first, and the queue checks what merged afterwards. It is polled until this one
// merged.
export fun merge_change(io: {str: any}) > any !> any {
    final hdrs = writing("merge_change");
    final repo = "{io["repo"] ?? ""}";
    final url = apiBase() + "/repos/" + repo + "/pulls/{io["id"] ?? ""}";
    final commit = "{io["commit"] ?? ""}";
    final pr = expect(get(url, hdrs: hdrs), status: 200, what: "merge_change: read the pull request");
    final payload = serialize\jsonEncode(mergeBody(pr, commit: commit, method: "{io["method"] ?? ""}", message: "{io["message"] ?? ""}"));
    final through = serialize\Boxed.init(io["through"]).listValue();
    if (through.len() == 0) {
        if (serialize\jsonDecode(pr).q("auto_merge").q("merge_method").stringValue() != "") {
            var state = awaitFrom(pr, commit: commit);
            var polls = 0;
            while (state["next"] == "wait" and polls < AUTO_MERGE_POLLS) {
                os\sleep(AUTO_MERGE_POLL_MS);
                polls = polls + 1;
                state = awaitFrom(expect(get(url, hdrs: hdrs), status: 200, what: "merge_change: read the pull request"), commit: commit);
            }
            if (state["next"] == "merged") {
                return {"merged": true, "by_provider": true, "reason": ""};
            }
            if (state["next"] == "refuse") {
                return {"merged": false, "reason": state["reason"] ?? ""};
            }
        }
        final res = mergequeue\request("PUT", url: url + "/merge", body: payload, headers: hdrs);
        if (res["status"] == 200) {
            return {"merged": true, "by_provider": false, "reason": ""};
        }
        final now = get(url, hdrs: hdrs);
        if (now["status"] == 200 and (awaitFrom("{now["body"]}", commit: commit)["next"] ?? "") == "merged") {
            return {"merged": true, "by_provider": mergedByOther("{now["body"]}"), "reason": ""};
        }
        return mergeFailure(res);
    }
    final moved = movedFrom(repo, through: through, hdrs: hdrs);
    if (moved != "") {
        return {"merged": false, "reason": "#{moved} moved past the head it was validated at"};
    }
    final res = mergequeue\request("PUT", url: url + "/merge-async", body: payload, headers: hdrs);
    // 409 is a merge of this stack already enqueued, which the polls below follow.
    if (res["status"] != 200 and res["status"] != 202 and res["status"] != 409) {
        return mergeFailure(res);
    }
    var polls = 0;
    while (polls < ASYNC_POLLS) {
        if (merged(url, commit: commit, hdrs: hdrs)) {
            return {"merged": true, "by_provider": false, "reason": ""};
        }
        os\sleep(ASYNC_POLL_MS);
        polls = polls + 1;
    }
    return {"merged": false, "reason": "the stack merge did not finish within {ASYNC_POLLS * 5} seconds"};
}

// The comment marker every kick-back ends with; kick_back minimizes the older comments
// carrying it.
final KICK_MARKER = "<!-- mergequeue: ";

// shQuote single-quotes s for sh, so a hook line pastes as one argument with its
// $MERGEQUEUE_* references left for the queue to expand.
fun shQuote(s: str) > str {
    return "'" + s.replace("'", with: "'\\''") + "'";
}

// requeueLine is how the author queues the change again: auto-merge with its merge
// method, or, when a label queued it, that label on the stack's top pull request. A
// fork cannot be queued, so it gets none.
fun requeueLine(number: str, method: str, fork: bool, label: str, top: str) > str {
    if (fork) {
        return "";
    }
    if (label != "") {
        return "Queue the stack again once fixed: `gh pr edit {top} --add-label \"{label}\"`";
    }
    return "Queue it again once fixed: `gh pr merge {number} --auto --{method}`";
}

// reproduction is the collapsed block that validates the change again on a person's
// machine, exactly as the run did: the run's plan and the hook lines it ran.
fun reproduction(number: str, run: {str: str}, repoArg: str, base: str, gate: str, regenerate: str) > [str] {
    final dir = "mq-{number}";
    final lines = mut [
        "<details><summary><b>Reproduce locally</b></summary>",
        "",
        "```sh",
        "gh run download {run["id"] ?? ""} -R {repoArg} -n mergequeue-plan -D {dir}",
        "magus queue validate --only {number} --plan {dir}/plan.json --verdicts {dir}/verdicts \\",
    ];
    if (regenerate == "") {
        lines.append("  --gate {shQuote(gate)}");
    } else {
        lines.append("  --gate {shQuote(gate)} \\");
        lines.append("  --regenerate {shQuote(regenerate)}");
    }
    lines.append("```");
    lines.append("");
    lines.append("The queue sets `$MERGEQUEUE_ONTO` and the other `MERGEQUEUE_*` variables for each hook, so leave them quoted. "
        + "Run it in a checkout of `{base}` whose `origin` is {repoArg}; the plan artifact is kept for a day.");
    lines.append("");
    lines.append("</details>");
    return lines;
}

// kickComment renders the kick-back comment from kick_back's record: what failed, the
// validation run, how to reproduce it, the files at issue, requeue (from requeueLine),
// and last the facts it was rendered from as one JSON line a workflow can read back.
// web is the provider's web root ("https://github.com").
fun kickComment(io: {str: any}, web: str, requeue: str) > str !> any {
    final number = "{io["id"] ?? ""}";
    final base = "{io["base"] ?? ""}";
    final report = "{io["report"] ?? ""}";
    final lines = mut ["### Merge queue: kicked back", "", report.trim()];
    final source = "{io["source"] ?? ""}";
    if (source != "") {
        final run = runOf(source);
        final host = apiHost(web);
        var repoArg = run["repo"] ?? "";
        if (host != "github.com") {
            repoArg = host + "/" + repoArg;
        }
        lines.append("");
        lines.append("[Validation run]({web}/{run["repo"] ?? ""}/actions/runs/{run["id"] ?? ""})");
        final repro = serialize\Boxed.init(io["reproduce"]);
        final gate = repro.q("gate").stringValue();
        if (gate != "") {
            lines.append("");
            foreach (line in reproduction(number, run: run, repoArg: repoArg, base: base, gate: gate, regenerate: repro.q("regenerate").stringValue())) {
                lines.append(line);
            }
        }
    }
    final paths = serialize\Boxed.init(io["paths"]).listValue();
    if (paths.len() > 0) {
        lines.append("");
        lines.append("<details><summary>Files ({paths.len()})</summary>");
        lines.append("");
        foreach (p in paths) {
            lines.append("- `{p.stringValue()}`");
        }
        final commits = serialize\Boxed.init(io["with"]).listValue();
        if (commits.len() > 0) {
            lines.append("");
            lines.append("Commits on `{base}` that changed them:");
            lines.append("");
            foreach (c in commits) {
                lines.append("- {c.stringValue()}");
            }
        }
        lines.append("");
        lines.append("</details>");
    }
    if (requeue != "") {
        lines.append("");
        lines.append(requeue);
    }
    final facts = serialize\jsonEncode({
        "code": "{io["code"] ?? ""}",
        "paths": io["paths"] ?? [<str>],
        "with": io["with"] ?? [<str>],
        "candidate_commit": "{io["candidate_commit"] ?? ""}",
    });
    lines.append("");
    lines.append(KICK_MARKER + facts + " -->");
    return lines.join("\n") + "\n";
}

final COMMENTS_QUERY = `query($owner: String!, $name: String!, $number: Int!, $after: String) { repository(owner: $owner, name: $name) { pullRequest(number: $number) { comments(first: 100, after: $after) { pageInfo { hasNextPage endCursor } nodes { id viewerDidAuthor isMinimized body } } } } }`;
final MINIMIZE_COMMENT = `mutation($id: ID!) { minimizeComment(input: {subjectId: $id, classifier: OUTDATED}) { minimizedComment { isMinimized } } }`;

// staleKicks reads one page of a pull request's comments into the ids of the earlier
// kick-backs this credential wrote and nobody minimized yet, keep aside.
fun staleKicks(body: str, keep: str) > [str] !> any {
    final ids = mut [<str>];
    foreach (c in serialize\jsonDecode(body).q("data").q("repository").q("pullRequest").q("comments").q("nodes").listValue()) {
        final cid = c.q("id").stringValue();
        if (cid != keep and c.q("viewerDidAuthor").booleanValue() and !c.q("isMinimized").booleanValue()
            and c.q("body").stringValue().indexOf(KICK_MARKER) != null) {
            ids.append(cid);
        }
    }
    return ids;
}

// commentsNext is the cursor of the page of comments after the one in body, "" at the
// end.
fun commentsNext(body: str) > str !> any {
    final info = serialize\jsonDecode(body).q("data").q("repository").q("pullRequest").q("comments").q("pageInfo");
    if (info.q("hasNextPage").booleanValue()) {
        return info.q("endCursor").stringValue();
    }
    return "";
}

// minimizeOlder collapses the earlier kick-backs on the pull request as outdated, so
// only the newest reads as current.
fun minimizeOlder(repo: str, number: str, keep: str, hdrs: {str: str}) > void !> any {
    final parts = repo.split("/");
    var after = "";
    while (true) {
        final vars = mut {<str: any>};
        vars["owner"] = parts[0];
        vars["name"] = parts[1];
        vars["number"] = std\parseInt(number) ?? 0;
        if (after != "") {
            vars["after"] = after;
        }
        final body = graphql(COMMENTS_QUERY, variables: vars, hdrs: hdrs);
        foreach (cid in staleKicks(body, keep: keep)) {
            graphql(MINIMIZE_COMMENT, variables: {"id": cid}, hdrs: hdrs);
        }
        after = commentsNext(body);
        if (after == "") {
            return;
        }
    }
}

final DISABLE_AUTO_MERGE = `mutation($id: ID!) { disablePullRequestAutoMerge(input: {pullRequestId: $id}) { clientMutationId } }`;

fun unlabel(repo: str, number: str, label: str, hdrs: {str: str}) > void !> any {
    final res = mergequeue\request("DELETE", url: apiBase() + "/repos/" + repo + "/issues/" + number + "/labels/" + escape(label), body: "", headers: hdrs);
    if (res["status"] != 200 and res["status"] != 404) {
        throw "github: kick_back: remove the label '{label}' from #{number}: HTTP {res["status"]}: {res["body"]}";
    }
}

// kick_back posts a new comment with the queue's report, then removes the change's merge
// intent where it lives: its own auto-merge, its own queue label, and for a stack member
// the label on its stack's top, which queues the whole stack. The author re-queues after
// a fix. Last it minimizes the earlier kick-backs on the pull request; the comment and
// the removal already happened, so a failure there is printed to stderr (the apply
// job's log) and the kick-back still succeeds.
export fun kick_back(io: {str: any}) > bool !> any {
    final hdrs = writing("kick_back");
    final repo = "{io["repo"] ?? ""}";
    final number = "{io["id"] ?? ""}";
    final decoded = serialize\jsonDecode(expect(get(apiBase() + "/repos/" + repo + "/pulls/" + number, hdrs: hdrs), status: 200, what: "kick_back: read the pull request"));
    final own = queueLabel(decoded);
    final sid = id(decoded.q("stack").q("id"));
    var top = {"number": "", "label": ""};
    if (sid != "") {
        top = stackTopIn(openPulls(repo, hdrs: hdrs), sid: sid);
    }
    var label = top["label"] ?? "";
    var labeled = top["number"] ?? "";
    if (label == "" and own != "") {
        label = own;
        labeled = number;
    }
    final requeue = requeueLine(number, method: "{io["method"] ?? ""}", fork: io["fork"] == true, label: label, top: labeled);
    final posted = expect(post(apiBase() + "/repos/" + repo + "/issues/" + number + "/comments",
        body: serialize\jsonEncode({"body": kickComment(io, web: "https://" + apiHost(apiBase()), requeue: requeue)}), hdrs: hdrs),
        status: 201, what: "kick_back: comment");
    if (decoded.q("auto_merge").q("merge_method").stringValue() != "") {
        graphql(DISABLE_AUTO_MERGE, variables: {"id": decoded.q("node_id").stringValue()}, hdrs: hdrs);
    }
    if (own != "") {
        unlabel(repo, number: number, label: own, hdrs: hdrs);
    }
    if ((top["label"] ?? "") != "" and (top["number"] ?? "") != number) {
        unlabel(repo, number: top["number"] ?? "", label: top["label"] ?? "", hdrs: hdrs);
    }
    try {
        minimizeOlder(repo, number: number, keep: serialize\jsonDecode(posted).q("node_id").stringValue(), hdrs: hdrs);
    } catch (e) {
        std\print("github: kick_back: #{number} was kicked back, but its earlier kick-back comments stay expanded: {e}");
    }
    return true;
}

// runOf reads "<owner>/<name>/runs/<id>" into {repo, id}, or throws.
fun runOf(spec: str) > {str: str} !> any {
    final parts = spec.split("/");
    if (parts.len() != 4 or parts[0] == "" or parts[1] == "" or parts[2] != "runs" or (std\parseInt(parts[3]) ?? 0) < 1) {
        throw "github: a run is <owner>/<name>/runs/<id>, got '{spec}'";
    }
    return {"repo": parts[0] + "/" + parts[1], "id": parts[3]};
}

// artifactsFrom reads one page of a run's artifact listing into {name, url} records.
fun artifactsFrom(body: str, base: str, repo: str) > [any] !> any {
    final artifacts = mut [<any>];
    foreach (a in serialize\jsonDecode(body).q("artifacts").listValue()) {
        artifacts.append({"name": a.q("name").stringValue(), "url": base + "/repos/" + repo + "/actions/artifacts/{a.q("id").integerValue()}/zip"});
    }
    return artifacts;
}

// list_artifacts reads the run's status BEFORE listing its artifacts, so a listing that
// says complete holds every artifact the run uploaded. The headers carry the read
// credential for the downloads; the queue drops them on a redirect to the storage host.
export fun list_artifacts(io: {str: any}) > any !> any {
    final hdrs = reading("list_artifacts");
    final run = runOf("{io["source"] ?? ""}");
    final base = apiBase();
    final prefix = base + "/repos/" + (run["repo"] ?? "") + "/actions/runs/" + (run["id"] ?? "");
    final status = serialize\jsonDecode(expect(get(prefix, hdrs: hdrs), status: 200, what: "run {run["id"] ?? ""}")).q("status").stringValue();
    final artifacts = mut [<any>];
    var page = 1;
    while (true) {
        final body = expect(get(prefix + "/artifacts?per_page=100&page={page}", hdrs: hdrs), status: 200, what: "artifacts of run {run["id"] ?? ""}");
        final got = artifactsFrom(body, base: base, repo: run["repo"] ?? "");
        foreach (a in got) {
            artifacts.append(a);
        }
        if (got.len() < 100) {
            break;
        }
        page = page + 1;
    }
    return {"complete": status == "completed", "headers": hdrs, "artifacts": artifacts};
}

test "list keeps auto-merge pull requests against the base and drops drafts and plain ones" {
    final got = changesFrom([`[
        {"number": 7, "draft": false, "auto_merge": {"merge_method": "squash"}, "title": "add x",
         "user": {"login": "priya"}, "base": {"ref": "main"},
         "head": {"sha": "abc", "ref": "feat", "repo": {"full_name": "acme/acme"}}},
        {"number": 8, "draft": false, "auto_merge": null, "title": "plain",
         "user": {"login": "eli"}, "base": {"ref": "main"},
         "head": {"sha": "def", "ref": "other", "repo": {"full_name": "acme/acme"}}},
        {"number": 9, "draft": true, "auto_merge": {"merge_method": "merge"}, "title": "draft",
         "user": {"login": "eli"}, "base": {"ref": "main"},
         "head": {"sha": "fed", "ref": "wip", "repo": {"full_name": "acme/acme"}}},
        {"number": 10, "draft": false, "auto_merge": {"merge_method": "merge"}, "title": "elsewhere",
         "user": {"login": "eli"}, "base": {"ref": "release"},
         "head": {"sha": "0de", "ref": "rel", "repo": {"full_name": "acme/acme"}}}
    ]`], repo: "acme/acme", base: "main", stacks: {<str: str>});
    assert\equal(got.len(), want: 1, message: "only the auto-merge pull request against main is queued");
    final one = serialize\Boxed.init(got[0]);
    assert\equal(one.q("id").stringValue(), want: "7", message: "id is the number as a string");
    assert\equal(one.q("head").stringValue(), want: "abc", message: "head sha");
    assert\equal(one.q("ref").stringValue(), want: "refs/pull/7/head", message: "a fetchable ref");
    assert\equal(one.q("branch").stringValue(), want: "feat", message: "a same-repository branch can take a push");
    assert\equal(one.q("fork").booleanValue(), want: false, message: "fork is always said");
    assert\equal(one.q("method").stringValue(), want: "squash", message: "the method chosen with auto-merge");
    assert\equal(one.q("parent").stringValue(), want: "", message: "not a stack member");
}

test "a fork is listed as one, with no branch to push to" {
    final got = changesFrom([`[{"number": 3, "draft": false, "auto_merge": {"merge_method": "squash"},
        "title": "t", "user": {"login": "x"}, "base": {"ref": "main"},
        "head": {"sha": "abc", "ref": "feat", "repo": {"full_name": "x/acme"}}}]`], repo: "acme/acme", base: "main", stacks: {<str: str>});
    final one = serialize\Boxed.init(got[0]);
    assert\equal(one.q("branch").stringValue(), want: "", message: "the queue cannot push to a fork");
    assert\equal(one.q("fork").booleanValue(), want: true, message: "so the queue can refuse it by name");
}

final STACK = `[
    {"number": 20, "draft": false, "auto_merge": null, "title": "bottom", "user": {"login": "ann"},
     "base": {"ref": "main"}, "labels": [],
     "stack": {"id": 5, "position": 1, "size": 2, "base": {"ref": "main", "sha": "b"}},
     "head": {"sha": "a20", "ref": "s1", "repo": {"full_name": "acme/acme"}}},
    {"number": 21, "draft": false, "auto_merge": null, "title": "top", "user": {"login": "ann"},
     "base": {"ref": "s1"}, "labels": [{"name": "queue:  Squash"}],
     "stack": {"id": 5, "position": 2, "size": 2, "base": {"ref": "main", "sha": "b"}},
     "head": {"sha": "a21", "ref": "s2", "repo": {"full_name": "acme/acme"}}},
    {"number": 22, "draft": true, "auto_merge": null, "title": "draft", "user": {"login": "bo"},
     "base": {"ref": "main"}, "labels": [],
     "head": {"sha": "a22", "ref": "d", "repo": {"full_name": "acme/acme"}}}
]`;

test "a labeled stack top queues the stack, each member naming the one below" {
    final tops = stackTops([STACK], base: "main");
    assert\equal(tops.len(), want: 1, message: "one labeled top");
    assert\equal(tops[0]["number"], want: "21", message: "the top");
    assert\equal(tops[0]["method"], want: "squash", message: "the label's method");
    assert\equal(tops[0]["label"], want: "queue:  Squash", message: "the label exactly as it is spelled, so removing it finds it");
    assert\equal(stackTops([STACK], base: "release").len(), want: 0, message: "a stack on another trunk is not this queue's");
    final got = changesFrom([STACK], repo: "acme/acme", base: "main", stacks: {"5": "squash"});
    assert\equal(got.len(), want: 2, message: "both members");
    assert\equal(serialize\Boxed.init(got[0]).q("parent").stringValue(), want: "", message: "the bottom sits on the trunk");
    assert\equal(serialize\Boxed.init(got[1]).q("parent").stringValue(), want: "20", message: "the top names the bottom");
    assert\equal(serialize\Boxed.init(got[1]).q("base").stringValue(), want: "main", message: "a member merges on the stack's base");
    assert\equal(changesFrom([STACK], repo: "acme/acme", base: "main", stacks: {<str: str>}).len(), want: 0, message: "an unlabeled stack is not queued");
    final top = stackTopIn([STACK], sid: "5");
    assert\equal(top["number"], want: "21", message: "a member finds its stack's top");
    assert\equal(top["label"], want: "queue:  Squash", message: "and the label that queues it");
}

test "every open pull request the listing leaves out is unqueued" {
    final queued = changesFrom([STACK], repo: "acme/acme", base: "main", stacks: {"5": "squash"});
    final got = unqueuedFrom([STACK], queued: queued);
    assert\equal(got.len(), want: 1, message: "the draft");
    assert\equal(serialize\Boxed.init(got[0]).q("id").stringValue(), want: "22", message: "by id");
    assert\equal(serialize\Boxed.init(got[0]).q("head").stringValue(), want: "a22", message: "and head");
}

test "the labeler is the last actor to apply the label" {
    final body = `[
        {"event": "labeled", "label": {"name": "queue: squash"}, "actor": {"login": "triager"}},
        {"event": "commented", "actor": {"login": "x"}},
        {"event": "labeled", "label": {"name": "queue: squash"}, "actor": {"login": "maint"}},
        {"event": "labeled", "label": {"name": "bug"}, "actor": {"login": "other"}}
    ]`;
    assert\equal(labelerFrom(body, label: "queue: squash"), want: "maint", message: "latest application wins");
}

test "merged changes are the ones merged into the base at a head the change carries" {
    final body = `{"data": {"repository": {"pullRequest": {"commits": {
        "pageInfo": {"hasNextPage": true, "endCursor": "c2"},
        "nodes": [
        {"commit": {"oid": "h4", "associatedPullRequests": {"pageInfo": {"hasNextPage": false}, "nodes": [
            {"number": 4, "state": "MERGED", "baseRefName": "main", "headRefOid": "h4", "mergeCommit": {"oid": "m4", "parents": {"totalCount": 1}}},
            {"number": 9, "state": "OPEN", "baseRefName": "main", "headRefOid": "h4", "mergeCommit": null}]}}},
        {"commit": {"oid": "h5", "associatedPullRequests": {"pageInfo": {"hasNextPage": false}, "nodes": [
            {"number": 5, "state": "MERGED", "baseRefName": "main", "headRefOid": "h5", "mergeCommit": {"oid": "m5", "parents": {"totalCount": 2}}},
            {"number": 6, "state": "MERGED", "baseRefName": "release", "headRefOid": "h5", "mergeCommit": {"oid": "m6", "parents": {"totalCount": 1}}},
            {"number": 7, "state": "MERGED", "baseRefName": "main", "headRefOid": "later", "mergeCommit": {"oid": "m7", "parents": {"totalCount": 1}}}]}}}
    ]}}}}}`;
    final merged = mergedFrom(body, base: "main");
    assert\equal(merged.len(), want: 2, message: "an open one, one merged elsewhere and one merged at another head are not");
    final four = serialize\Boxed.init(merged[0]);
    final five = serialize\Boxed.init(merged[1]);
    assert\equal(four.q("method").stringValue(), want: "squash", message: "one parent");
    assert\equal(five.q("method").stringValue(), want: "merge", message: "two parents");
    assert\equal(five.q("commit").stringValue(), want: "m5", message: "the commit on the base");
    assert\equal(nextPage(body), want: "c2", message: "and where the next page starts");
}

test "an approval counts only at the commit asked about" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "new", "reviewDecision": "APPROVED",
        "reviews": {"nodes": [{"state": "APPROVED", "submittedAt": "2026-01-01T00:00:00Z", "author": {"login": "a"}, "commit": {"oid": "old"}}]}}}}}`;
    assert\equal(approvalFrom(body, commit: "old", required: 1)["approved"], want: true, message: "approved at old");
    final atNew = approvalFrom(body, commit: "new", required: 1);
    assert\equal(atNew["approved"], want: false, message: "not approved at a commit nobody reviewed");
    assert\equal(atNew["head"], want: "new", message: "the current head rides along");
    assert\equal(atNew["reason"], want: "0 of 1 approvals at this commit", message: "says why");
    assert\equal(atNew["approved_commit"], want: "old", message: "names the commit the approvals stand at");
}

test "the commit approvals carry over from is the one approved most recently" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "new", "reviewDecision": "APPROVED",
        "reviews": {"nodes": [
            {"state": "APPROVED", "submittedAt": "2026-01-03T00:00:00Z", "author": {"login": "b"}, "commit": {"oid": "second"}},
            {"state": "APPROVED", "submittedAt": "2026-01-01T00:00:00Z", "author": {"login": "a"}, "commit": {"oid": "first"}},
            {"state": "APPROVED", "submittedAt": "2026-01-02T00:00:00Z", "author": {"login": "c"}, "commit": {"oid": "first"}}
        ]}}}}}`;
    assert\equal(approvalFrom(body, commit: "new", required: 1)["approved_commit"], want: "second", message: "whatever order the reviewers come in");
    assert\equal(approvalFrom(body, commit: "new", required: 2)["approved_commit"], want: "first", message: "among the commits holding enough");
}

test "a reviewer's latest decisive review wins, and changes requested blocks" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": "CHANGES_REQUESTED",
        "reviews": {"nodes": [
            {"state": "APPROVED", "author": {"login": "a"}, "commit": {"oid": "abc"}},
            {"state": "COMMENTED", "author": {"login": "a"}, "commit": {"oid": "abc"}},
            {"state": "CHANGES_REQUESTED", "author": {"login": "b"}, "commit": {"oid": "abc"}}
        ]}}}}}`;
    final got = approvalFrom(body, commit: "abc", required: 1);
    assert\equal(got["approved"], want: false, message: "changes requested blocks");
    assert\equal(got["reason"], want: "changes requested", message: "a comment does not undo an approval, and says why not");
    assert\equal(got["approved_commit"], want: "", message: "nothing carries over past a change request");
}

test "no review requirement approves with no reviews" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": null,
        "reviews": {"nodes": []}}}}}`;
    assert\equal(approvalFrom(body, commit: "abc", required: 0)["approved"], want: true, message: "nothing is required");
}

test "a requirement the rulesets do not show still needs one approval at the commit" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": "REVIEW_REQUIRED",
        "reviews": {"nodes": []}}}}}`;
    final got = approvalFrom(body, commit: "abc", required: 0);
    assert\equal(got["approved"], want: false, message: "classic protection or code owners");
    assert\equal(got["reason"], want: "0 of 1 approvals at this commit", message: "at least one");
}

test "required approvals come from the strictest pull_request rule" {
    assert\equal(requiredFrom(`[
        {"type": "deletion"},
        {"type": "pull_request", "parameters": {"required_approving_review_count": 1}},
        {"type": "pull_request", "parameters": {"required_approving_review_count": 2}}
    ]`), want: 2, message: "the larger count");
    assert\equal(requiredFrom(`[]`), want: 0, message: "no rules, no requirement");
}

test "a pull request merges on its stack's base with its auto-merge method" {
    final member = targetFrom(`{"base": {"ref": "s1"}, "stack": {"base": {"ref": "main"}}, "auto_merge": null}`, method: "squash");
    assert\equal(member["base"], want: "main", message: "the stack's base, not the branch below");
    assert\equal(member["method"], want: "squash", message: "the method it was queued with");
    final plain = targetFrom(`{"base": {"ref": "main"}, "auto_merge": {"merge_method": "REBASE"}}`, method: "squash");
    assert\equal(plain["base"], want: "main", message: "its own base");
    assert\equal(plain["method"], want: "rebase", message: "auto-merge's method, as the contract spells it");
}

test "the other pull requests from a branch share it" {
    assert\equal(sharedFrom([`[{"number": 7}, {"number": 40}]`], number: "7"), want: ["40"], message: "all but its own");
}

test "describe lists the methods the repository allows" {
    final got = describeFrom(`{"allow_merge_commit": false, "allow_squash_merge": true, "allow_rebase_merge": true}`, rules: `[]`, setup: null);
    assert\equal(got["methods"], want: ["squash", "rebase"], message: "allowed methods");
    assert\equal(got["stack_merge"], want: "atomic", message: "GitHub merges a stack in one call");
    assert\equal(got["queue_label"], want: "queue: ", message: "the label a stack is queued by, before its method");
    assert\equal(got["committer"], want: COMMITTER, message: "the Actions bot commits");
    assert\equal(COMMITTER["email"], want: "41898282+github-actions[bot]@users.noreply.github.com", message: "the bot's noreply address");
}

test "an active pull_request ruleset rule narrows methods to what it allows" {
    final got = describeFrom(`{"allow_merge_commit": true, "allow_squash_merge": true, "allow_rebase_merge": true}`,
        rules: `[{"type": "pull_request", "parameters": {"allowed_merge_methods": ["squash", "rebase"]}}]`, setup: null);
    assert\equal(got["methods"], want: ["squash", "rebase"], message: "the repo settings allow merge too, but the ruleset does not");
}

test "a required_linear_history rule drops merge even when settings and rulesets both allow it" {
    final got = describeFrom(`{"allow_merge_commit": true, "allow_squash_merge": true, "allow_rebase_merge": true}`,
        rules: `[{"type": "required_linear_history"}]`, setup: null);
    assert\equal(got["methods"], want: ["squash", "rebase"], message: "a merge commit is never linear");
}

test "no rule targeting the base leaves the settings untouched" {
    final got = describeFrom(`{"allow_merge_commit": true, "allow_squash_merge": false, "allow_rebase_merge": false}`, rules: `[]`, setup: null);
    assert\equal(got["methods"], want: ["merge"], message: "a ruleset on another branch never reaches this call, since the rules are read for the base branch alone");
}

test "a read-only token takes the methods its ruleset names" {
    final got = describeFrom(`{"full_name": "o/r"}`,
        rules: `[{"type": "pull_request", "parameters": {"allowed_merge_methods": ["squash", "rebase"]}}]`, setup: null);
    assert\equal(got["methods"], want: ["squash", "rebase"], message: "absent settings are unknown, not off");
}

test "a read-only token with no ruleset naming methods is an error naming why" {
    var reason = "";
    try {
        final _ = describeFrom(`{"full_name": "o/r"}`, rules: `[]`, setup: null);
    } catch (e) {
        reason = "{e}";
    }
    assert\contains(reason, item: "push access", message: "the error names the missing permission");
}

test "an empty intersection is an error naming why" {
    var reason = "";
    try {
        final _ = describeFrom(`{"allow_merge_commit": true, "allow_squash_merge": false, "allow_rebase_merge": false}`,
            rules: `[{"type": "pull_request", "parameters": {"allowed_merge_methods": ["squash"]}}]`, setup: null);
    } catch (e) {
        reason = "{e}";
    }
    assert\contains(reason, item: "no merge method", message: "the error names why, not just that it failed");
}

test "the merge carries the queued method and the author's title, pinned to the sha" {
    final body = mergeBody(`{"auto_merge": {"merge_method": "rebase", "commit_title": "feat: x (#7)", "commit_message": ""}}`, commit: "abc", method: "rebase", message: "* x");
    assert\equal(body["merge_method"], want: "rebase", message: "the queued method");
    assert\equal(body["sha"], want: "abc", message: "pinned to the tested commit");
    assert\equal(body["commit_title"], want: "feat: x (#7)", message: "the author's title");
    assert\equal(body["commit_message"], want: null, message: "a rebase takes no message");
}

test "a squash carries the pull request title and the change's own commits" {
    final body = mergeBody(`{"number": 7, "title": "feat: add x", "auto_merge": {"merge_method": "squash"}}`, commit: "abc", method: "squash", message: "* add x\n\n* fix typo");
    assert\equal(body["merge_method"], want: "squash", message: "squash");
    assert\equal(body["commit_title"], want: "feat: add x (#7)", message: "the title as subject, GitHub's shape");
    assert\equal(body["commit_message"], want: "* add x\n\n* fix typo", message: "no queue commit, no co-author trailer");
    final authored = mergeBody(`{"number": 7, "title": "t", "auto_merge": {"merge_method": "squash", "commit_title": "mine", "commit_message": "my body"}}`, commit: "abc", method: "squash", message: "* x");
    assert\equal(authored["commit_title"], want: "mine", message: "the author's own title wins");
    assert\equal(authored["commit_message"], want: "my body", message: "the author's own body wins");
}

test "merge_change waits for auto-merge while the pull request is open at the commit" {
    final at = "abc";
    assert\equal(awaitFrom(`{"state": "open", "merged": false, "head": {"sha": "abc"}, "auto_merge": {"merge_method": "squash"}}`, commit: at)["next"],
        want: "wait", message: "GitHub has yet to merge it");
    assert\equal(awaitFrom(`{"state": "closed", "merged": true, "head": {"sha": "abc"}, "auto_merge": null}`, commit: at)["next"],
        want: "merged", message: "GitHub merged it, and auto-merge is cleared by then");
    final moved = awaitFrom(`{"state": "open", "merged": false, "head": {"sha": "def"}, "auto_merge": {"merge_method": "squash"}}`, commit: at);
    assert\equal(moved["next"], want: "refuse", message: "a new head is not what was validated");
    assert\equal(moved["reason"], want: "head moved to def before GitHub merged it", message: "says where it moved");
    assert\equal(awaitFrom(`{"state": "open", "merged": false, "head": {"sha": "abc"}, "auto_merge": null}`, commit: at)["reason"],
        want: "auto-merge was disabled before GitHub merged it", message: "a withdrawn intent is not merged by the queue either");
    assert\equal(awaitFrom(`{"state": "closed", "merged": false, "head": {"sha": "abc"}, "auto_merge": null}`, commit: at)["reason"],
        want: "closed before GitHub merged it", message: "closed unmerged");
}

test "a merge the token's call raced is GitHub's unless the token made it" {
    assert\equal(mergedByOther(`{"merged_by": {"login": "egladman"}}`), want: true, message: "auto-merge merges as whoever enabled it");
    assert\equal(mergedByOther(`{"merged_by": {"login": "github-actions[bot]"}}`), want: false, message: "the token's own merge, its answer lost");
}

test "list_green keeps the open pull requests whose head carries the status at success" {
    final body = `{"data": {"repository": {"pullRequests": {
        "pageInfo": {"hasNextPage": true, "endCursor": "p2"},
        "nodes": [
        {"number": 4, "headRefOid": "h4", "commits": {"nodes": [{"commit": {"oid": "h4", "status": {"context": {"state": "SUCCESS"}}}}]}},
        {"number": 5, "headRefOid": "h5", "commits": {"nodes": [{"commit": {"oid": "h5", "status": {"context": {"state": "PENDING"}}}}]}},
        {"number": 6, "headRefOid": "h6", "commits": {"nodes": [{"commit": {"oid": "h6", "status": null}}]}},
        {"number": 7, "headRefOid": "h7", "commits": {"nodes": [{"commit": {"oid": "older", "status": {"context": {"state": "SUCCESS"}}}}]}}
    ]}}}}`;
    final got = greenFrom(body, repo: "acme/acme");
    assert\equal(got.len(), want: 1, message: "pending, no status and a stale commit are not green");
    final four = serialize\Boxed.init(got[0]);
    assert\equal(four.q("id").stringValue(), want: "4", message: "id");
    assert\equal(four.q("repo").stringValue(), want: "acme/acme", message: "repo");
    assert\equal(four.q("head").stringValue(), want: "h4", message: "head");
    assert\equal(greenNext(body), want: "p2", message: "and where the next page starts");
}

fun kickFacts(code: str, paths: [str], commits: [str], candidate: str) > str {
    return KICK_MARKER + serialize\jsonEncode({"code": code, "paths": paths, "with": commits, "candidate_commit": candidate}) + " -->";
}

test "a red gate's kick-back links the run, reproduces it locally and lists the files" {
    final io = {
        "id": "300", "base": "main", "method": "squash", "code": "KICK_RED", "candidate_commit": "c0ffee",
        "report": "The merge queue built this change at `4d028a1474d1` onto `main` at `9f2e01234567`, and the gate exited 1.\n",
        "source": "egladman/magus/runs/123",
        "reproduce": {"gate": `magus affected ci --base "$MERGEQUEUE_ONTO" --no-default-charms`, "regenerate": `magus affected generate:rw --base "$MERGEQUEUE_ONTO"`},
        "paths": ["libs/a.go"], "with": ["abc123 touch a"],
    };
    final got = kickComment(io, web: "https://github.com", requeue: requeueLine("300", method: "squash", fork: false, label: "", top: ""));
    final want = [
        "### Merge queue: kicked back",
        "",
        "The merge queue built this change at `4d028a1474d1` onto `main` at `9f2e01234567`, and the gate exited 1.",
        "",
        "[Validation run](https://github.com/egladman/magus/actions/runs/123)",
        "",
        "<details><summary><b>Reproduce locally</b></summary>",
        "",
        "```sh",
        "gh run download 123 -R egladman/magus -n mergequeue-plan -D mq-300",
        "magus queue validate --only 300 --plan mq-300/plan.json --verdicts mq-300/verdicts \\",
        `  --gate 'magus affected ci --base "$MERGEQUEUE_ONTO" --no-default-charms' \`,
        `  --regenerate 'magus affected generate:rw --base "$MERGEQUEUE_ONTO"'`,
        "```",
        "",
        "The queue sets `$MERGEQUEUE_ONTO` and the other `MERGEQUEUE_*` variables for each hook, so leave them quoted. "
            + "Run it in a checkout of `main` whose `origin` is egladman/magus; the plan artifact is kept for a day.",
        "",
        "</details>",
        "",
        "<details><summary>Files (1)</summary>",
        "",
        "- `libs/a.go`",
        "",
        "Commits on `main` that changed them:",
        "",
        "- abc123 touch a",
        "",
        "</details>",
        "",
        "Queue it again once fixed: `gh pr merge 300 --auto --squash`",
        "",
        kickFacts("KICK_RED", paths: ["libs/a.go"], commits: ["abc123 touch a"], candidate: "c0ffee"),
    ];
    assert\equal(got, want: want.join("\n") + "\n", message: "the whole comment");
}

test "a conflict planning found links the run and reproduces nothing" {
    final io = {
        "id": "7", "base": "main", "method": "rebase", "code": "KICK_CONFLICT", "candidate_commit": "",
        "report": "It conflicts.\n\nMerge `main` in.\n", "source": "o/r/runs/9", "paths": [<str>], "with": [<str>],
    };
    final got = kickComment(io, web: "https://github.com", requeue: requeueLine("7", method: "rebase", fork: false, label: "", top: ""));
    assert\equal(got, want: "### Merge queue: kicked back\n\nIt conflicts.\n\nMerge `main` in.\n\n[Validation run](https://github.com/o/r/actions/runs/9)\n\n"
        + "Queue it again once fixed: `gh pr merge 7 --auto --rebase`\n\n" + kickFacts("KICK_CONFLICT", paths: [<str>], commits: [<str>], candidate: "") + "\n",
        message: "no reproduce block, no files");
    assert\equal(kickComment({"id": "7", "report": "r", "paths": [<str>], "with": [<str>]}, web: "https://github.com", requeue: ""),
        want: "### Merge queue: kicked back\n\nr\n\n" + kickFacts("", paths: [<str>], commits: [<str>], candidate: "") + "\n", message: "a directory source links nothing");
}

test "a hook line's single quotes survive sh quoting" {
    assert\equal(shQuote("echo 'hi' there"), want: `'echo '\''hi'\'' there'`, message: "each quote closes, escapes and reopens");
    assert\equal(shQuote(`magus run x --base "$MERGEQUEUE_ONTO"`), want: `'magus run x --base "$MERGEQUEUE_ONTO"'`, message: "the variable stays literal");
    final lines = reproduction("5", run: {"repo": "o/r", "id": "2"}, repoArg: "o/r", base: "main", gate: "test 'x' = x", regenerate: "");
    assert\equal(lines[4], want: "magus queue validate --only 5 --plan mq-5/plan.json --verdicts mq-5/verdicts \\", message: "continued");
    assert\equal(lines[5], want: `  --gate 'test '\''x'\'' = x'`, message: "no regeneration: the gate line ends the command");
}

test "a stack queued by its top's label re-queues through that label, and a fork not at all" {
    assert\equal(requeueLine("11", method: "squash", fork: false, label: "queue: squash", top: "12"),
        want: "Queue the stack again once fixed: `gh pr edit 12 --add-label \"queue: squash\"`", message: "the top's label");
    assert\equal(requeueLine("11", method: "merge", fork: true, label: "", top: ""), want: "", message: "a fork");
}

test "only this credential's earlier kick-backs are minimized, never the new one" {
    final body = `{"data": {"repository": {"pullRequest": {"comments": {"pageInfo": {"hasNextPage": true, "endCursor": "p2"}, "nodes": [
        {"id": "old", "viewerDidAuthor": true, "isMinimized": false, "body": "x\n<!-- mergequeue: {} -->\n"},
        {"id": "done", "viewerDidAuthor": true, "isMinimized": true, "body": "<!-- mergequeue: {} -->"},
        {"id": "human", "viewerDidAuthor": false, "isMinimized": false, "body": "<!-- mergequeue: {} -->"},
        {"id": "chat", "viewerDidAuthor": true, "isMinimized": false, "body": "a note"},
        {"id": "new", "viewerDidAuthor": true, "isMinimized": false, "body": "<!-- mergequeue: {} -->"}
    ]}}}}}`;
    assert\equal(staleKicks(body, keep: "new"), want: ["old"], message: "stale");
    assert\equal(commentsNext(body), want: "p2", message: "and where the next page starts");
}

test "a label and a branch are escaped for the URL they go in" {
    assert\equal(escape("queue: squash"), want: "queue%3a%20squash", message: "a label");
    assert\equal(escape("ann:feat/x-1"), want: "ann%3afeat%2fx-1", message: "an owner and branch");
}

test "a long status description is cut to what GitHub accepts" {
    final parts = mut [<str>];
    var i = 0;
    while (i < 200) {
        parts.append("x");
        i = i + 1;
    }
    final long = parts.join("");
    assert\equal(statusBody("pending", context: "merge-queue", description: long)["description"].len(), want: 140, message: "140 bytes");
    assert\equal(statusBody("success", context: "merge-queue", description: "ok")["description"], want: "ok", message: "a short one is untouched");
}

test "a run names its repository and id, and its artifacts download from the API" {
    final run = runOf("acme/widgets/runs/7");
    assert\equal(run["repo"], want: "acme/widgets", message: "repository");
    assert\equal(run["id"], want: "7", message: "run id");
    final got = artifactsFrom(`{"artifacts": [{"id": 100, "name": "mergequeue-plan"}]}`, base: "https://api.github.com", repo: "acme/widgets");
    assert\equal(serialize\Boxed.init(got[0]).q("url").stringValue(), want: "https://api.github.com/repos/acme/widgets/actions/artifacts/100/zip", message: "zip url");
}

test "the GraphQL endpoint follows the REST one" {
    assert\equal(graphqlURL("https://api.github.com"), want: "https://api.github.com/graphql", message: "github.com");
    assert\equal(graphqlURL("https://github.acme.com/api/v3"), want: "https://github.acme.com/api/graphql", message: "Enterprise");
    assert\equal(slug("https://github.com/acme/acme.git", host: "github.com"), want: "acme/acme", message: "the Actions remote");
}

final RULES = `[
    {"type": "pull_request", "ruleset_id": 3, "parameters": {"required_approving_review_count": 1}},
    {"type": "required_status_checks", "ruleset_id": 9, "parameters": {"required_status_checks": [
        {"context": "merge-queue", "integration_id": 15368}, {"context": "ci gate"}]}},
    {"type": "required_status_checks", "ruleset_id": 4, "parameters": {"required_status_checks": [
        {"context": "merge-queue", "integration_id": 15368}]}}
]`;

final CLASSIC = `{"protection": {"required_status_checks": {"contexts": ["lint", "merge-queue"],
    "checks": [{"context": "lint", "app_id": null}, {"context": "merge-queue", "app_id": 812}]}}}`;

test "required checks come from rulesets and classic protection, once per ruleset and pin" {
    final got = requiredChecksFrom(RULES, branch: CLASSIC);
    assert\equal(got.len(), want: 5, message: "merge-queue in each ruleset, ci gate, lint, merge-queue from 812");
    assert\equal(got[0], want: {"context": "merge-queue", "integration": "15368", "ruleset": "9"}, message: "a ruleset pin names its ruleset");
    assert\equal(got[1], want: {"context": "ci gate", "integration": "", "ruleset": "9"}, message: "no pin accepts anyone");
    assert\equal(got[2], want: {"context": "merge-queue", "integration": "15368", "ruleset": "4"}, message: "each ruleset needs its own pin");
    assert\equal(got[3], want: {"context": "lint", "integration": "", "ruleset": ""}, message: "classic protection names no ruleset");
    assert\equal(got[4], want: {"context": "merge-queue", "integration": "812", "ruleset": ""}, message: "classic pins by app_id");
    final old = requiredChecksFrom("[]", branch: `{"protection": {"required_status_checks": {"contexts": ["build"]}}}`);
    assert\equal(old, want: [{"context": "build", "integration": "", "ruleset": ""}], message: "contexts alone, pinned to nothing");
    assert\equal(requiredChecksFrom("[]", branch: `{"protected": false}`).len(), want: 0, message: "an unprotected base requires nothing");
}

test "a check's events are the workflow runs that reported it" {
    final reports = reportsFrom(`{"check_runs": [
        {"name": "ci gate", "check_suite": {"id": 1}}, {"name": "ci gate", "check_suite": {"id": 2}},
        {"name": "ci gate", "check_suite": {"id": 1}}, {"name": "codecov", "check_suite": {"id": 5}}]}`,
        runs: `{"workflow_runs": [{"check_suite_id": 1, "event": "pull_request"}, {"check_suite_id": 2, "event": "push"}]}`);
    assert\equal(eventsOf(reports, context: "ci gate"), want: ["pull_request", "push"], message: "each event once");
    assert\equal(eventsOf(reports, context: "codecov").len(), want: 0, message: "another app's check has no workflow event");
    assert\equal(reportedOn(reports, context: "ci gate", event: "pull_request"), want: true, message: "on pull_request");
}

test "the sampled heads are pull requests from this repository, newest first" {
    final body = `[{"head": {"sha": "f0", "repo": {"full_name": "x/acme"}}}, {"head": {"sha": "a1", "repo": {"full_name": "acme/acme"}}},
        {"head": {"sha": "b2", "repo": {"full_name": "acme/acme"}}}]`;
    assert\equal(sampleHeads(body, repo: "acme/acme"), want: ["a1", "b2"], message: "a fork's runs are not this repository's");
    assert\equal(sampleHeads("[]", repo: "acme/acme").len(), want: 0, message: "no pull request, no sample");
    final runs = `{"check_runs": [{"name": "lint"}, {"name": "ci gate"}]}`;
    assert\equal(carriesRequired(runs, wanted: [{"context": "ci gate"}]), want: true, message: "a finished head carries the gate");
    assert\equal(carriesRequired(runs, wanted: [{"context": "deploy"}]), want: false, message: "one still running does not");
}

test "only a ruleset holding the queue's rule alone is rewritten in place" {
    final own = `{"name": "magus merge queue", "rules": [{"type": "required_status_checks", "parameters": {"required_status_checks": [{"context": "merge-queue"}]}}]}`;
    assert\equal(ownRuleset(own), want: RULESET_NAME, message: "the printed ruleset");
    final more = `{"name": "main", "rules": [{"type": "deletion"}, {"type": "required_status_checks", "parameters": {"required_status_checks": [{"context": "merge-queue"}]}}]}`;
    assert\equal(ownRuleset(more), want: "", message: "a PUT would drop the deletion rule");
}

test "the registration link pre-fills a private app with the queue's permissions" {
    assert\equal(registrationURL("https://github.com", repo: "acme/widgets", org: false),
        want: "https://github.com/settings/apps/new?name=acme-magus-queue&url=https%3a%2f%2fgithub.com%2facme%2fwidgets&public=false&webhook_active=false&" + APP_PERMISSIONS,
        message: "a user's app");
    assert\equal(registrationURL("https://github.com", repo: "acme/widgets", org: true).startsWith("https://github.com/organizations/acme/settings/apps/new?"),
        want: true, message: "an organization's app");
}

fun titles(setup: any) > [str] !> any {
    final got = mut [<str>];
    foreach (s in serialize\Boxed.init(setup).q("steps").listValue()) {
        got.append(s.q("title").stringValue());
    }
    return got;
}

final AT = {"repo": "acme/widgets", "base": "main", "context": "merge-queue", "web": "https://github.com"};

test "with the Actions token, setup requires the status, lists pull_request checks and offers the app" {
    final checks = [{"context": "ci gate", "integration": "", "ruleset": "4"}];
    final reports = [{"name": "ci gate", "event": "pull_request"}];
    final repo = `{"allow_auto_merge": false, "owner": {"type": "User"}}`;
    final setup = serialize\Boxed.init(setupFrom(AT, repoBody: repo, checks: checks, reports: reports, rulesets: {<str: str>}, app: {<str: str>}, steps: true));
    assert\equal(setup.q("credential").q("id").stringValue(), want: "15368", message: "GITHUB_TOKEN posts as GitHub Actions");
    assert\equal(setup.q("settings").listValue()[0].q("value").stringValue(), want: "false", message: "auto-merge is off");
    assert\equal(setup.q("required_checks").listValue()[0].q("events").listValue()[0].stringValue(), want: "pull_request", message: "the event it was seen on");
    final steps = setup.q("steps").listValue();
    assert\equal(steps.len(), want: 4, message: "auto-merge, the ruleset, the unreported check, the app");
    assert\equal(steps[0].q("command").stringValue(), want: "gh api -X PATCH repos/acme/widgets -F allow_auto_merge=true", message: "auto-merge");
    final ruleset = steps[1].q("command").stringValue();
    assert\equal(ruleset.startsWith("gh api -X POST repos/acme/widgets/rulesets --input - <<'EOF'\n"), want: true, message: "a ruleset of its own");
    assert\equal(ruleset.indexOf(`"integration_id":15368`) != null, want: true, message: "pinned to GitHub Actions");
    assert\equal(ruleset.indexOf(`"strict_required_status_checks_policy":false`) != null, want: true, message: "no strict up-to-date");
    assert\equal(ruleset.indexOf(`"refs/heads/main"`) != null, want: true, message: "on the base");
    assert\equal(steps[2].q("title").stringValue().startsWith(`Required "ci gate": reported by pull_request runs`), want: true, message: "listed, not changed");
    assert\equal(steps[2].q("command").stringValue(), want: "", message: "a link, never a command");
    assert\equal(steps[3].q("url").stringValue().startsWith("https://github.com/settings/apps/new?"), want: true, message: "the upgrade");
}

test "with the Actions token, a context required from anyone already works" {
    final checks = [{"context": "merge-queue", "integration": "", "ruleset": "9"}];
    final repo = `{"allow_auto_merge": true, "owner": {"type": "User"}}`;
    final setup = setupFrom(AT, repoBody: repo, checks: checks, reports: [<{str: str}>], rulesets: {<str: str>}, app: {<str: str>}, steps: true);
    assert\equal(titles(setup), want: ["Optional, later: register the queue's own GitHub App (Create GitHub App), then run this again with --app <its slug>"], message: "only the upgrade is left");
}

test "with an app, setup installs it, stores its credential and moves the pin" {
    final checks = [{"context": "merge-queue", "integration": "15368", "ruleset": "9"}, {"context": "merge-queue", "integration": "15368", "ruleset": ""}];
    final app = {"slug": "acme-magus-queue", "id": "812", "client_id": "Iv23li", "name": "acme magus queue"};
    final repo = `{"allow_auto_merge": true, "owner": {"type": "Organization"}}`;
    final setup = serialize\Boxed.init(setupFrom(AT, repoBody: repo, checks: checks, reports: [<{str: str}>], rulesets: {"9": RULESET_NAME}, app: app, steps: true));
    assert\equal(setup.q("credential").q("id").stringValue(), want: "812", message: "the app posts the status");
    assert\equal(setup.q("app").q("install_url").stringValue(), want: "https://github.com/apps/acme-magus-queue/installations/new", message: "install link");
    assert\equal(setup.q("app").q("secret").stringValue(), want: APP_SECRET, message: "the secret setup-magus reads");
    final steps = setup.q("steps").listValue();
    assert\equal(steps.len(), want: 6, message: "install, environment, variable, key, two pins");
    assert\equal(steps[2].q("command").stringValue(), want: "gh variable set MAGUS_QUEUE_APP_CLIENT_ID --repo acme/widgets --body 'Iv23li'", message: "the client id, read from the app");
    assert\equal(steps[3].q("command").stringValue().startsWith("gh secret set MAGUS_QUEUE_APP_PRIVATE_KEY --repo acme/widgets --env magus-queue < "), want: true, message: "the key, environment only");
    assert\equal(steps[3].q("title").stringValue().indexOf("https://github.com/organizations/acme/settings/apps/acme-magus-queue") != null, want: true, message: "an organization's app page");
    final pin = steps[4].q("command").stringValue();
    assert\equal(pin.startsWith("gh api -X PUT repos/acme/widgets/rulesets/9 --input - <<'EOF'\n"), want: true, message: "the queue's own ruleset, rewritten");
    assert\equal(pin.indexOf(`"integration_id":812`) != null, want: true, message: "pinned to the app");
    assert\equal(steps[5].q("url").stringValue(), want: "https://github.com/acme/widgets/settings/branches", message: "classic protection is edited by hand");
}

test "without steps, setup is the facts apply checks" {
    final setup = serialize\Boxed.init(setupFrom(AT, repoBody: `{"allow_auto_merge": true}`, checks: [{"context": "merge-queue", "integration": "812", "ruleset": "9"}],
        reports: [<{str: str}>], rulesets: {<str: str>}, app: {<str: str>}, steps: false));
    assert\equal(setup.q("status_context").stringValue(), want: "merge-queue", message: "the context asked about");
    assert\equal(setup.q("required_checks").listValue()[0].q("integration").stringValue(), want: "812", message: "the pin apply compares");
    assert\equal(setup.q("steps").listValue().len(), want: 0, message: "no steps");
}
