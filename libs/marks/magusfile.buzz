import "fs";
import "magus";

magus\project({
    // No spell claims .buzz, so this line declares the scripts sources.
    "sources": ["*.buzz", "*.md"],
});

// generate draws every mark into gen/. It clears gen/ first, so a design
// dropped from a script leaves no stale SVG behind.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["*.buzz"]);
    ctx.writesFiles(["gen/*.svg"]);
    fs\removeAll("gen");
    _ = magus\cmd("buzz", args: ["safetyscissors.buzz", "gen"]);
}

// test runs the in-file test blocks.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["*.buzz"]);
    _ = magus\cmd("buzz", args: ["-t", "safetyscissors.buzz"]);
}

// lint type-checks the script and fails on any BZZ diagnostic. --check
// exits 0 on a warning, so lint grades the output itself.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["*.buzz"]);
    final res = magus\cmd("buzz", args: ["--check", "safetyscissors.buzz"], opts: magus\CommandOptions{quiet = true});
    final found = mut [<str>];
    foreach (line in res.stderr.split("\n")) {
        if (line.indexOf("[BZZ") != null) {
            found.append(line);
        }
    }
    if (found.len() > 0) {
        foreach (line in found) {
            magus\log.error(line);
        }
        throw "lint: buzz --check reported {found.len()} diagnostic(s)";
    }
}

// ci runs lint, then test.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint);
    ctx.needs(test);
}
