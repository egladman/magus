// magusfile.buzz for coldread, a standalone Go module (github.com/egladman/magus/libs/coldread)
// at libs/coldread: a static analyzer reporting Go comments that tell a cold reader
// nothing the code does not (restatements, step and change narration, doc stubs,
// commented-out code) plus the spaced-hyphen em-dash. Its own module (not part of
// the magus module) because golangci-lint compiles a plugin INTO its binary rather
// than loading one at runtime, so the rule has to be a dependency someone can pin at
// a version, which is what makes it a project here rather than a package in the
// magus tree.
//
//   magus run build libs/coldread   compile the analyzer and the plugin glue
//   magus run test libs/coldread    run the analysistest suite
//   magus run ci libs/coldread      lint, build, and test
//
// Nothing in the magus module imports it, and nothing should: the consumer is
// `golangci-lint custom`, which reads libs/testlayout/.custom-gcl.yml. One binary
// carries every in-repo plugin, so that file names this module too.

import "magus";
import "../../tools/drift" as drift;

// go spell claims **/*.go and the module files. This file's own export-fun targets
// need no declaration: magus binds the magusfile driver to every project.
import "magus/spell/go";
// Imported for its dprint op only, NOT added to the spells list: binding markdown here
// would also claim this tree's **/*.md for markdownlint, which the root project lints.
import "magus/spell/markdown";
import "../../spells/golang/gomod" as gomod;

import "fs";

magus\project({
    "spells": [go],
    // MAGUS.md is declared per-target on index_generate, not here: see the root magusfile.
    "targets": {
        // Regenerates MAGUS.md, which the engine drift-gates as a declared output.
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
    },
});

// A pure library, so the pipeline is the Go lifecycle plus index-generate, matching
// libs/testlayout. Each target delegates to the go spell's ops.

// Regenerates MAGUS.md and fails on drift. Use the rw charm to keep the result.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    gomod\replaceWorkspaceModules(ctx, go, "libs/coldread");
    ctx.needs(index_generate);
}

// Renders MAGUS.md, this project's target catalog, from this magusfile.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    // Declared so `magus vcs resolve` can find the target that settles a conflict here:
    // it matches per-TARGET outputs, and the project-level outputs list is not enough.
    ctx.writesFiles("MAGUS.md");
    // Scoped to this project, the index is a function of this magusfile, the workspace
    // config and the renderer, so each is declared and `magus affected` regenerates it
    // exactly when one moves. The workspace-wide routing tables live only in the root
    // index. Relative paths, not <alias>\file(): the cross form also unions a depends_on
    // edge on the root project, which would pull this one into every root change.
    ctx.readsFiles("magusfile.buzz", "../../magus.yaml", "../../internal/render/target_graph.go",
                   "../../internal/render/md/md.go", "../../internal/hint/cli_command.go");
    final doc = magus\describe(["graph", "-o", "markdown", "libs/coldread"], {"quiet": true}).stdout;
    fs\writeFile("MAGUS.md", doc + "\n");
}

export fun format(ctx: magus\Context, args: [str]) > void {
    // Declared because the markdown spell is NOT in this project's spell list: the
    // dprint OP is imported on its own, so the spell's `**/*.md` claim never joins
    // these sources. Without this the cache key does not move when only markdown
    // changes, and format:rw replays a pass without running dprint at all.
    //
    // dprint.json is named beside it because the rules are an input too, and this is the
    // only target that reads them: an explicit ctx.readsFiles REPLACES the project
    // baseline, so a project-wide declaration would never reach this key.
    ctx.readsFiles("dprint.json");
    // What this target EDITS, restated. Not writesFiles: dprint, gofmt and go-mod-tidy
    // amend authored files rather than producing them, so the bytes stay off the
    // snapshot/replay path.
    //
    // The Go half is here because of the replacement above, and it was missing: the go
    // spell contributes its globs project-wide (mgs_listRequiredGlobs takes no target),
    // so the readsFiles call dropped **/*.go and go.mod out of this key entirely and
    // go-fmt replayed on a pure-Go edit. lint, build and test still re-ran, inheriting
    // the baseline, so the gate stayed green while nothing was reformatted.
    //
    // The markdown glob mirrors this project's dprint.json `includes` (./**/*.md); keep
    // the two in step.
    ctx.modifiesExistingFiles("**/*.md", "**/*.go", "go.mod", "go.sum");
    ctx.needs(generate);
    go["go-fmt"](ctx);
    go["go-mod-tidy"](ctx);
    markdown["dprint"](ctx);
}
// go-vet only, as in libs/testlayout. Deliberately NOT golangci-lint: this module
// is what a custom golangci-lint binary is built FROM, and linting it with a binary
// that carries it is a bootstrap nobody needs.
export fun lint(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-vet"](ctx); }
export fun build(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-build"](ctx); }
// The profile is a declared output: the root's coverage badge is one figure over every
// Go module, recorded from each module's own run rather than re-measured.
export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    ctx.writesFiles("coverage.out");
    go["go-test"](ctx, {"args": ["-covermode=atomic", "-coverprofile=coverage.out", "./..."]});
}

// The anchor `magus affected ci` keys off; fans out lint/build/test after format.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, build, test);
}
