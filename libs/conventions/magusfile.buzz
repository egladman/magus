// `golangci-lint custom` consumes the analyzers through libs/testlayout/.custom-gcl.yml;
// nothing in the magus module imports this module.

import "magus";
import "fs";
import "../../hack/magusfile/drift" as drift;
import "../../hack/magusfile/index" as index;
import "./judge_docs" as judgeDocs;

import "magus/spell/go";
// Imported for dprint only. Listing it in spells would claim **/*.md, which the root lints.
import "magus/spell/markdown";
import "../../spells/golang/gomod" as gomod;

magus\project({
    "spells": [go],
    // MAGUS.md is declared on index_generate, not here.
    "targets": {
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
    },
});

// Regenerates MAGUS.md and fails on drift. Use the rw charm to keep the result.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    gomod\replaceWorkspaceModules(ctx, go, "libs/conventions");
    ctx.needs(index_generate);
}

// Renders MAGUS.md, this project's target catalog.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("MAGUS.md");
    ctx.readsFiles("magusfile.buzz", "../../magus.yaml", "../../internal/render/target_graph.go",
                   "../../internal/render/md/md.go", "../../internal/hint/cli_command.go");
    index\render("libs/conventions");
}

export fun format(ctx: magus\Context, args: [str]) > void {
    // readsFiles replaces the project baseline, so the next two lines must name every
    // input. The markdown glob mirrors dprint.json `includes`; keep the two in step.
    ctx.readsFiles("dprint.json");
    ctx.modifiesExistingFiles("**/*.md", "**/*.go", "go.mod", "go.sum");
    ctx.needs(generate);
    go["go-fmt"](ctx);
    go["go-mod-tidy"](ctx);
    markdown["dprint"](ctx);
}
// go-vet only: the custom golangci-lint binary is built from this module.
export fun lint(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-vet"](ctx); }
// Compiles every analyzer package; the module root holds none.
export fun build(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-build"](ctx, {"args": ["./..."]}); }
// Links judge-docs, so the pull request guard and the prose checks never wait on the compiler.
// The guard denies a pull request until this has run, and again once the sources move on.
export fun judge_build(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(format);
    // readsFiles replaces the project baseline. judge_docs.buzz computes the digest, so a
    // change to it must relink: a replayed digest from the old code would deny every call.
    ctx.readsFiles("**/*.go", "go.mod", "go.sum", "judge_docs.buzz");
    // Literal, as magus reads outputs statically: judgeDocs\binary and judgeDocs\inputsFile.
    ctx.writesFiles("gen/judge-docs", "gen/judge-docs.inputs");
    go["go-build"](ctx, {"args": ["-trimpath", "-o", judgeDocs\binary, "./cmd/judge-docs"]});
    fs\writeFile(judgeDocs\inputsFile, content: judgeDocs\inputs(".") + "\n");
}
// Runs the suite; the root merges coverage.out into its coverage badge.
export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    ctx.writesFiles("coverage.out");
    go["go-test"](ctx, {"args": ["-covermode=atomic", "-coverprofile=coverage.out", "./..."]});
}

// The anchor `magus affected ci` keys off.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, build, test);
}
