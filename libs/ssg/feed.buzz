// feed.buzz - pure XML builders and date normalization for the sitemap and Atom
// feeds. Flat-imported by render.buzz (`import "lib/feed" as _`).
namespace feed;

import "assert";

// escapeXml is escapeAttr's XML form: five entities, ampersand FIRST so the & each of
// the other four introduces is never rescanned. (This note used to say "& last", which
// is the opposite of both the code and the correct order - replacing it last would turn
// "&lt;" into "&amp;lt;".)
export fun escapeXml(s: str) > str {
    return s.replace("&", with: "&amp;").replace("<", with: "&lt;").replace(">", with: "&gt;")
        .replace("\"", with: "&quot;").replace("'", with: "&apos;");
}

// Minimal XML leaves; every body and value funnels through escapeXml. Container tags
// with their own namespaces (<feed>, <urlset>, <entry>, <url>) stay written inline.
export fun xmlAttribute(name: str, value: str) > str {
    return " " + name + "=\"" + escapeXml(value) + "\"";
}
export fun xmlElementAttribute(tag: str, attrs: str, text: str) > str {
    return "<" + tag + attrs + ">" + escapeXml(text) + "</" + tag + ">";
}
export fun xmlElement(tag: str, text: str) > str {
    return xmlElementAttribute(tag, attrs: "", text: text);
}
export fun xmlSelfClose(tag: str, attrs: str) > str {
    return "<" + tag + attrs + "/>";
}

// atomDate normalizes a frontmatter date to RFC3339 UTC (bare date -> T00:00:00Z).
export fun atomDate(d: str) > str {
    if (d == "") { return ""; }
    if (d.indexOf("T") == null) { return d + "T00:00:00Z"; }
    return d;
}

test "escapeXml substitutes all five XML entities, ampersand-safe" {
    assert\equal(escapeXml("a & b < c > d \" e ' f"),
        want: "a &amp; b &lt; c &gt; d &quot; e &apos; f", message: "all five entities");
    assert\equal(escapeXml("plain"), want: "plain", message: "no-op on safe text");
}

// EVERY occurrence, not one of each. The test above covers all five entities and still
// missed a real defect for months: str.replace substituted only the FIRST match until
// 2026-08-09, so this escaper encoded the first ampersand of a document and left the
// rest raw in the feed. One-of-each fixtures measure thoroughness across CHARACTERS,
// which is the wrong axis - the axis that catches this is repetition.
//
// The shape to copy for any escaper: the character at both edges, adjacent to itself,
// and interleaved with the others.
test "escapeXml substitutes EVERY occurrence, not just the first" {
    assert\equal(escapeXml("&a&b&"), want: "&amp;a&amp;b&amp;", message: "ampersands at both edges and between");
    assert\equal(escapeXml("&&"), want: "&amp;&amp;", message: "adjacent ampersands");
    assert\equal(escapeXml("<a><b>"), want: "&lt;a&gt;&lt;b&gt;", message: "repeated angle brackets");
    assert\equal(escapeXml("\"a\"'b'"), want: "&quot;a&quot;&apos;b&apos;", message: "repeated quotes");
    // Ampersand is replaced FIRST so the & it introduces is never rescanned by the
    // later arms. Replacing it last would turn "&lt;" into "&amp;lt;".
    assert\equal(escapeXml("<&>"), want: "&lt;&amp;&gt;", message: "no double-encoding of introduced entities");
}

test "xml builders wrap and escape" {
    assert\equal(xmlAttribute("rel", value: "self"), want: " rel=\"self\"", message: "attribute with leading space");
    assert\equal(xmlElement("title", text: "a & b"), want: "<title>a &amp; b</title>", message: "element escapes body");
    assert\equal(xmlSelfClose("link", attrs: xmlAttribute("href", value: "u")), want: "<link href=\"u\"/>", message: "self-closing tag");
}

test "atomDate normalizes to RFC3339 UTC" {
    assert\equal(atomDate("2026-07-01"), want: "2026-07-01T00:00:00Z", message: "bare date gets midnight UTC");
    assert\equal(atomDate("2026-07-01T12:00:00Z"), want: "2026-07-01T12:00:00Z", message: "full RFC3339 passes through");
    assert\equal(atomDate(""), want: "", message: "empty stays empty");
}
