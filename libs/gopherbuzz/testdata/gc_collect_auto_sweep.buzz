// @expect: true
// The registry pinned every collectable until the program called gc\collect(), so
// a program that never called it retained all of them. Upstream fires collect()
// when an object becomes garbage rather than when asked, so sweeping unbidden is
// the closer behaviour as well as the bounded one. Note this file never imports
// gc: the sweep must happen with no cooperation from the program.
var collected = 0;

object Tracked {
    id: int,

    fun collect() > void { collected = collected + 1; }
}

var __r: any = null;

fun main(args: [str]) > void !> any {
    var i = 0;
    while (i < 5000) {
        _ = Tracked{ id = i };
        i = i + 1;
    }
    __r = collected > 0;
}
