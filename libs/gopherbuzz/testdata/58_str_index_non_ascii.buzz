// @expect: true
// str.indexOf and str.byte are BYTE-indexed, matching upstream: its indexOf is
// `std.mem.indexOf(u8, ...)` and its byte is `self.string[index]`, both over the raw
// bytes (src/builtin/str.zig).
//
// This fixture used to assert the opposite, and said the rune index was "what the
// language must report". It was pinning a divergence: with rune indexing a method
// literally named `byte` returned a CODE POINT for any non-ASCII character, and len()
// disagreed with the indexes sub() and indexOf() used.
//
// The characters are written literally rather than as \u escapes: Buzz spells string
// interpolation with braces, so \u{00e9} parses as an interpolation of "00e9".
//
// Two multibyte runes (2 and 3 bytes) are what make byte and rune indexing disagree:
// the needle begins at BYTE 10 but at RUNE 7.
final ascii = "abcdefNEEDLE";
final wide = "abéⅢdefNEEDLE";

// Byte offsets. In `ascii` byte and rune coincide at 6; in `wide` the needle is byte 10.
final asciiAt = ascii.indexOf("NEEDLE");
final wideAt = wide.indexOf("NEEDLE");

// byte(i) indexes BYTES, so a multibyte character's lead and continuation bytes are
// each reachable rather than collapsing to one code point.
final asciiByte = ascii.byte(2);        // "c"
final wideLead = wide.byte(2);          // e-acute's LEAD byte 0xC3
final wideCont = wide.byte(3);          // e-acute's continuation byte 0xA9

// Past the end is null on both.
final missing = ascii.indexOf("absent");
final missingWide = wide.indexOf("absent");

// len() agrees with those indexes: it is the byte count, and utf8Len is the rune count.
final wideLen = wide.len();
final wideRunes = wide.utf8Len();

final __r = asciiAt == 6
    and wideAt == 10
    and asciiByte == 99
    and wideLead == 195
    and wideCont == 169
    and missing == null
    and missingWide == null
    and wideLen == 16
    and wideRunes == 13
    and ascii.sub(asciiAt) == "NEEDLE"
    and wide.sub(wideAt) == "NEEDLE";
