// Upstream infers no type arguments at a generic call, so err("not a D")
// is refused at the call before E could be checked against D.
// @error: [BZZ1004] buzz: line 15:15: generic call requires explicit type arguments
object D {
    name: str,
}
object R::<T, E> {
    value: T?,
    error: E?,
}
fun err::<T, E>(e: E) > R::<T, E> {
    return R::<T, E>{ error = e };
}
fun port() > R::<int, D> {
    return err("not a D");
}
final __r = port();
