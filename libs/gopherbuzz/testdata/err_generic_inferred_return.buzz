// Embedded mode infers E from the argument, and it is not a D.
// Upstream mode also reports the missing type arguments at the call.
// @error: want R::<int, D>
object D {
    name: str,
}
object R::<T, E> {
    value: T?,
    error: E?,
}
fun err::<T, E>(e: E) > R::<T, E> {
    return R::<T, E>{ error = e };
}
fun port() > R::<int, D> {
    return err("not a D");
}
final __r = port();
