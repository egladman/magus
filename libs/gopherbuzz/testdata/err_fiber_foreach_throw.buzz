// @error: boom
// An error raised inside a fiber surfaces out of the driving foreach.
var __r: any = null;

fun bad() > void *> int? {
    _ = yield 1;
    throw "boom";
}

fun main(args: [str]) > void !> any {
    var sum = 0;
    foreach (n in &bad()) {
        sum = sum + n;
    }
    __r = sum;
}
