// magusfile.buzz for gopherbuzz, an embedded Go module
// (github.com/egladman/magus/libs/gopherbuzz, at libs/gopherbuzz - a separate module, but its path is
// indicative of where it lives rather than pretending to be standalone). Sets it up as its own magus
// project, scoped to its go.mod.
//
//   magus run build libs/gopherbuzz         compile the package
//   magus run test libs/gopherbuzz          run the Go test suite
//   magus run ci libs/gopherbuzz            lint, build, and test

import "magus";

// go spell: claims **/*.go and the module files. This file's own export-fun targets
// need no declaration - magus binds the magusfile driver to every project.
import "magus/spell/go";
import "../../spells/golang/gomod" as gomod;

// os.exec runs the benchmark; fs reads and writes the profile (Buzz's stdlib has
// neither streaming exec nor raw file IO). vcs.isDirty gates regenerated outputs.
// env.home locates the upstream clone cache for the conformance target.
import "os";
import "fs";
import "vcs";
import "env";

magus\project({
    "spells": [go],
    // Generated catalog; cached so a hit restores it without re-describing.
    "outputs": ["MAGUS.md"],
    "targets": {
        // Drift-gates MAGUS.md via git status: run alone, every time.
        "generate": {"skip_cache": "drift-gates MAGUS.md via git status; a replay would skip the check", "exclusive": true},
        // index-generate renders `magus describe graph -o markdown`, so its output is a
        // function of the WHOLE knowledge graph. Its declared inputs are the magusfiles,
        // which is the only part of that a glob can name, so any other change leaves the
        // key unmoved: a cache hit then replays a MAGUS.md built before it and REVERTS the
        // committed one, which the drift gate above correctly reports as drift. That is why
        // a branch touching the graph fails this gate in CI, where the shared cache is
        // restored, while passing on a clean checkout that has nothing to hit. The docs
        // project carries the same opt-out for the same reason.
        "index-generate": {"skip_cache": "output derives from the entire knowledge graph, which no input glob can key"},
        // Fetches over the network and re-checks upstream out every run.
        "conformance": {"skip_cache": "fetches over the network and re-checks upstream on every run"},
    },
});

// Targets. Each delegates to the go spell's ops; gopherbuzz is a pure library, so the
// pipeline is the Go lifecycle plus index-generate.

export fun preflight(ctx: magus\Context, args: [str]) > void {}

// Regenerates MAGUS.md and fails on drift. Use the rw charm to keep the result.
// Drift = regeneration dirtied a file that was clean, via vcs.isDirty (not a raw
// git/porcelain shell-out), so a locally-regenerated MAGUS.md passes whether or
// not it is committed; only a regeneration that changes a clean file fails.
export fun generate(ctx: magus\Context, args: [str]) > void {
    ctx.needs(preflight);
    gomod\replaceWorkspaceModules(ctx, go, "libs/gopherbuzz");
    final clean_before = vcs\isDirty(["MAGUS.md"]) == false;
    ctx.needs(index_generate);
    if (ctx.has_charm("rw")) { return; }

    if (clean_before == false) {
        magus\info("generate: drift gate skipped - MAGUS.md was already dirty when it started; commit, then re-run to actually check");
    }
    if (clean_before and vcs\isDirty(["MAGUS.md"])) {
        // Print the diff, not just the verdict. This gate fires where its reader has
        // a CI log and no tree, and the index carries workspace-wide counts, so
        // "drifted" alone cannot say whether a count moved or a whole section did.
        if (vcs\name() == "git") {
            final d = vcs\cmd(["diff", "--unified=1", "--", "MAGUS.md"], opts: {"allow_failure": true});
            if (d.stdout != "") { magus\info("generate: what changed on this runner:\n" + d.stdout); }
        }
        throw "generate: MAGUS.md drifted; re-run `magus run generate:rw libs/gopherbuzz` and commit";
    }
}

// Renders MAGUS.md (target catalog plus graph) from this magusfile.
export fun index_generate(ctx: magus\Context, args: [str]) > void {
    final doc = magus\describe(["graph", "-o", "markdown"], {"quiet": true}).stdout;
    fs\writeFile("MAGUS.md", doc + "\n");
}

export fun format(ctx: magus\Context, args: [str]) > void { ctx.needs(generate); go["go-fmt"](ctx); go["go-mod-tidy"](ctx); }
export fun lint(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-vet"](ctx); }
export fun build(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-build"](ctx); }
export fun test(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-test"](ctx); }

// The CLI is independently versioned from the gopherbuzz module tag namespace.
// A local checkout before its first nested tag stays explicitly "dev"; it must
// never inherit the root magus tag just because both modules share one Git repo.
fun module_version() > str {
    final prefix = "libs/gopherbuzz/";
    final tags: [Tag] = vcs\tags(prefix + "v*");
    if (tags.len() == 0) { return "dev"; }
    return tags[0].name.sub(prefix.len());
}

fun buzz_ld_flags() > str {
    // try/catch, not field sniffing: vcs.commit RAISES when there is no VCS or the
    // revision cannot be read, so there is no zero object to inspect. Building outside a
    // checkout (a release tarball, a container context) is the real case this covers.
    var short = "unknown";
    var date = "unknown";
    try {
        final c: Commit = vcs\commit();
        short = c.short;
        date = c.date;
    } catch (e) {
        // leave both as "unknown"
    }
    return "-w -s"
        + " -X main.version=" + module_version()
        + " -X main.commit=" + short
        + " -X main.buildDate=" + date;
}

// Compiles the standalone buzz CLI with the version of this nested module,
// rather than the root magus module's version.
export fun buzz_build(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    go["go-build"](ctx, {"args": ["-trimpath", "-ldflags", buzz_ld_flags(), "-o", "buzz", "./cmd/buzz"]});
}

// The anchor `magus affected ci` keys off; fans out lint/build/test after format.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, build, test);
}

// upstream_pinned_sha extracts the exact commit gopherbuzz was last synced and
// validated against from version.go's UpstreamRef git-describe string
// ("0.5.0-251-ged42f47" -> "ed42f47") - the sha `conformance` checks the
// upstream clone out to before running the Go test.
fun upstream_pinned_sha(version_src: str) > str {
    final marker = "UpstreamRef = \"";
    final start = version_src.indexOf(marker)! + marker.len();
    final rest = version_src.sub(start);
    final describe = rest.sub(0, rest.indexOf("\"")!);
    final parts = describe.split("-g");
    return parts[parts.len() - 1];
}

// Runs the upstream buzz-language/buzz behavior suite through gopherbuzz and
// checks the result against testdata/upstream-behavior-allowlist.txt (see
// conformance_test.go). Opt-in (not part of `ci`): it needs network access and
// a foreign clone, which `magus affected ci` should never require. Never
// vendors upstream's test files into this repo - it fetches a pinned commit
// into a cache directory outside the tree instead, so a later re-run reuses
// (fetches, not re-clones) rather than re-downloading whole history.
export fun conformance(ctx: magus\Context, args: [str]) > void {
    ctx.needs(preflight);

    final pinned = upstream_pinned_sha(fs\readFile("version.go"));
    final cache_dir = fs\join(env\home(), ".cache", "magus", "gopherbuzz-upstream-buzz");

    if (fs\exists(cache_dir)) {
        os\exec("git", ["fetch", "origin"], cache_dir, {});
    } else {
        os\exec("git", ["clone", "https://github.com/buzz-language/buzz", cache_dir], ".", {});
    }
    os\exec("git", ["checkout", pinned], cache_dir, {});

    magus\info("running upstream conformance against {cache_dir} @ {pinned}");
    os\withEnv({"GOPHERBUZZ_UPSTREAM_DIR": cache_dir}, fun() > void {
        os\exec("go", ["test", "-run", "TestUpstreamConformance", "-v", "."], ".", {});
    });
}
