import "magus";
import "../../hack/magusfile/drift" as drift;
import "../../hack/magusfile/index" as index;

import "magus/spell/go";
// Imported for dprint only. Listing it in spells would claim **/*.md, which the root lints.
import "magus/spell/markdown";
import "../../spells/golang/gomod" as gomod;

import "os";
import "proc";
import "fs";
import "flags";
import "vcs";
import "env";

magus\project({
    "spells": [go],
    // No go spell glob matches *.txt. The allowlist is what conformance_test.go treats as
    // the authority, so editing it must rerun test. The .buzz files seed FuzzTokenize.
    "sources": ["testdata/*.txt", "testdata/**/*.buzz", "examples/**/*.buzz"],
    // MAGUS.md is declared on index_generate, not here.
    "targets": {
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
        "conformance": {"skip_cache": "fetches over the network and re-checks upstream on every run"},
        "fuzz": {"skip_cache": "the mutator is randomized, so an unchanged tree can crash on the next run"},
    },
});

// Regenerates MAGUS.md. Without the rw charm it only checks for drift.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    gomod\replaceWorkspaceModules(ctx, go, "libs/gopherbuzz");
    ctx.needs(index_generate);
}

// Renders MAGUS.md, this project's target catalog.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("MAGUS.md");
    ctx.readsFiles("magusfile.buzz", "../../magus.yaml", "../../internal/render/target_graph.go",
                   "../../internal/render/md/md.go", "../../internal/hint/cli_command.go");
    index\render("libs/gopherbuzz");
}

export fun format(ctx: magus\Context, args: [str]) > void {
    // readsFiles replaces the project baseline, so the next two lines must name every
    // input. The markdown glob mirrors dprint.json `includes`; keep the two in step.
    ctx.readsFiles("dprint.json");
    ctx.modifiesExistingFiles("**/*.md", "**/*.go", "go.mod", "go.sum");
    ctx.needs(generate);
    go["go-fmt"](ctx);
    go["go-mod-tidy"](ctx);
    markdown["dprint"](ctx);
}
export fun lint(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-vet"](ctx); }
export fun build(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-build"](ctx); }
// Runs the suite under the default tags, then again under buzz_safe.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(format);
    // Declared so a cache hit leaves the profile the root's coverage badge merges.
    ctx.writesFiles("coverage.out");
    go["go-test"](ctx, {"args": ["-covermode=atomic", "-coverprofile=coverage.out", "./..."]});
    proc\exec("go", ["test", "-tags", "buzz_safe", "./..."]);
}

// Runs the benchmarks/comparison module's tests, which test's ./... skips because that
// directory has its own go.mod. Without the cgo_engines tag only the pure-Go engines
// compile, and without -bench no benchmark runs.
export fun buzzbench_test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    // The module replaces gopherbuzz and diagnostics with their checkouts, so both feed the key.
    ctx.readsFiles("**/*.go", "go.mod", "go.sum",
        "benchmarks/comparison/go.mod", "benchmarks/comparison/go.sum",
        "../diagnostics/**/*.go", "../diagnostics/go.mod");
    go["go-test"](ctx.withCwd("benchmarks/comparison"));
}

// Fuzzes the lexer for 30s; `magus run fuzz libs/gopherbuzz -- --fuzztime 2m` overrides it.
// go refuses -fuzz across packages, so go-test's ./... cannot run this.
export fun fuzz(ctx: magus\Context, args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: [<str>], valued: ["--fuzztime"]);
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "fuzz: unexpected arguments {args.join(" ")}; the only flag is --fuzztime <duration>";
    }
    // A crasher lands as a new file here.
    ctx.writesFiles("token/testdata/fuzz/**");
    go["go-fuzz"](ctx, {"args": ["-fuzz", "FuzzTokenize", "-fuzztime", parsed.values["--fuzztime"] ?? "30s", "./token"]});
}

// Before the first libs/gopherbuzz/v* tag this is "dev", never the root magus tag.
fun module_version() > str !> any {
    final prefix = "libs/gopherbuzz/";
    final tags: [Tag] = vcs\tags(prefix + "v*");
    if (tags.len() == 0) { return "dev"; }
    return tags[0].name.sub(prefix.len());
}

fun buzz_ld_flags() > str !> any {
    var short = "unknown";
    var date = "unknown";
    try {
        final c: Commit = vcs\commit();
        short = c.short;
        date = c.date;
    } catch (e) {
        // vcs.commit raises outside a checkout, such as a release tarball.
    }
    return "-w -s"
        + " -X main.version=" + module_version()
        + " -X main.commit=" + short
        + " -X main.buildDate=" + date;
}

// Compiles the standalone buzz CLI, stamped with this module's version, not magus's.
export fun buzz_build(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(format);
    go["go-build"](ctx, {"args": ["-trimpath", "-ldflags", buzz_ld_flags(), "-o", "buzz", "./cmd/buzz"]});
}

// The anchor `magus affected ci` keys off.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, build, test, buzzbench_test);
}

// "0.5.0-251-ged42f47" -> "ed42f47"
fun upstream_pinned_sha(version_src: str) > str {
    final marker = "UpstreamRef = \"";
    final start = version_src.indexOf(marker)! + marker.len();
    final rest = version_src.sub(start);
    final describe = rest.sub(0, rest.indexOf("\"")!);
    final parts = describe.split("-g");
    return parts[parts.len() - 1];
}

// Runs the upstream buzz suite at the pinned commit against the allowlist.
// Not part of ci: it needs the network and a clone outside the tree.
export fun conformance(ctx: magus\Context, args: [str]) > void !> any {
    final pinned = upstream_pinned_sha(fs\readFile("version.go"));
    final cache_dir = fs\join(env\home(), ".cache", "magus", "gopherbuzz-upstream-buzz");

    if (fs\exists(cache_dir)) {
        proc\exec("git", ["fetch", "origin"], cache_dir, {});
    } else {
        proc\exec("git", ["clone", "https://github.com/buzz-language/buzz", cache_dir], ".", {});
    }
    proc\exec("git", ["checkout", pinned], cache_dir, {});

    magus\log.info("running upstream conformance against {cache_dir} @ {pinned}");
    os\withEnv({"GOPHERBUZZ_UPSTREAM_DIR": cache_dir}, fun() > void !> any {
        proc\exec("go", ["test", "-run", "TestUpstreamConformance", "-v", "."], ".", {});
    });
}
