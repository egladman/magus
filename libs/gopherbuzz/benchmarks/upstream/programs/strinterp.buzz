// String interpolation in a loop: builds a fresh string each iteration.
fun main(_: [str]) > int {
    var last = "";
    var i = 0;
    while (i < 200000) {
        last = "item {i} of many";
        i = i + 1;
    }
    // The whole final string. `len() > 10` passed for any interpolation emitting
    // more than ten bytes, including one that dropped or mangled the {i}.
    return if (last == "item 199999 of many") 0 else 1;
}
