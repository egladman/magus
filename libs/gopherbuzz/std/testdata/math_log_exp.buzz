// log takes (base, n), matching upstream buzz's math.log signature.
// @expect: [0, 2, 1, true]
import "math";

var __r: any = null;

fun main(args: [str]) > void !> any {
    __r = [
        math\log(base: 10.0, n: 1.0),
        math\log(base: 10.0, n: 100.0),
        math\exp(0.0),
        math\exp(1.0) > 2.7,
    ];
}
