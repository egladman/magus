// @expect: 142
// Upstream-compatible Buffer: the Zig/pointer API yeetile's FFI memory ops move
// onto. Exercises ::<T> generic-method-call syntax, writeZAt (byte-offset `at`) /
// readZAt (ELEMENT-INDEX `at`, matching upstream's asymmetry), and collect() —
// the out-param shape (alloc, write at offsets, read back) a C fn would fill in.
import "buffer";

var __r: any = null;

fun main(args: [str]) > void !> any {
    final b = buffer\Buffer.init(16);
    final _wroteLo = b.writeZAt::<int>(at: 0, zigType: "u32", values: [42]);  // byte 0
    final _wroteHi = b.writeZAt::<int>(at: 8, zigType: "i64", values: [100]); // byte 8 (i64-aligned)
    final lo: int = b.readZAt::<int>(at: 0, zigType: "u32"); // element 0 -> byte 0
    final hi: int = b.readZAt::<int>(at: 1, zigType: "i64"); // element 1 -> byte 8
    b.collect();
    __r = lo + hi;
}

