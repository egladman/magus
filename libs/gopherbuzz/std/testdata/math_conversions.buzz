// maxInt/minDouble are two-argument max/min (upstream's math), not constants.
// @expect: [180, 7, 1.5]
import "math";

var __r: any = null;

fun main(args: [str]) > void !> any {
    __r = [
        math\deg(math\pi),
        math\maxInt(a: 3, b: 7),
        math\minDouble(a: 1.5, b: 2.5),
    ];
}
