// No build target: each consumer's esbuild bundles src/ inline.

import "magus";
import "../../hack/drift" as drift;
import "../../hack/index" as index;
import "fs";
import "os";

import "proc";
import "magus/spell/typescript";

import "../../hack/toolchain-policy" as policy;

magus\project({
    "tools": {"node": policy\node},
    "spells": [typescript],
    // Affected tracks this glob, not the import graph, so it names every input.
    "sources": ["src/**/*.ts", "package.json", "pnpm-lock.yaml",
                "tsconfig.json", "biome.json"],
    // MAGUS.md is declared on index_generate, not here.
    "targets": {
        "install": {"skip_cache": "composes the spell's install, whose own entry checks the tree; a replay here would skip that check"},
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
    },
});

// install installs node_modules through the typescript spell's pnpm-install op.
export fun install(ctx: magus\Context, args: [str]) > void !> any { typescript["pnpm-install"](ctx); }

// Regenerates MAGUS.md and fails on drift. Use the rw charm to keep the result.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.needs(index_generate);
}

// Renders MAGUS.md, this project's target catalog.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("MAGUS.md");
    ctx.readsFiles("magusfile.buzz", "../../magus.yaml", "../../internal/render/target_graph.go",
                   "../../internal/render/md/md.go", "../../internal/hint/cli_command.go");
    index\render("libs/textsearch");
}

// lint runs the TypeScript type-check and Biome.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    proc\exec("pnpm", ["run", "typecheck"], ".", {});
    proc\exec("pnpm", ["run", "biome"], ".", {});
}

// test runs the node:test suite over the bundled *.test.ts and leaves an lcov report.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    // Declared so a cache hit restores the report the console merges.
    ctx.writesFiles("coverage.lcov");

    final tests = fs\glob("src/**/*.test.ts");
    var bundle = mut ["exec", "esbuild"];
    foreach (t in tests) { bundle.append(t.value); }
    bundle.append("--bundle"); bundle.append("--platform=node");
    bundle.append("--format=esm"); bundle.append("--sourcemap");
    bundle.append("--outdir=.testcache");
    proc\exec("pnpm", bundle, ".", {});

    // Without --sourcemap above and --enable-source-maps here, lcov names the
    // .testcache bundle instead of src/*.ts.
    var run = mut ["--enable-source-maps", "--experimental-test-coverage",
        "--test-reporter=spec", "--test-reporter-destination=stdout",
        "--test-reporter=lcov", "--test-reporter-destination=coverage.lcov",
        "--test"];
    foreach (b in fs\glob(".testcache/**/*.test.js")) { run.append(b.value); }
    proc\exec("node", run, ".", {});
}

// The anchor `magus affected ci` keys off.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, test);
}
