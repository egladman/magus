// wardrobe.buzz holds what a gopher wears and carries. Each piece is an
// Accessory or a Prop sized from the Rig of the gopher it is drawn on, so
// one hat fits a short gopher and a tall one.
import "gopher";

export object Cloth {
    fill: str,
    shade: str,
}

// wizardHat is a tall cone that bends over at the tip, on a brim tilted
// down to the viewer's right.
export fun wizardHat(cloth: Cloth, tilt: double) > gopher\Accessory {
    return gopher\Accessory{
        layer = gopher\Layer.hat,
        draw = fun (f: gopher\Frames) > str {
            final r = f.rig;
            final w = r.w;
            final h = r.h;
            final cx = w * 0.04;
            final cy = r.top + h * 0.06;
            final parts = mut [`<g transform="rotate({gopher\num(tilt)} {gopher\num(cx)} {gopher\num(cy)})">`];
            parts.append(gopher\ellipse(cx, cy: cy, rx: w * 0.74, ry: w * 0.14, attrs: gopher\paint(cloth.fill, pal: f.pal)));
            parts.append(gopher\ellipse(cx, cy: cy - w * 0.015, rx: w * 0.42, ry: w * 0.06, attrs: `fill="{cloth.shade}"`));
            final cone = [
                gopher\p(cx - w * 0.36, y: cy),
                gopher\p(cx - w * 0.27, y: cy - h * 0.2),
                gopher\p(cx - w * 0.1, y: cy - h * 0.4),
                gopher\p(cx + w * 0.1, y: cy - h * 0.54),
                gopher\p(cx + w * 0.3, y: cy - h * 0.6),
                gopher\p(cx + w * 0.5, y: cy - h * 0.5),
                gopher\p(cx + w * 0.5, y: cy - h * 0.5),
                gopher\p(cx + w * 0.36, y: cy - h * 0.48),
                gopher\p(cx + w * 0.22, y: cy - h * 0.4),
                gopher\p(cx + w * 0.26, y: cy - h * 0.2),
                gopher\p(cx + w * 0.36, y: cy),
                gopher\p(cx, y: cy + w * 0.045),
            ];
            parts.append(gopher\path(gopher\smooth(cone, closed: true), attrs: gopher\paint(cloth.fill, pal: f.pal)));
            parts.append(gopher\path(gopher\smooth([
                gopher\p(cx + w * 0.04, y: cy - h * 0.05),
                gopher\p(cx + w * 0.1, y: cy - h * 0.26),
                gopher\p(cx + w * 0.24, y: cy - h * 0.43),
            ], closed: false), attrs: gopher\line(cloth.shade, width: w * 0.035)));
            parts.append("</g>");
            return parts.join("\n");
        },
    };
}

// brows are bushy tufts over each eye, flaring out and up at the ends.
export fun brows(color: str, shade: str) > gopher\Accessory {
    return gopher\Accessory{
        layer = gopher\Layer.hat,
        draw = fun (f: gopher\Frames) > str {
            final r = f.rig;
            final er = r.eyeR;
            final parts = mut [<str>];
            foreach (s in [-1.0, 1.0]) {
                final ex = s * r.eyeDX;
                final ey = r.eyeY - er * 1.0;
                final tuft = [
                    gopher\p(ex - s * er * 0.85, y: ey + er * 0.35),
                    gopher\p(ex - s * er * 0.7, y: ey - er * 0.1),
                    gopher\p(ex - s * er * 0.35, y: ey - er * 0.35),
                    gopher\p(ex - s * er * 0.05, y: ey - er * 0.75),
                    gopher\p(ex + s * er * 0.2, y: ey - er * 0.45),
                    gopher\p(ex + s * er * 0.55, y: ey - er * 0.85),
                    gopher\p(ex + s * er * 0.75, y: ey - er * 0.45),
                    gopher\p(ex + s * er * 1.35, y: ey - er * 0.6),
                    gopher\p(ex + s * er * 1.1, y: ey - er * 0.15),
                    gopher\p(ex + s * er * 1.6, y: ey + er * 0.1),
                    gopher\p(ex + s * er * 1.1, y: ey + er * 0.3),
                    gopher\p(ex + s * er * 1.35, y: ey + er * 0.6),
                    gopher\p(ex + s * er * 0.75, y: ey + er * 0.4),
                    gopher\p(ex + s * er * 0.2, y: ey + er * 0.3),
                    gopher\p(ex - s * er * 0.35, y: ey + er * 0.45),
                ];
                parts.append(gopher\path(gopher\smooth(tuft, closed: true), attrs: gopher\paint(color, pal: f.pal)));
                parts.append(gopher\path(gopher\smooth([
                    gopher\p(ex - s * er * 0.3, y: ey),
                    gopher\p(ex + s * er * 0.3, y: ey - er * 0.15),
                    gopher\p(ex + s * er * 0.9, y: ey - er * 0.05),
                ], closed: false), attrs: gopher\line(shade, width: er * 0.08)));
            }
            return parts.join("\n");
        },
    };
}

// beard runs from under the nose to a point at the belly. The gopher's
// teeth are drawn back over it.
export fun beard(color: str, shade: str) > gopher\Accessory {
    return gopher\Accessory{
        layer = gopher\Layer.beard,
        draw = fun (f: gopher\Frames) > str {
            final r = f.rig;
            final w = r.w;
            final h = r.h;
            final my = r.muzzleY;
            final half = [
                gopher\p(0.0, y: my + w * 0.04),
                gopher\p(w * 0.08, y: my - w * 0.02),
                gopher\p(w * 0.2, y: my - w * 0.01),
                gopher\p(w * 0.26, y: my + h * 0.08),
                gopher\p(w * 0.23, y: my + h * 0.24),
                gopher\p(w * 0.15, y: my + h * 0.37),
                gopher\p(w * 0.06, y: my + h * 0.46),
            ];
            final outline = gopher\mirror(half).cloneMutable();
            outline.insert(7, value: gopher\p(w * 0.01, y: my + h * 0.53));
            final parts = mut [gopher\path(gopher\smooth(outline, closed: true), attrs: gopher\paint(color, pal: f.pal))];
            foreach (s in [-1.0, 1.0]) {
                parts.append(gopher\path(gopher\smooth([
                    gopher\p(s * w * 0.1, y: my + h * 0.08),
                    gopher\p(s * w * 0.12, y: my + h * 0.24),
                    gopher\p(s * w * 0.05, y: my + h * 0.4),
                ], closed: false), attrs: gopher\line(shade, width: w * 0.018)));
                parts.append(gopher\path(gopher\smooth([
                    gopher\p(s * w * 0.2, y: my + h * 0.06),
                    gopher\p(s * w * 0.21, y: my + h * 0.2),
                    gopher\p(s * w * 0.15, y: my + h * 0.32),
                ], closed: false), attrs: gopher\line(shade, width: w * 0.015)));
            }
            parts.append(gopher\path(gopher\smooth([
                gopher\p(0.0, y: my + h * 0.12),
                gopher\p(w * 0.02, y: my + h * 0.35),
                gopher\p(-w * 0.01, y: my + h * 0.45),
            ], closed: false), attrs: gopher\line(shade, width: w * 0.015)));
            return parts.join("\n");
        },
    };
}

// hood bunches behind the neck, wider than the head, under everything.
export fun hood(cloth: Cloth) > gopher\Accessory {
    return gopher\Accessory{
        layer = gopher\Layer.back,
        draw = fun (f: gopher\Frames) > str {
            final r = f.rig;
            return gopher\ellipse(0.0, cy: r.shoulderY - r.h * 0.1, rx: r.w * 0.6, ry: r.h * 0.15, attrs: gopher\paint(cloth.fill, pal: f.pal));
        },
    };
}

// robe falls from the shoulders and flares to the ground, leaving the toes
// out.
export fun robe(cloth: Cloth) > gopher\Accessory {
    return gopher\Accessory{
        layer = gopher\Layer.robe,
        draw = fun (f: gopher\Frames) > str {
            final r = f.rig;
            final w = r.w;
            final h = r.h;
            final sy = r.shoulderY;
            final half = [
                gopher\p(0.0, y: sy - h * 0.03),
                gopher\p(w * 0.3, y: sy - h * 0.08),
                gopher\p(w * 0.48, y: sy - h * 0.02),
                gopher\p(w * 0.54, y: sy + h * 0.14),
                gopher\p(w * 0.58, y: -h * 0.12),
                gopher\p(w * 0.64, y: -h * 0.02),
                gopher\p(w * 0.4, y: -h * 0.035),
                gopher\p(w * 0.18, y: -h * 0.015),
                gopher\p(0.0, y: -h * 0.03),
            ];
            final parts = mut [gopher\path(gopher\smooth(gopher\mirror(half), closed: true), attrs: gopher\paint(cloth.fill, pal: f.pal))];
            foreach (s in [-1.0, 1.0]) {
                parts.append(gopher\path(gopher\smooth([
                    gopher\p(s * w * 0.3, y: sy + h * 0.12),
                    gopher\p(s * w * 0.34, y: -h * 0.18),
                    gopher\p(s * w * 0.4, y: -h * 0.05),
                ], closed: false), attrs: gopher\line(cloth.shade, width: w * 0.025)));
            }
            return parts.join("\n");
        },
    };
}

// staff is a crooked stick with an orb caught in its fork, stood upright in
// the hand. up and down are how far it runs above and below the hand.
export fun staff(wood: Cloth, orb: str, glint: str, up: double, down: double) > gopher\Prop {
    return gopher\Prop{
        upright = true,
        draw = fun (f: gopher\Frames) > str {
            final w = f.rig.w;
            final sw = w * 0.08;
            final bends = [0.0, 0.012, -0.01, 0.008, -0.012, 0.006, 0.0];
            final right = mut [<gopher\P>];
            final left = mut [<gopher\P>];
            foreach (i, b in bends) {
                final y = -up + (up + down) * wardrobeAlong(i, n: bends.len());
                final thick = sw * (0.75 + 0.25 * wardrobeAlong(i, n: bends.len()));
                right.append(gopher\p(b * w + thick / 2.0, y: y));
                left.append(gopher\p(b * w - thick / 2.0, y: y));
            }
            final outline = mut [<gopher\P>];
            foreach (q in right) {
                outline.append(q);
            }
            for (var i = left.len() - 1; i >= 0; i = i - 1) {
                outline.append(left[i]);
            }
            final orbR = w * 0.12;
            final oy = -up - orbR * 0.75;
            final parts = mut [gopher\path(gopher\smooth(outline, closed: true), attrs: gopher\paint(wood.fill, pal: f.pal))];
            parts.append(gopher\path(gopher\smooth([
                gopher\p(sw * 0.1, y: -up * 0.8),
                gopher\p(-sw * 0.15, y: 0.0),
                gopher\p(sw * 0.1, y: down * 0.8),
            ], closed: false), attrs: gopher\line(wood.shade, width: sw * 0.18)));
            parts.append(gopher\circle(0.0, cy: oy, r: orbR, attrs: gopher\paint(orb, pal: f.pal)));
            parts.append(gopher\ellipse(-orbR * 0.35, cy: oy - orbR * 0.38, rx: orbR * 0.3, ry: orbR * 0.2, attrs: `fill="{glint}"`));
            parts.append(gopher\path(gopher\smooth([
                gopher\p(-orbR * 0.75, y: oy + orbR * 0.35),
                gopher\p(0.0, y: oy + orbR * 1.1),
                gopher\p(orbR * 0.75, y: oy + orbR * 0.35),
            ], closed: false), attrs: gopher\line(wood.fill, width: sw * 0.45)));
            return parts.join("\n");
        },
    };
}

fun wardrobeAlong(i: int, n: int) > double {
    return (0.0 + i) / (0.0 + n - 1);
}

// cube floats over an open palm and bobs with the pose's open.
export fun cube(top: str, left: str, right: str) > gopher\Prop {
    return gopher\Prop{
        upright = true,
        draw = fun (f: gopher\Frames) > str {
            final a = f.rig.w * 0.13;
            final cx = -f.rig.armW * 0.75;
            final cy = -a * 2.6;
            final k = a * 0.866;
            final parts = mut [gopher\move(f, dx: gopher\track(f, pick: fun (q: gopher\Pose) > double => 0.0), dy: gopher\track(f, pick: fun (q: gopher\Pose) > double => -q.open * a * 0.5))];
            parts.append(`<g transform="rotate(-8 {gopher\num(cx)} {gopher\num(cy)})">`);
            parts.append(gopher\path(gopher\polygon([gopher\p(cx, y: cy - a), gopher\p(cx + k, y: cy - a / 2.0), gopher\p(cx, y: cy), gopher\p(cx - k, y: cy - a / 2.0)], closed: true), attrs: gopher\paint(top, pal: f.pal)));
            parts.append(gopher\path(gopher\polygon([gopher\p(cx - k, y: cy - a / 2.0), gopher\p(cx, y: cy), gopher\p(cx, y: cy + a), gopher\p(cx - k, y: cy + a / 2.0)], closed: true), attrs: gopher\paint(left, pal: f.pal)));
            parts.append(gopher\path(gopher\polygon([gopher\p(cx, y: cy), gopher\p(cx + k, y: cy - a / 2.0), gopher\p(cx + k, y: cy + a / 2.0), gopher\p(cx, y: cy + a)], closed: true), attrs: gopher\paint(right, pal: f.pal)));
            parts.append("</g></g>");
            return parts.join("\n");
        },
    };
}
