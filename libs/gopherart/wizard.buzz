// wizard.buzz redraws magus's mascot: a gopher in a wizard's hat and robe,
// a staff in one hand and a cube floating over the open palm of the other.
import "gopher";
import "wardrobe";

export final ROBE = wardrobe\Cloth{ fill = "#3f4646", shade = "#2c3131" };
export final HAT = wardrobe\Cloth{ fill = "#535b5b", shade = "#424949" };
export final WOOD = wardrobe\Cloth{ fill = "#7a573b", shade = "#5a3e29" };

export fun figure() > gopher\Gopher {
    final pal = gopher\Palette{
        body = "#7cb8ab",
        limb = "#7cb8ab",
        ear = "#5f9a8e",
        muzzle = "#e9dccb",
        nose = "#6b4a3f",
        foot = "#7cb8ab",
        outline = "#1c2222",
        outlineWidth = 4.0,
    };
    return gopher\Gopher{
        width = 230.0,
        height = 290.0,
        eyeSize = 0.82,
        reach = 1.45,
        pal = pal,
        sleeve = ROBE.fill,
        openHand = true,
        wear = [
            wardrobe\hood(ROBE),
            wardrobe\robe(ROBE),
            wardrobe\beard("#f7f5ef", shade: "#c9c6bd"),
            wardrobe\wizardHat(HAT, tilt: 10.0),
            wardrobe\brows("#f7f5ef", shade: "#c9c6bd"),
        ],
        leftHand = wardrobe\cube("#b8b8b6", left: "#9a9a98", right: "#7d7d7b"),
        rightHand = wardrobe\staff(WOOD, orb: "#e3a024", glint: "#f7d27a", up: 290.0, down: 80.0),
    };
}

export final STANDING = gopher\Pose{ leftArm = 76.0, rightArm = 66.0, lookX = 0.25, lookY = 0.1 };

// IDLE is the wizard's loop: the cube rises, it glances at it, blinks, and
// settles back where it began.
export final IDLE = [
    STANDING,
    gopher\Pose{ leftArm = 74.0, rightArm = 66.0, lookX = -0.55, lookY = -0.35, open = 1.0 },
    gopher\Pose{ leftArm = 74.0, rightArm = 66.0, lookX = -0.55, lookY = -0.35, open = 1.0, blink = 1.0 },
    gopher\Pose{ leftArm = 73.0, rightArm = 66.0, lookX = 0.1, lookY = 0.0, open = 0.6 },
    STANDING,
];
