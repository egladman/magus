// marks.buzz draws every mark this library ships into one directory:
//
//     magus buzz marks.buzz gen
import "std";
import "gopher";
import "result";
import "safety";
import "wizard";

object Mark {
    name: str,
    figure: gopher\Gopher,
    poses: [gopher\Pose],
    seconds: double = 0.0,
    width: double,
    height: double,
    x: double,
    y: double,
    scale: double = 1.0,
}

fun render(m: Mark, dir: str) > result\Result::<str> {
    final drawn = gopher\draw(m.figure, poses: m.poses, seconds: m.seconds, id: m.name);
    if (drawn.error -> e) {
        return result\Result::<str>{ error = e };
    }
    final svg = gopher\document(m.width, height: m.height, body: gopher\place(drawn.value!, x: m.x, y: m.y, scale: m.scale));
    return gopher\save("{dir}/{m.name}.svg", svg: svg);
}

fun main(args: [str]) > void !> any {
    if (args.len() != 1) {
        throw "usage: magus buzz marks.buzz <dir>";
    }
    final marks = [
        Mark{ name = "wizard", figure = wizard\figure(), poses = [wizard\STANDING], width = 760.0, height = 650.0, x = 370.0, y = 620.0, scale = 1.3 },
        Mark{ name = "safetyscissors-runner", figure = safety\runner(), poses = [safety\RUN[0]], width = 700.0, height = 620.0, x = 380.0, y = 590.0, scale = 1.25 },
        Mark{ name = "safetyscissors-runner-animated", figure = safety\runner(), poses = safety\RUN, seconds = 0.7, width = 700.0, height = 620.0, x = 380.0, y = 590.0, scale = 1.25 },
        Mark{ name = "safetyscissors-sorcerer", figure = safety\sorcerer(), poses = [safety\SORCERER], width = 760.0, height = 650.0, x = 370.0, y = 620.0, scale = 1.3 },
        Mark{ name = "safetyscissors-monitor", figure = safety\monitor(), poses = [safety\MONITOR], width = 640.0, height = 560.0, x = 330.0, y = 530.0, scale = 1.25 },
        Mark{ name = "wizard-animated", figure = wizard\figure(), poses = wizard\IDLE, seconds = 4.0, width = 760.0, height = 650.0, x = 370.0, y = 620.0, scale = 1.3 },
    ];
    foreach (m in marks) {
        final res = render(m, dir: args[0]);
        if (res.error -> e) {
            throw e.message;
        }
        std\print(res.value!);
    }
}
