          sum = sum + item * scale + index;
//        ^^^ reference local 3
//              ^^^ reference local 3
//                    ^^^^ reference local 5
//                           ^^^^^ reference local 2
//                                   ^^^^^ reference local 4
      }
      for (var i = 0; i < 2; i = i + 1) {
//             ^ definition local 6
//               kind Variable
//               display_name i
//               enclosing_symbol scip-buzz buzz . . `main.buzz`/total().
//                    ^ reference local 6
//                           ^ reference local 6
//                               ^ reference local 6
          sum = sum + i;
//        ^^^ reference local 3
//              ^^^ reference local 3
//                    ^ reference local 6
          sum += i;
//        ^^^ reference local 3
//               ^ reference local 6
      }
      if (sum < 0) {
//        ^^^ reference local 3
          throw "negative";
      }
      return sum;
//           ^^^ reference local 3
  }
