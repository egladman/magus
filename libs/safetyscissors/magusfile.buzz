import "fs";
import "magus";
import "../../hack/magusfile/index" as index;
import "../../hack/magusfile/run-golangci" as golangci;

import "magus/spell/go";
import "../../spells/golang/gomod" as gomod;

magus\project({
    "spells": [go],
    // No spell claims .buzz, so this line declares the mark's script a source.
    "sources": ["assets/*.buzz", "*.md"],
    // MAGUS.md is declared on index_generate, not here.
    "targets": {
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
    },
});

// Regenerates MAGUS.md and draws the mark. Without the rw charm it only checks
// MAGUS.md for drift.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    gomod\replaceWorkspaceModules(ctx, go, "libs/safetyscissors");
    ctx.needs(index_generate, mark_generate);
}

// Renders MAGUS.md, this project's target catalog.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["MAGUS.md"]);
    ctx.readsFiles(["magusfile.buzz", "../../magus.yaml", "../../internal/render/target_graph.go",
                    "../../internal/render/md/md.go", "../../internal/hint/cli_command.go"]);
    index\render("libs/safetyscissors");
}

// mark_generate draws the mark into assets/gen/. It clears that directory first,
// so an output dropped from the script leaves no stale SVG behind.
export fun mark_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["assets/*.buzz"]);
    ctx.writesFiles(["assets/gen/*.svg"]);
    fs\removeAll("assets/gen");
    _ = magus\cmd("buzz", args: ["assets/mark.buzz", "assets/gen"]);
}

export fun format(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles(["**/*.go", "go.mod"], editsExistingSource: true);
    ctx.needs(generate);
    go["go-fmt"](ctx);
    go["go-mod-tidy"](ctx);
}
export fun lint(ctx: magus\Context, args: [str]) > void { go["go-vet"](ctx); }
// The tree-wide conventions over this module, through .magus/custom-gcl. The root
// install-linter builds it; this target does not, so a missing binary fails naming it.
export fun golangci_lint(ctx: magus\Context, args: [str]) > void !> any {
    golangci\readLibFiles(ctx);
    golangci\lintLib("libs/safetyscissors", ctx.hasCharm("rw"));
}
// mark_lint type-checks the mark's script and fails on any BZZ diagnostic. --check
// exits 0 on a warning, so mark_lint grades the output itself.
export fun mark_lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["assets/*.buzz"]);
    final res = magus\cmd("buzz", args: ["--check", "assets/mark.buzz"], opts: magus\CommandOptions{quiet = true});
    final found = mut [<str>];
    foreach (line in res.stderr.split("\n")) {
        if (line.indexOf("[BZZ") != null) {
            found.append(line);
        }
    }
    if (found.len() > 0) {
        foreach (line in found) {
            magus\log.error(line);
        }
        throw "mark_lint: buzz --check reported {found.len()} diagnostic(s)";
    }
}
export fun build(ctx: magus\Context, args: [str]) > void { go["go-build"](ctx); }
// Runs the suite on encoding/json, the build without the experiment; the root merges
// coverage.out into its coverage badge. The experiment is turned off by name, since the
// workspace's own environment turns it on.
export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles(["coverage.out"]);
    go["go-test"](ctx.withEnv({"GOEXPERIMENT": "nojsonv2"}),
                  {"args": ["-covermode=atomic", "-coverprofile=coverage.out", "./..."]});
}
// Runs the same suite on encoding/json/v2: every module type holds only while both
// builds pass it unchanged.
export fun test_jsonv2(ctx: magus\Context, args: [str]) > void {
    go["go-test"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./..."]});
}
// mark_test runs the mark script's in-file test blocks.
export fun mark_test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["assets/*.buzz"]);
    _ = magus\cmd("buzz", args: ["-t", "assets/mark.buzz"]);
}

// The anchor `magus affected ci` keys off.
export fun ci(ctx: magus\Context, args: [str]) > void {
    // Only ci rewrites files: format first, so lint, build and test read the formatted tree.
    ctx.needs(format);
    ctx.needs(lint, build, test, test_jsonv2, mark_lint, mark_test);
}
