// magusfile.buzz for the diagram renderer at libs/diagram - the Buzz library that turns a
// declared figure into SVG, and the validator that refuses to draw an unreadable one.
// flow.buzz beside it lays a declared graph out for an author who places nothing.
// The design system is cathrynlavery/diagram-design (MIT); diagram.buzz's header says what it takes.
//
// Registered as its own first-class project for the same reason libs/textsearch is: it is
// shared SOURCE with its own test suite, and `magus affected ci` should run that suite when
// the library changes rather than only when a consumer happens to be rebuilt.
//
//   magus run lint libs/diagram   strict type check, warnings fail
//   magus run test libs/diagram   run the in-file test blocks
//   magus run ci libs/diagram     lint, then test
//
// There is deliberately NO build target. The library ships no artifact; docs/ imports the
// source directly (docs/site/diagrams/*.buzz and docs/engine/page.buzz), and the committed
// SVG pair is written by the docs project's own diagrams-generate.
//
// It is NOT a spell. A spell adapts an external tool and hands a project type its ops; this
// adapts nothing and is called as a library, so libs/ is the honest home.
import "magus";
import "../../hack/index" as index;

magus\project({
    // The renderer and flow.buzz, the layout built on it; each carries its tests as
    // `test "..."` blocks. No spell claims .buzz, so this is what makes them declared
    // sources at all.
    "sources": ["*.buzz"],
    "targets": {
        // Regenerates MAGUS.md, which the engine drift-gates as a declared output.
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
    },
});

// Regenerates MAGUS.md and fails on drift. Use the rw charm to keep the result.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(index_generate);
}

// Renders MAGUS.md, this project's target catalog. The declarations stay here; the
// body and the reasons for them are in hack/index.buzz.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("MAGUS.md");
    ctx.readsFiles("magusfile.buzz", "../../magus.yaml", "../../internal/render/target_graph.go",
                   "../../internal/render/md/md.go", "../../internal/hint/cli_command.go");
    index\render("libs/diagram");
}

// test runs the in-file test blocks. --embedded because the suite calls module-private
// helpers (connectorPath, attachPoint) directly rather than only the exported surface -
// the routing rules are what break, and they are not reachable from outside.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("*.buzz");
    magus\cmd("buzz", args: ["-t", "--embedded", "diagram.buzz"]);
    // flow.buzz imports the renderer by its workspace-root path, and `magus buzz` resolves
    // imports against its working directory.
    magus\cmd("buzz", args: ["-t", "--embedded", "libs/diagram/flow.buzz"], opts: {"dir": "../.."});
}

// lint type-checks both files upstream-strict, as a figure author's `magus buzz` runs them,
// and fails on any BZZ diagnostic. --check itself exits 0 on a warning, so the captured
// output is graded here; an error already exits nonzero and raises out of magus\cmd.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("diagram.buzz", "flow.buzz");
    // From the root, for the reason test gives: flow.buzz imports the renderer by that path.
    final res = magus\cmd("buzz", args: ["--check", "libs/diagram/diagram.buzz", "libs/diagram/flow.buzz"],
        opts: {"dir": "../..", "quiet": true});
    final found = mut [<str>];
    foreach (line in res.stderr.split("\n")) {
        if (line.indexOf("[BZZ") != null) {
            found.append(line);
        }
    }
    if (found.len() > 0) {
        foreach (line in found) {
            magus\log.error(line);
        }
        throw "lint: buzz --check reported {found.len()} diagnostic(s)";
    }
}

// ci runs lint before test, so a type error fails in seconds rather than after the suite.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(generate);
    ctx.needs(lint);
    ctx.needs(test);
}
