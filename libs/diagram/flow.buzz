            ObservedNode{ id = "pkg-internal-handler-status", label = "internal/handler/status", anchor = "internal/handler/status" },
            ObservedNode{ id = "pkg-internal-handler-token", label = "internal/handler/token", anchor = "internal/handler/token" },
            ObservedNode{ id = "pkg-internal-handler-tool", label = "internal/handler/tool", anchor = "internal/handler/tool" },
            ObservedNode{ id = "pkg-internal-handler-trailrpc", label = "internal/handler/trailrpc", anchor = "internal/handler/trailrpc" },
            ObservedNode{ id = "pkg-internal-handler-viewer", label = "internal/handler/viewer", anchor = "internal/handler/viewer" },
            ObservedNode{ id = "pkg-internal-httpx", label = "internal/httpx", anchor = "internal/httpx" },
            ObservedNode{ id = "pkg-internal-server", label = "internal/server", anchor = "internal/server" },
        ],
        edges = [
            ObservedEdge{ src = "pkg-internal-handler-graph", dst = "pkg-internal-httpx" },
            ObservedEdge{ src = "pkg-internal-handler-viewer", dst = "pkg-internal-httpx" },
