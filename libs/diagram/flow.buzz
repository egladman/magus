// serverHttpOmitting is the twin over the whole scope, leaving out the twelve handler
// packages with the reasons docs/site/diagrams/server-http.buzz gives. The six imports left
// run against the request path the figure claims, so each is hidden with its reason.
fun serverHttpOmitting() > mut Flow {
    final connect = "a Connect service, inside the Connect RPC box";
    final mounts = "the server mounts every handler; the figure draws the request path";
    return serverHttpTwin(observed: serverHttpObserved())
        .omitEdge("reads", dst: "guard", why: "the read views use guard helpers; requests run the other way")
        .omitEdge("health", dst: "guard", why: "the server builds the guard; drawn, the unguarded probe would pass through it")
        .omitEdge("health", dst: "reads", why: mounts)
        .omitEdge("health", dst: "mcp", why: mounts)
        .omitEdge("health", dst: "connect", why: mounts)
        .omitEdge("health", dst: "review", why: mounts)
        .omit("internal/handler/activity", why: connect)
        .omit("internal/handler/attention", why: "a read route, inside the /api/v1 read views box")
        .omit("internal/handler/diff", why: "the diff and session routes, inside the review + plans box")
        .omit("internal/handler/insight", why: "a read route and Connect service, inside the read views box")
        .omit("internal/handler/job", why: connect)
        .omit("internal/handler/memory", why: connect)
        .omit("internal/handler/notes", why: connect)
        .omit("internal/handler/plan", why: "the plan route, inside the review + plans box")
        .omit("internal/handler/token", why: connect)
        .omit("internal/handler/tool", why: connect)
        .omit("internal/handler/trailrpc", why: "the audit interceptor around Connect services, not a route")
        .omit("internal/handler/viewer", why: "read routes and a Connect service, inside the read views box");
}

test "the server-http twin over its whole scope lays out clean once it omits the handlers it folds" {
    final msg = thrown(serverHttpOmitting());
    std\assert(msg == "", message: "composed: {msg}");
    final d = serverHttpOmitting().diagram() catch Diagram{};
    std\assert(d.generated == false, message: "authored budgets apply");
    std\assert(d.nodes.len() == 9 and d.edges.len() == 7, message: "nine boxes, seven connectors: {d.nodes.len()}, {d.edges.len()}");
    std\assert(nodeOf(d, id: "guard").anchor == "internal/httpx", message: "the declared id kept");
    std\assert(d.omits.size() == 12, message: "every omit kept");
    std\assert(validate(d).len() == 0 and properCrossings(d) == 0, message: "clean");
}

fun decisionTree(down: bool) > mut Flow {
    final f = fig()
        .node("start").node("q", label: "which?", role: Role.decision).node("r", label: "again?", role: Role.decision)
        .node("a").node("b").node("c").node("d")
        .edge("start", dst: "q").edge("q", dst: "a").edge("q", dst: "r").edge("q", dst: "b")
        .edge("r", dst: "c").edge("r", dst: "d");
    if (down) { f.down(); }
    return f;
}

test "a decision leaves by its vertices, one connector each" {
    foreach (down in [false, true]) {
        final d = decisionTree(down).diagram() catch Diagram{};
        std\assert(validate(d).len() == 0, message: "down={down}: {validate(d)}");
        foreach (id in ["q", "r"]) {
            final sides: mut {str: bool} = mut {<str: bool>};
            foreach (e in d.edges) {
                if (e.src == id) {
                    std\assert(e.srcSlots == 1, message: "down={down}: {e.src}->{e.dst} fans");
                    std\assert(sides[e.srcSide] == null, message: "down={down}: {id} leaves {e.srcSide} twice");
                    sides[e.srcSide] = true;
                }
                if (e.dst == id) { std\assert(e.dstSlots == 1, message: "down={down}: {e.src}->{e.dst} fans in"); }
            }
        }
        foreach (e in d.edges) {
            foreach (leg in edgeLegs(d, e: e)) {
                foreach (n in d.nodes) {
                    std\assert(legEntersBox(leg, n: n) == false, message: "down={down}: {e.src}->{e.dst} runs through {n.id}");
                }
            }
        }
    }
}

test "a decision's faults are refused as declarations" {
    final text = thrown(fig().node("q", sub: "why", role: Role.decision).node("a").edge("q", dst: "a"));
    std\assert(text == "flow \"t\": node \"q\" is a Role.decision with a tag or sub; drop them from node(\"q\"), a diamond has room for neither",
        message: "text: {text}");
    final f = fig().node("q", role: Role.decision);
    foreach (id in ["a", "b", "c", "d"]) { f.node(id).edge("q", dst: id); }
    std\assert(thrown(f).indexOf("node \"q\" has 4 exits; a Role.decision takes 3, so nest a second decision node") != null, message: "exits: {thrown(f)}");
}

test "two declared boxes may share the anchor of one observed package" {
    final o = Observed{ nodes = [ObservedNode{ id = "pkg-a", label = "pkg/a", anchor = "pkg/a" }] };
    final f = fig(observed: o)
        .node("contract", label: "Contract", anchor: "pkg/a")
        .node("quote", label: "Quote", anchor: "pkg/a")
        .edge("contract", dst: "quote");
    std\assert(thrown(f) == "", message: "no finding: {thrown(f)}");
    final d = f.diagram() catch Diagram{};
    std\assert(d.nodes.len() == 2, message: "the observation merged into one of them: {d.nodes.len()}");
}

test "merging an observation keeps the declaration's order" {
    final d = fig(observed: pair())
        .node("b", label: "B").node("a", label: "A").node("c")
        .diagram() catch Diagram{};
    final ids: mut [str] = mut [<str>];
    foreach (n in d.nodes) { ids.append(n.id); }
    std\assert(ids.join(",") == "b,a,c", message: "declared order: {ids.join(",")}");
    final extra = fig(observed: pair()).node("z").diagram() catch Diagram{};
    std\assert(extra.nodes[0].id == "z" and extra.nodes[1].id == "a", message: "observed-only boxes follow the declared ones");
}

test "a rank no zone reaches centers between the bands" {
    final d = fig()
        .node("s").node("a1").node("a2").node("b1").node("b2")
        .edge("s", dst: "a1").edge("a1", dst: "a2").edge("s", dst: "b1").edge("b1", dst: "b2")
        .zone("one", members: ["a1", "a2"]).zone("two", members: ["b1", "b2"])
        .diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {validate(d)}");
    final s = nodeOf(d, id: "s");
    final mid = s.y + s.h / 2;
    std\assert(mid > d.zones[0].y + d.zones[0].h and mid < d.zones[1].y, message: "s sits between the bands at {mid}");
}

test "a zone's box never takes in a rank it spans without a member there" {
    final d = fig()
        .node("p").node("m").node("q")
        .edge("p", dst: "m").edge("m", dst: "q")
        .zone("pair", members: ["p", "q"])
        .diagram() catch Diagram{};
    final m = nodeOf(d, id: "m");
    final z = d.zones[0];
    std\assert(m.y >= z.y + z.h or m.y + m.h <= z.y, message: "m sits outside the band's box");
}

test "edge roles map onto the renderer's treatments" {
    final d = fig().node("a").node("b").node("c").node("d")
        .edge("a", dst: "b", role: EdgeRole.focal)
        .edge("a", dst: "c", role: EdgeRole.external)
        .edge("a", dst: "d", role: EdgeRole.optional)
        .diagram() catch Diagram{};
    std\assert(d.edges[0].kind == "accent" and d.edges[0].dashed == false, message: "focal is the accent");
    std\assert(d.edges[1].kind == "link" and d.edges[1].dashed == false, message: "external is the link colour");
    std\assert(d.edges[2].kind == "default" and d.edges[2].dashed, message: "optional is dashed");
    std\assert(d.edges[0].claim == "flow", message: "a declared edge claims flow by default");
}

// The checker accepts a str where an enum is declared; the old string surface must still
// fail loudly rather than paint a null role.
test "a string where a Role, EdgeRole or Claim belongs is a finding" {
    final msg = thrown(fig().node("a", role: "focal").node("b").edge("a", dst: "b", role: "focal", claim: "imports").legend("focal", label: "x"));
    final want = [
        "flow \"t\": node \"a\" takes role: Role.<case>, not a string; name the case",
        "flow \"t\": edge \"a\" -> \"b\" takes role: EdgeRole.<case>, not a string; name the case",
        "flow \"t\": edge \"a\" -> \"b\" takes claim: Claim.<case>, not a string; name the case",
        "flow \"t\": legend \"x\" takes Role.<case>, not a string; name the case",
    ];
    std\assert(msg == want.join("\n"), message: "stringly: {msg}");
}

test "a node links outside the repo or anchors inside it, never both" {
    final d = fig().node("stripe", label: "Stripe", role: Role.external, link: "https://stripe.com/docs").diagram() catch Diagram{};
    std\assert(nodeOf(d, id: "stripe").link == "https://stripe.com/docs", message: "the link reaches the node");
    final both = thrown(fig().node("a", anchor: "pkg/a", link: "https://example.com"));
    std\assert(both == "flow \"t\": node \"a\" sets both anchor and link; keep anchor for a path in this repo, link for anything outside it",
        message: "both: {both}");
}

test "a figure says what code it depicts, or why it depicts none" {
    final bare = thrown(flow("t").node("a"));
    std\assert(bare == "flow \"t\": names no code; add scope([...]) or unscoped(why:)", message: "bare: {bare}");
    std\assert(thrown(flow("t").node("a").scope(["pkg/a"])) == "", message: "a scope names code");
    std\assert(thrown(flow("t").node("a").generated()) == "", message: "a generated figure needs neither");
    final d = flow("t").node("a").unscoped("a decision a person makes").diagram() catch Diagram{};
    std\assert(d.unscoped == "a decision a person makes", message: "the reason reaches the Diagram: {d.unscoped}");
    final silent = thrown(flow("t").node("a").unscoped(""));
    std\assert(silent == "flow \"t\": unscoped gives no reason; say why in unscoped(why:)", message: "silent: {silent}");
    final both = thrown(flow("t").node("a").scope(["pkg/a"]).unscoped("both"));
    std\assert(both == "flow \"t\": declares both scope([...]) and unscoped(why:); keep one", message: "both: {both}");
}

test "a boundary paints as a trust boundary and counts against the band budget" {
    final f = fig().node("a").node("b").node("c").edge("a", dst: "b").edge("a", dst: "c")
        .boundary("trusted", members: ["b", "c"]);
    final d = f.diagram() catch Diagram{};
    std\assert(d.zones.len() == 1 and d.zones[0].boundary, message: "one boundary band: {thrown(f)}");
    final svg = f.svg(lightPalette()) catch "threw";
    std\assert(svg.indexOf("stroke-dasharray=\"4,4\"") != null and svg.indexOf(">TRUSTED</text>") != null, message: "the security treatment");
    final many = fig().node("a").node("b").node("c").node("d")
        .zone("one", members: ["a"]).zone("two", members: ["b"])
        .boundary("three", members: ["c"]).boundary("four", members: ["d"]);
    std\assert(thrown(many).indexOf("4 zones and boundaries exceed the budget of 3") != null, message: "budget: {thrown(many)}");
}

test "constraints that hold lay out, and ones that contradict are refused" {
    std\assert(thrown(diamond().rank(["b", "c"]).order(["c", "b"]).row(["a", "d"])) == "", message: "a consistent set: {thrown(diamond().rank(["b", "c"]))}");
    final path = thrown(diamond().rank(["a", "d"]));
    std\assert(path == "flow \"t\": rank([\"a\", \"d\"]) contradicts the path \"a\" -> \"d\"; drop one of them from rank([...])", message: "path: {path}");
    final chained = thrown(diamond().rank(["a", "x"]).rank(["x", "b"]).node("x"));
    std\assert(chained.indexOf("rank([\"a\", \"b\", \"x\"]) contradicts the path \"a\" -> \"b\"") != null, message: "chained: {chained}");
    final unknown = thrown(diamond().row(["a", "zz"]));
    std\assert(unknown == "flow \"t\": row([\"a\", \"zz\"]) names \"zz\", which no node declares; declare node(\"zz\") or drop it from row([...])", message: "unknown: {unknown}");
    final lone = thrown(diamond().order(["a"]));
    std\assert(lone == "flow \"t\": order([\"a\"]) relates fewer than two nodes; name two or more, or drop it", message: "lone: {lone}");
    final cycle = thrown(diamond().order(["b", "c"]).order(["c", "b"]));
    std\assert(cycle == "flow \"t\": order puts \"b\", \"c\" each before the other; drop the order([...]) that reverses them", message: "cycle: {cycle}");
    final across = thrown(diamond().order(["a", "b"]));
    std\assert(across.indexOf("order([\"a\", \"b\"]) names \"a\" and \"b\", which a path puts in different ranks") != null, message: "across: {across}");
    final apart = thrown(fig().node("x").node("y").node("p").node("q").edge("x", dst: "y").edge("p", dst: "q").order(["x", "q"]));
    std\assert(apart.indexOf("which sit in different ranks; add rank([...]) with both or drop the order") != null, message: "apart: {apart}");
    final zoned = thrown(diamond().zone("one", members: ["c"]).zone("two", members: ["b"]).order(["b", "c"]));
    std\assert(zoned.indexOf("order([\"b\", \"c\"]) puts \"b\" first, but zone \"two\" stacks after zone \"one\"") != null, message: "zoned: {zoned}");
    final ranked = thrown(diamond().row(["b", "c"]));
    std\assert(ranked.indexOf("row([\"b\", \"c\"]) names \"b\" and \"c\", which share a rank") != null, message: "ranked: {ranked}");
    final banded = thrown(diamond().zone("one", members: ["a"]).zone("two", members: ["d"]).row(["a", "d"]));
    std\assert(banded.indexOf("names \"a\" in zone \"one\" and \"d\" in zone \"two\"; bands never share a row") != null, message: "banded: {banded}");
}

test "every finding names the figure, one per line, with a fix" {
    final msg = thrown(flow("t").node("a").node("a").edge("a", dst: "z"));
    final lines = msg.split("\n");
    std\assert(lines.len() == 3, message: "three findings: {msg}");
    foreach (line in lines) {
        std\assert(line.startsWith("flow \"t\": ") and line.indexOf("; ") != null, message: "voiced: {line}");
    }
}

test "a layout fault reaches the author as a layout bug, never as a bend to move" {
    final got = layoutFindings([
        Fault{ rule = "sameLine", subjects = ["a", "b", "c", "d"], text = "connectors a->b and c->d run along the same line", fix = "offset one of their bends" },
        Fault{ rule = "bend", subjects = ["a", "b"], text = "edge a->b: a leg leaves 4px for a bend that needs 6", fix = "move the bend or the boxes" },
        Fault{ rule = "overlap", subjects = ["a", "b"], text = "nodes \"a\" and \"b\" overlap" },
    ]);
    std\assert(got[0] == "edges \"a\" -> \"b\" and \"c\" -> \"d\" cannot be routed apart; layout bug, report it", message: "{got[0]}");
    std\assert(got[1] == "edge \"a\" -> \"b\" has a leg too short to bend; layout bug, report it", message: "{got[1]}");
    std\assert(got[2] == "nodes \"a\" and \"b\" overlap; layout bug, report it", message: "{got[2]}");
    foreach (line in got) { std\assert(line.indexOf("move") == null, message: "no bend to move: {line}"); }
}
