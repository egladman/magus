// magusfile.buzz for diagnostics, a standalone Go module (github.com/egladman/magus/libs/diagnostics) at
// libs/diagnostics: the shared diagnostic-code framework both magus and gopherbuzz depend
// on. Its own module (not part of the magus module) so gopherbuzz - a separate
// module - can consume it without depending on magus. Set up as its own magus
// project, scoped to its go.mod.
//
//   magus run build libs/diagnostics   compile the package
//   magus run test libs/diagnostics    run the Go test suite
//   magus run ci libs/diagnostics      lint, build, and test

import "magus";
import "../../tools/drift" as drift;

// go spell claims **/*.go and the module files. This file's own export-fun targets
// need no declaration - magus binds the magusfile driver to every project.
import "magus/spell/go";
import "../../spells/golang/gomod" as gomod;

import "fs";

magus\project({
    "spells": [go],
    // MAGUS.md is declared per-target on index_generate, not here: see the root magusfile.
    "targets": {
        // Regenerates MAGUS.md, which the engine drift-gates as a declared output.
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
    },
});

// A pure library, so the pipeline is the Go lifecycle plus index-generate. Each target
// delegates to the go spell's ops. The Go-lifecycle targets take a magus\Context and
// declare their dependencies through it (ctx.needs); generate/index_generate keep the
// old global-magus form (per-target policy and fs/vcs side effects).

// Regenerates MAGUS.md. Use the rw charm to keep the result; without it the engine's drift
// gate compares what regeneration produced against what is committed. The gate is not
// written here: index_generate declares MAGUS.md as its output, which is the whole
// declaration magus needs to check it.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    gomod\replaceWorkspaceModules(ctx, go, "libs/diagnostics");
    ctx.needs(index_generate);
}

// Renders MAGUS.md, this project's target catalog, from this magusfile.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    // Declared so `magus vcs resolve` can find the target that settles a conflict here.
    ctx.writesFiles("MAGUS.md");
    // Scoped to this project; see libs/coldread for why these are its inputs.
    ctx.readsFiles("magusfile.buzz", "../../magus.yaml", "../../internal/render/target_graph.go",
                   "../../internal/render/md/md.go", "../../internal/hint/cli_command.go");
    final doc = magus\describe(["graph", "-o", "markdown", "libs/diagnostics"], {"quiet": true}).stdout;
    fs\writeFile("MAGUS.md", doc + "\n");
}

export fun format(ctx: magus\Context, args: [str]) > void { ctx.needs(generate); go["go-fmt"](ctx); go["go-mod-tidy"](ctx); }
export fun lint(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-vet"](ctx); }
export fun build(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-build"](ctx); }
// The profile is a declared output: the root's coverage badge is one figure over every
// Go module, merged from each module's own run rather than re-measured.
export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    ctx.writesFiles("coverage.out");
    go["go-test"](ctx, {"args": ["-covermode=atomic", "-coverprofile=coverage.out", "./..."]});
}

// The anchor `magus affected ci` keys off; fans out lint/build/test after format.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, build, test);
}
