// policy reads a project's analyzers.yaml: one top-level key per analyzer, each holding
// settings, baseline and exits, plus zones. A person types the file; the runner only
// reads it.
namespace policy;

import "std";
import "fs";
import "result";
import "encoding/yaml";
import "libs/analyzer/finding" as finding;

export final FILE = "analyzers.yaml";

// ZONES is the one top-level key that names no analyzer.
final ZONES = "zones";

final KEYS = {"settings": true, "baseline": true, "exits": true};

// Policy is one analyzer's block. baseline and exits are kept as typed: each analyzer
// reads its own rows until the runner applies one row shape for all.
export object Policy {
    settings: {str: any} = {<str: any>},
    baseline: any = null,
    exits: any = null,
}

// file is the workspace path of project's analyzers.yaml.
export fun file(project: str) > str {
    return if (project == ".") FILE else project + "/" + FILE;
}

// owner is the project holding path: the deepest project root path sits under, or "."
// for the root project.
export fun owner(path: str, projects: [str]) > str {
    var best = ".";
    foreach (p in projects) {
        if (p != "." and path.startsWith(p + "/") and (best == "." or p.len() > best.len())) {
            best = p;
        }
    }
    return best;
}

// parse reads text, the content of the file at path, into each analyzer's Policy. It
// refuses a top-level value that is not a mapping and a key beside settings, baseline
// and exits, naming path.
export fun parse(text: str, path: str) > result\Result::<{str: Policy}> {
    try {
        final got = mut {<str: Policy>};
        final parsed = yaml\parse(text);
        if (parsed == null) {
            return result\ok::<{str: Policy}>(got);
        }
        if (parsed is {str: any}) {
            final doc: {str: any} = parsed;
            foreach (name, block in doc) {
                if (name == ZONES) {
                    continue;
                }
                final read = blockOf(block, name: name, path: path);
                if (read.error != null) {
                    return result\Result::<{str: Policy}>{ error = read.error };
                }
                got[name] = read.value!;
            }
            return result\ok::<{str: Policy}>(got);
        }
        return result\fail::<{str: Policy}>("{path}: the top level is not a mapping of analyzer names");
    } catch (err: any) {
        return result\caught::<{str: Policy}>(err, doing: "policy: parse {path}");
    }
}

// blockOf is the Policy under name, one top-level key of path.
fun blockOf(block: any, name: str, path: str) > result\Result::<Policy> {
    if (block == null) {
        return result\ok::<Policy>(Policy{});
    }
    if (block is {str: any}) {
        final fields: {str: any} = block;
        foreach (key, _ in fields) {
            if (KEYS[key] == null) {
                return result\fail::<Policy>("{path}: {name}.{key} is not a policy key; an analyzer's block holds settings, baseline and exits");
            }
        }
        var settings = {<str: any>};
        final raw = fields["settings"];
        if (raw != null) {
            if (raw is {str: any}) {
                settings = raw;
            } else {
                return result\fail::<Policy>("{path}: {name}.settings is not a mapping");
            }
        }
        return result\ok::<Policy>(Policy{ settings = settings, baseline = fields["baseline"], exits = fields["exits"] });
    }
    return result\fail::<Policy>("{path}: {name} is not a mapping of settings, baseline and exits");
}

// read is the policy of project under root. A project with no analyzers.yaml has none,
// which leaves every analyzer strict.
export fun read(project: str, root: str = ".") > result\Result::<{str: Policy}> {
    try {
        final path = file(project);
        final full = if (root == ".") path else root + "/" + path;
        if (!fs\exists(full)) {
            return result\ok::<{str: Policy}>({<str: Policy>});
        }
        return parse(fs\readFile(full), path: path);
    } catch (err: any) {
        return result\caught::<{str: Policy}>(err, doing: "policy: read {project}");
    }
}

// Row is one baseline or exits row. item "" names the whole file; count is how many
// findings a baseline row absorbs; reason is what an exit is kept for.
export object Row {
    path: str,
    item: str = "",
    count: int = 1,
    reason: str = "",
}

final ROW_KEYS = {"path": true, "item": true, "count": true, "reason": true};

// rows reads one analyzer's list under key as Rows. A row of any other shape becomes
// a finding at file and is left out of the rows.
fun rows(raw: any, name: str, key: str, file: str, problems: mut [finding\Finding]) > [Row] {
    final got = mut [<Row>];
    if (raw == null) {
        return got;
    }
    if (!(raw is [any])) {
        problems.append(finding\Finding{ analyzer = name, path = file, message = "{name}.{key} is not a list of rows",
            fix = "Write {name}.{key} as a list of rows with a path, an item and a count." });
        return got;
    }
    final list: [any] = raw;
    foreach (i, row in list) {
        final bad = rowProblem(row, key: key);
        if (bad != "") {
            problems.append(finding\Finding{ analyzer = name, path = file, message = "{name}.{key}[{i}] {bad}",
                fix = "Write each row with a path, an item and a count; an exit also carries a reason." });
            continue;
        }
        final fields: {str: any} = row;
        final item = fields["item"];
        final count = fields["count"];
        final reason = fields["reason"];
        got.append(Row{ path = fields["path"], item = if (item is str) item else "", count = if (count is int) count else 1,
            reason = if (reason is str) reason else "" });
    }
    return got;
}

// rowProblem says why row is not a row of key, or "" when it is one.
fun rowProblem(row: any, key: str) > str {
    if (!(row is {str: any})) {
        return "is not a mapping";
    }
    final fields: {str: any} = row;
    foreach (field, _ in fields) {
        if (ROW_KEYS[field] == null) {
            return "has the field {field}, which no row holds";
        }
    }
    if (!(fields["path"] is str)) {
        return "has no path";
    }
    if (fields["item"] != null and !(fields["item"] is str)) {
        return "has an item that is not a string";
    }
    if (key == "baseline") {
        if (fields["reason"] != null) {
            return "has a reason; only an exit carries one";
        }
        if (fields["count"] != null and (!(fields["count"] is int) or std\toInt(fields["count"]) < 1)) {
            return "has a count that is not a whole number of 1 or more";
        }
    } else {
        if (fields["count"] != null) {
            return "has a count; only a baseline row carries one";
        }
        final reason = fields["reason"];
        if (!(reason is str)) {
            return "has no reason";
        }
        final text: str = reason;
        if (text.trim() == "") {
            return "has no reason";
        }
    }
    return "";
}

// apply is found with policy.exits applied, then policy.baseline. An exit drops the
// findings at its path and item. A baseline row absorbs up to its count.
// An unsound row is a finding at file: a bad shape, an exit that excuses nothing, a
// baseline count above what it absorbed.
export fun apply(name: str, found: [finding\Finding], policy: Policy, file: str) > [finding\Finding] {
    final problems = mut [<finding\Finding>];
    final exits = rows(policy.exits, name: name, key: "exits", file: file, problems: problems);
    final baseline = rows(policy.baseline, name: name, key: "baseline", file: file, problems: problems);
    final used = mut [<int>];
    foreach (_ in exits) {
        used.append(0);
    }
    final absorbed = mut [<int>];
    foreach (_ in baseline) {
        absorbed.append(0);
    }
    final kept = mut [<finding\Finding>];
    foreach (f in found) {
        var gone = false;
        foreach (i, row in exits) {
            if (row.path == f.path and row.item == f.item) {
                used[i] = used[i] + 1;
                gone = true;
                break;
            }
        }
        if (!gone) {
            foreach (i, row in baseline) {
                if (row.path == f.path and row.item == f.item and absorbed[i] < row.count) {
                    absorbed[i] = absorbed[i] + 1;
                    gone = true;
                    break;
                }
            }
        }
        if (!gone) {
            kept.append(f);
        }
    }
    foreach (i, row in exits) {
        if (used[i] == 0) {
            problems.append(finding\Finding{ analyzer = name, path = file, item = row.item,
                message = "{name}.exits excuses nothing at {row.path}{suffix(row.item)}",
                fix = "Delete the exit row; the code no longer needs it." });
        }
    }
    foreach (i, row in baseline) {
        if (absorbed[i] < row.count) {
            problems.append(finding\Finding{ analyzer = name, path = file, item = row.item,
                message = "{name}.baseline allows {row.count} at {row.path}{suffix(row.item)} but {absorbed[i]} remain; a baseline only falls",
                fix = if (absorbed[i] == 0) "Delete the baseline row." else "Lower the count to {absorbed[i]}." });
        }
    }
    return kept + problems;
}

// suffix is item as the tail of a path in a message.
fun suffix(item: str) > str {
    return if (item == "") "" else " ({item})";
}
