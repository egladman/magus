// stubs-never-reach-main refuses a function whose whole body is its spell's stub body.
// Under stub-first a placeholder belongs to an earlier layer, never to main. This rule
// holds no language's stub text and no extension: it reads StubSyntax.body and the
// extensions from each spell the workspace loads.
namespace stubsneverreachmain;

import "assert";
import "fs";
import "std";
import "magus";
import "analyzer" as analyzer;
import "finding" as finding;

// HOLE stands for a template hole while the body is escaped into a pattern.
final HOLE = "@@HOLE@@";

// NAME is the analyzer's name, which a workspace's analyzers.yaml keys.
export final NAME = "stubs-never-reach-main";

// stubs is the analyzer for spells, the workspace's loaded ones. It reads every extension
// a stub-declaring spell claims, as one glob so that an extension the tree lacks is no finding.
// It refuses.
export fun stubs(spells: [magus\Spell]) > analyzer\Analyzer {
    final bySuffix = suffixes(spells);
    final exts = bySuffix.keys().cloneMutable();
    final ordered = exts.sort(fun (left: str, right: str) > bool => left < right);
    return analyzer\check(NAME, tier: analyzer\Tier.mechanical,
        fix: "Write the real body, or land the function with the first caller that needs it.",
        source: "libs/analyzer/stubs-never-reach-main.buzz", files: ["**/*\{{ordered.join(",")}\}"], reach: analyzer\Reach.workspace,
        run: fun (input: analyzer\Input) > [finding\Finding] => check(input.files, bySuffix: bySuffix));
}

// suffixes maps each extension of a spell that declares a stub body to that body's syntax.
export fun suffixes(spells: [magus\Spell]) > {str: magus\StubSyntax} {
    final bySuffix = mut {<str: magus\StubSyntax>};
    foreach (sp in spells) {
        final stubs = sp.syntax?.stubs;
        if (stubs == null or stubs!.body == "") {
            continue;
        }
        foreach (ext in sp.extensions) {
            bySuffix[ext] = stubs!;
        }
    }
    return bySuffix;
}

// exempt: tests and fixtures hold stub text on purpose, to prove something rejects it. The
// markers are conventions of test files across languages, so no language is named.
export fun exempt(p: str) > bool {
    final parts = p.split("/");
    final base = parts[parts.len() - 1];
    return base.indexOf("_test.") != null or base.indexOf(".test.") != null or base.startsWith("test_")
        or p.indexOf("/testdata/") != null or p.startsWith("testdata/");
}

// check reports each function in files whose whole body is its spell's stub body.
// A file it cannot read is a finding, never a clean pass.
fun check(files: [str], bySuffix: {str: magus\StubSyntax}) > [finding\Finding] {
    final found = mut [<finding\Finding>];
    foreach (f in files) {
        if (exempt(f)) {
            continue;
        }
        final syntax = syntaxFor(f, bySuffix: bySuffix);
        if (syntax == null) {
            continue;
        }
        var src = "";
        try {
            src = fs\readFile(f);
        } catch (err: any) {
            found.append(finding\Finding{ path = f, message = "the file could not be read: {err}", fix = "Restore the file." });
            continue;
        }
        foreach (hit in judge(f, src: src, style: syntax!.bodyStyle, template: syntax!.body)) {
            found.append(hit);
        }
    }
    return found;
}

// syntaxFor is the stub syntax of the spell whose extension p ends in, or null.
fun syntaxFor(p: str, bySuffix: {str: magus\StubSyntax}) > magus\StubSyntax? {
    foreach (ext, syntax in bySuffix) {
        if (p.endsWith(ext)) {
            return syntax;
        }
    }
    return null;
}

// judge is each stub body src holds as a function's whole body, a file at path.
export fun judge(path: str, src: str, style: str, template: str) > [finding\Finding] {
    final found = mut [<finding\Finding>];
    final body = bodyPattern(template);
    if (style == "brace") {
        var cursor = 0;
        foreach (hit in std\pattern(body).matchAll(src) ?? []) {
            final at = src.indexOf(hit[0], from: cursor);
            if (at == null) {
                continue;
            }
            cursor = at! + hit[0].len();
            found.append(stubFinding(path, line: lineOf(src, at: at!)));
        }
        return found;
    }
    if (style == "indent") {
        foreach (line in indentHits(src.split("\n"), body: body)) {
            found.append(stubFinding(path, line: line));
        }
    }
    return found;
}

fun stubFinding(path: str, line: int) > finding\Finding {
    return finding\Finding{ path = path, line = line,
        message = "a function's whole body is its language's stub body, so a placeholder reached main",
        fix = "Write the real body, or land this function with the first caller that needs it: under stub-first a stub belongs to an earlier layer only." };
}

// bodyPattern is the regex for a stub body template: its text escaped, whitespace of any
// width, and each hole any run of non-quote characters.
export fun bodyPattern(template: str) > str {
    final holes = std\pattern(`\{\{&?\w+\}\}`).replaceAll(template, with: HOLE);
    var escaped = "";
    for (var i = 0; i < holes.len(); i = i + 1) {
        final c = holes.sub(i, len: 1);
        if ("\\.+*?()|[]\{\}^$".indexOf(c) != null) {
            escaped = escaped + "\\" + c;
        } else {
            escaped = escaped + c;
        }
    }
    final spaced = std\pattern(`\s+`).replaceAll(escaped, with: `\s*`);
    return std\pattern(HOLE).replaceAll(spaced, with: `[^"\n]*`);
}

// lineOf is the 1-based line of the byte offset at in src.
fun lineOf(src: str, at: int) > int {
    return src.sub(0, len: at).split("\n").len();
}

// indentHits are the lines that are a block's only statement, matching body, under a header
// ending in a colon. The template is taken as one line, as an indent-style body is.
fun indentHits(lines: [str], body: str) > [int] {
    final hits = mut [<int>];
    final whole = std\pattern("^\\s*" + body + "\\s*$");
    foreach (i, line in lines) {
        if (whole.match(line) == null) {
            continue;
        }
        final depth = indentOf(line);
        final before = neighbor(lines, start: i, step: -1);
        final after = neighbor(lines, start: i, step: 1);
        if (before == null or !header(lines[before!]) or indentOf(lines[before!]) >= depth) {
            continue;
        }
        if (after != null and indentOf(lines[after!]) >= depth) {
            continue;
        }
        hits.append(i + 1);
    }
    return hits;
}

// header: a line that opens a function. Only a def can hold a whole-body stub, not an if or a loop.
fun header(line: str) > bool {
    final text = line.trim();
    return (text.startsWith("def ") or text.startsWith("async def ")) and text.endsWith(":");
}

fun indentOf(line: str) > int {
    return line.len() - line.trim().len();
}

// neighbor is the index of the nearest non-blank line from i in the step direction, or null.
fun neighbor(lines: [str], start: int, step: int) > int? {
    var n = start + step;
    while (n >= 0 and n < lines.len()) {
        if (lines[n].trim() != "") {
            return n;
        }
        n = n + step;
    }
    return null;
}

final GO_STYLE = "brace";
final GO_BODY = "\{\n\tpanic(\"unimplemented: \{\{&Name}} lands in \{\{&Branch}}\")\n\}";
final PY_STYLE = "indent";
final PY_BODY = "raise NotImplementedError(\"\{\{&Name}} lands in \{\{&Branch}}\")";

test "a Go function whose whole body is the stub is reported at its brace" {
    final src = "package a\n\nfunc F() int \{\n\tpanic(\"unimplemented: F lands in topic-2\")\n\}\n";
    final got = judge("a.go", src: src, style: GO_STYLE, template: GO_BODY);
    assert\equal(got.len(), want: 1, message: "one stub");
    assert\equal(got[0].line, want: 3, message: "the line of the opening brace");
}

test "a function with a real body passes" {
    final src = "func F() int \{\n\tpanic(\"unimplemented: F lands in topic-2\")\n\treturn 1\n\}\n";
    assert\equal(judge("a.go", src: src, style: GO_STYLE, template: GO_BODY).len(), want: 0, message: "more than the stub");
}

test "a stub body written on one line is still the whole body" {
    final src = "func F() \{ panic(\"unimplemented: F lands in b\") \}\n";
    assert\equal(judge("a.go", src: src, style: GO_STYLE, template: GO_BODY).len(), want: 1, message: "one line");
}

test "two stubs are two findings" {
    final one = "func F() \{\n\tpanic(\"unimplemented: F lands in b\")\n\}\n";
    final two = "func G() \{\n\tpanic(\"unimplemented: G lands in b\")\n\}\n";
    final got = judge("a.go", src: one + two, style: GO_STYLE, template: GO_BODY);
    assert\equal(got.len(), want: 2, message: "both");
    assert\equal(got[1].line, want: 4, message: "the second one's line");
}

test "an indent body is a stub only as the block's sole statement" {
    final stub = "def f():\n    raise NotImplementedError(\"f lands in b\")\n\ndef g():\n    return 1\n";
    final got = judge("a.py", src: stub, style: PY_STYLE, template: PY_BODY);
    assert\equal(got.len(), want: 1, message: "one stub");
    assert\equal(got[0].line, want: 2, message: "its line");
    final more = "def f(x):\n    if x:\n        raise NotImplementedError(\"f lands in b\")\n    return 1\n";
    assert\equal(judge("a.py", src: more, style: PY_STYLE, template: PY_BODY).len(), want: 0, message: "a statement follows it");
}

test "a body that is not the spell's stub is left alone" {
    assert\equal(judge("a.go", src: "func F() \{\n\tpanic(\"boom\")\n\}\n", style: GO_STYLE, template: GO_BODY).len(), want: 0, message: "a real panic");
}

test "tests and fixtures are exempt" {
    assert\equal(exempt("spells/lex_test.go"), want: true, message: "go test");
    assert\equal(exempt("libs/x/testdata/a.go"), want: true, message: "testdata");
    assert\equal(exempt("spells/stubs.go"), want: false, message: "source");
}

test "a test file of any language is exempt by its name" {
    assert\equal(exempt("a/lex.test.ts"), want: true, message: "ts test");
    assert\equal(exempt("a/test_lex.py"), want: true, message: "py test");
    assert\equal(exempt("a/lex_test.buzz"), want: true, message: "buzz test");
    assert\equal(exempt("a/contest.rs"), want: false, message: "a name that merely holds test");
}

test "only a spell that declares a stub body contributes its extensions" {
    final stub = magus\StubSyntax{ bodyStyle = "brace", body = "panic(\"x\")" };
    final got = suffixes([
        magus\Spell{ name = "lang", extensions = [".zz", ".zy"], syntax = magus\Syntax{ stubs = stub } },
        magus\Spell{ name = "plain", extensions = [".md"] },
        magus\Spell{ name = "empty", extensions = [".yy"], syntax = magus\Syntax{ stubs = magus\StubSyntax{} } },
    ]);
    assert\equal(got.keys().len(), want: 2, message: "the two of the one spell");
    assert\equal(got.hasKey(".zz"), want: true, message: "first extension");
    assert\equal(got.hasKey(".md"), want: false, message: "a spell with no syntax");
    assert\equal(got.hasKey(".yy"), want: false, message: "an empty body");
}
