import "std";
import "fs";
import "env";
import "crypto";
import "magus";
import "project/../.." as workspace;
import "../../hack/magusfile/advisories" as advisories;
import "embed/sources";
import "embed/holdout";
import "embed/pairs";
import "embed/runlog";
import "split" as splitter;

import "magus/spell/go";

// Its own go.mod keeps GoMLX, go-xla and gonum out of the root module, govulncheck's root
// scan and the shipped binary. The teacher targets read and write the cache root
// (XDG_CACHE_HOME/magus-embed, else ~/.cache/magus-embed), which no cache entry records.
magus\project({
    "spells": [go],
    "sources": ["embed/inputs.jsonl", "inputs.jsonl", "config/*.yaml", "split.buzz", "gen/split.digest"],
    "targets": {
        "install": {"skip_cache": "downloads into the shared module cache, which no cache entry records"},
        "security": {"skip_cache": "reads the Go vulnerability database, which changes independently of this tree"},
        "fetch": {"skip_cache": "downloads the pinned inputs into the cache root, outside the tree"},
        "vocab": {"skip_cache": "reads the datasets and writes the training texts and token texts into the cache root, outside the tree"},
        "teacher": {"skip_cache": "writes teacher shards into the cache root, outside the tree"},
        "train": {"skip_cache": "reads teacher runs from the cache root, outside the tree"},
        "teacher-parity": {"skip_cache": "reads reference vectors from the cache root, outside the tree"},
        "convert": {"skip_cache": "reads potion from the cache root and writes the table there, outside the tree"},
        "table": {"skip_cache": "hashes the table convert writes to the cache root, outside the tree"},
        "bench": {"skip_cache": "reads the exported subsets under the cache root and writes teacher shards and runs there, outside the tree"},
        "oov": {"skip_cache": "reads the pinned tarballs and the converted table under the cache root, outside the tree"},
        // A pinned model is gigabytes, so the downloads and pilots outlast the default timeout.
        "models": {"skip_cache": "downloads the pinned models into the cache root, outside the tree", "timeout": "4h"},
        "fertility": {"skip_cache": "reads tokenizers from the cache root, outside the tree, and appends to runs.jsonl"},
        "pilot": {"skip_cache": "trains from weights in the cache root, outside the tree, and appends a measurement of this machine to runs.jsonl", "timeout": "2h"},
        "split": {"skip_cache": "reads the committed tree through git and writes the split into the cache root, outside the tree"},
        "eval-sets": {"skip_cache": "reads the split from the cache root and writes the evaluation sets there, outside the tree"},
        "fim": {"skip_cache": "reads the split and the eval sets from the cache root and writes the training samples there, outside the tree"},
        "g1": {"skip_cache": "recounts the datasets under the cache root, outside the tree"},
        "gguf-bench": {"skip_cache": "reads GGUFs from the cache root, outside the tree, and appends a measurement of this machine to runs.jsonl", "timeout": "1h"},
        // Each target forks llama-server over a GGUF in the cache root and times a loaded, shared machine, so no cache entry could hold the answer.
        "eval-complete": {"skip_cache": "serves GGUFs from the cache root with llama-server, outside the tree, and appends rows measured on this machine to evals.jsonl and runs.jsonl", "timeout": "12h"},
        "pass-at-k": {"skip_cache": "serves GGUFs from the cache root with llama-server, outside the tree, and appends rows measured on this machine to evals.jsonl and runs.jsonl", "timeout": "12h"},
        "latency": {"skip_cache": "serves GGUFs from the cache root with llama-server, outside the tree, and appends timings of this machine to evals.jsonl and runs.jsonl", "timeout": "6h"},
    },
});

// go-xla's PJRT binding is cgo; magus runs Go with cgo off unless a target turns it on.
// libs/embed decodes with encoding/json/v2, which needs GOEXPERIMENT=jsonv2.
final cgo = {"CGO_ENABLED": "1", "GOEXPERIMENT": "jsonv2"};

export fun install(ctx: magus\Context, args: [str]) > void !> any { go["go-mod-download"](ctx); }

export fun format(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles(["**/*.go", "go.mod", "go.sum"], editsExistingSource: true);
    go["go-fmt"](ctx);
    go["go-mod-tidy"](ctx);
}
export fun lint(ctx: magus\Context, args: [str]) > void { ctx.needs(format); go["go-vet"](ctx.withEnv(cgo)); }
export fun build(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    go["go-build"](ctx.withEnv(cgo), {"args": ["./..."]});
}
// Tiny fixtures only: the teacher on GoMLX's pure-Go backend against a naive forward
// pass, finite-difference checks of every training gradient, and the commands' helpers.
// No XLA, no downloads.
export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    go["go-test"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./..."] + args});
}

// Fails on a vulnerable symbol this module calls.
export fun security(ctx: magus\Context, args: [str]) > void !> any {
    final inheritedFatal = advisories\inheritedFatal(args);
    ctx.needs(format);
    advisories\govulncheck(ctx, go: go, inheritedFatal: inheritedFatal);
}

// Mines gen/: the sources (tracked files, the pinned downloads, the forced vocabulary,
// the figures), the holdout files and the training pairs, all read off the tracked
// tree and the knowledge graph. symbol-index.json keys the cache on the symbol index.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(workspace\symbol_digest_generate);
    ctx.readsFiles(["embed/sources.buzz", "embed/holdout.buzz", "embed/pairs.buzz",
        workspace\file("gen/symbol-index.json"), workspace\file("**/*.go"), workspace\file("**/*.buzz"),
        workspace\file("**/*.md"), workspace\file("**/*.ts"), workspace\file("**/*.tsx"),
        workspace\file("docs/assets/gen/diagram-*-light.svg")]);
    ctx.writesFiles(["embed/gen/sources.jsonl", "embed/gen/holdout.jsonl", "embed/gen/pairs.jsonl"]);
    fs\mkdirAll("embed/gen");
    final loaded = sources\load();
    if (loaded.error -> e) {
        throw e.message;
    }
    final c = loaded.value!;
    final paths: mut [str] = mut [];
    foreach (f in c.files) {
        paths.append(f.path);
    }
    final held = holdout\write(paths, target: fs\join("embed/gen", name: "holdout.jsonl"));
    if (held.error -> e) {
        throw e.message;
    }
    final figs = pairs\figures(c);
    if (figs.error -> e) {
        throw e.message;
    }
    final files = sources\write(c, figures: figs.value!, target: fs\join("embed/gen", name: "sources.jsonl"));
    if (files.error -> e) {
        throw e.message;
    }
    final mined = pairs\write(c, figs: figs.value!, target: fs\join("embed/gen", name: "pairs.jsonl"));
    if (mined.error -> e) {
        throw e.message;
    }
    std\print("source files {files.value!}; holdout files {held.value!}; pairs {mined.value!}");
}

// Downloads every input inputs.jsonl pins, verifying each sha256. Args after -- name
// input prefixes, e.g. `-- CodeRankEmbed/`.
export fun fetch(ctx: magus\Context, args: [str]) > void !> any {
    go["go-run"](ctx.withEnv(cgo), {"args": ["./embed/cmd/embed", "fetch"] + args});
}

// Writes the training texts (gen/sources.jsonl's files at the commit that wrote it, its
// figures, and CoRNStack rows), decontaminated against the eval sets embed bench reads
// from the cache root's bench/ (testdata/retrieval has no queries.jsonl, so judged-queries
// is left out), and the forced tokens under the cache root's training/, then
// the vocabulary's token texts beside them and its counts to gen/vocab.jsonl, which convert
// reads. FineWeb-Edu is left out: the module has no parquet reader. The texts run is
// appended to runs.jsonl. Args after -- go to `embed vocab`, e.g. `-- -size 16000`.
// Manual, never part of ci: rewriting gen/vocab.jsonl moves the table's pin.
export fun vocab(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["embed/gen/vocab.jsonl"]);
    final cache = fs\join(env\getOr("XDG_CACHE_HOME", def: fs\join(env\home(), name: ".cache")), name: "magus-embed");
    final dir = fs\join(cache, name: "training");
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./embed/cmd/embed", "texts", "-cache", cache, "-out", dir,
        "-eval", fs\join(cache, name: "bench"), "-no-eval", "judged-queries", "-skip", "fineweb-edu/sample/10BT/013_00000.parquet"]});
    final appended = runlog\appendTexts(dir, target: "embed/runs.jsonl");
    if (appended.error -> e) {
        throw e.message;
    }
    fs\mkdirAll("embed/gen");
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./embed/cmd/embed", "vocab", "-texts", fs\join(dir, name: "texts.jsonl"),
        "-forced", fs\join(dir, name: "forced.txt"), "-out", fs\join(dir, name: "tokens.jsonl"),
        "-vocab", fs\join("embed/gen", name: "vocab.jsonl")] + args});
}

// Embeds the vocabulary's token texts, then the training texts, each into resumable,
// content-addressed shards under the cache root's teacher/, and appends each run's
// totals to runs.jsonl. A rerun skips finished shards. Args after -- go to `embed
// teacher`; the model is CodeRankEmbed unless they name another with `-model <name>`.
// Manual, never part of ci.
export fun teacher(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(vocab);
    final cache = fs\join(env\getOr("XDG_CACHE_HOME", def: fs\join(env\home(), name: ".cache")), name: "magus-embed");
    var model = "CodeRankEmbed";
    foreach (i, arg in args) {
        if (arg == "-model" and i + 1 < args.len()) {
            model = args[i + 1];
        }
    }
    foreach (name in ["tokens.jsonl", "texts.jsonl"]) {
        final run = ["-cache", cache, "-max-len", "256", "-texts", fs\join(cache, "training", name), "-model", model];
        go["go-run"](ctx.withEnv(cgo), {"args": ["./embed/cmd/embed", "teacher"] + run + args});
        final recorded = runlog\recordTeacher(cache, model: model, texts: fs\join(cache, "training", name), maxLen: 256, target: "embed/runs.jsonl");
        if (recorded.error -> e) {
            throw e.message;
        }
    }
}

// Encodes the 1,024-text parity sample with one teacher, checks every row against the
// reference vectors (cosine >= 0.999) and the tokens against the reference tokenizer, and
// reports texts/s. Needs `-- -model <name>`.
export fun teacher_parity(ctx: magus\Context, args: [str]) > void !> any {
    go["go-run"](ctx.withEnv(cgo), {"args": ["./embed/cmd/embed", "teacher-parity"] + args});
}

// Runs one teacher over the external harness's exported subsets under the cache root's
// bench/ and writes its TREC runs beside them, where TestExternalEval in libs/embed
// fuses and scores them into evals.jsonl. The
// teacher is CodeRankEmbed with its query prompt, the ceiling, unless args name another
// with `-model <name>`; `-subset <dir>` runs one directory instead of the five. A
// multi-hour pass that needs the machine alone. Manual, never part of ci.
export fun bench(ctx: magus\Context, args: [str]) > void !> any {
    final cache = fs\join(env\getOr("XDG_CACHE_HOME", def: fs\join(env\home(), name: ".cache")), name: "magus-embed");
    var model = "CodeRankEmbed";
    final dirs: mut [str] = mut [];
    final rest: mut [str] = mut [];
    var skip = false;
    foreach (i, arg in args) {
        if (skip) {
            skip = false;
        } else if (arg == "-model" and i + 1 < args.len()) {
            model = args[i + 1];
            skip = true;
        } else if (arg == "-subset" and i + 1 < args.len()) {
            dirs.append(args[i + 1]);
            skip = true;
        } else {
            rest.append(arg);
        }
    }
    if (dirs.len() == 0) {
        foreach (name in ["cosqa-dedup", "stackoverflow-qa", "csn-python", "csn-go", "ccr-go"]) {
            dirs.append(fs\join(cache, "bench", name: name));
        }
    }
    foreach (dir in dirs) {
        go["go-run"](ctx.withEnv(cgo), {"args": ["./embed/cmd/embed", "bench", "-cache", cache, "-model", model, "-subset", dir] + rest});
    }
}

// Appends to libs/embed/evals.jsonl, for each pinned non-Go repo in inputs.jsonl, the share of
// its source files' identifier tokens with no row in the shipped vocabulary. Fetches the tarballs
// first; the converted table must be in the cache root (the convert target writes it). Args
// after -- go to `embed oov`, e.g. `-- guava`.
export fun oov(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["../embed/evals.jsonl"]);
    fetch(ctx, args: ["oov/"]);
    final cache = fs\join(env\getOr("XDG_CACHE_HOME", def: fs\join(env\home(), name: ".cache")), name: "magus-embed");
    go["go-run"](ctx.withEnv(cgo), {"args": ["./embed/cmd/embed", "oov", "-cache", cache] + args});
}

// Distills and trains the table from finished teacher runs, with the flags `embed train
// -h` lists after --; manual, never part of ci.
export fun train(ctx: magus\Context, args: [str]) > void !> any {
    go["go-run"](ctx.withEnv(cgo), {"args": ["./embed/cmd/embed", "train"] + args});
}

// Writes potion-code-16M-v2 over gen/vocab.jsonl as the cache root's
// potion-code-16M-v2.table. The table depends on nothing but the committed vocabulary and
// the pinned potion files, so its bytes, and the pin, hold at any commit.
export fun convert(ctx: magus\Context, args: [str]) > void !> any {
    fetch(ctx, args: ["potion-code-16M-v2/"]);
    final cache = fs\join(env\getOr("XDG_CACHE_HOME", def: fs\join(env\home(), name: ".cache")), name: "magus-embed");
    go["go-run"](ctx.withEnv(cgo), {"args": ["./embed/cmd/embed", "convert", "-cache", cache,
        "-vocab", fs\join("embed/gen", name: "vocab.jsonl"), "-run", "convert",
        "-out", fs\join(cache, name: "potion-code-16M-v2.table")] + args});
}

// Pins the converted table in libs/embed/gen/table.digest by its sha256, the digest its
// OCI artifact's layer and tag carry, so the release publishes the artifact without
// reading the pin off a registry. It lives here, not in libs/embed, because libs/embed
// importing this project closes a cycle through the root. Manual, never part of ci.
export fun table(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(convert);
    ctx.writesFiles(["../embed/gen/table.digest"]);
    final cache = fs\join(env\getOr("XDG_CACHE_HOME", def: fs\join(env\home(), name: ".cache")), name: "magus-embed");
    final digest = crypto\sha256File(fs\join(cache, name: "potion-code-16M-v2.table"));
    fs\mkdirAll(fs\join("..", "embed", name: "gen"));
    fs\writeFile(fs\join("..", "embed", "gen", "table.digest"), content: digest + "\n");
}

// The anchor `magus affected ci` keys off.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, build, test, security);
}

// Downloads the inputs inputs.jsonl pins into the cache root and verifies each sha256,
// through `embed fetch`. A file already there is hashed, not fetched again. Args after
// -- name input prefixes in place of stage S0's, e.g. `-- mellum2-12b-a2.5b-base/`.
export fun models(ctx: magus\Context, args: [str]) > void !> any {
    // What stage S0 reads: the small files of every model (licenses, configs, tokenizers),
    // the weights the three pilots train, and every GGUF. The other base weights stay
    // pinned and unfetched until a later stage reads them.
    final cache = fs\join(env\getOr("XDG_CACHE_HOME", def: fs\join(env\home(), name: ".cache")), name: "magus");
    var prefixes = [
        "qwen2.5-coder-0.5b/",
        "qwen2.5-coder-1.5b-instruct/",
        "qwen2.5-coder-1.5b/LICENSE", "qwen2.5-coder-1.5b/config.json", "qwen2.5-coder-1.5b/tokenizer",
        "mellum-4b-base/README.md", "mellum-4b-base/config.json", "mellum-4b-base/tokenizer",
        "mellum2-12b-a2.5b-base/README.md", "mellum2-12b-a2.5b-base/config.json", "mellum2-12b-a2.5b-base/tokenizer",
        "devstral-small-2-24b/README.md", "devstral-small-2-24b/config.json", "devstral-small-2-24b/tokenizer",
        "mellum2-12b-a2.5b-instruct-mlx-4bit/",
        "gguf/",
    ];
    if (args.len() > 0) {
        prefixes = args;
    }
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./embed/cmd/embed", "fetch", "-inputs", "inputs.jsonl", "-cache", cache] + prefixes});
}

// Appends, per tokenizer, the tokens per byte of held-in hand-written Buzz, Go and TS
// (gen/sources.jsonl's train split) to runs.jsonl. Args after -- go to `train fertility`.
export fun fertility(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["runs.jsonl"], editsExistingSource: true);
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "fertility"] + args});
}

// Runs one 200-step mlx_lm.lora pilot on train-split Buzz and appends its tokens/s, peak
// memory and load average to runs.jsonl. Needs `-- -config config/<pilot>.yaml -model
// <input prefix>`. Heavy: run one pilot at a time, with tests idle. Manual, never part of
// ci.
export fun pilot(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["runs.jsonl"], editsExistingSource: true);
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "pilot"] + args});
}

// Runs llama-bench pp512 and tg128 over every pinned GGUF and appends each one's rates to
// runs.jsonl. Args after -- go to `train gguf-bench`, e.g. `-- -prefix gguf/qwen`. Manual,
// never part of ci.
export fun gguf_bench(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["runs.jsonl"], editsExistingSource: true);
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "gguf-bench"] + args});
}

// The datasets of stage S1 live under <XDG cache>/magus/train/s1, outside git; gen/split.digest
// pins their sha256 and the commit they were read at. Args after -- go to `train`, e.g.
// `-- -rev <commit>` to read a commit other than HEAD.
fun s1Dir() > str !> any {
    return fs\join(env\getOr("XDG_CACHE_HOME", def: fs\join(env\home(), name: ".cache")), "magus", "train", "s1");
}

fun revOf(args: [str]) > str {
    foreach (i, arg in args) {
        if (arg == "-rev" and i + 1 < args.len()) {
            return args[i + 1];
        }
    }
    return "HEAD";
}

// Deals the provenance groups of the hand-written Buzz, Go and TypeScript at a commit:
// exact and near-duplicate files become links, so both land on one side, and groups are
// held out by sha256 order until each language has about 10% of its bytes.
export fun split(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["gen/split.digest"], editsExistingSource: true);
    final dir = s1Dir();
    final listed = splitter\candidates(revOf(args), dir: dir);
    if (listed.error -> e) {
        throw e.message;
    }
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "dedup"] + args});
    final placed = splitter\place(dir);
    if (placed.error -> e) {
        throw e.message;
    }
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "pin-split"] + args});
    std\print("candidates {listed.value!}; placed {placed.value!}");
}

// Writes the FIM dev and test sets of each language, the Buzz pass@k tasks, and the commits
// after the cutoff, then pins each. Needs the split.
export fun eval_sets(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["gen/split.digest"], editsExistingSource: true);
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "eval-sets"] + args});
}

// Writes the FIM training samples of every train-side file at the cutoff commit, leaving
// out the files whose text repeats an evaluation text. Needs the eval sets.
export fun fim(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["gen/split.digest"], editsExistingSource: true);
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "fim"] + args});
}

// Recounts every G1 bullet of plan 2.3 from the datasets and fails when one does not hold.
export fun g1(ctx: magus\Context, args: [str]) > void !> any {
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "g1"] + args});
}

// Serves each base GGUF with llama-server (the target forks it; magus serves no model),
// completes the FIM test sets of stage S1 and appends plan 6.1's precision, recall, AUPRC,
// identifier and check-pass rows with their intervals to evals.jsonl and a row per
// system to runs.jsonl. Needs the eval sets and `-- -run <name>`; args after -- go to
// `train eval-complete`: -systems, -sets, -max, -context. The with-context column waits
// for stage S2: -context none is the only value until a provider fills the spans'
// context. A rerun with the same -run resumes. Heavy: one at a time, with tests idle.
// Manual, never part of ci.
export fun eval_complete(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["evals.jsonl", "runs.jsonl"], editsExistingSource: true);
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "eval-complete"] + args});
}

// Samples 20 bodies per held-out Buzz task from each base at temperature 0.8 and top-p
// 0.95, grades each with `magus buzz -t` in a scratch tree under a seatbelt profile with
// no network, and appends the unbiased pass@1, pass@5 and pass@10 rows to evals.jsonl.
// Needs `-- -run <name>`; args after -- go to `train pass-at-k`. Heavy and manual, as
// eval-complete.
export fun pass_at_k(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["evals.jsonl", "runs.jsonl"], editsExistingSource: true);
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "pass-at-k"] + args});
}

// Replays FIM-Buzz dev spans in typing order against each base, with and without
// --spec-type ngram-simple, and appends p50, p95 and mean latency, cold and warm,
// single-line (stop at a newline, 24 tokens) and 64-token, to evals.jsonl. Needs
// `-- -run <name>`; args after -- go to `train latency`: -systems, -n, -set. Heavy and
// manual, as eval-complete.
export fun latency(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["evals.jsonl", "runs.jsonl"], editsExistingSource: true);
    go["go-run"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["./cmd/train", "latency"] + args});
}
