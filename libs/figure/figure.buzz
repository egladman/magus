// magus/figure: architecture figures drawn from the graph's own records.
//
//     import "magus";
//     import "magus/figure";
//
//     export fun serverHttp() > Figure !> any {
//         final guard = magus\dir("internal/httpx");
//         final mcp = magus\dir("internal/handler/mcp");
//         return figure\of("server-http")
//             .box(guard, label: "Guard", focal: true)
//             .box(mcp, label: "/mcp")
//             .group(figure\layerSet(magus\layer("handler")).without([mcp]), label: "Connect RPC")
//             .edgesFromGraph();
//     }
//
// A box takes a Dir, a group takes a DirSet, and an actor nobody's code holds takes an
// external(). Edges come from the records: imports and declared calls between drawn
// boxes. The only hand-drawn edges are flowIn, flowOut and flowAcross, and each has an
// actor at one end. Coverage is by set: every directory scope() names is drawn or
// excepted, so a package joining a layer joins its group or fails the figure.
//
// This module imports no host module. It names the magus\Dir, magus\Layer and
// magus\RefsResult records, which every magus session declares, and a test builds them
// as map literals.
//
// The design system these figures follow is cathrynlavery/diagram-design (MIT),
// https://github.com/cathrynlavery/diagram-design: its palette, role treatments, zones,
// legend strip, connector and label rules. The title face, the Pico font variables, the
// header band, the budgets for generated figures and the layout are this module's own.
//
// Two palettes, one geometry: Theme.page emits `var(--magus-diagram-*)` so an SVG inlined
// into a docs page follows the site's theme toggle; Theme.light and Theme.dark bake hex
// for a standalone file loaded through <img>, which can never read the page's CSS.
namespace figure;

import "std";
import "assert";


// escapeSvg makes s safe as SVG text or as a double-quoted attribute value.
fun escapeSvg(s: str) > str {
    return s.replace("&", with: "&amp;").replace("\"", with: "&quot;").replace("<", with: "&lt;").replace(">", with: "&gt;");
}

// Grid is the hard rule from the design system: every authored coordinate, size and gap is
// divisible by 4. Derived values (edge attach points, label masks) are rounded onto it.
final Grid = 4;

// Budgets. Exceeding one means the diagram is trying to be two diagrams. Exported so flow
// can refuse a declaration in its own terms before any placement runs.
final MaxNodes = 9;
final MaxEdges = 12;
final MaxAccent = 2;
// An edge label is a word or two on a connector; past this it is a note.
final MaxEdgeLabel = 14;

// HeaderPad is the band a title reserves above the figure. Content keeps its authored
// coordinates and the whole group is translated down by this much, so a diagram never has
// to leave room for its own heading by hand - volatility once put its first node four
// pixels under the title, and every other diagram was guessing at the clearance.
final HeaderPad = 40;

// The bottom LegendStrip px of a figure with a legend belong to the strip; a node there is
// a finding, since the design system forbids a legend inside the diagram area.
final LegendStrip = 60;
// More zones than this and the figure is a swimlane.
final MaxZones = 3;
// Four exits from one diamond is a nested decision drawn flat.
final MaxDecisionExits = 3;
// The tightest corner the design system allows. In an authored figure a leg too short to
// seat it is a finding, never a sharper corner.
final BendFloor = 6;
// Space between an edge label's mask and the stroke it names.
final LabelGap = 10;
// The least a label's mask keeps from any stroke or box: the design system's 6px floor.
final LabelClear = 6;

// Palette carries the nine semantic roles every diagram draws from. Values are whatever the
// SVG `fill`/`stroke` attributes accept, so a palette is either resolved hex or CSS vars.
//
// Treatments the skill writes as a role at an opacity (zones at ink 2%, input at muted 10%,
// security at accent 5%) are painted with fill-opacity and stroke-opacity over these same
// roles rather than stored as extra fields: an rgba literal cannot be derived from a var(),
// and the attribute keeps both palettes and the site's theme toggle in step for free.
object Palette {
    paper: str = "",        // page ground, and the opaque mask under every node
    surface: str = "",      // default node fill
    ink: str = "",          // primary text
    muted: str = "",        // secondary text, default connector stroke
    soft: str = "",         // sublabels, connector labels
    rule: str = "",         // hairlines, node and zone borders
    accent: str = "",       // focal treatment, 2 elements max
    accentTint: str = "",   // fill behind an accent border
    link: str = "",         // external and over-the-wire connectors
}

// cssVarPalette drives the diagram from custom properties defined in site.css, which map
// onto Pico's own variables. Only valid for an SVG inlined into the page; an <img>-loaded
// SVG resolves these against nothing and falls back to the hardcoded light values.
fun cssVarPalette() > Palette {
    final l = lightPalette();
    return Palette{
        paper      = "var(--magus-diagram-paper, " + l.paper + ")",
        surface    = "var(--magus-diagram-surface, " + l.surface + ")",
        ink        = "var(--magus-diagram-ink, " + l.ink + ")",
        muted      = "var(--magus-diagram-muted, " + l.muted + ")",
        soft       = "var(--magus-diagram-soft, " + l.soft + ")",
        rule       = "var(--magus-diagram-rule, " + l.rule + ")",
        accent     = "var(--magus-diagram-accent, " + l.accent + ")",
        accentTint = "var(--magus-diagram-accent-tint, " + l.accentTint + ")",
        link       = "var(--magus-diagram-link, " + l.link + ")",
    };
}

// lightPalette and darkPalette are diagram-design's own skin, for the standalone .svg pair
// GitHub loads. They deliberately do not mirror the site: an inlined figure blends into the
// page through the CSS vars, while a standalone file is a document of its own and paints the
// skill's paper. surface is the skill's backend fill (light) and paper-2 (dark).
fun lightPalette() > Palette {
    return Palette{
        paper = "#f5f5f5", surface = "#ffffff", ink = "#2d3142", muted = "#4f5d75",
        soft = "#7a8399", rule = "rgba(45,49,66,0.12)", accent = "#eb6c36",
        accentTint = "rgba(235,108,54,0.08)", link = "#2e5aa8",
    };
}

fun darkPalette() > Palette {
    return Palette{
        paper = "#2d3142", surface = "#393e53", ink = "#f5f5f5", muted = "#bfc0c0",
        soft = "#8e98ac", rule = "rgba(245,245,245,0.12)", accent = "#f08a59",
        accentTint = "rgba(240,138,89,0.10)", link = "#6a95d8",
    };
}

// Style carries the presentation literals the painters write into SVG attributes: the two
// font families, the type ramp, stroke widths, corner radii, dash patterns and the gutter
// the frame keeps. Style{} is the design system as shipped; a caller names only what
// differs.
//
// The omissions are deliberate. Grid, the budgets and layered()'s column geometry are
// structural rather than painted: validate() reasons about them, so a per-render override
// would let a caller ship a figure the validator approved under different numbers. Text
// baselines and the character-width estimates that size an opaque label mask are calibrated
// against the sizes below and only ever move together with them.
//
// Every default is written as a literal. A field default that names a module constant
// resolves in the IMPORTER's scope, so it compiles here and fails the moment another
// project imports this file.
object Style {
    fontFamily: str = "var(--pico-font-family, sans-serif)",           // titles and node names
    monoFamily: str = "var(--pico-font-family-monospace, monospace)",  // tags, sublabels, eyebrows, legend

    titleSize: int = 20,
    titleWeight: int = 600,
    eyebrowSize: int = 8,
    labelSize: int = 12,        // node and decision names
    labelWeight: int = 600,
    subSize: int = 9,
    tagSize: int = 7,
    zoneLabelSize: int = 7,
    edgeLabelSize: int = 8,
    legendSize: int = 8,

    // Tracking is what keeps an all-caps mono run legible at these sizes: the smaller and
    // shoutier the run, the more it needs.
    eyebrowTracking: str = "0.18em",
    zoneLabelTracking: str = "0.14em",
    tagTracking: str = "0.08em",
    edgeLabelTracking: str = "0.06em",
    legendTracking: str = "0.06em",

    strokeWidth: double = 1.2,      // node, decision and connector outlines
    hairlineWidth: double = 0.8,    // zone, tag chip, legend rule and legend swatch

    optionalDash: str = "4,3",
    securityDash: str = "4,4",
    edgeDash: str = "5,4",

    nodeRadius: int = 6,
    zoneRadius: int = 8,
    chipRadius: int = 2,            // tag chip, edge-label mask, legend swatch
    bendRadius: int = 8,            // raised to 6 when set lower; a leg too short for 6 is a validate finding

    // A URL template with `{path}` and optionally `{line}`; when set, every anchored node
    // links to its path, and a symbol anchor to its line.
    anchorHref: str = "",

    // The arrowhead is drawn in marker units. refX and the polygon derive from these, so
    // widening the head keeps its tip on the attach point rather than past it.
    arrowWidth: int = 8,
    arrowHeight: int = 6,

    margin: int = 32,               // gutter the header and legend keep from the frame
    nodePadding: int = 8,           // tag chip inset from the node's top-left corner
    legendSwatch: int = 10,
    legendPitch: int = 160,         // start-to-start spacing between legend entries
}

// defaultStyle names the baseline the way lightPalette() names its own. A customization
// states only what differs, since every other field already carries the value here:
// Style{ strokeWidth = 2.0 }.
fun defaultStyle() > Style {
    return Style{};
}

// Node is one box. Role selects the fill/stroke treatment; sub and tag are optional and
// render in mono, since they carry technical content (ports, packages, protocols).
//
// Roles: "default", "focal" (accent, 2 max per diagram), "store" (a persistent thing),
// "external" (outside the boundary), "input" (data arriving from outside), "optional"
// (dashed), "decision" (a diamond with at most 3 exits; its vertices are the only points on
// the shape, so it takes one connector per side), "security" (a trust boundary: dashed,
// painted under the connectors, its label masked on the top border, and free to contain
// other nodes).
object Node {
    id: str = "",
    label: str = "",
    sub: str = "",
    tag: str = "",
    role: str = "default",
    // Workspace-relative path this box claims to depict. Checked at build time: when the
    // package is renamed or deleted the diagram fails rather than quietly describing a
    // tree that no longer exists. Empty means the box depicts no single place in the code
    // (an external actor, a decision), which is legitimate and not an omission.
    anchor: str = "",
    // The line a symbol anchor starts on, 0 when the anchor is a directory or a whole file.
    line: int = 0,
    // A URL the box links to when what it depicts lives outside the repo: another service,
    // a vendor's docs. Painted as an <a>; unlike anchor, nothing checks it.
    link: str = "",
    x: int = 0,
    y: int = 0,
    w: int = 160,
    h: int = 56,
}

// Edge is one connector. Sides and slots are explicit because the design system forbids two
// connectors sharing an attach point: slot k of n sits at k/(n+1) along the edge, so an
// author declaring slot 1 of 2 and slot 2 of 2 gets them fanned without computing offsets.
//
// side: "auto" | "left" | "right" | "top" | "bottom". kind: "default" | "accent" | "link".
// bend is the coordinate of the crossing segment (x for a horizontal route, y for a
// vertical one); 0 means halfway between the two attach points.
object Edge {
    src: str = "",
    dst: str = "",
    label: str = "",
    kind: str = "default",
    dashed: bool = false,
    srcSide: str = "auto",
    dstSide: str = "auto",
    srcSlot: int = 1,
    srcSlots: int = 1,
    dstSlot: int = 1,
    dstSlots: int = 1,
    bend: int = 0,
    // Interior corners x1,y1,x2,y2,... of an orthogonal polyline on the grid. Non-empty
    // replaces the single bend, which cannot route around a column in the way.
    via: [int] = [<int>],
    // What the connector asserts about the code: "flow" (narrative, unchecked),
    // "imports" or "calls". Only a drift check reads it; the painters ignore it.
    claim: str = "flow",
}

// Zone is a labeled container drawn behind the nodes it groups. Zones are painted first,
// so a connector label may overlap one safely. A boundary zone is a trust boundary and
// takes the security treatment: dashed accent, its label masked on the top border.
object Zone {
    label: str = "",
    x: int = 0,
    y: int = 0,
    w: int = 0,
    h: int = 0,
    boundary: bool = false,
}

// LegendItem is one entry in the bottom strip. It names a node role rather than a color so
// the swatch resolves through the palette: a literal hex here would light up white on the
// dark variant, since the two palettes are rendered from the same authored source.
object LegendItem {
    role: str = "default",
    label: str = "",
}

// Diagram is the whole figure. id namespaces the SVG's marker ids: several diagrams inlined
// into one page share a document id space, and duplicate marker ids silently repoint every
// arrowhead at the first definition.
object Diagram {
    id: str = "",
    // Set by layered() and flow's generated(): the node and edge budgets exist to stop a HAND-authored figure
    // growing past what a reader can hold, and a graph computed from the workspace has no
    // author to push back on. Every structural check still applies.
    generated: bool = false,
    title: str = "",
    eyebrow: str = "",
    desc: str = "",
    width: int = 960,
    height: int = 600,
    zones: [Zone] = [<Zone>],
    nodes: [Node] = [<Node>],
    edges: [Edge] = [<Edge>],
    legend: [LegendItem] = [<LegendItem>],
    // Globs of the tree this figure claims to depict, and the paths under them it leaves
    // out on purpose, each with its reason. Read by a drift check, never by the painters.
    scope: [str] = [<str>],
    omits: {str: str} = {<str: str>},
    // Digest of the observed set a flow composed in, empty for a figure nobody observed.
    // Painted nowhere; a drift check compares it against a fresh observation.
    stamp: str = "",
    // Why a figure with no scope depicts no code, as its author said it. Painted nowhere;
    // the drift summary reports it so an unchecked figure says why it is unchecked.
    unscoped: str = "",
    // 0 spreads slot k of n at k/(n+1) along its side, the authored form. A positive pitch
    // puts the n slots that far apart, symmetric about the side's midline, as flow fans.
    pitch: int = 0,
}

fun iabs(n: int) > int {
    if (n < 0) { return 0 - n; }
    return n;
}

fun isign(n: int) > int {
    if (n > 0) { return 1; }
    if (n < 0) { return 0 - 1; }
    return 0;
}

fun imin(a: int, b: int) > int {
    if (a < b) { return a; }
    return b;
}

fun imax(a: int, b: int) > int {
    if (a > b) { return a; }
    return b;
}

// snap rounds onto the 4px grid. Applied to derived geometry only; an authored coordinate
// that misses the grid is a validation error rather than something to silently fix.
fun snap(n: int) > int {
    final r = n % Grid;
    if (r == 0) { return n; }
    if (r < 0) { return n - r; }
    return n - r;
}

fun onGrid(n: int) > bool {
    return n % Grid == 0;
}

// findNode returns the node with id, or null when the edge names something that is not
// there. validate reports that; render treats it as unreachable.
fun findNode(d: Diagram, id: str) > Node? {
    foreach (n in d.nodes) {
        if (n.id == id) { return n; }
    }
    return null;
}

fun isDecision(d: Diagram, id: str) > bool {
    final n = findNode(d, id);
    if (n == null) { return false; }
    return n!.role == "decision";
}

// edgeSegments returns an edge's route as axis-aligned segments, each [x1, y1, x2, y2].
// It mirrors connectorPath's and routePath's branching exactly; they must agree, or the overlap check
// below is validating a route nobody draws.
fun edgeSegments(d: Diagram, e: Edge) > [[int]] {
    final geo = edgeGeometry(d, e);
    if (e.via.len() > 0) {
        final pts = edgePoints(geo, e);
        final segs: mut [[int]] = mut [<[int]>];
        var i = 2;
        while (i + 1 < pts.len()) {
            if (pts[i - 2] != pts[i] or pts[i - 1] != pts[i + 1]) {
                segs.append([pts[i - 2], pts[i - 1], pts[i], pts[i + 1]]);
            }
            i = i + 2;
        }
        return segs;
    }
    final x1 = geo[0];
    final y1 = geo[1];
    final x2 = geo[2];
    final y2 = geo[3];
    if (e.bend == 0 and (x1 == x2 or y1 == y2)) {
        return [[x1, y1, x2, y2]];
    }
    if (geo[4] == 1) {
        var bx = e.bend;
        if (bx == 0) { bx = snap(x1 + (x2 - x1) / 2); }
        return [[x1, y1, bx, y1], [bx, y1, bx, y2], [bx, y2, x2, y2]];
    }
    var by = e.bend;
    if (by == 0) { by = snap(y1 + (y2 - y1) / 2); }
    return [[x1, y1, x1, by], [x1, by, x2, by], [x2, by, x2, y2]];
}

// edgePoints flattens a via route to x,y pairs from the source attach point to the
// destination's, given the edge's resolved geometry.
fun edgePoints(geo: [int], e: Edge) > [int] {
    final pts: mut [int] = mut [geo[0], geo[1]];
    foreach (v in e.via) { pts.append(v); }
    pts.append(geo[2]);
    pts.append(geo[3]);
    return pts;
}

// segmentsOverlap reports whether two axis-aligned segments run along the SAME line and
// share more than a point. Crossing at right angles is fine and common; running on top of
// each other is what makes two connectors impossible to tell apart.
fun segmentsOverlap(a: [int], b: [int]) > bool {
    final aVert = a[0] == a[2];
    final bVert = b[0] == b[2];
    if (aVert != bVert) { return false; }
    if (aVert) {
        if (a[0] != b[0]) { return false; }
        return overlapLen(a[1], p2: a[3], q1: b[1], q2: b[3]) > 0;
    }
    if (a[1] != b[1]) { return false; }
    return overlapLen(a[0], p2: a[2], q1: b[0], q2: b[2]) > 0;
}

// overlapLen measures the shared extent of two 1-D spans, each given in either order.
fun overlapLen(p1: int, p2: int, q1: int, q2: int) > int {
    var lo1 = p1;
    var hi1 = p2;
    if (lo1 > hi1) { lo1 = p2; hi1 = p1; }
    var lo2 = q1;
    var hi2 = q2;
    if (lo2 > hi2) { lo2 = q2; hi2 = q1; }
    var lo = lo1;
    if (lo2 > lo) { lo = lo2; }
    var hi = hi1;
    if (hi2 < hi) { hi = hi2; }
    return hi - lo;
}

// overlappingConnectors reports each pair of edges that share a stroke line. Runs on
// generated layouts too: automatic placement is exactly where this goes wrong unnoticed.
fun overlappingConnectors(d: Diagram) > [Fault] {
    final errs: mut [Fault] = mut [<Fault>];
    var i = 0;
    while (i < d.edges.len()) {
        var j = i + 1;
        while (j < d.edges.len()) {
            final a = d.edges[i];
            final b = d.edges[j];
            var found = false;
            foreach (sa in edgeSegments(d, e: a)) {
                foreach (sb in edgeSegments(d, e: b)) {
                    if (segmentsOverlap(sa, b: sb)) { found = true; }
                }
            }
            if (found) {
                errs.append(Fault{
                    rule = "sameLine", subjects = [a.src, a.dst, b.src, b.dst],
                    text = "connectors {a.src}->{a.dst} and {b.src}->{b.dst} run along the same line",
                    fix = "offset one of their bends",
                });
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return errs;
}

// A bridge is a semicircle of HopRadius over the crossing. It needs HopClear of its leg on
// either side, the hop plus the shipped bend radius, so it never runs into a rounded corner.
final HopRadius = 8;
final HopClear = 16;

// Crossing is one proper crossing of two connectors at x,y: bridged indexes the edge the
// renderer draws a hop on, kept the one it hops over, both into d.edges.
object Crossing {
    bridged: int = 0,
    kept: int = 0,
    x: int = 0,
    y: int = 0,
}

// edgeWeight ranks connectors for bridging, lesser first: dashed, plain, accent. A back edge
// and an optional edge both reach the renderer as dashed, so they rank together here.
fun edgeWeight(e: Edge) > int {
    if (e.kind == "accent") { return 2; }
    if (e.dashed) { return 0; }
    return 1;
}

// crossings reports every proper crossing, a horizontal leg meeting a vertical one strictly
// inside both, so a shared end or a touch is none. The lesser edge carries the bridge, and
// of two equals the one declared later. A crossing is drawn, never refused; only a bridge
// with no room to seat is a fault.
fun crossings(d: Diagram) > [Crossing] {
    final found: mut [Crossing] = mut [<Crossing>];
    final segs: mut [[[int]]] = mut [<[[int]]>];
    foreach (e in d.edges) { segs.append(edgeSegments(d, e: e)); }
    var i = 0;
    while (i < d.edges.len()) {
        var j = i + 1;
        while (j < d.edges.len()) {
            var bridged = j;
            var kept = i;
            if (edgeWeight(d.edges[i]) < edgeWeight(d.edges[j])) {
                bridged = i;
                kept = j;
            }
            foreach (a in segs[i]) {
                foreach (b in segs[j]) {
                    var flat = a;
                    var upright = b;
                    if (a[0] == a[2]) {
                        flat = b;
                        upright = a;
                    }
                    final proper = flat[1] == flat[3] and flat[0] != flat[2] and upright[0] == upright[2] and upright[1] != upright[3]
                        and imin(flat[0], b: flat[2]) < upright[0] and upright[0] < imax(flat[0], b: flat[2])
                        and imin(upright[1], b: upright[3]) < flat[1] and flat[1] < imax(upright[1], b: upright[3]);
                    if (proper) { found.append(Crossing{ bridged = bridged, kept = kept, x = upright[0], y = flat[1] }); }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return found;
}

// bridgeRoom is how far a crossing's hop may reach along the bridged leg before it meets the
// leg's end or halfway to another hop on it.
fun bridgeRoom(d: Diagram, c: Crossing, found: [Crossing]) > int {
    var room = 0;
    foreach (seg in edgeSegments(d, e: d.edges[c.bridged])) {
        if (onSegment(seg, x: c.x, y: c.y)) {
            room = imin(iabs(c.x - seg[0]) + iabs(c.y - seg[1]), b: iabs(c.x - seg[2]) + iabs(c.y - seg[3]));
            foreach (other in found) {
                final apart = iabs(other.x - c.x) + iabs(other.y - c.y);
                if (other.bridged == c.bridged and apart > 0 and onSegment(seg, x: other.x, y: other.y)) {
                    room = imin(room, b: apart / 2);
                }
            }
        }
    }
    return room;
}

// bridgeFaults reports a crossing whose hop cannot seat. A generated figure has no author to
// move a bend, so there the renderer draws that crossing plain instead.
fun bridgeFaults(d: Diagram, found: [Crossing]) > [Fault] {
    final errs: mut [Fault] = mut [<Fault>];
    if (d.generated) { return errs; }
    foreach (c in found) {
        final room = bridgeRoom(d, c: c, found: found);
        if (room < HopClear) {
            final e = d.edges[c.bridged];
            final k = d.edges[c.kept];
            errs.append(Fault{
                rule = "bridge", subjects = [e.src, e.dst, k.src, k.dst],
                text = "edge {e.src}->{e.dst} crosses {k.src}->{k.dst} at {c.x},{c.y}, {room}px from a bend or another hop; a bridge needs {HopClear}",
            });
        }
    }
    return errs;
}

// onSegment reports x,y strictly inside an axis-aligned segment.
fun onSegment(seg: [int], x: int, y: int) > bool {
    if (seg[1] == seg[3] and y == seg[1]) { return imin(seg[0], b: seg[2]) < x and x < imax(seg[0], b: seg[2]); }
    if (seg[0] == seg[2] and x == seg[0]) { return imin(seg[1], b: seg[3]) < y and y < imax(seg[1], b: seg[3]); }
    return false;
}

// Fault is one broken rule. rule names the check, subjects the node or edge ids it is
// about (an edge as src then dst), text the fault and fix the author's remedy, empty when
// the text says it all. A caller that builds diagrams itself, as flow does, reads rule and
// subjects to restate a fault in its own terms.
object Fault {
    rule: str = "",
    subjects: [str] = [<str>],
    text: str = "",
    fix: str = "",
}

// validate returns one message per broken rule, empty when the diagram is sound: each
// fault's text, then its fix after "; ".
fun validate(d: Diagram) > [str] {
    final msgs: mut [str] = mut [<str>];
    foreach (f in faults(d)) {
        if (f.fix == "") {
            msgs.append(f.text);
        } else {
            msgs.append(f.text + "; " + f.fix);
        }
    }
    return msgs;
}

// faults is validate before the messages are joined. These are the design system's
// non-negotiables plus the structural ones a renderer cannot paper over: an edge naming a
// missing node, two nodes occupying the same space, two connectors landing on the same
// point of the same box.
fun faults(d: Diagram) > [Fault] {
    final errs: mut [Fault] = mut [<Fault>];

    if (d.id == "") { errs.append(Fault{ rule = "id", text = "diagram has no id", fix = "marker ids would collide when inlined" }); }
    if (d.generated == false and d.nodes.len() > MaxNodes) {
        errs.append(Fault{ rule = "nodeBudget", text = "{d.nodes.len()} nodes exceeds the budget of {MaxNodes}", fix = "split into overview plus detail" });
    }
    if (d.generated == false and d.edges.len() > MaxEdges) {
        errs.append(Fault{ rule = "edgeBudget", text = "{d.edges.len()} edges exceeds the budget of {MaxEdges}", fix = "split into overview plus detail" });
    }

    var accent = 0;
    foreach (n in d.nodes) {
        if (n.role == "focal") { accent = accent + 1; }
        if (onGrid(n.x) == false or onGrid(n.y) == false or onGrid(n.w) == false or onGrid(n.h) == false) {
            errs.append(Fault{ rule = "grid", subjects = [n.id], text = "node \"{n.id}\" is off the {Grid}px grid at {n.x},{n.y} {n.w}x{n.h}" });
        }
        if (n.x < 0 or n.y < 0 or n.x + n.w > d.width or n.y + n.h > d.height) {
            errs.append(Fault{ rule = "viewBox", subjects = [n.id], text = "node \"{n.id}\" falls outside the {d.width}x{d.height} viewBox" });
        }
        // A tag chip, a name and a sublabel need 64px to stack without colliding.
        if (n.tag != "" and n.sub != "" and n.h < 64) {
            errs.append(Fault{ rule = "stack", subjects = [n.id], text = "node \"{n.id}\" stacks a tag, a name and a sublabel in {n.h}px", fix = "needs 64" });
        }
        // Only a diamond's four vertices sit on the shape, so a fanned connector would
        // attach to empty space beside it.
        if (n.role == "decision" and (n.tag != "" or n.sub != "")) {
            errs.append(Fault{ rule = "decisionText", subjects = [n.id], text = "decision \"{n.id}\" carries a tag or sublabel", fix = "a diamond has room for neither" });
        }
        if (n.role == "security" and (n.tag != "" or n.sub != "")) {
            errs.append(Fault{ rule = "securityText", subjects = [n.id], text = "security boundary \"{n.id}\" carries a tag or sublabel", fix = "only its border label is painted" });
        }
        if (d.legend.len() > 0 and n.y + n.h > d.height - LegendStrip) {
            errs.append(Fault{ rule = "legendStrip", subjects = [n.id], text = "node \"{n.id}\" enters the legend strip", fix = "keep the bottom {LegendStrip}px clear" });
        }
        if (n.role == "decision") {
            var exits = 0;
            foreach (e in d.edges) {
                if (e.src == n.id) { exits = exits + 1; }
            }
            if (exits > MaxDecisionExits) {
                errs.append(Fault{ rule = "decisionExits", subjects = [n.id], text = "decision \"{n.id}\" has {exits} exits", fix = "past {MaxDecisionExits}, nest a second decision" });
            }
        }
    }
    foreach (e in d.edges) {
        if (e.kind == "accent") { accent = accent + 1; }
    }
    if (d.generated == false and accent > MaxAccent) {
        errs.append(Fault{ rule = "accentBudget", text = "{accent} accent elements exceeds the budget of {MaxAccent}", fix = "the focal signal is gone" });
    }

    foreach (z in d.zones) {
        if (onGrid(z.x) == false or onGrid(z.y) == false or onGrid(z.w) == false or onGrid(z.h) == false) {
            errs.append(Fault{ rule = "zoneGrid", subjects = [z.label], text = "zone \"{z.label}\" is off the {Grid}px grid" });
        }
    }
    if (d.generated == false and d.zones.len() > MaxZones) {
        errs.append(Fault{ rule = "zoneBudget", text = "{d.zones.len()} zones exceeds the budget of {MaxZones}", fix = "a figure banded that finely is a swimlane" });
    }

    var i = 0;
    while (i < d.nodes.len()) {
        var j = i + 1;
        while (j < d.nodes.len()) {
            final a = d.nodes[i];
            final b = d.nodes[j];
            if (a.id == b.id) { errs.append(Fault{ rule = "duplicateId", subjects = [a.id], text = "duplicate node id \"{a.id}\"" }); }
            if (boxesOverlap([a.x, a.y, a.w, a.h], n: b) and bounds(a, inner: b) == false and bounds(b, inner: a) == false) {
                errs.append(Fault{ rule = "overlap", subjects = [a.id, b.id], text = "nodes \"{a.id}\" and \"{b.id}\" overlap" });
            }
            j = j + 1;
        }
        i = i + 1;
    }

    foreach (e in d.edges) {
        final ends = [e.src, e.dst];
        if (findNode(d, id: e.src) == null) { errs.append(Fault{ rule = "unknownEnd", subjects = ends, text = "edge from unknown node \"{e.src}\"" }); }
        if (findNode(d, id: e.dst) == null) { errs.append(Fault{ rule = "unknownEnd", subjects = ends, text = "edge to unknown node \"{e.dst}\"" }); }
        if (e.src == e.dst) { errs.append(Fault{ rule = "selfLoop", subjects = ends, text = "edge from \"{e.src}\" to itself" }); }
        if (e.srcSlot < 1 or e.srcSlot > e.srcSlots) {
            errs.append(Fault{ rule = "slot", subjects = ends, text = "edge {e.src}->{e.dst}: srcSlot {e.srcSlot} outside 1..{e.srcSlots}" });
        }
        if (e.dstSlot < 1 or e.dstSlot > e.dstSlots) {
            errs.append(Fault{ rule = "slot", subjects = ends, text = "edge {e.src}->{e.dst}: dstSlot {e.dstSlot} outside 1..{e.dstSlots}" });
        }
        if (e.label.len() > MaxEdgeLabel) {
            errs.append(Fault{ rule = "labelLength", subjects = ends, text = "edge {e.src}->{e.dst}: label \"{e.label}\" exceeds {MaxEdgeLabel} characters" });
        }
        if (isDecision(d, id: e.src) and e.srcSlots > 1) {
            errs.append(Fault{ rule = "decisionFan", subjects = ends, text = "edge {e.src}->{e.dst}: leaves decision \"{e.src}\" on a fanned slot, off the diamond" });
        }
        if (isDecision(d, id: e.dst) and e.dstSlots > 1) {
            errs.append(Fault{ rule = "decisionFan", subjects = ends, text = "edge {e.src}->{e.dst}: enters decision \"{e.dst}\" on a fanned slot, off the diamond" });
        }
        foreach (f in viaFaults(d, e: e)) { errs.append(f); }
        // A generated layout packs its channels one grid step apart and has no author to
        // move a bend, so there the painter clamps the radius down instead.
        if (d.generated == false and findNode(d, id: e.src) != null and findNode(d, id: e.dst) != null) {
            final tight = tightestBend(d, e);
            if (tight < BendFloor) {
                errs.append(Fault{
                    rule = "bend", subjects = ends,
                    text = "edge {e.src}->{e.dst}: a leg leaves {tight}px for a bend that needs {BendFloor}",
                    fix = "move the bend or the boxes",
                });
            }
        }
    }

    foreach (f in sharedAttachPoints(d)) { errs.append(f); }
    foreach (f in overlappingConnectors(d)) { errs.append(f); }
    foreach (f in bridgeFaults(d, found: crossings(d))) { errs.append(f); }
    final spots = labelSpots(d);
    var k = 0;
    while (k < d.edges.len()) {
        final e = d.edges[k];
        k = k + 1;
        if (e.label != "" and findNode(d, id: e.src) != null and findNode(d, id: e.dst) != null and spots[k - 1].len() == 0) {
            errs.append(Fault{
                rule = "label", subjects = [e.src, e.dst],
                text = "edge {e.src}->{e.dst}: label \"{e.label}\" has no spot {LabelClear}px clear of every stroke, box and label",
                fix = "shorten the label or give the connector a longer leg",
            });
        }
    }
    return errs;
}

// viaFaults holds a polyline to the rules connectorPath enforces by construction: every
// corner on the grid, and every leg axis-aligned, so a via cannot smuggle in a diagonal.
fun viaFaults(d: Diagram, e: Edge) > [Fault] {
    final errs: mut [Fault] = mut [<Fault>];
    final ends = [e.src, e.dst];
    if (e.via.len() == 0) { return errs; }
    if (e.via.len() % 2 != 0) {
        errs.append(Fault{ rule = "via", subjects = ends, text = "edge {e.src}->{e.dst}: via carries {e.via.len()} coordinates", fix = "it takes x,y pairs" });
        return errs;
    }
    foreach (v in e.via) {
        if (onGrid(v) == false) {
            errs.append(Fault{ rule = "via", subjects = ends, text = "edge {e.src}->{e.dst}: via coordinate {v} is off the {Grid}px grid" });
        }
    }
    if (findNode(d, id: e.src) == null or findNode(d, id: e.dst) == null) { return errs; }
    final pts = edgePoints(edgeGeometry(d, e), e);
    var i = 2;
    while (i + 1 < pts.len()) {
        if (pts[i - 2] != pts[i] and pts[i - 1] != pts[i + 1]) {
            errs.append(Fault{ rule = "via", subjects = ends, text = "edge {e.src}->{e.dst}: via runs diagonally from {pts[i - 2]},{pts[i - 1]} to {pts[i]},{pts[i + 1]}" });
        }
        i = i + 2;
    }
    return errs;
}

// boxesOverlap reports whether the rectangle [x, y, w, h] shares area with n; touching
// edges do not count.
fun boxesOverlap(box: [int], n: Node) > bool {
    return box[0] < n.x + n.w and n.x < box[0] + box[2] and box[1] < n.y + n.h and n.y < box[1] + box[3];
}

// bounds reports whether outer is a security boundary wholly containing inner, the one
// overlap that is the point of the role rather than a collision.
fun bounds(outer: Node, inner: Node) > bool {
    return outer.role == "security"
        and inner.x >= outer.x and inner.y >= outer.y
        and inner.x + inner.w <= outer.x + outer.w and inner.y + inner.h <= outer.y + outer.h;
}

// tightestBend returns the largest radius the painters could seat at the edge's tightest
// turning corner, or BendFloor when nothing turns. It repeats connectorPath's and routePath's
// clamps, so a finding here is exactly a corner they would have drawn sharper.
fun tightestBend(d: Diagram, e: Edge) > int {
    final geo = edgeGeometry(d, e);
    if (e.via.len() > 0) {
        if (e.via.len() % 2 != 0) { return BendFloor; }
        final pts = edgePoints(geo, e);
        final n = pts.len() / 2;
        var tight = BendFloor;
        var i = 1;
        while (i < n - 1) {
            final px = pts[2 * i - 2];
            final py = pts[2 * i - 1];
            final cx = pts[2 * i];
            final cy = pts[2 * i + 1];
            final nx = pts[2 * i + 2];
            final ny = pts[2 * i + 3];
            final turns = (px == cx and cx == nx) == false and (py == cy and cy == ny) == false;
            if (turns) {
                var inLen = iabs(cx - px) + iabs(cy - py);
                var outLen = iabs(nx - cx) + iabs(ny - cy);
                if (i > 1) { inLen = inLen / 2; }
                if (i < n - 2) { outLen = outLen / 2; }
                tight = imin(tight, b: imin(inLen, b: outLen));
            }
            i = i + 1;
        }
        return tight;
    }
    final x1 = geo[0];
    final y1 = geo[1];
    final x2 = geo[2];
    final y2 = geo[3];
    if (e.bend == 0 and (x1 == x2 or y1 == y2)) { return BendFloor; }
    if (geo[4] == 1) {
        if (y1 == y2) { return BendFloor; }
        var bx = e.bend;
        if (bx == 0) { bx = snap(x1 + (x2 - x1) / 2); }
        return imin(iabs(bx - x1), b: imin(iabs(x2 - bx), b: iabs(y2 - y1) / 2));
    }
    if (x1 == x2) { return BendFloor; }
    var by = e.bend;
    if (by == 0) { by = snap(y1 + (y2 - y1) / 2); }
    return imin(iabs(by - y1), b: imin(iabs(y2 - by), b: iabs(x2 - x1) / 2));
}

// sharedAttachPoints reports connectors that land on the same point of the same box. Two
// edges may share a side, but only by declaring different slots of the same total.
fun sharedAttachPoints(d: Diagram) > [Fault] {
    final errs: mut [Fault] = mut [<Fault>];
    final seen: mut [str] = mut [<str>];
    foreach (e in d.edges) {
        final a = attachKey(d, e, isFrom: true);
        final b = attachKey(d, e, isFrom: false);
        foreach (k in seen) {
            if (k == a) {
                errs.append(Fault{ rule = "sharedAttach", subjects = [e.src, e.dst], text = "two connectors share the attach point {a}", fix = "fan them with distinct slots" });
            }
            if (k == b) {
                errs.append(Fault{ rule = "sharedAttach", subjects = [e.src, e.dst], text = "two connectors share the attach point {b}", fix = "fan them with distinct slots" });
            }
        }
        seen.append(a);
        seen.append(b);
    }
    return errs;
}

fun attachKey(d: Diagram, e: Edge, isFrom: bool) > str {
    var n = e.dst;
    var slot = e.dstSlot;
    var slots = e.dstSlots;
    if (isFrom) {
        n = e.src;
        slot = e.srcSlot;
        slots = e.srcSlots;
    }
    final side = resolveSide(d, e, isFrom: isFrom);
    return "{n}.{side}[{slot}/{slots}]";
}

// resolveSide turns "auto" into a concrete side by comparing box centers: the wider gap
// wins, so two boxes side by side connect left-to-right rather than looping over the top.
fun resolveSide(d: Diagram, e: Edge, isFrom: bool) > str {
    var declared = e.dstSide;
    if (isFrom) { declared = e.srcSide; }
    if (declared != "auto") { return declared; }

    final a = findNode(d, id: e.src);
    final b = findNode(d, id: e.dst);
    if (a == null or b == null) { return "right"; }
    final ax = a!.x + a!.w / 2;
    final ay = a!.y + a!.h / 2;
    final bx = b!.x + b!.w / 2;
    final by = b!.y + b!.h / 2;

    if (iabs(bx - ax) >= iabs(by - ay)) {
        if (bx >= ax) {
            if (isFrom) { return "right"; }
            return "left";
        }
        if (isFrom) { return "left"; }
        return "right";
    }
    if (by >= ay) {
        if (isFrom) { return "bottom"; }
        return "top";
    }
    if (isFrom) { return "top"; }
    return "bottom";
}

// attachPoint places connector k of n along a box edge at k/(n+1), snapped to the grid, or
// on the pitch lattice about the side's midline, so connectors sharing a side stay
// independently traceable.
fun attachPoint(n: Node, side: str, slot: int, slots: int, pitch: int) > [int] {
    var fx = n.x + snap(n.w * slot / (slots + 1));
    var fy = n.y + snap(n.h * slot / (slots + 1));
    if (pitch > 0) {
        final off = latticeOffset(slot, slots: slots, pitch: pitch);
        fx = n.x + snap(n.w / 2) + off;
        fy = n.y + snap(n.h / 2) + off;
    }
    if (side == "left") { return [n.x, fy]; }
    if (side == "right") { return [n.x + n.w, fy]; }
    if (side == "top") { return [fx, n.y]; }
    return [fx, n.y + n.h];
}

// latticeOffset is where slot k of n sits from its side's midline on a pitch lattice: an
// odd n puts its middle slot on the midline, an even n straddles it. A half pitch off the
// 4px grid rounds away from the midline, so the lattice stays symmetric and no two slots
// close to under a pitch.
fun latticeOffset(slot: int, slots: int, pitch: int) > int {
    final v = (2 * slot - slots - 1) * pitch / 2;
    final r = iabs(v) % Grid;
    if (r == 0) { return v; }
    return v + isign(v) * (Grid - r);
}

// connectorPath emits an orthogonal route with rounded bends. Diagonals are not
// representable here by construction, which is how the "no diagonal connectors" rule is
// enforced rather than merely documented.
//
// A horizontal route leaves and enters on the left/right sides and crosses on a vertical
// segment at x = bend; a vertical route is the transpose. When the two points already share
// an axis the route degenerates to a straight line and no bend is drawn.
fun connectorPath(x1: int, y1: int, x2: int, y2: int, horizontal: bool, bend: int, radius: int) > str {
    // A shared axis collapses to a straight line only when no detour was asked for. A
    // return leg (bottom to bottom, say) shares its y with its own source, and taking the
    // shortcut there draws the connector straight through both boxes, which the nodes then
    // paint over.
    if (bend == 0 and (x1 == x2 or y1 == y2)) {
        return "M {x1} {y1} L {x2} {y2}";
    }

    if (horizontal) {
        var bx = bend;
        if (bx == 0) { bx = snap(x1 + (x2 - x1) / 2); }
        // Clamp the radius so a short leg cannot make the two quarter-rounds overlap and
        // bow the connector back on itself.
        final r = imin(radius, b: imin(iabs(bx - x1), b: imin(iabs(x2 - bx), b: iabs(y2 - y1) / 2)));
        if (r <= 0) { return "M {x1} {y1} L {bx} {y1} L {bx} {y2} L {x2} {y2}"; }
        final sx = isign(bx - x1);
        final sy = isign(y2 - y1);
        final sx2 = isign(x2 - bx);
        return "M {x1} {y1}"
            + " L {bx - sx * r} {y1}"
            + " Q {bx} {y1} {bx} {y1 + sy * r}"
            + " L {bx} {y2 - sy * r}"
            + " Q {bx} {y2} {bx + sx2 * r} {y2}"
            + " L {x2} {y2}";
    }

    var by = bend;
    if (by == 0) { by = snap(y1 + (y2 - y1) / 2); }
    final r = imin(radius, b: imin(iabs(by - y1), b: imin(iabs(y2 - by), b: iabs(x2 - x1) / 2)));
    if (r <= 0) { return "M {x1} {y1} L {x1} {by} L {x2} {by} L {x2} {y2}"; }
    final sy = isign(by - y1);
    final sx = isign(x2 - x1);
    final sy2 = isign(y2 - by);
    return "M {x1} {y1}"
        + " L {x1} {by - sy * r}"
        + " Q {x1} {by} {x1 + sx * r} {by}"
        + " L {x2 - sx * r} {by}"
        + " Q {x2} {by} {x2} {by + sy2 * r}"
        + " L {x2} {y2}";
}

// routePath is connectorPath for a polyline of x,y pairs: one rounded bend per interior
// corner. A corner may take all of an end leg but only half of an inner one, which the
// corner at its other end shares, and never the room a hop on either leg needs. Each hop
// is a crossing point on a leg, drawn as a semicircle that bulges up over a horizontal
// leg and left of a vertical one whichever way the leg runs.
fun routePath(pts: [int], radius: int, hops: [[int]] = [<[int]>]) > str {
    final n = pts.len() / 2;
    final parts: mut [str] = mut ["M {pts[0]} {pts[1]}"];
    var i = 1;
    while (i < n - 1) {
        final px = pts[2 * i - 2];
        final py = pts[2 * i - 1];
        final cx = pts[2 * i];
        final cy = pts[2 * i + 1];
        final nx = pts[2 * i + 2];
        final ny = pts[2 * i + 3];
        var inLen = iabs(cx - px) + iabs(cy - py);
        var outLen = iabs(nx - cx) + iabs(ny - cy);
        if (i > 1) { inLen = inLen / 2; }
        if (i < n - 2) { outLen = outLen / 2; }
        var r = imin(radius, b: imin(inLen, b: outLen));
        foreach (h in hops) {
            final seg = [px, py, cx, cy];
            final next = [cx, cy, nx, ny];
            if (onSegment(seg, x: h[0], y: h[1]) or onSegment(next, x: h[0], y: h[1])) {
                r = imin(r, b: iabs(h[0] - cx) + iabs(h[1] - cy) - HopRadius);
            }
        }
        appendHops(parts, leg: [px, py, cx, cy], hops: hops);
        if (r <= 0) {
            parts.append("L {cx} {cy}");
        } else {
            final ix = isign(cx - px);
            final iy = isign(cy - py);
            final ox = isign(nx - cx);
            final oy = isign(ny - cy);
            parts.append("L {cx - ix * r} {cy - iy * r}");
            parts.append("Q {cx} {cy} {cx + ox * r} {cy + oy * r}");
        }
        i = i + 1;
    }
    if (n >= 2) { appendHops(parts, leg: [pts[2 * n - 4], pts[2 * n - 3], pts[2 * n - 2], pts[2 * n - 1]], hops: hops); }
    parts.append("L {pts[2 * n - 2]} {pts[2 * n - 1]}");
    return parts.join(" ");
}

// appendHops draws the hops lying on one leg, in the order the leg meets them.
fun appendHops(parts: mut [str], leg: [int], hops: [[int]]) > void {
    final on: mut [[int]] = mut [<[int]>];
    foreach (h in hops) {
        if (onSegment(leg, x: h[0], y: h[1])) { on.append(h); }
    }
    final dx = isign(leg[2] - leg[0]);
    final dy = isign(leg[3] - leg[1]);
    on.sort(fun (a: [int], b: [int]) > bool { return (a[0] - b[0]) * dx + (a[1] - b[1]) * dy < 0; });
    var sweep = 0;
    if (dx > 0 or dy < 0) { sweep = 1; }
    foreach (h in on) {
        parts.append("L {h[0] - dx * HopRadius} {h[1] - dy * HopRadius}");
        parts.append("A {HopRadius} {HopRadius} 0 0 {sweep} {h[0] + dx * HopRadius} {h[1] + dy * HopRadius}");
    }
}

// nodePaint and nodeStroke implement the role-to-treatment table. Roles the table does not
// name fall back to the default treatment rather than failing: validate is where an
// unknown role should be caught, not the painter.
fun nodePaint(role: str, p: Palette) > str {
    if (role == "input") { return " fill=\"{p.muted}\" fill-opacity=\"0.1\" stroke=\"{p.soft}\""; }
    if (role == "security") {
        return " fill=\"{p.accent}\" fill-opacity=\"0.05\" stroke=\"{p.accent}\" stroke-opacity=\"0.5\"";
    }
    var fill = p.surface;
    if (role == "focal") { fill = p.accentTint; }
    if (role == "store" or role == "external") { fill = p.paper; }
    return " fill=\"{fill}\" stroke=\"" + nodeStroke(role, p) + "\"";
}

fun nodeStroke(role: str, p: Palette) > str {
    if (role == "focal" or role == "security") { return p.accent; }
    if (role == "external" or role == "optional" or role == "input") { return p.soft; }
    return p.rule;
}

fun edgeStroke(kind: str, p: Palette) > str {
    if (kind == "accent") { return p.accent; }
    if (kind == "link") { return p.link; }
    return p.muted;
}

// renderSvg paints the diagram and throws a joined validation report when any rule is
// broken, so a malformed diagram fails the docs build instead of shipping crooked.
//
// Paint order is load-bearing: zones and security boundaries, then connectors and their
// labels, then nodes, then the legend. Connectors go under nodes so a stroke cannot cross a
// box face; a boundary goes under them because crossing it is what a connector is for.
//
// Style is defaulted rather than overloaded: a caller that only wants the design system as
// shipped keeps writing renderSvg(d, palette), and one that wants a knob names it.
fun renderSvg(d: Diagram, p: Palette, s: Style = Style{}) > str !> str {
    final errs = validate(d);
    if (errs.len() > 0) {
        throw "diagram \"{d.id}\": " + errs.join("; ");
    }

    // A heading gets its own band and the content is translated beneath it, so authored
    // coordinates describe the figure alone.
    var pad = 0;
    if (d.title != "" or d.eyebrow != "") { pad = HeaderPad; }
    final total = d.height + pad;
    // optimization: collect fragments and join once. `svg = svg + part` copies the entire
    // document accumulated so far on every element, and on the default nanbox build each
    // intermediate is pinned in the global object heap for the life of the process, so those
    // copies are never reclaimed. See plans/reclaim-the-buzz-heap.md.
    final parts: mut [str] = mut [<str>];
    parts.append("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {d.width} {total}\""
        + " width=\"{d.width}\" height=\"{total}\" role=\"img\""
        + " aria-labelledby=\"{d.id}-title {d.id}-desc\" class=\"magus-diagram\">");
    parts.append("<title id=\"{d.id}-title\">" + escapeSvg(d.title) + "</title>");
    parts.append("<desc id=\"{d.id}-desc\">" + escapeSvg(d.desc) + "</desc>");
    parts.append(renderMarkers(d, p, s));
    parts.append("<rect width=\"100%\" height=\"100%\" fill=\"{p.paper}\"/>");
    parts.append(renderHeader(d, p, s));
    parts.append("<g transform=\"translate(0,{pad})\">");
    foreach (z in d.zones) { parts.append(renderZone(z, p, s)); }
    foreach (n in d.nodes) {
        if (n.role == "security") { parts.append(renderNode(n, p, s)); }
    }
    final ids = edgeIds(d);
    final found = crossings(d);
    var k = 0;
    while (k < d.edges.len()) {
        final hops: mut [[int]] = mut [<[int]>];
        foreach (c in found) {
            if (c.bridged == k and bridgeRoom(d, c: c, found: found) >= HopClear) { hops.append([c.x, c.y]); }
        }
        parts.append(renderEdge(d, e: d.edges[k], p: p, s: s, id: ids[k], hops: hops));
        k = k + 1;
    }
    final spots = labelSpots(d);
    k = 0;
    while (k < d.edges.len()) {
        parts.append(renderEdgeLabel(d.edges[k], p: p, s: s, at: spots[k]));
        k = k + 1;
    }
    foreach (n in d.nodes) {
        if (n.role != "security") { parts.append(renderNode(n, p, s)); }
    }
    parts.append(renderLegend(d, p, s));
    parts.append("</g>");
    parts.append("</svg>");
    return parts.join("");
}

// renderMarkers defines one arrowhead per connector kind. All three are always emitted:
// an arrowhead referencing a marker that was not defined renders as a bare line, and which
// kinds a diagram uses is not worth tracking to save 200 bytes.
fun renderMarkers(d: Diagram, p: Palette, s: Style) > str {
    final parts: mut [str] = mut ["<defs>"];
    final half = s.arrowHeight / 2;
    foreach (k in ["default", "accent", "link"]) {
        parts.append("<marker id=\"{d.id}-arrow-{k}\" markerWidth=\"{s.arrowWidth}\" markerHeight=\"{s.arrowHeight}\""
            + " refX=\"{s.arrowWidth - 1}\" refY=\"{half}\" orient=\"auto\">"
            + "<polygon points=\"0 0, {s.arrowWidth} {half}, 0 {s.arrowHeight}\" fill=\"" + edgeStroke(k, p) + "\"/></marker>");
    }
    parts.append("</defs>");
    return parts.join("");
}

fun renderHeader(d: Diagram, p: Palette, s: Style) > str {
    var svg = "";
    if (d.eyebrow != "") {
        svg = svg + "<text x=\"{s.margin}\" y=\"32\" fill=\"{p.soft}\" font-size=\"{s.eyebrowSize}\""
            + " font-family=\"{s.monoFamily}\" style=\"font-variant-ligatures:none\""
            + " letter-spacing=\"{s.eyebrowTracking}\">" + escapeSvg(d.eyebrow.upper()) + "</text>";
    }
    if (d.title != "") {
        svg = svg + "<text x=\"{s.margin}\" y=\"60\" fill=\"{p.ink}\" font-size=\"{s.titleSize}\" font-weight=\"{s.titleWeight}\""
            + " font-family=\"{s.fontFamily}\">"
            + escapeSvg(d.title) + "</text>";
    }
    return svg;
}

// renderZone paints a band as an ink wash with an ink hairline, the label centred in the
// band's top margin on a paper mask.
fun renderZone(z: Zone, p: Palette, s: Style) > str {
    if (z.boundary) {
        return renderSecurity(Node{ label = z.label, role = "security", x = z.x, y = z.y, w = z.w, h = z.h }, p: p, s: s);
    }
    final rect = "<rect x=\"{z.x}\" y=\"{z.y}\" width=\"{z.w}\" height=\"{z.h}\" rx=\"{s.zoneRadius}\""
        + " fill=\"{p.ink}\" fill-opacity=\"0.02\" stroke=\"{p.ink}\" stroke-opacity=\"0.1\" stroke-width=\"{s.hairlineWidth}\"/>";
    if (z.label == "") { return rect; }
    final cx = z.x + z.w / 2;
    final w = snap(z.label.len() * 6 + 12);
    return rect + "<rect x=\"{cx - w / 2}\" y=\"{z.y + 4}\" width=\"{w}\" height=\"12\" rx=\"{s.chipRadius}\" fill=\"{p.paper}\"/>"
        + "<text x=\"{cx}\" y=\"{z.y + 13}\" fill=\"{p.ink}\" fill-opacity=\"0.4\" font-size=\"{s.zoneLabelSize}\""
        + " font-family=\"{s.monoFamily}\" style=\"font-variant-ligatures:none\" text-anchor=\"middle\""
        + " letter-spacing=\"{s.zoneLabelTracking}\">" + escapeSvg(z.label.upper()) + "</text>";
}

// renderDecision paints the diamond. The label sits on the center line rather than the
// stacked layout a box uses: a diamond's widest run is its middle, so a two-line stack
// would push text out past the sloping sides.
fun renderDecision(n: Node, p: Palette, s: Style) > str {
    final cx = n.x + n.w / 2;
    final cy = n.y + n.h / 2;
    final pts = "{cx},{n.y} {n.x + n.w},{cy} {cx},{n.y + n.h} {n.x},{cy}";
    return "<polygon points=\"" + pts + "\" fill=\"{p.paper}\"/>"
        + "<polygon points=\"" + pts + "\"" + nodePaint("default", p) + " stroke-width=\"{s.strokeWidth}\"/>"
        + "<text x=\"{cx}\" y=\"{cy + 4}\" fill=\"{p.ink}\" font-size=\"{s.labelSize}\" font-weight=\"{s.labelWeight}\""
        + " font-family=\"{s.fontFamily}\" text-anchor=\"middle\">"
        + escapeSvg(n.label) + "</text>";
}

// renderSecurity paints a trust boundary. There is no opaque under-layer: connectors are
// meant to show through the wash, and the label sits on a paper mask over the top border
// the way the design system labels every boundary.
fun renderSecurity(n: Node, p: Palette, s: Style) > str {
    final cx = n.x + n.w / 2;
    final w = snap(n.label.len() * 6 + 12);
    var svg = "<rect x=\"{n.x}\" y=\"{n.y}\" width=\"{n.w}\" height=\"{n.h}\" rx=\"{s.zoneRadius}\""
        + nodePaint("security", p) + " stroke-width=\"{s.strokeWidth}\" stroke-dasharray=\"{s.securityDash}\"/>";
    if (n.label != "") {
        svg = svg + "<rect x=\"{cx - w / 2}\" y=\"{n.y - 6}\" width=\"{w}\" height=\"12\" rx=\"{s.chipRadius}\" fill=\"{p.paper}\"/>"
            + "<text x=\"{cx}\" y=\"{n.y + 3}\" fill=\"{p.accent}\" font-size=\"{s.zoneLabelSize}\""
            + " font-family=\"{s.monoFamily}\" style=\"font-variant-ligatures:none\" text-anchor=\"middle\""
            + " letter-spacing=\"{s.zoneLabelTracking}\">" + escapeSvg(n.label.upper()) + "</text>";
    }
    return svg;
}

// renderNode wraps each node's shapes in one group a viewer can hook by id and anchor. With
// Style.anchorHref set, an anchored node becomes a link: an SVG <a> is focusable and
// followable before any script loads. A node with a link of its own is always one.
fun renderNode(n: Node, p: Palette, s: Style) > str {
    var attrs = " data-node=\"" + escapeSvg(n.id) + "\"";
    if (n.anchor != "") { attrs = attrs + " data-anchor=\"" + escapeSvg(n.anchor) + "\""; }
    if (n.line > 0) { attrs = attrs + " data-line=\"{n.line}\""; }
    final body = renderNodeBody(n, p, s);
    if (n.link != "") {
        return "<a href=\"" + escapeSvg(n.link) + "\"" + attrs + "><g>" + body + "</g></a>";
    }
    if (s.anchorHref != "" and n.anchor != "") {
        var line = "";
        if (n.line > 0) { line = "{n.line}"; }
        final href = s.anchorHref.replace("\{path\}", with: escapeSvg(n.anchor)).replace("\{line\}", with: line);
        return "<a href=\"" + href + "\"" + attrs + "><g>" + body + "</g></a>";
    }
    return "<g" + attrs + ">" + body + "</g>";
}

fun renderNodeBody(n: Node, p: Palette, s: Style) > str {
    final cx = n.x + n.w / 2;
    // A decision is a diamond inscribed in the node box, so its vertices land exactly on
    // the box edge midpoints attachPoint already returns. Same mask-then-shape order as a
    // box: the opaque under-layer stops a connector routed behind it showing through.
    if (n.role == "decision") { return renderDecision(n, p, s); }
    if (n.role == "security") { return renderSecurity(n, p, s); }
    // An opaque mask under the styled box stops a connector routed behind the node from
    // showing through a translucent fill such as accentTint.
    var svg = "<rect x=\"{n.x}\" y=\"{n.y}\" width=\"{n.w}\" height=\"{n.h}\" rx=\"{s.nodeRadius}\" fill=\"{p.paper}\"/>";
    var dash = "";
    if (n.role == "optional") { dash = " stroke-dasharray=\"{s.optionalDash}\""; }
    svg = svg + "<rect x=\"{n.x}\" y=\"{n.y}\" width=\"{n.w}\" height=\"{n.h}\" rx=\"{s.nodeRadius}\""
        + nodePaint(n.role, p) + " stroke-width=\"{s.strokeWidth}\"" + dash + "/>";

    if (n.tag != "") {
        final tw = snap(n.tag.len() * 6 + 12);
        svg = svg + "<rect x=\"{n.x + s.nodePadding}\" y=\"{n.y + s.nodePadding}\" width=\"{tw}\" height=\"12\" rx=\"{s.chipRadius}\""
            + " fill=\"none\" stroke=\"" + nodeStroke(n.role, p) + "\" stroke-width=\"{s.hairlineWidth}\"/>"
            + "<text x=\"{n.x + s.nodePadding + tw / 2}\" y=\"{n.y + 17}\" fill=\"{p.soft}\" font-size=\"{s.tagSize}\""
            + " font-family=\"{s.monoFamily}\" style=\"font-variant-ligatures:none\" text-anchor=\"middle\""
            + " letter-spacing=\"{s.tagTracking}\">" + escapeSvg(n.tag.upper()) + "</text>";
    }

    // A tag chip occupies y+8 through y+20, so a tagged node stacks its text from the top;
    // centering it there would sit the name on the chip. Untagged nodes center as usual,
    // with the name nudged down when there is no sublabel to balance it.
    var ny = n.y + n.h / 2;
    if (n.tag != "") {
        ny = n.y + 40;
    } else {
        if (n.sub == "") { ny = n.y + n.h / 2 + 4; }
    }
    svg = svg + "<text x=\"{cx}\" y=\"{ny}\" fill=\"{p.ink}\" font-size=\"{s.labelSize}\" font-weight=\"{s.labelWeight}\""
        + " font-family=\"{s.fontFamily}\" text-anchor=\"middle\">"
        + escapeSvg(n.label) + "</text>";
    if (n.sub != "") {
        svg = svg + "<text x=\"{cx}\" y=\"{ny + 16}\" fill=\"{p.soft}\" font-size=\"{s.subSize}\""
            + " font-family=\"{s.monoFamily}\" style=\"font-variant-ligatures:none\" text-anchor=\"middle\">"
            + escapeSvg(n.sub) + "</text>";
    }
    return svg;
}

// renderEdge paints one connector. id is its stable fragment, so a link can target one
// arrow and CSS :target can light it with no script; hops are the crossings it bridges.
fun renderEdge(d: Diagram, e: Edge, p: Palette, s: Style, id: str, hops: [[int]]) > str {
    final geo = edgeGeometry(d, e);
    var dash = "";
    if (e.dashed) { dash = " stroke-dasharray=\"{s.edgeDash}\""; }
    var radius = s.bendRadius;
    if (radius < BendFloor) { radius = BendFloor; }
    var route = "";
    if (e.via.len() > 0) {
        route = routePath(edgePoints(geo, e), radius: radius, hops: hops);
    } else {
        if (hops.len() > 0) {
            final segs = edgeSegments(d, e);
            final pts: mut [int] = mut [segs[0][0], segs[0][1]];
            foreach (seg in segs) {
                pts.append(seg[2]);
                pts.append(seg[3]);
            }
            route = routePath(pts, radius: radius, hops: hops);
        } else {
            route = connectorPath(geo[0], y1: geo[1], x2: geo[2], y2: geo[3], horizontal: geo[4] == 1, bend: e.bend, radius: radius);
        }
    }
    return "<path data-edge=\"" + escapeSvg(e.src) + "->" + escapeSvg(e.dst) + "\" id=\"" + id + "\" d=\"" + route + "\""
        + " fill=\"none\" stroke=\"" + edgeStroke(e.kind, p) + "\" stroke-width=\"{s.strokeWidth}\"" + dash
        + " marker-end=\"url(#{d.id}-arrow-{e.kind})\"/>";
}

// edgeIds names each connector `<figure>-edge-<src>-<dst>`, every byte outside
// [A-Za-z0-9_-] written as _ and its hex, so the id is a valid fragment. The same pair drawn
// twice takes -2, -3 on the later ones, so no two paths share an id.
fun edgeIds(d: Diagram) > [str] {
    final ids: mut [str] = mut [<str>];
    final seen: mut {str: int} = mut {<str: int>};
    foreach (e in d.edges) {
        final base = fragment(d.id) + "-edge-" + fragment(e.src) + "-" + fragment(e.dst);
        final n = (seen[base] ?? 0) + 1;
        seen[base] = n;
        if (n == 1) {
            ids.append(base);
        } else {
            ids.append("{base}-{n}");
        }
    }
    return ids;
}

fun fragment(s: str) > str {
    final parts: mut [str] = mut [<str>];
    var i = 0;
    while (i < s.len()) {
        final c = s.sub(i, len: 1);
        final b = s.byte(i);
        final plain = (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 or b == 45;
        if (plain) {
            parts.append(c);
        } else {
            parts.append("_" + c.hex());
        }
        i = i + 1;
    }
    return parts.join("");
}

// edgeGeometry resolves an edge to [x1, y1, x2, y2, horizontal]. Buzz has no tuple, and a
// five-int list beats threading five result params through the painters.
fun edgeGeometry(d: Diagram, e: Edge) > [int] {
    final a = findNode(d, id: e.src);
    final b = findNode(d, id: e.dst);
    if (a == null or b == null) { return [0, 0, 0, 0, 1]; }
    final fromSide = resolveSide(d, e, isFrom: true);
    final toSide = resolveSide(d, e, isFrom: false);
    final s = attachPoint(a!, side: fromSide, slot: e.srcSlot, slots: e.srcSlots, pitch: d.pitch);
    final t = attachPoint(b!, side: toSide, slot: e.dstSlot, slots: e.dstSlots, pitch: d.pitch);
    final horizontal = fromSide == "left" or fromSide == "right";
    var h = 0;
    if (horizontal) { h = 1; }
    return [s[0], s[1], t[0], t[1], h];
}

fun renderEdgeLabel(e: Edge, p: Palette, s: Style, at: [int]) > str {
    if (e.label == "" or at.len() == 0) { return ""; }
    final cx = at[0];
    final cy = at[1];
    final w = at[2];
    return "<rect x=\"{cx - w / 2}\" y=\"{cy - 8}\" width=\"{w}\" height=\"12\" rx=\"{s.chipRadius}\" fill=\"{p.paper}\"/>"
        + "<text x=\"{cx}\" y=\"{cy + 1}\" fill=\"{p.soft}\" font-size=\"{s.edgeLabelSize}\""
        + " font-family=\"{s.monoFamily}\" style=\"font-variant-ligatures:none\" text-anchor=\"middle\""
        + " letter-spacing=\"{s.edgeLabelTracking}\">" + escapeSvg(e.label.upper()) + "</text>";
}

// labelPlacement returns [cx, cy, w] for an edge label: centred on cx, baseline just under
// cy, over a mask w wide spanning cy-8 to cy+4. Empty when no spot is clear, which validate
// reports as a finding naming the edge, or when e is not one of d's edges.
fun labelPlacement(d: Diagram, e: Edge) > [int] {
    final spots = labelSpots(d);
    var k = 0;
    while (k < d.edges.len()) {
        final x = d.edges[k];
        if (x.src == e.src and x.dst == e.dst and x.label == e.label) { return spots[k]; }
        k = k + 1;
    }
    return [<int>];
}

// labelSpots places every edge's label in declaration order, each mask an obstacle to the
// labels after it; an unlabelled edge, or one with no clear spot, gets an empty entry.
fun labelSpots(d: Diagram) > [[int]] {
    final obstacles: mut [[int]] = mut [<[int]>];
    foreach (s in strokesOf(d)) { obstacles.append(s); }
    final spots: mut [[int]] = mut [<[int]>];
    foreach (e in d.edges) {
        var at: [int] = [<int>];
        if (e.label != "" and findNode(d, id: e.src) != null and findNode(d, id: e.dst) != null) {
            at = labelSpot(d, e: e, strokes: obstacles);
        }
        if (at.len() > 0) { obstacles.append([at[0] - at[2] / 2, at[1] - 8, at[0] + at[2] / 2, at[1] + 4]); }
        spots.append(at);
    }
    return spots;
}

// strokesOf is every leg of every connector, plus the square each bridge's hop can reach, as
// the obstacles a label keeps clear of: [x1, y1, x2, y2], a leg or a box's corners.
fun strokesOf(d: Diagram) > [[int]] {
    final all: mut [[int]] = mut [<[int]>];
    foreach (e in d.edges) {
        foreach (seg in edgeSegments(d, e: e)) { all.append(seg); }
    }
    foreach (c in crossings(d)) {
        all.append([c.x - HopRadius, c.y - HopRadius, c.x + HopRadius, c.y + HopRadius]);
    }
    return all;
}

// labelSpot searches leg by leg: horizontal legs first, longest first, then vertical ones.
// On each leg it tries the midpoint, then slides a grid step at a time either way along
// it; a horizontal leg takes the label above its stroke, else below, a vertical one right,
// else left. The first spot whose mask stays on the canvas and keeps LabelClear from every
// stroke and box wins, so a label crowded off one leg moves to the next.
fun labelSpot(d: Diagram, e: Edge, strokes: [[int]]) > [int] {
    final w = snap(e.label.len() * 5 + 12);
    final flat: mut [[int]] = mut [<[int]>];
    final upright: mut [[int]] = mut [<[int]>];
    foreach (seg in edgeSegments(d, e)) {
        if (seg[1] == seg[3] and seg[0] != seg[2]) { insertByLength(flat, seg: seg); }
        if (seg[0] == seg[2] and seg[1] != seg[3]) { insertByLength(upright, seg: seg); }
    }
    foreach (seg in flat) {
        foreach (x in slides(seg[0], b: seg[2])) {
            foreach (at in [[x, seg[1] - LabelGap - 4, w], [x, seg[1] + LabelGap + 8, w]]) {
                if (labelClear(d, at: at, strokes: strokes)) { return at; }
            }
        }
    }
    foreach (seg in upright) {
        foreach (y in slides(seg[1], b: seg[3])) {
            foreach (at in [[seg[0] + LabelGap + w / 2, y, w], [seg[0] - LabelGap - w / 2, y, w]]) {
                if (labelClear(d, at: at, strokes: strokes)) { return at; }
            }
        }
    }
    return [<int>];
}

// slides is a leg's midpoint, then every 8px either way out to its ends, nearest first.
fun slides(a: int, b: int) > [int] {
    final lo = imin(a, b: b);
    final hi = imax(a, b: b);
    final mid = snap(a + (b - a) / 2);
    final at: mut [int] = mut [mid];
    var step = 8;
    while (mid - step >= lo or mid + step <= hi) {
        if (mid - step >= lo) { at.append(mid - step); }
        if (mid + step <= hi) { at.append(mid + step); }
        step = step + 8;
    }
    return at;
}

fun insertByLength(segs: mut [[int]], seg: [int]) > void {
    final len = iabs(seg[2] - seg[0]) + iabs(seg[3] - seg[1]);
    var i = 0;
    while (i < segs.len() and iabs(segs[i][2] - segs[i][0]) + iabs(segs[i][3] - segs[i][1]) >= len) {
        i = i + 1;
    }
    segs.insert(i, value: seg);
}

// labelClear reports whether a label mask at [cx, cy, w] sits on the canvas and keeps
// LabelClear from every box and stroke. A security boundary is exempt: a label inside one
// reads as inside the boundary.
fun labelClear(d: Diagram, at: [int], strokes: [[int]]) > bool {
    final mask = [at[0] - at[2] / 2, at[1] - 8, at[2], 12];
    if (mask[0] < 0 or mask[1] < 0 or mask[0] + mask[2] > d.width or mask[1] + mask[3] > d.height) {
        return false;
    }
    final lx = mask[0] - LabelClear;
    final ly = mask[1] - LabelClear;
    final hx = mask[0] + mask[2] + LabelClear;
    final hy = mask[1] + mask[3] + LabelClear;
    foreach (n in d.nodes) {
        if (n.role != "security" and boxesOverlap([lx, ly, hx - lx, hy - ly], n: n)) { return false; }
    }
    foreach (s in strokes) {
        if (imin(s[0], b: s[2]) < hx and imax(s[0], b: s[2]) > lx and imin(s[1], b: s[3]) < hy and imax(s[1], b: s[3]) > ly) {
            return false;
        }
    }
    return true;
}

// renderLegend draws the strip in the figure's bottom LegendStrip px, which validate keeps
// free of nodes: a hairline, the LEGEND word, then one swatch per entry.
fun renderLegend(d: Diagram, p: Palette, s: Style) > str {
    if (d.legend.len() == 0) { return ""; }
    final top = d.height - LegendStrip;
    final y = d.height - s.margin;
    final parts: mut [str] = mut [
        "<line x1=\"{s.margin}\" y1=\"{top}\" x2=\"{d.width - s.margin}\" y2=\"{top}\""
            + " stroke=\"{p.rule}\" stroke-width=\"{s.hairlineWidth}\"/>",
        "<text x=\"{s.margin}\" y=\"{top + 14}\" fill=\"{p.muted}\" font-size=\"{s.legendSize}\""
            + " font-family=\"{s.monoFamily}\" style=\"font-variant-ligatures:none\""
            + " letter-spacing=\"{s.legendTracking}\">LEGEND</text>",
    ];
    var x = s.margin;
    foreach (item in d.legend) {
        parts.append("<rect x=\"{x}\" y=\"{y - 8}\" width=\"{s.legendSwatch}\" height=\"{s.legendSwatch}\" rx=\"{s.chipRadius}\""
            + nodePaint(item.role, p) + " stroke-width=\"{s.hairlineWidth}\"/>"
            + "<text x=\"{x + 18}\" y=\"{y + 1}\" fill=\"{p.soft}\" font-size=\"{s.legendSize}\""
            + " font-family=\"{s.monoFamily}\" style=\"font-variant-ligatures:none\""
            + " letter-spacing=\"{s.legendTracking}\">" + escapeSvg(item.label.upper()) + "</text>");
        x = x + s.legendPitch;
    }
    return parts.join("");
}

// twoBox is the smallest sound diagram: two boxes on one row, one connector between them.
// Tests mutate a copy of it so each one states only the rule it is about.
fun twoBox() > Diagram {
    return Diagram{
        id = "t",
        title = "Two boxes",
        desc = "a and b",
        width = 480,
        height = 240,
        nodes = [
            Node{ id = "a", label = "A", x = 32, y = 112, w = 160, h = 56 },
            Node{ id = "b", label = "B", x = 288, y = 112, w = 160, h = 56 },
        ],
        edges = [ Edge{ src = "a", dst = "b" } ],
    };
}

test "a well-formed diagram validates clean" {
    assert\equal(validate(twoBox()).len(), want: 0, message: "no findings on the reference diagram");
}

test "authored coordinates must sit on the grid" {
    final d = twoBox();
    final bad = Diagram{
        id = d.id, width = d.width, height = d.height,
        nodes = [ Node{ id = "a", label = "A", x = 33, y = 80, w = 160, h = 56 } ],
    };
    assert\equal(validate(bad).len(), want: 1, message: "x=33 is off the 4px grid");
}

test "overlapping nodes are a finding" {
    final bad = Diagram{
        id = "t", width = 480, height = 240,
        nodes = [
            Node{ id = "a", label = "A", x = 32, y = 112, w = 160, h = 56 },
            Node{ id = "b", label = "B", x = 96, y = 112, w = 160, h = 56 },
        ],
    };
    assert\equal(validate(bad).len(), want: 1, message: "b starts inside a");
}

test "an edge naming a missing node is a finding" {
    final bad = Diagram{
        id = "t", width = 480, height = 240,
        nodes = [ Node{ id = "a", label = "A", x = 32, y = 112, w = 160, h = 56 } ],
        edges = [ Edge{ src = "a", dst = "ghost" } ],
    };
    assert\equal(validate(bad).len(), want: 1, message: "ghost is not a node");
}

// The rule this pins is the one that makes a diagram unreadable rather than merely ugly:
// two connectors landing on the same point of the same box cannot be told apart.
test "two connectors on one attach point are a finding" {
    final bad = Diagram{
        id = "t", width = 640, height = 320,
        nodes = [
            Node{ id = "a", label = "A", x = 32, y = 112, w = 160, h = 56 },
            Node{ id = "b", label = "B", x = 400, y = 112, w = 160, h = 56 },
            Node{ id = "c", label = "C", x = 400, y = 224, w = 160, h = 56 },
        ],
        edges = [
            Edge{ src = "a", dst = "b", srcSide = "right" },
            Edge{ src = "a", dst = "c", srcSide = "right" },
        ],
    };
    std\assert(validate(bad).len() > 0, message: "both edges leave a.right at slot 1 of 1");
}

test "fanning the same side with distinct slots validates clean" {
    final good = Diagram{
        id = "t", width = 640, height = 320,
        nodes = [
            Node{ id = "a", label = "A", x = 32, y = 112, w = 160, h = 56 },
            Node{ id = "b", label = "B", x = 400, y = 112, w = 160, h = 56 },
            Node{ id = "c", label = "C", x = 400, y = 224, w = 160, h = 56 },
        ],
        edges = [
            Edge{ src = "a", dst = "b", srcSide = "right", srcSlot = 1, srcSlots = 2 },
            Edge{ src = "a", dst = "c", srcSide = "right", srcSlot = 2, srcSlots = 2 },
        ],
    };
    assert\equal(validate(good).len(), want: 0, message: "distinct slots on one side are fine");
}

test "attachPoint spreads slots along the edge" {
    final n = Node{ id = "a", label = "A", x = 0, y = 0, w = 160, h = 60 };
    final one = attachPoint(n, side: "right", slot: 1, slots: 2, pitch: 0);
    final two = attachPoint(n, side: "right", slot: 2, slots: 2, pitch: 0);
    assert\equal(one[0], want: 160, message: "both leave the right face");
    assert\equal(two[0], want: 160, message: "both leave the right face");
    std\assert(one[1] != two[1], message: "slot 1 of 2 and slot 2 of 2 are distinct points");
}

test "a pitch lattice sits symmetric about the side's midline" {
    final n = Node{ id = "a", label = "A", x = 0, y = 0, w = 160, h = 64 };
    final odd: mut [int] = mut [<int>];
    foreach (k in [1, 2, 3]) { odd.append(attachPoint(n, side: "left", slot: k, slots: 3, pitch: 12)[1]); }
    assert\equal(odd, want: [20, 32, 44], message: "the middle slot of three on the midline");
    final even: mut [int] = mut [<int>];
    foreach (k in [1, 2, 3, 4]) { even.append(latticeOffset(k, slots: 4, pitch: 12)); }
    assert\equal(even, want: [0 - 20, 0 - 8, 8, 20], message: "an even fan straddles it, rounded away onto the grid");
}

// Connectors are orthogonal by construction. A shared axis must degenerate to a straight
// line rather than emit a bend, and a route across both axes must cross on a single
// segment, which is what keeps a diagonal unrepresentable.
test "a shared axis routes straight" {
    assert\equal(connectorPath(0, y1: 40, x2: 200, y2: 40, horizontal: true, bend: 0, radius: defaultStyle().bendRadius), want: "M 0 40 L 200 40", message: "same y");
    assert\equal(connectorPath(40, y1: 0, x2: 40, y2: 200, horizontal: false, bend: 0, radius: defaultStyle().bendRadius), want: "M 40 0 L 40 200", message: "same x");
}

test "a two-axis route bends on one crossing segment" {
    final path = connectorPath(0, y1: 0, x2: 200, y2: 120, horizontal: true, bend: 100, radius: defaultStyle().bendRadius);
    std\assert(path.startsWith("M 0 0"), message: "starts at the source attach point");
    std\assert(path.endsWith("L 200 120"), message: "ends at the destination attach point");
    std\assert(path.indexOf("Q") != null, message: "corners are rounded, not mitered");
}

test "marker ids are namespaced by diagram id" {
    final svg = renderSvg(twoBox(), p: lightPalette()) catch "threw";
    std\assert(svg.indexOf("id=\"t-arrow-default\"") != null, message: "marker id carries the diagram id");
    std\assert(svg.indexOf("url(#t-arrow-default)") != null, message: "the edge references it");
}

test "an invalid diagram fails the render rather than shipping crooked" {
    final bad = Diagram{
        id = "t", width = 480, height = 240,
        nodes = [ Node{ id = "a", label = "A", x = 33, y = 80, w = 160, h = 56 } ],
    };
    final svg = renderSvg(bad, p: lightPalette()) catch "threw";
    assert\equal(svg, want: "threw", message: "renderSvg throws on a validation finding");
}

// A diff nobody intended here is a default that drifted; a deliberate change to the design
// system regenerates it. Last regenerated for the edge path's stable id, a fragment a link
// can target.
test "the default Style renders the pre-Style bytes" {
    final want = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 280" width="480" height="280" role="img" aria-labelledby="t-title t-desc" class="magus-diagram">`
        + `<title id="t-title">Two boxes</title><desc id="t-desc">a and b</desc><defs>`
        + `<marker id="t-arrow-default" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">`
        + `<polygon points="0 0, 8 3, 0 6" fill="#4f5d75"/></marker>`
        + `<marker id="t-arrow-accent" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">`
        + `<polygon points="0 0, 8 3, 0 6" fill="#eb6c36"/></marker>`
        + `<marker id="t-arrow-link" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">`
        + `<polygon points="0 0, 8 3, 0 6" fill="#2e5aa8"/></marker></defs>`
        + `<rect width="100%" height="100%" fill="#f5f5f5"/>`
        + `<text x="32" y="60" fill="#2d3142" font-size="20" font-weight="600" font-family="var(--pico-font-family, sans-serif)">Two boxes</text>`
        + `<g transform="translate(0,40)">`
        + `<path data-edge="a->b" id="t-edge-a-b" d="M 192 140 L 288 140" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#t-arrow-default)"/>`
        + `<g data-node="a"><rect x="32" y="112" width="160" height="56" rx="6" fill="#f5f5f5"/>`
        + `<rect x="32" y="112" width="160" height="56" rx="6" fill="#ffffff" stroke="rgba(45,49,66,0.12)" stroke-width="1.2"/>`
        + `<text x="112" y="144" fill="#2d3142" font-size="12" font-weight="600" font-family="var(--pico-font-family, sans-serif)" text-anchor="middle">A</text></g>`
        + `<g data-node="b"><rect x="288" y="112" width="160" height="56" rx="6" fill="#f5f5f5"/>`
        + `<rect x="288" y="112" width="160" height="56" rx="6" fill="#ffffff" stroke="rgba(45,49,66,0.12)" stroke-width="1.2"/>`
        + `<text x="368" y="144" fill="#2d3142" font-size="12" font-weight="600" font-family="var(--pico-font-family, sans-serif)" text-anchor="middle">B</text></g>`
        + `</g></svg>`;
    assert\equal(renderSvg(twoBox(), p: lightPalette()) catch "threw", want, message: "twoBox at the shipped defaults");
    assert\equal(renderSvg(twoBox(), p: lightPalette(), s: defaultStyle()) catch "threw", want,
        message: "naming the default explicitly changes nothing");
}

// A knob nothing reaches is not customization. Three field kinds at once - a double, an int
// and a string - because each one reaches its attribute by a different formatting path.
test "a customized Style field reaches the attribute" {
    final styled = renderSvg(twoBox(), p: lightPalette(),
        s: Style{ strokeWidth = 2.0, nodeRadius = 12, fontFamily = "Iosevka" }) catch "threw";
    std\assert(styled.indexOf("stroke-width=\"2\"") != null, message: "the wider stroke landed");
    std\assert(styled.indexOf("rx=\"12\"") != null, message: "the rounder corner landed");
    std\assert(styled.indexOf("font-family=\"Iosevka\"") != null, message: "the family landed");
    std\assert(styled.indexOf("stroke-width=\"1\"") == null, message: "and the default is gone from it");
    final plain = renderSvg(twoBox(), p: lightPalette()) catch "threw";
    std\assert(plain.indexOf("stroke-width=\"2\"") == null, message: "a default render is untouched by it");
}

// The docs lease-loop figure, bend moved to the corridor's centre so both legs seat the
// bend floor. Its RELEASE label once sat on the vertical crossing between decl and work,
// its mask across both boxes.
fun leaseLoopGeometry() > Diagram {
    return Diagram{
        id = "lease-loop", width = 960, height = 600,
        nodes = [
            Node{ id = "cp", label = "cp", x = 32, y = 88, w = 200, h = 64 },
            Node{ id = "part", label = "part", x = 280, y = 88, w = 200, h = 64 },
            Node{ id = "decl", label = "decl", anchor = "internal/job", x = 528, y = 88, w = 200, h = 64 },
            Node{ id = "work", label = "work", role = "external", x = 744, y = 192, w = 200, h = 64 },
            Node{ id = "verify", label = "verify", x = 744, y = 440, w = 200, h = 64 },
            Node{ id = "integrate", label = "integrate", x = 280, y = 440, w = 200, h = 64 },
            Node{ id = "plan", label = "plan", x = 32, y = 232, w = 224, h = 64 },
            Node{ id = "human", label = "human", role = "external", x = 32, y = 344, w = 224, h = 64 },
            Node{ id = "doctrine", label = "doctrine", role = "focal", x = 376, y = 272, w = 280, h = 72 },
        ],
        edges = [
            Edge{ src = "cp", dst = "part" },
            Edge{ src = "part", dst = "decl" },
            Edge{ src = "decl", dst = "work", srcSide = "bottom", srcSlot = 1, srcSlots = 2, dstSide = "top", bend = 168 },
            Edge{ src = "work", dst = "verify", label = "reports done" },
            Edge{ src = "verify", dst = "integrate" },
            Edge{ src = "integrate", dst = "cp", srcSide = "left", dstSide = "left", bend = 16 },
            Edge{ src = "work", dst = "decl", label = "release", kind = "accent", srcSide = "left", dstSide = "right", bend = 736 },
            Edge{ src = "decl", dst = "plan", label = "job rows", srcSide = "bottom", srcSlot = 2, srcSlots = 2, dstSide = "top", bend = 196 },
            Edge{ src = "human", dst = "plan", label = "watches", srcSide = "top", dstSide = "bottom" },
        ],
        legend = [ LegendItem{ role = "focal", label = "the whole guarantee" } ],
    };
}

test "an edge label on a bent route clears every box" {
    final d = leaseLoopGeometry();
    assert\equal(validate(d).len(), want: 0, message: "the lease-loop geometry is sound");
    foreach (e in d.edges) {
        if (e.label != "") {
            final at = labelPlacement(d, e);
            final mask = [at[0] - at[2] / 2, at[1] - 8, at[2], 12];
            foreach (n in d.nodes) {
                std\assert(boxesOverlap(mask, n: n) == false, message: "{e.label} mask {mask} overlaps {n.id}");
            }
        }
    }
    final release = labelPlacement(d, e: d.edges[6]);
    assert\equal(release[0] - release[2] / 2, want: 736 + LabelGap, message: "release sits beside its vertical run, a 10px gap off it");
}

test "a horizontal leg long enough for the label carries it above the stroke" {
    final base = twoBox();
    final d = Diagram{ id = base.id, width = base.width, height = base.height, nodes = base.nodes,
        edges = [ Edge{ src = "a", dst = "b", label = "calls" } ] };
    assert\equal(labelPlacement(d, e: d.edges[0]), want: [240, 126, 36], message: "centred on the leg, mask bottom 10px above y=140");
}

test "the legend strip carries its word and keeps nodes out" {
    final base = twoBox();
    final d = Diagram{ id = base.id, width = base.width, height = base.height, nodes = base.nodes,
        edges = base.edges, legend = [ LegendItem{ role = "focal", label = "focal" } ] };
    final svg = renderSvg(d, p: lightPalette()) catch "threw";
    std\assert(svg.indexOf(">LEGEND</text>") != null, message: "the strip is labelled");
    final low = Diagram{ id = base.id, width = base.width, height = base.height, legend = d.legend,
        nodes = [ Node{ id = "a", label = "A", x = 32, y = 176, w = 160, h = 56 } ] };
    final errs = validate(low);
    assert\equal(errs.len(), want: 1, message: "a box reaching y=232 sits in the strip below y=180");
    std\assert(errs[0].indexOf("legend strip") != null, message: "named: {errs[0]}");
}

test "input and security paint the skill's treatments" {
    final d = Diagram{
        id = "t", width = 640, height = 320,
        nodes = [
            Node{ id = "trust", label = "trusted", role = "security", x = 16, y = 32, w = 400, h = 160 },
            Node{ id = "a", label = "A", role = "input", x = 32, y = 64, w = 160, h = 56 },
            Node{ id = "b", label = "B", x = 448, y = 64, w = 160, h = 56 },
        ],
        edges = [ Edge{ src = "a", dst = "b" } ],
    };
    assert\equal(validate(d).len(), want: 0, message: "a node wholly inside a boundary is not an overlap");
    final svg = renderSvg(d, p: lightPalette()) catch "threw";
    std\assert(svg.indexOf("fill=\"#4f5d75\" fill-opacity=\"0.1\" stroke=\"#7a8399\"") != null, message: "input is muted at 10%");
    std\assert(svg.indexOf("stroke-opacity=\"0.5\" stroke-width=\"1.2\" stroke-dasharray=\"4,4\"") != null, message: "security is dashed accent at half");
    std\assert(svg.indexOf(">TRUSTED</text>") != null, message: "the boundary label is painted");
    std\assert((svg.indexOf("data-node=\"trust\"") ?? 0) < (svg.indexOf("data-edge=") ?? 0), message: "the boundary paints under the connector");
    final straddle = Diagram{ id = "t", width = 640, height = 320,
        nodes = [ d.nodes[0], Node{ id = "b", label = "B", x = 320, y = 64, w = 160, h = 56 } ] };
    assert\equal(validate(straddle).len(), want: 1, message: "a box straddling the boundary still overlaps it");
}

test "a boundary zone paints the security treatment and a plain zone does not" {
    final base = twoBox();
    final z = Zone{ label = "trusted", x = 16, y = 80, w = 448, h = 120, boundary = true };
    final d = Diagram{ id = base.id, width = base.width, height = base.height, nodes = base.nodes, edges = base.edges, zones = [z] };
    assert\equal(validate(d).len(), want: 0, message: "a boundary is a zone, so boxes inside it are no overlap");
    final svg = renderSvg(d, p: lightPalette()) catch "threw";
    std\assert(svg.indexOf("stroke-opacity=\"0.5\" stroke-width=\"1.2\" stroke-dasharray=\"4,4\"") != null, message: "dashed accent at half");
    std\assert(svg.indexOf(">TRUSTED</text>") != null and svg.indexOf("y=\"74\"") != null, message: "the label masked on the top border");
    std\assert(svg.indexOf("fill-opacity=\"0.02\"") == null, message: "not the plain band's wash");
}

test "a node link paints an <a> whatever anchorHref says" {
    final base = twoBox();
    final d = Diagram{ id = base.id, width = base.width, height = base.height, edges = base.edges,
        nodes = [ Node{ id = "a", label = "A", link = "https://stripe.com/docs", x = 32, y = 112 }, base.nodes[1] ] };
    final svg = renderSvg(d, p: lightPalette()) catch "threw";
    std\assert(svg.indexOf("<a href=\"https://stripe.com/docs\" data-node=\"a\"><g>") != null, message: "linked: {svg}");
    std\assert(svg.indexOf("<g data-node=\"b\">") != null, message: "the other node is a plain group");
}

test "faults carry the rule and subjects validate's message leaves in prose" {
    final bad = Diagram{
        id = "t", width = 640, height = 400,
        nodes = [
            Node{ id = "a", label = "A", x = 32, y = 160, w = 160, h = 64 },
            Node{ id = "b", label = "B", x = 400, y = 256, w = 160, h = 64 },
            Node{ id = "c", label = "C", x = 400, y = 336, w = 160, h = 64 },
        ],
        edges = [
            Edge{ src = "a", dst = "b", srcSide = "right", srcSlot = 1, srcSlots = 2, dstSide = "left", bend = 296 },
            Edge{ src = "a", dst = "c", srcSide = "right", srcSlot = 2, srcSlots = 2, dstSide = "left", bend = 296 },
        ],
    };
    final got = faults(bad);
    assert\equal(got.len(), want: 1, message: "one fault");
    assert\equal(got[0].rule, want: "sameLine", message: "the rule");
    assert\equal(got[0].subjects, want: ["a", "b", "a", "c"], message: "both edges' ends");
    assert\equal(validate(bad)[0], want: "connectors a->b and a->c run along the same line; offset one of their bends",
        message: "the message joins text and fix");
}

test "a decision takes at most three exits" {
    final nodes = [
        Node{ id = "q", label = "?", role = "decision", x = 256, y = 128, w = 96, h = 96 },
        Node{ id = "n", label = "N", x = 224, y = 16, w = 160, h = 56 },
        Node{ id = "e", label = "E", x = 448, y = 148, w = 160, h = 56 },
        Node{ id = "s", label = "S", x = 224, y = 280, w = 160, h = 56 },
        Node{ id = "w", label = "W", x = 32, y = 148, w = 160, h = 56 },
    ];
    final three = [
        Edge{ src = "q", dst = "n", srcSide = "top", dstSide = "bottom" },
        Edge{ src = "q", dst = "e", srcSide = "right", dstSide = "left" },
        Edge{ src = "q", dst = "s", srcSide = "bottom", dstSide = "top" },
    ];
    assert\equal(validate(Diagram{ id = "t", width = 640, height = 360, nodes = nodes, edges = three }).len(), want: 0, message: "three exits");
    final four = Diagram{ id = "t", width = 640, height = 360, nodes = nodes,
        edges = [ three[0], three[1], three[2], Edge{ src = "q", dst = "w", srcSide = "left", dstSide = "right" } ] };
    final errs = validate(four);
    assert\equal(errs.len(), want: 1, message: "a fourth exit is a finding");
    std\assert(errs[0].indexOf("4 exits") != null, message: "named: {errs[0]}");
}

test "zones paint a solid hairline wash and stop at three" {
    final base = twoBox();
    final z = Zone{ label = "core", x = 16, y = 80, w = 448, h = 120 };
    final d = Diagram{ id = base.id, width = base.width, height = base.height, nodes = base.nodes, edges = base.edges, zones = [z] };
    final svg = renderSvg(d, p: lightPalette()) catch "threw";
    std\assert(svg.indexOf("fill=\"#2d3142\" fill-opacity=\"0.02\" stroke=\"#2d3142\" stroke-opacity=\"0.1\" stroke-width=\"0.8\"/>") != null,
        message: "ink wash, ink hairline, no dash");
    std\assert(svg.indexOf("x=\"240\" y=\"93\" fill=\"#2d3142\" fill-opacity=\"0.4\" font-size=\"7\"") != null, message: "label centred, 7px");
    final four = Diagram{ id = base.id, width = base.width, height = base.height, nodes = base.nodes, zones = [z, z, z, z] };
    assert\equal(validate(four).len(), want: 1, message: "a fourth zone is a finding");
}

test "a bend too tight for the floor is a finding, not a sharper corner" {
    final base = twoBox();
    final nodes = [ base.nodes[0], Node{ id = "b", label = "B", x = 288, y = 176, w = 160, h = 56 } ];
    final tight = Diagram{ id = base.id, width = base.width, height = base.height, nodes = nodes,
        edges = [ Edge{ src = "a", dst = "b", srcSide = "right", dstSide = "left", bend = 196 } ] };
    final errs = validate(tight);
    assert\equal(errs.len(), want: 1, message: "a 4px leg cannot seat a 6px bend");
    std\assert(errs[0].indexOf("leaves 4px") != null, message: "named: {errs[0]}");
    final roomy = Diagram{ id = base.id, width = base.width, height = base.height, nodes = nodes,
        edges = [ Edge{ src = "a", dst = "b", srcSide = "right", dstSide = "left" } ] };
    final svg = renderSvg(roomy, p: lightPalette(), s: Style{ bendRadius = 2 }) catch "threw";
    std\assert(svg.indexOf("L 234 140 Q 240 140 240 146") != null, message: "a radius under the floor is raised to 6");
}

test "anchorHref links an anchored node and leaves the rest alone" {
    final base = twoBox();
    final d = Diagram{ id = base.id, width = base.width, height = base.height, edges = base.edges,
        nodes = [ Node{ id = "a", label = "A", anchor = "internal/job", x = 32, y = 112 }, base.nodes[1] ] };
    final linked = renderSvg(d, p: lightPalette(), s: Style{ anchorHref = "/code/\{path\}" }) catch "threw";
    std\assert(linked.indexOf("<a href=\"/code/internal/job\" data-node=\"a\" data-anchor=\"internal/job\"><g>") != null,
        message: "the anchored node is wrapped in a link");
    std\assert(linked.indexOf("<g data-node=\"b\">") != null, message: "the unanchored node is a plain group");
    final plain = renderSvg(d, p: lightPalette()) catch "threw";
    std\assert(plain.indexOf("<a ") == null, message: "no template, no link");
    std\assert(plain.indexOf("<g data-node=\"a\" data-anchor=\"internal/job\">") != null, message: "the anchor still reaches the group");
}

// inlineDiagrams swaps a diagram reference in rendered HTML for the SVG itself, keyed by
// diagram id. Inlining is what makes a diagram follow the site's manual theme toggle: an
// <img>-loaded SVG is a separate document and can only ever see prefers-color-scheme.
//
// Two reference forms are recognized, because the two audiences need different markup.
// A docs page carries `<!--diagram:id-->`, which GitHub renders as nothing and goldmark
// passes through untouched. The README carries a real <picture> so GitHub shows the
// committed pair, and the docs home page (which is the README) still gets the inline copy.
fun inlineDiagrams(html: str, svgById: {str: str}) > str {
    var page = html;
    foreach (id in svgById.keys()) {
        final svg = svgById[id] ?? "";
        final figure = "<figure class=\"magus-diagram-figure\">" + svg + "</figure>";
        page = page.split("<!--diagram:" + id + "-->").join(figure);
        page = replacePicture(page, needle: "diagram-" + id + ".svg", replacement: figure);
    }
    return page;
}

// replacePicture rewrites each <picture> element whose markup mentions needle. Scanning for
// the element bounds beats a regex here: the srcset and img inside carry attributes in no
// fixed order, and a <picture> that does not mention the needle has to survive untouched.
fun replacePicture(html: str, needle: str, replacement: str) > str {
    final done = mut [<str>];
    var page = html;
    var guard = 0;
    while (guard < 64) {
        final start = page.indexOf("<picture");
        if (start == null) { break; }
        final rest = page.sub(start!);
        final close = rest.indexOf("</picture>");
        if (close == null) { break; }
        final element = rest.sub(0, len: close! + 10);
        if (element.indexOf(needle) != null) {
            done.append(page.sub(0, len: start!));
            done.append(replacement);
            page = rest.sub(close! + 10);
            break;
        }
        // Carry this one through and keep scanning. Returning on the first miss skips
        // every diagram that follows an unrelated <picture>, and the README opens with
        // one: the hero terminal recording.
        done.append(page.sub(0, len: start!));
        done.append(element);
        page = rest.sub(close! + 10);
        guard = guard + 1;
    }
    done.append(page);
    return done.join("");
}

test "a comment marker is replaced by the svg" {
    final page = inlineDiagrams("<p>before</p>\n<!--diagram:x-->\n<p>after</p>", svgById: {"x": "<svg/>"});
    std\assert(page.indexOf("<svg/>") != null, message: "the svg landed");
    std\assert(page.indexOf("<!--diagram:x-->") == null, message: "the marker is gone");
    std\assert(page.indexOf("<p>after</p>") != null, message: "surrounding content survives");
}

test "a picture element referencing the diagram is replaced whole" {
    final markup = "<p>a</p><picture><source srcset=\"assets/gen/diagram-x-light.svg\">"
        + "<img src=\"assets/gen/diagram-x.svg\" alt=\"x\"></picture><p>b</p>";
    final page = inlineDiagrams(markup, svgById: {"x": "<svg/>"});
    std\assert(page.indexOf("<picture") == null, message: "the whole element is replaced");
    std\assert(page.indexOf("<img") == null, message: "the fallback img goes with it");
    std\assert(page.indexOf("<svg/>") != null, message: "the svg landed");
    std\assert(page.indexOf("<p>b</p>") != null, message: "surrounding content survives");
}

test "an unrelated picture is left alone" {
    final markup = "<picture><img src=\"assets/gen/core-loop.svg\" alt=\"a recording\"></picture>";
    assert\equal(inlineDiagrams(markup, svgById: {"x": "<svg/>"}), want: markup, message: "a terminal recording is not a diagram");
}

test "a diagram picture is found after an unrelated one" {
    final markup = "<picture><img src=\"assets/gen/core-loop.svg\" alt=\"a recording\"></picture>"
        + "<p>mid</p><picture><img src=\"docs/assets/gen/diagram-x.svg\" alt=\"x\"></picture>";
    final page = inlineDiagrams(markup, svgById: {"x": "<svg/>"});
    std\assert(page.indexOf("core-loop.svg") != null, message: "the recording survives");
    std\assert(page.indexOf("diagram-x.svg") == null, message: "the diagram is replaced");
    std\assert(page.indexOf("<p>mid</p>") != null, message: "content between them survives");
}

test "an explicit bend beats the shared-axis shortcut" {
    // Both ends on y=224, detouring via y=288: a straight line here would run back through
    // the boxes it connects.
    final path = connectorPath(772, y1: 224, x2: 180, y2: 224, horizontal: false, bend: 288, radius: defaultStyle().bendRadius);
    std\assert(path.indexOf("288") != null, message: "the route reaches the declared bend");
    std\assert(path != "M 772 224 L 180 224", message: "not the straight shortcut");
}

test "a shared axis with no bend still routes straight" {
    assert\equal(connectorPath(0, y1: 40, x2: 200, y2: 40, horizontal: true, bend: 0, radius: defaultStyle().bendRadius), want: "M 0 40 L 200 40", message: "unchanged");
}

test "a via route rounds every corner" {
    assert\equal(routePath([0, 0, 40, 0, 40, 80, 120, 80, 120, 120], radius: 8),
        want: "M 0 0 L 32 0 Q 40 0 40 8 L 40 72 Q 40 80 48 80 L 112 80 Q 120 80 120 88 L 120 120",
        message: "three corners, three quarter-rounds");
}

// The via legs feed the same overlap check a single-bend route does, and a diagonal leg
// is a finding rather than something the painter quietly draws.
test "a via route is validated leg by leg" {
    final base = twoBox();
    final routed = Diagram{
        id = base.id, width = base.width, height = base.height, nodes = base.nodes,
        edges = [
            Edge{ src = "a", dst = "b", srcSide = "right", dstSide = "left", via = [240, 140] },
            Edge{ src = "a", dst = "b", srcSide = "bottom", dstSide = "bottom",
                  via = [112, 200, 368, 200] },
        ],
    };
    assert\equal(validate(routed).len(), want: 0, message: "a straight via and a return leg are sound");
    final diagonal = Diagram{
        id = base.id, width = base.width, height = base.height, nodes = base.nodes,
        edges = [ Edge{ src = "a", dst = "b", srcSide = "bottom", dstSide = "left", via = [112, 200, 240, 200] } ],
    };
    assert\equal(validate(diagonal).len(), want: 1, message: "the leg into b's left side runs diagonally");
}

// cross is a plus: a->b runs across y=140, c->d down x=240, crossing at 240,140.
fun cross(across: Edge, down: Edge) > Diagram {
    return Diagram{
        id = "t", width = 480, height = 320,
        nodes = [
            Node{ id = "a", label = "A", x = 32, y = 112, w = 112, h = 56 },
            Node{ id = "b", label = "B", x = 336, y = 112, w = 112, h = 56 },
            Node{ id = "c", label = "C", x = 184, y = 16, w = 112, h = 56 },
            Node{ id = "d", label = "D", x = 184, y = 232, w = 112, h = 56 },
        ],
        edges = [across, down],
    };
}

test "every proper crossing hops the dashed or lesser edge" {
    final plain = Edge{ src = "a", dst = "b" };
    final down = Edge{ src = "c", dst = "d", srcSide = "bottom", dstSide = "top" };
    final tie = crossings(cross(plain, down: down));
    assert\equal(tie.len(), want: 1, message: "one crossing");
    assert\equal([tie[0].bridged, tie[0].kept, tie[0].x, tie[0].y], want: [1, 0, 240, 140], message: "of equals the later-declared hops");
    final dashed = crossings(cross(Edge{ src = "a", dst = "b", dashed = true }, down: down));
    assert\equal(dashed[0].bridged, want: 0, message: "a dashed edge hops whatever its order");
    final accent = crossings(cross(plain, down: Edge{ src = "c", dst = "d", srcSide = "bottom", dstSide = "top", kind = "accent" }));
    assert\equal(accent[0].bridged, want: 0, message: "a plain edge hops the accent");
    final svg = renderSvg(cross(plain, down: down), p: lightPalette()) catch "threw";
    std\assert(svg.indexOf("d=\"M 240 72 L 240 132 A 8 8 0 0 0 240 148 L 240 232\"") != null, message: "a downward hop bulges left: {svg}");
    std\assert(svg.indexOf("d=\"M 144 140 L 336 140\"") != null, message: "the kept edge runs unbroken");
    assert\equal(routePath([0, 0, 100, 0], radius: 8, hops: [[40, 0]]), want: "M 0 0 L 32 0 A 8 8 0 0 1 48 0 L 100 0", message: "a rightward hop bulges up");
}

test "a crossing too near a bend to seat its hop is a finding, never a refusal of the crossing" {
    final tight = Diagram{
        id = "t", width = 480, height = 320,
        nodes = [
            Node{ id = "a", label = "A", x = 32, y = 112, w = 112, h = 56 },
            Node{ id = "b", label = "B", x = 336, y = 16, w = 112, h = 56 },
            Node{ id = "c", label = "C", x = 184, y = 16, w = 112, h = 56 },
            Node{ id = "d", label = "D", x = 184, y = 232, w = 112, h = 56 },
        ],
        edges = [
            Edge{ src = "c", dst = "d", srcSide = "bottom", dstSide = "top" },
            Edge{ src = "a", dst = "b", srcSide = "right", dstSide = "left", via = [248, 140, 248, 44] },
        ],
    };
    final errs = faults(tight);
    assert\equal(errs.len(), want: 1, message: "one fault: {validate(tight)}");
    assert\equal(errs[0].rule, want: "bridge", message: "the hop has 8px before the corner at 248,140");
    final generated = Diagram{ id = tight.id, width = tight.width, height = tight.height, nodes = tight.nodes, edges = tight.edges, generated = true };
    assert\equal(validate(generated).len(), want: 0, message: "a generated figure draws that crossing plain");
}

test "a label with no spot 6px clear of every stroke and box is a finding naming its edge" {
    final nodes = [ Node{ id = "a", label = "A", x = 32, y = 112, w = 160, h = 56 }, Node{ id = "b", label = "B", x = 264, y = 112, w = 160, h = 56 } ];
    final d = Diagram{ id = "t", width = 480, height = 240, nodes = nodes, edges = [ Edge{ src = "a", dst = "b", label = "abcdefghijklmn" } ] };
    final errs = faults(d);
    assert\equal(errs.len(), want: 1, message: "one fault: {validate(d)}");
    assert\equal([errs[0].rule, errs[0].subjects[0], errs[0].subjects[1]], want: ["label", "a", "b"], message: "an 80px mask on a 72px leg");
    assert\equal(labelPlacement(d, e: d.edges[0]).len(), want: 0, message: "no spot");
}

test "every edge path carries a stable id a fragment can target" {
    final base = twoBox();
    final d = Diagram{ id = "my fig", width = base.width, height = base.height, nodes = [
            Node{ id = "a/b", label = "A", x = 32, y = 112, w = 160, h = 56 },
            Node{ id = "c", label = "C", x = 288, y = 112, w = 160, h = 56 },
        ],
        edges = [ Edge{ src = "a/b", dst = "c" }, Edge{ src = "a/b", dst = "c", srcSide = "bottom", dstSide = "bottom", via = [112, 200, 368, 200] } ] };
    assert\equal(edgeIds(d), want: ["my_20fig-edge-a_2fb-c", "my_20fig-edge-a_2fb-c-2"], message: "escaped, and the repeat numbered");
    final svg = renderSvg(d, p: lightPalette()) catch "threw";
    std\assert(svg.indexOf("data-edge=\"a/b->c\" id=\"my_20fig-edge-a_2fb-c\"") != null, message: "beside data-edge: {svg}");
}

// LayeredItem is one node handed to layered(): an id, its display label, and the ids it
// depends on. Edges are declared by the dependent, matching how a dependency graph is
// usually held.
object LayeredItem {
    id: str = "",
    label: str = "",
    deps: [str] = [<str>],
}

// Layout constants for the generated form. Wider columns than an authored figure uses,
// because a generated label is a project or target name nobody shortened for the picture.
// flow()'s placement shares them, so the two automatic placements share one geometry.
final LayerNodeW = 216;
final LayerNodeH = 56;
final LayerColGap = 72;
final LayerRowGap = 24;
final LayerTop = 64;

// LayerMaxChars is what fits across a generated node at the 12px body size. A project
// path longer than that is truncated from the FRONT: the tail (the project's own name) is
// what distinguishes it, and "docs/guides/integrations/agents" overflows its box.
final LayerMaxChars = 32;

fun fitLabel(label: str) > str {
    if (label.len() <= LayerMaxChars) { return label; }
    return "..." + label.sub(label.len() - LayerMaxChars + 3);
}

// layered turns a dependency DAG into a Diagram: rank by longest path from the roots, one
// column per rank, and the ranks left to right so every edge points forward.
//
// It is deliberately the dumbest placement that works: no crossing minimization, no
// barycentre passes. flow() is the one that has them, for authored figures. It exists because the
// workspace's own dependency graph has no author to place it, and it stays honest by
// staying small - callers cap the node count and fall back to the table above the figure.

// LayerStaggers are the per-column offsets layered() tries, in order. A single fixed value
// cannot guarantee anything: an attach point is `node.y + h * k/(n+1)`, so two nodes at
// different y can still land on the same one once slot counts differ, and their stubs then
// run along each other. Rather than pretend a formula settles it, lay the graph out and
// ASK the validator, shifting the columns until it stops complaining.
//
// Bounded and deterministic: same input, same answer. If nothing is clean the last attempt
// is returned and the caller drops the figure (see dependencyFigure) rather than drawing
// connectors nobody can trace.
// Ascending, and the first clean one wins, so a graph pays only the offset it needs and the
// common case still settles at 4. The list runs to one full row pitch (80): past that a
// column has dropped a whole row and the staircase reads worse than the table the caller
// falls back to. Six values used to be the whole search, and the docs run-order figure
// needed more than that - it went unrendered for months while the graph had ample room
// (its busiest column gap wants 10 channels of the 18 a gap provides).
final LayerStaggers = [4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44, 48, 52, 56, 60, 64, 68, 72, 76, 80];

fun layered(id: str, title: str, desc: str, items: [LayeredItem]) > Diagram {
    var best = layoutWithStagger(id, title, desc, items, stagger: LayerStaggers[0]);
    foreach (stagger in LayerStaggers) {
        final attempt = layoutWithStagger(id, title, desc, items, stagger);
        if (validate(attempt).len() == 0) { return attempt; }
        best = attempt;
    }
    return best;
}

fun layoutWithStagger(id: str, title: str, desc: str, items: [LayeredItem], stagger: int) > Diagram {
    final rank: mut {str: int} = mut {<str: int>};
    foreach (it in items) { rank[it.id] = 0; }

    // Longest-path ranking. Iterating once per node is enough for a DAG: each pass pushes
    // every node at least one rank past its dependencies, so after n passes the deepest
    // chain has settled. A cycle simply stops moving, which keeps this total.
    var pass = 0;
    while (pass < items.len()) {
        foreach (it in items) {
            foreach (dep in it.deps) {
                final dr = rank[dep];
                if (dr != null and dr! + 1 > (rank[it.id] ?? 0)) {
                    rank[it.id] = dr! + 1;
                }
            }
        }
        pass = pass + 1;
    }

    var maxRank = 0;
    foreach (it in items) {
        if ((rank[it.id] ?? 0) > maxRank) { maxRank = rank[it.id] ?? 0; }
    }

    // Place each node at its rank's column, stacking in declaration order so the same
    // graph always renders the same bytes.
    final rowOf: mut {str: int} = mut {<str: int>};
    final used: mut {int: int} = mut {<int: int>};
    var maxRows = 0;
    foreach (it in items) {
        final r = rank[it.id] ?? 0;
        final row = used[r] ?? 0;
        rowOf[it.id] = row;
        used[r] = row + 1;
        if (row + 1 > maxRows) { maxRows = row + 1; }
    }

    final nodes: mut [Node] = mut [<Node>];
    foreach (it in items) {
        final r = rank[it.id] ?? 0;
        final row = rowOf[it.id] ?? 0;
        nodes.append(Node{
            id = it.id,
            label = fitLabel(it.label),
            x = 32 + r * (LayerNodeW + LayerColGap),
            // Each column sits `stagger` px lower than the last. Without a per-column
            // offset, ranks share row positions, so one edge's arrival y equals another's
            // departure y and their horizontal stubs run along the same line.
            y = LayerTop + row * (LayerNodeH + LayerRowGap) + r * stagger,
            w = LayerNodeW,
            h = LayerNodeH,
        });
    }

    // Fan the attach points: count each node's outgoing and incoming edges first, then
    // hand out slots in order, so two edges never land on one point.
    final outOf: mut {str: int} = mut {<str: int>};
    final inOf: mut {str: int} = mut {<str: int>};
    // Bound to locals first: `??` binds looser than `+`, so `m[k] ?? 0 + 1` reads as
    // `m[k] ?? 1` and the counter sticks at one, which fans nothing.
    foreach (it in items) {
        foreach (dep in it.deps) {
            final o = outOf[dep] ?? 0;
            outOf[dep] = o + 1;
            final i = inOf[it.id] ?? 0;
            inOf[it.id] = i + 1;
        }
    }
    // Vertical channels are allocated per COLUMN GAP, not per source node. Staggering
    // within one node's own outgoing edges leaves two nodes in the same column handing out
    // the same channel x, and their verticals then run along each other.
    final gapTotal: mut {int: int} = mut {<int: int>};
    foreach (it in items) {
        foreach (dep in it.deps) {
            final r = rank[dep] ?? 0;
            final n = gapTotal[r] ?? 0;
            gapTotal[r] = n + 1;
        }
    }

    final outSeen: mut {str: int} = mut {<str: int>};
    final inSeen: mut {str: int} = mut {<str: int>};
    final gapSeen: mut {int: int} = mut {<int: int>};
    final edges: mut [Edge] = mut [<Edge>];
    foreach (it in items) {
        foreach (dep in it.deps) {
            final osPrev = outSeen[dep] ?? 0;
            final inPrev = inSeen[it.id] ?? 0;
            final os = osPrev + 1;
            final ins = inPrev + 1;
            outSeen[dep] = os;
            inSeen[it.id] = ins;

            final depRank = rank[dep] ?? 0;
            final chPrev = gapSeen[depRank] ?? 0;
            final ch = chPrev + 1;
            gapSeen[depRank] = ch;
            final total = gapTotal[depRank] ?? 1;
            final srcRight = 32 + depRank * (LayerNodeW + LayerColGap) + LayerNodeW;
            edges.append(Edge{
                src = dep, dst = it.id,
                srcSide = "right", dstSide = "left",
                srcSlot = os, srcSlots = outOf[dep] ?? 1,
                dstSlot = ins, dstSlots = inOf[it.id] ?? 1,
                bend = srcRight + snap(LayerColGap * ch / (total + 1)),
            });
        }
    }

    return Diagram{
        id = id,
        generated = true,
        title = title,
        desc = desc,
        width = 64 + (maxRank + 1) * LayerNodeW + maxRank * LayerColGap,
        // maxRank * stagger, because a node's y carries r * stagger: the last column sits
        // that much lower than the first, and a canvas sized from rows alone clips it.
        height = LayerTop + maxRows * (LayerNodeH + LayerRowGap) + maxRank * stagger + 32,
        nodes = nodes,
        edges = edges,
    };
}

test "layered ranks a chain into one column per step" {
    final d = layered("t", title: "chain", desc: "a to c", items: [
        LayeredItem{ id = "a", label = "A" },
        LayeredItem{ id = "b", label = "B", deps = ["a"] },
        LayeredItem{ id = "c", label = "C", deps = ["b"] },
    ]);
    assert\equal(validate(d).len(), want: 0, message: "a generated layout is structurally sound");
    assert\equal(d.nodes.len(), want: 3, message: "every item placed");
    assert\equal(d.edges.len(), want: 2, message: "every dependency drawn");
    // Three ranks, so three distinct columns, left to right.
    std\assert(d.nodes[0].x < d.nodes[1].x, message: "b sits right of a");
    std\assert(d.nodes[1].x < d.nodes[2].x, message: "c sits right of b");
}

test "layered stacks independent roots in one column" {
    final d = layered("t", title: "fan", desc: "two roots into one sink", items: [
        LayeredItem{ id = "a", label = "A" },
        LayeredItem{ id = "b", label = "B" },
        LayeredItem{ id = "sink", label = "Sink", deps = ["a", "b"] },
    ]);
    assert\equal(validate(d).len(), want: 0, message: "no overlap, no shared attach point");
    assert\equal(d.nodes[0].x, want: d.nodes[1].x, message: "both roots share rank 0");
    std\assert(d.nodes[0].y != d.nodes[1].y, message: "and are stacked, not overlapping");
}

test "layered exceeds the authored budgets without complaint" {
    final items: mut [LayeredItem] = mut [<LayeredItem>];
    var i = 0;
    while (i < 14) {
        items.append(LayeredItem{ id = "n{i}", label = "N{i}" });
        i = i + 1;
    }
    final d = layered("t", title: "wide", desc: "more nodes than a human should draw", items: items);
    assert\equal(validate(d).len(), want: 0, message: "budgets are for hand-authored figures only");
}

// The regression this pins: distinct attach slots are NOT enough. Two connectors can leave
// one box at different points and still turn onto the same crossing line, which is what put
// overlapping vertical runs in the generated run-order figures.
test "two connectors sharing a crossing line are a finding" {
    final bad = Diagram{
        id = "t", width = 640, height = 400,
        nodes = [
            Node{ id = "a", label = "A", x = 32, y = 160, w = 160, h = 64 },
            Node{ id = "b", label = "B", x = 400, y = 256, w = 160, h = 64 },
            Node{ id = "c", label = "C", x = 400, y = 336, w = 160, h = 64 },
        ],
        edges = [
            Edge{ src = "a", dst = "b", srcSide = "right", srcSlot = 1, srcSlots = 2,
                  dstSide = "left", bend = 296 },
            Edge{ src = "a", dst = "c", srcSide = "right", srcSlot = 2, srcSlots = 2,
                  dstSide = "left", bend = 296 },
        ],
    };
    std\assert(validate(bad).len() > 0, message: "both verticals run down x=296");
}

test "offsetting one bend clears the overlap" {
    final good = Diagram{
        id = "t", width = 640, height = 400,
        nodes = [
            Node{ id = "a", label = "A", x = 32, y = 160, w = 160, h = 64 },
            Node{ id = "b", label = "B", x = 400, y = 256, w = 160, h = 64 },
            Node{ id = "c", label = "C", x = 400, y = 336, w = 160, h = 64 },
        ],
        edges = [
            Edge{ src = "a", dst = "b", srcSide = "right", srcSlot = 1, srcSlots = 2,
                  dstSide = "left", bend = 280 },
            Edge{ src = "a", dst = "c", srcSide = "right", srcSlot = 2, srcSlots = 2,
                  dstSide = "left", bend = 320 },
        ],
    };
    assert\equal(validate(good).len(), want: 0, message: "distinct crossing lines are traceable");
}

// The generated path has to satisfy the same rule, and it is where the defect actually
// shipped: a fan-out is the shape every run-order figure ends in.
test "layered fans siblings onto distinct crossing lines" {
    final d = layered("t", title: "fan out", desc: "one root, three children", items: [
        LayeredItem{ id = "root", label = "Root" },
        LayeredItem{ id = "x", label = "X", deps = ["root"] },
        LayeredItem{ id = "y", label = "Y", deps = ["root"] },
        LayeredItem{ id = "z", label = "Z", deps = ["root"] },
    ]);
    assert\equal(validate(d).len(), want: 0, message: "no two generated connectors share a line");
}


// validate refuses a tag, a name and a sublabel stacked in less than this.
final TallNodeH = 64;
final Margin = 32;
// A zone band reserves room for its label on the side the label is painted, and a narrower
// pad everywhere else.
final ZoneLabelPad = 32;
final ZonePad = 16;
// The legend strip needs this much below the content; renderLegend draws 32px off the bottom.
final LegendRoom = 96;
// A 20px title runs about 11px per character; the frame widens to fit it.
final TitleCharW = 11;
// The connector rule's spacing: slots on a side, channels in a gap, back-edge lanes and a
// long edge's lane beside a box all sit on a lattice this fine, so every leg seats the
// renderer's 6px bend floor.
final Pitch = 12;
// How far a channel or a lane keeps from any box face it runs beside, so the stub into it
// still turns on a full radius.
final FaceClear = 16;
// An authored box grows to seat a fan up to this many times its base cross size; past it
// the fan is a finding, never a denser pack.
final MaxFanGrowth = 2;
// A crowded label widens its gaps a grid step pair at a time, at most MaxWiden times, so a
// gap grows only as far as its label needs.
final MaxWiden = 16;
final WidenStep = 8;
final Far = 1000000000;
// A box's faces along the flow: out and in carry forward connectors; before and after lie
// across it and carry a decision's side exits and a back edge's way to its lane.
final FaceOut = 0;
final FaceIn = 1;
final FaceBefore = 2;
final FaceAfter = 3;

// Role picks a box's treatment. focal takes the accent (two per figure, counting focal
// edges); store is a persistent thing; external sits outside what the figure depicts; input
// is data arriving from outside; optional is dashed; decision is a diamond with at most
// three exits and no tag or sub. A trust boundary is a group, not a box: boundary().
enum<str> Role { default, focal, store, external, input, optional, decision }

// EdgeRole picks a connector's treatment: focal takes the accent, external the link colour
// of a call leaving the system, optional is dashed. A back edge draws dashed whatever its
// role, since it runs against the flow.
enum<str> EdgeRole { default, focal, external, optional }

// Claim is what a connector asserts about the code. flow is narrative and never checked;
// imports is checked against the import graph; calls is declared and counted until its
// source marker is settled.
enum<str> Claim { flow, imports, calls }

// ObservedNode is one box an observation supplies: a package, a target, whatever the
// caller extracted. An empty label shows the id.
object ObservedNode {
    id: str = "",
    label: str = "",
    anchor: str = "",
}

// ObservedEdge is one relationship an observation found; it is drawn with Claim.imports.
object ObservedEdge {
    src: str = "",
    dst: str = "",
}

// Observed is the generated half of a figure. stamp identifies the observation, so a later
// check can tell a figure drawn from a stale one.
object Observed {
    nodes: [ObservedNode] = [<ObservedNode>],
    edges: [ObservedEdge] = [<ObservedEdge>],
    stamp: str = "",
}

// FlowZone is one band. Members keep their ranks; the band only fixes which rows they
// occupy. A boundary band paints as a trust boundary.
object FlowZone {
    label: str = "",
    members: [str] = [<str>],
    boundary: bool = false,
}

object Hidden {
    src: str = "",
    dst: str = "",
    why: str = "",
}

// Flow is a figure under construction. Build one with flow(), chain the declarations, and
// finish with diagram() or svg(). Nothing here takes a coordinate or a weight: rank, row and
// order relate declared nodes, and a declaration the layout cannot honour is refused with a
// finding naming the flow call to change.
object Flow {
    id: str = "",
    titleText: str = "",
    eyebrowText: str = "",
    descText: str = "",
    topDown: bool = false,
    isGenerated: bool = false,
    isUnscoped: bool = false,
    unscopedWhy: str = "",
    nodes: mut [Node],
    edges: mut [Edge],
    zones: mut [FlowZone],
    legendItems: mut [LegendItem],
    scopeGlobs: mut [str],
    omitted: mut {str: str},
    omittedTwice: mut [str],
    // The observed half stays apart from the declared lists until layout, where the merge
    // rule needs to know which side supplied what.
    observedNodes: mut [ObservedNode],
    observedEdges: mut [ObservedEdge],
    stamp: str = "",
    hidden: mut [Hidden],
    // gopherbuzz's checker lets a str through where an enum is declared, and its value then
    // reads null; each such argument is recorded here and refused with the declarations.
    stringly: mut [str],
    // Only flow reads the constraints, so they stay here rather than on the Diagram.
    ranks: mut [[str]],
    rows: mut [[str]],
    orders: mut [[str]],

    mut fun title(t: str) > mut Flow {
        this.titleText = t;
        return this;
    }

    mut fun eyebrow(e: str) > mut Flow {
        this.eyebrowText = e;
        return this;
    }

    mut fun desc(d: str) > mut Flow {
        this.descText = d;
        return this;
    }

    // down lays ranks out top to bottom instead of left to right.
    mut fun down() > mut Flow {
        this.topDown = true;
        return this;
    }

    // generated marks a figure computed from data nobody authored, as layered() does: the
    // hand-authored node, edge, accent and zone budgets stop applying, every structural
    // check stays, and it needs no scope.
    mut fun generated() > mut Flow {
        this.isGenerated = true;
        return this;
    }

    // node declares a box. An empty label shows the observed label for the id, else the id.
    // A node sharing an observed node's id, or its anchor, overrides it. anchor is a path in
    // this repo the drift check holds the box to; link is a URL for anything outside it,
    // and a node takes one or the other. role defaults to Role.default.
    //
    // The enum parameters default to null rather than to a case: gopherbuzz resolves a
    // default in the caller's scope, where an importer that aliases this module has no
    // bare Role.
    mut fun node(id: str, label: str = "", sub: str = "", tag: str = "", role: Role? = null, anchor: str = "", link: str = "") > mut Flow {
        final r: str? = (role ?? Role.default).value;
        if (r == null) { this.stringly.append("node {quote(id)} takes role: Role.<case>"); }
        this.nodes.append(Node{ id = id, label = label, sub = sub, tag = tag, role = r ?? Role.default.value, anchor = anchor, link = link });
        return this;
    }

    // edge declares a connector, EdgeRole.default and Claim.flow unless named. One sharing an
    // observed edge's ends replaces it, and must then claim imports or be omitted with
    // omitEdge: a narrative edge over a real import would hide what the code does.
    mut fun edge(src: str, dst: str, label: str = "", role: EdgeRole? = null, claim: Claim? = null) > mut Flow {
        final r = role ?? EdgeRole.default;
        final roleName: str? = r.value;
        final c: str? = (claim ?? Claim.flow).value;
        if (roleName == null) { this.stringly.append("{edgeName(src, dst: dst)} takes role: EdgeRole.<case>"); }
        if (c == null) { this.stringly.append("{edgeName(src, dst: dst)} takes claim: Claim.<case>"); }
        var kind = "default";
        if (r == EdgeRole.focal) { kind = "accent"; }
        if (r == EdgeRole.external) { kind = "link"; }
        this.edges.append(Edge{ src = src, dst = dst, label = label, kind = kind, dashed = r == EdgeRole.optional, claim = c ?? Claim.flow.value });
        return this;
    }

    // zone stacks its members into one band, bands in declaration order, unzoned nodes
    // last unless one alone feeds a band, its neighbours all lie in two adjacent bands,
    // where it takes a row between them, or its rank lies outside every zone, where it
    // lines up with its neighbours across the figure. A node belongs to at most one zone or
    // boundary.
    mut fun zone(label: str, members: [str]) > mut Flow {
        this.zones.append(FlowZone{ label = label, members = members });
        return this;
    }

    // boundary is a zone painted as a trust boundary: dashed accent, its label on the
    // border. It counts against the same three-band budget.
    mut fun boundary(label: str, members: [str]) > mut Flow {
        this.zones.append(FlowZone{ label = label, members = members, boundary = true });
        return this;
    }

    mut fun legend(role: Role, label: str) > mut Flow {
        final r: str? = role.value;
        if (r == null) { this.stringly.append("legend {quote(label)} takes Role.<case>"); }
        this.legendItems.append(LegendItem{ role = r ?? Role.default.value, label = label });
        return this;
    }

    // scope names the directories the figure depicts, so the drift check can report a
    // package under them that no node anchors and no omit names.
    mut fun scope(globs: [str]) > mut Flow {
        foreach (g in globs) { this.scopeGlobs.append(g); }
        return this;
    }

    // unscoped says why a figure depicts no code: a decision process, a CI arrangement. The
    // reason reaches the drift summary.
    mut fun unscoped(why: str) > mut Flow {
        this.isUnscoped = true;
        this.unscopedWhy = why;
        return this;
    }

    // omit leaves a path under scope out on purpose, and drops any observed box anchored
    // there along with its connectors.
    mut fun omit(path: str, why: str) > mut Flow {
        if (this.omitted[path] != null) { this.omittedTwice.append(path); }
        this.omitted[path] = why;
        return this;
    }

    // omitEdge hides one observed edge. The reason is required, so the next reader of the
    // figure learns why the code's edge is missing from the picture.
    mut fun omitEdge(src: str, dst: str, why: str) > mut Flow {
        this.hidden.append(Hidden{ src = src, dst = dst, why = why });
        return this;
    }

    // rank puts its nodes in one rank; refused when a path between two of them orders them.
    mut fun rank(ids: [str]) > mut Flow {
        this.ranks.append(ids);
        return this;
    }

    // row lines its nodes up on one midline across ranks, so the connectors between them
    // run straight; refused for two nodes in one rank or in different bands.
    mut fun row(ids: [str]) > mut Flow {
        this.rows.append(ids);
        return this;
    }

    // order sorts nodes within their shared rank, first to last; refused across ranks,
    // against the zone order, or in a cycle with another order.
    mut fun order(ids: [str]) > mut Flow {
        this.orders.append(ids);
        return this;
    }

    // diagram lays the figure out and validates it. Throws one finding per line, each
    // naming the flow call to change, when the declaration contradicts itself or no layout
    // the search tries comes out clean. Same declarations, same Diagram.
    fun diagram() > Diagram !> str {
        return layoutFlow(this);
    }

    fun svg(p: Palette, s: Style = Style{}) > str !> str {
        final d = this.diagram();
        return renderSvg(d, p: p, s: s);
    }
}

// flow starts an empty left-to-right figure, composed over observed when a generator
// supplies one: its nodes and edges are drawn unless a declaration overrides them. The
// collections are built here because a mut collection field cannot carry a default.
fun flow(id: str, observed: Observed = Observed{}) > mut Flow {
    final f = mut Flow{
        id = id,
        nodes = mut [<Node>],
        edges = mut [<Edge>],
        zones = mut [<FlowZone>],
        legendItems = mut [<LegendItem>],
        scopeGlobs = mut [<str>],
        omitted = mut {<str: str>},
        omittedTwice = mut [<str>],
        observedNodes = mut [<ObservedNode>],
        observedEdges = mut [<ObservedEdge>],
        stamp = observed.stamp,
        hidden = mut [<Hidden>],
        stringly = mut [<str>],
        ranks = mut [<[str]>],
        rows = mut [<[str]>],
        orders = mut [<[str]>],
    };
    foreach (n in observed.nodes) { f.observedNodes.append(n); }
    foreach (e in observed.edges) { f.observedEdges.append(e); }
    return f;
}

// Plan is the placement that holds before any coordinate: ranks, bands, row order and
// each layout edge's chain of items. Items 0..nodes-1 are the declared nodes; the rest are
// one dummy per rank a long edge passes through.
object Plan {
    nodeCount: int = 0,
    bandCount: int = 0,
    maxRank: int = 0,
    rankOf: mut [int],
    // Bands 0..zones-1 are the zones, the next the unzoned rest, and after it one per gap
    // between neighbouring zones. stackOf is each band's place in the stack, top first.
    bandOf: mut [int],
    stackOf: mut [int],
    // Per declared node: a member of the band it sits in, so its zone box encloses it.
    inZone: mut [bool],
    orders: mut [mut [int]],
    // Per declared edge, in the direction it is laid out (a back edge is reversed).
    fromItem: mut [int],
    toItem: mut [int],
    reversed: mut [bool],
    // A back edge's chain is its two ends only: it takes no dummy and neighbours nothing.
    chains: mut [mut [int]],
    preds: mut [mut [int]],
    succs: mut [mut [int]],
}

fun zeros(n: int) > mut [int] {
    final made: mut [int] = mut [<int>];
    var i = 0;
    while (i < n) {
        made.append(0);
        i = i + 1;
    }
    return made;
}

fun lists(n: int) > mut [mut [int]] {
    final made: mut [mut [int]] = mut [<mut [int]>];
    var i = 0;
    while (i < n) {
        made.append(mut [<int>]);
        i = i + 1;
    }
    return made;
}

fun shownLabel(label: str, id: str) > str {
    if (label == "") { return id; }
    return label;
}

fun edgeKey(src: str, dst: str) > str {
    return "{src} -> {dst}";
}

fun quote(s: str) > str {
    return "\"{s}\"";
}

fun edgeName(src: str, dst: str) > str {
    return "edge {quote(src)} -> {quote(dst)}";
}

// call spells a constraint the way its author wrote it: rank(["a", "b"]).
fun call(verb: str, ids: [str]) > str {
    final quoted: mut [str] = mut [<str>];
    foreach (id in ids) { quoted.append(quote(id)); }
    return verb + "([" + quoted.join(", ") + "])";
}

// anchorRenames maps an observed id to the declared id that takes it over by anchor: the
// anchor names what a box depicts, so a declaration anchored where an observation sits is
// the same box under the author's id. An id match is settled first and never renamed; each
// declared node takes at most one observed node.
fun anchorRenames(f: Flow) > {str: str} {
    final observedIds: mut {str: bool} = mut {<str: bool>};
    foreach (o in f.observedNodes) { observedIds[o.id] = true; }
    final declaredIds: mut {str: bool} = mut {<str: bool>};
    final byAnchor: mut {str: str} = mut {<str: str>};
    foreach (n in f.nodes) {
        declaredIds[n.id] = true;
        if (n.anchor != "" and observedIds[n.id] == null and byAnchor[n.anchor] == null) {
            byAnchor[n.anchor] = n.id;
        }
    }
    final renames: mut {str: str} = mut {<str: str>};
    final claimed: mut {str: bool} = mut {<str: bool>};
    foreach (o in f.observedNodes) {
        final to = byAnchor[o.anchor];
        if (declaredIds[o.id] == null and o.anchor != "" and to != null and claimed[to!] == null) {
            renames[o.id] = to!;
            claimed[to!] = true;
        }
    }
    return renames;
}

fun observedEdgeKey(o: ObservedEdge, renames: {str: str}) > str {
    return edgeKey(renames[o.src] ?? o.src, dst: renames[o.dst] ?? o.dst);
}

// rebuilt is f with its node and edge lists replaced, every other declaration kept.
fun rebuilt(f: Flow, nodes: mut [Node], edges: mut [Edge], observedNodes: mut [ObservedNode], observedEdges: mut [ObservedEdge], hidden: mut [Hidden]) > Flow {
    return Flow{
        id = f.id,
        titleText = f.titleText,
        eyebrowText = f.eyebrowText,
        descText = f.descText,
        topDown = f.topDown,
        isGenerated = f.isGenerated,
        isUnscoped = f.isUnscoped,
        unscopedWhy = f.unscopedWhy,
        nodes = nodes,
        edges = edges,
        zones = f.zones,
        legendItems = f.legendItems,
        scopeGlobs = f.scopeGlobs,
        omitted = f.omitted,
        omittedTwice = f.omittedTwice,
        observedNodes = observedNodes,
        observedEdges = observedEdges,
        stamp = f.stamp,
        hidden = hidden,
        stringly = f.stringly,
        ranks = f.ranks,
        rows = f.rows,
        orders = f.orders,
    };
}

// dropOmitted removes every observed box anchored at an omitted path, and every observed
// connector touching one, so the observation cannot put back what the author left out.
fun dropOmitted(f: Flow) > Flow {
    final dropped: mut {str: bool} = mut {<str: bool>};
    final nodes: mut [ObservedNode] = mut [<ObservedNode>];
    foreach (o in f.observedNodes) {
        if (o.anchor != "" and f.omitted[o.anchor] != null) {
            dropped[o.id] = true;
        } else {
            nodes.append(o);
        }
    }
    final edges: mut [ObservedEdge] = mut [<ObservedEdge>];
    foreach (e in f.observedEdges) {
        if (dropped[e.src] == null and dropped[e.dst] == null) { edges.append(e); }
    }
    return rebuilt(f, nodes: f.nodes, edges: f.edges, observedNodes: nodes, observedEdges: edges, hidden: f.hidden);
}

// compose applies the merge rule and returns the flow the layout places: the declared boxes
// and connectors in declaration order, each merged with the observation sharing its id, its
// anchor or its ends, then what only the observation supplies, in observation order. The
// declaration order is the layout's tiebreak, so merging an observation never moves a box
// the author placed. Omitted observations are dropped before any of it.
fun compose(declared: Flow) > Flow {
    final f = dropOmitted(declared);
    final renames = anchorRenames(f);
    final declaredAt: mut {str: int} = mut {<str: int>};
    var i = 0;
    while (i < f.nodes.len()) {
        if (declaredAt[f.nodes[i].id] == null) { declaredAt[f.nodes[i].id] = i; }
        i = i + 1;
    }
    final mergedFrom: mut {int: ObservedNode} = mut {<int: ObservedNode>};
    final observedOnly: mut [ObservedNode] = mut [<ObservedNode>];
    foreach (o in f.observedNodes) {
        final at = declaredAt[renames[o.id] ?? o.id];
        if (at == null) {
            observedOnly.append(o);
        } else {
            if (mergedFrom[at!] == null) { mergedFrom[at!] = o; }
        }
    }
    final nodes: mut [Node] = mut [<Node>];
    i = 0;
    while (i < f.nodes.len()) {
        final d = f.nodes[i];
        final o = mergedFrom[i];
        var label = shownLabel(d.label, id: d.id);
        var anchor = d.anchor;
        if (o != null) {
            label = shownLabel(d.label, id: shownLabel(o!.label, id: o!.id));
            if (anchor == "") { anchor = o!.anchor; }
        }
        nodes.append(Node{ id = d.id, label = label, sub = d.sub, tag = d.tag, role = d.role, anchor = anchor, line = d.line, link = d.link });
        i = i + 1;
    }
    foreach (o in observedOnly) {
        nodes.append(Node{ id = o.id, label = shownLabel(o.label, id: o.id), anchor = o.anchor });
    }

    final declaredKeys: mut {str: bool} = mut {<str: bool>};
    final edges: mut [Edge] = mut [<Edge>];
    foreach (e in f.edges) {
        declaredKeys[edgeKey(e.src, dst: e.dst)] = true;
        edges.append(e);
    }
    final hiddenKeys: mut {str: bool} = mut {<str: bool>};
    foreach (h in f.hidden) { hiddenKeys[edgeKey(h.src, dst: h.dst)] = true; }
    foreach (o in f.observedEdges) {
        final src = renames[o.src] ?? o.src;
        final dst = renames[o.dst] ?? o.dst;
        final key = edgeKey(src, dst: dst);
        if (hiddenKeys[key] == null and declaredKeys[key] == null) {
            edges.append(Edge{ src = src, dst = dst, claim = Claim.imports.value });
        }
    }
    return rebuilt(f, nodes: nodes, edges: edges,
        observedNodes: mut [<ObservedNode>], observedEdges: mut [<ObservedEdge>], hidden: mut [<Hidden>]);
}

// compositionFindings reports what the merge rule cannot settle on its own: an omitEdge that
// no longer hides anything or gives no reason, two sides disagreeing on where a box lives in
// the code, a declared box drawing a path the figure omits, and a declared edge passing an
// observed import off as narrative.
fun compositionFindings(declared: Flow) > mut [str] {
    final errs: mut [str] = mut [<str>];
    foreach (arg in declared.stringly) { errs.append("{arg}, not a string; name the case"); }
    foreach (path in declared.omittedTwice) {
        errs.append("omit {quote(path)} is declared twice; keep one omit({quote(path)}, why:) with one reason");
    }
    // Read before the drop: a declaration overriding an omitted observation by id inherits
    // its anchor.
    final observedAnchor: mut {str: str} = mut {<str: str>};
    foreach (o in declared.observedNodes) { observedAnchor[o.id] = o.anchor; }
    foreach (n in declared.nodes) {
        var anchor = n.anchor;
        if (anchor == "") { anchor = observedAnchor[n.id] ?? ""; }
        final why = declared.omitted[anchor];
        if (anchor != "" and why != null) {
            errs.append("node {quote(n.id)} anchors {quote(anchor)}, which omit leaves out ({why!}); drop the node or the omit({quote(anchor)})");
        }
    }
    final f = dropOmitted(declared);
    final declaredAnchor: mut {str: str} = mut {<str: str>};
    foreach (n in f.nodes) {
        if (declaredAnchor[n.id] == null) { declaredAnchor[n.id] = n.anchor; }
    }
    foreach (o in f.observedNodes) {
        final d = declaredAnchor[o.id] ?? "";
        if (d != "" and o.anchor != "" and d != o.anchor) {
            errs.append("node {quote(o.id)} is anchored at {quote(d)} but observed at {quote(o.anchor)}; anchor it at {quote(o.anchor)} or give it an id of its own");
        }
    }
    // Whatever the merge left unmerged under a declared anchor would draw the same place
    // in the code twice. Two declared boxes may share an anchor, one package drawn as two
    // parts: the observation merges into the first and the second draws nothing twice.
    final renames = anchorRenames(f);
    final declaredIds: mut {str: bool} = mut {<str: bool>};
    foreach (n in f.nodes) { declaredIds[n.id] = true; }
    foreach (n in f.nodes) {
        if (n.anchor != "") {
            foreach (o in f.observedNodes) {
                if (o.anchor == n.anchor and declaredIds[o.id] == null and renames[o.id] == null) {
                    errs.append("node {quote(n.id)} anchors {quote(n.anchor)}, which observed node {quote(o.id)} already carries; override it with node({quote(o.id)}) or omit({quote(n.anchor)}, why:)");
                }
            }
        }
    }
    final observedKeys: mut {str: bool} = mut {<str: bool>};
    foreach (o in f.observedEdges) { observedKeys[observedEdgeKey(o, renames: renames)] = true; }
    final hiddenKeys: mut {str: bool} = mut {<str: bool>};
    foreach (h in f.hidden) {
        final hidden = "omitEdge {quote(h.src)} -> {quote(h.dst)}";
        hiddenKeys[edgeKey(h.src, dst: h.dst)] = true;
        if (h.why == "") {
            errs.append("{hidden} gives no reason; say why in omitEdge({quote(h.src)}, dst: {quote(h.dst)}, why:)");
        }
        if (observedKeys[edgeKey(h.src, dst: h.dst)] == null) {
            errs.append("{hidden} names no observed edge; drop the omitEdge");
        }
    }
    foreach (e in f.edges) {
        final key = edgeKey(e.src, dst: e.dst);
        if (hiddenKeys[key] != null) {
            errs.append("{edgeName(e.src, dst: e.dst)} is declared and also hidden by omitEdge; drop one of them");
        }
        if (observedKeys[key] != null and hiddenKeys[key] == null and e.claim == Claim.flow.value) {
            errs.append("{edgeName(e.src, dst: e.dst)} replaces an observed import but claims flow; claim Claim.imports or omitEdge it");
        }
    }
    return errs;
}

// declarationFindings reports, before any placement runs, every fault the declaration
// itself carries: what no layout could fix, and what the renderer would refuse in its own
// terms. What validate finds after placement is then the layout's alone.
fun declarationFindings(f: Flow) > [str] {
    final errs: mut [str] = mut [<str>];
    final known: mut {str: bool} = mut {<str: bool>};
    final exits: mut {str: int} = mut {<str: int>};
    var focal = 0;
    foreach (n in f.nodes) {
        final id = quote(n.id);
        if (known[n.id] != null) {
            errs.append("node {id} is declared twice; merge the two node({id}) calls");
        }
        known[n.id] = true;
        if (n.anchor != "" and n.link != "") {
            errs.append("node {id} sets both anchor and link; keep anchor for a path in this repo, link for anything outside it");
        }
        if (n.role == Role.decision.value and (n.tag != "" or n.sub != "")) {
            errs.append("node {id} is a Role.decision with a tag or sub; drop them from node({id}), a diamond has room for neither");
        }
        if (n.role == Role.focal.value) { focal = focal + 1; }
    }
    final seenEdge: mut {str: bool} = mut {<str: bool>};
    foreach (e in f.edges) {
        final name = edgeName(e.src, dst: e.dst);
        foreach (end in [e.src, e.dst]) {
            if (known[end] == null) {
                errs.append("{name} names {quote(end)}, which neither a node nor the observed set supplies; declare node({quote(end)})");
            }
        }
        if (e.src == e.dst) { errs.append("{name} loops to itself; drop the edge"); }
        final key = edgeKey(e.src, dst: e.dst);
        if (seenEdge[key] != null) { errs.append("{name} is declared twice; keep one edge({quote(e.src)}, dst: {quote(e.dst)})"); }
        seenEdge[key] = true;
        if (e.label.len() > MaxEdgeLabel) {
            errs.append("{name} label {quote(e.label)} runs past {MaxEdgeLabel} characters; shorten it or move it to desc()");
        }
        if (e.kind == "accent") { focal = focal + 1; }
        exits[e.src] = (exits[e.src] ?? 0) + 1;
    }
    foreach (n in f.nodes) {
        final leaving = exits[n.id] ?? 0;
        if (n.role == Role.decision.value and leaving > MaxDecisionExits) {
            errs.append("node {quote(n.id)} has {leaving} exits; a Role.decision takes {MaxDecisionExits}, so nest a second decision node");
        }
    }

    final owner: mut {str: str} = mut {<str: str>};
    final labels: mut {str: bool} = mut {<str: bool>};
    foreach (z in f.zones) {
        var kind = "zone";
        if (z.boundary) { kind = "boundary"; }
        final label = quote(z.label);
        if (labels[z.label] != null) {
            errs.append("{kind} {label} is declared twice; merge the members into one {kind}({label}, members:)");
        }
        labels[z.label] = true;
        if (z.members.len() == 0) {
            errs.append("{kind} {label} has no members; name them in {kind}({label}, members: [...]) or drop it");
        }
        foreach (m in z.members) {
            if (known[m] == null) {
                errs.append("{kind} {label} names {quote(m)}, which no node declares; declare node({quote(m)}) or drop it from members");
            }
            final prior = owner[m];
            if (prior != null and prior! != z.label) {
                errs.append("node {quote(m)} sits in zones {quote(prior!)} and {label}; keep it in one of them");
            }
            if (prior == null) { owner[m] = z.label; }
        }
    }

    final scoped = f.scopeGlobs.len() > 0;
    if (scoped == false and f.isUnscoped == false and f.isGenerated == false) {
        errs.append("names no code; add scope([...]) or unscoped(why:)");
    }
    if (scoped and f.isUnscoped) {
        errs.append("declares both scope([...]) and unscoped(why:); keep one");
    }
    if (f.isUnscoped and f.unscopedWhy == "") {
        errs.append("unscoped gives no reason; say why in unscoped(why:)");
    }

    if (f.isGenerated == false) {
        // internal/handler/diagram's 422 test pins "split into overview plus detail".
        final split = "split into overview plus detail, one flow() each";
        if (f.nodes.len() > MaxNodes) { errs.append("{f.nodes.len()} nodes exceeds the budget of {MaxNodes}; {split}"); }
        if (f.edges.len() > MaxEdges) { errs.append("{f.edges.len()} edges exceeds the budget of {MaxEdges}; {split}"); }
        if (focal > MaxAccent) {
            errs.append("{focal} focal nodes and edges exceed the budget of {MaxAccent}; keep Role.focal and EdgeRole.focal for the one point the figure makes");
        }
        if (f.zones.len() > MaxZones) {
            errs.append("{f.zones.len()} zones and boundaries exceed the budget of {MaxZones}; merge bands or {split}");
        }
    }

    foreach (verb in ["rank", "row", "order"]) {
        var sets = f.ranks;
        if (verb == "row") { sets = f.rows; }
        if (verb == "order") { sets = f.orders; }
        foreach (ids in sets) {
            final named = call(verb, ids: ids);
            if (ids.len() < 2) { errs.append("{named} relates fewer than two nodes; name two or more, or drop it"); }
            final seen: mut {str: bool} = mut {<str: bool>};
            foreach (id in ids) {
                if (known[id] == null) {
                    errs.append("{named} names {quote(id)}, which no node declares; declare node({quote(id)}) or drop it from {verb}([...])");
                }
                if (seen[id] != null) { errs.append("{named} names {quote(id)} twice; name each node once"); }
                seen[id] = true;
            }
        }
    }
    return errs;
}

// Groups is a union-find over node indices, for constraints that chain: rank(a, b) and
// rank(b, c) put all three in one rank.
object Groups {
    parent: mut [int],

    fun find(i: int) > int {
        var at = i;
        while (this.parent[at] != at) { at = this.parent[at]; }
        return at;
    }

    fun join(a: int, b: int) > void {
        final ra = this.find(a);
        final rb = this.find(b);
        if (ra < rb) { this.parent[rb] = ra; }
        if (rb < ra) { this.parent[ra] = rb; }
    }
}

fun groupsOf(n: int, sets: [[str]], idx: {str: int}) > Groups {
    final g = Groups{ parent = zeros(n) };
    var i = 0;
    while (i < n) {
        g.parent[i] = i;
        i = i + 1;
    }
    foreach (ids in sets) {
        var k = 1;
        while (k < ids.len()) {
            g.join(idx[ids[0]] ?? 0, b: idx[ids[k]] ?? 0);
            k = k + 1;
        }
    }
    return g;
}

// constraintFindings checks rank, row and order against the edges, the zones and the ranks
// the plan assigned. declarationFindings has already refused an unknown id.
fun constraintFindings(f: Flow, pl: Plan) > [str] {
    final errs: mut [str] = mut [<str>];
    final nn = f.nodes.len();
    if (f.ranks.len() + f.rows.len() + f.orders.len() == 0) { return errs; }
    final idx: mut {str: int} = mut {<str: int>};
    var i = 0;
    while (i < nn) {
        if (idx[f.nodes[i].id] == null) { idx[f.nodes[i].id] = i; }
        i = i + 1;
    }
    final succ = lists(nn);
    foreach (e in f.edges) { succ[idx[e.src] ?? 0].append(idx[e.dst] ?? 0); }
    // reach[a][b]: a directed path runs from a to b, walked from every node; figures are small.
    final reach: mut [mut {int: bool}] = mut [<mut {int: bool}>];
    i = 0;
    while (i < nn) {
        final seen: mut {int: bool} = mut {<int: bool>};
        final queue: mut [int] = mut [i];
        var head = 0;
        while (head < queue.len()) {
            foreach (w in succ[queue[head]]) {
                if (seen[w] == null) {
                    seen[w] = true;
                    queue.append(w);
                }
            }
            head = head + 1;
        }
        reach.append(seen);
        i = i + 1;
    }
    final zoneOf: mut {str: int} = mut {<str: int>};
    var z = 0;
    while (z < f.zones.len()) {
        foreach (m in f.zones[z].members) {
            if (zoneOf[m] == null) { zoneOf[m] = z; }
        }
        z = z + 1;
    }
    final ranked = groupsOf(nn, sets: f.ranks, idx: idx);
    final sameRank = fun (a: int, b: int) > bool {
        return ranked.find(a) == ranked.find(b) or pl.rankOf[a] == pl.rankOf[b];
    };

    // Each group of rank() calls, in declaration order, against every path between two of
    // its members.
    final reported: mut {int: bool} = mut {<int: bool>};
    i = 0;
    while (i < nn) {
        final root = ranked.find(i);
        if (reported[root] == null) {
            reported[root] = true;
            final members: mut [int] = mut [<int>];
            var m = 0;
            while (m < nn) {
                if (ranked.find(m) == root) { members.append(m); }
                m = m + 1;
            }
            if (members.len() > 1) {
                final ids: mut [str] = mut [<str>];
                foreach (at in members) { ids.append(f.nodes[at].id); }
                foreach (a in members) {
                    foreach (b in members) {
                        if (a != b and reach[a][b] != null) {
                            errs.append("{call("rank", ids: ids)} contradicts the path {quote(f.nodes[a].id)} -> {quote(f.nodes[b].id)}; drop one of them from rank([...])");
                        }
                    }
                }
            }
        }
        i = i + 1;
    }

    foreach (ids in f.orders) {
        final named = call("order", ids: ids);
        var k = 1;
        while (k < ids.len()) {
            final a = idx[ids[k - 1]] ?? 0;
            final b = idx[ids[k]] ?? 0;
            final pair = "{quote(ids[k - 1])} and {quote(ids[k])}";
            if (reach[a][b] != null or reach[b][a] != null) {
                errs.append("{named} names {pair}, which a path puts in different ranks; order sorts one rank, so drop it or use row([...])");
            } else {
                if (sameRank(a, b: b) == false) {
                    errs.append("{named} names {pair}, which sit in different ranks; add rank([...]) with both or drop the order");
                }
            }
            final za = zoneOf[ids[k - 1]];
            final zb = zoneOf[ids[k]];
            if (za != null and zb != null and za! > zb!) {
                errs.append("{named} puts {quote(ids[k - 1])} first, but zone {quote(f.zones[za!].label)} stacks after zone {quote(f.zones[zb!].label)}; reorder the zones or drop the order");
            }
            // An unzoned node stacks after every zone, save a band's sole parent and a node
            // between two bands.
            if ((za == null or zb == null) and pl.stackOf[pl.bandOf[a]] > pl.stackOf[pl.bandOf[b]]) {
                errs.append("{named} puts {quote(ids[k - 1])} first, but it stacks in a later band than {quote(ids[k])}; put both in one zone or drop the order");
            }
            k = k + 1;
        }
    }
    // Kahn's walk over the order pairs: whatever it cannot drain sits on a cycle.
    final before = lists(nn);
    final indeg = zeros(nn);
    foreach (ids in f.orders) {
        var k = 1;
        while (k < ids.len()) {
            final a = idx[ids[k - 1]] ?? 0;
            final b = idx[ids[k]] ?? 0;
            before[a].append(b);
            indeg[b] = indeg[b] + 1;
            k = k + 1;
        }
    }
    final queue: mut [int] = mut [<int>];
    i = 0;
    while (i < nn) {
        if (indeg[i] == 0) { queue.append(i); }
        i = i + 1;
    }
    var head = 0;
    while (head < queue.len()) {
        foreach (w in before[queue[head]]) {
            indeg[w] = indeg[w] - 1;
            if (indeg[w] == 0) { queue.append(w); }
        }
        head = head + 1;
    }
    if (queue.len() < nn) {
        final cycle: mut [str] = mut [<str>];
        i = 0;
        while (i < nn) {
            if (indeg[i] > 0) { cycle.append(quote(f.nodes[i].id)); }
            i = i + 1;
        }
        errs.append("order puts {cycle.join(", ")} each before the other; drop the order([...]) that reverses them");
    }

    final lined = groupsOf(nn, sets: f.rows, idx: idx);
    final seenRow: mut {int: bool} = mut {<int: bool>};
    i = 0;
    while (i < nn) {
        final root = lined.find(i);
        if (seenRow[root] == null) {
            seenRow[root] = true;
            final members: mut [int] = mut [<int>];
            var m = 0;
            while (m < nn) {
                if (lined.find(m) == root) { members.append(m); }
                m = m + 1;
            }
            final ids: mut [str] = mut [<str>];
            foreach (at in members) { ids.append(f.nodes[at].id); }
            var x = 0;
            while (x < members.len()) {
                var y = x + 1;
                while (y < members.len()) {
                    final a = f.nodes[members[x]].id;
                    final b = f.nodes[members[y]].id;
                    if (sameRank(members[x], b: members[y])) {
                        errs.append("{call("row", ids: ids)} names {quote(a)} and {quote(b)}, which share a rank; a row lines up across ranks, so use order([...]) within one");
                    }
                    final za = zoneOf[a];
                    final zb = zoneOf[b];
                    if (za != null and zb != null and za! != zb!) {
                        errs.append("{call("row", ids: ids)} names {quote(a)} in zone {quote(f.zones[za!].label)} and {quote(b)} in zone {quote(f.zones[zb!].label)}; bands never share a row, so drop one of them");
                    }
                    y = y + 1;
                }
                x = x + 1;
            }
        }
        i = i + 1;
    }
    return errs;
}
fun plan(f: Flow) > Plan {
    final nn = f.nodes.len();
    final nz = f.zones.len();
    final idx: mut {str: int} = mut {<str: int>};
    var i = 0;
    while (i < nn) {
        if (idx[f.nodes[i].id] == null) { idx[f.nodes[i].id] = i; }
        i = i + 1;
    }

    final bandOf: mut [int] = mut [<int>];
    i = 0;
    while (i < nn) {
        bandOf.append(nz);
        i = i + 1;
    }
    var z = 0;
    while (z < nz) {
        foreach (m in f.zones[z].members) {
            final at = idx[m];
            if (at != null) { bandOf[at!] = z; }
        }
        z = z + 1;
    }

    final fromItem: mut [int] = mut [<int>];
    final toItem: mut [int] = mut [<int>];
    final reversed: mut [bool] = mut [<bool>];
    // declarationFindings has already refused a missing endpoint and a self loop.
    foreach (e in f.edges) {
        fromItem.append(idx[e.src] ?? 0);
        toItem.append(idx[e.dst] ?? 0);
        reversed.append(false);
    }
    final ne = fromItem.len();

    // Cycle break: an edge into a node still on the DFS stack closes a cycle, and laying it
    // out reversed leaves a DAG. Entry points and children in declaration order.
    final outAdj = lists(nn);
    var li = 0;
    while (li < ne) {
        outAdj[fromItem[li]].append(li);
        li = li + 1;
    }
    final state = zeros(nn);
    final stackNode: mut [int] = mut [<int>];
    final stackNext: mut [int] = mut [<int>];
    var start = 0;
    while (start < nn) {
        if (state[start] == 0) {
            state[start] = 1;
            stackNode.append(start);
            stackNext.append(0);
            while (stackNode.len() > 0) {
                final top = stackNode.len() - 1;
                final u = stackNode[top];
                final k = stackNext[top];
                if (k < outAdj[u].len()) {
                    stackNext[top] = k + 1;
                    final edgeAt = outAdj[u][k];
                    final w = toItem[edgeAt];
                    if (state[w] == 1) {
                        reversed[edgeAt] = true;
                    } else {
                        if (state[w] == 0) {
                            state[w] = 1;
                            stackNode.append(w);
                            stackNext.append(0);
                        }
                    }
                } else {
                    state[u] = 2;
                    stackNode.pop();
                    stackNext.pop();
                }
            }
        }
        start = start + 1;
    }
    li = 0;
    while (li < ne) {
        if (reversed[li]) {
            final a = fromItem[li];
            fromItem[li] = toItem[li];
            toItem[li] = a;
        }
        li = li + 1;
    }

    final inZone: mut [bool] = mut [<bool>];
    foreach (b in bandOf) { inZone.append(b < nz); }
    // Layout parent of each node: -1 none yet, -2 more than one.
    final parentOf: mut [int] = mut [<int>];
    i = 0;
    while (i < nn) {
        parentOf.append(0 - 1);
        i = i + 1;
    }
    li = 0;
    while (li < ne) {
        final t = toItem[li];
        if (reversed[li]) {
            li = li + 1;
            continue;
        }
        if (parentOf[t] == 0 - 1) {
            parentOf[t] = fromItem[li];
        } else {
            if (parentOf[t] != fromItem[li]) { parentOf[t] = 0 - 2; }
        }
        li = li + 1;
    }
    z = 0;
    while (z < nz) {
        var sole = 0 - 1;
        var shared = true;
        foreach (m in f.zones[z].members) {
            final at = idx[m];
            if (at == null) {
                shared = false;
            } else {
                final p = parentOf[at!];
                if (p < 0 or (sole >= 0 and p != sole)) { shared = false; }
                if (sole < 0) { sole = p; }
            }
        }
        // An unzoned sole parent of every member of a band sits beside it, not after the last band.
        if (shared and sole >= 0 and bandOf[sole] == nz) { bandOf[sole] = z; }
        z = z + 1;
    }
    var gapCount = 0;
    if (nz > 1) { gapCount = nz - 1; }
    final stackOf: mut [int] = mut [<int>];
    var sb = 0;
    while (sb < nz + 1 + gapCount) {
        if (sb < nz) { stackOf.append(2 * sb); }
        if (sb == nz) { stackOf.append(nz + gapCount); }
        if (sb > nz) { stackOf.append(2 * (sb - nz - 1) + 1); }
        sb = sb + 1;
    }
    // An unzoned node joining two adjacent bands is what both sides share, so it takes a row
    // between them. Neighbours in bands further apart, in three bands, or in the unzoned
    // rest leave it after the last band: no one gap sits beside them all. Read against the
    // bands before any move, so no move depends on another.
    final nearLo: mut [int] = mut [<int>];
    final nearHi: mut [int] = mut [<int>];
    i = 0;
    while (i < nn) {
        nearLo.append(nz);
        nearHi.append(0 - 1);
        i = i + 1;
    }
    li = 0;
    while (li < ne) {
        final a = fromItem[li];
        final b = toItem[li];
        if (bandOf[b] < nearLo[a]) { nearLo[a] = bandOf[b]; }
        if (bandOf[b] > nearHi[a]) { nearHi[a] = bandOf[b]; }
        if (bandOf[a] < nearLo[b]) { nearLo[b] = bandOf[a]; }
        if (bandOf[a] > nearHi[b]) { nearHi[b] = bandOf[a]; }
        li = li + 1;
    }
    i = 0;
    while (i < nn) {
        if (bandOf[i] == nz and nearHi[i] == nearLo[i] + 1 and nearHi[i] < nz) { bandOf[i] = nz + 1 + nearLo[i]; }
        i = i + 1;
    }

    // Longest path from the roots, in topological order. A back edge closes a cycle over a
    // forward path, so leaving it out orders nothing differently.
    final succAdj = lists(nn);
    final indeg = zeros(nn);
    li = 0;
    while (li < ne) {
        if (reversed[li] == false) {
            succAdj[fromItem[li]].append(li);
            indeg[toItem[li]] = indeg[toItem[li]] + 1;
        }
        li = li + 1;
    }
    final topo: mut [int] = mut [<int>];
    i = 0;
    while (i < nn) {
        if (indeg[i] == 0) { topo.append(i); }
        i = i + 1;
    }
    var head = 0;
    while (head < topo.len()) {
        foreach (edgeAt in succAdj[topo[head]]) {
            final v = toItem[edgeAt];
            indeg[v] = indeg[v] - 1;
            if (indeg[v] == 0) { topo.append(v); }
        }
        head = head + 1;
    }
    // rank() pulls a group to its deepest member's rank as a floor, and the floors push
    // descendants on; a group that chases itself never settles, and constraintFindings
    // names the path that makes it.
    final ranked = groupsOf(nn, sets: f.ranks, idx: idx);
    final floor = zeros(nn);
    final rankOf = zeros(nn);
    var pass = 0;
    var moved = true;
    while (moved and pass <= nn) {
        i = 0;
        while (i < nn) {
            rankOf[i] = floor[i];
            i = i + 1;
        }
        foreach (u in topo) {
            foreach (edgeAt in succAdj[u]) {
                final v = toItem[edgeAt];
                if (rankOf[u] + 1 > rankOf[v]) { rankOf[v] = rankOf[u] + 1; }
            }
        }
        final deepest = zeros(nn);
        i = 0;
        while (i < nn) {
            final root = ranked.find(i);
            if (rankOf[i] > deepest[root]) { deepest[root] = rankOf[i]; }
            i = i + 1;
        }
        moved = false;
        i = 0;
        while (i < nn) {
            final want = deepest[ranked.find(i)];
            if (want > floor[i]) {
                floor[i] = want;
                moved = true;
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    var maxRank = 0;
    foreach (r in rankOf) {
        if (r > maxRank) { maxRank = r; }
    }

    // One dummy per intermediate rank, in the band of the edge's source, so a long edge
    // claims a lane of its own in every column it crosses. A back edge routes around the
    // outside instead, so it claims none and pulls on no box.
    final chains: mut [mut [int]] = mut [<mut [int]>];
    li = 0;
    while (li < ne) {
        final a = fromItem[li];
        final b = toItem[li];
        final chain: mut [int] = mut [a];
        var r = rankOf[a] + 1;
        while (r < rankOf[b] and reversed[li] == false) {
            chain.append(rankOf.len());
            rankOf.append(r);
            bandOf.append(bandOf[a]);
            r = r + 1;
        }
        chain.append(b);
        chains.append(chain);
        li = li + 1;
    }
    final items = rankOf.len();
    final preds = lists(items);
    final succs = lists(items);
    li = 0;
    while (li < ne) {
        final chain = chains[li];
        var s = 0;
        while (s + 1 < chain.len() and reversed[li] == false) {
            succs[chain[s]].append(chain[s + 1]);
            preds[chain[s + 1]].append(chain[s]);
            s = s + 1;
        }
        li = li + 1;
    }

    final orders = lists(maxRank + 1);
    i = 0;
    while (i < items) {
        orders[rankOf[i]].append(i);
        i = i + 1;
    }
    final pos = zeros(items);
    final scoreSum = zeros(items);
    final scoreCnt = zeros(items);
    // Band first, then barycenter compared as cross-multiplied fractions, then declaration
    // index, so the order is total and never leans on sort stability. An item with no
    // neighbors on the swept side sinks to the end of its band.
    final before = fun (x: int, y: int) > bool {
        if (bandOf[x] != bandOf[y]) { return stackOf[bandOf[x]] < stackOf[bandOf[y]]; }
        final xLoose = scoreCnt[x] == 0;
        final yLoose = scoreCnt[y] == 0;
        if (xLoose != yLoose) { return yLoose; }
        if (xLoose == false) {
            final l = scoreSum[x] * scoreCnt[y];
            final rr = scoreSum[y] * scoreCnt[x];
            if (l != rr) { return l < rr; }
        }
        return x < y;
    };
    final orderNext = lists(nn);
    final ordered: mut [bool] = mut [<bool>];
    i = 0;
    while (i < nn) {
        ordered.append(false);
        i = i + 1;
    }
    foreach (ids in f.orders) {
        var k = 1;
        while (k < ids.len()) {
            final a = idx[ids[k - 1]] ?? 0;
            final b = idx[ids[k]] ?? 0;
            orderNext[a].append(b);
            ordered[a] = true;
            ordered[b] = true;
            k = k + 1;
        }
    }
    foreach (row in orders) {
        row.sort(before);
        honourOrder(row, next: orderNext, ordered: ordered);
    }
    foreach (row in orders) {
        var j = 0;
        foreach (it in row) {
            pos[it] = j;
            j = j + 1;
        }
    }

    // Three barycenter sweeps: down, up, down. Each fixes the rank it reads from, so the
    // first rank of a sweep is never reordered by it.
    foreach (goingDown in [true, false, true]) {
        var step = 1;
        while (step <= maxRank) {
            var r = step;
            if (goingDown == false) { r = maxRank - step; }
            foreach (it in orders[r]) {
                var nbs = preds[it];
                if (goingDown == false) { nbs = succs[it]; }
                var sum = 0;
                foreach (nb in nbs) { sum = sum + pos[nb]; }
                scoreSum[it] = sum;
                scoreCnt[it] = nbs.len();
            }
            orders[r].sort(before);
            honourOrder(orders[r], next: orderNext, ordered: ordered);
            var j = 0;
            foreach (it in orders[r]) {
                pos[it] = j;
                j = j + 1;
            }
            step = step + 1;
        }
    }

    return Plan{
        nodeCount = nn,
        bandCount = nz + 1 + gapCount,
        maxRank = maxRank,
        rankOf = rankOf,
        bandOf = bandOf,
        stackOf = stackOf,
        inZone = inZone,
        orders = orders,
        fromItem = fromItem,
        toItem = toItem,
        reversed = reversed,
        chains = chains,
        preds = preds,
        succs = succs,
    };
}

// honourOrder deals the slots a rank's ordered nodes occupy back out in order() sequence,
// the rest of the rank untouched. Kahn's walk takes the leftmost free node first, so a pair
// no order() relates keeps its barycenter order; a cycle is refused elsewhere and left as is.
fun honourOrder(row: mut [int], next: [[int]], ordered: [bool]) > void {
    final at: mut [int] = mut [<int>];
    final members: mut [int] = mut [<int>];
    final inRow: mut {int: bool} = mut {<int: bool>};
    var k = 0;
    foreach (it in row) {
        if (it < ordered.len() and ordered[it]) {
            at.append(k);
            members.append(it);
            inRow[it] = true;
        }
        k = k + 1;
    }
    if (members.len() < 2) { return; }
    final indeg: mut {int: int} = mut {<int: int>};
    foreach (m in members) {
        foreach (w in next[m]) {
            if (inRow[w] != null) { indeg[w] = (indeg[w] ?? 0) + 1; }
        }
    }
    final dealt: mut [int] = mut [<int>];
    final done: mut {int: bool} = mut {<int: bool>};
    var stuck = false;
    while (dealt.len() < members.len() and stuck == false) {
        stuck = true;
        foreach (m in members) {
            if (stuck and done[m] == null and (indeg[m] ?? 0) == 0) {
                dealt.append(m);
                done[m] = true;
                foreach (w in next[m]) {
                    if (inRow[w] != null) { indeg[w] = (indeg[w] ?? 0) - 1; }
                }
                stuck = false;
            }
        }
    }
    if (dealt.len() < members.len()) { return; }
    k = 0;
    while (k < at.len()) {
        row[at[k]] = dealt[k];
        k = k + 1;
    }
}

// Placer is what the coordinate sweeps read about each item: half its cross size (a dummy
// is a line and has none), whether it is a diamond, and the row() leader it follows, -1
// for none.
object Placer {
    half: [int],
    decision: [bool],
    leader: [int],
    member: [bool],
}

// floor4 rounds down onto the 4px grid, negative midlines included.
fun floor4(n: int) > int {
    return n - ((n % 4) + 4) % 4;
}

fun roundUp8(n: int) > int {
    return n + (8 - n % 8) % 8;
}

// fanRoom is the cross size a side needs to seat n slots a Pitch apart and a Pitch clear
// of each corner, with room for the midline to hold the straight one: an even fan is
// anchored at its lower middle, which leaves n/2 steps on the far side. Rounded to 8 so the
// midline stays on the grid.
fun fanRoom(n: int) > int {
    return roundUp8(2 * (Pitch * (n / 2) + Pitch));
}

// gapFor is the width a column gap needs for k channels a Pitch apart, each FaceClear off
// both faces; never under the house gap.
fun gapFor(k: int) > int {
    if (k == 0) { return LayerColGap; }
    return imax(LayerColGap, b: roundUp8(2 * (iabs(latticeOffset(1, slots: k, pitch: Pitch)) + FaceClear)));
}

// median of an even count takes the lower middle inside a band, so one connector of the
// pair runs straight; a free rank, which belongs to no band, centres on the pair.
fun median(vals: mut [int], centre: bool) > int {
    vals.sort(fun (a: int, b: int) > bool { return a < b; });
    final n = vals.len();
    if (n % 2 == 1) { return vals[n / 2]; }
    if (centre) { return floor4((vals[n / 2 - 1] + vals[n / 2]) / 2); }
    return vals[n / 2 - 1];
}

// settle places one run of a rank, in cross order, by priority: each item takes the
// midline it wants unless one placed before it blocks the way, and pushes the unplaced
// ones aside. gaps[k] is the least distance between the midlines of seg[k] and seg[k + 1].
// This is the priority method of Sugiyama, Tagawa and Toda (1981), one rank at a time.
fun settle(seg: [int], pos: mut [int], want: [int], key: [int], gaps: [int]) > void {
    final n = seg.len();
    final byKey: mut [int] = mut [<int>];
    final fixed: mut [bool] = mut [<bool>];
    var k = 0;
    while (k < n) {
        byKey.append(k);
        fixed.append(false);
        k = k + 1;
    }
    byKey.sort(fun (x: int, y: int) > bool {
        if (key[x] != key[y]) { return key[x] < key[y]; }
        return x < y;
    });
    foreach (at in byKey) {
        var lo = 0 - Far;
        var room = 0;
        var j = at - 1;
        while (j >= 0) {
            room = room + gaps[j];
            if (fixed[j]) {
                lo = pos[seg[j]] + room;
                break;
            }
            j = j - 1;
        }
        var hi = Far;
        room = 0;
        j = at + 1;
        while (j < n) {
            room = room + gaps[j - 1];
            if (fixed[j]) {
                hi = pos[seg[j]] - room;
                break;
            }
            j = j + 1;
        }
        pos[seg[at]] = imin(imax(want[at], b: lo), b: hi);
        j = at - 1;
        while (j >= 0) {
            pos[seg[j]] = imin(pos[seg[j]], b: pos[seg[j + 1]] - gaps[j]);
            j = j - 1;
        }
        j = at + 1;
        while (j < n) {
            pos[seg[j]] = imax(pos[seg[j]], b: pos[seg[j - 1]] + gaps[j - 1]);
            j = j + 1;
        }
        fixed[at] = true;
    }
}

// runsOf splits a rank into what settle places as one: a band's share of it, or the whole
// rank once bands no longer matter.
fun runsOf(row: [int], bandOf: [int], whole: bool) > [[int]] {
    final runs: mut [[int]] = mut [<[int]>];
    var run: mut [int] = mut [<int>];
    foreach (item in row) {
        if (run.len() > 0 and whole == false and bandOf[run[0]] != bandOf[item]) {
            runs.append(run);
            run = mut [<int>];
        }
        run.append(item);
    }
    if (run.len() > 0) { runs.append(run); }
    return runs;
}

// gapsOf is the least midline distance between neighbours in a run: two boxes keep a row
// gap, and so does a diamond, whose side exits step into it; a lane beside anything keeps
// a Pitch.
fun gapsOf(run: [int], pc: Placer, nodeCount: int) > [int] {
    final gaps: mut [int] = mut [<int>];
    var k = 0;
    while (k + 1 < run.len()) {
        final a = run[k];
        final b = run[k + 1];
        var gap = Pitch;
        if ((a < nodeCount and b < nodeCount) or pc.decision[a] or pc.decision[b]) { gap = LayerRowGap; }
        gaps.append(pc.half[a] + pc.half[b] + gap);
        k = k + 1;
    }
    return gaps;
}

// pack lines a rank's runs up at their least distances from start, each run afresh.
fun pack(row: [int], pos: mut [int], pl: Plan, pc: Placer, whole: bool, start: int) > void {
    foreach (run in runsOf(row, bandOf: pl.bandOf, whole: whole)) {
        final gaps = gapsOf(run, pc: pc, nodeCount: pl.nodeCount);
        pos[run[0]] = start;
        var k = 1;
        while (k < run.len()) {
            pos[run[k]] = pos[run[k - 1]] + gaps[k - 1];
            k = k + 1;
        }
    }
}

// alignRanks sweeps down, up and down again, placing each rank toward its neighbours in the
// rank the sweep came from: a row() follower wants its leader's midline, anything else the
// median of its neighbours. A hub, a box fed by several and feeding more, reads its far
// side instead, so it sits in the middle of its wider fan. A row() member
// goes first, then a box, then a long edge's lane, then what has no neighbour there; within
// a class the better connected, then the one already nearest, then the earlier. The first
// phase aligns each band on its own; the second places the free ranks against everything.
fun alignRanks(pl: Plan, pos: mut [int], pc: Placer, free: [bool], phaseTwo: bool) > void {
    foreach (goingDown in [true, false, true]) {
        var step = 1;
        while (step <= pl.maxRank) {
            var r = step;
            if (goingDown == false) { r = pl.maxRank - step; }
            if (free[r] == phaseTwo) {
                foreach (run in runsOf(pl.orders[r], bandOf: pl.bandOf, whole: phaseTwo)) {
                    final want: mut [int] = mut [<int>];
                    final key: mut [int] = mut [<int>];
                    foreach (item in run) {
                        var nbs = pl.preds[item];
                        var far = pl.succs[item];
                        if (goingDown == false) {
                            nbs = pl.succs[item];
                            far = pl.preds[item];
                        }
                        if (item < pl.nodeCount and pc.decision[item] == false and nbs.len() > 1 and far.len() > nbs.len()) { nbs = far; }
                        final vals: mut [int] = mut [<int>];
                        foreach (nb in nbs) {
                            final sameBand = pl.bandOf[nb] == pl.bandOf[item] and free[pl.rankOf[nb]] == false;
                            if (phaseTwo or sameBand) { vals.append(pos[nb]); }
                        }
                        final lead = pc.leader[item];
                        var follows = false;
                        if (lead >= 0) {
                            follows = free[pl.rankOf[lead]] == phaseTwo and (phaseTwo or pl.bandOf[lead] == pl.bandOf[item]);
                        }
                        var w = pos[item];
                        var cls = 3;
                        var degree = vals.len();
                        if (vals.len() > 0) {
                            w = median(vals, centre: phaseTwo);
                            cls = 2;
                            if (item < pl.nodeCount) { cls = 1; }
                        }
                        if (pc.member[item]) { cls = 0; }
                        if (follows) {
                            w = pos[lead];
                            degree = 9;
                        }
                        want.append(w);
                        key.append(cls * 10000000 + (9 - imin(degree, b: 9)) * 1000000 + imin(iabs(w - pos[item]), b: 999999));
                    }
                    settle(run, pos: pos, want: want, key: key, gaps: gapsOf(run, pc: pc, nodeCount: pl.nodeCount));
                }
            }
            step = step + 1;
        }
    }
}

// straightenLanes gives each long edge's lane one cross coordinate where every rank it
// crosses leaves room: its source's row if it can, else its target's, else the first of
// its own that fits. The sweeps settle one rank at a time, so a lane pushed aside by
// another entering beside it would otherwise jog in every rank it passes. Longer lanes
// settle first; a lane keeps inside its band.
fun straightenLanes(pl: Plan, pos: mut [int], pc: Placer, free: [bool], bandLo: [int], bandHi: [int], bandOffset: [int]) > void {
    final at = zeros(pl.rankOf.len());
    foreach (row in pl.orders) {
        var k = 0;
        foreach (item in row) {
            at[item] = k;
            k = k + 1;
        }
    }
    final longs: mut [int] = mut [<int>];
    var li = 0;
    while (li < pl.chains.len()) {
        if (pl.chains[li].len() > 2) { longs.append(li); }
        li = li + 1;
    }
    longs.sort(fun (x: int, y: int) > bool {
        if (pl.chains[x].len() != pl.chains[y].len()) { return pl.chains[x].len() > pl.chains[y].len(); }
        return x < y;
    });
    foreach (edge in longs) {
        final chain = pl.chains[edge];
        final last = chain.len() - 1;
        final tries: mut [int] = mut [pos[chain[0]], pos[chain[last]]];
        var k = 1;
        while (k < last) {
            tries.append(pos[chain[k]]);
            k = k + 1;
        }
        var settled = false;
        foreach (v in tries) {
            var fits = settled == false;
            k = 1;
            while (k < last and fits) {
                final d = chain[k];
                final row = pl.orders[pl.rankOf[d]];
                final i = at[d];
                if (i > 0 and v < pos[row[i - 1]] + gapsOf([row[i - 1], d], pc: pc, nodeCount: pl.nodeCount)[0]) { fits = false; }
                if (i + 1 < row.len() and v > pos[row[i + 1]] - gapsOf([d, row[i + 1]], pc: pc, nodeCount: pl.nodeCount)[0]) { fits = false; }
                final b = pl.bandOf[d];
                if (free[pl.rankOf[d]] == false and (v < bandLo[b] + bandOffset[b] or v > bandHi[b] + bandOffset[b])) { fits = false; }
                k = k + 1;
            }
            if (fits) {
                k = 1;
                while (k < last) {
                    pos[chain[k]] = v;
                    k = k + 1;
                }
                settled = true;
            }
        }
    }
}

// place turns a plan into coordinates. Everything is computed on two axes: main runs along
// the ranks and cross along the rows, and down() only swaps which of x and y each one is.
// A cross coordinate is a midline. Each band is aligned on its own and the bands stacked in
// order; the ranks no zone reaches are aligned last, against everything. What the geometry
// itself refuses, a fan too wide for its box or a row() it cannot line up, lands in found.
// widen[g] is room added to gap g beyond what its channels need.
fun place(f: Flow, pl: Plan, found: mut [str], widen: [int]) > Diagram {
    final lr = f.topDown == false;
    final nn = pl.nodeCount;
    final ne = pl.fromItem.len();
    final nz = f.zones.len();
    final items = pl.rankOf.len();
    var nodeH = LayerNodeH;
    foreach (n in f.nodes) {
        if (n.tag != "" and n.sub != "") { nodeH = TallNodeH; }
    }
    final isDecision: mut [bool] = mut [<bool>];
    var item = 0;
    while (item < items) {
        isDecision.append(item < nn and f.nodes[item].role == Role.decision.value);
        item = item + 1;
    }

    // A rank no zone reaches has no band to sit in: it is placed against its neighbours
    // across the whole figure rather than stacking after the last band, the way a lone
    // source feeding two zones sits between them. A rank a zone's box spans is reached even
    // with no member in it, or a box placed there would land inside a zone it is not part of.
    final zoneLo = zeros(nz);
    final zoneHi = zeros(nz);
    var zi = 0;
    while (zi < nz) {
        zoneLo[zi] = pl.maxRank + 1;
        zoneHi[zi] = 0 - 1;
        zi = zi + 1;
    }
    var ni = 0;
    while (ni < nn) {
        final b = pl.bandOf[ni];
        if (b < nz and pl.inZone[ni]) {
            if (pl.rankOf[ni] < zoneLo[b]) { zoneLo[b] = pl.rankOf[ni]; }
            if (pl.rankOf[ni] > zoneHi[b]) { zoneHi[b] = pl.rankOf[ni]; }
        }
        ni = ni + 1;
    }
    final free: mut [bool] = mut [<bool>];
    var zr = 0;
    while (zr <= pl.maxRank) {
        var open = nz > 0;
        foreach (x in pl.orders[zr]) {
            if (pl.bandOf[x] < nz) { open = false; }
        }
        zi = 0;
        while (zi < nz) {
            if (zoneLo[zi] < zr and zr < zoneHi[zi]) { open = false; }
            zi = zi + 1;
        }
        free.append(open);
        zr = zr + 1;
    }

    // Each connector's declared ends and the faces they attach to. A back edge takes the
    // side of the figure where more of its ends are outermost in their ranks; an end that
    // is outermost leaves across the flow, straight to the lane, and one that is not steps
    // back through its gap first.
    final srcOf = zeros(ne);
    final dstOf = zeros(ne);
    final srcFace = zeros(ne);
    final dstFace = zeros(ne);
    final laneSide = zeros(ne);
    final laneBand = zeros(ne);
    final laneChan = zeros(ne);
    final backs: mut [int] = mut [<int>];
    var li = 0;
    while (li < ne) {
        srcOf[li] = pl.fromItem[li];
        dstOf[li] = pl.toItem[li];
        srcFace[li] = FaceOut;
        dstFace[li] = FaceIn;
        if (pl.reversed[li]) {
            final s = pl.toItem[li];
            final d = pl.fromItem[li];
            srcOf[li] = s;
            dstOf[li] = d;
            backs.append(li);
            final rowS = pl.orders[pl.rankOf[s]];
            final rowD = pl.orders[pl.rankOf[d]];
            var before = 0;
            var after = 0;
            if (rowS[0] == s) { before = before + 1; }
            if (rowD[0] == d) { before = before + 1; }
            if (rowS[rowS.len() - 1] == s) { after = after + 1; }
            if (rowD[rowD.len() - 1] == d) { after = after + 1; }
            var side = 1;
            var sideFace = FaceAfter;
            var sOut = rowS[rowS.len() - 1] == s;
            var dOut = rowD[rowD.len() - 1] == d;
            if (before >= after) {
                side = 0 - 1;
                sideFace = FaceBefore;
                sOut = rowS[0] == s;
                dOut = rowD[0] == d;
            }
            laneSide[li] = side;
            srcFace[li] = FaceIn;
            dstFace[li] = FaceOut;
            if (sOut) { srcFace[li] = sideFace; }
            if (dOut) { dstFace[li] = sideFace; }
            // The lane runs inside the ends' band when nothing of another band lies between
            // it and them in any rank it passes; otherwise outside the whole figure.
            final band = pl.bandOf[s];
            var owned = pl.bandOf[d] == band;
            var r = pl.rankOf[d];
            while (r <= pl.rankOf[s]) {
                if (free[r]) { owned = false; }
                foreach (x in pl.orders[r]) {
                    if (side < 0 and pl.stackOf[pl.bandOf[x]] < pl.stackOf[band]) { owned = false; }
                    if (side > 0 and pl.stackOf[pl.bandOf[x]] > pl.stackOf[band]) { owned = false; }
                }
                r = r + 1;
            }
            laneBand[li] = 0 - 1;
            if (owned) { laneBand[li] = band; }
        }
        li = li + 1;
    }
    // Lanes nest: the shorter back edge runs nearer the boxes, and two that share ranks
    // never share a lane.
    final spanOf = fun (x: int) > int { return pl.rankOf[srcOf[x]] - pl.rankOf[dstOf[x]]; };
    backs.sort(fun (x: int, y: int) > bool {
        if (spanOf(x) != spanOf(y)) { return spanOf(x) < spanOf(y); }
        return x < y;
    });
    var bi = 0;
    while (bi < backs.len()) {
        final x = backs[bi];
        var bj = 0;
        while (bj < bi) {
            final y = backs[bj];
            final shared = laneBand[x] == laneBand[y] and laneSide[x] == laneSide[y]
                and pl.rankOf[dstOf[x]] <= pl.rankOf[srcOf[y]] and pl.rankOf[dstOf[y]] <= pl.rankOf[srcOf[x]];
            if (shared and laneChan[y] + 1 > laneChan[x]) { laneChan[x] = laneChan[y] + 1; }
            bj = bj + 1;
        }
        bi = bi + 1;
    }
    final padBefore = zeros(pl.bandCount);
    final padAfter = zeros(pl.bandCount);
    foreach (x in backs) {
        final b = laneBand[x];
        final room = FaceClear + laneChan[x] * Pitch;
        if (b >= 0 and laneSide[x] < 0 and room > padBefore[b]) { padBefore[b] = room; }
        if (b >= 0 and laneSide[x] > 0 and room > padAfter[b]) { padAfter[b] = room; }
    }

    // A box grows across the flow to seat its own widest fan on the lattice, and no other
    // box grows with it. A diamond's vertices take one connector each, so it never fans.
    final faceCount = zeros(nn * 4);
    li = 0;
    while (li < ne) {
        faceCount[srcOf[li] * 4 + srcFace[li]] = faceCount[srcOf[li] * 4 + srcFace[li]] + 1;
        faceCount[dstOf[li] * 4 + dstFace[li]] = faceCount[dstOf[li] * 4 + dstFace[li]] + 1;
        li = li + 1;
    }
    var crossBase = nodeH;
    if (lr == false) { crossBase = LayerNodeW; }
    final half = zeros(items);
    ni = 0;
    while (ni < nn) {
        var size = crossBase;
        foreach (face in [FaceOut, FaceIn]) {
            final n = faceCount[ni * 4 + face];
            if (isDecision[ni] == false) { size = imax(size, b: fanRoom(n)); }
            if (isDecision[ni] == false and f.isGenerated == false and fanRoom(n) > crossBase * MaxFanGrowth) {
                found.append("node {quote(f.nodes[ni].id)} fans {n} connectors on one side; split the figure or add order([...])");
            }
        }
        half[ni] = size / 2;
        ni = ni + 1;
    }
    if (found.len() > 0) { return Diagram{}; }
    var mainSize = LayerNodeW;
    var mainStart = Margin;
    var crossStart = LayerTop;
    var crossLabelPad = ZoneLabelPad;
    var mainLabelPad = ZonePad;
    var sideNames = ["right", "left", "top", "bottom"];
    if (lr == false) {
        mainSize = nodeH;
        mainStart = LayerTop;
        crossStart = Margin;
        crossLabelPad = ZonePad;
        mainLabelPad = ZoneLabelPad;
        sideNames = ["bottom", "top", "left", "right"];
    }

    final idx: mut {str: int} = mut {<str: int>};
    ni = 0;
    while (ni < nn) {
        if (idx[f.nodes[ni].id] == null) { idx[f.nodes[ni].id] = ni; }
        ni = ni + 1;
    }
    final leader = zeros(items);
    final member: mut [bool] = mut [<bool>];
    item = 0;
    while (item < items) {
        leader[item] = 0 - 1;
        member.append(false);
        item = item + 1;
    }
    // A row() group's leader is its member in the earliest rank; the rest follow its midline.
    final lined = groupsOf(nn, sets: f.rows, idx: idx);
    final rowIds: mut {int: mut [str]} = mut {<int: mut [str]>};
    ni = 0;
    while (ni < nn) {
        final root = lined.find(ni);
        if (rowIds[root] == null) { rowIds[root] = mut [<str>]; }
        rowIds[root]!.append(f.nodes[ni].id);
        ni = ni + 1;
    }
    ni = 0;
    while (ni < nn) {
        final root = lined.find(ni);
        if (rowIds[root]!.len() > 1) {
            member[ni] = true;
            var lead = ni;
            var m = 0;
            while (m < nn) {
                if (lined.find(m) == root and pl.rankOf[m] < pl.rankOf[lead]) { lead = m; }
                m = m + 1;
            }
            if (lead != ni) { leader[ni] = lead; }
        }
        ni = ni + 1;
    }
    final pc = Placer{ half = half, decision = isDecision, leader = leader, member = member };

    final pos = zeros(items);
    var r = 0;
    while (r <= pl.maxRank) {
        if (free[r] == false) { pack(pl.orders[r], pos: pos, pl: pl, pc: pc, whole: false, start: 0); }
        r = r + 1;
    }
    alignRanks(pl, pos: pos, pc: pc, free: free, phaseTwo: false);

    // Bands stack in stackOf order, each as tall as its aligned content: a zone's label
    // pad, the lanes of the back edges it owns, its content, its bottom pad, a row gap.
    final bandLo = zeros(pl.bandCount);
    final bandHi = zeros(pl.bandCount);
    final hasBand: mut [bool] = mut [<bool>];
    var b = 0;
    while (b < pl.bandCount) {
        bandLo[b] = Far;
        bandHi[b] = 0 - Far;
        hasBand.append(false);
        b = b + 1;
    }
    item = 0;
    while (item < items) {
        if (free[pl.rankOf[item]] == false) {
            final bb = pl.bandOf[item];
            hasBand[bb] = true;
            bandLo[bb] = imin(bandLo[bb], b: pos[item] - half[item]);
            bandHi[bb] = imax(bandHi[bb], b: pos[item] + half[item]);
        }
        item = item + 1;
    }
    final bandOffset = zeros(pl.bandCount);
    final boxLo = zeros(pl.bandCount);
    final boxHi = zeros(pl.bandCount);
    final stacked = zeros(pl.bandCount);
    b = 0;
    while (b < pl.bandCount) {
        stacked[pl.stackOf[b]] = b;
        b = b + 1;
    }
    var cursor = crossStart;
    foreach (sk in stacked) {
        if (hasBand[sk]) {
            final zoned = sk < nz;
            boxLo[sk] = cursor;
            if (zoned) { cursor = cursor + crossLabelPad; }
            cursor = cursor + padBefore[sk];
            bandOffset[sk] = cursor - bandLo[sk];
            cursor = cursor + bandHi[sk] - bandLo[sk] + padAfter[sk];
            if (zoned) { cursor = cursor + ZonePad; }
            boxHi[sk] = cursor;
            cursor = cursor + LayerRowGap;
        }
    }
    item = 0;
    while (item < items) {
        if (free[pl.rankOf[item]] == false) { pos[item] = pos[item] + bandOffset[pl.bandOf[item]]; }
        item = item + 1;
    }
    r = 0;
    while (r <= pl.maxRank) {
        if (free[r]) { pack(pl.orders[r], pos: pos, pl: pl, pc: pc, whole: true, start: crossStart); }
        r = r + 1;
    }
    alignRanks(pl, pos: pos, pc: pc, free: free, phaseTwo: true);
    straightenLanes(pl, pos: pos, pc: pc, free: free, bandLo: bandLo, bandHi: bandHi, bandOffset: bandOffset);

    ni = 0;
    while (ni < nn) {
        final lead = leader[ni];
        if (lead >= 0 and pos[ni] != pos[lead]) {
            found.append("{call("row", ids: rowIds[lined.find(ni)]!)} cannot line {quote(f.nodes[ni].id)} up with {quote(f.nodes[lead].id)}; another box, row() or order() holds that line, so drop one of them or split the figure");
        }
        ni = ni + 1;
    }
    if (found.len() > 0) { return Diagram{}; }

    // Lanes: a band's inside its pad, the figure's outside everything. Then everything moves
    // so the outermost of it starts at the top margin.
    var low = Far;
    var high = 0 - Far;
    item = 0;
    while (item < items) {
        low = imin(low, b: pos[item] - half[item]);
        high = imax(high, b: pos[item] + half[item]);
        item = item + 1;
    }
    b = 0;
    while (b < pl.bandCount) {
        if (hasBand[b]) {
            low = imin(low, b: boxLo[b]);
            high = imax(high, b: boxHi[b]);
        }
        b = b + 1;
    }
    final laneLine = zeros(ne);
    var edgeLow = low;
    var edgeHigh = high;
    foreach (x in backs) {
        final bb = laneBand[x];
        if (bb >= 0 and laneSide[x] < 0) { laneLine[x] = bandLo[bb] + bandOffset[bb] - FaceClear - laneChan[x] * Pitch; }
        if (bb >= 0 and laneSide[x] > 0) { laneLine[x] = bandHi[bb] + bandOffset[bb] + FaceClear + laneChan[x] * Pitch; }
        if (bb < 0 and laneSide[x] < 0) {
            laneLine[x] = low - FaceClear - laneChan[x] * Pitch;
            edgeLow = imin(edgeLow, b: laneLine[x]);
        }
        if (bb < 0 and laneSide[x] > 0) {
            laneLine[x] = high + FaceClear + laneChan[x] * Pitch;
            edgeHigh = imax(edgeHigh, b: laneLine[x]);
        }
    }
    final shift = crossStart - edgeLow;
    item = 0;
    while (item < items) {
        pos[item] = pos[item] + shift;
        item = item + 1;
    }
    b = 0;
    while (b < pl.bandCount) {
        boxLo[b] = boxLo[b] + shift;
        boxHi[b] = boxHi[b] + shift;
        b = b + 1;
    }
    foreach (x in backs) { laneLine[x] = laneLine[x] + shift; }
    final crossEnd = edgeHigh + shift;

    // A diamond touches its box only at the four vertices, so a decision never fans: the
    // one connector entering it takes the inbound vertex, and up to three leaving take the
    // outbound vertex and the two across the flow. The exit whose next step sits on the
    // decision's own midline takes the outbound vertex and runs straight; the rest take the
    // vertex on their own side. When two of three share a side, one of them has to wrap
    // around the diamond, and wrapping the straight one is the only choice that crosses
    // nothing, so there the exits take the vertices in cross order.
    final outsOf = lists(nn);
    li = 0;
    while (li < ne) {
        if (pl.reversed[li] == false) { outsOf[pl.fromItem[li]].append(li); }
        li = li + 1;
    }
    final byNext = fun (x: int, y: int) > bool {
        final cx = pos[pl.chains[x][1]];
        final cy = pos[pl.chains[y][1]];
        if (cx != cy) { return cx < cy; }
        return x < y;
    };
    ni = 0;
    while (ni < nn) {
        final outs = outsOf[ni];
        if (isDecision[ni] and outs.len() <= 3 and outs.len() > 1) {
            outs.sort(byNext);
            var straight = 0 - 1;
            var before = 0;
            var after = 0;
            foreach (x in outs) {
                final next = pos[pl.chains[x][1]];
                if (next == pos[ni] and straight < 0) {
                    straight = x;
                } else {
                    if (next < pos[ni]) { before = before + 1; } else { after = after + 1; }
                }
            }
            if (straight >= 0 and before <= 1 and after <= 1) {
                foreach (x in outs) {
                    if (x != straight and pos[pl.chains[x][1]] < pos[ni]) { srcFace[x] = FaceBefore; }
                    if (x != straight and pos[pl.chains[x][1]] >= pos[ni]) { srcFace[x] = FaceAfter; }
                }
            } else {
                if (outs.len() == 3) {
                    srcFace[outs[0]] = FaceBefore;
                    srcFace[outs[2]] = FaceAfter;
                }
                if (outs.len() == 2) {
                    if (pos[pl.chains[outs[0]][1]] < pos[ni]) {
                        srcFace[outs[0]] = FaceBefore;
                    } else {
                        srcFace[outs[1]] = FaceAfter;
                    }
                }
            }
        }
        ni = ni + 1;
    }

    // Port selection: a connector whose next step lies wholly beyond its source's cross
    // span, with nothing else in the source's rank between them, leaves across the flow and
    // turns once, where it meets that step's line, instead of climbing to a channel from the
    // forward face. A decision already chose its side vertex above and only learns here
    // whether that vertex turns directly. A box's side takes ports farthest first, so each
    // turn encloses the nearer ones, until its lattice along the main axis is full; what is
    // left stays in the forward fan and turns in the gap nearer the source than any port.
    final port: mut [bool] = mut [<bool>];
    li = 0;
    while (li < ne) {
        port.append(false);
        li = li + 1;
    }
    final mainRoom = (mainSize / 2 - Pitch) / Pitch;
    final portFace = fun (x: int) > int {
        final chain = pl.chains[x];
        final s = chain[0];
        final t = chain[1];
        var need = 0;
        if (t >= nn) { need = Pitch; }
        var face = 0 - 1;
        var lo = 0;
        var hi = 0;
        if (pos[t] + half[t] + need <= pos[s] - half[s]) {
            face = FaceBefore;
            lo = pos[t] - half[t] - Pitch;
            hi = pos[s] - half[s];
        }
        if (pos[t] - half[t] - need >= pos[s] + half[s]) {
            face = FaceAfter;
            lo = pos[s] + half[s];
            hi = pos[t] + half[t] + Pitch;
        }
        if (face < 0) { return face; }
        foreach (other in pl.orders[pl.rankOf[s]]) {
            if (other != s and pos[other] - half[other] < hi and pos[other] + half[other] > lo) { return 0 - 1; }
        }
        // A zone border across the column would put the turn outside the source's band,
        // through a zone it is no part of and often through that zone's label.
        var zb = 0;
        while (zb < nz) {
            if (hasBand[zb] and zoneLo[zb] <= pl.rankOf[s] and pl.rankOf[s] <= zoneHi[zb]) {
                if ((boxLo[zb] > lo and boxLo[zb] < hi) or (boxHi[zb] > lo and boxHi[zb] < hi)) { return 0 - 1; }
            }
            zb = zb + 1;
        }
        return face;
    };
    final portsOf = lists(nn * 4);
    li = 0;
    while (li < ne) {
        final s = pl.fromItem[li];
        if (pl.reversed[li] == false) {
            final face = portFace(li);
            if (isDecision[s] and face >= 0 and face == srcFace[li]) { port[li] = true; }
            if (isDecision[s] == false and face >= 0) { portsOf[s * 4 + face].append(li); }
        }
        li = li + 1;
    }
    var pf = 0;
    while (pf < nn * 4) {
        final cands = portsOf[pf];
        final v = pf / 4;
        cands.sort(fun (x: int, y: int) > bool {
            final dx = iabs(pos[pl.chains[x][1]] - pos[v]);
            final dy = iabs(pos[pl.chains[y][1]] - pos[v]);
            if (dx != dy) { return dx > dy; }
            return x < y;
        });
        var taken = faceCount[pf];
        foreach (x in cands) {
            if (taken < 2 * mainRoom + 1) {
                port[x] = true;
                srcFace[x] = pf % 4;
                taken = taken + 1;
            }
        }
        pf = pf + 1;
    }

    // Slots, per face, ordered by where the far end sits so no fan crosses itself at the
    // box. An edge to a neighbour on the same row takes the midline and the rest of the fan
    // steps out from it a Pitch at a time; when that lattice would overflow the box the fan
    // sits symmetric about the midline instead. A side face runs its lattice along the main
    // axis: back-edge ends first, since their lanes run backward, then ports from the
    // farthest, which takes the midline, to the nearest, nearest the forward face.
    final faceEnds = lists(nn * 4);
    li = 0;
    while (li < ne) {
        faceEnds[srcOf[li] * 4 + srcFace[li]].append(li * 2 + 1);
        faceEnds[dstOf[li] * 4 + dstFace[li]].append(li * 2);
        li = li + 1;
    }
    final srcSlot = zeros(ne);
    final srcSlots = zeros(ne);
    final srcOff = zeros(ne);
    final dstSlot = zeros(ne);
    final dstSlots = zeros(ne);
    final dstOff = zeros(ne);
    final farOf = fun (end: int) > int {
        final chain = pl.chains[end / 2];
        if (end % 2 == 1) { return chain[1]; }
        return chain[chain.len() - 2];
    };
    final keyOf = fun (end: int) > int {
        final at = end / 2;
        if (pl.reversed[at]) {
            if (srcFace[at] == FaceBefore or srcFace[at] == FaceAfter or dstFace[at] == FaceBefore or dstFace[at] == FaceAfter) {
                if (end % 2 == 1) { return laneChan[at]; }
                return 0 - laneChan[at] - 1;
            }
            return laneSide[at] * Far;
        }
        if (end % 2 == 1 and port[at]) { return Far - iabs(pos[farOf(end)] - pos[srcOf[at]]); }
        return pos[farOf(end)];
    };
    var fi = 0;
    while (fi < nn * 4) {
        final ends = faceEnds[fi];
        final v = fi / 4;
        final face = fi % 4;
        final n = ends.len();
        if (n > 0) {
            ends.sort(fun (x: int, y: int) > bool {
                final kx = keyOf(x);
                final ky = keyOf(y);
                if (kx != ky) { return kx < ky; }
                return x < y;
            });
            var anchor = 0 - 1;
            var room = (half[v] - Pitch) / Pitch;
            if (isDecision[v] == false and (face == FaceOut or face == FaceIn)) {
                var k = 0;
                while (k < n) {
                    if (pl.reversed[ends[k] / 2] == false and pos[farOf(ends[k])] == pos[v]) { anchor = k; }
                    k = k + 1;
                }
            }
            if (isDecision[v] == false and (face == FaceBefore or face == FaceAfter)) {
                room = mainRoom;
                var k = n - 1;
                while (k >= 0) {
                    if (ends[k] % 2 == 1 and port[ends[k] / 2]) { anchor = k; }
                    k = k - 1;
                }
            }
            // In Pitch steps from the midline, where the first end sits. A fan whose anchored
            // lattice would run past the box slides back inside it a whole step at a time,
            // so the anchored end jogs by a Pitch rather than by a sliver.
            var first = 0 - anchor;
            if (anchor >= 0) {
                if (first + n - 1 > room) { first = room - n + 1; }
                if (first < 0 - room) { first = 0 - room; }
                if (first + n - 1 > room) { anchor = 0 - 1; }
            }
            final reach = imax(iabs(first), b: iabs(first + n - 1));
            var k = 0;
            while (k < n) {
                final end = ends[k];
                final at = end / 2;
                var slot = k + 1;
                var slots = n;
                if (anchor >= 0) {
                    slot = reach + 1 + first + k;
                    slots = 2 * reach + 1;
                }
                if (isDecision[v]) {
                    slot = 1;
                    slots = 1;
                }
                final off = latticeOffset(slot, slots: slots, pitch: Pitch);
                if (end % 2 == 1) {
                    srcSlot[at] = slot;
                    srcSlots[at] = slots;
                    srcOff[at] = off;
                } else {
                    dstSlot[at] = slot;
                    dstSlots[at] = slots;
                    dstOff[at] = off;
                }
                k = k + 1;
            }
        }
        fi = fi + 1;
    }

    // Every rank-to-rank hop that changes row turns in a channel of its gap. A back edge's
    // end that steps back through a gap turns there too, between its box and its lane.
    final hopGap: mut [int] = mut [<int>];
    final hopIn: mut [int] = mut [<int>];
    final hopOut: mut [int] = mut [<int>];
    final hopBack: mut [bool] = mut [<bool>];
    final hopFirst = zeros(ne);
    final hopS = zeros(ne);
    final hopD = zeros(ne);
    li = 0;
    while (li < ne) {
        final chain = pl.chains[li];
        hopFirst[li] = hopGap.len();
        hopS[li] = 0 - 1;
        hopD[li] = 0 - 1;
        if (pl.reversed[li]) {
            final s = srcOf[li];
            final d = dstOf[li];
            if (srcFace[li] == FaceIn) {
                hopS[li] = hopGap.len();
                hopGap.append(pl.rankOf[s] - 1);
                hopIn.append(pos[s] + srcOff[li]);
                hopOut.append(laneLine[li]);
                hopBack.append(true);
            }
            if (dstFace[li] == FaceOut) {
                hopD[li] = hopGap.len();
                hopGap.append(pl.rankOf[d]);
                hopIn.append(laneLine[li]);
                hopOut.append(pos[d] + dstOff[li]);
                hopBack.append(true);
            }
        } else {
            final last = chain.len() - 1;
            var s = 0;
            while (s < last) {
                var yIn = pos[chain[s]];
                if (s == 0) { yIn = pos[chain[0]] + srcOff[li]; }
                // A vertex across the flow steps into the row gap beside its box before
                // turning, the one run in a rank no box and no lane uses.
                if (s == 0 and srcFace[li] == FaceBefore) { yIn = pos[chain[0]] - half[chain[0]] - LayerRowGap / 2; }
                if (s == 0 and srcFace[li] == FaceAfter) { yIn = pos[chain[0]] + half[chain[0]] + LayerRowGap / 2; }
                var yOut = pos[chain[s + 1]];
                if (s + 1 == last) { yOut = pos[chain[last]] + dstOff[li]; }
                // A port turned inside its source's rank already, so its first hop is level.
                if (s == 0 and port[li]) { yIn = yOut; }
                hopGap.append(pl.rankOf[chain[s]]);
                hopIn.append(yIn);
                hopOut.append(yOut);
                hopBack.append(false);
                s = s + 1;
            }
        }
        li = li + 1;
    }

    // Channels per gap. A hop climbing to a higher row turns closer to its source the
    // higher it climbs, and a descending one the lower it lands: that order keeps a run's
    // turn clear of every other run it passes. A hop leaving a row turns before one landing
    // on it, or the two would share that row's stroke. Hops whose spans keep a Pitch apart
    // share a channel; the channels then sit a Pitch apart, symmetric about the gap's centre.
    final byTurn = fun (x: int, y: int) > bool {
        final upX = hopOut[x] < hopIn[x];
        final upY = hopOut[y] < hopIn[y];
        if (upX != upY) { return upX; }
        if (hopOut[x] != hopOut[y]) {
            if (upX) { return hopOut[x] < hopOut[y]; }
            return hopOut[x] > hopOut[y];
        }
        return x < y;
    };
    final hopChan = zeros(hopGap.len());
    final hopMain = zeros(hopGap.len());
    final chanCount = zeros(pl.maxRank + 1);
    var gap = 0;
    while (gap < pl.maxRank) {
        final ahead: mut [int] = mut [<int>];
        final behind: mut [int] = mut [<int>];
        var h = 0;
        while (h < hopGap.len()) {
            if (hopGap[h] == gap and hopIn[h] != hopOut[h]) {
                if (hopBack[h]) {
                    behind.append(h);
                } else {
                    ahead.append(h);
                }
            }
            h = h + 1;
        }
        ahead.sort(byTurn);
        behind.sort(byTurn);
        var turning: mut [int] = mut [<int>];
        foreach (x in ahead) { turning.append(x); }
        foreach (x in behind) { turning.append(x); }
        var tries = 0;
        var moved = true;
        while (moved and tries <= turning.len() * turning.len()) {
            moved = false;
            var i = 0;
            while (i < turning.len() and moved == false) {
                var j = i + 1;
                while (j < turning.len() and moved == false) {
                    if (hopOut[turning[i]] == hopIn[turning[j]]) {
                        final next: mut [int] = mut [<int>];
                        var k = 0;
                        while (k < turning.len()) {
                            if (k == i) { next.append(turning[j]); }
                            if (k != j) { next.append(turning[k]); }
                            k = k + 1;
                        }
                        turning = next;
                        moved = true;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            tries = tries + 1;
        }
        var count = 0;
        var p = 0;
        while (p < turning.len()) {
            final x = turning[p];
            final loX = imin(hopIn[x], b: hopOut[x]);
            final hiX = imax(hopIn[x], b: hopOut[x]);
            var q = 0;
            while (q < p) {
                final y = turning[q];
                final loY = imin(hopIn[y], b: hopOut[y]);
                final hiY = imax(hopIn[y], b: hopOut[y]);
                final apart = hiY + Pitch <= loX or hiX + Pitch <= loY;
                if (apart == false and hopChan[y] + 1 > hopChan[x]) { hopChan[x] = hopChan[y] + 1; }
                q = q + 1;
            }
            if (hopChan[x] + 1 > count) { count = hopChan[x] + 1; }
            p = p + 1;
        }
        chanCount[gap] = count;
        gap = gap + 1;
    }
    final rankMain = zeros(pl.maxRank + 1);
    rankMain[0] = mainStart;
    gap = 0;
    while (gap < pl.maxRank) {
        rankMain[gap + 1] = rankMain[gap] + mainSize + gapFor(chanCount[gap]) + widen[gap];
        gap = gap + 1;
    }
    var h = 0;
    while (h < hopGap.len()) {
        final g = hopGap[h];
        final centre = rankMain[g] + mainSize + (gapFor(chanCount[g]) + widen[g]) / 2;
        if (hopIn[h] != hopOut[h]) { hopMain[h] = centre + latticeOffset(hopChan[h] + 1, slots: chanCount[g], pitch: Pitch); }
        h = h + 1;
    }

    final nodes: mut [Node] = mut [<Node>];
    ni = 0;
    while (ni < nn) {
        final n = f.nodes[ni];
        var x = rankMain[pl.rankOf[ni]];
        var y = pos[ni] - half[ni];
        var boxW = mainSize;
        var boxH = 2 * half[ni];
        if (lr == false) {
            x = pos[ni] - half[ni];
            y = rankMain[pl.rankOf[ni]];
            boxW = 2 * half[ni];
            boxH = mainSize;
        }
        nodes.append(Node{
            id = n.id, label = n.label, sub = n.sub, tag = n.tag, role = n.role, anchor = n.anchor, line = n.line, link = n.link,
            x = x, y = y, w = boxW, h = boxH,
        });
        ni = ni + 1;
    }

    final edges: mut [Edge] = mut [<Edge>];
    li = 0;
    while (li < ne) {
        final e = f.edges[li];
        // Corners as main, cross pairs, transposed for down() as they are emitted.
        final pts: mut [int] = mut [<int>];
        var bend = 0;
        if (pl.reversed[li]) {
            final s = srcOf[li];
            final d = dstOf[li];
            final line = laneLine[li];
            if (srcFace[li] == FaceIn) {
                final hs = hopS[li];
                pts.append(hopMain[hs]);
                pts.append(hopIn[hs]);
                pts.append(hopMain[hs]);
                pts.append(line);
            } else {
                pts.append(rankMain[pl.rankOf[s]] + mainSize / 2 + srcOff[li]);
                pts.append(line);
            }
            if (dstFace[li] == FaceOut) {
                final hd = hopD[li];
                pts.append(hopMain[hd]);
                pts.append(line);
                pts.append(hopMain[hd]);
                pts.append(hopOut[hd]);
            } else {
                pts.append(rankMain[pl.rankOf[d]] + mainSize / 2 + dstOff[li]);
                pts.append(line);
            }
        } else {
            final hops = pl.chains[li].len() - 1;
            final exit = srcFace[li] != FaceOut;
            if (exit) {
                pts.append(rankMain[pl.rankOf[srcOf[li]]] + mainSize / 2 + srcOff[li]);
                pts.append(hopIn[hopFirst[li]]);
            }
            var s = 0;
            while (s < hops) {
                final hop = hopFirst[li] + s;
                if (hopIn[hop] != hopOut[hop]) {
                    pts.append(hopMain[hop]);
                    pts.append(hopIn[hop]);
                    pts.append(hopMain[hop]);
                    pts.append(hopOut[hop]);
                }
                s = s + 1;
            }
            if (hops == 1 and exit == false and pts.len() > 0) { bend = pts[0]; }
        }
        final via: mut [int] = mut [<int>];
        var k = 0;
        while (k + 1 < pts.len() and bend == 0) {
            if (lr) {
                via.append(pts[k]);
                via.append(pts[k + 1]);
            } else {
                via.append(pts[k + 1]);
                via.append(pts[k]);
            }
            k = k + 2;
        }
        edges.append(Edge{
            src = e.src, dst = e.dst, label = e.label, kind = e.kind, dashed = e.dashed or pl.reversed[li], claim = e.claim,
            srcSide = sideNames[srcFace[li]], dstSide = sideNames[dstFace[li]],
            srcSlot = srcSlot[li], srcSlots = srcSlots[li],
            dstSlot = dstSlot[li], dstSlots = dstSlots[li],
            bend = bend, via = via,
        });
        li = li + 1;
    }

    final zones: mut [Zone] = mut [<Zone>];
    var zk = 0;
    while (zk < nz) {
        var lo = 0 - 1;
        var hi = 0 - 1;
        ni = 0;
        while (ni < nn) {
            if (pl.bandOf[ni] == zk and pl.inZone[ni]) {
                final m = rankMain[pl.rankOf[ni]];
                if (lo < 0 or m < lo) { lo = m; }
                if (m > hi) { hi = m; }
            }
            ni = ni + 1;
        }
        if (lo >= 0) {
            final mainLo = lo - mainLabelPad;
            final mainHi = hi + mainSize + ZonePad;
            final band = f.zones[zk];
            final crossLo = boxLo[zk];
            final crossHi = boxHi[zk];
            if (lr) {
                zones.append(Zone{ label = band.label, boundary = band.boundary, x = mainLo, y = crossLo, w = mainHi - mainLo, h = crossHi - crossLo });
            } else {
                zones.append(Zone{ label = band.label, boundary = band.boundary, x = crossLo, y = mainLo, w = crossHi - crossLo, h = mainHi - mainLo });
            }
        }
        zk = zk + 1;
    }

    var mainEnd = rankMain[pl.maxRank] + mainSize;
    if (nz > 0) { mainEnd = mainEnd + ZonePad; }
    var bottom = Margin;
    if (f.legendItems.len() > 0) { bottom = LegendRoom; }
    var width = mainEnd + Margin;
    var height = crossEnd + bottom;
    if (lr == false) {
        width = crossEnd + Margin;
        height = mainEnd + bottom;
    }
    final titleW = snap(f.titleText.len() * TitleCharW) + 2 * Margin;
    if (titleW > width) { width = titleW; }
    final legendW = f.legendItems.len() * Style{}.legendPitch + 2 * Margin;
    if (legendW > width) { width = legendW; }

    return Diagram{
        id = f.id,
        generated = f.isGenerated,
        title = f.titleText,
        eyebrow = f.eyebrowText,
        desc = f.descText,
        width = width,
        height = height,
        zones = zones,
        nodes = nodes,
        edges = edges,
        legend = f.legendItems,
        scope = f.scopeGlobs,
        omits = f.omitted,
        stamp = f.stamp,
        unscoped = f.unscopedWhy,
        pitch = Pitch,
    };
}

// voiced puts the figure's id in front of every finding, one per line.
fun voiced(id: str, found: [str]) > str {
    final lines: mut [str] = mut [<str>];
    foreach (msg in found) { lines.append("flow {quote(id)}: {msg}"); }
    return lines.join("\n");
}

// layoutFindings restates what validate found in a placed figure. declarationFindings has
// already refused every fault a declaration can cause. Two connectors on one line are
// something a declaration can straighten; anything else is the layout's own, and an author
// can only report it.
fun layoutFindings(found: [Fault]) > [str] {
    final msgs: mut [str] = mut [<str>];
    foreach (fault in found) {
        final s = fault.subjects;
        if (fault.rule == "sameLine") {
            msgs.append("edges {quote(s[0])} -> {quote(s[1])} and {quote(s[2])} -> {quote(s[3])} run along one line; line their ends up with row([...]) or split the figure");
            continue;
        }
        if (fault.rule == "bend") {
            msgs.append("{edgeName(s[0], dst: s[1])} has a leg too short to bend; layout bug, report it");
            continue;
        }
        if (fault.rule == "label") {
            msgs.append("{edgeName(s[0], dst: s[1])} label has no spot clear of every stroke, box and label; shorten it or split the figure");
            continue;
        }
        msgs.append("{fault.text}; layout bug, report it");
    }
    return msgs;
}

fun layoutFlow(declared: Flow) > Diagram !> str {
    final f = compose(declared);
    final structural = compositionFindings(declared);
    foreach (msg in declarationFindings(f)) { structural.append(msg); }
    if (structural.len() > 0) { throw voiced(f.id, found: structural); }
    final pl = plan(f);
    final contradictions = constraintFindings(f, pl: pl);
    if (contradictions.len() > 0) { throw voiced(f.id, found: contradictions); }
    // A label with no spot clear of every stroke sits in a gap its channels crowd; each gap
    // the connector spans grows by WidenStep and the figure is placed again. Past MaxWiden
    // rounds the label is the author's finding.
    final widen = zeros(pl.maxRank + 1);
    var round = 0;
    while (round <= MaxWiden) {
        final found: mut [str] = mut [<str>];
        final d = place(f, pl: pl, found: found, widen: widen);
        if (found.len() > 0) { throw voiced(f.id, found: found); }
        final wrong = faults(d);
        var crowded = 0;
        foreach (fault in wrong) {
            if (fault.rule == "label") { crowded = crowded + 1; }
        }
        if (wrong.len() == 0) { return d; }
        if (crowded < wrong.len() or round == MaxWiden) { throw voiced(f.id, found: layoutFindings(wrong)); }
        foreach (fault in wrong) {
            var li = 0;
            while (li < f.edges.len()) {
                final e = f.edges[li];
                if (e.src == fault.subjects[0] and e.dst == fault.subjects[1]) {
                    final a = pl.rankOf[pl.fromItem[li]];
                    final b = pl.rankOf[pl.toItem[li]];
                    var g = imin(a, b: b);
                    while (g < imax(a, b: b)) {
                        widen[g] = widen[g] + WidenStep;
                        g = g + 1;
                    }
                }
                li = li + 1;
            }
        }
        round = round + 1;
    }
    return Diagram{};
}

fun nodeOf(d: Diagram, id: str) > Node {
    foreach (n in d.nodes) {
        if (n.id == id) { return n; }
    }
    return Node{};
}

fun sidePoint(n: Node, side: str, slot: int, slots: int) > [int] {
    final off = latticeOffset(slot, slots: slots, pitch: Pitch);
    final fx = n.x + n.w / 2 + off;
    final fy = n.y + n.h / 2 + off;
    if (side == "left") { return [n.x, fy]; }
    if (side == "right") { return [n.x + n.w, fy]; }
    if (side == "top") { return [fx, n.y]; }
    return [fx, n.y + n.h];
}

// edgeLegs rebuilds a connector's legs from its public fields the way the renderer draws
// them, so a test reasons about geometry without the renderer's private helpers.
fun edgeLegs(d: Diagram, e: Edge) > [[int]] {
    final s = sidePoint(nodeOf(d, id: e.src), side: e.srcSide, slot: e.srcSlot, slots: e.srcSlots);
    final t = sidePoint(nodeOf(d, id: e.dst), side: e.dstSide, slot: e.dstSlot, slots: e.dstSlots);
    final pts: mut [int] = mut [s[0], s[1]];
    foreach (v in e.via) { pts.append(v); }
    if (e.via.len() == 0 and e.bend != 0) {
        if (e.srcSide == "left" or e.srcSide == "right") {
            pts.append(e.bend);
            pts.append(s[1]);
            pts.append(e.bend);
            pts.append(t[1]);
        } else {
            pts.append(s[0]);
            pts.append(e.bend);
            pts.append(t[0]);
            pts.append(e.bend);
        }
    }
    pts.append(t[0]);
    pts.append(t[1]);
    final legs: mut [[int]] = mut [<[int]>];
    var k = 2;
    while (k + 1 < pts.len()) {
        legs.append([pts[k - 2], pts[k - 1], pts[k], pts[k + 1]]);
        k = k + 2;
    }
    return legs;
}

// legEntersBox reports a leg running through a box's interior. An attach point sits on the
// border, so a leg that only touches it does not count.
fun legEntersBox(leg: [int], n: Node) > bool {
    final x1 = imin(leg[0], b: leg[2]);
    final x2 = imax(leg[0], b: leg[2]);
    final y1 = imin(leg[1], b: leg[3]);
    final y2 = imax(leg[1], b: leg[3]);
    if (y1 == y2) {
        return n.y < y1 and y1 < n.y + n.h and imax(x1, b: n.x) < imin(x2, b: n.x + n.w);
    }
    return n.x < x1 and x1 < n.x + n.w and imax(y1, b: n.y) < imin(y2, b: n.y + n.h);
}

// fig is a test figure: laid out for its own sake, depicting no code.
fun fig(observed: Observed = Observed{}) > mut Flow {
    return flow("t", observed: observed).unscoped("a layout test");
}

fun diamond() > mut Flow {
    return fig().title("Diamond")
        .node("a").node("b").node("c").node("d")
        .edge("a", dst: "b").edge("a", dst: "c").edge("b", dst: "d").edge("c", dst: "d");
}

// serverHttpTwin is docs/site/diagrams/server-http.buzz declared as a flow: the same boxes,
// roles, anchors, connectors and legend, with every coordinate, slot and bend left out.
fun serverHttpTwin(observed: Observed = Observed{}) > mut Flow {
    return flow("server-http", observed: observed)
        .eyebrow("magus server")
        .title("The HTTP surface, and the one route without a guard")
        .desc("Agents and the console reach /mcp, the /api/v1 read views, the review and "
            + "plan routes and eleven typed Connect services through the DNS-rebind, "
            + "bearer-token and CORS guard. POST /api/v1/diff/session carries the human "
            + "half of a paired review and POST /api/v1/share opens the LAN listener; both "
            + "are loopback only. The health endpoints answer probes directly, with no "
            + "authentication.")
        .node("agent", label: "AI agents", sub: "Claude Code, IDE", tag: "client")
        .node("console", label: "Console PWA", sub: "dashboard, review", tag: "client")
        .node("probe", label: "kubelet", sub: "scripts, probes", tag: "client", role: Role.external)
        .node("guard", label: "Guard", sub: "rebind + token + CORS", tag: "gate", role: Role.focal, anchor: "internal/httpx")
        .node("mcp", label: "/mcp", sub: "agent tools, SSE", anchor: "internal/handler/mcp")
        .node("reads", label: "/api/v1 read views", sub: "graph, events, insight, outputs", anchor: "internal/handler/graph")
        .node("review", label: "/api/v1 review + plans", sub: "diff, session, plan, review", anchor: "internal/handler/status")
        .node("connect", label: "Connect RPC", sub: "eleven typed services", anchor: "internal/handler/metrics")
        .node("health", label: "/livez /readyz", sub: "no authentication", role: Role.external, anchor: "internal/server")
        .edge("agent", dst: "guard")
        .edge("console", dst: "guard")
        .edge("guard", dst: "mcp")
        .edge("guard", dst: "reads")
        .edge("guard", dst: "review")
        .edge("guard", dst: "connect")
        .edge("probe", dst: "health", label: "unguarded", role: EdgeRole.focal)
        .legend(Role.focal, label: "authenticated")
        .legend(Role.external, label: "open to any caller")
        .scope(["internal/handler/*", "internal/httpx", "internal/server"]);
}

// observedServerScope is magus\importGraph() over internal/handler/*, internal/httpx and
// internal/server on 09-29, declared the way docs/engine/page.buzz importFlow declares it.
fun observedServerScope() > mut Flow {
    final pkgs = [
        "internal/handler/activity", "internal/handler/attention", "internal/handler/diff",
        "internal/handler/graph", "internal/handler/insight", "internal/handler/job",
        "internal/handler/mcp", "internal/handler/memory", "internal/handler/metrics",
        "internal/handler/notes", "internal/handler/plan", "internal/handler/status",
        "internal/handler/token", "internal/handler/tool", "internal/handler/trailrpc",
        "internal/handler/viewer", "internal/httpx", "internal/server",
    ];
    final imports = [
        ["internal/handler/graph", "internal/httpx"],
        ["internal/handler/viewer", "internal/httpx"],
        ["internal/server", "internal/handler/activity"],
        ["internal/server", "internal/handler/attention"],
        ["internal/server", "internal/handler/diff"],
        ["internal/server", "internal/handler/graph"],
        ["internal/server", "internal/handler/insight"],
        ["internal/server", "internal/handler/job"],
        ["internal/server", "internal/handler/mcp"],
        ["internal/server", "internal/handler/memory"],
        ["internal/server", "internal/handler/metrics"],
        ["internal/server", "internal/handler/notes"],
        ["internal/server", "internal/handler/plan"],
        ["internal/server", "internal/handler/status"],
        ["internal/server", "internal/handler/token"],
        ["internal/server", "internal/handler/tool"],
        ["internal/server", "internal/handler/trailrpc"],
        ["internal/server", "internal/handler/viewer"],
        ["internal/server", "internal/httpx"],
    ];
    final f = flow("observed-server").title("internal/server and its handlers, as imported")
        .scope(["internal/handler/*", "internal/httpx", "internal/server"]);
    foreach (p in pkgs) { f.node("pkg-" + p.replace("/", with: "-"), label: p, anchor: p); }
    foreach (pair in imports) {
        f.edge("pkg-" + pair[0].replace("/", with: "-"), dst: "pkg-" + pair[1].replace("/", with: "-"), claim: Claim.imports);
    }
    return f;
}

test "a chain ranks into one column per step" {
    final d = fig().node("a").node("b").node("c").edge("a", dst: "b").edge("b", dst: "c").diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "the layout is sound");
    std\assert(nodeOf(d, id: "a").x < nodeOf(d, id: "b").x, message: "b sits right of a");
    std\assert(nodeOf(d, id: "b").x < nodeOf(d, id: "c").x, message: "c sits right of b");
    std\assert(nodeOf(d, id: "a").y == nodeOf(d, id: "c").y, message: "a chain runs straight");
}

test "a diamond lays out without a crossing" {
    final d = diamond().diagram() catch Diagram{};
    std\assert(d.nodes.len() == 4, message: "laid out");
    std\assert(nodeOf(d, id: "b").x == nodeOf(d, id: "c").x, message: "b and c share a rank");
    std\assert(crossings(d).len() == 0, message: "no two connectors cross");
}

test "an edge spanning three ranks routes around every box" {
    final d = fig()
        .node("a").node("b").node("c").node("d")
        .edge("a", dst: "b").edge("b", dst: "c").edge("c", dst: "d").edge("a", dst: "d")
        .diagram() catch Diagram{};
    std\assert(d.edges.len() == 4, message: "laid out");
    final long = d.edges[3];
    std\assert(long.via.len() > 0, message: "the long edge carries a via route");
    foreach (leg in edgeLegs(d, e: long)) {
        foreach (n in d.nodes) {
            std\assert(legEntersBox(leg, n: n) == false, message: "leg {leg} runs through {n.id}");
        }
    }
    std\assert(crossings(d).len() == 0, message: "and crosses nothing");
}

test "a cycle renders with one dashed reversed edge" {
    final f = fig().node("a").node("b").node("c")
        .edge("a", dst: "b").edge("b", dst: "c").edge("c", dst: "a");
    final d = f.diagram() catch Diagram{};
    var dashed = 0;
    foreach (e in d.edges) {
        if (e.dashed) { dashed = dashed + 1; }
    }
    std\assert(dashed == 1, message: "exactly the back edge is dashed");
    std\assert(d.edges[2].dashed and d.edges[2].src == "c" and d.edges[2].dst == "a", message: "drawn as declared");
    final svg = f.svg(lightPalette()) catch "threw";
    std\assert(svg != "threw", message: "and it renders");
}

test "a zone keeps its members contiguous" {
    final d = fig()
        .node("a").node("b").node("c").node("d")
        .edge("a", dst: "b").edge("a", dst: "c").edge("a", dst: "d")
        .zone("pair", members: ["b", "d"])
        .diagram() catch Diagram{};
    final b = nodeOf(d, id: "b");
    final c = nodeOf(d, id: "c");
    final dd = nodeOf(d, id: "d");
    std\assert(c.y > b.y and c.y > dd.y, message: "the unzoned node sits after the band");
    std\assert(d.zones.len() == 1, message: "one band drawn");
    final z = d.zones[0];
    std\assert(z.y <= b.y and z.y <= dd.y and z.y + z.h >= b.y + b.h and z.y + z.h >= dd.y + dd.h,
        message: "the band holds its members");
    std\assert(z.y + z.h <= c.y, message: "and not the outsider");
}

test "the same declarations render the same bytes" {
    final one = serverHttpTwin().svg(lightPalette()) catch "one threw";
    final two = serverHttpTwin().svg(lightPalette()) catch "two threw";
    std\assert(one == two, message: "deterministic");
    std\assert(one.startsWith("<svg"), message: "and it rendered: {one}");
}

test "a node in two zones is a finding" {
    final msg = thrown(fig().node("a").node("b").edge("a", dst: "b")
        .zone("one", members: ["a"]).zone("two", members: ["a", "b"]));
    std\assert(msg.indexOf("node \"a\" sits in zones \"one\" and \"two\"; keep it in one of them") != null, message: "named: {msg}");
}

test "down() transposes the layout" {
    final across = diamond().diagram() catch Diagram{};
    final down = diamond().down().diagram() catch Diagram{};
    std\assert(validate(down).len() == 0, message: "the transposed layout is sound");
    std\assert(nodeOf(down, id: "b").y == nodeOf(down, id: "c").y, message: "a rank is a row");
    std\assert(nodeOf(down, id: "b").x < nodeOf(down, id: "c").x, message: "ordered across it");
    std\assert(nodeOf(down, id: "a").y < nodeOf(down, id: "b").y, message: "ranks run down");
    std\assert(nodeOf(across, id: "b").y < nodeOf(across, id: "c").y, message: "where across they stack");
    std\assert(down.edges[0].srcSide == "bottom" and down.edges[0].dstSide == "top", message: "connectors leave downward");
    std\assert(crossings(down).len() == 0, message: "and still cross nothing");
}

test "the server-http twin lays out clean" {
    final msg = thrown(serverHttpTwin());
    std\assert(msg == "", message: "no findings: {msg}");
    final d = serverHttpTwin().diagram() catch Diagram{};
    std\assert(d.nodes.len() == 9, message: "every box placed");
    std\assert(validate(d).len() == 0, message: "no findings");
    std\assert(crossings(d).len() == 0, message: "no crossings");
}

test "an observed import scope lays out clean once generated" {
    final msg = thrown(observedServerScope());
    std\assert(msg.indexOf("flow \"observed-server\": 18 nodes exceeds the budget of 9; split into overview plus detail, one flow() each") != null,
        message: "authored budgets apply by default: {msg}");
    final d = observedServerScope().generated().diagram() catch Diagram{};
    std\assert(d.generated, message: "marked generated");
    std\assert(d.nodes.len() == 18 and d.edges.len() == 19, message: "every package and import placed");
    std\assert(validate(d).len() == 0, message: "no findings: {validate(d)}");
}

fun midY(n: Node) > int {
    return n.y + n.h / 2;
}

// channelsOf is every distinct x a connector turns on between two columns, sorted.
fun channelsOf(d: Diagram) > [int] {
    final seen: mut {int: bool} = mut {<int: bool>};
    final xs: mut [int] = mut [<int>];
    foreach (e in d.edges) {
        foreach (leg in edgeLegs(d, e: e)) {
            if (leg[0] == leg[2] and leg[1] != leg[3] and seen[leg[0]] == null) {
                seen[leg[0]] = true;
                xs.append(leg[0]);
            }
        }
    }
    xs.sort(fun (a: int, b: int) > bool { return a < b; });
    return xs;
}

fun fan(n: int) > mut Flow {
    final f = fig().node("root");
    var i = 0;
    while (i < n) {
        f.node("c{i}").edge("root", dst: "c{i}");
        i = i + 1;
    }
    return f;
}

// fanIn is n sources feeding one sink. Each source has a neighbour in its own rank between
// it and the sink, so no connector qualifies as a port and every one turns in the gap.
fun fanIn(n: int) > mut Flow {
    final f = fig();
    var i = 0;
    while (i < n) {
        f.node("c{i}");
        i = i + 1;
    }
    f.node("root");
    i = 0;
    while (i < n) {
        f.edge("c{i}", dst: "root");
        i = i + 1;
    }
    return f;
}

// Twenty slots a Pitch apart, with ten steps of room on the far side of the midline, need
// 264px; the box grows to that and no other box grows with it.
test "a fan past a gap's channels widens the gap and the fanning box alone" {
    final d = fanIn(20).generated().diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "twenty connectors, twenty lines");
    final root = nodeOf(d, id: "root");
    std\assert(root.h == 264 and nodeOf(d, id: "c0").h == LayerNodeH, message: "a Pitch per slot: {root.h}");
    final xs = channelsOf(d);
    std\assert(xs.len() == 10, message: "a rising and a falling connector share each channel: {xs}");
    var k = 1;
    while (k < xs.len()) {
        std\assert(xs[k] - xs[k - 1] >= Pitch, message: "a Pitch per channel: {xs}");
        k = k + 1;
    }
}

test "every channel sits >= 16px from both faces" {
    foreach (f in [fanIn(20).generated(), fanIn(5), serverHttpTwin()]) {
        final d = f.diagram() catch Diagram{};
        foreach (e in d.edges) {
            final a = nodeOf(d, id: e.src);
            final b = nodeOf(d, id: e.dst);
            foreach (leg in edgeLegs(d, e: e)) {
                if (leg[0] == leg[2] and leg[1] != leg[3] and e.srcSide == "right") {
                    std\assert(leg[0] - a.x - a.w >= FaceClear and b.x - leg[0] >= FaceClear, message: "{d.id} {e.src}->{e.dst} turns at {leg[0]}");
                }
            }
        }
    }
}

test "edges in one gap whose vertical spans do not overlap share a channel; a lone channel sits at the gap's centre x" {
    final d = fanIn(3).diagram() catch Diagram{};
    final c0 = nodeOf(d, id: "c0");
    final centre = (c0.x + c0.w + nodeOf(d, id: "root").x) / 2;
    std\assert(d.edges[0].bend == centre and d.edges[2].bend == centre, message: "one channel for both: {d.edges[0].bend}, {d.edges[2].bend}, centre {centre}");
    std\assert(edgeLegs(d, e: d.edges[1]).len() == 1, message: "the middle one runs straight");
}

test "k channels sit at centre + (i-(k-1)/2)*12, rounded to nearest; the k-th rising edge mirrors the k-th falling one" {
    final d = fanIn(5).diagram() catch Diagram{};
    final c0 = nodeOf(d, id: "c0");
    final centre = (c0.x + c0.w + nodeOf(d, id: "root").x) / 2;
    final bends: mut [int] = mut [<int>];
    foreach (e in d.edges) { bends.append(e.bend); }
    std\assert(bends[1] == centre - 8 and bends[3] == centre - 8, message: "the inner pair turns nearest the sources: {bends}");
    std\assert(bends[0] == centre + 8 and bends[4] == centre + 8, message: "the outermost pair a Pitch on, rounded away onto the grid: {bends}");
    std\assert(bends[2] == 0, message: "the middle runs straight: {bends}");
}

test "an odd fan puts its middle slot on the midline; an edge to a same-row neighbour takes the midline at both ends" {
    final d = fan(3).diagram() catch Diagram{};
    final root = nodeOf(d, id: "root");
    final mid = d.edges[1];
    std\assert(sidePoint(root, side: mid.srcSide, slot: mid.srcSlot, slots: mid.srcSlots)[1] == midY(root), message: "the middle slot on the midline");
    std\assert(midY(nodeOf(d, id: "c1")) == midY(root), message: "and its target shares the row");
    // Four routes: the Guard's even fan anchors the route on its own row at the midline and
    // steps the rest out from it, rather than straddling the midline and jogging all four.
    final http = serverHttpTwin().diagram() catch Diagram{};
    final guard = nodeOf(http, id: "guard");
    var anchored = 0;
    foreach (e in http.edges) {
        final b = nodeOf(http, id: e.dst);
        if (e.src == "guard" and midY(b) == midY(guard)) {
            std\assert(sidePoint(guard, side: e.srcSide, slot: e.srcSlot, slots: e.srcSlots)[1] == midY(guard)
                and sidePoint(b, side: e.dstSide, slot: e.dstSlot, slots: e.dstSlots)[1] == midY(b), message: "guard->{e.dst} off the midline");
            anchored = anchored + 1;
        }
    }
    std\assert(anchored == 1, message: "one route shares the Guard's row: {anchored}");
}

// A 56px box grows to at most 112px, and eight slots with room to anchor the straight one
// need 120.
test "a fan whose 12px pitch overflows the box is a finding, never a 4px pack" {
    std\assert(thrown(fan(8)) == "flow \"t\": node \"root\" fans 8 connectors on one side; split the figure or add order([...])",
        message: "refused: {thrown(fan(8))}");
    final d = fanIn(7).diagram() catch Diagram{};
    final root = nodeOf(d, id: "root");
    final ys: mut [int] = mut [<int>];
    foreach (e in d.edges) { ys.append(sidePoint(root, side: e.dstSide, slot: e.dstSlot, slots: e.dstSlots)[1]); }
    var k = 1;
    while (k < ys.len()) {
        std\assert(ys[k] - ys[k - 1] >= Pitch, message: "seven slots a Pitch apart: {ys}");
        k = k + 1;
    }
    std\assert(ys[0] >= root.y + Pitch and ys[ys.len() - 1] <= root.y + root.h - Pitch, message: "inside the box: {ys} in {root.y}+{root.h}");
}

// On the forward face slots run in the targets' row order. Ports on the top or bottom run
// from the farthest target to the nearest, so each turn encloses the next: above the box
// that is row order, below it the reverse.
test "slots follow their targets' rows, so no fan crosses itself at its source" {
    foreach (f in [fan(5), fan(4), fanIn(4), serverHttpTwin()]) {
        final d = f.diagram() catch Diagram{};
        foreach (a in d.edges) {
            foreach (b in d.edges) {
                if (a.src == b.src and a.srcSide == b.srcSide and midY(nodeOf(d, id: a.dst)) < midY(nodeOf(d, id: b.dst))) {
                    if (a.srcSide == "bottom") {
                        std\assert(a.srcSlot > b.srcSlot, message: "{d.id}: {a.src}->{a.dst} leaves outside {b.dst}");
                    } else {
                        std\assert(a.srcSlot < b.srcSlot, message: "{d.id}: {a.src}->{a.dst} leaves below {b.dst}");
                    }
                }
            }
        }
        std\assert(crossings(d).len() == 0, message: "{d.id} crosses nothing");
    }
}

test "a node with one neighbour in the adjacent rank shares its midline whenever that row is free; a long edge whose source row is free across the ranks it spans draws one leg" {
    final d = fig()
        .node("a").node("b").node("c").node("d").node("s").node("t")
        .edge("a", dst: "b").edge("b", dst: "c").edge("c", dst: "d").edge("s", dst: "t")
        .rank(["d", "t"])
        .diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {validate(d)}");
    foreach (id in ["b", "c", "d"]) {
        std\assert(midY(nodeOf(d, id: id)) == midY(nodeOf(d, id: "a")), message: "{id} on a's row");
    }
    final long = edgeOf(d, src: "s", dst: "t");
    std\assert(long != null and edgeLegs(d, e: long!).len() == 1, message: "s -> t runs straight across three gaps");
    std\assert(midY(nodeOf(d, id: "t")) == midY(nodeOf(d, id: "s")), message: "t on s's row");
}

test "a fan keeps its slots and channels a Pitch apart, so every leg seats the bend floor" {
    final f = fig().node("root");
    foreach (id in ["a", "b", "c", "d", "e"]) { f.node(id).edge("root", dst: id); }
    final msg = thrown(f);
    std\assert(msg == "", message: "an authored fan of five passes the bend floor: {msg}");
    final d = f.diagram() catch Diagram{};
    final root = nodeOf(d, id: "root");
    foreach (side in ["top", "right", "bottom"]) {
        final along: mut [int] = mut [<int>];
        foreach (e in d.edges) {
            final at = sidePoint(root, side: e.srcSide, slot: e.srcSlot, slots: e.srcSlots);
            if (e.srcSide == side and side == "right") { along.append(at[1]); }
            if (e.srcSide == side and side != "right") { along.append(at[0]); }
        }
        along.sort(fun (a: int, b: int) > bool { return a < b; });
        var k = 1;
        while (k < along.len()) {
            std\assert(along[k] - along[k - 1] >= Pitch, message: "{side} slots {along}");
            k = k + 1;
        }
    }
    std\assert(validate(d).len() == 0, message: "every leg seats the floor: {validate(d)}");
}

test "neighbouring ranks on one row connect straight" {
    final d = serverHttpTwin().diagram() catch Diagram{};
    var straight = 0;
    foreach (e in d.edges) {
        final a = nodeOf(d, id: e.src);
        final b = nodeOf(d, id: e.dst);
        if (midY(a) == midY(b) and b.x - a.x == LayerNodeW + LayerColGap) {
            std\assert(edgeLegs(d, e: e).len() == 1, message: "{e.src}->{e.dst} detours");
            straight = straight + 1;
        }
    }
    std\assert(straight > 0, message: "the guard shares a row with a route");
}

test "a band's sole parent sits beside it" {
    final d = fig()
        .node("u").node("b").node("c").node("v").node("w")
        .edge("u", dst: "b").edge("u", dst: "c").edge("v", dst: "w")
        .zone("pair", members: ["b", "c"])
        .diagram() catch Diagram{};
    final u = nodeOf(d, id: "u");
    final z = d.zones[0];
    std\assert(u.y >= z.y and u.y + u.h <= z.y + z.h, message: "u sits within the band's rows");
    std\assert(u.x + u.w <= z.x, message: "and outside its box");
    std\assert(nodeOf(d, id: "v").y >= z.y + z.h, message: "an unrelated node still sits after the band");
}

test "an unzoned node whose neighbours lie in two adjacent bands sits in the gap row between them" {
    final d = fig()
        .node("p").node("l").node("s").node("k").node("r").node("v")
        .edge("p", dst: "l").edge("s", dst: "p").edge("k", dst: "s").edge("s", dst: "r")
        .zone("top", members: ["p", "l"]).zone("bottom", members: ["k", "r"])
        .diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {validate(d)}");
    final s = nodeOf(d, id: "s");
    final top = d.zones[0];
    final bottom = d.zones[1];
    std\assert(s.y >= top.y + top.h and s.y + s.h <= bottom.y, message: "s sits between the bands at y {s.y}");
    std\assert(nodeOf(d, id: "k").x < s.x and s.x < nodeOf(d, id: "p").x, message: "and keeps its rank");
    std\assert(nodeOf(d, id: "v").y >= bottom.y + bottom.h, message: "a node with no edges still sits after the last band");

    final apart = fig()
        .node("x0").node("x1").node("x2").node("y0").node("y1").node("z2").node("s")
        .edge("x0", dst: "x1").edge("x1", dst: "x2").edge("y0", dst: "y1").edge("x0", dst: "s").edge("s", dst: "z2").edge("y1", dst: "z2")
        .zone("one", members: ["x0", "x1", "x2"]).zone("two", members: ["y0", "y1"]).zone("three", members: ["z2"])
        .diagram() catch Diagram{};
    std\assert(apart.zones.len() == 3, message: "laid out");
    final far = nodeOf(apart, id: "s");
    foreach (z in apart.zones) {
        std\assert(far.y >= z.y + z.h, message: "bands that are not adjacent leave s after the last band");
    }
}

fun pair() > Observed {
    return Observed{
        nodes = [ObservedNode{ id = "a", label = "pkg/a", anchor = "pkg/a" }, ObservedNode{ id = "b", anchor = "pkg/b" }],
        edges = [ObservedEdge{ src = "a", dst = "b" }],
        stamp = "sha256:0123",
    };
}

fun thrown(f: Flow) > str {
    var msg = "";
    try {
        f.diagram();
    } catch (e: str) {
        msg = e;
    }
    return msg;
}

fun edgeOf(d: Diagram, src: str, dst: str) > Edge? {
    foreach (e in d.edges) {
        if (e.src == src and e.dst == dst) { return e; }
    }
    return null;
}

// serverHttpComposed is the twin rebuilt the way a figure composes: the six anchored
// packages arrive observed, the declaration relabels them, adds the clients and the request
// flow, and hides every import the request flow does not follow.
fun serverHttpComposed() > mut Flow {
    final pkgs = [
        "internal/handler/graph", "internal/handler/mcp", "internal/handler/metrics",
        "internal/handler/status", "internal/httpx", "internal/server",
    ];
    final imports = [
        ["internal/handler/graph", "internal/httpx"],
        ["internal/server", "internal/handler/graph"],
        ["internal/server", "internal/handler/mcp"],
        ["internal/server", "internal/handler/metrics"],
        ["internal/server", "internal/handler/status"],
        ["internal/server", "internal/httpx"],
    ];
    final nodes: mut [ObservedNode] = mut [<ObservedNode>];
    foreach (p in pkgs) {
        nodes.append(ObservedNode{ id = "pkg-" + p.replace("/", with: "-"), label = p, anchor = p });
    }
    final edges: mut [ObservedEdge] = mut [<ObservedEdge>];
    foreach (imp in imports) {
        edges.append(ObservedEdge{ src = "pkg-" + imp[0].replace("/", with: "-"), dst = "pkg-" + imp[1].replace("/", with: "-") });
    }
    final mounts = "the server mounts every handler; the figure draws the request path";
    return flow("server-http", observed: Observed{ nodes = nodes, edges = edges, stamp = "sha256:0929" })
        .eyebrow("magus server")
        .title("The HTTP surface, and the one route without a guard")
        .node("agent", label: "AI agents", sub: "Claude Code, IDE", tag: "client")
        .node("console", label: "Console PWA", sub: "dashboard, review", tag: "client")
        .node("probe", label: "kubelet", sub: "scripts, probes", tag: "client", role: Role.external)
        .node("pkg-internal-httpx", label: "Guard", sub: "rebind + token + CORS", tag: "gate", role: Role.focal)
        .node("pkg-internal-handler-mcp", label: "/mcp", sub: "agent tools, SSE")
        .node("pkg-internal-handler-graph", label: "/api/v1 read views", sub: "graph, events, insight, outputs")
        .node("pkg-internal-handler-status", label: "/api/v1 review + plans", sub: "diff, session, plan, review")
        .node("pkg-internal-handler-metrics", label: "Connect RPC", sub: "eleven typed services")
        .node("pkg-internal-server", label: "/livez /readyz", sub: "no authentication", role: Role.external)
        .edge("agent", dst: "pkg-internal-httpx")
        .edge("console", dst: "pkg-internal-httpx")
        .edge("pkg-internal-httpx", dst: "pkg-internal-handler-mcp")
        .edge("pkg-internal-httpx", dst: "pkg-internal-handler-graph")
        .edge("pkg-internal-httpx", dst: "pkg-internal-handler-status")
        .edge("pkg-internal-httpx", dst: "pkg-internal-handler-metrics")
        .edge("probe", dst: "pkg-internal-server", label: "unguarded", role: EdgeRole.focal)
        .omitEdge("pkg-internal-handler-graph", dst: "pkg-internal-httpx", why: "the read views use guard helpers; requests run the other way")
        .omitEdge("pkg-internal-server", dst: "pkg-internal-handler-graph", why: mounts)
        .omitEdge("pkg-internal-server", dst: "pkg-internal-handler-mcp", why: mounts)
        .omitEdge("pkg-internal-server", dst: "pkg-internal-handler-metrics", why: mounts)
        .omitEdge("pkg-internal-server", dst: "pkg-internal-handler-status", why: mounts)
        .omitEdge("pkg-internal-server", dst: "pkg-internal-httpx", why: mounts)
        .legend(Role.focal, label: "authenticated")
        .legend(Role.external, label: "open to any caller")
        .scope(["internal/handler/*", "internal/httpx", "internal/server"]);
}

// serverHttpAnchored composes the twin as an author would keep it: its own ids, each box
// anchored, laid over an observation that names the same packages by the generator's ids.
fun serverHttpAnchored() > mut Flow {
    final o = Observed{
        nodes = [
            ObservedNode{ id = "pkg-internal-handler-graph", label = "internal/handler/graph", anchor = "internal/handler/graph" },
            ObservedNode{ id = "pkg-internal-handler-mcp", label = "internal/handler/mcp", anchor = "internal/handler/mcp" },
            ObservedNode{ id = "pkg-internal-handler-metrics", label = "internal/handler/metrics", anchor = "internal/handler/metrics" },
            ObservedNode{ id = "pkg-internal-handler-status", label = "internal/handler/status", anchor = "internal/handler/status" },
            ObservedNode{ id = "pkg-internal-httpx", label = "internal/httpx", anchor = "internal/httpx" },
            ObservedNode{ id = "pkg-internal-server", label = "internal/server", anchor = "internal/server" },
        ],
        edges = [
            ObservedEdge{ src = "pkg-internal-handler-graph", dst = "pkg-internal-httpx" },
            ObservedEdge{ src = "pkg-internal-server", dst = "pkg-internal-handler-graph" },
            ObservedEdge{ src = "pkg-internal-server", dst = "pkg-internal-handler-mcp" },
            ObservedEdge{ src = "pkg-internal-server", dst = "pkg-internal-handler-metrics" },
            ObservedEdge{ src = "pkg-internal-server", dst = "pkg-internal-handler-status" },
            ObservedEdge{ src = "pkg-internal-server", dst = "pkg-internal-httpx" },
        ],
        stamp = "sha256:0929",
    };
    final mounts = "the server mounts every handler; the figure draws the request path";
    return serverHttpTwin(observed: o)
        .omitEdge("reads", dst: "guard", why: "the read views use guard helpers; requests run the other way")
        .omitEdge("health", dst: "reads", why: mounts)
        .omitEdge("health", dst: "mcp", why: mounts)
        .omitEdge("health", dst: "connect", why: mounts)
        .omitEdge("health", dst: "review", why: mounts);
}

test "a declared anchor takes over the observed box it depicts" {
    final msg = thrown(serverHttpAnchored());
    std\assert(msg == "", message: "composed: {msg}");
    final d = serverHttpAnchored().diagram() catch Diagram{};
    std\assert(d.nodes.len() == 9, message: "nine boxes: {d.nodes.len()}");
    final ids = ["agent", "console", "probe", "guard", "mcp", "reads", "review", "connect", "health"];
    final declared: mut {str: bool} = mut {<str: bool>};
    foreach (id in ids) { declared[id] = true; }
    final anchors: mut {str: bool} = mut {<str: bool>};
    foreach (n in d.nodes) {
        std\assert(declared[n.id] != null, message: "{n.id} is a declared id");
        if (n.anchor != "") {
            std\assert(anchors[n.anchor] == null, message: "{n.anchor} drawn twice");
            anchors[n.anchor] = true;
        }
    }
    std\assert(nodeOf(d, id: "guard").label == "Guard", message: "the declared label wins");
    final kept = edgeOf(d, src: "health", dst: "guard");
    std\assert(kept != null and kept?.claim == "imports", message: "the observed import runs between declared ids");
    foreach (e in d.edges) {
        std\assert(declared[e.src] != null and declared[e.dst] != null, message: "{e.src} -> {e.dst} names a declared id");
    }
    std\assert(d.edges.len() == 8, message: "seven declared connectors and one observed: {d.edges.len()}");
}

test "a node matching one observation by id and another by anchor is a finding" {
    final msg = thrown(fig(observed: pair()).node("a", anchor: "pkg/b"));
    std\assert(msg.indexOf("node \"a\" anchors \"pkg/b\", which observed node \"b\" already carries; override it with node(\"b\") or omit(\"pkg/b\", why:)") != null,
        message: "named: {msg}");
}

test "observed nodes and edges render" {
    final f = fig(observed: pair());
    final d = f.diagram() catch Diagram{};
    std\assert(d.nodes.len() == 2 and d.edges.len() == 1, message: "both boxes and the import placed");
    std\assert(nodeOf(d, id: "a").label == "pkg/a" and nodeOf(d, id: "b").label == "b", message: "an empty label shows the id");
    std\assert(nodeOf(d, id: "b").anchor == "pkg/b", message: "the observed anchor kept");
    std\assert(d.edges[0].claim == "imports", message: "an observed edge claims imports");
    final svg = f.svg(lightPalette()) catch "threw";
    std\assert(svg.startsWith("<svg"), message: "and it renders: {svg}");
}

test "a declared node overrides an observed label and keeps its anchor" {
    final d = fig(observed: pair()).node("a", label: "Alpha", sub: "the source", role: Role.focal).diagram() catch Diagram{};
    std\assert(d.nodes.len() == 2, message: "merged, not duplicated");
    final a = nodeOf(d, id: "a");
    std\assert(a.label == "Alpha" and a.sub == "the source" and a.role == "focal", message: "the declaration wins");
    std\assert(a.anchor == "pkg/a", message: "an empty declared anchor keeps the observed one");
    final plain = fig(observed: pair()).node("a", sub: "only a sub").diagram() catch Diagram{};
    std\assert(nodeOf(plain, id: "a").label == "pkg/a", message: "an empty declared label keeps the observed one");
}

test "a node anchored apart from its observation is a finding" {
    final msg = thrown(fig(observed: pair()).node("a", anchor: "pkg/elsewhere"));
    std\assert(msg.indexOf("node \"a\" is anchored at \"pkg/elsewhere\" but observed at \"pkg/a\"; anchor it at \"pkg/a\" or give it an id of its own") != null,
        message: "named: {msg}");
}

test "a declared edge replaces an observed one" {
    final d = fig(observed: pair()).edge("a", dst: "b", label: "http", claim: Claim.calls).diagram() catch Diagram{};
    std\assert(d.edges.len() == 1, message: "replaced, not doubled");
    std\assert(d.edges[0].claim == "calls" and d.edges[0].label == "http", message: "the declaration's claim and label win");
}

test "a declared edge over an observed import must claim it or omit it" {
    final flowing = thrown(fig(observed: pair()).edge("a", dst: "b", label: "reads"));
    std\assert(flowing == "flow \"t\": edge \"a\" -> \"b\" replaces an observed import but claims flow; claim Claim.imports or omitEdge it",
        message: "named: {flowing}");
    final d = fig(observed: pair()).edge("a", dst: "b", label: "reads", claim: Claim.imports).diagram() catch Diagram{};
    std\assert(d.edges.len() == 1 and d.edges[0].claim == "imports" and d.edges[0].label == "reads", message: "claimed, it relabels the import");
    final both = thrown(fig(observed: pair()).edge("a", dst: "b").omitEdge("a", dst: "b", why: "drawn by hand"));
    std\assert(both.indexOf("edge \"a\" -> \"b\" is declared and also hidden by omitEdge; drop one of them") != null, message: "both: {both}");
}

test "omitEdge hides an observed edge and is reported when stale" {
    final o = Observed{
        nodes = [ObservedNode{ id = "a" }, ObservedNode{ id = "b" }, ObservedNode{ id = "c" }],
        edges = [ObservedEdge{ src = "a", dst = "b" }, ObservedEdge{ src = "b", dst = "c" }],
    };
    final d = fig(observed: o).omitEdge("a", dst: "b", why: "a test seam").diagram() catch Diagram{};
    std\assert(d.edges.len() == 1 and edgeOf(d, src: "a", dst: "b") == null, message: "hidden");
    final stale = thrown(fig(observed: o).omitEdge("a", dst: "c", why: "gone"));
    std\assert(stale == "flow \"t\": omitEdge \"a\" -> \"c\" names no observed edge; drop the omitEdge", message: "stale: {stale}");
    final bare = thrown(fig(observed: o).omitEdge("a", dst: "b", why: ""));
    std\assert(bare == "flow \"t\": omitEdge \"a\" -> \"b\" gives no reason; say why in omitEdge(\"a\", dst: \"b\", why:)", message: "unexplained: {bare}");
}

test "an edge to an id neither side supplies is a finding" {
    final msg = thrown(fig(observed: pair()).edge("a", dst: "z"));
    std\assert(msg == "flow \"t\": edge \"a\" -> \"z\" names \"z\", which neither a node nor the observed set supplies; declare node(\"z\")",
        message: "named: {msg}");
    final bare = thrown(fig().node("a").edge("a", dst: "z"));
    std\assert(bare == msg, message: "one message whether or not a set is observed: {bare}");
}

test "the stamp reaches the Diagram" {
    final d = fig(observed: pair()).diagram() catch Diagram{};
    std\assert(d.stamp == "sha256:0123", message: "stamped: {d.stamp}");
    final plain = diamond().diagram() catch Diagram{};
    std\assert(plain.stamp == "", message: "an unobserved figure carries none");
}

test "the server-http twin composed from an observation lays out clean" {
    final msg = thrown(serverHttpComposed());
    std\assert(msg == "", message: "composed: {msg}");
    final d = serverHttpComposed().diagram() catch Diagram{};
    std\assert(d.nodes.len() == 9 and d.edges.len() == 7, message: "every box and connector placed");
    std\assert(nodeOf(d, id: "pkg-internal-httpx").label == "Guard", message: "relabelled");
    std\assert(nodeOf(d, id: "pkg-internal-httpx").anchor == "internal/httpx", message: "anchored by observation");
    std\assert(d.stamp == "sha256:0929", message: "stamped");
    std\assert(crossings(d).len() == 0, message: "no crossings");
}

test "an omit drops the observed box it names and every connector touching it" {
    final o = Observed{
        nodes = [ObservedNode{ id = "a", anchor = "pkg/a" }, ObservedNode{ id = "b", anchor = "pkg/b" }, ObservedNode{ id = "c", anchor = "pkg/c" }],
        edges = [ObservedEdge{ src = "a", dst = "b" }, ObservedEdge{ src = "b", dst = "c" }, ObservedEdge{ src = "a", dst = "c" }],
    };
    final d = fig(observed: o).omit("pkg/b", why: "folded into a").diagram() catch Diagram{};
    std\assert(d.nodes.len() == 2 and nodeOf(d, id: "b").id == "", message: "b is gone: {d.nodes.len()}");
    std\assert(d.edges.len() == 1 and edgeOf(d, src: "a", dst: "c") != null, message: "only a -> c remains: {d.edges.len()}");
    std\assert(d.omits["pkg/b"] == "folded into a", message: "the omit reaches the Diagram");
}

test "a declared node anchored at an omitted path is a finding" {
    final byAnchor = thrown(fig(observed: pair()).node("x", anchor: "pkg/b").omit("pkg/b", why: "folded into a"));
    std\assert(byAnchor == "flow \"t\": node \"x\" anchors \"pkg/b\", which omit leaves out (folded into a); drop the node or the omit(\"pkg/b\")",
        message: "named: {byAnchor}");
    final byId = thrown(fig(observed: pair()).node("b", label: "B").omit("pkg/b", why: "folded into a"));
    std\assert(byId.indexOf("node \"b\" anchors \"pkg/b\", which omit leaves out") != null, message: "an override inherits the anchor: {byId}");
}

test "an omit or a zone declared twice is a finding" {
    final omits = thrown(fig().node("a").omit("pkg/a", why: "one").omit("pkg/a", why: "two"));
    std\assert(omits == "flow \"t\": omit \"pkg/a\" is declared twice; keep one omit(\"pkg/a\", why:) with one reason", message: "omit: {omits}");
    final zones = thrown(fig().node("a").node("b").zone("x", members: ["a"]).boundary("x", members: ["b"]));
    std\assert(zones == "flow \"t\": boundary \"x\" is declared twice; merge the members into one boundary(\"x\", members:)", message: "zone: {zones}");
}

