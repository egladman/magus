// serverHttpOmitting is the twin over the whole scope, leaving out the twelve handler
// packages with the reasons docs/site/diagrams/server-http.buzz gives. The six imports left
// run against the request path the figure claims, so each is hidden with its reason.
fun serverHttpOmitting() > mut Flow {
    final connect = "a Connect service, inside the Connect RPC box";
    final mounts = "the server mounts every handler; the figure draws the request path";
    return serverHttpTwin(observed: serverHttpObserved())
        .omitEdge("reads", dst: "guard", why: "the read views use guard helpers; requests run the other way")
        .omitEdge("health", dst: "guard", why: "the server builds the guard; drawn, the unguarded probe would pass through it")
        .omitEdge("health", dst: "reads", why: mounts)
        .omitEdge("health", dst: "mcp", why: mounts)
        .omitEdge("health", dst: "connect", why: mounts)
        .omitEdge("health", dst: "review", why: mounts)
        .omit("internal/handler/activity", why: connect)
        .omit("internal/handler/attention", why: "a read route, inside the /api/v1 read views box")
        .omit("internal/handler/diff", why: "the diff and session routes, inside the review + plans box")
        .omit("internal/handler/insight", why: "a read route and Connect service, inside the read views box")
        .omit("internal/handler/job", why: connect)
        .omit("internal/handler/memory", why: connect)
        .omit("internal/handler/notes", why: connect)
        .omit("internal/handler/plan", why: "the plan route, inside the review + plans box")
        .omit("internal/handler/token", why: connect)
        .omit("internal/handler/tool", why: connect)
        .omit("internal/handler/trailrpc", why: "the audit interceptor around Connect services, not a route")
        .omit("internal/handler/viewer", why: "read routes and a Connect service, inside the read views box");
}

test "the server-http twin over its whole scope lays out clean once it omits the handlers it folds" {
    final msg = thrown(serverHttpOmitting());
    std\assert(msg == "", message: "composed: {msg}");
    final d = serverHttpOmitting().diagram() catch Diagram{};
    std\assert(d.generated == false, message: "authored budgets apply");
    std\assert(d.nodes.len() == 9 and d.edges.len() == 7, message: "nine boxes, seven connectors: {d.nodes.len()}, {d.edges.len()}");
    std\assert(nodeOf(d, id: "guard").anchor == "internal/httpx", message: "the declared id kept");
    std\assert(d.omits.size() == 12, message: "every omit kept");
    std\assert(validate(d).len() == 0 and crossings(d).len() == 0, message: "clean");
}

fun decisionTree(down: bool) > mut Flow {
    final f = fig()
        .node("start").node("q", label: "which?", role: Role.decision).node("r", label: "again?", role: Role.decision)
        .node("a").node("b").node("c").node("d")
        .edge("start", dst: "q").edge("q", dst: "a").edge("q", dst: "r").edge("q", dst: "b")
        .edge("r", dst: "c").edge("r", dst: "d");
    if (down) { f.down(); }
    return f;
}

test "a decision leaves by its vertices, one connector each" {
    foreach (down in [false, true]) {
        final d = decisionTree(down).diagram() catch Diagram{};
        std\assert(validate(d).len() == 0, message: "down={down}: {validate(d)}");
        foreach (id in ["q", "r"]) {
            final sides: mut {str: bool} = mut {<str: bool>};
            foreach (e in d.edges) {
                if (e.src == id) {
                    std\assert(e.srcSlots == 1, message: "down={down}: {e.src}->{e.dst} fans");
                    std\assert(sides[e.srcSide] == null, message: "down={down}: {id} leaves {e.srcSide} twice");
                    sides[e.srcSide] = true;
                }
                if (e.dst == id) { std\assert(e.dstSlots == 1, message: "down={down}: {e.src}->{e.dst} fans in"); }
            }
        }
        foreach (e in d.edges) {
            foreach (leg in edgeLegs(d, e: e)) {
                foreach (n in d.nodes) {
                    std\assert(legEntersBox(leg, n: n) == false, message: "down={down}: {e.src}->{e.dst} runs through {n.id}");
                }
            }
        }
    }
}

test "a decision's faults are refused as declarations" {
    final text = thrown(fig().node("q", sub: "why", role: Role.decision).node("a").edge("q", dst: "a"));
    std\assert(text == "flow \"t\": node \"q\" is a Role.decision with a tag or sub; drop them from node(\"q\"), a diamond has room for neither",
        message: "text: {text}");
    final f = fig().node("q", role: Role.decision);
    foreach (id in ["a", "b", "c", "d"]) { f.node(id).edge("q", dst: id); }
    std\assert(thrown(f).indexOf("node \"q\" has 4 exits; a Role.decision takes 3, so nest a second decision node") != null, message: "exits: {thrown(f)}");
}

test "two declared boxes may share the anchor of one observed package" {
    final o = Observed{ nodes = [ObservedNode{ id = "pkg-a", label = "pkg/a", anchor = "pkg/a" }] };
    final f = fig(observed: o)
        .node("contract", label: "Contract", anchor: "pkg/a")
        .node("quote", label: "Quote", anchor: "pkg/a")
        .edge("contract", dst: "quote");
    std\assert(thrown(f) == "", message: "no finding: {thrown(f)}");
    final d = f.diagram() catch Diagram{};
    std\assert(d.nodes.len() == 2, message: "the observation merged into one of them: {d.nodes.len()}");
}

test "merging an observation keeps the declaration's order" {
    final d = fig(observed: pair())
        .node("b", label: "B").node("a", label: "A").node("c")
        .diagram() catch Diagram{};
    final ids: mut [str] = mut [<str>];
    foreach (n in d.nodes) { ids.append(n.id); }
    std\assert(ids.join(",") == "b,a,c", message: "declared order: {ids.join(",")}");
    final extra = fig(observed: pair()).node("z").diagram() catch Diagram{};
    std\assert(extra.nodes[0].id == "z" and extra.nodes[1].id == "a", message: "observed-only boxes follow the declared ones");
}

test "a rank no zone reaches centers between the bands" {
    final d = fig()
        .node("s").node("a1").node("a2").node("b1").node("b2")
        .edge("s", dst: "a1").edge("a1", dst: "a2").edge("s", dst: "b1").edge("b1", dst: "b2")
        .zone("one", members: ["a1", "a2"]).zone("two", members: ["b1", "b2"])
        .diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {validate(d)}");
    final s = nodeOf(d, id: "s");
    final mid = s.y + s.h / 2;
    std\assert(mid > d.zones[0].y + d.zones[0].h and mid < d.zones[1].y, message: "s sits between the bands at {mid}");
}

test "a zone's box never takes in a rank it spans without a member there" {
    final d = fig()
        .node("p").node("m").node("q")
        .edge("p", dst: "m").edge("m", dst: "q")
        .zone("pair", members: ["p", "q"])
        .diagram() catch Diagram{};
    final m = nodeOf(d, id: "m");
    final z = d.zones[0];
    std\assert(m.y >= z.y + z.h or m.y + m.h <= z.y, message: "m sits outside the band's box");
}

test "edge roles map onto the renderer's treatments" {
    final d = fig().node("a").node("b").node("c").node("d")
        .edge("a", dst: "b", role: EdgeRole.focal)
        .edge("a", dst: "c", role: EdgeRole.external)
        .edge("a", dst: "d", role: EdgeRole.optional)
        .diagram() catch Diagram{};
    std\assert(d.edges[0].kind == "accent" and d.edges[0].dashed == false, message: "focal is the accent");
    std\assert(d.edges[1].kind == "link" and d.edges[1].dashed == false, message: "external is the link colour");
    std\assert(d.edges[2].kind == "default" and d.edges[2].dashed, message: "optional is dashed");
    std\assert(d.edges[0].claim == "flow", message: "a declared edge claims flow by default");
}

// The checker accepts a str where an enum is declared; the old string surface must still
// fail loudly rather than paint a null role.
test "a string where a Role, EdgeRole or Claim belongs is a finding" {
    final msg = thrown(fig().node("a", role: "focal").node("b").edge("a", dst: "b", role: "focal", claim: "imports").legend("focal", label: "x"));
    final want = [
        "flow \"t\": node \"a\" takes role: Role.<case>, not a string; name the case",
        "flow \"t\": edge \"a\" -> \"b\" takes role: EdgeRole.<case>, not a string; name the case",
        "flow \"t\": edge \"a\" -> \"b\" takes claim: Claim.<case>, not a string; name the case",
        "flow \"t\": legend \"x\" takes Role.<case>, not a string; name the case",
    ];
    std\assert(msg == want.join("\n"), message: "stringly: {msg}");
}

test "a node links outside the repo or anchors inside it, never both" {
    final d = fig().node("stripe", label: "Stripe", role: Role.external, link: "https://stripe.com/docs").diagram() catch Diagram{};
    std\assert(nodeOf(d, id: "stripe").link == "https://stripe.com/docs", message: "the link reaches the node");
    final both = thrown(fig().node("a", anchor: "pkg/a", link: "https://example.com"));
    std\assert(both == "flow \"t\": node \"a\" sets both anchor and link; keep anchor for a path in this repo, link for anything outside it",
        message: "both: {both}");
}

test "a figure says what code it depicts, or why it depicts none" {
    final bare = thrown(flow("t").node("a"));
    std\assert(bare == "flow \"t\": names no code; add scope([...]) or unscoped(why:)", message: "bare: {bare}");
    std\assert(thrown(flow("t").node("a").scope(["pkg/a"])) == "", message: "a scope names code");
    std\assert(thrown(flow("t").node("a").generated()) == "", message: "a generated figure needs neither");
    final d = flow("t").node("a").unscoped("a decision a person makes").diagram() catch Diagram{};
    std\assert(d.unscoped == "a decision a person makes", message: "the reason reaches the Diagram: {d.unscoped}");
    final silent = thrown(flow("t").node("a").unscoped(""));
    std\assert(silent == "flow \"t\": unscoped gives no reason; say why in unscoped(why:)", message: "silent: {silent}");
    final both = thrown(flow("t").node("a").scope(["pkg/a"]).unscoped("both"));
    std\assert(both == "flow \"t\": declares both scope([...]) and unscoped(why:); keep one", message: "both: {both}");
}

test "a boundary paints as a trust boundary and counts against the band budget" {
    final f = fig().node("a").node("b").node("c").edge("a", dst: "b").edge("a", dst: "c")
        .boundary("trusted", members: ["b", "c"]);
    final d = f.diagram() catch Diagram{};
    std\assert(d.zones.len() == 1 and d.zones[0].boundary, message: "one boundary band: {thrown(f)}");
    final svg = f.svg(lightPalette()) catch "threw";
    std\assert(svg.indexOf("stroke-dasharray=\"4,4\"") != null and svg.indexOf(">TRUSTED</text>") != null, message: "the security treatment");
    final many = fig().node("a").node("b").node("c").node("d")
        .zone("one", members: ["a"]).zone("two", members: ["b"])
        .boundary("three", members: ["c"]).boundary("four", members: ["d"]);
    std\assert(thrown(many).indexOf("4 zones and boundaries exceed the budget of 3") != null, message: "budget: {thrown(many)}");
}

test "constraints that hold lay out, and ones that contradict are refused" {
    std\assert(thrown(diamond().rank(["b", "c"]).order(["c", "b"]).row(["a", "d"])) == "", message: "a consistent set: {thrown(diamond().rank(["b", "c"]))}");
    final path = thrown(diamond().rank(["a", "d"]));
    std\assert(path == "flow \"t\": rank([\"a\", \"d\"]) contradicts the path \"a\" -> \"d\"; drop one of them from rank([...])", message: "path: {path}");
    final chained = thrown(diamond().rank(["a", "x"]).rank(["x", "b"]).node("x"));
    std\assert(chained.indexOf("rank([\"a\", \"b\", \"x\"]) contradicts the path \"a\" -> \"b\"") != null, message: "chained: {chained}");
    final unknown = thrown(diamond().row(["a", "zz"]));
    std\assert(unknown == "flow \"t\": row([\"a\", \"zz\"]) names \"zz\", which no node declares; declare node(\"zz\") or drop it from row([...])", message: "unknown: {unknown}");
    final lone = thrown(diamond().order(["a"]));
    std\assert(lone == "flow \"t\": order([\"a\"]) relates fewer than two nodes; name two or more, or drop it", message: "lone: {lone}");
    final cycle = thrown(diamond().order(["b", "c"]).order(["c", "b"]));
    std\assert(cycle == "flow \"t\": order puts \"b\", \"c\" each before the other; drop the order([...]) that reverses them", message: "cycle: {cycle}");
    final across = thrown(diamond().order(["a", "b"]));
    std\assert(across.indexOf("order([\"a\", \"b\"]) names \"a\" and \"b\", which a path puts in different ranks") != null, message: "across: {across}");
    final apart = thrown(fig().node("x").node("y").node("p").node("q").edge("x", dst: "y").edge("p", dst: "q").order(["x", "q"]));
    std\assert(apart.indexOf("which sit in different ranks; add rank([...]) with both or drop the order") != null, message: "apart: {apart}");
    final zoned = thrown(diamond().zone("one", members: ["c"]).zone("two", members: ["b"]).order(["b", "c"]));
    std\assert(zoned.indexOf("order([\"b\", \"c\"]) puts \"b\" first, but zone \"two\" stacks after zone \"one\"") != null, message: "zoned: {zoned}");
    final ranked = thrown(diamond().row(["b", "c"]));
    std\assert(ranked.indexOf("row([\"b\", \"c\"]) names \"b\" and \"c\", which share a rank") != null, message: "ranked: {ranked}");
    final banded = thrown(diamond().zone("one", members: ["a"]).zone("two", members: ["d"]).row(["a", "d"]));
    std\assert(banded.indexOf("names \"a\" in zone \"one\" and \"d\" in zone \"two\"; bands never share a row") != null, message: "banded: {banded}");
}

test "every finding names the figure, one per line, with a fix" {
    final msg = thrown(flow("t").node("a").node("a").edge("a", dst: "z"));
    final lines = msg.split("\n");
    std\assert(lines.len() == 3, message: "three findings: {msg}");
    foreach (line in lines) {
        std\assert(line.startsWith("flow \"t\": ") and line.indexOf("; ") != null, message: "voiced: {line}");
    }
}

// Two connectors on one line are the author's to separate, with row() or a split; any other
// fault in a placed figure is the layout's.
test "a layout fault reaches the author as a finding or a layout bug, never as a bend to move" {
    final got = layoutFindings([
        Fault{ rule = "sameLine", subjects = ["a", "b", "c", "d"], text = "connectors a->b and c->d run along the same line", fix = "offset one of their bends" },
        Fault{ rule = "bend", subjects = ["a", "b"], text = "edge a->b: a leg leaves 4px for a bend that needs 6", fix = "move the bend or the boxes" },
        Fault{ rule = "overlap", subjects = ["a", "b"], text = "nodes \"a\" and \"b\" overlap" },
    ]);
    std\assert(got[0] == "edges \"a\" -> \"b\" and \"c\" -> \"d\" run along one line; line their ends up with row([...]) or split the figure", message: "{got[0]}");
    std\assert(got[1] == "edge \"a\" -> \"b\" has a leg too short to bend; layout bug, report it", message: "{got[1]}");
    std\assert(got[2] == "nodes \"a\" and \"b\" overlap; layout bug, report it", message: "{got[2]}");
    foreach (line in got) { std\assert(line.indexOf("move") == null, message: "no bend to move: {line}"); }
}

fun midX(n: Node) > int {
    return n.x + n.w / 2;
}

// leaseLoopTwin is docs/site/diagrams/lease-loop.buzz's shape: a six-step spine whose last
// step and whose release both run back against the flow.
fun leaseLoopTwin() > mut Flow {
    return fig().down().title("Lease loop")
        .node("cp", sub: "x", tag: "x").node("part").node("decl").node("work").node("verify").node("integrate")
        .node("plan").node("human").node("doctrine")
        .edge("cp", dst: "part").edge("part", dst: "decl").edge("decl", dst: "work")
        .edge("work", dst: "verify").edge("verify", dst: "integrate").edge("integrate", dst: "cp")
        .edge("work", dst: "decl", label: "release").edge("decl", dst: "plan").edge("human", dst: "plan")
        .zone("loop", members: ["cp", "part", "decl", "work", "verify", "integrate"])
        .zone("watch", members: ["plan", "human"]);
}

test "a reversed edge runs outside the outermost row of the ranks it spans, takes no dummy slot, never moves a spine node" {
    final f = leaseLoopTwin();
    final d = f.diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {thrown(f)}");
    final spine = ["cp", "part", "decl", "work", "verify", "integrate"];
    final x = midX(nodeOf(d, id: "cp"));
    foreach (id in spine) { std\assert(midX(nodeOf(d, id: id)) == x, message: "{id} off the spine"); }
    final left = nodeOf(d, id: "cp").x;
    foreach (back in [edgeOf(d, src: "integrate", dst: "cp"), edgeOf(d, src: "work", dst: "decl")]) {
        std\assert(back != null and back!.dashed and back!.srcSide == "left" and back!.dstSide == "left", message: "leaves and lands across the flow");
        var k = 0;
        while (k < back!.via.len()) {
            std\assert(back!.via[k] <= left - FaceClear, message: "{back!.src}->{back!.dst} lane at {back!.via[k]} inside {left}");
            k = k + 2;
        }
    }
    final loop = d.zones[0];
    std\assert(edgeOf(d, src: "integrate", dst: "cp")!.via[0] > loop.x, message: "the loop's lanes stay inside its zone");
    std\assert(edgeOf(d, src: "integrate", dst: "cp")!.via[0] < edgeOf(d, src: "work", dst: "decl")!.via[0], message: "the longer lane runs outside the shorter");
    final pl = plan(compose(f));
    var li = 0;
    while (li < pl.chains.len()) {
        if (pl.reversed[li]) { std\assert(pl.chains[li].len() == 2, message: "a back edge claims no lane in the ranks it spans"); }
        li = li + 1;
    }
    std\assert(crossings(d).len() == 0, message: "and crosses nothing");
}

test "row lines its members up on one midline across ranks" {
    final shape = fun () > mut Flow {
        return fig().node("x").node("y").node("z").node("w")
            .edge("x", dst: "y").edge("x", dst: "z").edge("z", dst: "w");
    };
    final free = shape().diagram() catch Diagram{};
    std\assert(midY(nodeOf(free, id: "w")) != midY(nodeOf(free, id: "x")), message: "left alone, w follows z");
    final lined = shape().row(["x", "w"]).diagram() catch Diagram{};
    std\assert(validate(lined).len() == 0, message: "sound: {thrown(shape().row(["x", "w"]))}");
    std\assert(midY(nodeOf(lined, id: "w")) == midY(nodeOf(lined, id: "x")), message: "row puts w on x's midline");
    final crossed = thrown(fig().node("a").node("p").node("b").node("q")
        .edge("a", dst: "b").edge("p", dst: "q").row(["a", "q"]).row(["p", "b"]));
    std\assert(crossed.indexOf("row([") != null and crossed.indexOf("cannot line") != null, message: "two rows that cross are refused by name: {crossed}");
}

test "order fixes the cross order within a rank before the barycentre sweep" {
    final plain = fig().node("a").node("b").node("c").edge("a", dst: "b").edge("a", dst: "c").diagram() catch Diagram{};
    std\assert(nodeOf(plain, id: "b").y < nodeOf(plain, id: "c").y, message: "declaration order by default");
    final ordered = fig().node("a").node("b").node("c").edge("a", dst: "b").edge("a", dst: "c").order(["c", "b"]).diagram() catch Diagram{};
    std\assert(nodeOf(ordered, id: "c").y < nodeOf(ordered, id: "b").y, message: "order puts c first");
    std\assert(crossings(ordered).len() == 0, message: "and the slots follow");
    final banded = thrown(diamond().zone("one", members: ["c"]).order(["b", "c"]));
    std\assert(banded == "flow \"t\": order([\"b\", \"c\"]) puts \"b\" first, but it stacks in a later band than \"c\"; put both in one zone or drop the order",
        message: "an unzoned node cannot be ordered ahead of a zone: {banded}");
}

test "rank puts its members in one column" {
    final d = fig().node("a").node("b").node("c").node("x").node("y")
        .edge("a", dst: "b").edge("b", dst: "c").edge("x", dst: "y")
        .rank(["c", "y"])
        .diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound");
    std\assert(nodeOf(d, id: "y").x == nodeOf(d, id: "c").x, message: "y joins c's column");
    std\assert(nodeOf(d, id: "x").x == nodeOf(d, id: "a").x, message: "x keeps its own");
}

// Each shape below is a docs figure's, cut to the boxes and connectors whose placement the
// test pins.
test "commit-generated's decision spine runs down one column" {
    final d = fig().down()
        .node("start").node("pure", role: Role.decision).node("needed", role: Role.decision)
        .node("read", role: Role.decision).node("churn", role: Role.decision)
        .node("skip").node("commit")
        .edge("start", dst: "pure").edge("pure", dst: "needed").edge("needed", dst: "read").edge("read", dst: "churn")
        .edge("pure", dst: "skip").edge("needed", dst: "skip").edge("churn", dst: "skip")
        .edge("read", dst: "commit").edge("churn", dst: "commit")
        .diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {validate(d)}");
    final x = midX(nodeOf(d, id: "start"));
    foreach (id in ["pure", "needed", "read", "churn"]) { std\assert(midX(nodeOf(d, id: id)) == x, message: "{id} off the spine"); }
    final noDetour = edgeOf(d, src: "pure", dst: "skip");
    std\assert(noDetour != null and edgeLegs(d, e: noDetour!).len() <= 5, message: "pure -> skip turns at most four times: {edgeLegs(d, e: noDetour!).len()} legs");
}

test "volatility's questions line up rather than zigzag" {
    final d = fig().down()
        .node("fail").node("det", role: Role.decision).node("report").node("hist", role: Role.decision)
        .node("rate", role: Role.decision).node("retry").node("pass", role: Role.decision).node("volatile").node("regress")
        .edge("fail", dst: "det").edge("det", dst: "report").edge("det", dst: "hist").edge("hist", dst: "retry")
        .edge("hist", dst: "rate").edge("rate", dst: "retry").edge("rate", dst: "regress").edge("retry", dst: "pass")
        .edge("pass", dst: "volatile").edge("pass", dst: "regress")
        .diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {validate(d)}");
    final x = midX(nodeOf(d, id: "hist"));
    foreach (id in ["rate", "retry", "pass"]) { std\assert(midX(nodeOf(d, id: id)) == x, message: "{id} off hist's column"); }
    std\assert(midX(nodeOf(d, id: "fail")) == midX(nodeOf(d, id: "det")), message: "fail over det");
}

test "image-build's channel diamond shares a row with the middle of its fan, not the gap between two rows" {
    final d = fig()
        .node("run").node("cd", role: Role.decision).node("local").node("channel", role: Role.decision)
        .node("commit").node("unstable").node("stable")
        .edge("run", dst: "cd").edge("cd", dst: "local").edge("cd", dst: "channel")
        .edge("channel", dst: "commit").edge("channel", dst: "unstable").edge("channel", dst: "stable")
        .diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {validate(d)}");
    std\assert(midY(nodeOf(d, id: "run")) == midY(nodeOf(d, id: "cd")), message: "run and cd on one row");
    std\assert(midY(nodeOf(d, id: "channel")) == midY(nodeOf(d, id: "unstable")), message: "channel on its middle exit's row");
}

test "server-jobs' and server-share's one-child chains run straight" {
    final jobs = fig()
        .node("fs", sub: "x", tag: "x").node("cli").node("watch").node("idx").node("job").node("ws")
        .edge("fs", dst: "watch").edge("fs", dst: "idx").edge("cli", dst: "job")
        .edge("watch", dst: "ws").edge("idx", dst: "ws").edge("job", dst: "ws")
        .diagram() catch Diagram{};
    std\assert(validate(jobs).len() == 0, message: "jobs sound: {validate(jobs)}");
    std\assert(midY(nodeOf(jobs, id: "cli")) == midY(nodeOf(jobs, id: "job")), message: "magus run level with its only child");
    final share = fig()
        .node("dash").node("sharep").node("lan").node("phone").node("served").node("connectreads").node("withheld")
        .edge("dash", dst: "sharep").edge("sharep", dst: "lan").edge("phone", dst: "lan")
        .edge("lan", dst: "served").edge("lan", dst: "connectreads")
        .diagram() catch Diagram{};
    std\assert(validate(share).len() == 0, message: "share sound: {validate(share)}");
    std\assert(midY(nodeOf(share, id: "dash")) == midY(nodeOf(share, id: "sharep")) and midY(nodeOf(share, id: "sharep")) == midY(nodeOf(share, id: "lan")),
        message: "Console, share and LAN on one row");
}

test "ci-providers' long edge leaves its row once, with no hump" {
    final d = fig()
        .node("run").node("contract").node("quote").node("ops").node("prefixes").node("vendor")
        .edge("run", dst: "contract").edge("contract", dst: "ops").edge("ops", dst: "vendor")
        .edge("prefixes", dst: "quote", role: EdgeRole.optional).edge("quote", dst: "vendor")
        .zone("binary", members: ["run", "contract", "quote"]).zone("spell", members: ["ops", "prefixes"])
        .diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {validate(d)}");
    final long = edgeOf(d, src: "quote", dst: "vendor");
    std\assert(long != null and edgeLegs(d, e: long!).len() <= 3, message: "one jog at most: {edgeLegs(d, e: long!)}");
}

fun ciPipelineTwin() > mut Flow {
    final f = fig().node("cmd", label: "magus affected ci", role: Role.focal);
    foreach (id in ["generate", "format", "lint", "build", "test", "security"]) { f.node(id); }
    foreach (id in ["generate", "build", "format", "test", "lint", "security"]) { f.edge("cmd", dst: id); }
    return f;
}

// A port's first leg runs across the flow from the source's face; its one corner lands on
// the line its far end enters at.
fun portTurn(d: Diagram, e: Edge) > [int] {
    final legs = edgeLegs(d, e: e);
    return [legs[0][0], legs[0][1], legs[0][2], legs[0][3], legs.len()];
}

test "an edge whose target lies wholly beyond the source's cross span, with the source column clear, leaves top or bottom at the source midline and bends once, at the target midline" {
    final http = serverHttpTwin().rank(["mcp", "reads", "review", "connect", "health"]).diagram() catch Diagram{};
    final guard = nodeOf(http, id: "guard");
    final mcp = edgeOf(http, src: "guard", dst: "mcp")!;
    final up = portTurn(http, e: mcp);
    std\assert(mcp.srcSide == "top" and up[4] == 2, message: "guard->mcp leaves the top and turns once: {mcp.srcSide}, {edgeLegs(http, e: mcp)}");
    std\assert(up[0] == midX(guard) and up[3] == midY(nodeOf(http, id: "mcp")), message: "at the Guard's midline, turning on /mcp's: {up}");
    final connect = edgeOf(http, src: "guard", dst: "connect")!;
    std\assert(connect.srcSide == "bottom" and portTurn(http, e: connect)[0] == midX(guard), message: "the farthest route below takes the bottom midline");
    std\assert(edgeOf(http, src: "guard", dst: "reads")!.srcSide == "right", message: "the route on the Guard's row stays on the forward face");
    std\assert(validate(http).len() == 0 and crossings(http).len() == 0, message: "clean: {validate(http)}");

    final ci = ciPipelineTwin().diagram() catch Diagram{};
    final cmd = nodeOf(ci, id: "cmd");
    final gen = edgeOf(ci, src: "cmd", dst: "generate")!;
    final climb = portTurn(ci, e: gen);
    std\assert(gen.srcSide == "top" and climb[4] == 2 and climb[0] == midX(cmd) and climb[3] == midY(nodeOf(ci, id: "generate")),
        message: "cmd->generate leaves the top at the midline and turns once: {edgeLegs(ci, e: gen)}");
    std\assert(validate(ci).len() == 0 and crossings(ci).len() == 0, message: "the whole fan clean: {validate(ci)}");

    final across = fig().down().node("s").node("a").node("b").edge("s", dst: "a").edge("s", dst: "b").diagram() catch Diagram{};
    final sb = edgeOf(across, src: "s", dst: "b")!;
    final side = portTurn(across, e: sb);
    std\assert(sb.srcSide == "right" and side[4] == 2 and side[1] == midY(nodeOf(across, id: "s")) and side[2] == midX(nodeOf(across, id: "b")),
        message: "transposed, the port leaves the side and turns down into b: {sb.srcSide}, {edgeLegs(across, e: sb)}");

    // server-socket: the optional spawn sits in the socket's column below it, so the routes
    // below keep the forward face and turn in the gap.
    final socket = fig()
        .node("cli").node("sock").node("pool").node("ws").node("runs").node("svc").node("serve")
        .edge("cli", dst: "sock").edge("sock", dst: "pool").edge("sock", dst: "ws").edge("sock", dst: "runs").edge("sock", dst: "svc")
        .edge("cli", dst: "serve", role: EdgeRole.optional)
        .diagram() catch Diagram{};
    std\assert(edgeOf(socket, src: "sock", dst: "svc")!.srcSide == "right", message: "a box in the column keeps the side port");
    std\assert(edgeOf(socket, src: "sock", dst: "pool")!.srcSide == "top", message: "while the clear side takes the port");

    // ci-providers: quote_prefixes sits in the spell band below the binary band it feeds; a
    // port would climb out through both borders.
    final bands = fig()
        .node("run").node("contract").node("quote").node("ops").node("prefixes").node("vendor")
        .edge("run", dst: "contract").edge("contract", dst: "ops").edge("ops", dst: "vendor")
        .edge("prefixes", dst: "quote", role: EdgeRole.optional).edge("quote", dst: "vendor")
        .zone("binary", members: ["run", "contract", "quote"]).zone("spell", members: ["ops", "prefixes"])
        .diagram() catch Diagram{};
    std\assert(edgeOf(bands, src: "prefixes", dst: "quote")!.srcSide == "right", message: "a zone border in the column keeps the side port");
}

fun volatilityTwin() > mut Flow {
    return fig().down()
        .node("fail").node("det", role: Role.decision).node("report").node("hist", role: Role.decision)
        .node("rate", role: Role.decision).node("retry").node("pass", role: Role.decision).node("volatile").node("regress")
        .edge("fail", dst: "det").edge("det", dst: "report").edge("det", dst: "hist").edge("hist", dst: "retry")
        .edge("hist", dst: "rate").edge("rate", dst: "retry").edge("rate", dst: "regress").edge("retry", dst: "pass")
        .edge("pass", dst: "volatile").edge("pass", dst: "regress");
}

// Bends are legs less one. hist->retry took five before its side vertex turned straight
// onto the lane beside rate.
test "a decision's out-edge to a target on its own midline takes the outbound vertex" {
    final d = volatilityTwin().diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {validate(d)}");
    std\assert(edgeOf(d, src: "hist", dst: "rate")!.srcSide == "bottom", message: "rate, straight below, takes the outbound vertex");
    std\assert(edgeOf(d, src: "det", dst: "report")!.srcSide == "bottom", message: "report, straight below, takes the outbound vertex");
    final retry = edgeOf(d, src: "hist", dst: "retry")!;
    std\assert(retry.srcSide == "right" and edgeLegs(d, e: retry).len() == 4, message: "hist->retry bends three times: {edgeLegs(d, e: retry)}");
    std\assert(edgeLegs(d, e: edgeOf(d, src: "det", dst: "hist")!).len() == 2, message: "det->hist turns once");
    std\assert(edgeLegs(d, e: edgeOf(d, src: "rate", dst: "regress")!).len() == 2, message: "rate->regress turns once onto its lane");
    foreach (first in [true, false]) {
        final f = fig().node("q", role: Role.decision).node("m").node("b").edge("q", dst: "m").edge("q", dst: "b");
        if (first == false) { f.order(["b", "m"]); }
        final two = f.row(["q", "m"]).diagram() catch Diagram{};
        std\assert(edgeOf(two, src: "q", dst: "m")!.srcSide == "right", message: "the midline exit sorted first={first} still leaves the outbound vertex");
        std\assert(edgeLegs(two, e: edgeOf(two, src: "q", dst: "m")!).len() == 1, message: "and runs straight");
    }
}

fun commitGeneratedTwin() > mut Flow {
    return fig().down()
        .node("start").node("pure", role: Role.decision).node("needed", role: Role.decision)
        .node("read", role: Role.decision).node("churn", role: Role.decision)
        .node("skip", sub: "CI builds it").node("commit", sub: "generate is the gate", role: Role.focal)
        .edge("start", dst: "pure").edge("pure", dst: "needed", label: "yes").edge("needed", dst: "read", label: "no")
        .edge("read", dst: "churn", label: "no").edge("pure", dst: "skip", label: "no").edge("needed", dst: "skip", label: "yes")
        .edge("churn", dst: "skip", label: "yes").edge("read", dst: "commit", label: "yes").edge("churn", dst: "commit", label: "no");
}

test "every proper crossing hops the dashed or lesser edge" {
    final d = commitGeneratedTwin().diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {validate(d)}");
    final found = crossings(d);
    std\assert(found.len() == 1, message: "one crossing: {found.len()}");
    final bridged = d.edges[found[0].bridged];
    final kept = d.edges[found[0].kept];
    std\assert(bridged.src == "read" and bridged.dst == "commit" and kept.src == "churn" and kept.dst == "skip",
        message: "of two plain edges the later-declared hops: {bridged.src}->{bridged.dst} over {kept.src}->{kept.dst}");
    final svg = commitGeneratedTwin().svg(lightPalette()) catch "threw";
    final hop = "A 8 8 0 0 0 {found[0].x - 8} {found[0].y}";
    std\assert(svg.indexOf(hop) != null, message: "read->commit, running left, bulges up over {found[0].x},{found[0].y}");

    final providers = fig()
        .node("run").node("contract").node("quote").node("ops").node("prefixes").node("vendor")
        .edge("run", dst: "contract").edge("contract", dst: "ops").edge("ops", dst: "vendor")
        .edge("prefixes", dst: "quote", role: EdgeRole.optional).edge("quote", dst: "vendor")
        .zone("binary", members: ["run", "contract", "quote"]).zone("spell", members: ["ops", "prefixes"])
        .diagram() catch Diagram{};
    final pc = crossings(providers);
    std\assert(pc.len() == 1 and providers.edges[pc[0].bridged].src == "quote", message: "quote->vendor hops contract->ops: {pc.len()}");
}

test "a bent-route label never touches a stroke" {
    final f = fig()
        .node("run", role: Role.focal).node("cd", role: Role.decision).node("local", sub: "pushes nothing").node("channel", role: Role.decision)
        .node("commit", sub: "ghcr, tagged by hash").node("unstable", sub: "no floating tag").node("stable", sub: "version and latest")
        .edge("run", dst: "cd").edge("cd", dst: "local", label: "no").edge("cd", dst: "channel", label: "yes")
        .edge("channel", dst: "commit", label: "default").edge("channel", dst: "unstable", label: "unstable")
        .edge("channel", dst: "stable", label: "stable");
    final d = f.diagram() catch Diagram{};
    std\assert(validate(d).len() == 0, message: "sound: {thrown(f)}");
    final strokes: mut [[int]] = mut [<[int]>];
    foreach (e in d.edges) {
        foreach (leg in edgeLegs(d, e: e)) { strokes.append(leg); }
    }
    final masks: mut [[int]] = mut [<[int]>];
    foreach (e in d.edges) {
        if (e.label != "") {
            final at = labelPlacement(d, e: e);
            final lx = at[0] - at[2] / 2 - 6;
            final ly = at[1] - 8 - 6;
            final hx = at[0] + at[2] / 2 + 6;
            final hy = at[1] + 4 + 6;
            foreach (s in strokes) {
                final touches = imin(s[0], b: s[2]) < hx and imax(s[0], b: s[2]) > lx and imin(s[1], b: s[3]) < hy and imax(s[1], b: s[3]) > ly;
                std\assert(touches == false, message: "{e.label} at {at} within 6px of {s}");
            }
            foreach (m in masks) {
                std\assert((m[0] < hx and m[2] > lx and m[1] < hy and m[3] > ly) == false, message: "{e.label} at {at} within 6px of the label at {m}");
            }
            masks.append([at[0] - at[2] / 2, at[1] - 8, at[0] + at[2] / 2, at[1] + 4]);
        }
    }
    // An 80px mask has no room on a 72px gap between two boxes, so the gap widens for it.
    final wide = fig().node("a").node("b").edge("a", dst: "b", label: "abcdefghijklmn");
    std\assert(thrown(wide) == "", message: "the gap widens for the label: {thrown(wide)}");
    final pair = wide.diagram() catch Diagram{};
    std\assert(nodeOf(pair, id: "b").x - nodeOf(pair, id: "a").x - nodeOf(pair, id: "a").w > LayerColGap, message: "wider than the house gap");
    std\assert(layoutFindings([Fault{ rule = "label", subjects = ["a", "b"] }])[0]
        == "edge \"a\" -> \"b\" label has no spot clear of every stroke, box and label; shorten it or split the figure",
        message: "past the widening rounds it is a finding naming the edge");
}


// The figure surface. Everything above is the layout and the renderer, private to this
// module; everything below is what an author calls.

// Look picks a box's treatment. focal takes the accent, two per figure counting focal
// strokes; store is a persistent thing; external sits outside what the figure depicts;
// input is data arriving from outside; optional is dashed; decision is a diamond with at
// most three exits, for an external alone.
export enum<str> Look { plain, focal, store, external, input, optional, decision }

// Stroke picks a connector's treatment: focal takes the accent, external the link colour
// of a call leaving the system, optional is dashed.
export enum<str> Stroke { plain, focal, external, optional }

// Theme picks the palette svg() paints with: page follows the docs site's CSS variables,
// light and dark bake hex for a file a page cannot style.
export enum<str> Theme { page, light, dark }

// DirSet is an immutable set of Dir records, kept sorted by path. A set built from a Layer
// holds every directory the layer covers, so a package added to the layer joins whatever
// the set feeds without an edit to the figure.
export object DirSet {
    dirs: [magus\Dir] = [<magus\Dir>],
    // How the set was built, for findings: layerSet("handler").without([...]).
    named: str = "",

    // without drops dirs from the set. Raises naming any it does not hold, so a drop left
    // behind by a rename fails rather than hiding nothing.
    fun without(drop: [magus\Dir]) > DirSet !> str {
        mustBeDirs(drop, call: "{this.named}.without");
        final gone: mut {str: bool} = mut {<str: bool>};
        foreach (d in drop) {
            if (this.holds(d.path) == false) {
                throw "{this.named}.without names {quote(d.path)}, which the set does not hold; drop it from without([...])";
            }
            gone[d.path] = true;
        }
        final kept: mut [magus\Dir] = mut [<magus\Dir>];
        foreach (d in this.dirs) {
            if (gone[d.path] == null) { kept.append(d); }
        }
        return DirSet{ dirs = kept, named = "{this.named}.without({pathList(drop)})" };
    }

    // plus adds dirs to the set. Raises naming any it already holds.
    fun plus(add: [magus\Dir]) > DirSet !> str {
        mustBeDirs(add, call: "{this.named}.plus");
        final all: mut [magus\Dir] = mut [<magus\Dir>];
        foreach (d in this.dirs) { all.append(d); }
        foreach (d in add) {
            if (this.holds(d.path)) {
                throw "{this.named}.plus names {quote(d.path)}, which the set already holds; drop it from plus([...])";
            }
            all.append(d);
        }
        return DirSet{ dirs = sortedDirs(all), named = "{this.named}.plus({pathList(add)})" };
    }

    fun holds(path: str) > bool {
        foreach (d in this.dirs) {
            if (d.path == path) { return true; }
        }
        return false;
    }

    fun paths() > [str] {
        final list: mut [str] = mut [<str>];
        foreach (d in this.dirs) { list.append(d.path); }
        return list;
    }
}

// setOf is the set of the given dirs; a dir named twice is held once. Raises when an item
// is not a Dir record.
export fun setOf(dirs: [magus\Dir]) > DirSet !> str {
    mustBeDirs(dirs, call: "setOf");
    final seen: mut {str: bool} = mut {<str: bool>};
    final kept: mut [magus\Dir] = mut [<magus\Dir>];
    foreach (d in dirs) {
        if (seen[d.path] == null) {
            seen[d.path] = true;
            kept.append(d);
        }
    }
    return DirSet{ dirs = sortedDirs(kept), named = "setOf({pathList(dirs)})" };
}

// layerSet is every directory layer covers. Raises when layer is not a Layer record.
export fun layerSet(layer: magus\Layer) > DirSet !> str {
    final name: str? = layer.name;
    final dirs: [magus\Dir]? = layer.dirs;
    if (name == null or dirs == null) { throw "layerSet takes a Layer from magus\\layer, and this argument is not one"; }
    final call = "layerSet({quote(name!)})";
    mustBeDirs(dirs!, call: call);
    return DirSet{ dirs = sortedDirs(dirs!), named = call };
}

// recordPath is a Dir's path, or empty when d is not a Dir record. The checker lets any
// value through where a host record is declared, so every entry point asks.
fun recordPath(d: magus\Dir) > str {
    final path: str? = d.path;
    return path ?? "";
}

fun mustBeDirs(dirs: [magus\Dir], call: str) > void !> str {
    var i = 0;
    while (i < dirs.len()) {
        if (recordPath(dirs[i]) == "") {
            throw "{call} takes Dir records from magus\\dir or magus\\dirs, and item {i} is not one";
        }
        i = i + 1;
    }
}

// Actor is a box that names no directory: a person, a vendor service, a step in a
// process. Build one with external().
export object Actor {
    name: str = "",
    sub: str = "",
    tag: str = "",
    // A URL for what the actor is; painted as a link, never checked.
    link: str = "",
    // The Look's value, or empty when the caller passed something that is not a Look.
    look: str = "external",
}

// external is an actor the figure draws but no directory holds. look defaults to
// Look.external.
//
// The enum parameter defaults to null rather than a case: gopherbuzz resolves a default in
// the caller's scope.
export fun external(name: str, sub: str = "", tag: str = "", link: str = "", look: Look? = null) > Actor {
    final l: str? = (look ?? Look.external).value;
    return Actor{ name = name, sub = sub, tag = tag, link = link, look = l ?? "" };
}

// Part is one drawn box: a Dir, a group of Dirs, or an Actor.
object Part {
    id: str = "",
    kind: str = "",
    // How the author spelled the declaration, for findings.
    call: str = "",
    label: str = "",
    sub: str = "",
    tag: str = "",
    role: str = "default",
    dirs: [str] = [<str>],
    anchor: str = "",
    line: int = 0,
    link: str = "",
}

object Exclusion {
    dirs: [str] = [<str>],
    why: str = "",
    call: str = "",
}

object EdgeHide {
    src: [str] = [<str>],
    dst: [str] = [<str>],
    why: str = "",
    call: str = "",
}

object EdgeMark {
    src: str = "",
    dst: str = "",
    label: str = "",
    kind: str = "default",
    dashed: bool = false,
    call: str = "",
}

// HandEdge is a connector the graph cannot hold, so its author draws it. At least one end
// is an Actor; srcDir and dstDir name the other end's directory when it has one.
object HandEdge {
    srcActor: str = "",
    srcDir: str = "",
    dstActor: str = "",
    dstDir: str = "",
    label: str = "",
    kind: str = "default",
    dashed: bool = false,
    call: str = "",
}

// Band is a zone, boundary, rank or row over drawn boxes.
object Band {
    verb: str = "",
    label: str = "",
    dirs: [str] = [<str>],
    actors: [str] = [<str>],
    call: str = "",
}

// Figure is a figure under construction: of() starts one, and diagram() or svg() lays it
// out. Declarations never raise; diagram() raises every finding at once, one per line,
// each naming the call to change.
export object Figure {
    id: str = "",
    titleText: str = "",
    eyebrowText: str = "",
    descText: str = "",
    topDown: bool = false,
    isGenerated: bool = false,
    isUnscoped: bool = false,
    unscopedWhy: str = "",
    graphEdges: bool = false,
    records: mut {str: magus\Dir},
    parts: mut [Part],
    actorRecords: mut {str: Actor},
    scopes: mut [DirSet],
    exclusions: mut [Exclusion],
    hides: mut [EdgeHide],
    marks: mut [EdgeMark],
    hand: mut [HandEdge],
    bands: mut [Band],
    legends: mut [LegendItem],
    findings: mut [str],

    mut fun title(t: str) > mut Figure {
        this.titleText = t;
        return this;
    }

    mut fun eyebrow(e: str) > mut Figure {
        this.eyebrowText = e;
        return this;
    }

    mut fun desc(d: str) > mut Figure {
        this.descText = d;
        return this;
    }

    // down lays ranks out top to bottom instead of left to right.
    mut fun down() > mut Figure {
        this.topDown = true;
        return this;
    }

    // generated marks a figure computed from data nobody authored: the hand-authored node,
    // edge, accent and zone budgets stop applying, and it needs no code.
    mut fun generated() > mut Figure {
        this.isGenerated = true;
        return this;
    }

    // unscoped says why a figure draws no directory: a decision process, a CI arrangement.
    mut fun unscoped(why: str) > mut Figure {
        this.isUnscoped = true;
        this.unscopedWhy = why;
        return this;
    }

    // box draws one directory. The label defaults to its path. symbol anchors the box at a
    // function or type the directory defines, from magus\refs; a symbol defined elsewhere
    // is a finding. focal is Look.focal.
    mut fun box(dir: magus\Dir, label: str = "", sub: str = "", tag: str = "", focal: bool = false, look: Look? = null, symbol: magus\RefsResult? = null) > mut Figure {
        if (recordPath(dir) == "") {
            this.findings.append("box takes a Dir from magus\\dir, and this argument is not one");
            return this;
        }
        final call = "box({quote(dir.path)})";
        this.records[dir.path] = dir;
        final role = this.roleOf(call, focal: focal, look: look);
        if (role == "decision") {
            this.findings.append("{call} is a Look.decision; a directory is never a diamond, so draw the decision with external()");
        }
        var anchor = dir.path;
        var line = 0;
        if (symbol != null) {
            final refs = symbol!;
            var found = false;
            final elsewhere: mut [str] = mut [<str>];
            foreach (site in refs.defs) {
                if (found == false and inside(site.file, dir: dir.path)) {
                    found = true;
                    anchor = site.file;
                    if (site.lines.len() > 0) { line = site.lines[0]; }
                }
                if (inside(site.file, dir: dir.path) == false) { elsewhere.append(site.file); }
            }
            if (refs.defs.len() == 0) {
                this.findings.append("{call} anchors symbol {quote(refs.symbol)}, which has no definition in the index; drop symbol: or rebuild the index with `magus graph build`");
            } else {
                if (found == false) {
                    this.findings.append("{call} anchors symbol {quote(refs.symbol)}, defined in {elsewhere.join(", ")}; box the directory that defines it");
                }
            }
        }
        this.parts.append(Part{
            id = dir.path, kind = "box", call = call, label = shownLabel(label, id: dir.path), sub = sub, tag = tag,
            role = role, dirs = [dir.path], anchor = anchor, line = line,
        });
        return this;
    }

    // group draws every directory in set as one box. A directory joining the set later
    // joins the box with it.
    mut fun group(set: DirSet, label: str, sub: str = "", tag: str = "", focal: bool = false, look: Look? = null) > mut Figure {
        final call = "group({quote(label)})";
        if (label == "") { this.findings.append("group over {set.named} has no label; name what the box stands for in group(set, label:)"); }
        if (set.dirs.len() == 0) {
            this.findings.append("{call} takes {set.named}, which holds no directory; drop the group or give it a set that holds one");
        }
        foreach (d in set.dirs) { this.records[d.path] = d; }
        final role = this.roleOf(call, focal: focal, look: look);
        if (role == "decision") {
            this.findings.append("{call} is a Look.decision; a group of directories is never a diamond");
        }
        this.parts.append(Part{
            id = "group:" + label, kind = "group", call = call, label = label, sub = sub, tag = tag,
            role = role, dirs = set.paths(),
        });
        return this;
    }

    // actor draws an Actor. flowIn, flowOut and flowAcross draw theirs on first use, so
    // actor() only fixes where one falls in declaration order.
    mut fun actor(a: Actor) > mut Figure {
        this.drawActor(a);
        return this;
    }

    // scope names directories the figure answers for: each must be drawn by a box or a
    // group, or excluded with except(set, why:).
    mut fun scope(set: DirSet) > mut Figure {
        foreach (d in set.dirs) { this.records[d.path] = d; }
        this.scopes.append(set);
        return this;
    }

    // except leaves directories in scope undrawn on purpose; why reaches the drift summary.
    mut fun except(set: DirSet, why: str) > mut Figure {
        final call = "except({set.named})";
        if (why == "") { this.findings.append("{call} gives no reason; say why in except(set, why:)"); }
        if (set.dirs.len() == 0) { this.findings.append("{call} excludes nothing; drop it"); }
        this.exclusions.append(Exclusion{ dirs = set.paths(), why = why, call = call });
        return this;
    }

    // edgesFromGraph draws what the records hold between drawn boxes: every import, claimed
    // imports, and every declared magus:calls marker, claimed calls. An edge inside one
    // group is not drawn. Every drawn directory must carry a symbol index.
    mut fun edgesFromGraph() > mut Figure {
        this.graphEdges = true;
        return this;
    }

    // hideEdges keeps the graph's edges from a directory in src to one in dst out of the
    // picture. why is required, and a hide that matches nothing is a finding.
    mut fun hideEdges(src: DirSet, dst: DirSet, why: str) > mut Figure {
        final call = "hideEdges({src.named}, dst: {dst.named})";
        if (why == "") { this.findings.append("{call} gives no reason; say why in hideEdges(src, dst:, why:)"); }
        this.hides.append(EdgeHide{ src = src.paths(), dst = dst.paths(), why = why, call = call });
        return this;
    }

    // markEdge labels or strokes the edge edgesFromGraph() draws from the box holding src to
    // the box holding dst.
    mut fun markEdge(src: magus\Dir, dst: magus\Dir, label: str = "", stroke: Stroke? = null) > mut Figure {
        if (recordPath(src) == "" or recordPath(dst) == "") {
            this.findings.append("markEdge takes Dir records from magus\\dir at both ends");
            return this;
        }
        final call = "markEdge({quote(src.path)}, dst: {quote(dst.path)})";
        final m = mut EdgeMark{ src = src.path, dst = dst.path, label = label, call = call };
        this.strokeOf(call, stroke: stroke, into: m);
        this.marks.append(m);
        return this;
    }

    // flowIn draws a hand edge from an actor to the box holding dir: flow the graph cannot
    // hold, such as a person running a tool. It claims flow, which nothing checks.
    mut fun flowIn(src: Actor, dst: magus\Dir, label: str = "", stroke: Stroke? = null) > mut Figure {
        this.drawActor(src);
        if (recordPath(dst) == "") {
            this.findings.append("flowIn({quote(src.name)}) takes a Dir from magus\\dir as dst");
            return this;
        }
        final call = "flowIn({quote(src.name)}, dst: {quote(dst.path)})";
        this.addHand(call, edge: HandEdge{ srcActor = src.name, dstDir = dst.path, label = label }, stroke: stroke);
        return this;
    }

    // flowOut draws a hand edge from the box holding dir to an actor.
    mut fun flowOut(src: magus\Dir, dst: Actor, label: str = "", stroke: Stroke? = null) > mut Figure {
        this.drawActor(dst);
        if (recordPath(src) == "") {
            this.findings.append("flowOut(dst: {quote(dst.name)}) takes a Dir from magus\\dir as src");
            return this;
        }
        final call = "flowOut({quote(src.path)}, dst: {quote(dst.name)})";
        this.addHand(call, edge: HandEdge{ srcDir = src.path, dstActor = dst.name, label = label }, stroke: stroke);
        return this;
    }

    // flowAcross draws a hand edge between two actors.
    mut fun flowAcross(src: Actor, dst: Actor, label: str = "", stroke: Stroke? = null) > mut Figure {
        this.drawActor(src);
        this.drawActor(dst);
        final call = "flowAcross({quote(src.name)}, dst: {quote(dst.name)})";
        this.addHand(call, edge: HandEdge{ srcActor = src.name, dstActor = dst.name, label = label }, stroke: stroke);
        return this;
    }

    // zone stacks the boxes drawing dirs, and the actors, into one band. A group joins
    // only whole: a zone taking part of one is a finding.
    mut fun zone(label: str, dirs: DirSet? = null, actors: [Actor]? = null) > mut Figure {
        this.bands.append(bandOf("zone", label: label, dirs: dirs, actors: actors));
        return this;
    }

    // boundary is a zone painted as a trust boundary.
    mut fun boundary(label: str, dirs: DirSet? = null, actors: [Actor]? = null) > mut Figure {
        this.bands.append(bandOf("boundary", label: label, dirs: dirs, actors: actors));
        return this;
    }

    // rank puts the boxes drawing dirs, and the actors, in one rank.
    mut fun rank(dirs: DirSet? = null, actors: [Actor]? = null) > mut Figure {
        this.bands.append(bandOf("rank", label: "", dirs: dirs, actors: actors));
        return this;
    }

    // row lines the boxes drawing dirs, and the actors, up on one midline across ranks.
    mut fun row(dirs: DirSet? = null, actors: [Actor]? = null) > mut Figure {
        this.bands.append(bandOf("row", label: "", dirs: dirs, actors: actors));
        return this;
    }

    mut fun legend(look: Look, label: str) > mut Figure {
        final r: str? = look.value;
        if (r == null) { this.findings.append("legend {quote(label)} takes look: Look.<case>, not a string"); }
        this.legends.append(LegendItem{ role = roleName(r ?? "plain"), label = label });
        return this;
    }

    // diagram lays the figure out. Raises every finding, one per line, each naming the call
    // to change. Same declarations and records, same Diagram.
    fun diagram() > Diagram !> str {
        final f = lowered(this);
        try {
            return layoutFlow(f);
        } catch (msg: str) {
            throw revoiced(msg);
        }
        return Diagram{};
    }

    // svg lays the figure out and paints it. anchorHref is a URL template: {path} takes a
    // box's anchor and {line} its symbol's line.
    fun svg(theme: Theme, anchorHref: str = "") > str !> str {
        final named: str? = theme.value;
        if (named == null) { throw "figure {quote(this.id)}: svg takes theme: Theme.<case>, not a string"; }
        final d = this.diagram();
        var p = cssVarPalette();
        if (theme == Theme.light) { p = lightPalette(); }
        if (theme == Theme.dark) { p = darkPalette(); }
        return renderSvg(d, p: p, s: Style{ anchorHref = anchorHref });
    }

    mut fun roleOf(call: str, focal: bool, look: Look?) > str {
        final named: str? = (look ?? Look.plain).value;
        if (named == null) {
            this.findings.append("{call} takes look: Look.<case>, not a string");
            return "default";
        }
        if (focal and look != null and named! != "focal") {
            this.findings.append("{call} sets focal: true and look: Look.{named!}; keep one");
        }
        if (focal) { return "focal"; }
        return roleName(named!);
    }

    mut fun strokeOf(call: str, stroke: Stroke?, into: mut EdgeMark) > void {
        final named: str? = (stroke ?? Stroke.plain).value;
        if (named == null) {
            this.findings.append("{call} takes stroke: Stroke.<case>, not a string");
            return;
        }
        if (named! == "focal") { into.kind = "accent"; }
        if (named! == "external") { into.kind = "link"; }
        into.dashed = named! == "optional";
    }

    mut fun addHand(call: str, edge: HandEdge, stroke: Stroke?) > void {
        final m = mut EdgeMark{};
        this.strokeOf(call, stroke: stroke, into: m);
        this.hand.append(HandEdge{
            srcActor = edge.srcActor, srcDir = edge.srcDir, dstActor = edge.dstActor, dstDir = edge.dstDir,
            label = edge.label, kind = m.kind, dashed = m.dashed, call = call,
        });
    }

    mut fun drawActor(a: Actor) > void {
        final call = "external({quote(a.name)})";
        if (a.name == "") {
            this.findings.append("an external has no name; name what it stands for in external(name)");
            return;
        }
        final prior = this.actorRecords[a.name];
        if (prior != null) {
            final p = prior!;
            if (p.sub != a.sub or p.tag != a.tag or p.link != a.link or p.look != a.look) {
                this.findings.append("{call} is built twice with different fields; build it once and reuse it");
            }
            return;
        }
        this.actorRecords[a.name] = a;
        if (a.look == "") { this.findings.append("{call} takes look: Look.<case>, not a string"); }
        this.parts.append(Part{
            id = actorId(a.name), kind = "actor", call = call, label = a.name, sub = a.sub, tag = a.tag,
            role = roleName(a.look), link = a.link,
        });
    }
}

// of starts an empty left-to-right figure. The collections are built here because a mut
// collection field cannot carry a default.
export fun of(id: str) > mut Figure {
    return mut Figure{
        id = id,
        records = mut {<str: magus\Dir>},
        parts = mut [<Part>],
        actorRecords = mut {<str: Actor>},
        scopes = mut [<DirSet>],
        exclusions = mut [<Exclusion>],
        hides = mut [<EdgeHide>],
        marks = mut [<EdgeMark>],
        hand = mut [<HandEdge>],
        bands = mut [<Band>],
        legends = mut [<LegendItem>],
        findings = mut [<str>],
    };
}

fun roleName(look: str) > str {
    if (look == "plain") { return "default"; }
    return look;
}

fun actorId(name: str) > str {
    return "external:" + name;
}

fun pathList(dirs: [magus\Dir]) > str {
    final quoted: mut [str] = mut [<str>];
    foreach (d in dirs) { quoted.append(quote(d.path)); }
    return "[" + quoted.join(", ") + "]";
}

fun sortedDirs(dirs: [magus\Dir]) > [magus\Dir] {
    final copy: mut [magus\Dir] = mut [<magus\Dir>];
    foreach (d in dirs) { copy.append(d); }
    return copy.sort(fun (a: magus\Dir, b: magus\Dir) > bool { return a.path < b.path; });
}

// inside reports whether a workspace-relative file sits in dir, "." holding everything.
fun inside(file: str, dir: str) > bool {
    if (dir == ".") { return true; }
    return file.startsWith(dir + "/");
}

fun bandOf(verb: str, label: str, dirs: DirSet?, actors: [Actor]?) > Band {
    final paths: mut [str] = mut [<str>];
    var named = "";
    if (dirs != null) {
        foreach (p in dirs!.paths()) { paths.append(p); }
        named = dirs!.named;
    }
    final names: mut [str] = mut [<str>];
    foreach (a in actors ?? [<Actor>]) { names.append(a.name); }
    var call = "{verb}({named})";
    if (label != "") { call = "{verb}({quote(label)})"; }
    return Band{ verb = verb, label = label, dirs = paths, actors = names, call = call };
}

// revoiced turns the layout's findings, spoken for flow(), into the figure's own.
fun revoiced(msg: str) > str {
    return msg.replace("flow \"", with: "figure \"").replace("one flow() each", with: "one figure\\of() each");
}

// Derived is one part-to-part edge the graph holds.
object Derived {
    src: str = "",
    dst: str = "",
    claim: str = "imports",
}

// lowered checks the figure against its records and turns it into the flow the layout
// places, or raises every finding at once.
fun lowered(fig: Figure) > Flow !> str {
    final found: mut [str] = mut [<str>];
    foreach (msg in fig.findings) { found.append(msg); }

    final drawnBy: mut {str: str} = mut {<str: str>};
    final callOf: mut {str: str} = mut {<str: str>};
    final order: mut {str: int} = mut {<str: int>};
    var codeParts = 0;
    var i = 0;
    while (i < fig.parts.len()) {
        final part = fig.parts[i];
        if (order[part.id] != null) {
            found.append("{part.call} is declared twice; keep one");
        } else {
            order[part.id] = i;
            callOf[part.id] = part.call;
        }
        if (part.kind != "actor") { codeParts = codeParts + 1; }
        foreach (d in part.dirs) {
            final prior = drawnBy[d];
            if (prior != null and prior! != part.id) {
                found.append("{quote(d)} is drawn by {callOf[prior!] ?? prior!} and {part.call}; draw it once, dropping it from a group's set with .without([...])");
            }
            if (prior == null) { drawnBy[d] = part.id; }
        }
        i = i + 1;
    }

    final excluded: mut {str: str} = mut {<str: str>};
    foreach (ex in fig.exclusions) {
        foreach (d in ex.dirs) {
            final by = drawnBy[d];
            if (by != null) {
                found.append("{ex.call} excludes {quote(d)}, which {callOf[by!] ?? by!} draws; drop one of them");
            }
            excluded[d] = ex.why;
        }
    }
    final scoped: mut {str: bool} = mut {<str: bool>};
    foreach (s in fig.scopes) {
        foreach (d in s.dirs) {
            if (scoped[d.path] != null) { continue; }
            scoped[d.path] = true;
            if (drawnBy[d.path] == null and excluded[d.path] == null) {
                found.append("{quote(d.path)} is in scope({s.named}) but nothing draws it; add it to a box or a group, or except(setOf([...]), why:)");
            }
        }
    }
    foreach (ex in fig.exclusions) {
        foreach (d in ex.dirs) {
            if (scoped[d] == null) {
                found.append("{ex.call} excludes {quote(d)}, which no scope(...) holds; drop it from the except");
            }
        }
    }

    if (codeParts == 0 and fig.isUnscoped == false and fig.isGenerated == false) {
        found.append("draws no directory; draw a box() or group(), or say why in unscoped(why:)");
    }
    if (codeParts > 0 and fig.isUnscoped) {
        found.append("draws directories and declares unscoped(why:); drop the unscoped");
    }
    if (fig.isUnscoped and fig.unscopedWhy == "") {
        found.append("unscoped gives no reason; say why in unscoped(why:)");
    }
    if (codeParts > 1 and fig.graphEdges == false and fig.isGenerated == false) {
        found.append("draws {codeParts} boxes of code and no edge between them; call edgesFromGraph()");
    }

    // Graph edges, directory pair by directory pair, before they fold into boxes.
    final derived: mut {str: Derived} = mut {<str: Derived>};
    final hideUsed: mut [bool] = mut [<bool>];
    while (hideUsed.len() < fig.hides.len()) { hideUsed.append(false); }
    if (fig.graphEdges) {
        foreach (part in fig.parts) {
            foreach (path in part.dirs) {
                final rec = fig.records[path];
                if (rec == null) { continue; }
                final d = rec!;
                if (d.importsIndexed == false) {
                    found.append("{quote(path)} has no symbol index, so its imports are unknown and edgesFromGraph() cannot draw them; build it with `magus graph build`");
                }
                foreach (imp in d.imports) {
                    foldPair(fig, derived: derived, hideUsed: hideUsed, drawnBy: drawnBy, src: path, dst: imp, claim: "imports");
                }
                foreach (c in d.calls) {
                    foldPair(fig, derived: derived, hideUsed: hideUsed, drawnBy: drawnBy, src: path, dst: c.dir, claim: "calls");
                }
            }
        }
    }
    i = 0;
    while (i < fig.hides.len()) {
        if (hideUsed[i] == false) {
            found.append("{fig.hides[i].call} hides no edge the graph draws; drop it");
        }
        i = i + 1;
    }

    final marked: mut {str: EdgeMark} = mut {<str: EdgeMark>};
    foreach (m in fig.marks) {
        final src = drawnBy[m.src];
        final dst = drawnBy[m.dst];
        if (src == null or dst == null) {
            found.append("{m.call} names a directory no box or group draws; draw it or drop the mark");
            continue;
        }
        final key = edgeKey(src!, dst: dst!);
        if (derived[key] == null) {
            found.append("{m.call} matches no edge edgesFromGraph() draws; drop it, or check which way the import runs");
            continue;
        }
        if (marked[key] != null) { found.append("{m.call} marks an edge already marked; keep one"); }
        marked[key] = m;
    }

    final edges: mut [Edge] = mut [<Edge>];
    final handKeys: mut {str: bool} = mut {<str: bool>};
    foreach (h in fig.hand) {
        var src = actorId(h.srcActor);
        if (h.srcDir != "") { src = drawnBy[h.srcDir] ?? ""; }
        var dst = actorId(h.dstActor);
        if (h.dstDir != "") { dst = drawnBy[h.dstDir] ?? ""; }
        if (src == "" or dst == "") {
            found.append("{h.call} names a directory no box or group draws; draw it first");
            continue;
        }
        final key = edgeKey(src, dst: dst);
        if (derived[key] != null) {
            found.append("{h.call} runs where edgesFromGraph() already draws an edge; drop it, and markEdge() the graph's to label it");
            continue;
        }
        if (handKeys[key] != null) {
            found.append("{h.call} is declared twice; keep one");
            continue;
        }
        handKeys[key] = true;
        edges.append(Edge{ src = src, dst = dst, label = h.label, kind = h.kind, dashed = h.dashed, claim = "flow" });
    }
    foreach (key, e in derived) {
        final m = marked[key];
        if (m != null) {
            edges.append(Edge{ src = e.src, dst = e.dst, label = m!.label, kind = m!.kind, dashed = m!.dashed, claim = e.claim });
        } else {
            edges.append(Edge{ src = e.src, dst = e.dst, claim = e.claim });
        }
    }
    // Map order is not declaration order: sort by the boxes' declaration order, the
    // layout's tiebreak.
    final sortedEdges = edges.sort(fun (a: Edge, b: Edge) > bool {
        final sa = order[a.src] ?? 0;
        final sb = order[b.src] ?? 0;
        if (sa != sb) { return sa < sb; }
        return (order[a.dst] ?? 0) < (order[b.dst] ?? 0);
    });

    final f = flow(fig.id);
    f.titleText = fig.titleText;
    f.eyebrowText = fig.eyebrowText;
    f.descText = fig.descText;
    f.topDown = fig.topDown;
    f.isGenerated = fig.isGenerated;
    f.isUnscoped = fig.isUnscoped;
    f.unscopedWhy = fig.unscopedWhy;
    foreach (part in fig.parts) {
        f.nodes.append(Node{
            id = part.id, label = part.label, sub = part.sub, tag = part.tag, role = part.role,
            anchor = part.anchor, line = part.line, link = part.link,
        });
    }
    foreach (e in sortedEdges) { f.edges.append(e); }
    foreach (b in fig.bands) {
        final members = bandMembers(fig, band: b, drawnBy: drawnBy, found: found);
        if (b.verb == "zone") { f.zones.append(FlowZone{ label = b.label, members = members }); }
        if (b.verb == "boundary") { f.zones.append(FlowZone{ label = b.label, members = members, boundary = true }); }
        if (b.verb == "rank") { f.ranks.append(members); }
        if (b.verb == "row") { f.rows.append(members); }
    }
    foreach (l in fig.legends) { f.legendItems.append(l); }

    final covered: mut [str] = mut [<str>];
    foreach (path, _ in drawnBy) { covered.append(path); }
    foreach (path, why in excluded) {
        if (drawnBy[path] == null) { covered.append(path); }
        f.omitted[path] = why;
    }
    foreach (path in covered.sort(fun (a: str, b: str) > bool { return a < b; })) { f.scopeGlobs.append(path); }

    if (found.len() > 0) {
        final lines: mut [str] = mut [<str>];
        foreach (msg in found) { lines.append("figure {quote(fig.id)}: {msg}"); }
        throw lines.join("\n");
    }
    return f;
}

// foldPair records the graph edge from directory src to dst as an edge between the boxes
// drawing them, unless a hide covers it or it stays inside one box. A declared call
// outranks an import between the same two boxes.
fun foldPair(fig: Figure, derived: mut {str: Derived}, hideUsed: mut [bool], drawnBy: {str: str}, src: str, dst: str, claim: str) > void {
    final srcPart = drawnBy[src];
    final dstPart = drawnBy[dst];
    if (srcPart == null or dstPart == null or srcPart! == dstPart!) { return; }
    var hidden = false;
    var k = 0;
    while (k < fig.hides.len()) {
        final h = fig.hides[k];
        if (listHolds(h.src, item: src) and listHolds(h.dst, item: dst)) {
            hideUsed[k] = true;
            hidden = true;
        }
        k = k + 1;
    }
    if (hidden) { return; }
    final key = edgeKey(srcPart!, dst: dstPart!);
    final prior = derived[key];
    if (prior == null or claim == "calls") {
        derived[key] = Derived{ src = srcPart!, dst = dstPart!, claim = claim };
    }
}

fun listHolds(items: [str], item: str) > bool {
    foreach (x in items) {
        if (x == item) { return true; }
    }
    return false;
}

// bandMembers resolves a band's dirs and actors to the drawn boxes holding them. A group
// joins only whole.
fun bandMembers(fig: Figure, band: Band, drawnBy: {str: str}, found: mut [str]) > [str] {
    final members: mut [str] = mut [<str>];
    final seen: mut {str: bool} = mut {<str: bool>};
    foreach (path in band.dirs) {
        final by = drawnBy[path];
        if (by == null) {
            found.append("{band.call} names {quote(path)}, which no box or group draws; draw it or drop it from the set");
            continue;
        }
        if (seen[by!] != null) { continue; }
        seen[by!] = true;
        members.append(by!);
        foreach (part in fig.parts) {
            if (part.id == by!) {
                foreach (d in part.dirs) {
                    if (listHolds(band.dirs, item: d) == false) {
                        found.append("{band.call} takes part of {part.call}, leaving out {quote(d)}; name every directory of the group or none");
                    }
                }
            }
        }
    }
    foreach (name in band.actors) {
        if (fig.actorRecords[name] == null) {
            found.append("{band.call} names external {quote(name)}, which the figure does not draw; draw it with actor() first");
            continue;
        }
        members.append(actorId(name));
    }
    return members;
}

// asRecord types a map literal as a host record. A host returns its records as maps the
// checker reads through the magus\ mirrors, which no object literal can build; this is how
// the tests below build them as the host would.
fun asRecord::<T>(fields: {str: any}) > T {
    final value: any = fields;
    return value;
}

fun dirAt(path: str, layer: str = "", imports: [str] = [<str>], calls: [magus\DirCall] = [<magus\DirCall>], indexed: bool = true) > magus\Dir {
    return asRecord::<magus\Dir>({
        "path": path, "id": "dir:" + path, "layer": layer, "language": "go",
        "imports": imports, "importedBy": [<str>], "importsIndexed": indexed,
        "calls": calls, "calledBy": [<magus\DirCall>], "children": [<str>], "files": 1,
    });
}

fun callTo(dir: str, transport: str) > magus\DirCall {
    return asRecord::<magus\DirCall>({ "dir": dir, "transport": transport, "marker": "marker:" + dir, "source": dir + "/x.go:1" });
}

fun layerOf(name: str, dirs: [magus\Dir]) > magus\Layer {
    final declared: mut [str] = mut [<str>];
    foreach (d in dirs) { declared.append(d.path); }
    return asRecord::<magus\Layer>({ "name": name, "declared": declared, "dirs": dirs });
}

fun refsAt(symbol: str, files: [str], line: int) > magus\RefsResult {
    final defs: mut [magus\RefSite] = mut [<magus\RefSite>];
    foreach (file in files) {
        defs.append(asRecord::<magus\RefSite>({ "file": file, "count": 1, "lines": [line] }));
    }
    return asRecord::<magus\RefsResult>({ "symbol": symbol, "label": symbol, "defs": defs, "refs": [<magus\RefSite>] });
}

fun guardDir() > magus\Dir { return dirAt("internal/httpx"); }
fun mcpDir() > magus\Dir { return dirAt("internal/handler/mcp", layer: "handler", imports: ["internal/httpx"]); }
fun graphDir() > magus\Dir { return dirAt("internal/handler/graph", layer: "handler", imports: ["internal/httpx"]); }
fun jobDir() > magus\Dir { return dirAt("internal/handler/job", layer: "handler", imports: ["internal/handler/graph"]); }
fun serverDir() > magus\Dir {
    return dirAt("internal/server", imports: ["internal/handler/graph", "internal/handler/job", "internal/handler/mcp", "internal/httpx"]);
}

fun handlers() > magus\Layer { return layerOf("handler", dirs: [mcpDir(), graphDir(), jobDir()]); }

// serverHttp is the decided shape of the server-http figure.
fun serverHttp(layer: magus\Layer) > mut Figure !> str {
    final guard = guardDir();
    final mcp = mcpDir();
    return of("server-http")
        .title("The HTTP surface")
        .box(guard, label: "Guard", focal: true)
        .box(mcp, label: "/mcp")
        .group(layerSet(layer).without([mcp]), label: "Connect RPC")
        .edgesFromGraph();
}

fun failure(f: Figure) > str {
    var msg = "";
    try {
        f.diagram();
    } catch (e: str) {
        msg = e;
    }
    return msg;
}

fun edgeBetween(d: Diagram, src: str, dst: str) > Edge? {
    foreach (e in d.edges) {
        if (e.src == src and e.dst == dst) { return e; }
    }
    return null;
}

test "the server-http figure lays out from its records" {
    final d = serverHttp(handlers()).diagram() catch Diagram{};
    assert\equal(d.id, want: "server-http", message: "the figure lays out");
    assert\equal(d.nodes.len(), want: 3, message: "guard, /mcp and the group");
    assert\equal(nodeOf(d, id: "internal/httpx").role, want: "focal", message: "focal: true is the accent");
    assert\equal(nodeOf(d, id: "internal/handler/mcp").anchor, want: "internal/handler/mcp", message: "a box anchors its directory");
    assert\equal(d.edges.len(), want: 2, message: "one import into the guard from each side; job -> graph stays inside the group");
    final mcp = edgeBetween(d, src: "internal/handler/mcp", dst: "internal/httpx");
    std\assert(mcp != null and mcp!.claim == "imports", message: "/mcp -> guard claims imports");
    final group = edgeBetween(d, src: "group:Connect RPC", dst: "internal/httpx");
    std\assert(group != null and group!.claim == "imports", message: "the group -> guard claims imports");
    assert\equal(d.scope.join(","), want: "internal/handler/graph,internal/handler/job,internal/handler/mcp,internal/httpx", message: "the scope is what the figure draws");
}

test "a package added to a layer joins its group" {
    final notes = dirAt("internal/handler/notes", layer: "handler", imports: ["internal/httpx"]);
    final grown = layerOf("handler", dirs: [mcpDir(), graphDir(), jobDir(), notes]);
    final before = serverHttp(handlers()).diagram() catch Diagram{};
    final after = serverHttp(grown).diagram() catch Diagram{};
    assert\equal(after.nodes.len(), want: before.nodes.len(), message: "no new box");
    assert\equal(after.edges.len(), want: before.edges.len(), message: "notes' import folds into the group's edge");
    std\assert(listHolds(after.scope, item: "internal/handler/notes"), message: "and the figure answers for it");
}

test "every directory in scope is drawn or excepted" {
    final f = (serverHttp(handlers()) catch of("x")).scope(setOf([guardDir(), serverDir()]));
    assert\equal(failure(f), want: "figure \"server-http\": \"internal/server\" is in scope(setOf([\"internal/httpx\", \"internal/server\"])) but nothing draws it; add it to a box or a group, or except(setOf([...]), why:)",
        message: "an undrawn directory in scope is a finding");
    final d = f.except(setOf([serverDir()]), why: "builds the guard and mounts every route").diagram() catch Diagram{};
    assert\equal(d.omits["internal/server"] ?? "", want: "builds the guard and mounts every route", message: "the reason reaches the Diagram");
    std\assert(listHolds(d.scope, item: "internal/server"), message: "an excepted directory stays in scope");
}

test "except is by set, with a reason, over a scope" {
    final base = serverHttp(handlers()) catch of("x");
    final msg = failure(base.except(setOf([guardDir(), serverDir()]), why: ""));
    final want = [
        "figure \"server-http\": except(setOf([\"internal/httpx\", \"internal/server\"])) gives no reason; say why in except(set, why:)",
        "figure \"server-http\": except(setOf([\"internal/httpx\", \"internal/server\"])) excludes \"internal/httpx\", which box(\"internal/httpx\") draws; drop one of them",
        "figure \"server-http\": except(setOf([\"internal/httpx\", \"internal/server\"])) excludes \"internal/httpx\", which no scope(...) holds; drop it from the except",
        "figure \"server-http\": except(setOf([\"internal/httpx\", \"internal/server\"])) excludes \"internal/server\", which no scope(...) holds; drop it from the except",
    ];
    assert\equal(msg, want: want.join("\n"), message: "except findings");
}

test "a directory is drawn once" {
    final f = of("t").box(mcpDir()).group(layerSet(handlers()), label: "handlers").edgesFromGraph();
    assert\equal(failure(f), want: "figure \"t\": \"internal/handler/mcp\" is drawn by box(\"internal/handler/mcp\") and group(\"handlers\"); draw it once, dropping it from a group's set with .without([...])",
        message: "a box inside a group's set is a finding");
}

test "set operations refuse a stale member" {
    final set = layerSet(handlers());
    var gone = "";
    try {
        set.without([guardDir()]);
    } catch (e: str) {
        gone = e;
    }
    assert\equal(gone, want: "layerSet(\"handler\").without names \"internal/httpx\", which the set does not hold; drop it from without([...])", message: "without");
    var twice = "";
    try {
        set.plus([mcpDir()]);
    } catch (e: str) {
        twice = e;
    }
    assert\equal(twice, want: "layerSet(\"handler\").plus names \"internal/handler/mcp\", which the set already holds; drop it from plus([...])", message: "plus");
    final grown = set.plus([guardDir()]) catch DirSet{};
    assert\equal(grown.paths().join(","), want: "internal/handler/graph,internal/handler/job,internal/handler/mcp,internal/httpx", message: "plus keeps the set sorted");
    assert\equal(setOf([guardDir(), guardDir()]).paths().join(","), want: "internal/httpx", message: "setOf holds a directory once");
}

test "a declared call claims calls and outranks an import" {
    final api = dirAt("internal/api", imports: ["internal/store"], calls: [callTo("internal/store", transport: "http")]);
    final store = dirAt("internal/store");
    final d = of("t").box(api).box(store).edgesFromGraph().diagram() catch Diagram{};
    assert\equal(d.edges.len(), want: 1, message: "one edge per pair of boxes");
    assert\equal(d.edges[0].claim, want: "calls", message: "the declared call wins");
}

test "hideEdges takes graph edges out by set, and a stale hide is a finding" {
    final f = serverHttp(handlers()) catch of("x");
    final d = f.hideEdges(setOf([mcpDir()]), dst: setOf([guardDir()]), why: "requests run the other way").diagram() catch Diagram{};
    assert\equal(d.edges.len(), want: 1, message: "the hidden import is gone");
    std\assert(edgeBetween(d, src: "internal/handler/mcp", dst: "internal/httpx") == null, message: "and it is that one");
    final stale = (serverHttp(handlers()) catch of("x")).hideEdges(setOf([guardDir()]), dst: setOf([mcpDir()]), why: "x");
    assert\equal(failure(stale), want: "figure \"server-http\": hideEdges(setOf([\"internal/httpx\"]), dst: setOf([\"internal/handler/mcp\"])) hides no edge the graph draws; drop it",
        message: "a hide that matches nothing");
}

test "edgesFromGraph refuses a directory with no symbol index" {
    final f = of("t").box(dirAt("a", indexed: false)).box(dirAt("b")).edgesFromGraph();
    assert\equal(failure(f), want: "figure \"t\": \"a\" has no symbol index, so its imports are unknown and edgesFromGraph() cannot draw them; build it with `magus graph build`",
        message: "unknown is not absent");
}

test "code boxes need edgesFromGraph, and a figure names code or says why not" {
    assert\equal(failure(of("t").box(guardDir()).box(mcpDir())), want: "figure \"t\": draws 2 boxes of code and no edge between them; call edgesFromGraph()", message: "no edges");
    final person = external("Author");
    assert\equal(failure(of("t").actor(person)), want: "figure \"t\": draws no directory; draw a box() or group(), or say why in unscoped(why:)", message: "no code");
    assert\equal(failure(of("t").box(guardDir()).unscoped(why: "x")), want: "figure \"t\": draws directories and declares unscoped(why:); drop the unscoped", message: "both");
    final d = of("t").flowAcross(person, dst: external("GitHub"), label: "pushes").unscoped(why: "a process").diagram() catch Diagram{};
    assert\equal(d.unscoped, want: "a process", message: "an unscoped figure lays out");
    assert\equal(d.edges[0].claim, want: "flow", message: "a hand edge claims flow");
}

test "a hand edge has an actor at one end and a drawn box at the other" {
    final person = external("Author", sub: "writes a magusfile", look: Look.input);
    final github = external("GitHub", link: "https://github.com");
    final d = (serverHttp(handlers()) catch of("x"))
        .flowIn(person, dst: mcpDir(), label: "tools")
        .flowOut(guardDir(), dst: github, label: "webhooks", stroke: Stroke.external)
        .diagram() catch Diagram{};
    final into = edgeBetween(d, src: "external:Author", dst: "internal/handler/mcp");
    std\assert(into != null and into!.claim == "flow" and into!.label == "tools", message: "flowIn draws a flow edge");
    final leaving = edgeBetween(d, src: "internal/httpx", dst: "external:GitHub");
    std\assert(leaving != null and leaving!.kind == "link", message: "flowOut takes its stroke");
    assert\equal(nodeOf(d, id: "external:Author").role, want: "input", message: "an actor keeps its look");
    assert\equal(nodeOf(d, id: "external:GitHub").link, want: "https://github.com", message: "and its link");
    final undrawn = (serverHttp(handlers()) catch of("x")).flowIn(person, dst: serverDir());
    assert\equal(failure(undrawn), want: "figure \"server-http\": flowIn(\"Author\", dst: \"internal/server\") names a directory no box or group draws; draw it first", message: "an undrawn end");
}

test "markEdge labels a graph edge, and one the graph lacks is a finding" {
    final d = (serverHttp(handlers()) catch of("x")).markEdge(mcpDir(), dst: guardDir(), label: "every call", stroke: Stroke.focal).diagram() catch Diagram{};
    final e = edgeBetween(d, src: "internal/handler/mcp", dst: "internal/httpx");
    std\assert(e != null and e!.label == "every call" and e!.kind == "accent" and e!.claim == "imports", message: "the mark reaches the edge and keeps its claim");
    final wrong = (serverHttp(handlers()) catch of("x")).markEdge(guardDir(), dst: mcpDir());
    assert\equal(failure(wrong), want: "figure \"server-http\": markEdge(\"internal/httpx\", dst: \"internal/handler/mcp\") matches no edge edgesFromGraph() draws; drop it, or check which way the import runs", message: "a mark against the import");
}

test "a symbol anchors its box at the definition" {
    final ok = of("t").box(guardDir(), symbol: refsAt("httpx.Guard", files: ["internal/httpx/guard.go"], line: 12)).box(mcpDir()).edgesFromGraph();
    final d = ok.diagram() catch Diagram{};
    assert\equal(nodeOf(d, id: "internal/httpx").anchor, want: "internal/httpx/guard.go", message: "the anchor is the defining file");
    assert\equal(nodeOf(d, id: "internal/httpx").line, want: 12, message: "and its line");
    final svg = ok.svg(Theme.light, anchorHref: "/code/\{path\}#L\{line\}") catch "threw";
    std\assert(svg.indexOf("<a href=\"/code/internal/httpx/guard.go#L12\" data-node=\"internal/httpx\" data-anchor=\"internal/httpx/guard.go\" data-line=\"12\">") != null, message: "the link carries the line: {svg}");
    final elsewhere = of("t").box(mcpDir(), symbol: refsAt("httpx.Guard", files: ["internal/httpx/guard.go"], line: 12)).unscoped(why: "x");
    std\assert(failure(elsewhere).indexOf("box(\"internal/handler/mcp\") anchors symbol \"httpx.Guard\", defined in internal/httpx/guard.go; box the directory that defines it") != null, message: "a symbol defined elsewhere");
    final none = of("t").box(guardDir(), symbol: refsAt("httpx.Gone", files: [<str>], line: 0));
    std\assert(failure(none).indexOf("box(\"internal/httpx\") anchors symbol \"httpx.Gone\", which has no definition in the index") != null, message: "a symbol with no definition");
}

test "a zone takes a group whole" {
    final guarded = layerSet(handlers()).plus([guardDir()]) catch DirSet{};
    final zoned = (serverHttp(handlers()) catch of("x")).zone("guarded", dirs: guarded);
    final d = zoned.diagram() catch Diagram{};
    assert\equal(d.zones.len(), want: 1, message: "the zone lays out");
    final part = (serverHttp(handlers()) catch of("x")).zone("guarded", dirs: setOf([guardDir(), graphDir()]));
    assert\equal(failure(part), want: "figure \"server-http\": zone(\"guarded\") takes part of group(\"Connect RPC\"), leaving out \"internal/handler/job\"; name every directory of the group or none",
        message: "a split group");
}

test "a string where a Look or Stroke belongs is a finding" {
    final f = of("t").box(guardDir(), look: "store").box(mcpDir()).markEdge(mcpDir(), dst: guardDir(), stroke: "focal").legend("focal", label: "x").edgesFromGraph();
    final want = [
        "figure \"t\": box(\"internal/httpx\") takes look: Look.<case>, not a string",
        "figure \"t\": markEdge(\"internal/handler/mcp\", dst: \"internal/httpx\") takes stroke: Stroke.<case>, not a string",
        "figure \"t\": legend \"x\" takes look: Look.<case>, not a string",
    ];
    assert\equal(failure(f), want: want.join("\n"), message: "stringly");
}

test "a layout finding speaks for the figure" {
    var f = of("t").unscoped(why: "budget");
    var n = 0;
    while (n < 10) {
        f = f.actor(external("actor {n}"));
        n = n + 1;
    }
    final msg = failure(f);
    assert\equal(msg, want: "figure \"t\": 10 nodes exceeds the budget of {MaxNodes}; split into overview plus detail, one figure\\of() each", message: "budget");
}

test "svg paints each theme" {
    final f = serverHttp(handlers()) catch of("x");
    final page = f.svg(Theme.page) catch "threw";
    final dark = f.svg(Theme.dark) catch "threw";
    std\assert(page.indexOf("var(--magus-diagram-") != null, message: "page follows the site's variables");
    std\assert(dark.indexOf("var(--magus-diagram-") == null and dark.startsWith("<svg"), message: "dark bakes hex");
}

test "a value that is not a record is refused where it enters" {
    final notDir = asRecord::<magus\Dir>({ "id": "dir:x" });
    assert\equal(failure(of("t").box(notDir).unscoped(why: "x")), want: "figure \"t\": box takes a Dir from magus\\dir, and this argument is not one", message: "box");
    var msg = "";
    try {
        setOf([guardDir(), notDir]);
    } catch (e: str) {
        msg = e;
    }
    assert\equal(msg, want: "setOf takes Dir records from magus\\dir or magus\\dirs, and item 1 is not one", message: "setOf");
    msg = "";
    try {
        layerSet(asRecord::<magus\Layer>({ "declared": [<str>] }));
    } catch (e: str) {
        msg = e;
    }
    assert\equal(msg, want: "layerSet takes a Layer from magus\\layer, and this argument is not one", message: "layerSet");
}
