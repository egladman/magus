// Spells bind a real toolchain to magus. Importing one gives you a handle whose
// ops are cached, kebab-case targets: go-build, go-test, go-vet. Call an op by
// indexing the handle with its name (the same name `magus run go-build` uses)
// and passing the target's ctx as the first argument. The tools are stubbed in
// the playground, so `run ci` records the ops (try it, then `graph`) without
// executing anything.

import "magus";
import "magus/spell/golang";     // the Go toolchain: go-build, go-test, go-vet, ...

magus\project({ "spells": [golang] });

export fun build(ctx: magus\Context, args: [str]) > void {
    golang["go-build"](ctx);
}

export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(build);
    golang["go-test"](ctx);
}

export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(build, test);
}
