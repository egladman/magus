// title: Custom targets: name your own phases
// desc: The canonical names are conventions, not a closed set; export a release or deploy target and drive one from another.
// doc: concepts/targets|Targets
//
// Try `ls` to see every target, then `run deploy` to watch one drive another.

import "magus";
import "magus/spell/go";

magus\project({ "spells": [go] });

export fun build(ctx: magus\Context, args: [str]) > void {
    go["go-build"](ctx);
}

// The conventional anchor, wired with ctx.needs like always.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(build);
}

// A bespoke phase. It depends on ci through the same ctx.needs edge the
// canonical targets use, then does its own extra work.
export fun release(ctx: magus\Context, args: [str]) > void {
    ctx.needs(ci);
    magus\log.info("tagging and publishing the release");
}

// Another target in the same project is always an edge, never a nested run. A run
// holds its projects' locks for its whole life, so `magus\run(["release"])` here
// would wait on a lock its own caller holds and magus refuses it (MGS3007).
// magus\run is for driving a DIFFERENT project - `magus\run(["build", "web"])` -
// which the caller does not hold.
export fun deploy(ctx: magus\Context, args: [str]) > void {
    ctx.needs(release);
    magus\log.info("rolling out to production");
}
