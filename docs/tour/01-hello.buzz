// title: Magusfiles: write your first target
// desc: A magusfile is a build definition; each exported function is a runnable target.
// doc: concepts/targets|Targets
//
// Try it in the console below: `ls` lists targets, `run greet` runs this one.

import "magus";

export fun greet(ctx: magus\Context, args: [str]) > void {
    magus\log.info("hello from magus");
}
