// title: Charm axes: one question each, and a charm that checks itself
// desc: The shape a real publish target reaches: two charms on separate axes, a guard for the pair that answers one question twice, and magus.raise so a refusal carries a code instead of a sentence.
// doc: recommendations|Recommendations
//
// Charms that answer one question each, and fail when they cannot. Step 8 showed a charm
// flipping a target between two behaviors; step 15 showed one patching argv. This is the
// shape a real publish target ends up with, and the two mistakes it invites.
//
// The first mistake is putting two charms on ONE question. magus keeps charms as an
// unordered set and gives none precedence over another, so a magusfile that reads two in
// sequence invents a precedence the engine does not have - and the loser is discarded in
// silence, which is the worst way to lose an argument you explicitly made.
//
// The second is a charm that CLAIMS something and never checks it. `stable` tells whoever
// follows the moving tag that this artifact is for them. If nothing verifies that, the
// claim is a comment that happens to execute.
//
// Both are reported with magus\raise, which fails with a CODE rather than a sentence, so a
// caller branches on identity instead of substring-matching prose. Step 19 is the other
// half of this: what a `catch` sees.
//
// Run `run publish`, then `run publish:cd`, then `run publish:cd,stable`, then break it
// with `run publish:cd,stable,unstable`.

import "magus";
import "semver";
import "std";

magus\project({});

// The version this build would carry. Real magusfiles read vcs\describe(); a literal keeps
// the tour runnable with no repository behind it. Change it to "1.4.0" and watch which
// channels accept it.
fun version() > str { return "1.4.0-rc.2"; }

// Two charms that answer one question are a mistake worth REPORTING, not resolving. WS is
// this workspace's own code prefix - magus refuses the MGS prefix, which is its closed
// catalog, so a workspace diagnostic can never render as though magus documented it.
fun exclusiveCharms(ctx: magus\Context, a: str, b: str, code: str, question: str) > void !> any {
    if (ctx.has_charm(a) and ctx.has_charm(b)) {
        magus\raise(code, message: "the `" + a + "` and `" + b + "` charms both answer "
            + question + " - name one");
    }
}

// The channel this run publishes to, and the assertion that the version belongs there.
//
// Note what the two charms have in common: each checks the OPPOSITE side of one semver
// field. That is why naming both needs no special case beyond the guard above - a version
// either carries a prerelease component or it does not, so one of the two assertions would
// fail on its own anyway.
fun channel(ctx: magus\Context) > str !> any {
    exclusiveCharms(ctx, a: "stable", b: "unstable", code: "WS1002",
        question: "which channel to publish to");

    final wantStable = ctx.has_charm("stable");
    final wantUnstable = ctx.has_charm("unstable");
    if (!wantStable and !wantUnstable) { return "commit"; }

    final pre = semver\parse(version()).prerelease;
    if (wantStable and pre != "") {
        magus\raise("WS1003", message: "`" + version() + "` carries the prerelease `" + pre
            + "`, so it cannot go to the stable channel - that is the one a moving tag follows");
    }
    if (wantUnstable and pre == "") {
        magus\raise("WS1004", message: "`" + version()
            + "` is a stable version, so `unstable` would file it under the wrong channel");
    }
    if (wantStable) { return "stable"; }
    return "unstable";
}

// TWO axes, one charm each, and neither answers the other's question:
//
//   cd                 deliver? Absent, this builds and pushes nothing.
//   stable / unstable  which channel? Only read when cd is set.
//
// The default among delivering modes is the harmless one, for the same reason a bare run
// pushes nothing: the commit channel adds an immutable tag and moves nothing, while a
// release moves a tag every consumer follows.
export fun publish(ctx: magus\Context, args: [str]) > void !> any {
    if (!ctx.has_charm("cd")) {
        magus\info("publish: built " + version() + ", pushed nothing (add the cd charm to deliver)");
        return;
    }
    final ch = channel(ctx);
    if (ch == "commit") {
        magus\info("publish: " + version() + " -> commit channel, tagged by hash, one registry");
        return;
    }
    if (ch == "unstable") {
        magus\info("publish: " + version() + " -> unstable channel, version tag only");
        return;
    }
    magus\info("publish: " + version() + " -> stable channel, version tag and the moving tag");
}

test "a version with a prerelease belongs to the unstable channel" {
    std\assert(semver\parse(version()).prerelease != "",
        message: "the tour version is a release candidate, so stable must refuse it");
}
