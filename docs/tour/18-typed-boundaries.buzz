// title: Typed boundaries: keep the data inside
// desc: A target returns void, so structured data belongs in the magusfile - declare the table once, export a verb per action, and let CI supply only the secrets.
// doc: guides/tips|Tips and tricks
//
// Where the type system stops. A target's signature is fixed - it takes a Context
// and args and returns `void` - so what reaches the outside world is an exit code
// and text. `magus run <target> -o json` renders the RUN (target, charms, projects,
// count), never a value your target computed. Built-in commands are the ones with
// declared output types; `magus describe projects -o template` lists theirs.
//
// That is not a limitation to route around, it is a boundary to put in the right
// place. Everything INSIDE stays typed. So when two steps have to agree on
// structured data, keep the data here and export a VERB for each thing you want
// done with it - never a target that prints the data for a shell to parse back.
//
// Run `run registries`, then `run registries:prod`, then `run login:prod` (it will
// tell you which variables to set), then `run login:prod ghcr.io`.

import "magus";
import "os";

// The shape, declared once. Note what user_ref holds: a REFERENCE to a credential -
// under the built-in provider, the name of an environment variable - never the value.
// That is the whole trick to keeping secrets out of a magusfile: this file describes
// where to find a credential, something else supplies it, and neither has to know about
// the other.
object Registry {
    host: str = "",
    repository: str = "",
    user_ref: str = "",
    token_ref: str = "",
}

final GHCR = Registry{
    host = "ghcr.io",
    repository = "ghcr.io/example/demo",
    user_ref = "GHCR_USERNAME",
    token_ref = "GHCR_TOKEN",
};

final DOCKERHUB = Registry{
    host = "docker.io",
    repository = "docker.io/example/demo",
    user_ref = "DOCKERHUB_USERNAME",
    token_ref = "DOCKERHUB_TOKEN",
};

// The single source of truth. A typed helper, not a target: it returns [Registry],
// which a target could not. Every verb below reads it, so they cannot disagree about
// which registries a run involves - add one entry and all of them follow.
fun publish_registries(ctx: magus\Context) > [Registry] {
    if (ctx.has_charm("prod")) { return [GHCR, DOCKERHUB]; }
    if (ctx.has_charm("snapshot")) { return [GHCR]; }
    return [];
}

// Selection is BY NAME. Positional indexing looks tempting and is a trap here: the
// charm decides the list's length, so index 1 is a valid registry under `prod` and
// out of range under `dev`. An unknown host is an error naming the valid ones rather
// than a silent no-op.
fun select(registries: [Registry], host: str) > [Registry] {
    if (host == "") { return registries; }
    var hosts = "";
    foreach (reg in registries) {
        if (reg.host == host) { return [reg]; }
        if (hosts != "") { hosts = hosts + ", "; }
        hosts = hosts + reg.host;
    }
    throw "no registry \"" + host + "\"; these charms use: " + hosts;
}

// Probing with try/catch, because a provider signals "not available" by THROWING -
// $VAR unset for the built-in, a locked vault for a 1Password spell. Presence is not
// something a caller can test for without asking.
fun readable(ref: str) > bool {
    try {
        magus\secret.read(ref);
        return true;
    } catch (e) {
        return false;
    }
}

// Verb one: LOOK. Reports where a push would go and whether the credentials are
// present - without needing any of them, and without ever printing a value.
export fun registries(ctx: magus\Context, args: [str]) > void {
    var host = "";
    if (args.len() > 0) { host = args[0]; }
    final selected = select(publish_registries(ctx), host);
    if (selected.len() == 0) {
        magus\info("nothing is published under these charms; try `run registries:prod`");
        return;
    }
    var report = "";
    foreach (reg in selected) {
        var state = "ready";
        if (!readable(reg.user_ref) or !readable(reg.token_ref)) {
            state = "needs " + reg.user_ref + " and " + reg.token_ref;
        }
        report = report + "\n" + reg.host + "  ->  " + reg.repository + "  (" + state + ")";
    }
    magus\info("publishes to:" + report);
}

// Verb two: ACT. The same list, so the set logged into is by construction the set
// pushed to. A CI step is now one line with no shell parsing anything, and it is the
// same line you run locally.
//
// TWO protections, and neither makes the other redundant. The token goes to the command
// on STDIN, so it never enters an argv magus persists. And it was read through
// magus\secret.read, so magus knows the value is a credential and redacts it from
// captured output - which covers what this file does not control: the command itself
// echoing the token back. Read the same variable with os\env and you get a plain string
// magus has no reason to protect.
//
// This tour uses `env` in place of a real `docker login` so it is safe to run - watch it
// echo the argv it was given, with no secret in it.
export fun login(ctx: magus\Context, args: [str]) > void {
    var host = "";
    if (args.len() > 0) { host = args[0]; }
    final selected = select(publish_registries(ctx), host);
    if (selected.len() == 0) {
        throw "these charms publish nowhere - try `run login:prod`";
    }
    foreach (reg in selected) {
        final user = magus\secret.read(reg.user_ref);
        final token = magus\secret.read(reg.token_ref);
        os\exec("env", args: ["echo", "login", reg.host, "-u", user, "--password-stdin"],
            dir: ".", opts: {"stdin": token});
        magus\info("login: " + reg.host + " authenticated as " + user);
    }
}
