import "magus";
import "../tools/toolchain-policy" as policy;
// The shared advisory gate; see tools/audit.buzz for why an exit code is the wrong question.
import "../tools/audit" as audit;
import "../tools/drift" as drift;
// Modules the targets use: fs (writes MAGUS.md), os (esbuild,
// npm), vcs (drift gate), http (serve). render.buzz owns the rendering
// machinery's own imports (markdown, io, std, serialize, encoding).
import "fs";
import "os";
import "proc";
import "vcs";
import "http";
// build-playground compiles the gopherbuzz Buzz VM to wasm with the stock Go
// toolchain, so it depends on
// gopherbuzz's build. The path import binds its targets as cross-project handles
// (gopherbuzz.build), and folds gopherbuzz into this project's affected set.
import "project/../libs/gopherbuzz" as gopherbuzz;
// The shared DOM-free browser client lib (libs/textsearch) holds the search grammar the
// site bundle imports from source. Affected tracking is glob-based (not import-graph),
// so this handle lets lint pull in textsearch.lint (type-check + biome) - a lib edit then
// marks docs affected and re-checks it through the target graph.
import "project/../libs/textsearch" as textsearch;
// workspace exposes cross-project files in exact target footprints. The publication
// stages below deliberately name only what they read so a page or bundle change does
// not invalidate every docs target.
import "project/.." as workspace;
// The agent-hook templates are a nested project under this one (guides/integrations/agents).
// This page EMBEDS their contents verbatim - a repo-root test fails when a template and its
// code block drift apart - so a template edit has to re-run this project's gates. Affected
// tracking is glob-based, not import-graph-based, so the edge is declared, never inferred.
import "project/guides/integrations/agents" as agents;
// The static site generator, a sibling module. Aliased so it does not collide with the
// `render` target below: a same-name target shadows the import and nulls its members.
import "render" as renderer;

// magusfile binds this file's own exported targets (generate, render, ci, ...); ts adds
// the TypeScript spell so the client bundles under src/ are symbol-capable - its `scip`
// op indexes them (via tsconfig.json) for the knowledge graph. ts is opaque (pnpm owns
// the dependency graph; informational) and does not run in this project's ci, which uses
// the custom targets below; it just makes the project's TypeScript browsable as symbols.
import "magus/spell/typescript";
// go is imported for its go-run op only (content-generate/changelog-generate drive
// repo-root Go tools through it), NOT added to the project spells list below: docs is
// not a Go project, so it must not inherit go's **/*.go required-globs or language tag.
import "magus/spell/go";
// Imported for its typos op only, NOT added to the project spells list below: binding
// markdown here would also claim this tree's **/*.md for markdownlint, which the root
// project already lints. The prose check is the part docs was missing.
import "magus/spell/markdown";

magus\project({
    // The shared node window, by explicit import (tools/toolchain-policy.buzz).
    // This project drives node; it declares no go window because it drives no Go.
    "tools": {"node": policy.node},
    "spells": [typescript],
    // ../proto because content-generate reads proto/gen/descriptor.binpb, which the proto
    // project writes. Without the edge the two generate targets are unordered, so a schema
    // change could regenerate the API reference from the PREVIOUS descriptor - and reading
    // another project's declared output with no dependency on it is what MGS4004 flags.
    // ../libs/diagram for the same reason: diagrams-generate reads its renderer, and
    // reading another project's file with no edge is unordered (MGS4004).
    "depends_on": ["..", "../proto", "../libs/diagram"],
    // Affected/drift tracks this sources glob, not the import graph, so render.buzz
    // (and every other input) must be named to be watched. The SSG now lives IN docs/,
    // co-located with the markdown it renders, so the content and the generator share one
    // tree. **/*.md is the local docs corpus this render reads; source expansion prunes any
    // dir named gen/ or node_modules/ (and the declared outputs) by name, so the generated
    // index.md files under gen/ and package READMEs under node_modules/ never leak in as
    // watched content. Both src/**/*.js AND src/**/*.ts are named: the client bundles are
    // increasingly TypeScript (esbuild strips the types), and a .ts edit must mark this
    // project affected just like a .js one. package.json + pnpm-lock.yaml are named so a
    // bundled-dep version bump (hljs, d3, codemirror) invalidates the cacheable
    // build-* targets and marks this project affected - the esbuild inputs live in those
    // manifests, not in the src/ entries. tsconfig.json (the ts build) is a render/build
    // input too. (pnpm is the package manager - NOT npm; there is no package-lock.json.)
    "sources": ["*.buzz", "lib/**/*.buzz", "engine/**/*.buzz", "site/**/*.buzz", "**/*.md",
                "src/**/*.js", "src/**/*.ts", "src/**/*.css", "playground.html",
                "tour/*.buzz", "package.json", "pnpm-lock.yaml", "tsconfig.json", "biome.json",
                // retired.urls.lock is hand-authored: a human lists URLs intentionally
                // removed from the site, exempting them from abandonedLinkCheck (gates.buzz).
                // Nothing generates it, so it belongs here as a source, not in "outputs" -
                // editing it must invalidate the cache key that gates the render.
                "retired.urls.lock",
                // NOT the .proto sources. The JS client is generated by the proto project
                // (proto/buf.gen.yaml) straight into src/gen/, and src/**/*.ts below already
                // covers the generated files - so a schema change still marks this project
                // affected, without a Markdown edit re-running a network-bound codegen step.
                "../README.md", "../CONTRIBUTING.md", "../blog/**", "../assets/**",
                // content-generate derives committed Markdown from the Go source tree (the
                // Buzz module reference, the built-in spell docs, and the Markdown manpages),
                // so name those generators' inputs here: a change to a host-module binding, a
                // built-in spell or its example, or the CLI/manpage registry must mark this
                // project affected so content-generate re-runs and the drift gate catches an
                // unregenerated page. Data sources are ../std + ../host (module ref), ../spells
                // + ../internal/spellruntime (spell docs), and ../internal/clispec + ../internal/config
                // (manpages); the tools themselves live under ../cmd/magus-{docs,spelldocs,manpage}.
                "../std/**/*.go", "../host/**/*.go",
                "../spells/**/*.buzz", "../internal/spellruntime/**/*.go",
                "../internal/clispec/**/*.go", "../internal/config/**/*.go",
                "../internal/render/**/*.go", "../internal/graph/**/*.go",
                "../cmd/magus-docs/**/*.go", "../cmd/magus-spelldocs/**/*.go",
                "../cmd/magus-manpage/**/*.go", "../cmd/magus-examples/**/*.go",
                // The skill reference is generated from the embedded bodies and the
                // elision that splits them, so both are inputs: edit a SKILL.md and
                // its page must regenerate, or the site documents a version nobody
                // installs - the exact drift this generator exists to prevent.
                "../cmd/magus-skilldocs/**/*.go", "../internal/agent/**/*.go",
                "../cmd/magus/skills/**/*.md"],
    // The committed Markdown that content-generate derives from the Go tree
    // (buzz/modules, spells, manpage) is declared per-target in content-generate's own
    // magus.outputs, not here, so that generator's cache entry snapshots exactly its
    // pages and no other target's hit can restore them stale.
    // Outputs are owned by the stage that writes them. A project-wide output would make
    // every target snapshot the entire site tree, defeating the cache boundary below.
    "targets": {
        "security": {"skip_cache": "reads the npm advisory database, which changes independently of this tree"},
        // index-generate renders `magus describe graph -o markdown`, so its output is a
        // function of the WHOLE knowledge graph - every source file in the workspace and
        // the binary that walks them. Its declared inputs are the magusfiles, which is
        // the only part of that a glob can name, so any other change leaves the key
        // unmoved: a cache hit then replays a MAGUS.md built before it and REVERTS the
        // committed one, which the drift gate correctly reports as drift. That is why a
        // branch adding Go files fails this gate in CI (where the shared cache is
        // restored) while passing on a clean checkout that has nothing to hit.
        //
        // Skipping the cache is the honest fix rather than widening readsFiles to the
        // whole tree: the input set really is everything, and a key that claimed
        // otherwise would go on being wrong in a way nobody could see.
        "index-generate": {"skip_cache": "output derives from the entire knowledge graph, which no input glob can key"},
        // ci and test COMPOSE other targets and write nothing of their own. With outputs owned
        // per-stage (see above), the wrapper has no glob of its own to snapshot, and the cache
        // treats an empty match as a broken entry rather than an empty one:
        // `snapshot "docs": no files matched declared outputs`. It stayed hidden while these
        // wrappers replayed from cache and only surfaced once a change actually made docs
        // re-run. Same shape, same fix, and the same reason as @magus/agents.
        "ci": {"skip_cache": "composes other targets and declares no outputs of its own; an empty snapshot match reads as a broken cache entry"},
        "test": {"skip_cache": "composes other targets and declares no outputs of its own; an empty snapshot match reads as a broken cache entry"},
        // generate is the cheap orchestration and drift gate. Its actual work lives in
        // cacheable *-generate stages below, so unchanged docs do not rebuild the site.
        "generate": {"skip_cache": "is the drift gate itself; a replay would skip the check it exists to make", "exclusive": true},
        // render is the FAST re-render path (site_render only, no MAGUS.md/changelog/
        // JS-bundle rebuild, no drift gate) the workspace-root `serve` dev loop calls on
        // a docs change. skip_cache so every invocation actually re-renders gen/.
        "render": {"skip_cache": "the dev-loop fast path; every invocation must actually re-render gen/"},
		// site-generate incorporates VCS tags and history. Those are deliberately
		// outside file hashing, so replay is unsafe until the cache has a VCS input
		// primitive. It still has a narrow target footprint and no output snapshot.
		"site-generate": {"skip_cache": "incorporates VCS tags and history, which are outside file hashing, so a replay is unsafe"},
        // build-hljs / build-playground-editor bundle a
        // src/*-vendor.js (or feature) entry with esbuild (pinned in mise.toml) into a
        // gen/ artifact. esbuild + pinned npm deps are deterministic, so these
        // stay cacheable (no skip_cache): a cache hit replays identical bytes, and a
        // version bump invalidates it via package.json/pnpm-lock.yaml in sources.
        // generate runs them, so a version bump reaches the published site on its own.
    },
});

// Paths this project reads from and writes to, owned here and passed into
// render.site_render so the generator stays config-agnostic.
final ROOT = "..";          // the magus/ workspace dir, relative to this project
final DOCS = "docs";        // source docs subtree under ROOT
final BLOG = "blog";        // source blog subtree under ROOT
final OUT  = "gen";         // generated site output, under this project

export fun preflight(ctx: magus\Context, args: [str]) > void !> any { install(); }

// pnpm, NOT npm: .npmrc's minimum-release-age supply-chain gate is the reason.
// Always let pnpm validate the install. A canceled or interrupted install leaves a
// node_modules directory that EXISTS but is incomplete, so the `if (!fs.isDir(...))`
// guard this replaced read that tree as ready and handed the missing packages to
// esbuild instead - surfacing as `Could not resolve "@codemirror/view"` from
// build-playground-editor, which reads like a source bug rather than a half-installed
// tree. On a warm tree --frozen-lockfile is about a second and changes nothing.
// Reached once per invocation through preflight, so the fan-out of build-* targets
// below does not race several installs in the same directory.
fun install() > void !> any {
    proc\exec("pnpm", ["install", "--frozen-lockfile"], ".", {});
}

// index-generate refreshes MAGUS.md (the target catalog + dependency graph) from this
// magusfile, so it stays in lockstep with the targets. generate calls it; run
// standalone after editing targets: `magus run index-generate docs`.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("magusfile.buzz", workspace.file("**/magusfile.buzz"));
    ctx.writesFiles("MAGUS.md");
    final doc = magus\describe(["graph", "-o", "markdown", "docs"], {"quiet": true, "root": ROOT}).stdout;
    fs\writeFile("MAGUS.md", doc + "\n");
}

// content-generate regenerates the committed docs Markdown derived from the Go source
// tree: the Buzz stdlib module reference (cmd/magus-docs, from the host module registry),
// the built-in spell reference plus the spells.md table (cmd/magus-spelldocs), the
// Markdown manpages (cmd/magus-manpage -format md, from internal/clispec), and the worked
// examples in knowledge.md (cmd/magus-examples, captured from a fixture graph). The
// generator tools live at the repo root, so they run from here (the docs cwd) through
// the go spell's go-run op (`go run ../cmd/...`) writing into this project's own tree,
// version-pinned and sandbox-aware rather than a raw proc.exec. This owns only the Markdown
// manpages (docs-site content, docs/manpage/*.md); the roff manpages are a distribution
// artifact owned by the root magusfile (man-generate). generate depends on this and
// drift-gates the result.
export fun content_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(workspace.file("std/**/*.go"), workspace.file("host/**/*.go"),
        workspace.file("spells/**/*.buzz"), workspace.file("internal/spellruntime/**/*.go"),
        workspace.file("internal/clispec/**/*.go"), workspace.file("internal/config/**/*.go"),
        workspace.file("internal/render/**/*.go"), workspace.file("internal/graph/**/*.go"),
        workspace.file("cmd/magus-docs/**/*.go"), workspace.file("cmd/magus-spelldocs/**/*.go"),
        workspace.file("cmd/magus-manpage/**/*.go"), workspace.file("cmd/magus-examples/**/*.go"),
        workspace.file("cmd/magus-skilldocs/**/*.go"), workspace.file("internal/agent/**/*.go"),
        workspace.file("cmd/magus/skills/**/*.md"), workspace.file("cmd/magus-protodocs/**/*.go"),
        // The DESCRIPTOR, not the .proto sources: it is the proto project's declared output, so
        // a schema edit reaches here through that artifact. Depending on ../proto/**/*.proto
        // directly would drag a network-bound buf step into this project's cache boundary,
        // which is the exact coupling buf.gen.yaml was restructured to remove.
        workspace.file("proto/gen/descriptor.binpb"), workspace.file("CHANGELOG.md"));
    ctx.writesFiles("reference/buzz/*.md", "reference/config.md", "concepts/spells/*.md", "reference/manpage/*.md", "reference/skills/*.md", "reference/api/*.md", "changelog.md");
    // spells.md and knowledge.md are EDITED, not produced: both are hand-written pages
    // carrying a small generated region between HTML markers, which magus-spelldocs and
    // magus-examples replace in place and hard-error on if the markers are missing.
    // Declared as outputs they were deletable, and excluded from the source hash.
    ctx.modifiesExistingFiles("concepts/spells.md", "concepts/knowledge.md");
    go["go-run"](ctx, {"args": ["../cmd/magus-docs", "-out", "./reference/buzz"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-configdocs", "-out", "./reference/config.md"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-spelldocs", "-out", "./concepts/spells", "-spells", "../spells"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-manpage", "-format", "md", "-out", "./reference/manpage"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-examples", "-docs", "./concepts/knowledge.md"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-skilldocs", "-out", "./reference/skills", "-src", "../cmd/magus"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-protodocs", "-descriptor", "../proto/gen/descriptor.binpb", "-out", "./reference/api"]});

    // The changelog as a docs page. CHANGELOG.md is generated at the repo ROOT (magus-utils,
    // from releases/*.yaml) and sits outside this project's walk, so a reader upgrading has
    // nowhere on the site to see what changed. Copying it in with frontmatter hands it to the
    // ordinary page pipeline - search index, breadcrumbs, related cards, the orphan gate - with
    // no renderer change at all, the same way the generated manpages arrive. Copy, not a
    // symlink: the walk reads real files, and a link would leave the page's provenance chip
    // pointing outside the project.
    // Links inside CHANGELOG.md are written for GitHub, where they resolve from the repo
    // ROOT ("docs/concepts/knowledge.md"). This page sits INSIDE docs/, so the prefix has to
    // come off or every one of them 404s - which the asset-integrity gate catches, and did.
    // Rewriting here rather than in CHANGELOG.md keeps the file correct in both places.
    // CONTRIBUTING.md is the other root-relative target, and it needs a different rewrite
    // than the docs/ prefix: it is not a docs page at all. site/development.buzz renders the
    // repo-root file as a synthesized page under development/, so the GitHub-correct
    // "CONTRIBUTING.md" has to become that URL rather than just losing a prefix. Trailing
    // slash and no anchor here so an existing "#naming" suffix survives the join.
    final changelogMd = fs\readFile("../CHANGELOG.md")
        .split("](docs/").join("](")
        .split("](CONTRIBUTING.md").join("](development/contributing/");
    fs\writeFile("changelog.md",
        "---\ntitle: Changelog\n"
        + "description: Every released change to magus, newest first, in Keep a Changelog format. Generated from releases/*.yaml.\n"
        + "tags: [changelog, releases, versions, upgrade, breaking-changes]\n---\n\n"
        + changelogMd);
}

// site-generate owns publication. It cannot replay while it reads VCS state; the
// public generate target still lets the independent content stages fan out first.
export fun site_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("render.buzz", "lib/**/*.buzz", "engine/**/*.buzz", "site/**/*.buzz", "**/*.md",
        "src/**/*.js", "src/**/*.ts", "src/**/*.css", "playground.html", "tour/*.buzz",
        "package.json", "pnpm-lock.yaml", "tsconfig.json", "biome.json", "retired.urls.lock",
        workspace.file("README.md"), workspace.file("CONTRIBUTING.md"), workspace.file("blog/**"),
        workspace.file("assets/**"), workspace.file("releases/*.yaml"));
    ctx.writesFiles("gen/**", "active.urls.lock");
    renderer\site_publish(ROOT, DOCS, BLOG, OUT,
        magus\targets(), magus\projectGraph(),
        ctx.hasCharm("rw"));
}

// generate is the one public docs publication target. Its small drift gate always runs;
// its content, catalog, changelog, and site stages replay independently when unchanged.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
	magus\log.hint("docs generate refreshes derived content and bundles; unchanged stages replay from cache; for a docs/blog preview use `magus run render docs`");
    ctx.needs(preflight);
    final CONTENT = ["reference/buzz", "reference/config.md", "concepts/spells", "concepts/spells.md",
        "concepts/knowledge.md", "reference/manpage", "reference/skills", "reference/api", "changelog.md"];
    // OUT is deliberately absent. gen/ is ignored now that cd.yaml renders at deploy
    // time, and an ignored path is never "dirty", so listing it would assert a check that
    // silently passes. What still gates is every generated file that IS tracked: MAGUS.md,
    // the root CHANGELOG.md, src/gen, and the derived Markdown in CONTENT.
    final GENERATED = ["MAGUS.md", ROOT + "/CHANGELOG.md", "src/gen"] + CONTENT;
    // Hashed before and after, not gated on a clean tree: the old form skipped whenever any
    // of these was already dirty, which is the state you are in while editing a generator.
    // It also makes the gate work in a git WORKTREE, where vcs\isDirty does not report
    // these paths at all - it used to be inert there and fire only in CI.
    final before = drift.hashes(GENERATED);
    // changelog-generate runs FIRST, alone: content-generate now copies CHANGELOG.md in as a
    // docs page, so the two no longer own disjoint outputs and cannot share a stage - fanned
    // out together, the page could be written from the previous release's changelog.
    ctx.needs(workspace.changelog_generate);
    // These producers own disjoint outputs and can fan out. site-generate then reads
    // their completed artifacts, so it intentionally runs in the following stage.
    ctx.needs(content_generate, index_generate);
    // The esbuild bundles are a stage of their own, BEFORE site-generate rather than beside
    // it: site-generate hashes gen/ into the service-worker precache and site-manifest, so a
    // bundle written after it would ship with a manifest that does not describe it. They used
    // to be run by hand and committed; with gen/ untracked, generate is what produces them.
    ctx.needs(build_hljs, build_playground_editor, build_playground);
    ctx.needs(site_generate);
    // site_generate owns the full render, bundle, and manifest artifact.
    if (ctx.hasCharm("rw")) { return; }
    // Name the files, not the set. "MAGUS.md or CHANGELOG.md or generated docs Markdown
    // drifted" tells a reader only that one of nine things moved, and this gate fires
    // where the tree is not in front of them. changedSince expands the directories in
    // GENERATED, so what comes back is the actual files.
    final moved = drift.changedSince(before, GENERATED);
    if (moved.len() > 0) {
        // Print the diff, not just the names: a name alone still leaves the reader
        // guessing WHY a file they regenerated locally came out different on a runner,
        // and CI is where this mostly fires. magus\info, NOT the command's own streamed
        // output: a tool's stdout goes to the run log and the console shows only "likely
        // diagnostics", which dropped this diff entirely on the first attempt.
        var body = vcs\dirtyDiff(moved);
        // A generated JSON file is one enormous line; bound it so the useful
        // case (a small markdown drift) is not buried by the useless one.
        if (body.len() > 4000) {
            body = body.sub(0, len: 4000) + "\n... truncated; `magus query output <ref>` has it all";
        }
        if (body != "") {
            magus\log.info("generate: what changed on this runner:\n" + body);
        }
        throw "generate: regeneration changed " + moved.join(", ")
            + "; re-run `magus run generate:rw docs` and commit" + drift.secondCause;
    }
}

// Scope dprint by ARGV, not by its config, for the same reason the root project does:
// dprint DISCOVERS a nested dprint.json and formats that subtree under its own config,
// and neither this project's `includes` nor an exclude prunes it. Since the guard-hook
// templates' project under guides/integrations/agents grew Markdown pages of its own,
// a bare run here reached them - the parent target writing into a descendant project,
// which magus rejects as MGS3001. That project formats its own pages.
//
// Keep this list in step with dprint.json's `includes` (minus that one directory); the
// excludes there still apply, so the generated trees stay out.
export fun format(ctx: magus\Context, args: [str]) > void {
    ctx.needs(generate);
    // Keep in step with the dprint args below. Not writesFiles: dprint amends authored
    // pages, so `magus clean` must never claim them. Undeclared, this is MGS4007.
    ctx.modifiesExistingFiles("*.md", "concepts/**/*.md", "guides/*.md",
        "guides/integrations/*.md", "migrating/**/*.md", "reference/**/*.md",
        "setup/**/*.md");
    markdown["dprint"](ctx, {"args": ["./*.md", "./concepts/**/*.md", "./guides/*.md",
        "./guides/integrations/*.md", "./migrating/**/*.md", "./reference/**/*.md",
        "./setup/**/*.md"]});
}

// conventions holds the prose corpus to the conventions page it publishes: no shell prompt
// in a command block, no pinned version standing in for example output, no backticked path
// that has since moved. See docs/conventions.md for what each rule means.
//
// Its OWN target, not a line inside lint, and it deliberately depends on nothing. A prose
// nit should name the thing that is wrong; folding it into lint would report a stale path in
// the README as "docs lint failed", and a target that fails for reasons unrelated to its
// name is a target people learn to ignore. It also means `magus run conventions docs` is a
// two-second check you can run on its own while editing a page.
export fun conventions(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("**/*.md", "lib/conventions.buzz", "engine/gates.buzz",
        workspace.file("README.md"), workspace.file("CONTRIBUTING.md"));
    renderer\site_conventions(ROOT, DOCS);
}
// lint runs the client-side TypeScript gates: tsc for type errors and Biome for the
// banned patterns (no `any`, no non-null assertions - see biome.json). Both need
// node_modules, which it reaches through format -> generate -> preflight; proc.exec raises
// on a non-zero exit, so either gate fails lint.
//
// Markdown formatting is dprint, run once from the root project (its scope is
// dprint.json at the workspace root), so `format` here is a dependency edge and nothing
// else. This project only lints prose; see docs/concepts/generated-files.md.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(format, conventions);
    // The site bundle imports the search grammar from the shared libs/textsearch source,
    // so gate its type-check + biome here: a lib edit fails docs lint through the graph.
    ctx.needs(textsearch\lint);
    // Same reasoning, one directory down: the guide embeds these templates, so their
    // type-check and biome gates are part of this project's lint.
    ctx.needs(agents\lint);
    // The docs corpus is the largest prose surface in the workspace and had no spell
    // check at all - the op was defined and never invoked from any target.
    markdown.typos(ctx);
    proc\exec("pnpm", ["run", "typecheck"], ".", {});
    proc\exec("pnpm", ["exec", "biome", "check", "src"], ".", {});
}
export fun build(ctx: magus\Context, args: [str]) > void { ctx.needs(generate); }

// buzz-test runs render's in-file `test "..." {}` blocks through `magus buzz`, in
// --embedded mode so render's markdown/encoding imports resolve. magus.cmd raises
// on a non-zero exit, so a failing assertion fails this target.
export fun buzz_test(ctx: magus\Context, args: [str]) > void !> any {
    magus\cmd("buzz", args: ["-t", "--embedded", "render.buzz"]);
}

export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format, buzz_test);
}

// security audits what actually ships against the npm advisory database. See
// console/magusfile.buzz for why it is --prod, why it is not folded into lint, and why the
// .npmrc cooling period is the stronger half of this.
export fun security(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(preflight);
    audit.audit();
}

export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(generate, lint, build, test);
}

// build-playground rebuilds the WebAssembly interpreter the playground loads: the
// stock Go toolchain compiles ../cmd/buzz-playground straight into
// gen/playground/buzz.wasm, and Go's own wasm_exec.js glue is copied beside it. The
// glue must come from the SAME Go that built the wasm - it is a matched pair.
//
// gen/, not vendor/. Those bytes were committed for one reason: CI had no TinyGo, so
// it could not reproduce them and they had to be inputs rather than output. CI has
// Go. So this is ordinary render output now, rebuilt at will, and a ~21MB binary
// stops entering git history on every interpreter change.
//
// Stock Go over TinyGo, which built this until now, is a deliberate trade. It costs
// size: 3.4MB brotli against TinyGo's 0.9MB, and no flag closes that gap - `-s -w`
// saves 0.07MB and wasm-opt -Oz shrinks the RAW file while making the compressed one
// slightly larger, because its transforms compress worse than what they replace. It
// buys three things back: the build is byte-reproducible (verified by building twice
// and comparing sha256, which is why this target no longer needs skip_cache, where
// TinyGo's non-determinism forced it), the toolchain is one already pinned rather
// than a second one, and full reflection means std/validate_wasm.go's no-op stub -
// there because TinyGo's wasm reflect omits NumIn/NumOut - can go.
export fun build_playground(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(preflight);
    ctx.needs(gopherbuzz\build);
    ctx.writesFiles("gen/playground/buzz.wasm", "gen/playground/wasm_exec.js");
    fs\mkdirAll("gen/playground");
    // Run from the module root (..) so go resolves its go.mod. -trimpath keeps the
    // output independent of the checkout path, which is half of what makes it
    // reproducible; -s -w drops the symbol table and DWARF.
    os\withEnv({"GOOS": "js", "GOARCH": "wasm"}, fun () > void !> any {
        proc\exec("go",
            ["build", "-trimpath", "-ldflags=-s -w",
             "-o", "docs/gen/playground/buzz.wasm", "./cmd/buzz-playground"],
            "..", {});
    });
    final goroot = proc\exec("go", ["env", "GOROOT"], ".", {}).stdout.trim();
    fs\copyFile(goroot + "/lib/wasm/wasm_exec.js", "gen/playground/wasm_exec.js");
}

// diagrams-generate writes the committed light/dark SVG pair for every diagram under
// diagrams/. The docs site does NOT read these - it inlines a CSS-variable copy at render
// time so a diagram follows the theme toggle. This pair is for GitHub, where the README
// loads an image through <img> and cannot reach the page's CSS at all.
//
// The pair lands under this project rather than beside the terminal recordings in the
// workspace's assets/gen: docs already depends on the root project, so writing there is
// MGS1012, a target reading from and writing into the same project. The README reaches
// them by relative path, which is all GitHub needs. Committed and drift-gated, unlike the
// untracked gen/ site output.
export fun diagrams_generate(ctx: magus\Context, args: [str]) > void !> any {
    // workspace.file, not a project-relative path: the renderer moved out to
    // libs/diagram, and the stale "lib/diagram.buzz" entry left this target's cache
    // key blind to renderer edits - it replayed committed SVGs through a Style change.
    ctx.readsFiles("site/diagrams/*.buzz", workspace.file("libs/diagram/diagram.buzz"));
    ctx.writesFiles("assets/gen/diagram-*.svg");
    // Verified before writing, not after: a diagram that names a package which no longer
    // exists should fail the target rather than ship a rendered picture of a tree that is
    // gone. Scans the Go sources for back-references too, so deleting a diagram whose id a
    // source file still marks is caught from the other side.
    final drift = renderer\site_diagram_drift(ROOT, ["internal/**/*.go", "cmd/**/*.go"]);
    if (drift.len() > 0) {
        foreach (msg in drift) { magus\log.error(msg); }
        throw "diagram anchors are stale: {drift.len()} finding(s)";
    }
    renderer\site_diagrams("assets/gen");
    magus\log.info("rendered the diagram pair into docs/assets/gen");
}

// build-hljs bundles the vendored highlight.js library (src/vendor/hljs.js -> highlight.js@11)
// into gen/assets/hljs.js. syntax-highlight.js imports it same-origin so syntax highlighting
// works offline without any CDN. Bump the version in package.json and the next generate picks
// it up; gen/ is not committed, so generate runs this as one of its stages.
export fun build_hljs(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(preflight);
    // See build-hljs: declare the real artifact rather than inheriting `dist/**`.
    ctx.writesFiles("gen/assets/hljs.js");
    proc\exec("pnpm", ["run", "build-hljs"], ".", {});
    magus\log.info("rebuilt gen/assets/hljs.js");
}

// build-playground-editor bundles the CodeMirror editor the playground loads into
// gen/playground/editor.js. It existed only as a pnpm script before, because the artifact
// was committed and a human ran it after a version bump. gen/ is no longer committed, so
// every published byte needs a target CI can run - a script nothing invokes would have
// shipped a playground with no editor.
export fun build_playground_editor(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(preflight);
    // See build-hljs: declare the real artifact rather than inheriting `dist/**`.
    ctx.writesFiles("gen/playground/editor.js");
    proc\exec("pnpm", ["run", "build-editor"], ".", {});
}

// render is the fast docs/blog iteration path; it skips generated content, bundles, and drift checks.
export fun render(ctx: magus\Context, args: [str]) > void !> any {
	magus\log.hint("docs render updates the site only; run `magus run generate:rw docs` before committing generated docs or changing generator inputs");
    renderer\site_render(ROOT, DOCS, BLOG, OUT,
        magus\targets(), magus\projectGraph());
}
