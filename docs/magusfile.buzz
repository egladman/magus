import "magus";
import "../hack/magusfile/toolchain-policy" as policy;
import "../hack/magusfile/advisories" as advisories;
import "../hack/magusfile/drift" as drift;
import "../hack/magusfile/index" as index;
import "../hack/magusfile/changelog" as changelog;
import "crypto";
import "fs";
import "os";
import "proc";
import "vcs";
import "http";
import "project/../libs/gopherbuzz";
import "project/../libs/textsearch";
import "project/.." as workspace;
// The guide embeds these templates verbatim, so a template edit must rerun this project's gates.
import "project/guides/integrations/agents";
// Aliased: the same-name `render` target would shadow the import and null its members.
import "render" as renderer;

import "magus/spell/typescript";
// Imported for go-run only. Listing it in spells would claim **/*.go for docs.
import "magus/spell/go";
// Imported for typos only. Listing it in spells would claim **/*.md, which the root lints.
import "magus/spell/markdown";

magus\project({
    "tools": {"node": policy\node},
    "spells": [typescript],
    // content-generate reads proto's descriptor and the render reads libs/figure;
    // without these edges the reads are unordered (MGS4004).
    "depends_on": ["..", "../proto", "../libs/figure"],
    // Affected tracks this glob, not the import graph, so it names every input,
    // including the Go trees content-generate renders pages from.
    "sources": ["*.buzz", "lib/**/*.buzz", "engine/**/*.buzz", "site/**/*.buzz", "**/*.md",
                "src/**/*.js", "src/**/*.ts", "src/**/*.css", "playground.html",
                "tour/*.buzz", "package.json", "pnpm-lock.yaml", "tsconfig.json", "biome.json",
                // The binary embeds magus/figure from this file.
                "../libs/figure/figure.buzz",
                // Hand-authored exemptions for abandonedLinkCheck, so a source, not an output.
                "retired.urls.lock",
                // Not the .proto files: src/**/*.ts already covers the client proto generates.
                "../README.md", "../CONTRIBUTING.md", "../blog/**", "../assets/**",
                "../std/**/*.go", "../host/**/*.go",
                "../spells/**/*.buzz", "../internal/spell/**/*.go",
                "../internal/cli/**/*.go", "../internal/config/**/*.go",
                "../internal/render/**/*.go", "../internal/graph/**/*.go",
                "../cmd/magus-docs/**/*.go", "../cmd/magus-spelldocs/**/*.go",
                "../cmd/magus-manpage/**/*.go", "../cmd/magus-examples/**/*.go",
                "../cmd/magus-skilldocs/**/*.go", "../internal/agent/**/*.go",
                "../internal/agent/skills/**/*.md",
                "../cmd/magus-ruledocs/**/*.go", "../internal/guard/**/*.go"],
    // No project-wide outputs: each stage declares its own, so a hit restores only its files.
    "targets": {
        "install": {"skip_cache": "composes the spell's install, whose own entry checks the tree; a replay here would skip that check"},
        "security": {"skip_cache": "reads the npm advisory database, which changes independently of this tree"},
        "ci": {"skip_cache": "composes other targets and declares no outputs of its own; an empty snapshot match reads as a broken cache entry"},
        "test": {"skip_cache": "composes other targets and declares no outputs of its own; an empty snapshot match reads as a broken cache entry"},
        "generate": {"skip_cache": "is the drift gate itself; a replay would skip the check it exists to make"},
        "render": {"skip_cache": "the dev-loop fast path; every invocation must actually re-render gen/"},
		"site-generate": {"skip_cache": "incorporates VCS tags and history, which are outside file hashing, so a replay is unsafe"},
        "figure-engine-digest-generate": {"skip_cache": "hashes the running magus binary, which no input glob can key; it runs before any replay of diagrams-generate, so that stays cacheable"},
        // The build-* targets stay cached: esbuild and the npm deps are pinned.
    },
});

final ROOT = "..";          // the magus/ workspace dir, relative to this project
final DOCS = "docs";        // source docs subtree under ROOT
final BLOG = "blog";        // source blog subtree under ROOT
final OUT  = "gen";         // generated site output, under this project

// install installs node_modules through the typescript spell's pnpm-install op.
// The build-* targets reach it through install, so they do not race parallel installs.
export fun install(ctx: magus\Context, args: [str]) > void !> any { typescript["pnpm-install"](ctx); }

// index-generate refreshes MAGUS.md (this project's target catalog) from this magusfile.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("MAGUS.md");
    ctx.readsFiles("magusfile.buzz", "../magus.yaml", "../internal/render/target_graph.go",
                   "../internal/render/md/md.go", "../internal/hint/cli_command.go");
    index\render("docs");
}

// content-generate regenerates the committed docs Markdown derived from the Go source tree.
export fun content_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(workspace\file("std/**/*.go"), workspace\file("host/**/*.go"),
        workspace\file("spells/**/*.buzz"), workspace\file("internal/spell/**/*.go"),
        workspace\file("internal/cli/**/*.go"), workspace\file("internal/config/**/*.go"),
        workspace\file("internal/render/**/*.go"), workspace\file("internal/graph/**/*.go"),
        workspace\file("cmd/magus-docs/**/*.go"), workspace\file("cmd/magus-spelldocs/**/*.go"),
        workspace\file("cmd/magus-manpage/**/*.go"), workspace\file("cmd/magus-examples/**/*.go"),
        workspace\file("cmd/magus-skilldocs/**/*.go"), workspace\file("internal/agent/**/*.go"),
        workspace\file("internal/agent/skills/**/*.md"), workspace\file("cmd/magus-protodocs/**/*.go"),
        workspace\file("cmd/magus-ruledocs/**/*.go"), workspace\file("internal/guard/**/*.go"),
        // The .proto files are redundant with the descriptor, kept so a key change names the schema.
        workspace\file("proto/magus/**/*.proto"),
        workspace\file("proto/gen/descriptor.binpb"),
        workspace\file("benchmarks/agent/reports/**/*.md"), workspace\file("benchmarks/BENCHMARKS.md"));
    ctx.writesFiles("reference/buzz/*.md", "reference/config.md", "concepts/spells/*.md", "reference/manpage/*.md", "reference/skills/*.md", "reference/rules/*.md", "reference/api/**/*.md", "benchmarks/**/*.md");
    // Hand-written pages with a generated region between markers; as outputs, clean would delete them.
    ctx.modifiesExistingFiles("concepts/spells.md", "concepts/knowledge.md",
        "concepts/review.md",
        // The byte-identical copies pruneContentPageCopies removes.
        "reference/config *.md");
    go["go-run"](ctx, {"args": ["../cmd/magus-docs", "-out", "./reference/buzz"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-configdocs", "-out", "./reference/config.md"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-spelldocs", "-out", "./concepts/spells", "-spells", "../spells"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-manpage", "-format", "md", "-out", "./reference/manpage"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-examples", "-dir", "."]});
    go["go-run"](ctx, {"args": ["../cmd/magus-skilldocs", "-out", "./reference/skills"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-ruledocs", "-out", "./reference/rules"]});
    go["go-run"](ctx, {"args": ["../cmd/magus-protodocs", "-descriptor", "../proto/gen/descriptor.binpb", "-out", "./reference/api"]});

    fs\mkdirAll("benchmarks");
    final contentPages: mut [str] = mut ["reference/config.md", "benchmarks/build-tools.md"];
    foreach (report in fs\glob("../benchmarks/agent/reports/*/*/*.md")) {
        final rel = report.value.split("../benchmarks/agent/reports/").join("");
        final segments = rel.split("/");
        final date = segments[0];
        final provider = segments[1];
        final model = segments[2].split(".md").join("");
        fs\mkdirAll(fs\join("benchmarks", date, provider));
        fs\writeFile(fs\join("benchmarks", rel),
            "---\ntitle: \"Agent harness benchmark (" + date + ", " + provider + " " + model + ")\"\n"
            + "generated_from: benchmarks/agent/reports/" + rel + "\n"
            + "description: One published run of the agent harness benchmark, the controls first, then cost-of-pass, paired deltas and pass rates. Generated from the committed report.\n"
            + "tags: [benchmarks, agents, harness, measurement]\n---\n\n"
            + fs\readFile(report.value));
        contentPages.append(fs\join("benchmarks", rel));
    }
    fs\writeFile("benchmarks/build-tools.md",
        "---\ntitle: Build-tool benchmarks\ngenerated_from: benchmarks/BENCHMARKS.md\n"
        + "description: magus timed against make on one fixture with hyperfine, stamped with the date, hardware and tool versions. Generated from the committed results.\n"
        + "tags: [benchmarks, performance, measurement]\n---\n\n"
        + fs\readFile("../benchmarks/BENCHMARKS.md"));
    pruneContentPageCopies(contentPages);
    pruneGeneratedPageCopies("reference/skills/*.md");
    pruneGeneratedPageCopies("reference/manpage/*.md");
    pruneGeneratedPageCopies("reference/rules/*.md");
}

// Removes macOS-style "name 3.md" copies, and only byte-identical ones: these pages mix
// authored and generated text, so a differing copy may be someone's work.
fun pruneContentPageCopies(canonicals: [str]) > void !> any {
    foreach (canonical in canonicals) {
        if (fs\exists(canonical) == false) { continue; }
        final stem = canonical.sub(0, canonical.len() - ".md".len());
        final body = fs\readFile(canonical);
        foreach (candidate in fs\glob(stem + " *.md")) {
            final suffix = candidate.value.sub(stem.len(), len: candidate.value.len() - stem.len() - ".md".len());
            if (isDecimalCopySuffix(suffix) and fs\readFile(candidate.value) == body) {
                fs\remove(candidate.value);
            }
        }
    }
}

// Matches copies by name alone: every page in these directories is generated.
fun pruneGeneratedPageCopies(pattern: str) > void !> any {
    final pages = fs\glob(pattern);
    foreach (canonical in pages) {
        final stem = canonical.value.sub(0, canonical.value.len() - ".md".len());
        foreach (candidate in pages) {
            if (candidate.value.startsWith(stem + " ") == false) { continue; }
            final suffix = candidate.value.sub(stem.len(), len: candidate.value.len() - stem.len() - ".md".len());
            if (isDecimalCopySuffix(suffix)) {
                fs\remove(candidate.value);
            }
        }
    }
}

fun isDecimalCopySuffix(suffix: str) > bool {
    if (suffix.len() < 2 or suffix.startsWith(" ") == false) { return false; }
    var i = 1;
    while (i < suffix.len()) {
        final code = suffix.byte(i);
        if (code < 48 or code > 57) { return false; }
        i = i + 1;
    }
    return true;
}

// changelog-page renders the changelog from releases/*.yaml and changes/unreleased/.
// Uncommitted: a committed page would conflict in every pull request.
export fun changelog_page(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("templates/changelog.mustache", workspace\file("releases/*.yaml"),
        workspace\file("changes/unreleased/*.md"), workspace\file("hack/magusfile/changelog.buzz"),
        workspace\file("hack/magusfile/commits.buzz"));
    ctx.writesFiles("changelog.md");
    // Entry links resolve from the repo root for GitHub; this page sits inside docs/.
    final page = changelog\render(fs\readFile("templates/changelog.mustache"),
        fragments: changelog\read("../" + changelog\FRAGMENT_DIR),
        shipped: changelog\releases("../releases"));
    fs\writeFile("changelog.md", page
        .split("](docs/").join("](")
        .split("](CONTRIBUTING.md").join("](development/contributing/"));
}

// site-generate renders and publishes the site into gen/.
export fun site_generate(ctx: magus\Context, args: [str]) > void !> any {
    // The render hashes gen/ into the precache manifest, so the bundles must exist first.
    ctx.needs(build_hljs, build_playground_editor, build_playground, changelog_page);
    ctx.readsFiles("render.buzz", "lib/**/*.buzz", "engine/**/*.buzz", "site/**/*.buzz", "**/*.md",
        "src/**/*.js", "src/**/*.ts", "src/**/*.css", "playground.html", "tour/*.buzz",
        "package.json", "pnpm-lock.yaml", "tsconfig.json", "biome.json", "retired.urls.lock",
        "assets/gen/diagram-*-page.svg", workspace\file("libs/figure/figure.buzz"),
        workspace\file("README.md"), workspace\file("CONTRIBUTING.md"), workspace\file("blog/**"),
        workspace\file("assets/**"), workspace\file("releases/*.yaml"));
    ctx.writesFiles("gen/**", "active.urls.lock");
    renderer\site_publish(ROOT, DOCS, BLOG, OUT,
        magus\targets(), magus\projectGraph(),
        ctx.hasCharm("rw"));
}

// generate regenerates the committed derived files and fails on drift. The ignored gen/
// tree belongs to build.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
	magus\log.hint("docs generate refreshes the committed derived content; `magus run build docs` renders the site itself, and `magus run render docs` is the fast docs/blog preview");
    ctx.needs(install);
    final CONTENT = ["reference/buzz", "reference/config.md", "concepts/spells", "concepts/spells.md",
        "concepts/knowledge.md", "concepts/review.md", "reference/manpage", "reference/skills",
        "reference/rules", "reference/api"];
    // Repeats content-generate's declaration: the write is attributed here too, or MGS4007.
    ctx.modifiesExistingFiles("concepts/spells.md", "concepts/knowledge.md", "concepts/review.md",
        "reference/config *.md");
    // Tracked paths only. src/gen is gated by proto:generate and assets/gen by
    // diagrams-generate, which needs a symbol index these shards never build.
    final GENERATED = ["MAGUS.md"] + CONTENT;
    // Hashed before and after: a dirty tree or a git worktree must not disarm the gate.
    final before = drift\hashes(GENERATED);
    ctx.needs(content_generate, index_generate);
    if (ctx.hasCharm("rw")) { return; }
    final moved = drift\changedSince(before, GENERATED);
    if (moved.len() > 0) {
        // magus\log.info, not stdout: the console drops a tool's stdout from its diagnostics.
        var body = vcs\dirtyDiff(moved);
        if (body.len() > 4000) {
            body = body.sub(0, len: 4000) + "\n... truncated; `magus query output <ref>` has it all";
        }
        if (body != "") {
            magus\log.info("generate: what changed on this runner:\n" + body);
        }
        throw "generate: regeneration changed " + moved.join(", ")
            + "; re-run `magus run generate:rw docs` and commit" + drift\secondCause;
    }
}

// format runs dprint over the authored pages.
// The paths go in argv because dprint would otherwise descend into the agents project's
// own dprint.json (MGS3001). Keep them in step with dprint.json `includes`.
export fun format(ctx: magus\Context, args: [str]) > void {
    ctx.needs(generate);
    // Keep in step with the dprint args below.
    ctx.modifiesExistingFiles("*.md", "concepts/**/*.md", "guides/*.md",
        "guides/integrations/*.md", "migrating/**/*.md", "reference/**/*.md",
        "setup/**/*.md");
    markdown["dprint"](ctx, {"args": ["./*.md", "./concepts/**/*.md", "./guides/*.md",
        "./guides/integrations/*.md", "./migrating/**/*.md", "./reference/**/*.md",
        "./setup/**/*.md"]});
}

// conventions holds every doc page to docs/conventions.md and to what it documents.
export fun conventions(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("**/*.md", "lib/conventions.buzz", "lib/crosscheck.buzz", "engine/gates.buzz",
        workspace\file("README.md"), workspace\file("CONTRIBUTING.md"),
        workspace\file("changes/unreleased/*.md"), workspace\file("internal/selfupdate/release-keys.json"),
        workspace\file(".claude/settings.json"),
        agents\file("cursor-hook.buzz"), agents\file("magus-*.buzz"), agents\file("codex-hooks.json"),
        agents\file("opencode-plugin.ts"));
    renderer\site_conventions(ROOT, DOCS);
}
// lint runs conventions, typos, tsc and Biome, plus the lint of each project the site embeds.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    // Before conventions: a page content-generate creates is missing until format finishes.
    ctx.needs(format);
    ctx.needs(conventions);
    ctx.needs(textsearch\lint);
    ctx.needs(agents\lint);
    ctx.needs(workspace\lint_rules);
    markdown.typos(ctx);
    typescript["tsc"](ctx, {"args": ["--noEmit", "-p", "tsconfig.json"]});
    proc\exec("pnpm", ["exec", "biome", "check", "src"], ".", {});
}
// build renders the site cd.yaml publishes. It is uncommitted, so no drift gate applies.
export fun build(ctx: magus\Context, args: [str]) > void {
    ctx.needs(generate);
    ctx.needs(site_generate);
}

// buzz-test runs render's in-file `test "..." {}` blocks through `magus buzz`.
// --embedded so render's markdown and encoding imports resolve.
export fun buzz_test(ctx: magus\Context, args: [str]) > void !> any {
    magus\cmd("buzz", args: ["-t", "--embedded", "render.buzz"]);
}

export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format, buzz_test);
}

// security audits what actually ships against the npm advisory database.
export fun security(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    advisories\audit(inheritedFatal: advisories\inheritedFatal(args));
}

export fun ci(ctx: magus\Context, args: [str]) > void {
    // Two stages so build waits for lint's format instead of racing it (MGS4008).
    ctx.needs(generate, lint, test);
    ctx.needs(build);
}

// build-playground compiles the playground's WebAssembly interpreter with stock Go and
// copies that Go's wasm_exec.js beside it; the two must come from the same toolchain.
// Stock Go over TinyGo: about 4x larger, but reproducible, so the target stays cached.
export fun build_playground(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.needs(gopherbuzz\build);
    ctx.writesFiles("gen/playground/buzz.wasm", "gen/playground/wasm_exec.js");
    fs\mkdirAll("gen/playground");
    // From the module root so go finds go.mod; -trimpath keeps the output reproducible.
    os\withEnv({"GOOS": "js", "GOARCH": "wasm"}, fun () > void !> any {
        proc\exec("go",
            ["build", "-trimpath", "-ldflags=-s -w",
             "-o", "docs/gen/playground/buzz.wasm", "./cmd/buzz-playground"],
            "..", {});
    });
    final goroot = proc\exec("go", ["env", "GOROOT"], ".", {}).stdout.trim();
    fs\copyFile(goroot + "/lib/wasm/wasm_exec.js", "gen/playground/wasm_exec.js");
}

// diagrams-generate lays every figure out from the knowledge graph and fails when the
// committed files move. It is not a generate stage: generate runs where no symbol index
// exists. The files stay in docs because writing the root's assets/gen is MGS1012.
export fun diagrams_generate(ctx: magus\Context, args: [str]) > void !> any {
    if (args.len() > 0) {
        throw "diagrams-generate: unexpected arguments {args.join(" ")}; it takes none";
    }
    // The index lives outside file hashing; the root's digest of it keys this target.
    ctx.needs(workspace\symbol_digest_generate, figure_engine_digest_generate);
    ctx.readsFiles("site/diagrams/*.buzz", "gen/figure-engine.sha256",
        workspace\file("gen/symbol-index.json"), workspace\file("magusfile.buzz"));
    ctx.writesFiles("assets/gen/diagram-*.svg", "assets/gen/diagram-*.json");
    final GENERATED = ["assets/gen"];
    final before = drift\hashes(GENERATED);
    final findings = renderer\site_figures("assets/gen");
    if (findings.len() > 0) {
        foreach (msg in findings) { magus\log.error(msg); }
        throw "diagrams-generate: {findings.len()} finding(s); each names the call to change";
    }
    if (ctx.hasCharm("rw")) { return; }
    final moved = drift\changedSince(before, GENERATED);
    if (moved.len() > 0) {
        throw "diagrams-generate: the figures changed " + moved.join(", ")
            + "; re-run `magus run diagrams-generate:rw docs` and commit" + drift\secondCause;
    }
}

// figure-engine-digest-generate writes the running magus binary's SHA-256 to
// gen/figure-engine.sha256. The figures render from the magus/figure copy that binary
// embeds, not from libs/figure/figure.buzz, so diagrams-generate keys on this file: an
// edit to figure.buzz reaches the SVGs only once a rebuilt binary carries it.
export fun figure_engine_digest_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("gen/figure-engine.sha256");
    final body = crypto\sha256File(os\executable()) + "\n";
    final path = fs\join("gen", "figure-engine.sha256");
    if (fs\exists(path) and fs\readFile(path) == body) { return; }
    fs\mkdirAll("gen");
    fs\writeFile(path, body);
}

// build-hljs bundles highlight.js into gen/assets/hljs.js so the site highlights without a CDN.
export fun build_hljs(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.writesFiles("gen/assets/hljs.js");
    typescript["esbuild"](ctx, {"args": ["src/vendor/hljs.ts", "--bundle", "--minify", "--format=esm",
                                         "--outfile=gen/assets/hljs.js"]});
    magus\log.info("rebuilt gen/assets/hljs.js");
}

// build-playground-editor bundles the CodeMirror editor the playground loads into
// gen/playground/editor.js.
export fun build_playground_editor(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.writesFiles("gen/playground/editor.js");
    typescript["esbuild"](ctx, {"args": ["src/playground/editor.js", "--bundle", "--minify", "--format=esm",
                                         "--outfile=gen/playground/editor.js"]});
}

// render is the fast docs/blog iteration path; it skips generated content, bundles, and drift checks.
export fun render(ctx: magus\Context, args: [str]) > void !> any {
	magus\log.hint("docs render updates the site only; run `magus run generate:rw docs` before committing generated docs or changing generator inputs");
    // Uncommitted, so a fresh checkout lacks it.
    ctx.needs(changelog_page);
    renderer\site_render(ROOT, DOCS, BLOG, OUT,
        magus\targets(), magus\projectGraph());
}
