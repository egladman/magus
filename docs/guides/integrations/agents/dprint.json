{
  // This project's own Markdown: the per-host guide pages that live beside the templates
  // they document. Every project with Markdown carries its own dprint.json extending
  // dprint-base.json, so the rules live with the project.
  //
  // Patterns are "./"-anchored: a slash-less dprint pattern matches at any depth, so a
  // bare "*.md" would sweep every project from here.
  //
  // The parent (docs) excludes this directory, and the markdown spell runs dprint with
  // --config-discovery=ignore-descendants, so docs' format never writes here (MGS3001).
  "extends": "../../../../dprint-base.json",
  "includes": ["./*.md"]
}
