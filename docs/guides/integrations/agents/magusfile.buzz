// No build target: hosts run the Buzz templates through `magus buzz`, and OpenCode's Bun
// loads the plugin from source. cmd/magus/testdata/script/guard_templates.txtar runs the templates.

import "magus";
import "project/../../../.." as workspace;
import "./lib/embed" as embed;
import "../../../../hack/magusfile/drift" as drift;
import "../../../../hack/magusfile/index" as index;

import "proc";
import "fs";
import "result";
import "semver";
import "magus/spell/typescript";
// Imported for dprint only. Listing it in spells would claim *.md, which the root lints.
import "magus/spell/markdown";

magus\project({
    "spells": [typescript],
    // Affected tracks this glob, not the import graph, so it names every input.
    "sources": ["*.ts", "*.buzz", "lib/*.buzz", "codex-hooks.json", "*.md", "*.tmpl",
                "package.json", "pnpm-lock.yaml", "tsconfig.json", "biome.json",
                "dprint.json",
                // The Claude Code mod. Only Claude Code's engine can test or type-check
                // it, so only mod-test runs on it, and ci cannot compose that.
                "claude-code/mod/**"],
    "targets": {
        "install": {"skip_cache": "composes the spell's install, whose own entry checks the tree; a replay here would skip that check"},
        "mod-test": {"skip_cache": "runs on the installed claude, whose version no input glob can key"},
        "mod_types_generate": {"skip_cache": "runs on the installed claude, whose version no input glob can key"},
    },
});

// install installs node_modules through the typescript spell's pnpm-install op.
export fun install(ctx: magus\Context, args: [str]) > void !> any { typescript["pnpm-install"](ctx); }

// The schema directory, not its files: drift\expand walks it, so new schemas are covered.
fun generatedOutputs() > [str] {
    return ["guard-templates.md", "README.md", "../../../../internal/render/testdata/hosts/cursor/gen", OPENCODE_COPY, GLUE_COPY];
}

// OpenCode's plugin runs its glue from .opencode/magus/runtime (internal/interp/bindings/opencode),
// so its spell carries its own copy rather than the hook glue's.
final OPENCODE_COPY = "../../../../spells/harness/opencode/runtime";
final OPENCODE_GLUE = ["magus-observe.buzz", "magus-buzz-check.buzz", "magus-reclaim-disk.buzz", "lib/hook.buzz"];

// The copy of the glue the binary embeds (internal/agent) and installs into a workspace.
final GLUE_COPY = "../../../../internal/agent/gen/glue";

// Every script a shipped harness spell's hooks run, and the module they import. A hook
// naming one missing here fails that harness's load.
final GLUE = ["cursor-hook.buzz", "magus-buzz-check.buzz", "magus-checkpoint.buzz", "magus-command.buzz",
              "magus-duration.buzz", "magus-observe.buzz", "magus-reclaim-disk.buzz", "magus-rehydrate.buzz",
              "magus-session.buzz", "lib/hook.buzz"];

// Renders guard-templates.md: the prose in guard-templates.md.tmpl, with each marker
// replaced by the file it names.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    // Hashed by name before the generators run, so a dirty tree does not disarm the check.
    // vcs\status names paths from the repository root, which this directory cannot match.
    final before = drift\hashes(generatedOutputs());

    ctx.needs(cursor_schemas_generate, index_generate);
    ctx.readsFiles(["guard-templates.md.tmpl", "*.buzz", "lib/*.buzz",
                    "../../../../spells/harness/*/spell.buzz", "../../../../internal/spell/harness.buzz"]);
    final copies = mut {<str: str>};
    foreach (name in GLUE) { copies["{GLUE_COPY}/{name}"] = name; }
    foreach (name in OPENCODE_GLUE) { copies["{OPENCODE_COPY}/{name}"] = name; }
    // Literal, as the static read requires: one path per GLUE and OPENCODE_GLUE entry.
    ctx.writesFiles(["guard-templates.md", "README.md",
        "../../../../spells/harness/opencode/runtime/magus-observe.buzz", "../../../../spells/harness/opencode/runtime/magus-buzz-check.buzz",
        "../../../../spells/harness/opencode/runtime/magus-reclaim-disk.buzz", "../../../../spells/harness/opencode/runtime/lib/hook.buzz",
        "../../../../internal/agent/gen/glue/cursor-hook.buzz", "../../../../internal/agent/gen/glue/magus-buzz-check.buzz",
        "../../../../internal/agent/gen/glue/magus-checkpoint.buzz", "../../../../internal/agent/gen/glue/magus-command.buzz",
        "../../../../internal/agent/gen/glue/magus-duration.buzz", "../../../../internal/agent/gen/glue/magus-observe.buzz",
        "../../../../internal/agent/gen/glue/magus-reclaim-disk.buzz", "../../../../internal/agent/gen/glue/magus-rehydrate.buzz",
        "../../../../internal/agent/gen/glue/magus-session.buzz", "../../../../internal/agent/gen/glue/lib/hook.buzz"]);
    foreach (dest, name in copies) {
        final content = fs\readFile(name);
        if (ctx.hasCharm("rw")) {
            fs\writeFileAtomic(dest, content: content);
        } else if ((fs\readFile(dest) catch "") != content) {
            throw "[MGS4006] generate: the embedded glue " + dest + " is stale; run magus run generate:rw docs/guides/integrations/agents";
        }
    }
    final tmpl = fs\readFile("guard-templates.md.tmpl");
    final files = mut {<str: str>};
    foreach (name in embed\embedNames(tmpl)) {
        files[name] = fs\readFile(name);
    }
    final rendering = embed\render(tmpl, files: files);
    if (rendering.error -> failed) { throw failed.message; }
    final rendered = rendering.value!;
    // A spell imported here is a handle, not its functions, so a script
    // at the root calls each harness spell's lists.
    final row = fun (alias: str, id: str, hooks: str) > str
        => "bindings\\HookMatrix\{id = \"{id}\", hooks = {hooks}, "
            + "unsupported = {alias}\\mgs_listUnsupportedHooks()\}";
    final listed = fun (alias: str, id: str) > str => row(alias, id: id, hooks: "{alias}\\mgs_listHooks()");
    final script = "import \"io\"; import \"magus/spell\"; "
        + "import \"docs/guides/integrations/agents/lib/bindings\" as bindings; "
        + "import \"spells/harness/claude-code/spell\" as claudeCode; "
        + "import \"spells/harness/claude-code-mod/spell\" as claudeCodeMod; "
        + "import \"spells/harness/codex/spell\" as codex; "
        + "import \"spells/harness/cursor/spell\" as cursor; "
        + "import \"spells/harness/opencode/spell\" as opencode; "
        + "fun main(args: [str]) > void !> any \{ final page = bindings\\page(["
        + [listed("claudeCode", id: "claude-code"), row("claudeCodeMod", id: "claude-code-mod", hooks: "[<HookCommand>]"),
           listed("codex", id: "codex"), listed("cursor", id: "cursor"), listed("opencode", id: "opencode")].join(", ")
        + "]); if (page.error -> failed) \{ throw failed.message; \} io\\stdout.write(page.value!); \}";
    // magus\cmd trims its stdout, and a Markdown file ends on a newline.
    final matrix = magus\cmd("buzz", args: ["-e", script],
        opts: magus\CommandOptions{dir = "../../../..", quiet = true}).stdout + "\n";

    if (ctx.hasCharm("rw")) {
        fs\writeFile("guard-templates.md", content: rendered);
        fs\writeFile("README.md", content: matrix);
        return;
    }

    // Compared, never written: writing here would edit the tree under judgment (MGS1035).
    if ((fs\readFile("guard-templates.md") catch "") != rendered) {
        throw "[MGS4006] generate: guard-templates.md does not match its template; re-run "
            + "`magus run generate:rw docs/guides/integrations/agents` and commit it";
    }
    if ((fs\readFile("README.md") catch "") != matrix) {
        throw "[MGS4006] generate: README.md does not match the harness spells' hook bindings; re-run "
            + "`magus run generate:rw docs/guides/integrations/agents` and commit it";
    }
    final changed = drift\changedSince(before, generatedOutputs());
    if (changed.len() > 0) {
        throw "[MGS4006] generate: regeneration changed generated files; re-run "
            + "`magus run generate:rw docs/guides/integrations/agents` and commit: "
            + changed.join(", ");
    }
}

// Renders MAGUS.md, this project's target catalog.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["MAGUS.md"]);
    ctx.readsFiles(["magusfile.buzz", "../../../../magus.yaml", "../../../../internal/render/target_graph.go",
                    "../../../../internal/render/md/md.go", "../../../../internal/hint/cli_command.go"]);
    index\render("docs/guides/integrations/agents");
}

// Emits internal/render/testdata/hosts/cursor/gen from the zod schemas @cursor/sdk publishes.
// It writes into internal/render's testdata, where its glue tests and internal/agent's tests read them.
export fun cursor_schemas_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.writesFiles(["../../../../internal/render/testdata/hosts/cursor/gen/*.schema.json"]);
    _ = proc\exec("node", ["cursor-schemas.ts"], ".");
}


// Emits claude-code/mod/types/gen from the types the engine writes when a claude session
// loads its plugin-authoring skill. It runs where claude is installed; CI reads the
// committed copy, so ci never composes it.
export fun mod_types_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["claude-code/mod/types/gen/*.d.ts"]);
    final ask = "/plugin-authoring reply only with the absolute path of the types/claude-code.d.ts file this skill names";
    final source = proc\exec("claude", args: ["-p", "--model", "haiku", ask], dir: ".",
        opts: proc\ExecOptions{quiet = true}).stdout.trim();
    if (!source.endsWith("/types/claude-code.d.ts")) {
        throw "mod-types-generate: claude did not name the engine's types file; it printed: " + source;
    }
    final text = fs\readFile(source);
    final testing = text.indexOf("declare module 'claude-code/testing'");
    final tools = text.indexOf("// The inputs of the built-in tools");
    if (testing == null or tools == null) {
        throw "mod-types-generate: " + source + " no longer has the testing and tools sections this target splits on";
    }
    final dest = "claude-code/mod/types/gen/";
    fs\writeFile(dest + "claude-code.d.ts", content: text.sub(0, len: testing!));
    fs\writeFile(dest + "claude-code-testing.d.ts", content: text.sub(testing!, len: tools! - testing!));
    fs\writeFile(dest + "claude-code-tools.d.ts", content: text.sub(tools!, len: text.len() - tools!));
}

// lint runs the TypeScript type-check of the templates and of the Claude Code mod, Biome,
// and a Buzz type-check of the templates. The mod checks against its committed types/gen.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    typescript["tsc"](ctx, {"args": ["--noEmit", "-p", "tsconfig.json"]});
    typescript["tsc"](ctx, {"args": ["--noEmit", "-p", "claude-code/mod/tsconfig.json"]});
    typescript["biome-check"](ctx);
    final checked = checkBuzz();
    if (checked.error -> failed) { throw failed.message; }
}

// The templates are upstream-strict and lib/ is engine Buzz, so each set gets its own
// check. Not quiet: quiet would swallow the diagnostics on failure.
fun checkBuzz() > result\Result::<bool> {
    try {
        var strict = mut ["--check", "cursor-hook.buzz"];
        foreach (script in fs\glob("magus-*.buzz")) {
            strict.append(script.value);
        }
        _ = magus\cmd("buzz", args: strict);

        var embedded = mut ["--check", "--embedded"];
        foreach (script in fs\glob("lib/*.buzz")) {
            embedded.append(script.value);
        }
        _ = magus\cmd("buzz", args: embedded);
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err);
    }
}

// test runs the OpenCode plugin's transport cases under node; the test supplies Bun.spawn.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    // go_build places the <root>/magus the live test's guard judges with.
    ctx.needs(install, workspace\opencode_runtime_generate, workspace\go_build);
    ctx.readsFiles(["*.ts", "*.json", "../../../../spells/harness/opencode/plugins/*.js", "../../../../spells/harness/opencode/probe.ts", "../../../../spells/harness/opencode/gen/*"]);
    final run = mut ["--test"];
    foreach (t in fs\glob("*.test.ts")) { run.append(t.value); }
    _ = proc\exec("node", run, ".");
}

// mod-test runs the Claude Code mod's tests on the engine that loads it.
// CI has no claude, so ci never composes it.
// 2.1.308 is the oldest build seen to carry `plugin test`.
export fun mod_test(ctx: magus\Context, args: [str]) > void !> any {
    final printed = proc\exec("claude", args: ["--version"], dir: ".", opts: proc\ExecOptions{quiet = true}).stdout;
    final version = printed.trim().split(" ")[0];
    if (!semver\isValid(version) or !semver\satisfies(version, constraint: ">= 2.1.308")) {
        throw "mod-test: `claude plugin test` needs claude 2.1.308 or newer; `claude --version` on PATH printed: " + printed.trim();
    }
    _ = proc\exec("claude", args: ["plugin", "test", "claude-code/mod"], dir: ".");
}

// The anchor `magus affected ci` keys off.
export fun ci(ctx: magus\Context, args: [str]) > void {
    // Before format, so dprint formats the freshly rendered page; format itself must not write the
    // cursor schemas generate emits outside a docs worker's lease.
    ctx.needs(generate);
    ctx.needs(format);
    ctx.needs(lint);
    ctx.needs(test);
}

// format owns this directory's Markdown; the docs project formatting it would be MGS3001.
export fun format(ctx: magus\Context, args: [str]) > void {
    ctx.needs(install);
    // Inputs, not outputs: an output declaration would let magus clean delete the guide pages.
    ctx.writesFiles(["*.md", "*.ts"], editsExistingSource: true);
    markdown["dprint"](ctx);
    typescript["biome-format"](ctx);
}
