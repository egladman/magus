// No build target: hosts run the Buzz templates through `magus buzz`, and OpenCode's Bun
// loads the plugin from source. cmd/magus/testdata/script/guard_templates.txtar runs the templates.

import "magus";
import "./lib/embed" as embed;
import "../../../../hack/magusfile/drift" as drift;
import "../../../../hack/magusfile/index" as index;
import "os";

import "proc";
import "fs";
import "magus/spell/typescript";
// Imported for dprint only. Listing it in spells would claim *.md, which the root lints.
import "magus/spell/markdown";

magus\project({
    "spells": [typescript],
    // Affected tracks this glob, not the import graph, so it names every input.
    "sources": ["*.ts", "*.buzz", "lib/*.buzz", "codex-hooks.json", "*.md", "*.tmpl", "host-e2e/*.json",
                "host-e2e/*.tmpl",
                "package.json", "pnpm-lock.yaml", "tsconfig.json", "biome.json",
                "dprint.json"],
    "targets": {
        "install": {"skip_cache": "composes the spell's install, whose own entry checks the tree; a replay here would skip that check"},
    },
});

// install installs node_modules through the typescript spell's pnpm-install op.
export fun install(ctx: magus\Context, args: [str]) > void !> any { typescript["pnpm-install"](ctx); }

// The schema directory, not its files: drift\expand walks it, so new schemas are covered.
fun generatedOutputs() > [str] {
    return ["guard-templates.md", "../../../../testdata/hosts/cursor/gen"];
}

// Renders guard-templates.md: the prose in guard-templates.md.tmpl, with each marker
// replaced by the file it names.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    // Hashed by name before the generators run, so a dirty tree does not disarm the check.
    // vcs\status names paths from the repository root, which this directory cannot match.
    final before = drift\hashes(generatedOutputs());

    ctx.needs(cursor_schemas_generate, index_generate);
    ctx.readsFiles("guard-templates.md.tmpl", "*.buzz", "lib/*.buzz");
    ctx.writesFiles("guard-templates.md");
    final tmpl = fs\readFile("guard-templates.md.tmpl");
    final files = mut {<str: str>};
    foreach (name in embed\embedNames(tmpl)) {
        files[name] = fs\readFile(name);
    }
    final rendered = embed\render(tmpl, files: files);

    if (ctx.hasCharm("rw")) {
        fs\writeFile("guard-templates.md", content: rendered);
        return;
    }

    // Compared, never written: writing here would edit the tree under judgment (MGS1035).
    if ((fs\readFile("guard-templates.md") catch "") != rendered) {
        throw "[MGS4006] generate: guard-templates.md does not match its template; re-run "
            + "`magus run generate:rw docs/guides/integrations/agents` and commit it";
    }
    final changed = drift\changedSince(before, generatedOutputs());
    if (changed.len() > 0) {
        throw "[MGS4006] generate: regeneration changed generated files; re-run "
            + "`magus run generate:rw docs/guides/integrations/agents` and commit: "
            + changed.join(", ");
    }
}

// Renders MAGUS.md, this project's target catalog.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("MAGUS.md");
    ctx.readsFiles("magusfile.buzz", "../../../../magus.yaml", "../../../../internal/render/target_graph.go",
                   "../../../../internal/render/md/md.go", "../../../../internal/hint/cli_command.go");
    index\render("docs/guides/integrations/agents");
}

// Emits testdata/hosts/cursor/gen from the zod schemas @cursor/sdk publishes.
// It writes into the root project's testdata, where internal/agent's tests read them.
export fun cursor_schemas_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.writesFiles("../../../../testdata/hosts/cursor/gen/*.schema.json");
    proc\exec("node", ["cursor-schemas.ts"], ".", {});
}


// lint runs the TypeScript type-check, Biome, and a Buzz type-check of the templates.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    typescript["tsc"](ctx, {"args": ["--noEmit", "-p", "tsconfig.json"]});
    typescript["biome-check"](ctx);
    checkBuzz();
}

// The templates are upstream-strict and lib/ is engine Buzz, so each set gets its own
// check. Not quiet: quiet would swallow the diagnostics on failure.
fun checkBuzz() > void !> any {
    var strict = mut ["--check", "cursor-hook.buzz"];
    foreach (script in fs\glob("magus-*.buzz")) {
        strict.append(script.value);
    }
    magus\cmd("buzz", args: strict);

    var embedded = mut ["--check", "--embedded"];
    foreach (script in fs\glob("lib/*.buzz")) {
        embedded.append(script.value);
    }
    magus\cmd("buzz", args: embedded);
}

// test runs the OpenCode plugin's transport cases under node; the test supplies Bun.spawn.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    final run = mut ["--test"];
    foreach (t in fs\glob("*.test.ts")) { run.append(t.value); }
    proc\exec("node", run, ".", {});
}

// host_integration drives real local agent hosts, spending the caller's auth and quota,
// so it stays out of ci. Opt in with MAGUS_HOST_E2E=1 and pass descriptors:
//
//   MAGUS_HOST_E2E=1 magus run host-integration docs/guides/integrations/agents -- \
//     host-e2e/example.json
//
// An all-skip run exits nonzero. MAGUS_HOST_E2E_KEEP=1 keeps passing workspaces.
export fun host_integration(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    var command = mut ["host-e2e.ts"];
    foreach (arg in args) { command.append(arg); }
    proc\exec("node", args: command, dir: ".", opts: {});
}

// The anchor `magus affected ci` keys off.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    ctx.needs(lint);
    ctx.needs(test);
}

// format owns this directory's Markdown; the docs project formatting it would be MGS3001.
export fun format(ctx: magus\Context, args: [str]) > void {
    ctx.needs(install);
    // Before dprint, so it formats the freshly rendered page.
    ctx.needs(generate);
    // Inputs, not outputs: an output declaration would let magus clean delete the guide pages.
    ctx.modifiesExistingFiles("*.md", "*.ts");
    markdown["dprint"](ctx);
    typescript["biome-format"](ctx);
}
