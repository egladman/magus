namespace dictionary;

import "std";
import "markdown";
import "serialize";
import "lib/glossary" as _;   // glossarySlug

// TermPage is what the index in glossary.md lists for one docs/glossary/<slug>.md page.
export object TermPage {
    file: str = "",
    slug: str = "",
    group: str = "",
    order: int = 0,
    title: str = "",
    description: str = "",
}

// TermProblem is one way a term page departs from its template. lib/conventions wraps it as
// a ConventionFinding, the way it wraps an AdrProblem.
export object TermProblem {
    line: int = 0,
    message: str = "",
}

// UsageDoc is one docs section the knowledge graph names a term in; UsageSymbol is one code
// symbol that carries the term's name.
export object UsageDoc {
    label: str = "",
    file: str = "",
    anchor: str = "",
}

export object UsageSymbol {
    name: str = "",
    language: str = "",
}

// GROUPS is the index order; a term page names its group as its second tag.
export final GROUPS = ["core-model", "execution-and-caching", "telemetry-and-health",
    "insight-and-knowledge", "design-and-scope", "agents", "sessions-and-leases", "console"];
final GROUP_TITLES = {"core-model": "Core model", "execution-and-caching": "Execution and caching",
    "telemetry-and-health": "Telemetry and health", "insight-and-knowledge": "Insight and knowledge",
    "design-and-scope": "Design and scope", "agents": "Agents", "sessions-and-leases": "Sessions and leases",
    "console": "Console"};
final SECTIONS = ["Elsewhere", "Example", "Used in", "See also"];
final REQUIRED = ["Example", "Used in", "See also"];

export final INDEX_BEGIN = "<!-- BEGIN GLOSSARY INDEX (generated by glossary-index-generate from each term page's front matter; edit the term pages, not this list) -->";
export final INDEX_END = "<!-- END GLOSSARY INDEX -->";
export final USAGE_BEGIN = "<!-- BEGIN GLOSSARY USAGE (generated by glossary-usage-generate from the knowledge graph; edit the generator, not this list) -->";
export final USAGE_END = "<!-- END GLOSSARY USAGE -->";

// Headings every reference page repeats; a hit on one says nothing about the term.
final GENERIC_LABELS = ["why", "see also", "seeing it", "example", "examples", "overview", "usage", "fix"];

// isTermPage is true for docs/glossary/<slug>.md and nothing else.
export fun isTermPage(file: str) > bool {
    final segs = file.split("/");
    return segs.len() >= 2 and segs[segs.len() - 2] == "glossary" and segs[segs.len() - 1].endsWith(".md");
}

fun slugOf(file: str) > str {
    final segs = file.split("/");
    final base = segs[segs.len() - 1];
    return base.sub(0, len: base.len() - 3);
}

// compact folds a term to the letters and digits a code symbol would spell it with, so
// "Lease id" meets LeaseID and "One-off" meets OneOff.
export fun compact(term: str) > str {
    final low = term.lower();
    final parts = mut [<str>];
    var i = 0;
    while (i < low.len()) {
        final b = low.byte(i);
        if ((b >= 97 and b <= 122) or (b >= 48 and b <= 57)) { parts.append(low.sub(i, len: 1)); }
        i = i + 1;
    }
    return parts.join("");
}

fun tagsOf(fm: serialize\Boxed) > [str] {
    final tags = mut [<str>];
    foreach (t in fm.q("tags").listValue()) { tags.append(t.stringValue()); }
    return tags;
}

// termPage reads the index entry for file from its front matter. A missing order sorts the
// page last and an unknown group leaves it out of the index; termProblems reports both.
export fun termPage(file: str, md: str) > TermPage !> any {
    final fm = serialize\jsonDecode(markdown\frontmatter(md));
    final tags = tagsOf(fm);
    return TermPage{
        file = file,
        slug = slugOf(file),
        group = if (tags.len() >= 2) tags[1] else "",
        order = fm.q("order").integer() ?? 9999,
        title = fm.q("title").stringValue(),
        description = fm.q("description").stringValue(),
    };
}

fun isFence(t: str) > bool {
    return t.startsWith("```") or t.startsWith("~~~");
}

// Walk is where termProblems stands in a page body.
object Walk {
    h1: int = 0,
    lead: bool = false,
    inFence: bool = false,
    section: str = "",
    sectionLine: int = 0,
    seen: mut [str],
    fences: int = 0,
    usageBlock: bool = false,
}

fun closeSection(w: Walk, problems: mut [TermProblem]) > void {
    if (w.section == "Example" and w.fences == 0) {
        problems.append(TermProblem{ line = w.sectionLine, message = "`## Example` holds no fenced example; show one real command or code block" });
    }
    if (w.section == "Used in" and w.usageBlock == false) {
        problems.append(TermProblem{ line = w.sectionLine, message = "`## Used in` has no generated block; run `magus run glossary-usage-generate:rw docs`" });
    }
}

fun openSection(w: mut Walk, heading: str, n: int, problems: mut [TermProblem]) > void {
    if (w.lead == false) {
        problems.append(TermProblem{ line = n, message = "no definition before `## {heading}`; open with what the word means in magus" });
    }
    final at = SECTIONS.indexOf(heading);
    if (at == null) {
        problems.append(TermProblem{ line = n, message = "`## {heading}` is not a template section; use Elsewhere, Example, Used in or See also" });
    } else {
        foreach (s in w.seen) {
            if ((SECTIONS.indexOf(s) ?? 0) > at!) {
                problems.append(TermProblem{ line = n, message = "`## {heading}` is out of order; order the sections Elsewhere, Example, Used in, See also" });
                break;
            }
        }
    }
    w.seen.append(heading);
    w.section = heading;
    w.sectionLine = n;
    w.fences = 0;
}

fun step(w: mut Walk, line: str, n: int, problems: mut [TermProblem]) > void {
    final t = line.trim();
    if (isFence(t)) {
        if (w.inFence == false) { w.fences = w.fences + 1; }
        w.inFence = !w.inFence;
    } else if (w.inFence) {
        return;
    } else if (line.startsWith("## ")) {
        closeSection(w, problems: problems);
        openSection(w, heading: line.sub(3).trim(), n: n, problems: problems);
    } else if (line.startsWith("# ")) {
        if (w.h1 == 0) { w.h1 = n; }
    } else if (t == USAGE_BEGIN) {
        w.usageBlock = true;
    } else if (t != "" and w.h1 > 0 and w.section == "") {
        w.lead = true;
    }
}

// termProblems holds a docs/glossary/<slug>.md page to the term page template in
// docs/conventions.md, and returns nothing for any other page. lib/conventions already
// checks the title, description and H1 every page shares.
export fun termProblems(file: str, md: str) > [TermProblem] !> any {
    final problems: mut [TermProblem] = mut [<TermProblem>];
    if (isTermPage(file) == false) { return problems; }
    final page = termPage(file, md: md);
    final fm = serialize\jsonDecode(markdown\frontmatter(md));
    final tags = tagsOf(fm);
    if (tags.len() < 2 or tags[0] != "glossary" or GROUPS.indexOf(tags[1]) == null) {
        problems.append(TermProblem{ line = 1, message = "`tags` must open with `glossary` and then one group: {GROUPS.join(", ")}" });
    }
    if (fm.q("order").integer() == null) {
        problems.append(TermProblem{ line = 1, message = "front matter has no numeric `order`; the index in glossary.md sorts each group by it" });
    }
    // The file name is the anchor the single-page glossary gave the term, so the index H3
    // that keeps that anchor and the page it links agree.
    if (page.slug != glossarySlug(page.title)) {
        problems.append(TermProblem{ line = 1, message = "the file is named `{page.slug}.md` but the title slugs to `{glossarySlug(page.title)}`; rename one so the URL is the term" });
    }
    final lines = md.split("\n");
    var start = 0;
    if (lines.len() > 0 and lines[0] == "---") {
        start = 1;
        while (start < lines.len() and lines[start] != "---") { start = start + 1; }
        start = start + 1;
    }
    final w = mut Walk{ seen = mut [<str>] };
    var i = start;
    while (i < lines.len()) {
        step(w, line: lines[i], n: i + 1, problems: problems);
        i = i + 1;
    }
    closeSection(w, problems: problems);
    foreach (s in REQUIRED) {
        if (w.seen.indexOf(s) == null) {
            problems.append(TermProblem{ line = lines.len(), message = "no `## {s}`; every term page carries Example, Used in and See also" });
        }
    }
    return problems;
}

// glossaryIndex renders the block glossary.md carries between INDEX_BEGIN and INDEX_END:
// one H2 per group, one H3 per term, and the term's description linking its page. The H3
// keeps the anchor the old single-page glossary gave the term, so a glossary.md#<slug> link
// from outside still lands on it; a link inside the heading would fold its target into
// goldmark's id.
export fun glossaryIndex(pages: [TermPage]) > str {
    final rows = mut [INDEX_BEGIN];
    foreach (group in GROUPS) {
        final members = mut [<TermPage>];
        foreach (p in pages) {
            if (p.group == group) { members.append(p); }
        }
        if (members.len() == 0) { continue; }
        members.sort(fun (a: TermPage, b: TermPage) > bool => a.order < b.order or (a.order == b.order and a.slug < b.slug));
        rows.append("");
        rows.append("## {GROUP_TITLES[group] ?? group}");
        foreach (p in members) {
            rows.append("");
            rows.append("### {p.title}");
            rows.append("");
            // A description is plain text, so `magus run <target>` must not reach Markdown as a tag.
            rows.append("{p.description.replace("<", with: "\\<")} [{p.title} in full](glossary/{p.slug}.md).");
        }
    }
    rows.append("");
    rows.append(INDEX_END);
    return rows.join("\n");
}

// usefulDoc keeps a docs section worth sending a reader to: outside the glossary, under
// docs/, and not one of the headings every reference page repeats.
export fun usefulDoc(id: str, label: str) > bool {
    if (id.startsWith("docsection:docs/") == false) { return false; }
    if (id.startsWith("docsection:docs/glossary")) { return false; }
    return GENERIC_LABELS.indexOf(label.lower()) == null;
}

// docFromID splits docsection:docs/<file>#<anchor> into a UsageDoc.
export fun docFromID(id: str, label: str) > UsageDoc {
    final rest = id.sub("docsection:docs/".len());
    final hash = rest.indexOf("#");
    if (hash == null) { return UsageDoc{ label = label, file = rest }; }
    return UsageDoc{ label = label, file = rest.sub(0, len: hash!), anchor = rest.sub(hash! + 1) };
}

// symbolFromID names a SCIP symbol id the way a reader would type it to `magus refs`, or
// returns an empty name for generated code and for anything but a top-level type. Go:
// "types.Job"; a Buzz host type: "magus\Job"; TypeScript: "Pane" in console.
export fun symbolFromID(id: str, term: str) > UsageSymbol {
    if (id.endsWith("#") == false or id.indexOf("/gen/") != null or id.indexOf("_pb.") != null) {
        return UsageSymbol{};
    }
    final slash = id.split("/");
    final name = slash[slash.len() - 1].sub(0, len: slash[slash.len() - 1].len() - 1);
    if (compact(name) != compact(term)) { return UsageSymbol{}; }
    if (id.startsWith("symbol:gomod ")) {
        final ticks = id.split("`");
        if (ticks.len() < 3) { return UsageSymbol{}; }
        final segs = ticks[1].split("/");
        return UsageSymbol{ name = "{segs[segs.len() - 1]}.{name}", language = "Go" };
    }
    if (id.startsWith("symbol:buzz host ")) {
        final mod = id.sub("symbol:buzz host ".len()).split("/")[0];
        return UsageSymbol{ name = "{mod}\\{name}", language = "Buzz host type" };
    }
    if (id.startsWith("symbol:npm ")) {
        final pkg = id.sub("symbol:npm ".len()).split(" ")[0];
        return UsageSymbol{ name = name, language = "TypeScript, {pkg}" };
    }
    return UsageSymbol{};
}

// usageBlock renders the block a term page carries between USAGE_BEGIN and USAGE_END.
// Links are relative to docs/glossary/.
export fun usageBlock(docs: [UsageDoc], symbols: [UsageSymbol]) > str {
    final rows = mut [USAGE_BEGIN, ""];
    if (docs.len() == 0 and symbols.len() == 0) {
        rows.append("The knowledge graph holds no docs section or code type by this name outside the glossary.");
    }
    if (docs.len() > 0) {
        rows.append("In the docs:");
        rows.append("");
        foreach (d in docs) {
            final anchor = if (d.anchor != "") "#" + d.anchor else "";
            // A heading can carry a literal `<ref>`, which Markdown would read as an HTML tag.
            final label = d.label.replace("<", with: "\\<").replace("[", with: "\\[").replace("]", with: "\\]");
            rows.append("- [{label}](../{d.file}{anchor})");
        }
    }
    if (symbols.len() > 0) {
        if (docs.len() > 0) { rows.append(""); }
        rows.append("In the code (`magus refs <name>` lists every site):");
        rows.append("");
        foreach (s in symbols) { rows.append("- `{s.name}` ({s.language})"); }
    }
    rows.append("");
    rows.append(USAGE_END);
    return rows.join("\n");
}

// replaceBlock swaps the lines from begin to end in md for block, and raises when either
// marker line is missing.
export fun replaceBlock(md: str, begin: str, end: str, block: str) > str !> str {
    final lines = md.split("\n");
    final b = lines.indexOf(begin);
    final e = lines.indexOf(end);
    if (b == null or e == null or e! < b!) {
        throw "no `{begin}` ... `{end}` block to regenerate";
    }
    final before = lines.sub(0, len: b!);
    final after = lines.sub(e! + 1);
    return before.join("\n") + (if (before.len() > 0) "\n" else "") + block + (if (after.len() > 0) "\n" + after.join("\n") else "");
}

final GOOD_PAGE = "---\ntitle: Lease id\norder: 2\ndescription: The id a worker carries.\ntags: [glossary, sessions-and-leases]\n---\n\n"
    + "# Lease id\n\nThe short identifier a worker carries.\n\n## Elsewhere\n\nOther tools mean a DHCP lease.\n\n"
    + "## Example\n\n```sh\nmagus job exec --lease x -- true\n```\n\n## Used in\n\n" + USAGE_BEGIN + "\n\nnone\n\n" + USAGE_END + "\n\n"
    + "## See also\n\n- [Lease](lease.md)\n";

fun messages(file: str, md: str) > [str] {
    return (termProblems(file, md: md) catch [<TermProblem>]).map(fun (i: int, p: TermProblem) > str => p.message);
}

test "a page in the template has no problems" {
    final got = messages("docs/glossary/lease-id.md", md: GOOD_PAGE);
    std\assert(got.len() == 0, message: "{got}");
}

test "a page outside docs/glossary/ is not judged" {
    std\assert(messages("docs/glossary.md", md: "# x\n").len() == 0, message: "glossary.md");
}

test "a missing example, a stray section and a misnamed file are problems" {
    final noFence = messages("docs/glossary/lease-id.md", md: GOOD_PAGE.replace("```sh\nmagus job exec --lease x -- true\n```\n", with: "Run it.\n"));
    std\assert(noFence.len() == 1 and noFence[0].indexOf("no fenced example") != null, message: "{noFence}");
    final stray = messages("docs/glossary/lease-id.md", md: GOOD_PAGE.replace("## Elsewhere", with: "## History"));
    std\assert(stray.len() == 1 and stray[0].indexOf("not a template section") != null, message: "{stray}");
    final named = messages("docs/glossary/leaseid.md", md: GOOD_PAGE);
    std\assert(named.len() == 1 and named[0].indexOf("rename") != null, message: "{named}");
}

test "sections out of order or missing are problems" {
    final swapped = GOOD_PAGE.replace("## Elsewhere\n\nOther tools mean a DHCP lease.\n\n", with: "")
        .replace("## See also", with: "## Elsewhere\n\nOther tools.\n\n## See also");
    final got = messages("docs/glossary/lease-id.md", md: swapped);
    std\assert(got.len() == 1 and got[0].indexOf("out of order") != null, message: "{got}");
}

test "the index groups terms in order and keeps each term's old anchor" {
    final pages = [
        TermPage{ slug = "lease-id", group = "sessions-and-leases", order = 2, title = "Lease id", description = "The id." },
        TermPage{ slug = "lease", group = "sessions-and-leases", order = 1, title = "Lease", description = "The grant." },
        TermPage{ slug = "workspace", group = "core-model", order = 1, title = "Workspace", description = "The root." },
    ];
    final block = glossaryIndex(pages);
    std\assert(block.indexOf("## Core model\n\n### Workspace\n\nThe root. [Workspace in full](glossary/workspace.md).\n\n## Sessions and leases\n\n### Lease\n") != null, message: block);
    final md = "# Glossary\n\n{INDEX_BEGIN}\nstale\n{INDEX_END}\n";
    final got = replaceBlock(md, begin: INDEX_BEGIN, end: INDEX_END, block: block) catch "";
    std\assert(got.indexOf("stale") == null and got.endsWith("{INDEX_END}\n"), message: got);
}

test "symbol ids read the way magus refs takes them" {
    std\assert(symbolFromID("symbol:gomod github.com/egladman/magus `github.com/egladman/magus/types`/Job#", term: "Job").name == "types.Job", message: "go type");
    std\assert(symbolFromID("symbol:buzz host magus/Job#", term: "Job").name == "magus\\Job", message: "buzz host");
    std\assert(symbolFromID("symbol:gomod github.com/egladman/magus `github.com/egladman/magus/types`/JobBlock#Job.", term: "Job").name == "", message: "a field is not the term");
    std\assert(symbolFromID("symbol:npm magus-console src/gen/magus/job/v1alpha1/`job_pb.ts`/Job#", term: "Job").name == "", message: "generated");
    std\assert(symbolFromID("symbol:gomod github.com/egladman/magus `github.com/egladman/magus/types`/LeaseID#", term: "Lease id").name == "types.LeaseID", message: "compacted");
}

test "docs hits skip the glossary and generic headings" {
    std\assert(usefulDoc("docsection:docs/glossary.md#lease", label: "Lease") == false, message: "glossary");
    std\assert(usefulDoc("docsection:docs/reference/rules/lease-claim.md#why", label: "Why") == false, message: "generic");
    std\assert(usefulDoc("docsection:changes/unreleased/x.md#added", label: "Added") == false, message: "outside docs");
    final d = docFromID("docsection:docs/guides/integrations/agents/leases.md#take-the-lease", label: "Take the lease");
    std\assert(d.file == "guides/integrations/agents/leases.md" and d.anchor == "take-the-lease", message: "{d.file}#{d.anchor}");
}
