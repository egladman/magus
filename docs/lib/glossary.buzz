// lib/glossary.buzz - render-time glossary auto-linker + slug. Links the first
// linkable occurrence of each glossary term on a page to its term page, so the domain
// vocabulary self-cross-links without hand-maintained links. Pure string transforms,
// golden-gated like the content transforms in lib/html.buzz. The link carries the term's
// definition in data-def so the client popover can show it in place.
namespace glossary;

import "assert";
import "html" as htmlcodec;
import "../libs/ssg/text" as _;

// GlossaryTerm is one glossary entry: the display term, its slug (the term page's file
// name), and the one-line definition the popover shows. Terms are matched longest-first
// so a multi-word term wins over a substring term (e.g. "pool mode" over "pool").
export object GlossaryTerm {
    term: str = "",
    anchor: str = "",
    def: str = "",
}

// GlossaryLinkResult carries the linked HTML plus the slugs that were linked on this page.
export object GlossaryLinkResult {
    html: str = "",
    linked: [str] = mut [<str>],
}

// glossarySlug mirrors goldmark's heading-id slug: lowercase, spaces AND underscores to
// hyphens, drop any char that is not a-z, 0-9, or hyphen. "Output reference" ->
// "output-reference"; "MAGUS.md" -> "magusmd"; "write_file" -> "write-file".
export fun glossarySlug(term: str) > str {
    final low = term.lower();
    final parts: mut [str] = mut [<str>];
    var i = 0;
    while (i < low.len()) {
        final b = low.byte(i);
        if (b == 32 or b == 95) {   // space or underscore -> hyphen
            parts.append("-");
        } else if ((b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45) {
            parts.append(low.sub(i, len: 1));
        }
        i = i + 1;
    }
    return parts.join("");
}

fun isWordByte(b: int) > bool {
    return (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122);
}

// scanPast returns the index just past the next s at/after `start`, or
// the end of html. Native indexOf(from:) copies nothing; a loop of
// html.byte() calls stepped the interpreter through every page byte.
fun scanPast(html: str, start: int, s: str) > int {
    final at = html.indexOf(s, from: start);
    if (at == null) { return html.len(); }
    return at! + s.len();
}

// tagNameLower reads the tag name at a '<' (skipping a leading '/'), lowercased.
fun tagNameLower(html: str, at: int) > str {
    var j = at + 1;
    if (j < html.len() and html.byte(j) == 47) { j = j + 1; }   // '/'
    final parts: mut [str] = mut [<str>];
    while (j < html.len()) {
        final b = html.byte(j);
        if ((b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57)) {
            parts.append(html.sub(j, len: 1));
            j = j + 1;
        } else {
            break;
        }
    }
    return parts.join("").lower();
}

// isSkipContainer is true for tags whose text content must never be auto-linked: pre
// (fenced code always), a (no nested links), and headings. Inline <code> is skipped only
// in prose mode (glossary terms) - code entities (MGSxxxx codes, commands, mod\method)
// DELIBERATELY link inside inline code, which is where those references appear.
fun isSkipContainer(name: str, skipInlineCode: bool) > bool {
    if (name == "code") { return skipInlineCode; }
    return name == "pre" or name == "a"
        or name == "h1" or name == "h2" or name == "h3"
        or name == "h4" or name == "h5" or name == "h6";
}

// Both maskers key off the tag NAME, so a <span> reads as prose no matter what it
// holds. That split "magusfile.buzz" in a code panel's title bar into two popovers,
// one on "magusfile" and one on "buzz", because neither linker has a term for the
// filename and both had a term for its halves. data-nolink marks an element whose
// text is a literal - a filename, a command line - rather than prose to be read.
fun hasNoLinkAttr(html: str, start: int, tagEnd: int) > bool {
    return html.sub(start, len: tagEnd - start).indexOf("data-nolink") != null;
}

// linkIns is one pending link insertion: wrap html[pos : pos+len) in `open` ... </a>.
object linkIns {
    pos: int = 0,
    len: int = 0,
    open: str = "",
}

// spaces returns n space bytes so masking a large protected region stays cheap.
fun spaces(n: int) > str {
    if (n <= 0) { return ""; }
    return " ".repeat(n);
}

// maskLinkable returns html the SAME LENGTH, with every byte outside linkable text replaced
// by a space and the linkable text lowercased. Non-linkable = inside a tag (< .. >), an HTML
// comment, or a skip container (pre/a/headings, plus inline code when skipInlineCode). A
// native indexOf then lands only in linkable text, so the ONE interpreted pass over the page
// is this build - not one scan per term, which is the difference between a fast render and a
// ten-minute one. Emits per-run pieces (not per char) so allocation stays O(tags), not O(N).
fun maskLinkable(html: str, skipInlineCode: bool) > str {
    final total = html.len();
    final pieces: mut [str] = mut [<str>];
    var i = 0;
    while (i < total) {
        if (html.byte(i) == 60) {   // '<': mask this tag / comment / skip container
            var end = 0;
            if (i + 3 < total and html.byte(i + 1) == 33 and html.byte(i + 2) == 45 and html.byte(i + 3) == 45) {
                end = scanPast(html, start: i + 4, s: "-->");
            } else {
                final isClose = (i + 1 < total and html.byte(i + 1) == 47);
                final name = tagNameLower(html, at: i);
                final tagEnd = scanPast(html, start: i + 1, s: ">");
                if (isClose == false and (isSkipContainer(name, skipInlineCode: skipInlineCode)
                        or hasNoLinkAttr(html, start: i, tagEnd: tagEnd))) {
                    end = scanPast(html, start: i + 1, s: "</" + name + ">");
                } else {
                    end = tagEnd;
                }
            }
            pieces.append(spaces(end - i));
            i = end;
        } else {   // a run of linkable text up to the next '<'
            final start = i;
            i = html.indexOf("<", from: i + 1) ?? total;
            pieces.append(html.sub(start, len: i - start).lower());
        }
    }
    return pieces.join("");
}

// acceptable reports whether needle matched at pos (length n) in searchable is a whole word
// (non-word boundaries) that does not overlap an already-placed insertion.
fun acceptable(searchable: str, pos: int, n: int, ins: [linkIns]) > bool {
    if (pos > 0 and isWordByte(searchable.byte(pos - 1))) { return false; }
    final after = pos + n;
    if (after < searchable.len() and isWordByte(searchable.byte(after))) { return false; }
    foreach (x in ins) {
        if (pos < x.pos + x.len and after > x.pos) { return false; }
    }
    return true;
}

// requireIndexOfFrom fails fast when the running magus predates str.indexOf's `from:`
// argument, which applyLinks below depends on to resume a scan without copying.
//
// An older VM does not reject the extra argument, it IGNORES it - so every "find the next
// occurrence" call returns the FIRST one again, the loop never advances, and the render
// hangs. A hang is the worst way for a version mismatch to present: no output, no exit
// code, nothing naming the cause. One O(1) probe turns it into a sentence.
//
// A capability probe rather than a magus.yaml `required_version` floor, because the floor
// cannot be armed yet. Source builds stamp v<last-tag>-N-g<sha> and the ward compares on
// the release alone (internal/ward/version.go), so a floor naming the release that will
// first CARRY this feature rejects every build made before that release is tagged -
// including the source-path builds CI uses to exercise a magusfile change at the commit
// that introduces it. Raise the floor when the release is cut; see magus.yaml.
export fun requireIndexOfFrom() > void {
    // On a build that honors `from:` the second "a" is at index 1; a build that drops the
    // argument answers 0, which is exactly the value that would stall the loop.
    if ("aa".indexOf("a", from: 1) != 1) {
        throw "this magus is too old to render the docs: str.indexOf(needle, from:) is "
            + "ignored by this build, so the glossary linker would loop forever instead of "
            + "advancing. Rebuild from this commit (`magus run go_build .`), or upgrade the "
            + "binary.";
    }
}

// applyLinks wraps the first acceptable match of each token in
// opener(index) ... </a>, and returns the keys it linked. tokens and keys are
// parallel, longest-first. A mask of another length leaves html unlinked.
fun applyLinks(html: str, searchable: str, tokens: [str], keys: [str], opener: fun (index: int) > str) > GlossaryLinkResult {
    if (searchable.len() != html.len()) {
        return GlossaryLinkResult{ html = html, linked = mut [<str>] };
    }
    final ins: mut [linkIns] = mut [<linkIns>];
    final linked: mut [str] = mut [<str>];
    var t = 0;
    while (t < tokens.len()) {
        final needle = tokens[t];
        final n = needle.len();
        // indexOf(from:) rather than sub().indexOf(): the slice form copied the whole
        // remaining page on every REJECTED candidate, and rejection is the common case -
        // a term like "target" occurs 166 times on concepts/targets, nearly all of them
        // inside code or an existing link, so one term cost megabytes of copying on one
        // page. Scanning in place is what makes this loop linear in the page.
        var pos = searchable.indexOf(needle);
        while (pos != null and acceptable(searchable, pos: pos!, n: n, ins: ins) == false) {
            pos = searchable.indexOf(needle, from: pos! + 1);
        }
        if (pos != null) {
            ins.append(linkIns{ pos = pos!, len = n, open = opener(t) });
            linked.append(keys[t]);
        }
        t = t + 1;
    }
    // Ascending with a cursor, collected into segments and joined once. The previous
    // pass went descending and spliced into `result` per insertion, which rebuilt the
    // ENTIRE page string once per linked term - 47 terms on a 57 KB page is ~2.7 MB of
    // copying to insert a few hundred bytes. Descending order existed so an early splice
    // could not shift the positions of later ones; a cursor gives that for free, because
    // every position is read off the untouched `html`.
    final ordered = ins.sort(fun (a: linkIns, b: linkIns) > bool { return a.pos < b.pos; });
    final parts: mut [str] = mut [<str>];
    var cursor = 0;
    foreach (x in ordered) {
        parts.append(html.sub(cursor, len: x.pos - cursor));
        parts.append(x.open);
        parts.append(html.sub(x.pos, len: x.len));
        parts.append("</a>");
        cursor = x.pos + x.len;
    }
    parts.append(html.sub(cursor));
    return GlossaryLinkResult{ html = parts.join(""), linked = linked };
}

// linkGlossaryTerms links the first linkable occurrence of each term (terms MUST be
// ordered longest-first so multi-word terms win over their substrings) to its term page,
// relToGlossary + anchor + "/", and records which anchors were linked. A page carrying
// the "<!-- magus-noglossary -->" opt-out marker is returned verbatim (marker stripped)
// with nothing linked.
export fun linkGlossaryTerms(html: str, terms: [GlossaryTerm], relToGlossary: str) > GlossaryLinkResult {
    final marker = "<!-- magus-noglossary -->";
    if (html.indexOf(marker) != null) {
        final stripped = html.split(marker).join("");
        return GlossaryLinkResult{ html = stripped, linked = mut [<str>] };
    }
    // The definition is baked into each link (data-def) so the client popover/reveal needs no
    // fetch; the href is the term's own page.
    final tokens: mut [str] = mut [<str>];
    final keys: mut [str] = mut [<str>];
    foreach (t in terms) {
        tokens.append(t.term.lower());
        keys.append(t.anchor);
    }
    // prose: mask inline code
    return applyLinks(html, searchable: maskLinkable(html, skipInlineCode: true), tokens: tokens, keys: keys,
        opener: fun (index: int) > str => "<a class=\"glossary-term\" href=\"" + relToGlossary + terms[index].anchor
            + "/\" data-def=\"" + htmlcodec\escape(terms[index].def) + "\">");
}

// Entity is one linkable domain reference recognized in INLINE code (and prose), never in
// fenced blocks: a diagnostic code (MGSxxxx), a CLI command ("magus run"), a module method
// ("fs\glob"), or a config key. url is gen-root-relative; anchor is an optional in-page
// target; summary feeds the shared popover; kind labels it. Matched longest-first so a
// specific reference wins over a shorter prefix.
export object Entity {
    token: str = "",
    kind: str = "",
    url: str = "",
    anchor: str = "",
    summary: str = "",
}

// sortEntitiesLongestFirst orders entities by descending match length, so linkCodeEntities
// tries "magus affected ci" before "magus affected". Selection sort; the catalogs are small.
export fun sortEntitiesLongestFirst(entities: [Entity]) > [Entity] {
    var work: mut [Entity] = mut [<Entity>];
    foreach (e in entities) { work.append(e); }
    final res: mut [Entity] = mut [<Entity>];
    while (work.len() > 0) {
        var best = 0;
        var b = 1;
        while (b < work.len()) {
            if (work[b].token.len() > work[best].token.len()) { best = b; }
            b = b + 1;
        }
        res.append(work[best]);
        final nw: mut [Entity] = mut [<Entity>];
        var c = 0;
        while (c < work.len()) {
            if (c != best) { nw.append(work[c]); }
            c = c + 1;
        }
        work = nw;
    }
    return res;
}

// linkCodeEntities links the first occurrence of each entity's match string (inside inline
// code or prose, never a fenced <pre> block) to its reference page, baking the summary into
// data-def and the kind into data-kind for the shared popover (glossary-terms.js). entities
// MUST be longest-match-first; pageDir is the linking page's clean gen-root dir (for the href).
export fun linkCodeEntities(html: str, entities: [Entity], pageDir: str) > str {
    final tokens: mut [str] = mut [<str>];
    final keys: mut [str] = mut [<str>];
    foreach (e in entities) {
        tokens.append(e.token.lower());
        keys.append(e.token);
    }
    // code mode: inline <code> stays linkable (that is where these references appear); only
    // fenced <pre> blocks, tags, and links are masked out.
    return applyLinks(html, searchable: maskLinkable(html, skipInlineCode: false), tokens: tokens, keys: keys,
        opener: fun (index: int) > str => entityOpen(entities[index], pageDir: pageDir)).html;
}

// entityOpen is the opening <a> linking one entity from pageDir. Built only
// for an entity the page links: a page meets every entity and links a few.
fun entityOpen(e: Entity, pageDir: str) > str {
    final base = relativePath(fromDir: pageDir, toUrl: e.url);
    final href = if (e.anchor != "") base + "#" + e.anchor else base;
    return "<a class=\"code-xref\" href=\"" + href + "\" data-kind=\"" + e.kind
        + "\" data-def=\"" + htmlcodec\escape(e.summary) + "\">";
}

// ConfigKey is a parsed config.md table row: the dotted key and a popover summary built
// from its type + flag + env-var columns. ok is false for header/separator/non-dotted rows.
export object ConfigKey {
    key: str = "",
    summary: str = "",
    ok: bool = false,
}

// cleanConfigCell trims a markdown table cell and drops its backticks (env-var underscores
// are kept - they are part of the name, not markdown).
fun cleanConfigCell(c: str) > str {
    final s = c.trim().split("`").join("");
    return s.trim();
}

// parseConfigRow parses a config.md table row "| `key` | `ENV` | `--flag` | type |" into a
// dotted config key and a one-line popover summary (its type, how to set it via flag/env).
// Returns ok=false for the header, the separator, and any non-dotted key.
export fun parseConfigRow(line: str) > ConfigKey {
    if (line.startsWith("| ") == false) { return ConfigKey{}; }
    final cells: mut [str] = mut [<str>];
    foreach (c in line.split("|")) { cells.append(cleanConfigCell(c)); }
    if (cells.len() < 5) { return ConfigKey{}; }
    final key = cells[1];
    if (key.indexOf(".") == null) { return ConfigKey{}; }
    var summary = cells[4];   // type
    final flag = cells[3];
    if (flag != "" and flag.indexOf("env only") == null and flag.indexOf("---") == null) {
        summary = summary + ", flag " + flag;
    }
    final env = cells[2];
    if (env != "" and env.indexOf("---") == null) {
        summary = summary + ", env " + env;
    }
    return ConfigKey{ key = key, summary = summary, ok = true };
}

test "parseConfigRow extracts the key and a type/flag/env summary" {
    final r = parseConfigRow("| `cache.dir` | `MAGUS_CACHE_DIR` | `--cache-dir` | string |");
    assert\equal(r.ok, want: true, message: "dotted key row parsed");
    assert\equal(r.key, want: "cache.dir", message: "key");
    assert\equal(r.summary, want: "string, flag --cache-dir, env MAGUS_CACHE_DIR", message: "type + flag + env");
}

test "parseConfigRow skips header, separator, and bare section keys" {
    assert\equal(parseConfigRow("| Config key | Environment variable | Flag | Type |").ok, want: false, message: "header skipped");
    assert\equal(parseConfigRow("|------------|----------------------|------|------|").ok, want: false, message: "separator skipped");
    assert\equal(parseConfigRow("| `cache` | x | y | z |").ok, want: false, message: "non-dotted key skipped");
}

// sortLongestFirst returns terms ordered by descending term length, so linkGlossaryTerms
// matches a multi-word term before any of its substring terms. Selection sort; the term
// set is small (a few dozen).
export fun sortLongestFirst(terms: [GlossaryTerm]) > [GlossaryTerm] {
    var work: mut [GlossaryTerm] = mut [<GlossaryTerm>];
    foreach (t in terms) { work.append(t); }
    final res: mut [GlossaryTerm] = mut [<GlossaryTerm>];
    while (work.len() > 0) {
        var best = 0;
        var b = 1;
        while (b < work.len()) {
            if (work[b].term.len() > work[best].term.len()) { best = b; }
            b = b + 1;
        }
        res.append(work[best]);
        final nw: mut [GlossaryTerm] = mut [<GlossaryTerm>];
        var c = 0;
        while (c < work.len()) {
            if (c != best) { nw.append(work[c]); }
            c = c + 1;
        }
        work = nw;
    }
    return res;
}

test "sortLongestFirst orders by descending term length" {
    final ts: mut [GlossaryTerm] = mut [<GlossaryTerm>];
    ts.append(GlossaryTerm{ term = "pool", anchor = "pool" });
    ts.append(GlossaryTerm{ term = "remote cache", anchor = "remote-cache" });
    ts.append(GlossaryTerm{ term = "cache", anchor = "cache" });
    final sorted = sortLongestFirst(ts);
    assert\equal(sorted[0].term, want: "remote cache", message: "longest first");
    assert\equal(sorted[2].term, want: "pool", message: "shortest last");
}

test "linkCodeEntities links inside inline code but never in a fenced block" {
    final ents: mut [Entity] = mut [<Entity>];
    ents.append(Entity{ token = "MGS1002", kind = "code", url = "reference/codes/graph/MGS1002/", summary = "duplicate spell" });
    final html = "<p>see <code>MGS1002</code> here</p><pre><code>MGS1002 again</code></pre>";
    assert\equal(linkCodeEntities(html, entities: ents, pageDir: "concepts/cache"),
        want: "<p>see <code><a class=\"code-xref\" href=\"../../reference/codes/graph/MGS1002/\" data-kind=\"code\" data-def=\"duplicate spell\">MGS1002</a></code> here</p><pre><code>MGS1002 again</code></pre>",
        message: "inline code linked, fenced block untouched, first occurrence only");
}

test "linkCodeEntities builds an anchored href for a method ref" {
    final ents: mut [Entity] = mut [<Entity>];
    ents.append(Entity{ token = "fs\\glob", kind = "method", url = "reference/buzz/fs/", anchor = "glob", summary = "list files" });
    assert\equal(linkCodeEntities("<p><code>fs\\glob</code></p>", entities: ents, pageDir: "concepts/cache"),
        want: "<p><code><a class=\"code-xref\" href=\"../../reference/buzz/fs/#glob\" data-kind=\"method\" data-def=\"list files\">fs\\glob</a></code></p>",
        message: "method ref links to its anchor");
}

test "linkCodeEntities favors a full command over its bare alias" {
    final ents: mut [Entity] = mut [<Entity>];
    ents.append(Entity{ token = "magus affected", kind = "command", url = "reference/manpage/magus-affected/", summary = "run a target for changed projects" });
    ents.append(Entity{ token = "affected", kind = "command", url = "reference/manpage/magus-affected/", summary = "magus affected" });
    final sorted = sortEntitiesLongestFirst(ents);
    assert\equal(linkCodeEntities("<p><code>magus affected ci</code></p>", entities: sorted, pageDir: ""),
        want: "<p><code><a class=\"code-xref\" href=\"reference/manpage/magus-affected/\" data-kind=\"command\" data-def=\"run a target for changed projects\">magus affected</a> ci</code></p>",
        message: "full command links once");
}

test "sortEntitiesLongestFirst orders by descending match length" {
    final es: mut [Entity] = mut [<Entity>];
    es.append(Entity{ token = "magus affected" });
    es.append(Entity{ token = "magus affected ci" });
    final sorted = sortEntitiesLongestFirst(es);
    assert\equal(sorted[0].token, want: "magus affected ci", message: "longest match first");
}

test "glossarySlug mirrors goldmark heading ids" {
    assert\equal(glossarySlug("Output reference"), want: "output-reference", message: "space to hyphen");
    assert\equal(glossarySlug("MAGUS.md"), want: "magusmd", message: "punctuation dropped");
    assert\equal(glossarySlug("One-off"), want: "one-off", message: "existing hyphen kept");
    assert\equal(glossarySlug("CI"), want: "ci", message: "lowercased");
}

test "linkGlossaryTerms links the first linkable occurrence and records it" {
    final terms: mut [GlossaryTerm] = mut [<GlossaryTerm>];
    terms.append(GlossaryTerm{ term = "cache", anchor = "cache", def = "Content store." });
    final r = linkGlossaryTerms("<p>The cache is warm; the cache stays.</p>", terms: terms, relToGlossary: "../glossary/");
    assert\equal(r.html,
        want: "<p>The <a class=\"glossary-term\" href=\"../glossary/cache/\" data-def=\"Content store.\">cache</a> is warm; the cache stays.</p>",
        message: "first occurrence only, definition baked in");
    assert\equal(r.linked.len(), want: 1, message: "one anchor recorded");
    assert\equal(r.linked[0], want: "cache", message: "recorded the cache anchor");
}

test "linkGlossaryTerms skips code, headings, and existing links" {
    final terms: mut [GlossaryTerm] = mut [<GlossaryTerm>];
    terms.append(GlossaryTerm{ term = "cache", anchor = "cache" });
    final html = "<h2>cache</h2><pre>cache</pre><code>cache</code><a href=\"x\">cache</a>";
    final r = linkGlossaryTerms(html, terms: terms, relToGlossary: "g/");
    assert\equal(r.html, want: html, message: "every protected region untouched");
    assert\equal(r.linked.len(), want: 0, message: "nothing recorded");
}

test "linkGlossaryTerms does not match a substring (plural) as a whole word" {
    final terms: mut [GlossaryTerm] = mut [<GlossaryTerm>];
    terms.append(GlossaryTerm{ term = "target", anchor = "target" });
    assert\equal(linkGlossaryTerms("<p>targets everywhere</p>", terms: terms, relToGlossary: "g/").html,
        want: "<p>targets everywhere</p>", message: "plural not linked");
}

test "linkGlossaryTerms prefers the longer term" {
    final terms: mut [GlossaryTerm] = mut [<GlossaryTerm>];
    terms.append(GlossaryTerm{ term = "pool mode", anchor = "pool-mode" });
    terms.append(GlossaryTerm{ term = "pool", anchor = "pool" });
    assert\equal(linkGlossaryTerms("<p>pool mode here</p>", terms: terms, relToGlossary: "g/").html,
        want: "<p><a class=\"glossary-term\" href=\"g/pool-mode/\" data-def=\"\">pool mode</a> here</p>",
        message: "longer term wins");
}

test "linkGlossaryTerms honors the noglossary opt-out" {
    final terms: mut [GlossaryTerm] = mut [<GlossaryTerm>];
    terms.append(GlossaryTerm{ term = "cache", anchor = "cache" });
    final r = linkGlossaryTerms("<!-- magus-noglossary --><p>cache</p>", terms: terms, relToGlossary: "g/");
    assert\equal(r.html, want: "<p>cache</p>", message: "marker stripped, nothing linked");
    assert\equal(r.linked.len(), want: 0, message: "nothing recorded");
}
