namespace design;

import "std";
import "lib/adr" as _;        // fenceRun

// DesignProblem is one way a design page departs from its template. lib/conventions wraps
// it as a ConventionFinding, the way it wraps an AdrProblem.
export object DesignProblem {
    line: int = 0,
    message: str = "",
}

// DesignPage is what the index in design.md lists for one page.
export object DesignPage {
    group: str = "",
    file: str = "",
    order: int = 0,
    title: str = "",
    description: str = "",
}

final SECTIONS = ["Enforced by", "Good", "Bad", "See also"];
final GROUPS = ["principles", "judgment"];
final GROUP_TITLES = {"principles": "Principles", "judgment": "Judgment"};
export final INDEX_BEGIN = "<!-- BEGIN DESIGN INDEX (generated by design-index-generate from each page's front matter; edit the pages, not this list) -->";
export final INDEX_END = "<!-- END DESIGN INDEX -->";

// designGroup returns the group of docs/design/<group>/<slug>.md, or "" for any other page.
export fun designGroup(file: str) > str {
    final segs = file.split("/");
    if (segs.len() < 3 or segs[segs.len() - 3] != "design" or segs[segs.len() - 1].endsWith(".md") == false) {
        return "";
    }
    final group = segs[segs.len() - 2];
    if (GROUPS.indexOf(group) == null) { return ""; }
    return group;
}

// frontMatter returns the page's top-level keys, a folded value joined onto one line, and
// the index of the closing `---`, or -1 when the page opens without front matter.
fun frontMatter(lines: [str]) > obj{ keys: {str: str}, close: int } {
    final keys = mut {<str: str>};
    if (lines.len() == 0 or lines[0] != "---") { return .{ keys = keys, close = -1 }; }
    var last = "";
    var i = 1;
    while (i < lines.len()) {
        final line = lines[i];
        if (line == "---") { return .{ keys = keys, close = i }; }
        if ((line.startsWith(" ") or line.startsWith("\t")) and last != "") {
            keys[last] = (keys[last] ?? "") + " " + line.trim();
        } else if (line.indexOf(":") -> colon) {
            last = line.sub(0, len: colon);
            keys[last] = line.sub(colon + 1).trim();
        }
        i = i + 1;
    }
    return .{ keys = keys, close = -1 };
}

// A design page's title is plain text; a quoted one loses only its quotes, since the
// conventions check that would unescape it imports this file.
fun unquoted(v: str) > str {
    if (v.len() >= 2 and v.startsWith("\"") and v.endsWith("\"")) { return v.sub(1, len: v.len() - 2); }
    return v;
}

// designPage reads the index entry for file from its front matter. A missing or non-numeric
// order sorts the page last; designProblems reports it.
export fun designPage(file: str, md: str) > DesignPage {
    final fm = frontMatter(md.split("\n"));
    return DesignPage{
        group = designGroup(file),
        file = file,
        order = std\parseInt(fm.keys["order"] ?? "") ?? 9999,
        title = unquoted(fm.keys["title"] ?? ""),
        description = fm.keys["description"] ?? "",
    };
}

// Walk is where designProblems stands in a page: the open fence, the current section and
// what that section has held so far.
object Walk {
    title: str = "",
    h1: int = 0,
    lead: bool = false,
    marker: str = "",
    section: str = "",
    sectionLine: int = 0,
    next: int = 0,
    fences: int = 0,
    proseAfterFence: bool = false,
}

fun closeSection(w: Walk, problems: mut [DesignProblem]) > void {
    if ((w.section == "Good" or w.section == "Bad") and w.fences == 0) {
        problems.append(DesignProblem{ line = w.sectionLine, message = "`## {w.section}` holds no fenced example; show the pattern" });
    } else if (w.section == "Bad" and w.proseAfterFence == false) {
        problems.append(DesignProblem{ line = w.sectionLine, message = "`## Bad` ends on its example; follow it with a sentence saying why it is bad" });
    }
}

fun openSection(w: mut Walk, heading: str, n: int, problems: mut [DesignProblem]) > void {
    if (w.section == "" and w.lead == false) {
        problems.append(DesignProblem{ line = n, message = "no argument before `## {heading}`; open with why the rule exists and what it prevents" });
    }
    if (w.next < SECTIONS.len() and heading == SECTIONS[w.next]) {
        w.next = w.next + 1;
    } else if (SECTIONS.indexOf(heading) != null) {
        problems.append(DesignProblem{ line = n, message = "`## {heading}` is out of order; order the sections Enforced by, Good, Bad, See also" });
    } else {
        problems.append(DesignProblem{ line = n, message = "`## {heading}` is not a template section; make it an H3 under the argument or one of Enforced by, Good, Bad, See also" });
    }
    w.section = heading;
    w.sectionLine = n;
    w.fences = 0;
    w.proseAfterFence = false;
}

// step judges line n of the page body. A fenced block's lines are skipped whole, so a
// heading inside an example is not a section.
fun step(w: mut Walk, line: str, n: int, problems: mut [DesignProblem]) > void {
    final t = line.trim();
    final run = fenceRun(t);
    if (w.marker != "") {
        if (run != "" and run.byte(0) == w.marker.byte(0) and run.len() >= w.marker.len() and run.len() == t.len()) {
            w.marker = "";
        }
    } else if (run != "") {
        w.marker = run;
        w.fences = w.fences + 1;
        w.proseAfterFence = false;
    } else if (line.startsWith("## ")) {
        closeSection(w, problems: problems);
        openSection(w, heading: line.sub(3).trim(), n: n, problems: problems);
    } else if (line.startsWith("# ")) {
        if (w.h1 == 0 and w.title != "" and line != "# " + w.title) {
            problems.append(DesignProblem{ line = n, message = "the H1 does not match the title; write `# {w.title}`" });
        }
        if (w.h1 == 0) { w.h1 = n; }
    } else if (t != "") {
        if (w.h1 > 0 and w.section == "") { w.lead = true; }
        if (w.fences > 0) { w.proseAfterFence = true; }
    }
}

fun keyProblems(keys: {str: str}, problems: mut [DesignProblem]) > void {
    if (std\parseInt(keys["order"] ?? "") == null) {
        problems.append(DesignProblem{ line = 1, message = "front matter has no numeric `order`; the index in design.md sorts by it" });
    }
    if ((keys["tags"] ?? "").indexOf("design") == null) {
        problems.append(DesignProblem{ line = 1, message = "`tags` does not include `design`" });
    }
}

// designProblems holds a docs/design/<group>/<slug>.md page to the design page template in
// docs/conventions.md, and returns nothing for any other page.
export fun designProblems(file: str, md: str) > [DesignProblem] {
    final problems: mut [DesignProblem] = mut [<DesignProblem>];
    if (designGroup(file) == "") { return problems; }
    final lines = md.split("\n");
    final fm = frontMatter(lines);
    if (fm.close < 0) {
        problems.append(DesignProblem{ line = 1, message = "no front matter; open the page with `---`, title, order, description, tags, `---`" });
        return problems;
    }
    keyProblems(fm.keys, problems: problems);
    final w = mut Walk{ title = unquoted(fm.keys["title"] ?? "") };
    var i = fm.close + 1;
    while (i < lines.len()) {
        step(w, line: lines[i], n: i + 1, problems: problems);
        i = i + 1;
    }
    closeSection(w, problems: problems);
    if (w.h1 == 0) {
        problems.append(DesignProblem{ line = fm.close + 2, message = "no H1; write `# {w.title}`" });
    }
    if (w.next < SECTIONS.len()) {
        problems.append(DesignProblem{ line = lines.len(), message = "no `## {SECTIONS[w.next]}`; every design page carries Enforced by, Good, Bad and See also" });
    }
    return problems;
}

// designIndex renders the list design.md carries between INDEX_BEGIN and INDEX_END: one H3
// per group, each page a link with its description, in front-matter order.
export fun designIndex(pages: [DesignPage]) > str {
    final rows = mut [INDEX_BEGIN];
    foreach (group in GROUPS) {
        final members = mut [<DesignPage>];
        foreach (p in pages) {
            if (p.group == group) { members.append(p); }
        }
        members.sort(fun (a: DesignPage, b: DesignPage) > bool => a.order < b.order or (a.order == b.order and a.file < b.file));
        rows.append("");
        rows.append("### {GROUP_TITLES[group] ?? group}");
        rows.append("");
        foreach (p in members) {
            final segs = p.file.split("/");
            rows.append("- [{p.title}](design/{group}/{segs[segs.len() - 1]}): {p.description}");
        }
    }
    rows.append("");
    rows.append(INDEX_END);
    return rows.join("\n");
}

// replaceIndex swaps the block between INDEX_BEGIN and INDEX_END in md for block, and
// raises when either marker line is missing.
export fun replaceIndex(md: str, block: str) > str !> str {
    final lines = md.split("\n");
    final begin = lines.indexOf(INDEX_BEGIN);
    final end = lines.indexOf(INDEX_END);
    if (begin == null or end == null or end! < begin!) {
        throw "design.md has no `{INDEX_BEGIN}` ... `{INDEX_END}` block to regenerate";
    }
    final before = lines.sub(0, len: begin!);
    final after = lines.sub(end! + 1);
    return before.join("\n") + (if (before.len() > 0) "\n" else "") + block + (if (after.len() > 0) "\n" + after.join("\n") else "");
}

final GOOD_PAGE = "---\ntitle: A rule\norder: 1\ndescription: The rule in one sentence.\ntags: [design, principle]\n---\n\n"
    + "# A rule\n\nWhy it exists.\n\n## Enforced by\n\n- a test\n\n## Good\n\n```sh\nmagus run test\n```\n\n"
    + "## Bad\n\n```sh\ngo test ./...\n```\n\nIt skips the cache.\n\n## See also\n\n- [Scope](../../scope.md)\n";

fun messages(file: str, md: str) > [str] {
    return designProblems(file, md: md).map(fun (i: int, p: DesignProblem) > str => p.message);
}

test "a page in the template has no problems" {
    std\assert(messages("docs/design/principles/a-rule.md", md: GOOD_PAGE).len() == 0, message: "{messages("docs/design/principles/a-rule.md", md: GOOD_PAGE)}");
}

test "a page outside docs/design/<group>/ is not judged" {
    std\assert(messages("docs/design.md", md: "# x\n").len() == 0, message: "design.md");
    std\assert(messages("docs/design/refusals.md", md: "# x\n").len() == 0, message: "refusals.md");
}

test "a Bad example with no reason after it is a problem" {
    final md = GOOD_PAGE.replace("It skips the cache.\n\n", with: "");
    final got = messages("docs/design/judgment/a-rule.md", md: md);
    std\assert(got.len() == 1 and got[0].indexOf("saying why") != null, message: "{got}");
}

test "a missing or reordered section is a problem" {
    final missing = messages("docs/design/principles/a.md", md: GOOD_PAGE.replace("## See also\n\n- [Scope](../../scope.md)\n", with: ""));
    std\assert(missing.len() == 1 and missing[0].indexOf("See also") != null, message: "{missing}");
    final extra = messages("docs/design/principles/a.md", md: GOOD_PAGE.replace("## Good", with: "## Example"));
    std\assert(extra.len() >= 1 and extra[0].indexOf("not a template section") != null, message: "{extra}");
}

test "the index lists each group in order and replaces only its block" {
    final pages = [
        DesignPage{ group = "principles", file = "design/principles/b.md", order = 2, title = "B", description = "Second." },
        DesignPage{ group = "principles", file = "design/principles/a.md", order = 1, title = "A", description = "First." },
        DesignPage{ group = "judgment", file = "design/judgment/c.md", order = 1, title = "C", description = "Third." },
    ];
    final block = designIndex(pages);
    std\assert(block.indexOf("- [A](design/principles/a.md): First.\n- [B]") != null, message: block);
    final md = "# Design\n\nIntro.\n\n{INDEX_BEGIN}\nstale\n{INDEX_END}\n\nAfter.\n";
    final got = replaceIndex(md, block: block) catch "";
    std\assert(got.startsWith("# Design\n\nIntro.\n\n{INDEX_BEGIN}") and got.endsWith("{INDEX_END}\n\nAfter.\n") and got.indexOf("stale") == null, message: got);
}
