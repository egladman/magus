// lib/dom.buzz - a small HTML builder. Attribute values are escaped; element bodies
// are inserted raw (already-built HTML). Caller orders the attrs, so output matches
// hand-written markup byte for byte.
namespace dom;

import "assert";
import "lib/text" as _;

// attr renders one escaped attribute with a leading space: ` name="value"`.
export fun attr(name: str, value: str) > str {
    return " " + name + "=\"" + escapeAttr(value) + "\"";
}

// el wraps raw body in <tag attrs>...</tag>. attrs is "" or a run of attr() calls.
export fun el(tag: str, attrs: str, body: str) > str {
    return "<" + tag + attrs + ">" + body + "</" + tag + ">";
}

// voidEl is an unclosed element: <tag attrs> (meta, link, img).
export fun voidEl(tag: str, attrs: str) > str {
    return "<" + tag + attrs + ">";
}

// esc escapes text for HTML element content (& < >).
export fun esc(s: str) > str {
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
}

test "attr escapes and el/voidEl wrap" {
    assert\equal(attr("class", "a & b"), " class=\"a &amp; b\"", "escaped attribute");
    assert\equal(el("p", attr("id", "x"), "hi"), "<p id=\"x\">hi</p>", "element with attr");
    assert\equal(el("div", "", "raw"), "<div>raw</div>", "no attrs");
    assert\equal(voidEl("meta", attr("charset", "utf-8")), "<meta charset=\"utf-8\">", "void element");
    assert\equal(esc("<a & b>"), "&lt;a &amp; b&gt;", "text escape");
}

// EVERY occurrence. The fixture above has exactly one of each character, which is the
// shape that hid a real defect: str.replace substituted only the FIRST match until
// 2026-08-09, so this escaper encoded the first ampersand of a fragment and left the
// rest raw. Repetition is the axis that catches it, not character coverage.
test "esc and attr escape EVERY occurrence, not just the first" {
    assert\equal(esc("&a&b&"), "&amp;a&amp;b&amp;", "ampersands at both edges and between");
    assert\equal(esc("<a><b>"), "&lt;a&gt;&lt;b&gt;", "repeated angle brackets");
    assert\equal(esc("&&"), "&amp;&amp;", "adjacent ampersands");
    // Ampersand first, so the & introduced by &lt;/&gt; is never rescanned.
    assert\equal(esc("<&>"), "&lt;&amp;&gt;", "no double-encoding of introduced entities");
    assert\equal(attr("id", "a&b&c"), " id=\"a&amp;b&amp;c\"", "attribute values too");
}
