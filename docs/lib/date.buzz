// lib/date.buzz - pure date formatting for bylines, feeds, and the recent-changes
// footer. Flat-imported by render.buzz (`import "lib/date" as _`).
namespace date;

import "time";
import "assert";
import "lib/text" as _;

// formatISO renders an ISO 8601 UTC string as "June 29, 2026, 1:41 AM UTC" (no-JS
// fallback; client JS rewrites it to the viewer's local zone).
export fun formatISO(iso: str) > str !> any {
    final ms = time\parse("2006-01-02T15:04:05Z", iso);
    return time\format("January 2, 2006, 3:04 PM UTC", ms);
}

// formatISOShort is the compact recent-changes form ("Jan 2, 2006").
export fun formatISOShort(iso: str) > str !> any {
    final ms = time\parse("2006-01-02T15:04:05Z", iso);
    return time\format("Jan 2, 2006", ms);
}

// blogDate renders a post's frontmatter date as a plain calendar byline ("July 1, 2026").
export fun blogDate(d: str) > str !> any {
    final dateOnly = d.split("T")[0];          // date-only or the date part of RFC3339
    if (dateOnly.split("-").len() < 3) { return d; }
    final ms = time\parse("2006-01-02", dateOnly);
    return time\format("January 2, 2006", ms);
}

// blogDateAttr is the date-only "YYYY-MM-DD" that pairs with blogDate() in <time datetime>.
export fun blogDateAttr(d: str) > str {
    return d.split("T")[0];
}

// isFuturePost reports whether date falls on a UTC day after asOf's. Same day is not
// future: a post dated the day of the build publishes that day. An undated post never is.
//
// asOf is site.metaStamp (HEAD's commit date), never wall-clock: generate is a drift gate,
// so the render stays a pure function of the tree rather than of when it ran. Empty asOf
// fails open, since a missing git stamp should not blank every dated post.
export fun isFuturePost(date: str, asOf: str) > bool {
    if (asOf == "") { return false; }
    return strLess(blogDateAttr(asOf), blogDateAttr(date));
}

test "blogDateAttr keeps just the calendar day" {
    assert\equal(blogDateAttr("2026-07-01T12:00:00Z"), "2026-07-01", "drops the time part");
    assert\equal(blogDateAttr("2026-07-01"), "2026-07-01", "date-only unchanged");
}

test "blogDate renders a calendar byline" {
    assert\equal(blogDate("2026-07-01"), "July 1, 2026", "date-only byline");
    assert\equal(blogDate("2026-07-01T12:00:00Z"), "July 1, 2026", "RFC3339 byline");
}

test "formatISO renders human-readable UTC" {
    assert\equal(formatISO("2026-06-29T01:41:51Z"), "June 29, 2026, 1:41 AM UTC", "full form");
    assert\equal(formatISOShort("2026-06-29T01:41:51Z"), "Jun 29, 2026", "compact form");
}

test "isFuturePost gates on the calendar day, inclusive of the day itself" {
    assert\equal(isFuturePost("2026-08-25", "2026-08-24T23:00:00Z"), true, "a later day is future");
    assert\equal(isFuturePost("2026-08-25T00:00:00Z", "2026-08-25T23:59:59Z"), false, "same day at any hour is not");
    assert\equal(isFuturePost("2026-08-24", "2026-08-25T00:00:00Z"), false, "an earlier day is not");
    assert\equal(isFuturePost("", "2026-08-25T00:00:00Z"), false, "an undated post is not");
    assert\equal(isFuturePost("2026-08-25", ""), false, "no asOf fails open");
}
