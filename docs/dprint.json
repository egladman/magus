{
  // Generated Markdown is excluded because its generators do not emit dprint-normal
  // output yet - the documented fallback, not the goal (docs/concepts/generated-files.md).
  // The list mirrors ../.markdownlintignore; both should eventually be written from
  // declared outputs, the way .gitattributes already is.
  //
  // guides/integrations/agents is its own project with its own dprint.json.
  "extends": "../dprint-base.json",
  "includes": ["./**/*.md"],
  "excludes": [
    "./guides/integrations/agents/**",
    "./node_modules/**",
    "./vendor/**",
    "./gen/**",
    "./src/gen/**",
    "./MAGUS.md",
    "./changelog.md",
    "./reference/buzz/**",
    "./reference/manpage/**",
    "./reference/api/**",
    "./reference/skills/**",
    "./reference/config.md",
    "./concepts/spells/**",
    "./concepts/spells.md",
    "./concepts/knowledge.md"
  ]
}
