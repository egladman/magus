#!/usr/bin/env sh

set -eu

VERSION="${VERSION:-latest}"
BASE_URL="https://github.com/egladman/magus/releases"
VARIANT="${VARIANT:-static}"

TARGET_OS="${TARGET_OS:-$(uname -s)}"
TARGET_ARCH="${TARGET_ARCH:-$(uname -m)}"

INSTALL_PREFIX="${INSTALL_PREFIX:-${HOME:?}/.local}"

# Every key a magus binary trusts, newline-separated, mirroring the ring in
# internal/selfupdate/release-keys.json - TestReleaseTrustAnchorMatchesInstallerAndCI
# fails if the two disagree. Accepting the whole ring is what stops a key rotation
# stranding fresh installs while self update keeps working.
#
# Revocation is deliberately NOT honoured here. It lives in the signed release index,
# and a first install has no prior trust to withdraw and no installed binary to strand.
# A revoked key is deleted from this list instead, which is the same outcome by the
# only means an installer with no state can achieve.
MAGUS_RELEASE_PUBKEY_HEX="ffbb8fa6f36274defd12888093c6a322c2532bc545016f495ab4955decb66779"

SHORTHAND="${SHORTHAND:-true}"

DRY_RUN=false
VERBOSE=false

die() {
    printf 'fatal: %s\n' "$*" >&2
    exit 1
}

is_true() {
    case "$1" in
        1|true|TRUE|yes|YES|on|ON)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

log() {
    if is_true "$VERBOSE"; then
        printf '%s\n' "$*"
    fi
}

require() {
    command -v "$1" >/dev/null 2>&1 ||
        die "missing required command: $1"
}

require_ed25519_openssl() {
    fix="Install one and put it ahead of the current openssl on PATH."
    case "$TARGET_OS" in
        Darwin)
            fix="macOS ships LibreSSL as /usr/bin/openssl, which this check rejects. Install real OpenSSL 3 with 'brew install openssl@3' and put its bin directory ahead of /usr/bin on PATH."
            ;;
    esac
    hint="OpenSSL 3 with Ed25519 support is required to verify releases. $fix See https://eli.gladman.cc/magus/setup/verify/ to verify by hand instead."

    algorithms="$(openssl list -public-key-algorithms 2>/dev/null)" ||
        die "$hint"
    case "$algorithms" in
        *ED25519*) ;;
        *) die "$hint" ;;
    esac
}

usage() {
    cat <<EOF
Usage:
  install [options]

Options:
  --version VERSION   Install a specific release tag
  --variant VARIANT   Install static (default) or dynamic binary
  --no-shorthand      Do not symlink mgs, the magus shorthand
  --dry-run           Show what would be installed
  --verbose           Print additional verification details
  --help              Show this help message

Environment:
  VERSION             Release version (default: latest)
  VARIANT             Binary variant: static (default) or dynamic
  INSTALL_PREFIX      Installation prefix (default: ~/.local)
  SHORTHAND           Symlink mgs alongside magus (default: true)
  TARGET_OS           The operating system's binary to be installed  (default: auto-detected)
  TARGET_ARCH         The architecture's binary to be installed  (default: auto-detected)
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --version)
            [ "$#" -ge 2 ] ||
                die "--version requires a value"

            VERSION="$2"
            shift 2
            ;;

        --variant)
            [ "$#" -ge 2 ] ||
                die "--variant requires static or dynamic"

            VARIANT="$2"
            shift 2
            ;;

        --no-shorthand)
            SHORTHAND=false
            shift
            ;;

        --dry-run)
            DRY_RUN=true
            shift
            ;;

        --verbose)
            VERBOSE=true
            shift
            ;;

        --help)
            usage
            exit 0
            ;;

        *)
            die "unknown argument: $1"
            ;;
    esac
done

curl_get() {
    curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --proto '=https' \
        --proto-redir '=https' \
        --tlsv1.2 \
        --globoff \
        --max-redirs 5 \
        "$@"
}

validate_version() {
    case "$1" in
        v[0-9]*)
            case "$1" in
                *[!0-9A-Za-z.+-]*) die "invalid release version: $1" ;;
            esac
            ;;
        *) die "invalid release version: $1" ;;
    esac
}

validate_variant() {
    case "$1" in
        static|dynamic) ;;
        *) die "invalid binary variant '$1' (expected static or dynamic)" ;;
    esac
}

# Returns the resolved release tag URL.
#
# Examples:
#   https://github.com/egladman/magus/releases/tag/v0.2.1
#   https://github.com/egladman/magus/releases/tag/v1.0.0
find_release() {
    case "$VERSION" in
        latest|"")
            curl_get \
                -o /dev/null \
                -w "%{url_effective}" \
                "${BASE_URL}/latest"
            ;;

        v*)
            validate_version "$VERSION"
            printf '%s/tag/%s\n' "$BASE_URL" "$VERSION"
            ;;

        *)
            die "unexpected version '$VERSION' (expected 'latest' or a tag beginning with 'v')"
            ;;
    esac
}

release_version() {
    url="${1:?}"
    version="${url##*/}"
    validate_version "$version"
    printf '%s\n' "$version"
}

detect_platform() {
    case "$TARGET_OS" in
        Linux)
            OS=linux
            ;;

        Darwin)
            OS=darwin
            ;;

        *)
            die "unsupported operating system: $TARGET_OS"
            ;;
    esac

    case "$TARGET_ARCH" in
        x86_64|amd64)
            ARCH=amd64
            ;;

        arm64|aarch64)
            ARCH=arm64
            ;;

        *)
            die "unsupported architecture: $TARGET_ARCH"
            ;;
    esac
}

# Downloads the signed manifest before any binary artifact.
download_metadata() {
    # Usage: download_metadata <version>

    version="${1:?}"
    asset_url="${BASE_URL}/download/${version}"

    printf 'Downloading release metadata...\n'

    curl_get \
        "${asset_url}/SHA256SUMS" \
        -o "${work_dir}/SHA256SUMS"

    curl_get \
        "${asset_url}/SHA256SUMS.sig" \
        -o "${work_dir}/SHA256SUMS.sig"
}

# Verifies that SHA256SUMS was signed by the Magus release key.
#
# No hashes are trusted until this succeeds.
verify_metadata() {
    cd "$work_dir"

    log "Verifying release metadata signature..."

    # Try each key in the ring. SHA256SUMS names no signer - it stays a plain
    # sha256sum(1) file - so which key signed it is discovered, not declared.
    # shellcheck disable=SC2086  # unquoted on purpose: the ring is one key per word
    for key_hex in ${MAGUS_RELEASE_PUBKEY_HEX}; do
        printf '302a300506032b6570032100%s' "${key_hex}" | xxd -r -p > pub.der

        {
            echo "-----BEGIN PUBLIC KEY-----"
            openssl base64 -A < pub.der
            echo
            echo "-----END PUBLIC KEY-----"
        } > pub.pem

        if openssl pkeyutl \
            -verify \
            -pubin \
            -inkey pub.pem \
            -rawin \
            -in SHA256SUMS \
            -sigfile SHA256SUMS.sig \
            >/dev/null 2>&1
        then
            log "Release metadata signature verified (key $(printf '%.16s' "${key_hex}")...)."
            return
        fi
    done

    die "release metadata signature verification failed: SHA256SUMS.sig matches none of the keys this installer trusts"
}

# Downloads the release artifact after metadata has been authenticated.
download_artifact() {
    # Usage: download_artifact <release-url>

    release_url="${1:?}"
    version="$(release_version "$release_url")"

    # The asset name is READ OUT of the signed manifest rather than reconstructed here.
    # SHA256SUMS is already downloaded and its signature already verified at this point,
    # so it is both authoritative and trusted, and it is the only source that cannot go
    # stale: this script is served from main and installs older releases, whose naming
    # this file has now been wrong about twice.
    #
    # The two spellings it has to span: v0.3.0 and earlier published `-static`, later
    # releases publish `_static`, and in BOTH the bare name is the dynamic build. The
    # old code asked for the bare name whenever VARIANT=static, so the default install
    # silently fetched a dynamically linked binary; its other branch asked for `-cgo`,
    # a token no release has ever produced.
    artifact="$(select_artifact "$version")" ||
        die "no ${VARIANT} archive for ${OS}/${ARCH} in the signed manifest for ${version}"

    printf 'Downloading %s...\n' "$artifact" >&2

    curl_get \
        "${BASE_URL}/download/${version}/${artifact}" \
        -o "${work_dir}/${artifact}"

    printf '%s\n' "$artifact"
}

# select_artifact prints the asset name for this platform and VARIANT, chosen from the
# verified SHA256SUMS. Static prefers the current `_static` spelling and falls back to
# the pre-v0.4.0 `-static`; dynamic is the bare name in both eras.
select_artifact() {
    # Usage: select_artifact <version>

    version="${1:?}"
    base="magus_${version}_${OS}_${ARCH}"

    if [ "$VARIANT" = "static" ]; then
        for candidate in "${base}_static.tar.gz" "${base}-static.tar.gz"; do
            if manifest_has "$candidate"; then
                printf '%s\n' "$candidate"
                return 0
            fi
        done
        return 1
    fi

    manifest_has "${base}.tar.gz" || return 1
    printf '%s\n' "${base}.tar.gz"
}

# manifest_has reports whether the verified manifest lists exactly this asset.
manifest_has() {
    # Usage: manifest_has <asset>

    awk -v asset="${1:?}" '
        ($2 == asset || $2 == "*" asset) { found = 1 }
        END { exit found ? 0 : 1 }
    ' "${work_dir}/SHA256SUMS"
}

verify_artifact() {
    # Usage: verify_artifact <artifact>

    artifact="${1:?}"

    cd "$work_dir"

    log "Verifying artifact checksum..."

    awk -v artifact="$artifact" '
        ($2 == artifact || $2 == "*" artifact) && length($1) == 64 && $1 ~ /^[0-9A-Fa-f]+$/ {
            matches++
            entry = $0
        }
        END {
            if (matches == 1) {
                print entry
                exit 0
            }
            exit 1
        }
    ' SHA256SUMS > SHA256SUMS.selected ||
        die "signed checksum manifest must contain exactly one SHA-256 entry for ${artifact}"

    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum --check --status SHA256SUMS.selected ||
            die "checksum verification failed"
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 --check --status SHA256SUMS.selected ||
            die "checksum verification failed"
    else
        die "missing SHA-256 verifier: install sha256sum or shasum"
    fi

    log "Artifact checksum verified."
}

install_release() {
    # Usage: install_release <artifact>

    archive="${1:?}"

    verify_artifact "$archive"

    printf '\n'
    printf 'Installation plan:\n'
    printf '  Version: %s\n' "$(release_version "$url")"
    printf '  Platform: %s/%s\n' "$OS" "$ARCH"
    printf '  Variant: %s\n' "$VARIANT"
    printf '  Destination: %s/bin/magus\n' "$INSTALL_PREFIX"
    if is_true "$SHORTHAND"; then
        printf '  Shorthand: %s/bin/mgs -> magus\n' "$INSTALL_PREFIX"
    fi

    if is_true "$DRY_RUN"; then
        return
    fi

    cd "$work_dir"

    mkdir -p "${INSTALL_PREFIX}/bin"

    # The archive carries the binary plus its paperwork (LICENSE, README.md,
    # THIRD-PARTY-NOTICES, BUILDINFO). Check the member list against that allowlist
    # rather than for equality with "magus": equality was correct until the paperwork
    # was added and then rejected every release. An allowlist still refuses the thing
    # the check is for - a verified archive that carries a member nobody expected -
    # and only `magus` is ever extracted.
    archive_members="$(tar -tzf "$archive")" ||
        die "cannot inspect verified archive"
    printf '%s\n' "$archive_members" | grep -qx 'magus' ||
        die "verified archive does not contain a magus binary"
    unexpected="$(printf '%s\n' "$archive_members" |
        grep -vx -e 'magus' -e 'LICENSE' -e 'README.md' -e 'THIRD-PARTY-NOTICES' -e 'BUILDINFO' || true)"
    [ -z "$unexpected" ] ||
        die "verified archive carries unexpected members: $(printf '%s' "$unexpected" | tr '\n' ' ')"

    tar -xzf "$archive" magus ||
        die "cannot extract verified magus binary"
    [ -f magus ] && [ ! -L magus ] ||
        die "verified archive's magus member is not a regular file"

    install -m 0755 \
        magus \
        "${INSTALL_PREFIX}/bin/magus"

    # Tolerated like the shorthand below: this script is served from main and installs
    # older releases too. `man` landed after v0.3.0, so an unconditional call killed the
    # install with the binary already in place.
    "${INSTALL_PREFIX}/bin/magus" man install \
        --dir "${INSTALL_PREFIX}/share/man/man1" ||
        printf 'warning: could not install the man pages; magus itself is installed\n' >&2

    # The shorthand is a convenience, so a failure here (an mgs already on the
    # prefix, a read-only bin dir) must not fail an otherwise good install.
    if is_true "$SHORTHAND"; then
        "${INSTALL_PREFIX}/bin/magus" self install-shorthand ||
            printf 'warning: could not install the mgs shorthand; magus itself is installed\n' >&2
    fi

    printf '\n'
    printf 'Successfully installed Magus to:\n'
    printf '  %s/magus\n' "${INSTALL_PREFIX}/bin"

    case ":$PATH:" in
    *":${INSTALL_PREFIX}/bin:"*)
            ;;

        *)
            printf '\n'
            printf 'NOTE:\n'
            printf '  %s is not on your PATH.\n' "${INSTALL_PREFIX}/bin"
            printf '  Add it to your shell profile to invoke "magus" directly.\n'
            ;;
    esac

    printf '\n'
    printf 'Next steps:\n'
    printf '  Read the quickstart: https://eli.gladman.cc/magus/tour/\n'
    printf '  Create a workspace: magus init\n'
    printf '  Read the local manual: man magus\n'

    # The zsh script ends by invoking its own completion function, so it must go
    # on $fpath as _magus - appending it to ~/.zshrc registers nothing.
    case "${SHELL:-}" in
        */bash)
            printf "  Enable Bash completion: echo 'source <(magus completion bash)' >> ~/.bashrc\n"
            ;;
        */zsh)
            printf '  Enable Zsh completion: magus completion zsh > ~/.zsh/completions/_magus\n'
            printf '    then put that directory on the zsh fpath before compinit:\n'
            printf '    https://eli.gladman.cc/magus/guides/download/shell-setup/\n'
            ;;
        */fish)
            printf '  Enable Fish completion: magus completion fish > ~/.config/fish/completions/magus.fish\n'
            ;;
    esac
}

main() {
    validate_variant "$VARIANT"

    require curl
    require tar
    require install
    require openssl
    require_ed25519_openssl
    require awk
    require xxd
    require uname
    require mktemp
    umask 077

    detect_platform

    url="$(find_release)"

    work_dir="$(mktemp -d)"

    cleanup() {
        rm -rf "$work_dir"
    }

    trap cleanup EXIT HUP INT TERM

    download_metadata "$(release_version "$url")"

    verify_metadata

    artifact="$(download_artifact "$url")"

    install_release "$artifact"
}

main "$@"
