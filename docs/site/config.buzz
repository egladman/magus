// site/config.buzz - configuration for THIS site (magus's docs). The single swap
// point: engine/ reads everything site-specific through the Site's Config, so
// retargeting this SSG means a different Config here. Nothing under engine/ imports
// this; render.buzz injects magusConfig() into the Site once at build start.
namespace config;

import "io";
import "assert";
import "engine/types" as _;
import "../libs/ssg/csp" as _;

// CSP_INLINE_SCRIPT_SOURCES lists the source HTML files scanned for inline <script>
// blocks whose hashes the site-wide CSP must allow. Every renderPage()-based page
// carries no inline script; only hand-authored playground.html does today (WASM
// bootstrap, syntax-overlay resize sync, draft persistence, fullscreen toggle - 4
// blocks). An inline <script> on a listed file, or a new unlisted file, surfaces as a
// browser CSP violation on that page - the intended failure mode (see computeCSP).
export final CSP_INLINE_SCRIPT_SOURCES = ["playground.html"];

// CSP_SCRIPT_SRC is the script source the Go/TinyGo wasm runtime (playground,
// run-example.js's "Run" buttons) needs, for which there is no narrower one.
export final CSP_SCRIPT_SRC = "'wasm-unsafe-eval'";

// CSP_IMG_SRC_BADGES extends CSP_IMG_SRC_DEFAULT with the two hosts the README's status
// badges load from (github.com Actions badge, pkg.go.dev reference badge). Only the page
// rendered FROM the README embeds them - /development/, not the site root - so only its
// CSP (Site.cspBadges) passes this value. Graph and playground, which hold the reader's
// own graph or source, keep the default.
export final CSP_IMG_SRC_BADGES = CSP_IMG_SRC_DEFAULT + " https://github.com https://pkg.go.dev";

// Nav links in display order; Console opens blank (new tab) - it is a standalone app,
// not a docs page.
export fun magusConfig() > Config {
    final nav = mut [<NavLink>];
    // NO "Home" entry: the brand lockup beside it already links to index.html, so a Home link
    // spends a nav slot on a destination the user can already reach from the thing next to it.
    //
    // Four top-level items, grouped by what someone is trying to DO rather than by what kind of
    // page it is. Documentation and Console stay flat because each is a single destination and
    // burying a primary one behind a menu costs a click for nothing.
    nav.append(NavLink{ suffix = "documentation/", label = "Documentation", key = "documentation" });
    // Everything for someone who has not run magus yet, in the order they would meet it.
    final start = mut [<NavLink>];
    start.append(NavLink{ suffix = "guides/setup/", label = "Setup", key = "setup" });
    start.append(NavLink{ suffix = "tour/", label = "Tour", key = "tour" });
    start.append(NavLink{ suffix = "playground/", label = "Playground", key = "playground" });
    nav.append(NavLink{ label = "Get started", key = "start", children = start });
    // The project around the tool rather than the tool itself. Contributing was two clicks deep
    // under /development/, which is the right depth for a project nobody contributes to and the
    // wrong one for a project that wants contributors; it keeps its promotion here.
    final community = mut [<NavLink>];
    community.append(NavLink{ suffix = "blog/", label = "Blog", key = "blog" });
    community.append(NavLink{ suffix = "development/contributing/", label = "Contribute", key = "contributing" });
    nav.append(NavLink{ label = "Community", key = "community", children = community });
    nav.append(NavLink{ suffix = "console/", label = "Console", key = "console", blank = true });
    return Config{
        baseURL = "https://eli.gladman.cc/magus/",
        title = "magus",
        description = "magus is a fast, cross-platform task orchestrator for polyglot (mono)repos. Single binary, programmable targets, statically typed.",
        repoURL = "https://github.com/egladman/magus",
        navLinks = nav,
        generatorDirs = mut ["node_modules", "gen", "src", "tour"],
        generatorFiles = mut ["MAGUS.md"],
        // pico is same-origin (no CDN); offline/ is the navigation fallback. The heavy
        precacheAssets = mut [
            "search-index.json",
            "playground/wasm_exec.js",
            "playground/buzz.wasm",
            "main.js",
            "theme.js",
            "site.css",
            "console.css",
            "ui-panels.css",
            "theme.css",
            "assets/pico.min.css",
            "offline/",
        ],
    };
}

test "the site CSP carries one script-src hash per playground.html inline script" {
    final got = computeCSP(CSP_IMG_SRC_DEFAULT, scriptSrc: CSP_SCRIPT_SRC, inlineScriptFiles: CSP_INLINE_SCRIPT_SOURCES);
    assert\equal(got.indexOf("'wasm-unsafe-eval'") != null, true, "wasm-unsafe-eval present for the playground's wasm runtime");
    final f = io\File.open("playground.html", io\FileMode.read);
    final n = extractInlineScripts(f.readAll()).len();
    f.close();
    assert\equal(got.split("'sha256-").len() - 1, n, "one script-src hash per playground.html inline script");
}

test "only the badge CSP carries the badge hosts" {
    final withBadges = computeCSP(CSP_IMG_SRC_BADGES, scriptSrc: CSP_SCRIPT_SRC, inlineScriptFiles: []);
    assert\equal(withBadges.indexOf("img-src 'self' data: https://github.com https://pkg.go.dev;") != null, true, "badge img-src carries both badge hosts, verbatim");
}
