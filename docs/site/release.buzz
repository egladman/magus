// site/release.buzz - pure transforms over releases/*.yaml: newest-first semver
// ordering and per-artifact descriptions. Self-contained (only lib/text), so it
// unit-tests here; the Site-coupled loaders/writers stay in render.buzz.
namespace release;

import "lib/text" as _;
import "assert";

// semverSortKey returns a zero-padded sort key: "v0.10.0.yaml" -> "0000.0010.0000",
// so lexicographic order matches numeric semver. Unknown formats fall through to the
// original name (safe: sort-only).
export fun semverSortKey(name: str) > str {
    var v = name;
    if (v.startsWith("v")) { v = v.sub(1); }
    if (v.endsWith(".yaml")) { v = v.sub(0, v.len() - 5); }
    final parts = v.split(".");
    var key = "";
    foreach (p in parts) {
        if (key.len() > 0) { key = key + "."; }
        key = key + pad4(strToNat(p));
    }
    return key;
}

// isVersionTag reports whether a git tag names a release: "v" followed by three
// dot-separated numeric parts, with an optional -prerelease/+build suffix on the
// last one ("v0.3.0", "v1.0.0-rc.1"). Anything else is some other kind of tag.
//
// This exists because a `v*` refspec is NOT a version filter, and reading it as one
// shipped a real bug: a tag called "verified-refinements" matched the glob, sorted
// newest by creation date, and became site.releases[0]. That is the value the
// announcement bar prints AND the value __MAGUS_VERSION__ expands to, so the
// published install instructions read `VERSION=verified-refinements` and every
// download URL on the setup page pointed at a release that does not exist.
export fun isVersionTag(name: str) > bool {
    if (name.startsWith("v") == false) { return false; }
    final parts = name.sub(1).split(".");
    if (parts.len() < 3) { return false; }
    var i = 0;
    while (i < 3) {
        var p = parts[i];
        // Only the last of the three may carry a -prerelease or +build suffix.
        if (i == 2) {
            final dash = p.indexOf("-");
            if (dash != null) { p = p.sub(0, dash!); }
            final plus = p.indexOf("+");
            if (plus != null) { p = p.sub(0, plus!); }
        }
        if (p.len() == 0) { return false; }
        var j = 0;
        while (j < p.len()) {
            final b = p.byte(j);
            if (b < 48 or b > 57) { return false; }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

test "isVersionTag accepts release tags and rejects everything else" {
    assert\equal(isVersionTag("v0.3.0"), true, "a plain release tag");
    assert\equal(isVersionTag("v1.10.2"), true, "multi-digit parts");
    assert\equal(isVersionTag("v1.0.0-rc.1"), true, "a prerelease suffix");
    assert\equal(isVersionTag("verified-refinements"), false, "the tag that caused this");
    assert\equal(isVersionTag("v0.3"), false, "too few parts");
    assert\equal(isVersionTag("0.3.0"), false, "no leading v");
    assert\equal(isVersionTag("vendor"), false, "a word starting with v");
    assert\equal(isVersionTag("v0.x.0"), false, "a non-numeric part");
}

// sortNamesSemverDesc sorts release filenames newest-first. Selection sort; O(n^2)
// fine for ~10-20 releases. Mirrors Go's compareSemver in cmd/magus-utils/release.go.
export fun sortNamesSemverDesc(names: [str]) > [str] {
    var remaining: mut [str] = mut [<str>];
    foreach (n in names) { remaining.append(n); }
    var sorted: mut [str] = mut [<str>];
    while (remaining.len() > 0) {
        var maxIdx = 0;
        var maxKey = semverSortKey(remaining[0]);
        var k = 1;
        while (k < remaining.len()) {
            final key = semverSortKey(remaining[k]);
            if (key > maxKey) {
                maxKey = key;
                maxIdx = k;
            }
            k = k + 1;
        }
        sorted.append(remaining[maxIdx]);
        var next: mut [str] = mut [<str>];
        var m = 0;
        while (m < remaining.len()) {
            if (m != maxIdx) { next.append(remaining[m]); }
            m = m + 1;
        }
        remaining = next;
    }
    return sorted;
}

// artifactDesc describes a release artifact from its filename and platform, over the
// standard release asset set.
export fun artifactDesc(name: str, platform: str) > str {
    if (name == "SHA256SUMS")        { return "SHA-256 manifest"; }
    if (name == "SHA256SUMS.sig")    { return "Ed25519 signature of SHA256SUMS"; }
    if (name == "magus-release.pem") { return "Release signing key (SPKI PEM)"; }
    // Tarballs: derive from the platform string.
    if (platform == "linux/amd64")   { return "Linux amd64 binary"; }
    if (platform == "linux/arm64")   { return "Linux arm64 binary"; }
    if (platform == "linux/armv6")   { return "Linux 32-bit ARMv6 binary"; }
    if (platform == "linux/armv7")   { return "Linux 32-bit ARMv7 binary"; }
    if (platform == "darwin/amd64")  { return "macOS Intel binary"; }
    if (platform == "darwin/arm64")  { return "macOS Apple Silicon binary"; }
    if (platform == "windows/amd64") { return "Windows amd64 binary"; }
    if (platform == "windows/arm64") { return "Windows arm64 binary"; }
    return name;
}

// releaseIndexJSON (in public.buzz) encodes via serialize.jsonEncode, so this module
// needs no hand-rolled JSON string helpers.

test "semverSortKey produces zero-padded keys for numeric semver comparison" {
    assert\equal(semverSortKey("v0.2.0.yaml"),  "0000.0002.0000", "v0.2.0");
    assert\equal(semverSortKey("v0.10.0.yaml"), "0000.0010.0000", "v0.10.0");
    assert\equal(semverSortKey("v1.0.0.yaml"),  "0001.0000.0000", "v1.0.0");
    // v0.10.0 key > v0.2.0 key: newest-first sort is correct
    final key10 = semverSortKey("v0.10.0.yaml");
    final key2  = semverSortKey("v0.2.0.yaml");
    assert\equal(key10 > key2, true, "v0.10.0 sorts after v0.2.0 in descending pass");
}
