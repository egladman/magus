// site/public.buzz - the /public/ page listing the endpoints this site serves for
// machines, and loadReleases (releases/v*.yaml + tags -> Site). site_render calls
// loadReleases + renderPublic once each. The self-update index.json is NOT rendered
// here; see the note above renderPublic for why.
namespace public;

import "fs";
import "vcs";
import "io";
import "os";
import "serialize";
import "template";
import "encoding/yaml";
import "lib/text" as _;
import "lib/feed" as _;
import "site/release" as _;
import "engine/types" as _;
import "engine/page" as _;

// loadReleases builds site.releases, newest-first.
//
// TAGS ARE THE SPINE. A release exists because someone tagged it, so the version
// list and its dates come from vcs\tags("v*"); the glob keeps release tags and
// skips namespaced ones (backup/x, pre-rebase-main), whose wildcards stop at "/".
//
// releases/v*.yaml is ENRICHMENT layered on top, carrying the two things a tag
// cannot know: the changelog prose the Atom feed renders, and the artifact
// name/platform/size/sha256 that gen/public/release/index.json publishes for
// `magus self update`.
//
// Inverting these is what stops them drifting. The YAML used to BE the list, so a
// tagged release with no manifest was invisible: v0.3.0 shipped and the whole site
// - announcement bar, __MAGUS_VERSION__, every download snippet - went on
// advertising v0.2.1. A missing manifest now costs that release its prose, not its
// existence.
//
// The fallback carries as much weight as the spine. A shallow or single-branch CI
// checkout fetches no tags, and vcs\tags cannot distinguish that from "nothing has
// ever shipped" (see its binding doc). Rendering zero releases there would blank
// the version across the site on a clone depth setting, so when no tags are visible
// the manifests are used as the list, exactly as before.
export fun loadReleases(site: Site) > void !> any {
    site.releases = mut [<Release>];

    // Phase 1: read every manifest, keyed by version. manifestOrder preserves the
    // semver-descending order for the no-tags fallback (v0.10.0 before v0.2.0; a
    // lexicographic reversal gets that wrong).
    var manifests: mut {str: Release} = mut {};
    var manifestOrder: mut [str] = mut [<str>];
    final relDir = site.root + "/releases";
    if (fs\isDir(relDir)) {
        var names: mut [str] = mut [<str>];
        foreach (name in fs\list(relDir)) {
            if (name.endsWith(".yaml")) { names.append(name); }
        }
        foreach (name in sortNamesSemverDesc(names)) {
            final path = relDir + "/" + name;
            final f = io\File.open(path, io\FileMode.read);
            final src = f.readAll();
            f.close();
            final doc = serialize\Boxed.init(yaml\parse(src));
            final ver = doc.q("version").stringValue();
            final date = doc.q("date").stringValue();
            final body = doc.q("body").stringValue();
            if (ver == "") { continue; } // skip malformed files
            // Notes sections. .list() returns null when the field is absent; guard first.
            var notesAdded: mut [str] = mut [<str>];
            var notesChanged: mut [str] = mut [<str>];
            var notesFixed: mut [str] = mut [<str>];
            var notesRemoved: mut [str] = mut [<str>];
            final _addedList = doc.q("notes").q("added").list();
            if (_addedList != null) {
                foreach (item in _addedList) { notesAdded.append(item.stringValue()); }
            }
            final _changedList = doc.q("notes").q("changed").list();
            if (_changedList != null) {
                foreach (item in _changedList) { notesChanged.append(item.stringValue()); }
            }
            final _fixedList = doc.q("notes").q("fixed").list();
            if (_fixedList != null) {
                foreach (item in _fixedList) { notesFixed.append(item.stringValue()); }
            }
            final _removedList = doc.q("notes").q("removed").list();
            if (_removedList != null) {
                foreach (item in _removedList) { notesRemoved.append(item.stringValue()); }
            }
            final yanked = doc.q("yanked").booleanValue();
            // Artifacts, each name/platform/size/sha256.
            var arts: mut [{str: str}] = mut [<{str: str}>];
            final artList = doc.q("artifacts").list();
            foreach (a in artList) {
                arts.append(mut {
                    "name": a.q("name").stringValue(),
                    "platform": a.q("platform").stringValue(),
                    "size": a.q("size").stringValue(),
                    "sha256": a.q("sha256").stringValue(),
                });
            }
            manifests[ver] = Release{
                version = ver,
                date = date,
                body = body,
                notesAdded = notesAdded,
                notesChanged = notesChanged,
                notesFixed = notesFixed,
                notesRemoved = notesRemoved,
                yanked = yanked,
                artifacts = arts,
            };
            manifestOrder.append(ver);
        }
    }

    // Phase 2: tags decide which releases exist and in what order. vcs\tags already
    // returns them newest-first by creation date, so no re-sort is needed here.
    final tags = vcs\tags("v*");
    if (tags.len() == 0) {
        // No tags visible - a shallow clone, or a genuinely untagged repository. The
        // binding cannot tell those apart, so trust the manifests rather than publish
        // an empty release list that would blank the version site-wide.
        foreach (ver in manifestOrder) { site.releases.append(manifests[ver]); }
        return;
    }
    foreach (t in tags) {
        final ver = t["name"];
        final known = manifests[ver];
        if (known != null) {
            site.releases.append(known);
            continue;
        }
        // Tagged with no manifest: real, and dated, but with no prose or artifacts.
        // The tag date is RFC3339; the manifests carry a bare date, so match them.
        var when = t["date"];
        if (when.len() >= 10) { when = when.sub(0, 10); }
        site.releases.append(Release{ version = ver, date = when });
    }
}



// gen/public/release/index.json is NOT rendered here, and the omission is the
// whole mechanism. It is the manifest `magus self update` fetches, and it is only
// trustworthy alongside index.json.sig - which needs MAGUS_SIGNING_KEY, which only
// a tag build holds. This render runs on every push to main. A renderer that could
// write index.json would therefore overwrite a signed file with an unsigned one the
// next time anything merged, and the signature would 404 again.
//
// So the pair is TRACKED at docs/gen/public/release/, written by `magus-utils
// release-index` at release time from releases/*.yaml, and copied out by the deploy
// like any other file under gen/. Same arrangement as gen/install: a source file
// living inside the output tree, listed in pruneStaleOutputs' alwaysKeep so this
// render leaves it alone.


// renderPublic writes /public/ - one ordinary page listing the machine-readable
// endpoints this site serves. It used to be four nested Apache-mod_autoindex
// listings (public/, public/atom/, public/release/, public/release/<ver>/) whose
// columns promised more than the site delivers: the per-version pages tabulated
// artifact names, sizes, and checksums for files that are hosted on GitHub and
// were never served from here, so each one rendered a directory listing of an
// empty directory. Releases now link to the GitHub release, which is where the
// bytes actually are.
//
// Only the HTML went. The feeds (public/atom/*.xml, written by engine/feeds.buzz)
// are real files and are written exactly as before; the signed release manifest at
// public/release/index.json is tracked rather than rendered, for the reason above.
export fun renderPublic(site: Site) > void !> any {
    if (site.config.baseURL == "") { return; }

    // Releases stay newest-first (loadReleases sorts by semver); each card is a
    // deep link to that version's GitHub release page rather than to any asset,
    // so there is one place that lists what a release actually contains.
    var releases: mut [{str: any}] = mut [<{str: any}>];
    foreach (rel in site.releases) {
        releases.append(mut {
            "version": rel.version,
            "date": rel.date,
            "href": site.config.repoURL + "/releases/tag/" + rel.version,
            "yanked": rel.yanked,
        });
    }

    var feeds: mut [{str: str}] = mut [<{str: str}>];
    if (site.blogPosts.len() > 0) {
        feeds.append(mut {"name": "blog.atom.xml", "href": "atom/blog.atom.xml", "desc": "Blog posts, Atom 1.0"});
    }
    if (site.releases.len() > 0) {
        feeds.append(mut {"name": "releases.atom.xml", "href": "atom/releases.atom.xml", "desc": "Releases, Atom 1.0"});
    }

    final hasReleases = site.releases.len() > 0;
    final body = template\render(`<h1>Public files</h1>
<p>Endpoints this site serves for machines rather than readers. Release binaries
are hosted on GitHub; the links below go there.</p>

{{#hasReleases}}
<h2>Releases</h2>
<div class="related-grid">
{{#releases}}  <a class="related-card" href="{{href}}"><span class="related-card-title">{{version}}{{#yanked}} (yanked){{/yanked}}</span><span class="related-card-desc">{{date}}</span></a>
{{/releases}}</div>
{{/hasReleases}}

{{#hasFeeds}}
<h2>Feeds</h2>
<ul>
{{#feeds}}  <li><a href="{{href}}">{{name}}</a> - {{desc}}</li>
{{/feeds}}</ul>
{{/hasFeeds}}

<h2>Manifests</h2>
<ul>
{{#hasReleases}}  <li><a href="release/index.json">release/index.json</a> - the signed release manifest <code>magus self update</code> reads. Verified against <code>index.json.sig</code> using the release key pinned in every binary.</li>
{{/hasReleases}}  <li><a href="../sitemap.xml">sitemap.xml</a> - XML sitemap</li>
  <li><a href="../robots.txt">robots.txt</a> - crawler policy</li>
</ul>
`, {"hasReleases": hasReleases, "releases": releases, "hasFeeds": feeds.len() > 0, "feeds": feeds});

    fs\mkdirAll(site.outDir + "/public");
    // srcRel is a synthesized-page marker, not a file: the "/_index.md" suffix is
    // what tells renderPage there is no source to view or edit, and the depth is
    // what rootPrefix climbs. Pin its commit footer to CHANGELOG.md (this tree's
    // real source) so it does not advance with HEAD every commit and trip the
    // drift gate; fall back to HEAD before CHANGELOG.md is committed.
    final srcMarker = "public/_index.md";
    final chLog = site.metaCommits[site.metaPrefix + "CHANGELOG.md"];
    if (chLog != null) {
        site.metaCommits[site.metaPrefix + srcMarker] = chLog;
    } else {
        site.metaCommits[site.metaPrefix + srcMarker] = site.metaFull + "|" + site.metaShort + "|" + site.metaStamp;
    }
    final doc = renderPage("Public files", "Machine-readable endpoints served by this site: release manifest, Atom feeds, sitemap, and robots policy.", body, srcMarker, "", "public/", "", mut [], site);
    fs\writeFile(site.outDir + "/public/index.html", doc);
    site.pageUrls["public/"] = true;
    site.writtenPaths["public/index.html"] = true;
}
