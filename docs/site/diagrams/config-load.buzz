namespace configLoad;

import "magus";
import "magus/figure";

export fun configLoadFigure() > figure\Figure !> any {
    final config = magus\graph().dir("internal/config");
    final gen = magus\graph().dir("internal/config/gen");
    final cfgen = magus\graph().dir("libs/clikit/generate");
    final httpx = magus\graph().dir("internal/httpx");
    final endpoint = magus\graph().dir("internal/proc/endpoint");
    final ward = magus\graph().dir("internal/ward");
    final stamp = magus\graph().dir("internal/stamp");
    final xdg = magus\graph().dir("libs/xdg");
    final sources = figure\external("Config sources", sub: "magus.yaml, env, flags", look: figure\Look.input);
    return figure\of("config-load",
            title: "Every key has one declaration, and every source feeds the same load",
            eyebrow: "config",
            desc: "The load reads magus.yaml, the environment and the flags into one set of "
                + "keys, resolving user and state paths through the xdg directories. A remote "
                + "source goes through the HTTP client, a daemon address through the endpoint "
                + "package, and a key that names a ward or a stamp is checked against it. The "
                + "keys come from one declaration. The generator writes the typed accessors in "
                + "gen from it, so a flag, a config key and the help text cannot disagree.")
        .actor(sources)
        .box(config, label: "Config load", sub: "one set of keys", focal: true)
        .box(gen, label: "Typed keys", sub: "generated accessors", look: figure\Look.store)
        .box(cfgen, label: "Key generator", sub: "from the declaration")
        .box(httpx, label: "HTTP client", sub: "remote sources")
        .box(endpoint, label: "Endpoints", sub: "daemon addresses")
        .box(ward, label: "Ward", sub: "kind checks")
        .box(stamp, label: "Stamp", sub: "build identity")
        .box(xdg, label: "XDG paths", sub: "config, state, cache")
        .edgesFromGraph()
        .flowIn(sources, dst: config)
        .legend(figure\Look.focal, label: "the load")
        .legend(figure\Look.store, label: "generated output")
        .legend(figure\Look.input, label: "where keys come from")
        .scope([config, gen, cfgen]);
}
