// site/diagrams/daemon-http.buzz - what reaches the daemon's HTTP server, and what bypasses the
// guard. Split out of the README's single whole-system flowchart, which carried this
// alongside four other subjects and blew every complexity budget in the design system.
//
// The figure has one claim: every route except the health probes sits behind the guard.
// The accent pair (the guard box, the probe connector) is spent entirely on making that
// one exception visible.
namespace daemonHttp;

import "../libs/diagram/diagram" as _;

export fun daemonHttpDiagram() > Diagram {
    return Diagram{
        id = "daemon-http",
        eyebrow = "magus daemon",
        title = "The HTTP surface, and the one route without a guard",
        desc = "Agents and the console reach /mcp, /api/v1, the Connect services and "
            + "/api/v1/share through the DNS-rebind, bearer-token and CORS guard. The "
            + "health endpoints answer probes directly, with no authentication.",
        width = 960,
        height = 600,
        nodes = [
            Node{ id = "agent", label = "AI agents", sub = "Claude Code, IDE",
                  tag = "client", x = 32, y = 112, w = 160, h = 64 },
            Node{ id = "console", label = "Console PWA", sub = "dashboard, graph",
                  tag = "client", x = 32, y = 200, w = 160, h = 64 },
            Node{ id = "probe", label = "kubelet", sub = "scripts, probes",
                  tag = "client", role = "external", x = 32, y = 440, w = 160, h = 64 },

            Node{ id = "guard", anchor = "internal/httpx", label = "Guard", sub = "rebind + token + CORS",
                  tag = "gate", role = "focal", x = 320, y = 200, w = 180, h = 88 },

            Node{ id = "mcp", anchor = "internal/handler/mcp", label = "/mcp", sub = "Streamable HTTP, SSE",
                  x = 600, y = 88, w = 200, h = 64 },
            Node{ id = "api", anchor = "internal/handler/graph", label = "/api/v1", sub = "graph, status, events",
                  x = 600, y = 176, w = 200, h = 64 },
            Node{ id = "connect", anchor = "internal/handler/metrics", label = "Connect RPC", sub = "metrics, activity",
                  x = 600, y = 264, w = 200, h = 64 },
            Node{ id = "share", anchor = "internal/share", label = "/api/v1/share", sub = "loopback only",
                  x = 600, y = 352, w = 200, h = 64 },
            Node{ id = "health", anchor = "internal/daemon", label = "/livez /readyz", sub = "no authentication",
                  role = "external", x = 600, y = 440, w = 200, h = 64 },
        ],
        // Bends are declared rather than defaulted so no two crossing segments share an x:
        // the fan order out of the guard has to mirror the bend order, or the runs to /mcp
        // and /api/v1 cross each other on the way up.
        edges = [
            Edge{ src = "agent", dst = "guard", dstSlot = 1, dstSlots = 2, bend = 240 },
            Edge{ src = "console", dst = "guard", dstSlot = 2, dstSlots = 2, bend = 272 },

            Edge{ src = "guard", dst = "mcp", srcSlot = 1, srcSlots = 4, bend = 520 },
            Edge{ src = "guard", dst = "api", srcSlot = 2, srcSlots = 4, bend = 536 },
            Edge{ src = "guard", dst = "connect", srcSlot = 3, srcSlots = 4, bend = 528 },
            Edge{ src = "guard", dst = "share", srcSlot = 4, srcSlots = 4, bend = 512 },

            Edge{ src = "probe", dst = "health", label = "unguarded", kind = "accent" },
        ],
        legend = [
            LegendItem{ role = "focal", label = "authenticated" },
            LegendItem{ role = "external", label = "open to any caller" },
        ],
    };
}
