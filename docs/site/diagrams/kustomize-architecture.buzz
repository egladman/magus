namespace kustomizeArchitecture;

import "magus/diagram";
import "result";
import "../libs/kustomize/kustomize" as kustomize;

// The objects come from the dev overlay's own YAML, so an edit to a manifest moves the
// diagram and nobody redraws it.
export fun kustomizeArchitectureDiagram() > result\Result::<diagram\Diagram> {
    final objects = kustomize\build("../deploy/kustomize/overlays/dev");
    if (objects.error -> err) {
        return result\Result::<diagram\Diagram>{ error = err };
    }
    return kustomize\diagram(objects.value!,
        id: "kustomize-architecture",
        title: "The dev overlay denies the daemon every port but DNS and HTTPS",
        eyebrow: "kustomize",
        desc: "Read from deploy/kustomize/overlays/dev without the kustomize binary. One pod, "
            + "one claim, no token: the default-deny policy shuts every port, and two "
            + "egress policies open DNS and HTTPS back up.");
}
