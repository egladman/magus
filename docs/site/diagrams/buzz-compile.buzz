namespace buzzCompile;

import "magus";
import "magus/diagram";
import "result";

// buzzCompileDiagram draws the steps inside the gopherbuzz root package. The lexer and the
// chunk passes live in token and vm, so they are named in the subs, not drawn beside the
// steps: a Level.symbol diagram draws inside one package.
export fun buzzCompileDiagram() > result\Result::<diagram\Diagram> {
    try {
        final session = magus\graph().dir("libs/gopherbuzz");
        final source = diagram\external("Buzz source", sub: "a file or a snippet", look: diagram\Look.input);
        final parseCache = diagram\stage(session, refs: magus\graph().refs("symbol:gomod github.com/egladman/magus/libs/gopherbuzz `github.com/egladman/magus/libs/gopherbuzz`/ParseCache#tokenize()."), name: "Parse cache",
            sub: "token.Tokenize on a miss", look: diagram\Look.store);
        final parser = diagram\stage(session, refs: magus\graph().refs("symbol:gomod github.com/egladman/magus/libs/gopherbuzz `github.com/egladman/magus/libs/gopherbuzz`/parseModedTracked()."), name: "Parser",
            sub: "recursive descent, *ast.Program");
        final imports = diagram\stage(session, refs: magus\graph().refs("symbol:gomod github.com/egladman/magus/libs/gopherbuzz `github.com/egladman/magus/libs/gopherbuzz`/Session#loadFileImports()."), name: "Import resolution",
            sub: "runs each module first", look: diagram\Look.focal);
        final checker = diagram\stage(session, refs: magus\graph().refs("symbol:gomod github.com/egladman/magus/libs/gopherbuzz `github.com/egladman/magus/libs/gopherbuzz`/checkWithPrelude()."), name: "Checker",
            sub: "types.Type, BZZ codes");
        final compiler = diagram\stage(session, refs: magus\graph().refs("symbol:gomod github.com/egladman/magus/libs/gopherbuzz `github.com/egladman/magus/libs/gopherbuzz`/CompileWith()."), name: "Compiler",
            sub: "AST to *vm.Chunk");
        final store = diagram\stage(session, refs: magus\graph().refs("symbol:gomod github.com/egladman/magus/libs/gopherbuzz `github.com/egladman/magus/libs/gopherbuzz`/Session#loadCachedChunk()."), name: "Bytecode store",
            sub: ".bo plus its import closure", look: diagram\Look.store);
        return result\ok::<diagram\Diagram>(diagram\of("buzz-compile",
                title: "Imports run before the checker sees a name",
                eyebrow: "gopherbuzz",
                desc: "Inside the gopherbuzz root package, source passes the parse cache, the parser, "
                    + "import resolution, the checker and the compiler, which emits a chunk. Import "
                    + "resolution runs every imported module through the same steps first, so its "
                    + "exports are bound before the checker looks names up. A fresh bytecode store "
                    + "skips every step.",
                direction: diagram\Direction.down, level: diagram\Level.symbol)
            .actor(source)
            .actor(parseCache)
            .actor(parser)
            .actor(imports)
            .actor(checker)
            .actor(compiler)
            .actor(store)
            .flowAcross(source, dst: parseCache)
            .flowAcross(parseCache, dst: parser, label: "[]Token")
            .flowAcross(parser, dst: imports, label: "*ast.Program")
            .flowAcross(imports, dst: checker, label: "exports bound")
            .flowAcross(checker, dst: compiler, label: "no errors")
            .flowAcross(compiler, dst: store, label: "saves")
            .flowAcross(source, dst: store, label: "fresh hit", stroke: diagram\Stroke.optional)
            .legend(diagram\Look.focal, label: "where an import runs")
            .legend(diagram\Look.store, label: "optional, set by the host")
            .legend(diagram\Look.input, label: "what a host hands in")
            .scope([session]));
    } catch (err: any) {
        return result\caught::<diagram\Diagram>(err);
    }
}
