// site/diagrams/diagram-pipeline.buzz: how a figure on this site gets drawn, including this one.
//
// The figure has one claim: every figure reaches its reader through magus/figure, and the
// Go that touches the module embeds the same source the figures import. The accent is
// that module.
//
// A figure's boxes are the graph's own records, read through the magus module; the Go
// edges between std, the module and the server are imports. The figure sources, the
// committed files and the site render are Buzz and files, so they are actors.
namespace diagramPipeline;

import "magus";
import "magus/figure";

export fun diagramPipelineFigure() > figure\Figure !> any {
    final module = magus\dir("libs/figure");
    final host = magus\dir("std");
    final server = magus\dir("internal/handler/diagram");
    final source = figure\external("Figure source", sub: "records, sets, actors", tag: "buzz", look: figure\Look.plain);
    final files = figure\external("SVGs + receipts", sub: "diagrams-generate", look: figure\Look.store);
    final site = figure\external("Site render", sub: "inlines the page copy", look: figure\Look.plain);
    final console = figure\external("Console view", sub: "static SVG, then wasm", look: figure\Look.plain);
    return figure\of("diagram-pipeline")
        .eyebrow("figures")
        .title("One library draws every figure, here and in the console")
        .desc("A figure in docs/site/diagrams builds its boxes from the knowledge graph's own "
            + "records, magus\\dir, magus\\dirs and magus\\layer, and draws the imports and "
            + "declared calls between them. magus/figure lays it out and paints it; "
            + "diagrams-generate writes the committed light, dark and page copies with a "
            + "receipt beside each, and the site render inlines the page copy. The server "
            + "embeds the same module to draw live figures at /api/v1/diagrams, which the "
            + "console fetches.")
        .actor(source)
        .box(host, label: "magus module", sub: "dir, dirs, layer from the graph", look: figure\Look.input)
        .box(module, label: "magus/figure", sub: "sets, layout, paint", focal: true)
        .actor(files)
        .actor(site)
        .box(server, label: "/api/v1/diagrams", sub: "the module in-process")
        .actor(console)
        .edgesFromGraph()
        .markEdge(host, dst: module, label: "embeds")
        .flowIn(source, dst: host, label: "records")
        .flowIn(source, dst: module, label: "imports")
        .flowOut(module, dst: files, label: "paints")
        .flowAcross(files, dst: site, label: "page copy")
        .flowIn(console, dst: server, label: "GET")
        .legend(figure\Look.focal, label: "the one layout")
        .legend(figure\Look.input, label: "reads the knowledge graph")
        .legend(figure\Look.store, label: "committed output")
        .scope(figure\setOf([module, server]));
}
