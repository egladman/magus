namespace diagramPipeline;

import "magus";
import "magus/figure";
import "site/diagrams/packages" as packages;

export fun diagramPipelineFigure() > figure\Figure !> any {
    final module = magus\graph().dir("libs/figure");
    final host = magus\graph().dir("std");
    final server = magus\graph().dir("internal/handler/diagram");
    final jobs = magus\graph().dir("internal/job");
    final source = figure\external("Figure source", sub: "records, sets, actors", tag: "buzz", look: figure\Look.plain);
    final files = figure\external("SVGs + receipts", sub: "diagrams-generate", look: figure\Look.store);
    final site = figure\external("Site render", sub: "inlines the page copy", look: figure\Look.plain);
    final console = figure\external("Console view", sub: "static SVG, then wasm", look: figure\Look.plain);
    return figure\of("diagram-pipeline",
            title: "One library draws every figure, here and in the console",
            eyebrow: "figures",
            desc: "A figure in docs/site/diagrams builds its boxes from the knowledge graph's own "
                + "records, magus\\graph().dir, magus\\graph().dirs and magus\\graph().layer, and draws the imports and "
                + "declared calls between them. magus/figure lays it out and paints it; "
                + "diagrams-generate writes the committed light, dark and page copies with a "
                + "receipt beside each, and the site render inlines the page copy. The server "
                + "embeds the same module to draw live figures at /api/v1/diagrams, which the "
                + "console fetches. The job store draws its plan figure through the same module, and each figure's receipt carries a stamp of its boxes and edges, so a stale committed copy is a diff.")
        .actor(source)
        .box(host, label: "magus module", sub: "dir, dirs, layer from the graph", look: figure\Look.input)
        .box(module, label: "magus/figure", sub: "sets, layout, paint", focal: true)
        .actor(files)
        .actor(site)
        .box(server, label: "/api/v1/diagrams", sub: "the module in-process")
        .box(jobs, label: "Job plan figure", sub: "draws rows with the same module")
        .actor(console)
        .edgesFromGraph()
        .markEdge(host, dst: module, label: "embeds")
        .flowIn(source, dst: host, label: "records")
        .flowIn(source, dst: module, label: "imports")
        .flowOut(module, dst: files, label: "paints")
        .flowAcross(files, dst: site, label: "page copy")
        .flowIn(console, dst: server, label: "GET")
        .legend(figure\Look.focal, label: "the one layout")
        .legend(figure\Look.input, label: "reads the knowledge graph")
        .legend(figure\Look.store, label: "committed output")
        .scope(packages\goPackages("libs/*"))
        .scope(packages\goPackages("libs/figure/**"))
        .scope(packages\goPackages("std/**"))
        .scope(magus\graph().layer("handler").dirs)
        .except([magus\graph().dir("libs/gopherbuzz")],
            why: "the Buzz runtime every module runs on, figures included; drawn in buzz-engine")
        .except([magus\graph().dir("libs/testpairing")],
            why: "the Go analyzer for test layout; no figure passes through it")
        .except([magus\graph().dir("libs/proofread")],
            why: "the prose linter; figure layout does not use it")
        .except([magus\graph().dir("libs/diagnostics")],
            why: "the diagnostic-code framework; a figure's findings are plain strings")
        .except([magus\graph().dir("libs/testkit")], why: "fixtures for magus's Go tests")
        .except([magus\graph().dir("libs/scipbuzz")],
            why: "the Buzz symbol indexer; it feeds the knowledge graph, not a figure")
        .except([magus\graph().dir("libs/apiversion")],
            why: "the apiVersion, kind and conditions envelope records carry; no figure passes through it")
        .except([magus\graph().dir("libs/proofread")],
            why: "the prose judge; a figure's text is not judged by it")
        .except([magus\graph().dir("libs/xdg")],
            why: "the user config, state and cache directories; no figure passes through them")
        .except([magus\graph().dir("libs/embed")],
            why: "the static embedding table and retrieval eval behind knowledge search; no figure passes through it")
        .except([magus\graph().dir("libs/image")],
            why: "OCI layout assembly; no figure passes through it")
        .except([magus\graph().dir("libs/oci")],
            why: "the registry client; no figure passes through it")
        .except([magus\graph().dir("libs/result")],
            why: "the Buzz Result type embedded by go-build; no figure passes through it")
        .except([magus\graph().dir("libs/termkit")],
            why: "the terminal UI library; no figure passes through it")
        .except(packages\goPackages("std/termkit/**"),
            why: "the termkit host modules; a figure source reads the graph through the magus module alone")
        .except(packages\goPackages("std/encoding/**"),
            why: "the encoding host modules; a figure source reads the graph through the magus module alone")
        .except(figure\without(magus\graph().layer("handler").dirs, drop: [server]),
            why: "the console's other services; none embeds magus/figure");
}
