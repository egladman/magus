namespace dogfood;

import "magus/figure";

export fun dogfoodFigure() > figure\Figure !> any {
    final commit = figure\external("This commit", sub: "magusfile + Go source", look: figure\Look.plain);
    final fromSource = figure\external("Built from source", sub: "setup-magus source-path", look: figure\Look.plain);
    final gates = figure\external("Every gate", sub: "lint, build, test, ci", look: figure\Look.focal);
    final pinned = figure\external("Last release", sub: "setup-magus git-ref");
    final compat = figure\external("audit compat", sub: "red is a signal, not a stop", look: figure\Look.optional);
    // Two tracks, not a build cycle: a cycle shows the bootstrap but not why one job pins the
    // last release.
    return figure\of("dogfood",
            title: "magus builds magus, then runs the last release at it too",
            eyebrow: "development",
            desc: "Almost every CI job builds magus from the commit under test and runs it "
                + "against that commit's magusfile, so a change can rely on a feature that has "
                + "not shipped. One audit job instead runs the pinned previous release against "
                + "the same magusfile; it is advisory, and a failure reports a breaking change "
                + "rather than blocking the branch.")
        .actor(commit)
        .flowAcross(commit, dst: fromSource)
        .flowAcross(commit, dst: pinned)
        .flowAcross(fromSource, dst: gates, label: "must pass")
        .flowAcross(pinned, dst: compat, label: "may fail", stroke: figure\Stroke.focal)
        .zone("blocking: the binary this commit defines", actors: [fromSource, gates])
        .zone("advisory: the last release, same magusfile", actors: [pinned, compat])
        .legend(figure\Look.focal, label: "blocks the branch")
        .legend(figure\Look.optional, label: "advisory only")
        .unscoped(why: "a CI arrangement, not a Go package");
}
