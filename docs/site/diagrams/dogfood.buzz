// site/diagrams/dogfood.buzz - magus builds magus, and the two ways CI runs it against
// this commit's magusfile.
//
// The figure is about a deliberate asymmetry, not a build loop. Nearly every job builds
// the magus THIS commit defines and runs it here, so a magusfile change that needs an
// unreleased feature is exercised by the very commit introducing it - there is no
// release-first ordering problem. Exactly one job pins the last release instead. That one
// is allowed to go red: it is a compatibility signal, not a gate, and breaking it on
// purpose is sometimes the correct outcome.
//
// An earlier version of this diagram drew the build as a three-node cycle. That was true
// and useless: it showed the bootstrap without showing why there are two tracks.
namespace dogfood;

import "../libs/diagram/diagram" as _;
import "../libs/diagram/flow" as _;

export fun dogfoodDiagram() > Diagram !> str {
    return flow("dogfood")
        .eyebrow("development")
        .title("magus builds magus, then runs the last release at it too")
        .desc("Almost every CI job builds magus from the commit under test and runs it "
            + "against that commit's magusfile, so a change can rely on a feature that has "
            + "not shipped. One audit job instead runs the pinned previous release against "
            + "the same magusfile; it is advisory, and a failure reports a breaking change "
            + "rather than blocking the branch.")
        .node("commit", label: "This commit", sub: "magusfile + Go source")
        .node("fromsource", label: "Built from source", sub: "setup-magus source-path")
        .node("gates", label: "Every gate", sub: "lint, build, test, ci", role: Role.focal)
        .node("pinned", label: "Last release", sub: "setup-magus git-ref", role: Role.external)
        .node("compat", label: "audit compat", sub: "red is a signal, not a stop", role: Role.optional)
        .edge("commit", dst: "fromsource")
        .edge("commit", dst: "pinned")
        .edge("fromsource", dst: "gates", label: "must pass")
        .edge("pinned", dst: "compat", label: "may fail", role: EdgeRole.focal)
        .zone("blocking: the binary this commit defines", members: ["fromsource", "gates"])
        .zone("advisory: the last release, same magusfile", members: ["pinned", "compat"])
        .legend(Role.focal, label: "blocks the branch")
        .legend(Role.optional, label: "advisory only")
        .unscoped("a CI arrangement, not a Go package")
        .diagram();
}
