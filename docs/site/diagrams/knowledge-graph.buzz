// site/diagrams/knowledge-graph.buzz: where the knowledge graph's nodes come from and who reads them.
//
// The figure has one claim: every source lands in a shard of its own, and every reader
// asks the one merged graph the same four verbs. The accent is that graph.
//
// The adapters are files of one Go package, so the connectors between them claim flow:
// an import graph cannot see a call inside a package. The two readers' connectors are
// real imports and claim so. Five small file adapters share one box; each writes its own
// @ shard, which the box's sub names.
namespace knowledgeGraph;

import "../libs/diagram/diagram" as _;
import "../libs/diagram/flow" as _;
import "site/diagrams/gen/knowledge-graph" as knowledgeGraphGen;

export fun knowledgeGraphDiagram() > Diagram !> str {
    return flow("knowledge-graph", observed: knowledgeGraphGen\knowledgeGraphObserved())
        .eyebrow("knowledge graph")
        .title("Every source writes a shard; every reader asks one graph")
        .desc("magus graph build assembles a shard per source: the registry and one per "
            + "project from the magusfiles, the file adapters for Buzz, docs, directories, "
            + "citations and CODEOWNERS, a lazy symbol shard per project from a SCIP index, "
            + "git history and notes. The store fingerprints each shard and rewrites only "
            + "the ones whose content changed, then merges them into one graph. The CLI and "
            + "the MCP tools read that graph through the same query, explain, refs and path.")
        .node("core", label: "Magusfiles + registry", sub: "@registry, one per project", anchor: "internal/graph/knowledge/assemble.go")
        .node("files", label: "File adapters", sub: "buzz, docs, dirs, links, owners", anchor: "internal/graph/knowledge/buzz.go")
        .node("symbols", label: "Symbols", sub: "SCIP index, lazy shards", role: Role.input, anchor: "internal/graph/knowledge/symbols.go")
        .node("vcs", label: "History", sub: "@vcs, from git", anchor: "internal/graph/knowledge/vcs.go")
        .node("notes", label: "Notes", sub: "@notes shared + private", anchor: "internal/graph/knowledge/notes.go")
        .node("store", label: "Shard store", sub: "fingerprint, sync, merge", role: Role.store, anchor: "internal/graph/knowledge/store.go")
        .node("graph", label: "One graph", sub: "query, explain, refs, path", role: Role.focal, anchor: "internal/graph/knowledge")
        .node("cli", label: "magus CLI", sub: "text or -o json", tag: "reader", anchor: "cmd/magus")
        .node("mcp", label: "MCP tools", sub: "magus_query and kin", tag: "reader", anchor: "internal/handler/mcp")
        .edge("core", dst: "store")
        .edge("files", dst: "store")
        .edge("symbols", dst: "store")
        .edge("vcs", dst: "store")
        .edge("notes", dst: "store")
        .edge("store", dst: "graph")
        .edge("cli", dst: "graph", claim: Claim.imports)
        .edge("mcp", dst: "graph", claim: Claim.imports)
        // The readers sit a column past the adapters, so their connectors reach the graph
        // without crossing the five into the store.
        .rank(["store", "cli", "mcp"])
        .zone("a shard per source", members: ["core", "files", "symbols", "vcs", "notes"])
        .legend(Role.focal, label: "what every reader asks")
        .legend(Role.input, label: "built by a SCIP indexer")
        .legend(Role.store, label: "the cache directory")
        .scope(["internal/graph/**"])
        .omit("internal/graph/dependency", why: "the project DAG the build runs on; it reaches the graph as types inside the magusfiles box")
        .omit("internal/graph/url", why: "formats Graph Explorer links a CLI command prints; it adds no node")
        .diagram();
}
