// site/diagrams/knowledge-graph.buzz: where the knowledge graph's nodes come from and who reads them.
//
// The figure has one claim: every source lands in a shard of its own, and every reader
// asks the one merged graph the same four verbs. The accent is that graph.
//
// The adapters are files of internal/graph/knowledge, so they are actors writing into the
// package that stores and merges their shards. The readers' connectors are real imports:
// the CLI and the MCP tools both reach the graph through the root package's verbs.
namespace knowledgeGraph;

import "magus";
import "magus/figure";

export fun knowledgeGraphFigure() > figure\Figure !> any {
    final graph = magus\dir("internal/graph/knowledge");
    final verbs = magus\dir(".");
    final cli = magus\dir("cmd/magus");
    final mcp = magus\dir("internal/handler/mcp");
    final core = figure\external("Magusfiles + registry", sub: "@registry, one per project", look: figure\Look.plain);
    final files = figure\external("File adapters", sub: "buzz, docs, dirs, links, owners", look: figure\Look.plain);
    final symbols = figure\external("Symbols", sub: "SCIP index, lazy shards", look: figure\Look.input);
    final vcs = figure\external("History", sub: "@vcs, from git", look: figure\Look.plain);
    final notes = figure\external("Notes", sub: "@notes shared + private", look: figure\Look.plain);
    return figure\of("knowledge-graph",
            title: "Every source writes a shard; every reader asks one graph",
            eyebrow: "knowledge graph",
            desc: "magus graph build assembles a shard per source: the registry and one per "
                + "project from the magusfiles, the file adapters for Buzz, docs, directories, "
                + "citations and CODEOWNERS, a lazy symbol shard per project from a SCIP index, "
                + "git history and notes. The store fingerprints each shard and rewrites only "
                + "the ones whose content changed, then merges them into one graph. The CLI and "
                + "the MCP tools read that graph through the same query, explain, refs and path.")
        .actor(core)
        .actor(files)
        .actor(symbols)
        .actor(vcs)
        .actor(notes)
        .box(graph, label: "One graph", sub: "fingerprint, sync, merge", focal: true)
        .box(verbs, label: "The four verbs", sub: "query, explain, refs, path")
        .box(cli, label: "magus CLI", sub: "text or -o json", tag: "reader")
        .box(mcp, label: "MCP client", sub: "magus\\query and kin", tag: "reader")
        .edgesFromGraph()
        .hideEdges(figure\setOf([cli]), dst: figure\setOf([graph, mcp]),
            why: "graph build drives the store and the CLI serves the MCP tools; the reads go through the verbs")
        .flowIn(core, dst: graph)
        .flowIn(files, dst: graph)
        .flowIn(symbols, dst: graph)
        .flowIn(vcs, dst: graph)
        .flowIn(notes, dst: graph)
        .zone("a shard per source", actors: [core, files, symbols, vcs, notes])
        .legend(figure\Look.focal, label: "what every reader asks")
        .legend(figure\Look.input, label: "built by a SCIP indexer")
        .scope(figure\setOf([graph]));
}
