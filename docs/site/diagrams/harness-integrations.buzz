namespace harnessIntegrations;

import "magus";
import "magus/diagram";
import "result";

export fun harnessIntegrationsDiagram() > result\Result::<diagram\Diagram> {
    try {
        final spells = diagram\external("Harness spells", sub: "spells/harness: claude-code, codex, cursor, opencode", look: diagram\Look.focal);
        final hook = diagram\external("Hook entry", sub: "printed by describe harness", look: diagram\Look.plain);
        final skills = diagram\external("Skills", sub: "embedded, stamped", look: diagram\Look.plain);
        final scout = diagram\external("Scout agent", sub: "read-only lookups", look: diagram\Look.plain);
        final host = diagram\external("Agent host", sub: "Claude Code, Codex, Cursor, OpenCode", tag: "client");
        final agent = magus\graph().dir("internal/agent");
        final driver = magus\graph().dir("internal/agent/harness");
        final guard = magus\graph().dir("internal/guard");
        return result\ok::<diagram\Diagram>(diagram\of("harness-integrations",
                title: "One spell per host writes the hook that reaches the guard",
                eyebrow: "agents",
                direction: diagram\Direction.down,
                desc: "Each supported host has a harness spell under spells/harness that prints the "
                    + "hook entry a person merges into the host's config. magus agent install writes "
                    + "the shared half, the embedded skills and the scout agent, through "
                    + "internal/agent. The hook each spell prints runs the guard before every call, and "
                    + "the driver in internal/agent/harness proves it against a real hook payload.")
            .actor(spells)
            .actor(hook)
            .actor(host)
            .actor(skills)
            .actor(scout)
            .box(agent, label: "Agent install", sub: "magus agent install")
            .box(driver, label: "Host driver", sub: "runs a host's loop in tests", look: diagram\Look.optional)
            .box(guard, label: "Guard", sub: "every call, first")
            .flowAcross(spells, dst: hook, label: "prints")
            .flowAcross(hook, dst: host, label: "merged by hand")
            .flowOut(agent, dst: skills, label: "writes")
            .flowOut(agent, dst: scout, label: "writes")
            .flowAcross(skills, dst: host, label: "read by")
            .flowIn(host, dst: guard, label: "every call", stroke: diagram\Stroke.focal)
            .edgesFromGraph()
            .zone("what a spell prints", actors: [spells, hook])
            .legend(diagram\Look.focal, label: "one per host")
            .legend(diagram\Look.optional, label: "tests only")
            .legend(diagram\Look.external, label: "outside magus")
            .scope([agent, driver, guard]));
    } catch (err: any) {
        return result\caught::<diagram\Diagram>(err);
    }
}
