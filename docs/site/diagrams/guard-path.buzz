// site/diagrams/guard-path.buzz: what happens between an agent's tool call and the verdict it gets back.
//
// The figure has one claim: one command judges every call, and the verdict it returns
// carries its own next step. The built-in rules run first; the workspace's rules only
// see what they let through and can only add to the verdict. The accent is the verdict.
//
// The hook runs magus as a separate process, the workspace's rules are a Buzz file, and the
// verdict is a value the guard returns, so those are actors. The Go connectors are imports.
namespace guardPath;

import "magus";
import "magus/figure";

export fun guardPathFigure() > figure\Figure !> any {
    final shell = magus\dir("cmd/magus");
    final guard = magus\dir("internal/guard");
    final jobs = magus\dir("internal/job");
    final hint = magus\dir("internal/hint");
    final hook = figure\external("Host hook", sub: "PreToolUse, stdin JSON", tag: "settings");
    final policy = figure\external("Workspace rules", sub: "magus\\guard.command, can only add", look: figure\Look.input);
    final verdict = figure\external("Verdict", sub: "deny, advise or pass", look: figure\Look.focal);
    return figure\of("guard-path")
        .eyebrow("guard")
        .title("One command judges every call, and says what to run instead")
        .desc("The host's PreToolUse hook, wired by magus agent harness install, pipes the "
            + "event to magus shell. The built-in rules judge it first, reading the job store "
            + "for the lease the call acts as; the workspace's magus\\guard.command rule sees "
            + "only what they let through and can only add to the verdict. A deny carries its "
            + "reason and a next: breadcrumb naming the command to run instead, and the hook "
            + "renders it into the host's reply.")
        .actor(hook)
        .box(shell, label: "magus shell", sub: "the guard with one door")
        .box(guard, label: "Built-in rules", sub: "catalogued, run first")
        .box(jobs, label: "Job store", sub: "leases, write paths", look: figure\Look.store)
        .actor(policy)
        .actor(verdict)
        .box(hint, label: "next: breadcrumb", sub: "a command to run")
        .edgesFromGraph()
        .hideEdges(figure\setOf([shell]), dst: figure\setOf([jobs, hint]),
            why: "the shell's own job and hint uses are other verbs; a call reaches them through the guard")
        .hideEdges(figure\setOf([jobs]), dst: figure\setOf([hint]),
            why: "job results carry their own next: steps; the guard's comes from the verdict")
        .markEdge(shell, dst: guard, label: "judges")
        .markEdge(guard, dst: jobs, label: "lease")
        .markEdge(guard, dst: hint, label: "next")
        .flowIn(hook, dst: shell, label: "argv + stdin")
        .flowOut(guard, dst: policy, label: "let through")
        .flowOut(guard, dst: verdict)
        .flowAcross(policy, dst: verdict)
        .flowAcross(verdict, dst: hook, label: "reply")
        .legend(figure\Look.focal, label: "what the agent reads")
        .legend(figure\Look.external, label: "the host's side")
        .legend(figure\Look.input, label: "this repo's rules")
        .legend(figure\Look.store, label: "the declared leases")
        .scope(figure\setOf([guard, jobs, hint]));
}
