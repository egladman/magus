namespace mergeQueueWorkflows;

import "magus";
import "magus/figure";

export fun mergeQueueWorkflowsFigure() > figure\Figure !> any {
    final provider = magus\graph().dir("internal/queue/provider");
    final client = magus\graph().dir("internal/queue/client");
    final engine = magus\graph().dir("internal/queue");
    final types = magus\graph().dir("internal/queue/types");
    final intent = figure\external("queue-intent", sub: "records a merge intent", tag: "workflow", look: figure\Look.input);
    final queue = figure\external("queue", sub: "plans, validates the batch", tag: "workflow", look: figure\Look.plain);
    final apply = figure\external("queue-apply", sub: "merges what passed", tag: "workflow", look: figure\Look.plain);
    final gate = figure\external("merge-queue.buzz", sub: "the repo's gate", look: figure\Look.plain);
    return figure\of("merge-queue-workflows",
            title: "Three workflows drive the queue, and one script gates it",
            eyebrow: "merge queue",
            desc: "queue-intent runs when a pull request asks to merge and records the intent. "
                + "queue plans the batch with the engine, asks the forge provider for the changes "
                + "and runs the repository's gate script on the candidate. queue-apply merges the "
                + "candidate the gate passed and reports the rest. The workflows are YAML; the "
                + "decisions are the engine's, so the same queue runs from any forge that has a "
                + "provider.",
            direction: figure\Direction.down)
        .actor(intent)
        .actor(queue)
        .actor(apply)
        .box(engine, label: "Queue engine", sub: "plan, validate, apply", focal: true)
        .box(provider, label: "Forge provider", sub: "github.buzz")
        .box(client, label: "Queue client", sub: "asks the SDK")
        .box(types, label: "Queue records", sub: "intent, candidate", look: figure\Look.store)
        .actor(gate)
        .edgesFromGraph()
        .hideEdges([engine], dst: [types], why: "every queue package uses the records; one arrow from the engine is enough")
        .flowAcross(intent, dst: queue, label: "intent")
        .flowIn(queue, dst: engine, label: "plan")
        .flowOut(engine, dst: gate, label: "candidate")
        .flowAcross(queue, dst: apply, label: "passed")
        .flowIn(apply, dst: provider, label: "merge")
        .legend(figure\Look.focal, label: "the decisions")
        .legend(figure\Look.input, label: "starts the flow")
        .legend(figure\Look.store, label: "records")
        .scope([engine, provider, client, types]);
}
