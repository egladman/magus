namespace inputsOutputs;

import "magus";
import "magus/figure";
import "site/diagrams/packages" as _;

export fun inputsOutputsFigure() > figure\Figure !> any {
    // NestedDirs narrows a snapshot here, never the key.
    final cache = magus\dir("internal/cache");
    final audit = magus\dir("internal/audit");
    // types/workspace.go: a nested project owns its files.
    final claims = magus\dir("types");
    final reads = figure\external("readsFiles(\"**/*.go\")", sub: "matches nested files too", tag: "root", look: figure\Look.plain);
    final writes = figure\external("writesFiles(\"**/gen/mocks/*.go\")", sub: "the root's gen/ only", tag: "root", look: figure\Look.plain);
    // describe.go joins a cross-project input's owner to DependsOn.
    final handle = figure\external("workspace\\file(...)", sub: "the root's tree, as upstream", tag: "docs", look: figure\Look.plain);
    final probe = figure\external("Tool probe", sub: "the version, or UNPROBED", look: figure\Look.plain);
    return figure\of("inputs-outputs",
            title: "An output stops at a nested project; an input does not",
            eyebrow: "inputs and outputs",
            desc: "A target's ctx.readsFiles and ctx.writesFiles globs resolve from its own "
                + "project's directory. The source walk matches every file a glob names, so the "
                + "root's **/*.go keys every nested Go file too. An output glob claims a file "
                + "inside a nested project only when the glob is rooted there; the snapshot, "
                + "the replay and the drift gate all ask the same rule, and a write that lands "
                + "there anyway fails the run as MGS3001. A nested project reads the root's "
                + "tree through a project handle, workspace\\file, which also makes the root "
                + "its upstream. The matched files and the probed tool versions are the key; an "
                + "input nobody declared never reaches it.")
        .actor(reads)
        .actor(writes)
        .actor(handle)
        .box(audit, label: "Descendant audit", sub: "MGS3001 on a write inside")
        .actor(probe)
        .box(cache, label: "Cache key", sub: "source walk, key, snapshot", focal: true)
        .box(claims, label: "Output claim", sub: "stops at a nested dir")
        .edgesFromGraph()
        .hideEdges([audit], dst: [claims],
            why: "the audit reads the same claim rule; the figure draws it from the snapshot")
        .flowIn(reads, dst: cache, label: "src:")
        .flowIn(handle, dst: cache, label: "+ depends_on", stroke: figure\Stroke.focal)
        .flowIn(probe, dst: cache, label: "tool:")
        .flowIn(writes, dst: cache, label: "snapshot")
        .flowIn(writes, dst: audit, label: "stray write", stroke: figure\Stroke.optional)
        .zone("root project .", actors: [reads, writes])
        .zone("a nested project", dirs: [audit], actors: [handle])
        .zone("the cache", dirs: [cache, claims], actors: [probe])
        .legend(figure\Look.focal, label: "what a hit is keyed on")
        .scope(goPackages("internal/cache/**"))
        .scope(goPackages("internal/audit/**"))
        .scope(goPackages("types/**"))
        .except([magus\dir("internal/cache/reflink")],
            why: "copies files in and out of the store; it reads no glob and keys nothing")
        .except([magus\dir("internal/cache/remotetest")], why: "a fake remote cache for tests")
        .except([magus\dir("types/enum")],
            why: "the closed string sets every package checks values against; no claim rule")
        .except([magus\dir("types/gen/mocks")], why: "generated test mocks");
}
