namespace agentOrchestration;

import "magus";
import "magus/figure";

export fun agentOrchestrationFigure() > figure\Figure !> any {
    final store = magus\graph().dir("internal/job");
    final guard = magus\graph().dir("internal/guard");
    final broker = magus\graph().dir("broker");
    final sandbox = magus\graph().dir("internal/sandbox");
    final landlock = magus\graph().dir("libs/safetyscissors/sandbox/filesystem");
    final vcs = magus\graph().dir("vcs");
    final root = figure\external("Orchestrator", sub: "the root session");
    final worker = figure\external("Worker", sub: "one row, one check");
    final integrator = figure\external("Integrator", sub: "<parent>/integrate");
    return figure\of("agent-orchestration",
            title: "Three roles, one store, and a guard at every boundary",
            eyebrow: "orchestration",
            direction: figure\Direction.down,
            desc: "The orchestrator forks job rows into one store and waits on them. Each worker "
                + "holds one row: its write paths, check and checkout. The integrator merges "
                + "finished branches and runs the checks. The guard reads the row on every call, "
                + "the sandbox narrows a run's writes to it, and the broker holds the machine's one "
                + "build budget.")
        .actor(root)
        .actor(worker)
        .actor(integrator)
        .box(store, label: "Job store", sub: "jobs.jsonl, one per repo", look: figure\Look.store)
        .box(guard, label: "Guard", sub: "every write and command", focal: true)
        .group([sandbox, landlock], label: "Sandbox", sub: "write grant, landlock applies it")
        .box(broker, label: "Broker", sub: "one machine budget")
        .box(vcs, label: "vcs", sub: "checkpoint, merge")
        .edgesFromGraph()
        .markEdge(guard, dst: store, label: "lease")
        .markEdge(guard, dst: broker, label: "seats")
        .flowIn(root, dst: store, label: "fork, wait")
        .flowAcross(root, dst: worker, label: "./magus, exec")
        .flowIn(worker, dst: guard, label: "each call")
        .flowIn(integrator, dst: guard, label: "merge, build")
        .zone("the roles", actors: [root, worker, integrator])
        .zone("what magus holds and enforces", dirs: [store, guard, sandbox, landlock, broker, vcs])
        .legend(figure\Look.focal, label: "the one enforcer")
        .legend(figure\Look.store, label: "the declared rows")
        .legend(figure\Look.external, label: "agent sessions")
        .scope([store, guard, sandbox, landlock, broker, vcs]);
}
