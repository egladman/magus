namespace harnessPyramid;

import "magus";
import "magus/diagram";

export fun harnessPyramidDiagram() > diagram\Diagram !> any {
    final person = diagram\person("Person", sub: "decides, pays");
    final outer = diagram\step("Outer harness", sub: "magus: guard, leases, jobs", look: diagram\Look.focal);
    final inner = diagram\step("Inner harness", sub: "agent loop: Claude Code, Codex");
    final model = diagram\external("Model", sub: "proposes the next action", look: diagram\Look.plain);
    return diagram\of("harness-pyramid",
            title: "The model proposes, the harness executes",
            eyebrow: "design",
            desc: "Four layers, top to bottom. The person writes the guard rules, forks the jobs "
                + "and prompts the agent. The outer harness, magus, judges every call the inner "
                + "harness makes and answers from the workspace record. The inner harness, the "
                + "host's agent loop, sends the model its context and executes the tool calls "
                + "the model proposes. The model only proposes.",
            direction: diagram\Direction.down)
        .flowAcross(person, dst: outer, label: "rules, jobs")
        .flowAcross(person, dst: inner, label: "prompts")
        .flowAcross(outer, dst: inner, label: "verdicts")
        .flowAcross(inner, dst: model, label: "context")
        .legend(diagram\Look.focal, label: "magus")
        .legend(diagram\Look.plain, label: "proposes only")
        .unscoped(why: "a division of work between a person, two harness layers and a model, not a Go package");
}

export fun harnessStackDiagram() > diagram\Diagram !> any {
    final store = magus\graph().dir("internal/job");
    final guard = magus\graph().dir("internal/guard");
    final graph = magus\graph().dir("internal/graph/workspacegraph");
    final person = diagram\person("Person", sub: "forks, reviews");
    final claude = diagram\external("Claude Code", sub: "inner harness");
    final codex = diagram\external("Codex", sub: "inner harness");
    return diagram\of("harness-stack",
            title: "Two inner harnesses never talk; the outer harness's records join them",
            eyebrow: "design",
            desc: "The person writes the guard rules and forks job rows into the job store. Claude "
                + "Code and Codex each take a row with magus job exec, return it with magus job "
                + "exit, and send every call through the guard, which reads the row and the "
                + "workspace graph. The two loops never talk; the records are what they share.",
            direction: diagram\Direction.down)
        .actor(person)
        .actor(claude)
        .actor(codex)
        .box(guard, label: "Guard", sub: "allow, deny, advise", focal: true)
        .box(store, label: "Job store", sub: "jobs.jsonl", look: diagram\Look.store)
        .box(graph, label: "Workspace graph", sub: "inputs, outputs, deps")
        .edgesFromGraph()
        .flowIn(person, dst: guard, label: "rules")
        .flowIn(person, dst: store, label: "forks jobs")
        .flowOut(guard, dst: claude, label: "verdicts")
        .flowOut(guard, dst: codex, label: "verdicts")
        .flowOut(store, dst: claude, label: "exec, exit")
        .flowOut(store, dst: codex, label: "exec, exit")
        .rank(dirs: [guard, graph])
        .rank(actors: [claude, codex])        .zone("inner harnesses", actors: [claude, codex])
        .zone("outer harness: magus", dirs: [guard, store, graph])
        .legend(diagram\Look.focal, label: "the one enforcer")
        .legend(diagram\Look.store, label: "the shared rows")
        .legend(diagram\Look.external, label: "outside magus")
        .scope([guard, store, graph]);
}
