namespace harnessPyramid;

import "magus";
import "magus/figure";

export fun harnessPyramidFigure() > figure\Figure !> any {
    final person = figure\external("Person", sub: "decides, pays");
    final outer = figure\external("Outer harness", sub: "magus: guard, leases, jobs", look: figure\Look.focal);
    final inner = figure\external("Inner harness", sub: "agent loop: Claude Code, Codex");
    final model = figure\external("Model", sub: "proposes the next action", look: figure\Look.plain);
    return figure\of("harness-pyramid",
            title: "The model proposes, the harness executes",
            eyebrow: "design",
            desc: "Four layers, top to bottom. The person writes the guard rules, forks the jobs "
                + "and prompts the agent. The outer harness, magus, judges every call the inner "
                + "harness makes and answers from the workspace record. The inner harness, the "
                + "host's agent loop, sends the model its context and executes the tool calls "
                + "the model proposes. The model only proposes.",
            direction: figure\Direction.down)
        .flowAcross(person, dst: outer, label: "rules, jobs")
        .flowAcross(person, dst: inner, label: "prompts")
        .flowAcross(outer, dst: inner, label: "verdicts")
        .flowAcross(inner, dst: model, label: "context")
        .legend(figure\Look.focal, label: "magus")
        .legend(figure\Look.plain, label: "proposes only")
        .unscoped(why: "a division of work between a person, two harness layers and a model, not a Go package");
}

export fun harnessStackFigure() > figure\Figure !> any {
    final store = magus\graph().dir("internal/job");
    final guard = magus\graph().dir("internal/guard");
    final graph = magus\graph().dir("internal/graph/workspacegraph");
    final person = figure\external("Person", sub: "forks, reviews");
    final claude = figure\external("Claude Code", sub: "inner harness");
    final codex = figure\external("Codex", sub: "inner harness");
    return figure\of("harness-stack",
            title: "Two inner harnesses, one outer harness, shared records",
            eyebrow: "design",
            desc: "Top to bottom: the person, the outer harness, the inner harnesses. The person "
                + "writes the guard rules and forks job rows into the job store. Claude Code and "
                + "Codex each take a row with magus job exec and return it with magus job exit, "
                + "and send every call through the guard, which reads the row and the workspace "
                + "graph and answers with a verdict. The two loops never talk to each other; the "
                + "records are what they share.",
            direction: figure\Direction.down)
        .actor(person)
        .actor(claude)
        .actor(codex)
        .box(guard, label: "Guard", sub: "allow, deny, advise", focal: true)
        .box(store, label: "Job store", sub: "jobs.jsonl", look: figure\Look.store)
        .box(graph, label: "Workspace graph", sub: "inputs, outputs, deps")
        .edgesFromGraph()
        .flowIn(person, dst: guard, label: "rules")
        .flowIn(person, dst: store, label: "forks jobs")
        .flowOut(guard, dst: claude, label: "verdicts")
        .flowOut(guard, dst: codex, label: "verdicts")
        .flowOut(store, dst: claude, label: "exec, exit")
        .flowOut(store, dst: codex, label: "exec, exit")
        .rank(dirs: [guard, graph])
        .rank(actors: [claude, codex])        .zone("inner harnesses", actors: [claude, codex])
        .zone("outer harness: magus", dirs: [guard, store, graph])
        .legend(figure\Look.focal, label: "the one enforcer")
        .legend(figure\Look.store, label: "the shared rows")
        .legend(figure\Look.external, label: "outside magus")
        .scope([guard, store, graph]);
}
