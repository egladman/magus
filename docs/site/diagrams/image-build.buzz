// site/diagrams/image-build.buzz - which registries and tags an image-build run touches, as a
// function of the charms stacked on it. The first diagram to use the decision shape: two
// diamonds, each with one connector per vertex, which is all a diamond has room for.
namespace imageBuild;

import "../libs/diagram/diagram" as _;
import "../libs/diagram/flow" as _;

export fun imageBuildDiagram() > Diagram !> str {
    return flow("image-build")
        .eyebrow("recommendations")
        .title("What a bare run pushes, and what each channel adds")
        .desc("Without the cd charm an image-build loads locally and pushes nothing. With "
            + "it, the channel decides: the default commit channel adds one immutable tag "
            + "to one registry, and only stable moves the floating latest tag.")
        .node("run", label: "magus run image-build", role: "focal")
        .node("cd", label: "cd?", role: "decision")
        .node("local", label: "Load locally", sub: "pushes nothing")
        .node("channel", label: "channel", role: "decision")
        .node("commit", label: "Commit", sub: "ghcr, tagged by hash")
        .node("unstable", label: "Prerelease", sub: "no floating tag")
        .node("stable", label: "Release", sub: "version and latest")
        .edge("run", dst: "cd")
        .edge("cd", dst: "local", label: "no")
        .edge("cd", dst: "channel", label: "yes")
        .edge("channel", dst: "commit", label: "default")
        .edge("channel", dst: "unstable", label: "unstable")
        .edge("channel", dst: "stable", label: "stable")
        // A spell's decision process, not a Go package.
        .scope([<str>])
        .diagram();
}
