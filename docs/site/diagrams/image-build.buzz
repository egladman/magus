namespace imageBuild;

import "magus/figure";

export fun imageBuildFigure() > figure\Figure !> any {
    final run = figure\external("magus run image-build", look: figure\Look.focal);
    // Each diamond takes one connector per vertex, all the room a diamond has.
    final cd = figure\external("cd?", look: figure\Look.decision);
    final local = figure\external("Load locally", sub: "pushes nothing", look: figure\Look.plain);
    final channel = figure\external("channel", look: figure\Look.decision);
    final commit = figure\external("Commit", sub: "ghcr, tagged by hash", look: figure\Look.plain);
    final unstable = figure\external("Prerelease", sub: "no floating tag", look: figure\Look.plain);
    final stable = figure\external("Release", sub: "version and latest", look: figure\Look.plain);
    return figure\of("image-build",
            title: "What a bare run pushes, and what each channel adds",
            eyebrow: "recommendations",
            desc: "Without the cd charm an image-build loads locally and pushes nothing. With "
                + "it, the channel decides: the default commit channel adds one immutable tag "
                + "to one registry, and only stable moves the floating latest tag.")
        .flowAcross(run, dst: cd)
        .flowAcross(cd, dst: local, label: "no")
        .flowAcross(cd, dst: channel, label: "yes")
        .flowAcross(channel, dst: commit, label: "default")
        .flowAcross(channel, dst: unstable, label: "unstable")
        .flowAcross(channel, dst: stable, label: "stable")
        .unscoped(why: "a spell's decision process, not a Go package");
}
