namespace buzzEngine;

import "magus";
import "magus/figure";
import "site/diagrams/packages" as packages;
import "site/diagrams/buzz-stages" as buzzStages;

export fun buzzEngineFigure() > figure\Figure !> any {
    final session = magus\graph().dir("libs/gopherbuzz");
    final pipeline = [
        session,
        magus\graph().dir("libs/gopherbuzz/token"),
        magus\graph().dir("libs/gopherbuzz/ast"),
        magus\graph().dir("libs/gopherbuzz/types"),
        magus\graph().dir("libs/gopherbuzz/vm"),
    ];
    final engine = magus\graph().dir("internal/interp");
    final bindings = magus\graph().dir("internal/interp/bindings");
    final opencode = magus\graph().dir("internal/interp/bindings/opencode");
    final opencodeWasm = magus\graph().dir("internal/interp/bindings/opencode/wasm");
    final trampolines = magus\graph().dir("internal/interp/bindings/gen");
    final hostModules = magus\graph().dir("std");
    final buzzStdlib = magus\graph().dir("libs/gopherbuzz/std");
    final dry = magus\graph().dir("internal/dry");
    final playground = figure\external("Browser playground", sub: "js/wasm editor", tag: "client", look: figure\Look.plain);
    return figure\of("buzz-engine",
            title: "One pipeline, and the modules each host registers",
            eyebrow: "buzz",
            desc: "Every Buzz program magus touches goes through the same gopherbuzz pipeline: lex, "
                + "parse, check, compile, run. Hosts differ only in the modules they register first. "
                + "The host bindings attach to the magusfile engine at init and provide every magus "
                + "host module, each through the trampoline generated from its descriptor. The "
                + "browser playground runs the dry evaluator, which installs only the trampolines "
                + "marked WASM, pure compute with no filesystem, process or network access, and "
                + "records host calls instead of running them. Both also install the Buzz stdlib.")
        .box(bindings, label: "Host bindings", sub: "magus namespace, init()")
        .box(opencode, label: "OpenCode binding", sub: "plugin, runtime")
        .box(opencodeWasm, label: "OpenCode WASM", sub: "main, plugin")
        .box(engine, label: "Magusfile engine", sub: "load magusfiles, run targets")
        .group(pipeline, label: "gopherbuzz", sub: "lex, parse, check, compile, run")
        .box(trampolines, label: "Trampolines", sub: "every module, plus a WASM set")
        .box(hostModules, label: "Host modules", sub: "fs, vcs, proc, http, json")
        .actor(playground)
        .box(dry, label: "Dry evaluator", sub: "records host calls", focal: true)
        .edgesFromGraph()
        .hideEdges([bindings, trampolines, hostModules], dst: pipeline,
            why: "modules and bindings pass vm and gopherbuzz values; a program reaches the pipeline through the engine or the dry evaluator")
        .hideEdges([engine, bindings, dry], dst: [hostModules],
            why: "they read module descriptors and std.WithCwd; every module is wired through its trampoline")
        .markEdge(engine, dst: session)
        .markEdge(bindings, dst: engine, label: "init()")
        .markEdge(bindings, dst: trampolines)
        .markEdge(dry, dst: trampolines, stroke: figure\Stroke.focal)
        .markEdge(dry, dst: session)
        .flowIn(playground, dst: dry, label: "runs")
        .rank(dirs: [opencodeWasm, opencode, bindings])
        .row(dirs: [dry, trampolines])
        .legend(figure\Look.focal, label: "the browser's subset")
        .scope(buzzStages\gopherbuzzPackages())
        .scope(packages\goPackages("internal/interp/**"))
        .scope(packages\goPackages("internal/dry/**"))
        .scope(packages\goPackages("std/**"))
        .except([buzzStdlib, magus\graph().dir("libs/gopherbuzz/internal/codec")],
            why: "the Buzz stdlib and its JSON codec: both hosts install them the same way, so they tell the two apart in nothing")
        .except(buzzStages\gopherbuzzAround(), why: buzzStages\AROUND_WHY)
        .except([magus\graph().dir("internal/interp/bindings/ffi"), magus\graph().dir("internal/interp/bindings/gen/decode"),
                magus\graph().dir("internal/interp/bindings/gen/providerops")],
            why: "the register call, the generated argument decoders and the generated provider-call values every trampoline uses")
        .except([magus\graph().dir("internal/interp/engine"), magus\graph().dir("internal/interp/engine/buzz")],
            why: "the generic engine interface and its buzz adapter; the magusfile engine drives the session directly")
        .except([magus\graph().dir("internal/interp/mcpclient"), magus\graph().dir("internal/interp/transform")],
            why: "the MCP client and transform workers run Buzz apart from the two hosts compared here")
        .except(packages\goPackages("std/encoding/**"),
            why: "the encoding host modules, wired through the trampolines like every module in the Host modules box")
        .except(packages\goPackages("std/termkit/**"),
            why: "the termkit host modules, wired through the trampolines like every module in the Host modules box");
}
