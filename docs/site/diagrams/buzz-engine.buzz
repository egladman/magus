namespace buzzEngine;

import "magus";
import "magus/figure";
import "site/diagrams/buzz-stages" as _;

export fun buzzEngineFigure() > figure\Figure !> any {
    final session = magus\dir("libs/gopherbuzz");
    final pipeline = figure\setOf([
        session,
        magus\dir("libs/gopherbuzz/token"),
        magus\dir("libs/gopherbuzz/ast"),
        magus\dir("libs/gopherbuzz/types"),
        magus\dir("libs/gopherbuzz/vm"),
    ]);
    final engine = magus\dir("internal/interp");
    final bindings = magus\dir("internal/interp/bindings");
    final trampolines = magus\dir("internal/interp/bindings/gen");
    final hostModules = magus\dir("std");
    final buzzStdlib = magus\dir("libs/gopherbuzz/std");
    final dry = magus\dir("internal/dry");
    final goOnly = magus\DirsOptions{ language = "go" };
    final playground = figure\external("Browser playground", sub: "js/wasm editor", tag: "client", look: figure\Look.plain);
    return figure\of("buzz-engine",
            title: "One pipeline, and the modules each host registers",
            eyebrow: "buzz",
            desc: "Every Buzz program magus touches goes through the same gopherbuzz pipeline: lex, "
                + "parse, check, compile, run. Hosts differ only in the modules they register first. "
                + "The host bindings attach to the magusfile engine at init and provide every magus "
                + "host module, each through the trampoline generated from its descriptor. The "
                + "browser playground runs the dry evaluator, which installs only the trampolines "
                + "marked WASM, pure compute with no filesystem, process or network access, and "
                + "records host calls instead of running them. Both also install the Buzz stdlib.")
        .box(bindings, label: "Host bindings", sub: "magus namespace, init()")
        .box(engine, label: "Magusfile engine", sub: "load magusfiles, run targets")
        .group(pipeline, label: "gopherbuzz", sub: "lex, parse, check, compile, run")
        .box(trampolines, label: "Trampolines", sub: "every module, plus a WASM set")
        .box(hostModules, label: "Host modules", sub: "fs, vcs, proc, http, json")
        .actor(playground)
        .box(dry, label: "Dry evaluator", sub: "records host calls", focal: true)
        .edgesFromGraph()
        .hideEdges(figure\setOf([bindings, trampolines, hostModules]), dst: pipeline,
            why: "modules and bindings pass vm and gopherbuzz values; a program reaches the pipeline through the engine or the dry evaluator")
        .hideEdges(figure\setOf([engine, bindings, dry]), dst: figure\setOf([hostModules]),
            why: "they read module descriptors and std.WithCwd; every module is wired through its trampoline")
        .markEdge(engine, dst: session, label: "magusfile")
        .markEdge(bindings, dst: engine, label: "init()")
        .markEdge(bindings, dst: trampolines, label: "every module")
        .markEdge(dry, dst: trampolines, label: "WASM set", stroke: figure\Stroke.focal)
        .markEdge(dry, dst: session, label: "editor source")
        .flowIn(playground, dst: dry, label: "runs")
        .legend(figure\Look.focal, label: "the browser's subset")
        .scope(gopherbuzzPackages())
        .scope(figure\setOf(magus\dirs("internal/interp/**", opts: goOnly)))
        .scope(figure\setOf(magus\dirs("internal/dry/**", opts: goOnly)))
        .scope(figure\setOf(magus\dirs("std/**", opts: goOnly)))
        .except(figure\setOf([buzzStdlib, magus\dir("libs/gopherbuzz/internal/codec")]),
            why: "the Buzz stdlib and its JSON codec: both hosts install them the same way, so they tell the two apart in nothing")
        .except(gopherbuzzAround(), why: AROUND_WHY)
        .except(figure\setOf([magus\dir("internal/interp/bindings/ffi"), magus\dir("internal/interp/bindings/gen/decode")]),
            why: "the register call and the generated argument decoders every trampoline uses")
        .except(figure\setOf([magus\dir("internal/interp/engine"), magus\dir("internal/interp/engine/buzz")]),
            why: "the generic engine interface and its buzz adapter; the magusfile engine drives the session directly")
        .except(figure\setOf([magus\dir("internal/interp/mcpclient"), magus\dir("internal/interp/transform")]),
            why: "the MCP client and transform workers run Buzz apart from the two hosts compared here")
        .except(figure\setOf([magus\dir("internal/dry/gen/mocks")]), why: "generated test mocks")
        .except(figure\setOf([
            magus\dir("std/encoding"),
            magus\dir("std/encoding/base64"),
            magus\dir("std/encoding/csv"),
            magus\dir("std/encoding/hex"),
            magus\dir("std/encoding/ini"),
            magus\dir("std/encoding/json"),
            magus\dir("std/encoding/toml"),
            magus\dir("std/encoding/url"),
            magus\dir("std/encoding/xml"),
            magus\dir("std/encoding/yaml"),
        ]),
            why: "the encoding host modules, wired through the trampolines like every module in the Host modules box");
}
