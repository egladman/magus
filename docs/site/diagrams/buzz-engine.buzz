// site/diagrams/buzz-engine.buzz: how a Buzz program runs, and what decides what it can
// reach.
//
// The figure has one claim: every host runs the same gopherbuzz pipeline, and a host
// differs only in the modules it registers. The magusfile engine gets every host module;
// the browser playground gets the WASM-safe subset and nothing else. The accent pair (the
// generated module sets, their connector to the host modules) is spent on that subset.
//
// Parse, check and compile are the one libs/gopherbuzz package. The playground is a js/wasm
// build the symbol index does not read, so it is an actor. Every other connector is an
// import; the hidden ones carry value types, not a stage.
namespace buzzEngine;

import "magus";
import "magus/figure";

export fun buzzEngineFigure() > figure\Figure !> any {
    final engine = magus\dir("internal/interp");
    final bindings = magus\dir("internal/interp/bindings");
    final sets = magus\dir("internal/interp/bindings/gen");
    final hostModules = magus\dir("std");
    final pipeline = magus\dir("libs/gopherbuzz");
    final vm = magus\dir("libs/gopherbuzz/vm");
    final playground = figure\external("Browser playground", sub: "js/wasm editor, REPL", tag: "client", look: figure\Look.plain);
    final valueTypes = "every binding and module passes vm and gopherbuzz values; the program reaches them through the pipeline";
    return figure\of("buzz-engine")
        .eyebrow("buzz")
        .title("One pipeline, and the modules each host registers")
        .desc("gopherbuzz parses Buzz source, type-checks it, compiles it to bytecode and "
            + "runs it on its VM, the same way for a magusfile, a spell, a magus buzz "
            + "script and the browser playground. The host bindings register magus's host "
            + "modules at init, through the trampolines generated from each module's "
            + "descriptor. The playground's wasm build installs only the modules marked "
            + "WASM: pure compute, with no filesystem, process or network access.")
        .box(engine, label: "Magusfile engine", sub: "load, cache, run targets")
        .box(bindings, label: "Host bindings", sub: "magus namespace, init()")
        .box(hostModules, label: "Host modules", sub: "fs, vcs, proc, http, json")
        .box(pipeline, label: "Parse, check, compile", sub: "tokens to flat bytecode")
        .box(vm, label: "VM", sub: "register window, JIT")
        .actor(playground)
        .box(sets, label: "Module sets", sub: "WASM: pure compute only", focal: true)
        .edgesFromGraph()
        .hideEdges(figure\setOf([bindings, sets, hostModules]), dst: figure\setOf([vm, pipeline]),
            why: valueTypes)
        .hideEdges(figure\setOf([engine]), dst: figure\setOf([vm]),
            why: "the engine reads vm.Value results and heap stats; programs reach the VM through the pipeline")
        .hideEdges(figure\setOf([engine]), dst: figure\setOf([hostModules]),
            why: "one call, std.WithCwd, pins a target's working directory; the modules arrive through the bindings")
        .markEdge(engine, dst: pipeline, label: "magusfile")
        .markEdge(bindings, dst: engine, label: "init()")
        .markEdge(bindings, dst: hostModules, label: "every module")
        .markEdge(sets, dst: hostModules, label: "WASM-safe only", stroke: figure\Stroke.focal)
        .markEdge(pipeline, dst: vm, label: "bytecode")
        .flowIn(playground, dst: pipeline, label: "editor source")
        .flowIn(playground, dst: sets, label: "installs")
        .zone("gopherbuzz", dirs: figure\setOf([pipeline, vm]))
        .zone("magus as host", dirs: figure\setOf([engine, bindings, hostModules]))
        .boundary("the browser, js/wasm", dirs: figure\setOf([sets]), actors: [playground])
        .legend(figure\Look.focal, label: "the browser's subset")
        .scope(figure\setOf([pipeline, vm, engine, bindings, hostModules]));
}
