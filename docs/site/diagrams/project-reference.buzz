// site/diagrams/project-reference.buzz - the four spellings of a project reference magus
// accepts, and the two it emits. The figure exists to make one point: input is forgiving
// and output is not, so an agent can pass whatever it has and still get a stable string
// back to key on.
namespace projectReference;

import "../libs/diagram/diagram" as _;
import "../libs/diagram/flow" as _;

export fun projectReferenceDiagram() > Diagram !> str {
    return flow("project-reference")
        .eyebrow("agents")
        .title("Four spellings in, one reference out")
        .desc("magus accepts a workspace URL, a workspace-relative path, a dot-relative "
            + "path or the bare root alias, and parses them all to one project reference. "
            + "Human output prints the short path; machine output prints the workspace URL.")
        .node("url", label: "workspace://pkg/api")
        .node("rel", label: "pkg/api")
        .node("dot", label: "./pkg/api")
        .node("root", label: "workspace://", sub: "the root alias")
        .node("parse", tag: "step")
        .node("ref", label: "One reference", sub: "path: pkg/api", role: Role.focal)
        .node("human", label: "Human output", sub: "pkg/api")
        .node("machine", label: "Machine output", sub: "workspace://pkg/api")
        .edge("rel", dst: "parse")
        .edge("dot", dst: "parse")
        .edge("url", dst: "parse")
        .edge("root", dst: "parse")
        .edge("parse", dst: "ref")
        .edge("ref", dst: "human", label: "printed")
        .edge("ref", dst: "machine", label: "-o json")
        .zone("accepted as input, interchangeable", members: ["url", "rel", "dot", "root"])
        .legend(Role.focal, label: "one canonical form")
        .unscoped("an input and output contract, drawn with no anchors to hold a scope to")
        .diagram();
}
