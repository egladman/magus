// site/diagrams/project-reference.buzz: the four spellings of a project reference magus
// accepts, and the two it emits. The figure exists to make one point: input is forgiving
// and output is not, so an agent can pass whatever it has and still get a stable string
// back to key on.
namespace projectReference;

import "magus/figure";

export fun projectReferenceFigure() > figure\Figure !> any {
    final url = figure\external("workspace://pkg/api", look: figure\Look.plain);
    final rel = figure\external("pkg/api", look: figure\Look.plain);
    final dot = figure\external("./pkg/api", look: figure\Look.plain);
    final root = figure\external("workspace://", sub: "the root alias", look: figure\Look.plain);
    final parse = figure\external("parse", tag: "step", look: figure\Look.plain);
    final ref = figure\external("One reference", sub: "path: pkg/api", look: figure\Look.focal);
    final human = figure\external("Human output", sub: "pkg/api", look: figure\Look.plain);
    final machine = figure\external("Machine output", sub: "workspace://pkg/api", look: figure\Look.plain);
    return figure\of("project-reference",
            title: "Four spellings in, one reference out",
            eyebrow: "agents",
            desc: "magus accepts a workspace URL, a workspace-relative path, a dot-relative "
                + "path or the bare root alias, and parses them all to one project reference. "
                + "Human output prints the short path; machine output prints the workspace URL.")
        .actor(url)
        .actor(rel)
        .actor(dot)
        .actor(root)
        .flowAcross(rel, dst: parse)
        .flowAcross(dot, dst: parse)
        .flowAcross(url, dst: parse)
        .flowAcross(root, dst: parse)
        .flowAcross(parse, dst: ref)
        .flowAcross(ref, dst: human, label: "printed")
        .flowAcross(ref, dst: machine, label: "-o json")
        .zone("accepted as input, interchangeable", actors: [url, rel, dot, root])
        .legend(figure\Look.focal, label: "one canonical form")
        .unscoped(why: "an input and output contract, drawn with no directory to hold a scope to");
}
