namespace projectReference;

import "magus/diagram";
import "result";

export fun projectReferenceDiagram() > result\Result::<diagram\Diagram> {
    try {
        final url = diagram\step("workspace://pkg/api", look: diagram\Look.plain);
        final rel = diagram\step("pkg/api", look: diagram\Look.plain);
        final dot = diagram\step("./pkg/api", look: diagram\Look.plain);
        final root = diagram\step("workspace://", sub: "the root alias", look: diagram\Look.plain);
        final parse = diagram\step("parse", tag: "step", look: diagram\Look.plain);
        final ref = diagram\step("One reference", sub: "path: pkg/api", look: diagram\Look.focal);
        final human = diagram\step("Human output", sub: "pkg/api", look: diagram\Look.plain);
        final machine = diagram\step("Machine output", sub: "workspace://pkg/api", look: diagram\Look.plain);
        return result\ok::<diagram\Diagram>(diagram\of("project-reference",
                title: "Four spellings in, one reference out",
                eyebrow: "agents",
                desc: "magus accepts a workspace URL, a workspace-relative path, a dot-relative "
                    + "path or the bare root alias, and parses them all to one project reference. "
                    + "Human output prints the short path; machine output prints the workspace URL.")
            .actor(url)
            .actor(rel)
            .actor(dot)
            .actor(root)
            .flowAcross(rel, dst: parse)
            .flowAcross(dot, dst: parse)
            .flowAcross(url, dst: parse)
            .flowAcross(root, dst: parse)
            .flowAcross(parse, dst: ref)
            .flowAcross(ref, dst: human, label: "printed")
            .flowAcross(ref, dst: machine, label: "-o json")
            .zone("accepted as input, interchangeable", actors: [url, rel, dot, root])
            .legend(diagram\Look.focal, label: "one canonical form")
            .unscoped(why: "an input and output contract, drawn with no directory to hold a scope to"));
    } catch (err: any) {
        return result\caught::<diagram\Diagram>(err);
    }
}
