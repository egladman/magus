namespace workspaceLoad;

import "magus";
import "magus/figure";
import "site/diagrams/packages" as _;

export fun workspaceLoadFigure() > figure\Figure !> any {
    final discover = magus\dir("project");
    final interp = magus\dir("internal/interp");
    final extract = magus\dir("internal/describe");
    final model = magus\dir("types");
    final cache = magus\dir("internal/cache");
    final root = magus\dir(".");
    final rootMf = figure\external("Root magusfile", sub: "declares project .", look: figure\Look.input);
    final nestedMf = figure\external("Nested magusfiles", sub: "docs/, proto/, libs/*", look: figure\Look.input);
    final steps = figure\setOf([discover, interp, extract, cache]);
    return figure\of("workspace-load",
            title: "A target exists because a magusfile exported it",
            eyebrow: "workspace",
            desc: "Discovery walks the tree from the root marker and registers one project per "
                + "magusfile: the root's is project ., each nested one declares its own. Every "
                + "magusfile is evaluated: its exported functions are its targets and "
                + "magus\\project layers policy on. A static read of each target body recovers "
                + "ctx.readsFiles, ctx.writesFiles and cross-project ctx.needs as literals. The "
                + "project model that results is what the cache keys, what describe answers "
                + "from, and what a command resolves its project against from the current "
                + "directory.")
        .actor(rootMf)
        .actor(nestedMf)
        .box(discover, label: "Projects", sub: "discovery, Where(cwd)")
        .box(interp, label: "Evaluate", sub: "export fun is a target")
        .box(extract, label: "Static read", sub: "literal reads, writes, needs")
        .box(model, label: "Projects and targets", sub: "sources, outputs, depends_on", focal: true)
        .box(cache, label: "Cache key", sub: "one step per target")
        .box(root, label: "magus describe", sub: "targets, claims, the graph")
        .edgesFromGraph()
        .hideEdges(figure\setOf([root]), dst: steps,
            why: "the root package runs the load; its calls into each step are the order, not the model")
        .hideEdges(figure\setOf([interp, cache]), dst: figure\setOf([discover]),
            why: "they read project options and project paths; the model they fill is types")
        .markEdge(interp, dst: model, label: "targets")
        .markEdge(extract, dst: model, label: "footprints")
        .flowIn(rootMf, dst: discover, label: "registers .")
        .flowIn(nestedMf, dst: discover, label: "registers dir")
        .zone("written by hand", actors: [rootMf, nestedMf])
        .legend(figure\Look.focal, label: "what every reader reads")
        .legend(figure\Look.input, label: "the only declarations")
        .scope(goPackages("project/**"))
        .scope(goPackages("internal/interp/**"))
        .scope(goPackages("internal/describe/**"))
        .scope(goPackages("types/**"))
        .scope(goPackages("internal/cache/**"))
        .except(figure\setOf([magus\dir("project/impact")]),
            why: "the blast radius of a changeset, which affected reads after the load")
        .except(figure\setOf([
            magus\dir("internal/interp/bindings"),
            magus\dir("internal/interp/bindings/ffi"),
            magus\dir("internal/interp/bindings/gen"),
            magus\dir("internal/interp/bindings/gen/decode"),
            magus\dir("internal/interp/engine"),
            magus\dir("internal/interp/engine/buzz"),
            magus\dir("internal/interp/mcpclient"),
            magus\dir("internal/interp/transform"),
        ]),
            why: "the engine seam, host bindings, MCP client and transforms an evaluation calls through; the Evaluate box is where an export becomes a target")
        .except(figure\setOf([magus\dir("types/enum")]),
            why: "the closed string sets every package checks values against; no part of the project model")
        .except(figure\setOf([magus\dir("internal/cache/reflink"), magus\dir("internal/cache/remotetest")]),
            why: "copying files in and out of the store, and a fake remote cache for tests; the key is computed in internal/cache")
        .except(figure\setOf([magus\dir("project/impact/gen/mocks"), magus\dir("types/gen/mocks")]),
            why: "generated test mocks");
}
