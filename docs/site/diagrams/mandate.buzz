namespace mandatefigures;

import "magus/figure";

// mandateRolesFigure is ADR 0019's division of acts: the person decides, what they decide
// is written down, the guard enforces it on every call, and the root and its workers do the
// work. The workers' hand-back that wakes the root is left out to stay in the connector
// budget; the ADR's text says it.
export fun mandateRolesFigure() > figure\Figure !> any {
    final person = figure\external("Person", sub: "decides", look: figure\Look.focal);
    final plan = figure\external("Plan", sub: "job rows", look: figure\Look.store);
    final mandate = figure\external("Mandate", sub: "raises the bar", look: figure\Look.store);
    final grant = figure\external("Grant", sub: "lowers one rule", look: figure\Look.store);
    final guard = figure\external("Guard", sub: "allow, deny, advise", look: figure\Look.focal);
    final root = figure\external("Root", sub: "the session");
    final workers = figure\external("Workers", sub: "one per job");
    final disposition = figure\external("Disposition", sub: "integrated or held for review");
    final report = figure\external("Report", sub: "hack/dev/mandate.buzz");
    return figure\of("mandate-roles",
            title: "The person decides; the guard enforces what they wrote down",
            eyebrow: "decision",
            desc: "Four rows: the person decides, the plan, the mandate and each grant write the "
                + "decision down, the guard judges every call against them, and the root and its "
                + "workers do the work. Every call either one makes goes to the guard, whose verdict "
                + "is allow, deny or advise. The root forks jobs and spawns workers; a worker's "
                + "hand-back wakes the root. What a job did ends integrated or held for review, and "
                + "the report hands that back to the person.",
            direction: figure\Direction.down)
        .flowAcross(person, dst: plan, label: "plans")
        .flowAcross(person, dst: mandate, label: "mandates")
        .flowAcross(person, dst: grant, label: "grants")
        .flowAcross(plan, dst: guard)
        .flowAcross(mandate, dst: guard)
        .flowAcross(grant, dst: guard)
        .flowAcross(root, dst: guard, label: "every call")
        .flowAcross(workers, dst: guard, label: "every call")
        .flowAcross(root, dst: workers, label: "forks, spawns")
        .flowAcross(root, dst: disposition)
        .flowAcross(disposition, dst: report)
        .flowAcross(report, dst: person)
        .rank(actors: [plan, mandate, grant])
        .rank(actors: [root, workers])
        .legend(figure\Look.focal, label: "decides or enforces")
        .legend(figure\Look.store, label: "written down")
        .unscoped(why: "a division of acts between a person, the guard and sessions, not a Go package");
}

// mandateBarFigure is the tier bar a mandate's tolerance sets: an unsettled job at or below
// it is integrated with no one present, one above it is held for review.
export fun mandateBarFigure() > figure\Figure !> any {
    final trivial = figure\external("trivial", sub: "no gate");
    final mechanical = figure\external("mechanical", sub: "no code semantics");
    final scoped = figure\external("scoped", sub: "tests narrow");
    final full = figure\external("full", sub: "anything unproven");
    return figure\of("mandate-raises-the-bar",
            title: "A mandate raises the bar at its tolerance",
            eyebrow: "decision",
            desc: "The risk tiers magus proves, lowest first. The person types --tolerance when "
                + "issuing a mandate, at most this repository's ceiling, mechanical. An unsettled "
                + "job whose change proves at or below it is integrated with no one present; one "
                + "above it is held for review. A settled job is integrated through its gates at "
                + "any tier.")
        .flowAcross(trivial, dst: mechanical)
        .flowAcross(mechanical, dst: scoped, label: "--tolerance", stroke: figure\Stroke.focal)
        .flowAcross(scoped, dst: full)
        .zone("integrated with no one present", actors: [trivial, mechanical])
        .zone("held for review", actors: [scoped, full])
        .unscoped(why: "a policy threshold over risk tiers, not a Go package");
}
