namespace volatility;

import "magus";
import "magus/figure";
import "site/diagrams/buzz-stages" as _;
import "site/diagrams/packages" as _;

export fun volatilityFigure() > figure\Figure !> any {
    final decide = magus\dir("internal/ci/volatility");
    final fail = figure\external("Target fails", look: figure\Look.plain);
    final report = figure\external("Report failure", look: figure\Look.plain);
    final thin = codeStage(decide, symbol: "shouldRetry().", name: "enough history?", look: figure\Look.decision);
    final touched = codeStage(decide, symbol: "shouldRetry().", name: "diff touched it?", look: figure\Look.decision);
    final rate = codeStage(decide, symbol: "score().", name: "over threshold?", look: figure\Look.decision);
    // invokeSpell in the root package reruns the target; codeStage cannot anchor a symbol there.
    final retry = figure\external("Retry once", sub: "the same target", look: figure\Look.plain);
    final volatile = figure\external("Record volatile", sub: "the run continues", look: figure\Look.plain);
    final regress = figure\external("Suspected regression", sub: "chase with --bisect", look: figure\Look.focal);
    return figure\of("volatility",
            title: "When a failure is retried, and when it is believed",
            eyebrow: "volatility",
            desc: "A failing target that opted in is retried once while its history is too thin "
                + "to judge, when the diff did not touch its project, or when its measured "
                + "volatility is above the threshold. A retry that passes is recorded as volatile "
                + "and the run continues; anything else is a suspected regression.",
            direction: figure\Direction.down)
        .actor(fail)
        .box(decide, label: "Decide", sub: "on, and opted in?", symbol: magus\refs("Runtime#Decide()."))
        .actor(report)
        .actor(thin)
        .actor(touched)
        .actor(rate)
        .actor(retry)
        .actor(volatile)
        .actor(regress)
        .edgesFromGraph()
        .flowIn(fail, dst: decide)
        .flowOut(decide, dst: report, label: "no")
        .flowOut(decide, dst: thin, label: "yes")
        .flowAcross(thin, dst: retry, label: "bootstrap")
        .flowAcross(thin, dst: touched, label: "yes")
        .flowAcross(touched, dst: retry, label: "no")
        .flowAcross(touched, dst: rate, label: "yes")
        .flowAcross(rate, dst: retry, label: "yes")
        .flowAcross(rate, dst: regress, label: "no")
        .flowAcross(retry, dst: volatile, label: "passes")
        .flowAcross(retry, dst: regress, label: "fails again")
        .legend(figure\Look.focal, label: "wants a human")
        .scope(goPackages("internal/ci/**"))
        .except(figure\setOf([magus\dir("internal/ci")]),
            why: "plans the CI fan-out and the gate; a retry is decided per target, inside a run")
        .except(figure\setOf([magus\dir("internal/ci/annotate")]),
            why: "turns a retry already made into a CI notice; drawn in ci-providers")
        .except(figure\setOf([magus\dir("internal/ci/forecast")]),
            why: "the run history Decide reads and Record appends to; drawn, it breaks the nine-box budget");
}
