namespace buzzStages;

import "magus";
import "result";

// gopherbuzzPackages is every Go package in the gopherbuzz tree. A diagram scoped to it meets
// a new package as a finding until a box draws it or an except names it.
export fun gopherbuzzPackages() > result\Result::<[magus\Dir]> {
    try {
        return result\ok::<[magus\Dir]>(magus\graph().dirs("libs/gopherbuzz/**", opts: magus\DirsOptions{ language = "go" }));
    } catch (err: any) {
        return result\caught::<[magus\Dir]>(err);
    }
}

// gopherbuzzAround is the gopherbuzz packages built on the pipeline rather than part of
// it; a diagram excepts them for AROUND_WHY.
export fun gopherbuzzAround() > result\Result::<[magus\Dir]> {
    try {
        return result\ok::<[magus\Dir]>([
            magus\graph().dir("libs/gopherbuzz/benchmarks/comparison"),
            magus\graph().dir("libs/gopherbuzz/benchmarks/upstream"),
            magus\graph().dir("libs/gopherbuzz/buzzgen"),
            magus\graph().dir("libs/gopherbuzz/cmd/buzz"),
            magus\graph().dir("libs/gopherbuzz/examples/ffi-c"),
            magus\graph().dir("libs/gopherbuzz/internal/cmd/stdgen"),
            magus\graph().dir("libs/gopherbuzz/internal/stdgen"),
            magus\graph().dir("libs/gopherbuzz/std/internal/boxed"),
            magus\graph().dir("libs/gopherbuzz/wasm"),
        ]);
    } catch (err: any) {
        return result\caught::<[magus\Dir]>(err);
    }
}

export final AROUND_WHY = "the buzz CLI, the WASI build, the Go-to-Buzz type mirror, the stdlib generator and its boxed values, two benchmarks and an example: built on the pipeline, not a stage of it";
