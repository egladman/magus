// site/diagrams/server-share.buzz - sharing a read-only view onto the LAN. Kept as its own
// figure because the LAN listener is the only part of the server that a machine other than
// localhost can reach, and burying that in a whole-system flowchart is how it stops being
// obvious. The two accent elements both mark that boundary.
//
// The subset is drawn route by route rather than as one "read-only views" box, because the
// asymmetry IS the message: a share link is a URL handed to a phone, so the graph, the diff
// routes, the plan, /mcp and job control never appear on it. The three route boxes are
// internal/server/server.go's shareGuarded map and its complement, in order.
//
// The withheld box takes no connector on purpose: an arrow into it would say the listener
// reaches it. Nothing points at it, which is exactly the claim.
namespace serverShare;

import "../libs/diagram/diagram" as _;
import "../libs/diagram/flow" as _;
import "site/diagrams/gen/server-share" as serverShareGen;

export fun serverShareDiagram() > Diagram !> str {
    return flow("server-share")
        .observed(serverShareGen\serverShareObserved())
        .eyebrow("magus server")
        .title("The only listener a second machine can reach")
        .desc("Sharing from the dashboard posts to a loopback-only endpoint, which mints a "
            + "time-boxed read-only token and opens an ephemeral LAN listener. The listener "
            + "serves four JSON read routes and the read Connect services, and nothing "
            + "else: the graph, the diff routes, the derived plan, the job store, "
            + "/mcp and job control stay loopback only.")
        .node("dash", label: "Console", sub: "dashboard", tag: "pwa")
        .node("sharep", label: "/api/v1/share", sub: "loopback + bearer", tag: "route", anchor: "internal/share")
        .node("lan", label: "LAN listener", sub: "15m, read-only token", tag: "ephemeral", role: "focal", anchor: "internal/share")
        .node("phone", label: "Phone on the LAN", sub: "same-origin viewer", tag: "client", role: "external")
        .node("served", label: "Shared read routes", sub: "events, insight, outputs, output", role: "store", anchor: "internal/handler/viewer")
        .node("connectreads", label: "Shared Connect reads", sub: "status, activity, metrics, insight", role: "store", anchor: "internal/handler/status")
        .node("withheld", label: "Never on a share", sub: "graph, diff, plan, job, /mcp", role: "optional", anchor: "internal/handler/graph")
        .edge("dash", dst: "sharep", label: "share")
        .edge("sharep", dst: "lan", label: "mints token")
        .edge("phone", dst: "lan", label: "read-only", kind: "accent")
        .edge("lan", dst: "served", label: "serves")
        .edge("lan", dst: "connectreads", label: "serves")
        .legend("focal", label: "reachable off-machine")
        .legend("store", label: "served on a share")
        .legend("optional", label: "loopback only")
        .scope(["internal/share", "internal/handler/viewer", "internal/handler/status", "internal/handler/graph"])
        .diagram();
}
