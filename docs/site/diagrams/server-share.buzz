namespace serverShare;

import "magus";
import "magus/figure";

export fun serverShareFigure() > figure\Figure !> any {
    final server = magus\dir("internal/server");
    final lan = magus\dir("internal/share");
    // Route by route, not one read-only box: what a share link withholds is the message.
    // internal/server's shareGuarded map is the split drawn here.
    final served = magus\dir("internal/handler/viewer");
    final connectReads = magus\dir("internal/handler/status");
    final withheld = magus\dir("internal/handler/graph");
    final dash = figure\external("Console", sub: "dashboard", tag: "pwa", look: figure\Look.plain);
    final phone = figure\external("Phone on the LAN", sub: "same-origin viewer", tag: "client");
    return figure\of("server-share",
            title: "The only listener a second machine can reach",
            eyebrow: "magus server",
            desc: "Sharing from the dashboard posts to a loopback-only endpoint, which mints a "
                + "time-boxed read-only token and opens an ephemeral LAN listener. The listener "
                + "serves four JSON read routes and the read Connect services, and nothing "
                + "else: the graph, the diff routes, the derived plan, the job store, "
                + "/mcp and job control stay loopback only.")
        .actor(dash)
        .box(server, label: "/api/v1/share", sub: "loopback + bearer", tag: "route")
        .box(lan, label: "LAN listener", sub: "15m, read-only token", tag: "ephemeral", focal: true)
        .actor(phone)
        .box(served, label: "Shared read routes", sub: "events, insight, outputs, output", look: figure\Look.store)
        .box(connectReads, label: "Shared Connect reads", sub: "status, activity, metrics, insight", look: figure\Look.store)
        .box(withheld, label: "Never on a share", sub: "graph, diff, plan, job, /mcp", look: figure\Look.optional)
        .edgesFromGraph()
        .hideEdges(figure\setOf([server]), dst: figure\setOf([withheld]),
            why: "the server mounts it on loopback only; drawn, it would read as served on a share")
        .markEdge(server, dst: lan, label: "mints token")
        .markEdge(server, dst: served, label: "mounts")
        .markEdge(server, dst: connectReads, label: "mounts")
        .flowIn(dash, dst: server, label: "share")
        .flowIn(phone, dst: lan, label: "read-only", stroke: figure\Stroke.focal)
        .legend(figure\Look.focal, label: "reachable off-machine")
        .legend(figure\Look.store, label: "served on a share")
        .legend(figure\Look.optional, label: "loopback only")
        .scope(figure\setOf([lan]))
        .scope(figure\layerSet(magus\layer("handler")))
        .except(figure\setOf([magus\dir("internal/handler/activity"), magus\dir("internal/handler/insight"), magus\dir("internal/handler/metrics")]),
            why: "shared read services, folded into the two shared boxes")
        .except(figure\setOf([magus\dir("internal/handler/diff"), magus\dir("internal/handler/job"), magus\dir("internal/handler/mcp"), magus\dir("internal/handler/plan")]),
            why: "loopback only, named in the never-on-a-share box")
        .except(figure\setOf([magus\dir("internal/handler/attention"), magus\dir("internal/handler/diagram"), magus\dir("internal/handler/notes"), magus\dir("internal/handler/token"), magus\dir("internal/handler/tool")]),
            why: "loopback only: a person's blocks, the figures, private notes, token management and a service that execs tools")
        .except(figure\setOf([magus\dir("internal/handler/trailrpc")]),
            why: "the audit interceptor around Connect services, not a route");
}
