// site/diagrams/cache-trust.buzz - who may write which cache tier in CI. The argument is
// in the connectors that are missing: no pull request run writes the remote tier, and
// nothing carries a pull request's local tier to the default branch.
namespace cacheTrust;

import "../libs/diagram/diagram" as _;
import "../libs/diagram/flow" as _;
import "site/diagrams/gen/cache-trust" as cacheTrustGen;

export fun cacheTrustDiagram() > Diagram !> str {
    return flow("cache-trust", observed: cacheTrustGen\cacheTrustObserved())
        .eyebrow("remote cache")
        .title("A pull request reads the shared cache and never writes it")
        .desc("A pull request run reads the signed remote tier and reads and writes a "
            + "local tier scoped to its own ref. Only a run on the default branch holds "
            + "the signing key, so only the default branch writes the remote tier. "
            + "Every read checks the signature "
            + "and rebuilds the target on an unsigned entry.")
        .node("pr", label: "PR run", sub: "no signing key", tag: "pull_request", anchor: ".github/workflows/ci.yaml")
        .node("local", label: "Local tier", sub: "Actions cache, PR ref", role: Role.store, anchor: ".github/workflows/ci.yaml")
        // The package, not internal/cache/signing.go: the observed set names packages, and a
        // box merges with the observation that carries its exact anchor.
        .node("remote", label: "Remote tier", sub: "verified on every read", tag: "ed25519", role: Role.focal, anchor: "internal/cache")
        .node("default", label: "Default branch run", sub: "holds the signing key", tag: "push", anchor: ".github/workflows/ci.yaml")
        .node("reject", label: "Unsigned entry", sub: "rejected, then rebuilt", role: Role.optional)
        .edge("pr", dst: "local", label: "read + write")
        .edge("remote", dst: "pr", label: "read only")
        .edge("default", dst: "remote", label: "sign + put", role: EdgeRole.focal)
        .edge("remote", dst: "reject", label: "no signature", role: EdgeRole.optional)
        .zone("pull request, untrusted code", members: ["pr", "local"])
        .zone("default branch, trusted", members: ["default", "reject"])
        .legend(Role.focal, label: "the one shared store")
        .legend(Role.store, label: "one pull request only")
        .legend(Role.optional, label: "never replayed")
        .scope(["internal/cache"])
        .diagram();
}
