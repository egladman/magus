namespace cacheTrust;

import "magus";
import "magus/figure";
import "site/diagrams/packages" as _;

export fun cacheTrustFigure() > figure\Figure !> any {
    final remote = magus\dir("internal/cache");
    final pr = figure\external("PR run", sub: "no signing key", tag: "pull_request", look: figure\Look.plain);
    final local = figure\external("Local tier", sub: "Actions cache, PR ref", look: figure\Look.store);
    final main = figure\external("Default branch run", sub: "holds the signing key", tag: "push", look: figure\Look.plain);
    final reject = figure\external("Unsigned entry", sub: "rejected, then rebuilt", look: figure\Look.optional);
    return figure\of("cache-trust",
            title: "A pull request reads the shared cache and never writes it",
            eyebrow: "remote cache",
            desc: "A pull request run reads the signed remote tier and reads and writes a "
                + "local tier scoped to its own ref. Only a run on the default branch holds "
                + "the signing key, so only the default branch writes the remote tier. "
                + "Every read checks the signature "
                + "and rebuilds the target on an unsigned entry.")
        .actor(pr)
        .actor(local)
        .box(remote, label: "Remote tier", sub: "verified on every read", tag: "ed25519", focal: true)
        .actor(main)
        .actor(reject)
        // The argument is the connectors left out: no pull request run writes the remote tier,
        // and nothing carries a pull request's local tier to the default branch.
        .flowAcross(pr, dst: local, label: "read + write")
        .flowOut(remote, dst: pr, label: "read only")
        .flowIn(main, dst: remote, label: "sign + put", stroke: figure\Stroke.focal)
        .flowOut(remote, dst: reject, label: "no signature", stroke: figure\Stroke.optional)
        .zone("pull request, untrusted code", actors: [pr, local])
        .zone("default branch, trusted", actors: [main, reject])
        .legend(figure\Look.focal, label: "the one shared store")
        .legend(figure\Look.store, label: "one pull request only")
        .legend(figure\Look.optional, label: "never replayed")
        .scope(goPackages("internal/cache/**"))
        .except([magus\dir("internal/cache/reflink")],
            why: "copy-on-write file clones for a local restore; no tier, key or signature")
        .except([magus\dir("internal/cache/remotetest")],
            why: "a test server for the remote protocols, linked only by tests");
}
