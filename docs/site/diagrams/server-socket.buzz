namespace serverSocket;

import "magus";
import "magus/figure";
import "site/diagrams/packages" as packages;

export fun serverSocketFigure() > figure\Figure !> any {
    final cli = magus\graph().dir("cmd/magus");
    final sock = magus\graph().dir("internal/proc");
    final server = magus\graph().dir("internal/server");
    final share = magus\graph().dir("internal/share");
    final person = figure\person("You", sub: "run, status, query", tag: "shell");
    // The HTTP entry is server-http's; the two share only the registries internal/server holds.
    return figure\of("server-socket",
            title: "A local command reaches the server over one private socket",
            eyebrow: "magus server",
            desc: "The magus CLI dispatches over a private unix domain socket to the server, "
                + "which holds the concurrency pool, the workspace and run registries and the "
                + "broker for shared services. Sharing a graph spawns a separate short-lived "
                + "loopback server.",
            level: figure\Level.package)
        .actor(person)
        .box(cli, label: "magus CLI", sub: "dispatches every command")
        .box(sock, label: "Unix socket", sub: "0700, internal/proc", tag: "ipc", focal: true)
        .box(server, label: "Server", sub: "pool, registries, broker", look: figure\Look.store)
        // Not --serve: it only picks the transport, so naming it alone would omit the command.
        .box(share, label: "Loopback server", sub: "graph export --open", look: figure\Look.optional)
        .edgesFromGraph()
        .flowIn(person, dst: cli)
        .legend(figure\Look.store, label: "shared server state")
        .legend(figure\Look.optional, label: "spawned on demand")
        .scope(packages\goPackages("internal/proc/**"))
        .scope(packages\goPackages("internal/share/**"))
        .scope([server])
        .except([magus\graph().dir("internal/proc/endpoint")],
            why: "parses the transport address a client dials, a value type the CLI and config share")
        .except([magus\graph().dir("internal/proc/environ")],
            why: "one run's environment for the env host module; nothing on the socket reads it")
        .except([magus\graph().dir("internal/proc/spawn")],
            why: "the subprocess helper spells run tools through, under the pool rather than at the socket")
        .except([magus\graph().dir("internal/proc/sockdir")],
            why: "picks the 0700 directory the socket lives in, which the box's sub names");
}
