namespace packages;

import "magus";
import "result";

// dataTypes is the types packages a diagram of the project model leaves out:
// closed string sets and data the diagrams do not trace.
export fun dataTypes() > result\Result::<[magus\Dir]> {
    final names = ["enum", "daemon", "diff", "feedback", "image",
                   "check", "impact", "release", "vcs"];
    final dirs: mut [magus\Dir] = mut [<magus\Dir>];
    foreach (name in names) {
        try {
            dirs.append(magus\graph().dir("types/" + name));
        } catch (err: any) {
            return result\caught::<[magus\Dir]>(err);
        }
    }
    return result\ok::<[magus\Dir]>(dirs);
}
