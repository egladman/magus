// site/diagrams/merge-queue-risk.buzz: how a candidate's risk decides what the merge queue
// runs. The one claim: the queue asks the workspace two questions of every candidate, which
// projects its change reaches and, for a conflicted file, whether the edit is low risk, and
// the answers alone pick between gating those projects, gating every project, and kicking
// the change back. The accent is on the classifier, the only step that reads what an edit is.
//
// The tier table gate sizing builds on the same classes is not drawn: this repository's
// queue gate is `magus run ci:gha` on the change's projects (tools/gha-queue.buzz), which
// runs no sizing, and a merge reads the class alone. Apply reaches GitHub through the
// provider too; its edge is drawn straight to the forge so the loop closes on one box.
namespace mergeQueueRisk;

import "../libs/diagram/diagram" as _;
import "../libs/diagram/flow" as _;
import "site/diagrams/gen/merge-queue-risk" as mergeQueueRiskGen;

export fun mergeQueueRiskDiagram() > Diagram !> str {
    return flow("merge-queue-risk", observed: mergeQueueRiskGen\mergeQueueRiskObserved())
        .down()
        .eyebrow("merge queue")
        .title("What a candidate's risk makes the queue run")
        .desc("For a conflicted file the queue asks the classifier which class the edit is "
            + "and settles only a low-risk one, kicking code back, then gates the projects "
            + "the magus SDK says the change reaches, or every project when that set is no proof.")
        .node("github", label: "GitHub", sub: "auto-merge or a label", role: Role.external)
        .node("provider", label: "Forge provider", sub: "github.buzz on a Buzz VM", anchor: "internal/queue/provider")
        .node("queue", label: "Queue engine", sub: "plan, validate, apply", anchor: "internal/queue")
        .node("sdk", label: "magus SDK", sub: "asked via queue/client", anchor: "magus.go")
        .node("risk", label: "Classify each path", sub: "generated, prose, comment, code", role: Role.focal, anchor: "internal/risk")
        .node("low", label: "low risk?", role: Role.decision)
        .node("gate", label: "Gate the projects", sub: "every one when unbounded", anchor: "tools/gha-queue.buzz")
        .node("verdict", label: "Verdict", sub: "green, red or kicked back", anchor: "internal/queue/verdicts.go")
        .edge("github", dst: "provider", label: "merge intent", claim: Claim.calls)
        .edge("provider", dst: "queue", label: "changes")
        .edge("queue", dst: "risk", label: "a conflict")
        .edge("queue", dst: "gate", label: "no conflict")
        .edge("sdk", dst: "risk", claim: Claim.imports)
        .edge("sdk", dst: "gate", label: "its projects")
        .edge("risk", dst: "low", label: "the class", role: EdgeRole.focal)
        .edge("low", dst: "gate", label: "yes: settled")
        .edge("low", dst: "verdict", label: "no: kick back")
        .edge("gate", dst: "verdict", label: "exit status")
        .edge("verdict", dst: "github", label: "apply", claim: Claim.calls)
        // The queue's own spine in one column, so the workspace's answers enter it from beside.
        .row(["github", "provider", "queue", "low", "gate"])
        .zone("the workspace", members: ["sdk", "risk"])
        .legend(Role.focal, label: "reads what an edit is")
        .legend(Role.external, label: "outside magus")
        .legend(Role.decision, label: "the queue decides")
        .scope(["internal/risk/**", "internal/ci/**", "internal/queue/**"])
        .omit("internal/risk/golang", why: "the Go prover places code for gate sizing tiers; a merge reads the class alone")
        .omit("internal/ci", why: "the shard packer the SDK's Plan runs; the queue keeps only the affected list, computed before packing")
        .omit("internal/ci/annotate", why: "CI log folds and notices; it decides nothing")
        .omit("internal/ci/forecast", why: "runtime history that sizes shards and memory claims, not which projects run")
        .omit("internal/ci/volatility", why: "retries a failing target inside a run; it decides whether a red is believed, not what runs")
        .omit("internal/queue/client", why: "the build-facts adapter over the SDK, drawn as the queue -> SDK edge")
        .omit("internal/queue/types", why: "the documents and interfaces every step shares; drawn, every box would import it")
        .omit("internal/queue/types/gen/mocks", why: "generated test doubles")
        .diagram();
}
