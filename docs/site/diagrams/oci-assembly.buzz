namespace ociAssembly;

import "magus/figure";

export fun ociAssemblyFigure() > figure\Figure !> any {
    final files = figure\external("Built files", look: figure\Look.input);
    final base = figure\external("Pinned base", sub: "optional, by digest", look: figure\Look.optional);
    final write = figure\external("image.write", look: figure\Look.focal);
    final layouts = figure\external("Platform layouts", sub: "one per platform", look: figure\Look.plain);
    final index = figure\external("image.index", look: figure\Look.plain);
    final publish = figure\external("image.publish", look: figure\Look.plain);
    final registry = figure\external("Registry", look: figure\Look.store);

    return figure\of("oci-assembly",
            title: "Proposed OCI assembly flow",
            eyebrow: "proposed",
            desc: "Built files and an optional digest-pinned base feed image.write, which stages "
                + "one layout per platform. image.index combines the layouts, then image.publish "
                + "sends the result to a registry. These API calls remain proposed.")
        .flowAcross(files, dst: write)
        .flowAcross(base, dst: write)
        .flowAcross(write, dst: layouts)
        .flowAcross(layouts, dst: index)
        .flowAcross(index, dst: publish)
        .flowAcross(publish, dst: registry)
        .unscoped(why: "a proposed API process, not a package dependency graph");
}
