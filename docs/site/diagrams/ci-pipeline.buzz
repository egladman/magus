namespace ciPipeline;

import "magus/diagram";
import "result";

export fun ciPipelineDiagram() > result\Result::<diagram\Diagram> {
    try {
        final cmd = diagram\step("magus affected ci", look: diagram\Look.focal);
        // A fan-out, not a chain: drawn as a sequence, it read as magus owning a fixed pipeline,
        // which the page around it says magus does not.
        final f = diagram\of("ci-pipeline",
                title: "ci declares steps, not an order",
                eyebrow: "targets",
                desc: "A ci target names its steps in a single needs call, so they are independent "
                    + "and run in parallel. Order comes from edges the steps themselves declare, "
                    + "such as test depending on build. magus enforces none of this list.")
            .actor(cmd)
            .unscoped(why: "a magusfile convention, not a package: nothing in the tree to hold it to");
        foreach (step in ["generate", "format", "lint", "build", "test", "security"]) {
            _ = f.actor(diagram\step(step, look: diagram\Look.plain));
        }
        // An actor is keyed by its name, so these join the boxes declared above.
        foreach (step in ["generate", "build", "format", "test", "lint", "security"]) {
            _ = f.flowAcross(cmd, dst: diagram\step(step, look: diagram\Look.plain));
        }
        return result\ok::<diagram\Diagram>(f);
    } catch (err: any) {
        return result\caught::<diagram\Diagram>(err);
    }
}
