// site/diagrams/agent-surface.buzz: what an agent host gets from magus, and the one gate
// every call it makes crosses.
//
// The figure has one claim: skills and hook wiring are installed before a session, and from
// then on every tool call the host makes reaches the guard's hook first, MCP calls
// included. The accent pair (the guard box, the hook connector) is spent on that gate.
//
// Hints sit last because three surfaces render through them: a skill may name only a
// command or tool internal/hint registers, the guard's denials carry its invocations, and
// the MCP replies carry its next fields. Those three connectors are imports. The harness
// spells are Buzz and the host is outside magus, so they are actors.
namespace agentSurface;

import "magus";
import "magus/figure";

export fun agentSurfaceFigure() > figure\Figure !> any {
    final skills = magus\dir("internal/agent");
    final guard = magus\dir("internal/guard");
    final hint = magus\dir("internal/hint");
    final tools = magus\dir("internal/handler/mcp");
    final nested: [magus\Dir] = magus\dirs("internal/handler/mcp/**");
    final mcp = figure\setOf(nested + [tools]);
    final harness = figure\external("Harness spells", sub: "hook entries per host", look: figure\Look.plain);
    final host = figure\external("Agent host", sub: "Claude Code, Codex, Cursor", tag: "client");
    return figure\of("agent-surface",
            title: "What an agent host gets, and the gate every call crosses",
            eyebrow: "agents",
            desc: "magus agent install writes the skills and the AGENTS.md block, and magus "
                + "describe harness prints the hook entries a person merges into the host's "
                + "config. From then on the host runs the guard's PreToolUse hook before every "
                + "shell command, file edit and magus MCP call, and only an allowed call runs. "
                + "Skills, guard verdicts and MCP replies all name commands through internal/hint, "
                + "so a renamed command cannot leave one of them pointing at nothing.")
        .box(skills, label: "Skills catalog", sub: "embedded skills, AGENTS.md")
        .actor(harness)
        .actor(host)
        .box(guard, label: "Guard", sub: "deny, advise, ask", tag: "gate", focal: true)
        .group(mcp, label: "MCP tools", sub: "./magus mcp or /mcp")
        .box(hint, label: "Hints", sub: "commands, next fields")
        .edgesFromGraph()
        .hideEdges(figure\setOf([guard]), dst: figure\setOf([skills]),
            why: "the guard names skills in its denials; the skills reach the host by install, drawn from the catalog")
        .markEdge(skills, dst: hint, label: "command names")
        .markEdge(guard, dst: hint, label: "denial hints")
        .markEdge(tools, dst: hint, label: "next fields")
        .flowOut(skills, dst: host, label: "agent install")
        .flowAcross(harness, dst: host, label: "hooks to merge")
        .flowIn(host, dst: guard, label: "every call", stroke: figure\Stroke.focal)
        .flowIn(host, dst: tools, label: "if allowed")
        .zone("installed before a session", dirs: figure\setOf([skills]), actors: [harness])
        .zone("on every call", dirs: mcp.plus([guard, hint]))
        .legend(figure\Look.focal, label: "the gate")
        .legend(figure\Look.external, label: "outside magus")
        .scope(mcp.plus([skills, hint]));
}
