// site/diagrams/agent-surface.buzz - what an agent host gets from magus, and the one gate
// every call it makes crosses.
//
// The figure has one claim: skills and hook wiring are installed before a session, and from
// then on every tool call the host makes reaches the guard's hook first, MCP calls
// included. The accent pair (the guard box, the hook connector) is spent on that gate.
//
// Hints sit last because three surfaces render through them: a skill may name only a
// command or tool internal/hint registers, the guard's denials carry its invocations, and
// the MCP replies carry its next fields. Those three connectors are imports and are checked.
// The two install connectors and guard -> MCP are narrative: nothing in the code joins them.
namespace agentSurface;

import "../libs/diagram/diagram" as _;
import "../libs/diagram/flow" as _;
import "site/diagrams/gen/agent-surface" as agentSurfaceGen;

export fun agentSurfaceDiagram() > Diagram !> str {
    return flow("agent-surface", observed: agentSurfaceGen\agentSurfaceObserved())
        .eyebrow("agents")
        .title("What an agent host gets, and the gate every call crosses")
        .desc("magus agent install writes the skills and the AGENTS.md block, and magus "
            + "describe harness prints the hook entries a person merges into the host's "
            + "config. From then on the host runs the guard's PreToolUse hook before every "
            + "shell command, file edit and magus MCP call, and only an allowed call runs. "
            + "Skills, guard verdicts and MCP replies all name commands through internal/hint, "
            + "so a renamed command cannot leave one of them pointing at nothing.")
        .node("skills", label: "Skills catalog", sub: "embedded skills, AGENTS.md", anchor: "internal/agent")
        .node("harness", label: "Harness spells", sub: "hook entries per host", anchor: "spells/harness")
        .node("host", label: "Agent host", sub: "Claude Code, Codex, Cursor", tag: "client", role: Role.external)
        .node("guard", label: "Guard", sub: "deny, advise, ask", tag: "gate", role: Role.focal, anchor: "internal/guard")
        .node("mcp", label: "MCP tools", sub: "./magus mcp or /mcp", anchor: "internal/handler/mcp")
        .node("hint", label: "Hints", sub: "commands, next fields", anchor: "internal/hint")
        .edge("skills", dst: "host", label: "agent install")
        .edge("harness", dst: "host", label: "hooks to merge")
        .edge("host", dst: "guard", label: "every call", role: EdgeRole.focal, claim: Claim.calls)
        .edge("guard", dst: "mcp", label: "allowed")
        .edge("skills", dst: "hint", label: "command names", claim: Claim.imports)
        .edge("guard", dst: "hint", label: "denial hints", claim: Claim.imports)
        .edge("mcp", dst: "hint", label: "next fields", claim: Claim.imports)
        .zone("installed before a session", members: ["skills", "harness"])
        .zone("on every call", members: ["guard", "mcp", "hint"])
        .legend(Role.focal, label: "the gate")
        .legend(Role.external, label: "outside magus")
        .scope(["internal/agent", "internal/handler/mcp/**", "internal/hint"])
        .omit("internal/handler/mcp/gen", why: "the tool catalog generated from std's module descriptors, inside the MCP tools box")
        .omit("internal/handler/mcp/origin", why: "the calling client's name carried on the context for the activity trail, not a surface")
        .diagram();
}
