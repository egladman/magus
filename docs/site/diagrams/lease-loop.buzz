// site/diagrams/lease-loop.buzz - how work is split across several agents and put back
// together. The mechanism is a loop that closes: the checkpoint the orchestrator takes at
// the start is the same one it diffs against at the end, so a lease is verified against what
// it CLAIMED rather than against whatever the tree looks like later.
//
// The doctrine box is not a step. It is the doctrine the rest of the figure only makes sense
// under: every other box is a thing magus RECORDS or ANSWERS, and none of them is a thing
// it prevents. No connector reaches it because it constrains all of them.
//
// The release connector is the one accent. Releasing a path early, so write_paths shrinks
// while the lease is still held, is the move that makes the plan usable by a reader, and
// it is the half people skip. It returns to the row the lease was declared in, so it and
// the closing integrate -> checkpoint leg run against the flow and draw dashed.
namespace leaseLoop;

import "../libs/diagram/diagram" as _;
import "../libs/diagram/flow" as _;
import "site/diagrams/gen/lease-loop" as leaseLoopGen;

export fun leaseLoopDiagram() > Diagram !> str {
    return flow("lease-loop", observed: leaseLoopGen\leaseLoopObserved())
        .down()
        .eyebrow("lease")
        .title("A declared plan, released early, verified by diff")
        .desc("An orchestrator checkpoints the working state, partitions the work by write "
            + "set using graph evidence, and forks one job per unit: goal, "
            + "checkpoint, write paths. Holders release paths as soon as they are done with "
            + "them, so the plan shrinks while it runs, and the Jobs view renders the "
            + "rows, their overlaps and their staleness for whoever is watching. The "
            + "orchestrator verifies each job by diffing since that job's checkpoint "
            + "against what it claimed, then integrates and runs magus affected ci. magus "
            + "records and answers; it enforces none of it.")
        .node("cp", label: "magus vcs checkpoint", sub: "revision + dirty digest", anchor: "cmd/magus")
        .node("part", label: "Partition by write set", sub: "refs, explain, affected", anchor: "internal/graph")
        .node("decl", label: "Declare the plan", sub: "goal, checkpoint, paths", anchor: "internal/job")
        .node("work", label: "Workers edit", sub: "one write set each", role: Role.external)
        .node("verify", label: "Verify each lease", sub: "diff since its checkpoint", anchor: "internal/changeset")
        .node("integrate", label: "Integrate", sub: "magus affected ci", anchor: "cmd/magus")
        .node("plan", label: "Plan surface", sub: "/console/plan/, overlaps, stale", anchor: "internal/handler/status")
        .node("human", label: "The human", sub: "watches and decides", role: Role.external)
        .node("doctrine", label: "magus records and answers", sub: "it enforces none of it", role: Role.focal, anchor: "internal/job")
        .edge("cp", dst: "part")
        .edge("part", dst: "decl")
        .edge("decl", dst: "work")
        .edge("work", dst: "verify", label: "reports done")
        .edge("verify", dst: "integrate")
        .edge("integrate", dst: "cp")
        .edge("work", dst: "decl", label: "release", role: EdgeRole.focal)
        .edge("decl", dst: "plan", label: "job rows")
        .edge("human", dst: "plan", label: "watches")
        .zone("the loop the orchestrator runs", members: ["cp", "part", "decl", "work", "verify", "integrate"])
        .zone("what a person watches", members: ["plan", "human"])
        .legend(Role.focal, label: "the whole guarantee")
        .legend(Role.external, label: "agents and people")
        .scope(["internal/job", "internal/changeset"])
        .diagram();
}
