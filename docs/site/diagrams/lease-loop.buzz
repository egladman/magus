// site/diagrams/lease-loop.buzz: how work is split across several agents and put back
// together. The mechanism is a loop that closes: the checkpoint the orchestrator takes at
// the start is the same one it diffs against at the end, so a lease is verified against what
// it CLAIMED rather than against whatever the tree looks like later.
//
// The doctrine box is not a step. It is the doctrine the rest of the figure only makes sense
// under: every other box is a thing magus RECORDS or ANSWERS, and none of them is a thing
// it prevents. No connector reaches it because it constrains all of them.
//
// The release connector is the one accent. Releasing a path early, so write_paths shrinks
// while the lease is still held, is the move that makes the plan usable by a reader, and
// it is the half people skip.
//
// The job store and the diff are packages; the rest are commands the orchestrator runs,
// people, and a console page, so they are actors.
namespace leaseLoop;

import "magus";
import "magus/figure";

export fun leaseLoopFigure() > figure\Figure !> any {
    final decl = magus\dir("internal/job");
    final verify = magus\dir("internal/changeset");
    final cp = figure\external("magus vcs checkpoint", sub: "revision + dirty digest", look: figure\Look.plain);
    final part = figure\external("Partition by write set", sub: "refs, explain, affected", look: figure\Look.plain);
    final work = figure\external("Workers edit", sub: "one write set each");
    final integrate = figure\external("Integrate", sub: "magus affected ci", look: figure\Look.plain);
    final plan = figure\external("Plan surface", sub: "/console/plan/, overlaps, stale", look: figure\Look.plain);
    final human = figure\external("The human", sub: "watches and decides");
    final doctrine = figure\external("magus records and answers", sub: "it enforces none of it", look: figure\Look.focal);
    return figure\of("lease-loop")
        .down()
        .eyebrow("lease")
        .title("A declared plan, released early, verified by diff")
        .desc("An orchestrator checkpoints the working state, partitions the work by write "
            + "set using graph evidence, and forks one job per unit: goal, "
            + "checkpoint, write paths. Holders release paths as soon as they are done with "
            + "them, so the plan shrinks while it runs, and the Jobs view renders the "
            + "rows, their overlaps and their staleness for whoever is watching. The "
            + "orchestrator verifies each job by diffing since that job's checkpoint "
            + "against what it claimed, then integrates and runs magus affected ci. magus "
            + "records and answers; it enforces none of it.")
        .actor(cp)
        .actor(part)
        .box(decl, label: "Declare the plan", sub: "goal, checkpoint, paths")
        .actor(work)
        .box(verify, label: "Verify each lease", sub: "diff since its checkpoint")
        .actor(integrate)
        .actor(plan)
        .actor(human)
        .actor(doctrine)
        .edgesFromGraph()
        .flowAcross(cp, dst: part)
        .flowIn(part, dst: decl)
        .flowOut(decl, dst: work)
        .flowIn(work, dst: verify, label: "reports done")
        .flowOut(verify, dst: integrate)
        .flowAcross(integrate, dst: cp)
        .flowIn(work, dst: decl, label: "release", stroke: figure\Stroke.focal)
        .flowOut(decl, dst: plan, label: "job rows")
        .flowAcross(human, dst: plan, label: "watches")
        .zone("the loop the orchestrator runs", dirs: figure\setOf([decl, verify]), actors: [cp, part, work, integrate])
        .zone("what a person watches", actors: [plan, human])
        .legend(figure\Look.focal, label: "the whole guarantee")
        .legend(figure\Look.external, label: "agents and people")
        .scope(figure\setOf([decl, verify]));
}
