// site/diagrams/server-jobs.buzz: the background work that keeps the warm workspace honest.
// Everything here converges on one node, which is the point: the file watchers, the SCIP
// indexer and the graph-build job exist only to keep the workspace registry current, and
// nothing else in the server writes to it.
//
// The registry is the server's in-memory graph, and the indexer and the build job are work
// the server schedules, so all three are actors; the watchers are their own package.
namespace serverJobs;

import "magus";
import "magus/figure";

export fun serverJobsFigure() > figure\Figure !> any {
    final watch = magus\dir("internal/file/watch");
    final fs = figure\external("Source files", sub: "magusfiles, code", tag: "input");
    final cli = figure\external("magus run", sub: "any invocation", tag: "input");
    final idx = figure\external("SCIP indexer", sub: "symbol index", tag: "job", look: figure\Look.plain);
    final job = figure\external("Graph build", sub: "coalesced, async", tag: "job", look: figure\Look.plain);
    final ws = figure\external("Workspace registry", sub: "the warm graph", tag: "state", look: figure\Look.focal);
    return figure\of("server-jobs",
            title: "What keeps the warm workspace current",
            eyebrow: "magus server",
            desc: "File changes drive the watchers and the SCIP auto-indexer; a magus run "
                + "queues a coalesced graph-build job. All three write into the workspace "
                + "registry, which is the server's single warm copy of the knowledge graph.")
        .actor(fs)
        .actor(cli)
        .box(watch, label: "File watchers", sub: "internal/file/watch", tag: "job")
        .flowIn(fs, dst: watch)
        .flowAcross(fs, dst: idx)
        .flowAcross(cli, dst: job, label: "queues")
        .flowOut(watch, dst: ws, label: "invalidate")
        .flowAcross(idx, dst: ws, label: "symbols")
        .flowAcross(job, dst: ws, label: "rebuild")
        .legend(figure\Look.external, label: "outside the server")
        .legend(figure\Look.focal, label: "the one warm copy")
        .scope(figure\setOf([watch]));
}
