namespace serverJobs;

import "magus";
import "magus/figure";

export fun serverJobsFigure() > figure\Figure !> any {
    final watch = magus\graph().dir("internal/file/watch");
    final registry = magus\graph().dir("internal/workspace");
    final server = magus\graph().dir("internal/server");
    final graph = magus\graph().dir("internal/graph/knowledge");
    final fs = figure\external("Source files", sub: "magusfiles, code", tag: "input");
    final cli = figure\external("magus run", sub: "any invocation", tag: "input");
    return figure\of("server-jobs",
            title: "What keeps the warm workspace current",
            eyebrow: "magus server",
            desc: "File changes reach the watchers, which tell the workspace registry what to "
                + "invalidate. A magus run queues a coalesced graph-build job on the server, "
                + "which rebuilds the knowledge graph and writes it back into the registry, the "
                + "server's single warm copy.")
        .actor(fs)
        .actor(cli)
        .box(watch, label: "File watchers", sub: "invalidate on change", tag: "job")
        .box(registry, label: "Workspace registry", sub: "the warm copy", look: figure\Look.focal)
        .box(server, label: "Server", sub: "runs the jobs", tag: "job")
        .box(graph, label: "Graph build", sub: "coalesced, async", tag: "job")
        .edgesFromGraph()
        .markEdge(registry, dst: watch, label: "watches")
        .markEdge(server, dst: graph, label: "rebuild")
        .markEdge(server, dst: registry, label: "writes")
        .flowIn(fs, dst: watch)
        .flowIn(cli, dst: server, label: "queues")
        .legend(figure\Look.external, label: "outside the server")
        .legend(figure\Look.focal, label: "the one warm copy")
        .scope([watch, registry, server, graph]);
}
