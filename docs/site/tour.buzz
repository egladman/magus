// site/tour.buzz - the two interactive-demo pages: the guided tour (renderTourPage,
// with codeTeaser/tourSrc/playgroundLink) and the standalone playground
// (renderPlayground). Both called once by site_render; both inject the shared nav.
namespace tour;

import "fs";
import "io";
import "std";
import "encoding/base64";
import "template";
import "engine/types" as _;
import "engine/route" as _;
import "engine/nav" as _;
import "engine/page" as _;

// TourStep is one tour card: the .buzz example file, its copy, and a cross-link to
// the next concept doc (docSlug is the clean-URL directory, e.g. "targets"). It
// renders its own numbered card, keeping presentation on the typed data rather than a
// stringly-typed {str: str} map.
object TourStep {
    file: str = "",
    title: str = "",
    desc: str = "",
    docLabel: str = "",
    docSlug: str = "",

    // renderCard renders this step's numbered <li>: code teaser, Open-in-Playground
    // deep link, and concept cross-link, all resolved against root.
    fun renderCard(root: str, num: int) > str !> any {
        final src = tourSrc(this.file);
        // The cross-link is inline at the end of the description, not a separate line.
        return template\render(`      <li class="tour-card" id="step-{{num}}">
        <div class="tour-head"><span class="tour-num">{{num}}</span><h3>{{title}}</h3></div>
        <p class="tour-desc">{{desc}} <a class="tour-learn" href="{{root}}{{docSlug}}/">{{docLabel}} <span class="xref-arrow" aria-hidden="true">&rarr;</span></a></p>
        <pre class="tour-teaser"><code class="language-buzz">{{teaser}}</code></pre>
        <div class="tour-foot">
          <a class="open-in-playground" href="{{playLink}}" target="_blank" rel="noopener" title="Open this snippet in the playground (new tab)" data-tooltip="Open in playground">Open in Playground <span class="oip-arrow" aria-hidden="true">&#x2197;</span></a>
        </div>
      </li>
`, {"num": num, "title": this.title, "desc": this.desc, "root": root, "docSlug": this.docSlug, "docLabel": this.docLabel, "teaser": codeTeaser(src), "playLink": playgroundLink(root, src)});
    }
}


// renderPlayground writes gen/playground/index.html from the hand-authored
// playground.html, injecting the shared nav at its <!-- site-nav --> placeholder. The
// playground is standalone (custom head, wasm, own scripts), so it skips renderPage();
// templating just the nav keeps it in lockstep with every other page. Its bottom
// chrome is the console status bar (in playground.html), not the docs footer.
export fun renderPlayground(site: Site) > void !> any {
    final f = io\File.open("playground.html", io\FileMode.read);
    var html = f.readAll();
    f.close();
    // Ships at /playground/ (a directory index), so the nav climbs one level to root.
    final outDir = "playground";
    final root = climbFromDir(outDir);
    html = html.replace("<!-- site-nav -->", renderSiteNav(root, "playground", true, site.config));
    // Default (non-home) CSP meta - site.csp, not site.cspHome: the playground never
    // loads an external image and holds the reader's own source, so it takes the
    // tighter img-src, not the badge hosts. playground.html's own <!-- csp -->
    // placeholder is also what CSP_INLINE_SCRIPT_SOURCES reads to compute site.csp, so
    // this file is both the hash's source and its sink.
    html = html.replace("<!-- csp -->", "<meta http-equiv=\"Content-Security-Policy\" content=\"" + site.csp + "\">");
    fs\mkdirAll(fs\join(site.outDir, outDir));
    fs\writeFile(fs\join(site.outDir, outDir, "index.html"), html);
}


// codeTeaser previews a tour example: skip the leading comment block and blank lines,
// then take the first several real lines - so the card shows code, not the header comment.
fun codeTeaser(src: str) > str {
    var started = false;
    final kept: mut [str] = mut [<str>];
    foreach (line in src.split("\n")) {
        if (started == false) {
            final t = line.trim();
            if (t == "" or t.startsWith("//")) { continue; }
            started = true;
        }
        if (kept.len() >= 7) { break; }
        kept.append(line);
    }
    return kept.join("\n");
}


// tourSrc reads one curated example from tour/ (cwd-relative, build-time only; the
// files aren't written - their content rides into the page as teaser + deep-link).
fun tourSrc(file: str) > str {
    final f = io\File.open("tour/" + file, io\FileMode.read);
    final s = f.readAll();
    f.close();
    return s;
}


// playgroundLink deep-links src into the playground editor via a #source= fragment of
// url-safe unpadded base64 (matching src/site/run-example.ts and the wasm's
// applyHashSource decoder), so the code stays client-side, never hitting server/CDN.
fun playgroundLink(root: str, src: str) > str {
    var enc = base64\urlEncode(src);
    while (enc.endsWith("=")) { enc = enc.sub(0, enc.len() - 1); }
    return root + "playground/#source=" + enc;
}


// renderTourPage writes gen/tour/index.html: a numbered card grid walking a newcomer
// through magusfiles and Buzz. Synthesized (no .md source), so renderPage()'s srcRel
// guards drop the provenance/edit chrome.
// tourSteps is the ordered curriculum, shared by the tour page and collectDemos (which
// inverts each step's docSlug into a "see the demo" callout on the matching concept page).
export fun tourSteps() > [TourStep] !> any {
    final steps: mut [TourStep] = mut [<TourStep>];
    // Discovered from the directory, not from a list kept here. A hand-maintained
    // registry silently omitted steps 19 through 22 for as long as they existed: the
    // files were on disk, linted and shipped in sources, and simply never appeared on
    // the page. The same reasoning renderDevelopment gives for asking magus rather than
    // scanning - the set has one source of truth, so read THAT.
    //
    // Filenames sort into curriculum order because they are numbered, which is also what
    // lets a step reference "step 8" in its prose and stay right.
    // glob returns Paths, and an immutable list that sort cannot mutate in place, so
    // take the relative value of each into a list this can order.
    final files: mut [str] = mut [<str>];
    foreach (f in fs\glob("tour/*.buzz")) { files.append(f.value); }
    final ordered = files.sort(fun (a: str, b: str) > bool { return a < b; });
    foreach (f in ordered) {
        // glob yields "tour/NN-name.buzz"; TourStep.file is the bare name, because
        // tourSrc re-joins the directory and renderCard puts the name in the card.
        final name = f.sub("tour/".len());
        final src = fs\readFile(f);
        steps.append(TourStep{
            file = name,
            title = tourMeta(src, "title"),
            desc = tourMeta(src, "desc"),
            docLabel = tourDocLabel(src),
            docSlug = tourDocSlug(src),
        });
    }
    return steps;
}

// tourMeta reads one `// key: value` line from a step's header. The metadata lives in the
// step file so adding a step is one file, not two places that can disagree.
fun tourMeta(src: str, key: str) > str {
    foreach (line in src.split("\n")) {
        if (!line.startsWith("// ")) { return ""; }  // header ends at the first non-comment
        final want = "// " + key + ": ";
        if (line.startsWith(want)) { return line.sub(want.len()); }
    }
    return "";
}

// The doc cross-link is one line, `// doc: <slug>|<label>`, because a slug with no label
// renders a link with nothing to click.
fun tourDocSlug(src: str) > str {
    final raw = tourMeta(src, "doc");
    final bar = raw.indexOf("|");
    if (bar == null) { return raw; }
    return raw.sub(0, bar);
}

fun tourDocLabel(src: str) > str {
    final raw = tourMeta(src, "doc");
    final bar = raw.indexOf("|");
    if (bar == null) { return ""; }
    return raw.sub(bar + 1);
}

// collectDemos maps each concept docSlug to the FIRST tour step that demonstrates it (its
// title + card anchor), pre-walk, so renderFile can inject a "see the demo" callout on the
// matching concept page.
export fun collectDemos(site: Site) > void !> any {
    var n = 1;
    foreach (step in tourSteps()) {
        if (step.docSlug != "" and site.demoBySlug[step.docSlug] == null) {
            site.demoBySlug[step.docSlug] = DemoLink{ title = step.title, anchor = "step-{n}" };
        }
        n = n + 1;
    }
}

export fun renderTourPage(site: Site) > void !> any {
    final root = rootPrefix("tour/index.md", site);
    final steps = tourSteps();

    var cards = "";
    var n = 1;
    foreach (step in steps) {
        cards = cards + step.renderCard(root, n);
        n = n + 1;
    }

    final body = template\render(`<h1>Tour</h1>
<p class="lede">A guided walk through magusfiles and Buzz, step by step. Open any example in the Playground to run and edit it.</p>
    <ol class="tour-grid">
{{{cards}}}    </ol>
`, {"cards": cards});
    final title = "Tour";
    final desc = "A guided tour of magus: curated, runnable examples from a hello-world magusfile through a full multi-toolchain pipeline, custom targets, and the Buzz standard library.";
    final doc = renderPage(title, desc, body, "tour/index.md", "", "tour/", "", mut [], site);
    fs\mkdirAll(site.outDir + "/tour");
    final of = io\File.open(site.outDir + "/tour/index.html", io\FileMode.write);
    of.write(doc);
    of.close();
    // addRecord uses the desc arg directly and parses this stub only for tags, so the
    // stub is just a valid tags list (a description: line with colons would break the
    // YAML). The body text seeds a few search terms.
    site.addRecord("tour/", title, desc,
        "---\ntags: [tour, getting started, examples, playground, hello world]\n---\nGuided tour of magus. Hello world, targets, spells, the Buzz language, and a full magusfile.\n");
    std\print("  tour page -> " + site.outDir + "/tour/index.html");
}
