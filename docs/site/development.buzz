// site/development.buzz - the /development/ contributor section (renderDevelopment),
// built from the repo's own docs; pages emit through renderDevelopmentPage (Markdown)
// or renderDevelopmentPageRaw (pre-rendered HTML).
namespace development;

import "markdown";
import "fs";
import "io";
import "os";
import "template";
import "lib/text" as _;
import "lib/html" as _;
import "engine/path" as _;
import "engine/types" as _;
import "engine/page" as _;

// The three fixed /development/ page descriptions. Module-level because BOTH passes need
// them: collectDevelopmentPages registers the page, renderDevelopment renders it, and a
// description that differed between the two would put one string in the search index and a
// different one in the meta tag.
final DEVELOPMENT_DESC = "magus in full: why it exists, who it is for, how the affected set, "
    + "the cache and the knowledge graph work, and how to build and test the repository itself.";
final PROJECTS_DESC = "Every magus project in this repository: its runnable targets, its "
    + "run-order graph, and how the projects depend on each other.";
final CONTRIBUTING_DESC = "How to build, test, and contribute to magus: the performance-evidence "
    + "rule, the docs-site flow, and one-person-project etiquette.";

// projectPageDesc is one project page's description. Same reason as the constants above:
// two passes, one string.
fun projectPageDesc(name: str) > str {
    return "Target catalog and run-order graph for the " + name + " project, generated from its magusfile.";
}

// registerDevPage adds a synthesized /development/ page to docPages, the corpus
// every navigation helper walks. addRecord alone only feeds the search index, so
// without this these pages were reachable by search and invisible to Related,
// the section list, and the subtree.
//
// The landing page is the section's overview, so it anchors the others rather
// than listing itself.
fun registerDevPage(title: str, desc: str, url: str, srcRel: str, site: Site) > void {
    site.docPages.append(DocPage{
        url = url,
        title = title,
        desc = desc,
        srcRel = srcRel,
        section = "development",
        overview = url == "development/",
    });
}

// collectDevelopmentPages registers EVERY /development/ page in docPages before anything
// renders, the same pre-walk contract collectDocPages and collectSectionIndexes hold.
//
// Registering at render time (which is what renderDevelopmentPage used to do) cannot work
// here, because the section's two navigation directions point at each other: the landing's
// "In this section" list is built from its children, and every child's list is built from
// the landing that governs it. Whichever rendered second was the only one with a complete
// corpus to read. Splitting registration out satisfies both.
//
// The landing is README.md - the repository's front door renders at /development/, not at
// gen's root (see renderRoot). It is the section overview, and it is registered whether or
// not the workspace reported any projects, because renderRoot writes that page regardless.
export fun collectDevelopmentPages(site: Site) > void !> any {
    registerDevPage("Development", DEVELOPMENT_DESC, "development/", "README.md", site);
    if (fs\isFile(site.root + "/CONTRIBUTING.md")) {
        registerDevPage("Contributing", CONTRIBUTING_DESC,
            "development/contributing/", "development/contributing/_index.md", site);
    }
    if (site.targets.projects.len() == 0) { return; }
    registerDevPage("Projects", PROJECTS_DESC,
        "development/projects/", "development/projects/_index.md", site);
    foreach (proj in site.targets.projects) {
        final name = projectLabel(proj.path);
        final slug = slugifyProject(name);
        registerDevPage(name + " targets", projectPageDesc(name),
            "development/" + slug + "/", "development/" + slug + "/_index.md", site);
    }
}

// renderDevelopmentPage renders one /development/ page from markdown through the
// shared renderPage() pipeline (nav, TOC, theme, search index). url ends in "/";
// srcRel uses the "<dir>/_index.md" marker so rootPrefix/renderBreadcrumb derive the
// right depth and trail. collectDevelopmentPages has already registered it.
fun renderDevelopmentPage(title: str, desc: str, md: str, url: str, srcRel: str, site: Site) > void !> any {
    final html = renderContentHTML(markdown\toHtml(md), "", "");
    final doc = renderPage(title, desc, html, srcRel, "", url, "", mut [], site);
    final dir = fs\join(site.outDir, url.sub(0, url.len() - 1));
    fs\mkdirAll(dir);
    fs\writeFile(dir + "/index.html", doc);
    site.addRecord(url, title, desc, md);
    site.pageUrls[url] = true;
}


// renderDevelopmentPageRaw is renderDevelopmentPage for bodies already in final HTML
// (the /development/projects/ landing). It skips renderContentHTML - whose link-rewrite
// strips the trailing slash off relative links - so card hrefs like "../magus/" stay
// slash-terminated and resolve without a directory redirect. searchText is the plain
// text to index, since the HTML carries no useful prose.
fun renderDevelopmentPageRaw(title: str, desc: str, html: str, searchText: str, url: str, srcRel: str, site: Site) > void !> any {
    final doc = renderPage(title, desc, html, srcRel, "", url, "", mut [], site);
    final dir = fs\join(site.outDir, url.sub(0, url.len() - 1));
    fs\mkdirAll(dir);
    fs\writeFile(dir + "/index.html", doc);
    site.addRecord(url, title, desc, searchText);
    site.pageUrls[url] = true;
}


// slugifyProject turns a workspace-relative project path into one URL segment:
// "libs/gopherbuzz" -> "libs-gopherbuzz". Nested projects are the reason this exists --
// the previous shallow scan never produced a path with a separator in it.
//
// split/join, not replace: str.replace substitutes only the FIRST match, so a
// two-separator path ("cmd/magus/starter") kept the rest and the "one segment" this
// promises became a directory tree - /development/cmd-magus/starter/ - plus a Mermaid
// node id with slashes still in it.
fun slugifyProject(name: str) > str {
    return name.split("/").join("-");
}

// projectLabel is the display name for a workspace-relative project path. The root
// project's path is ".", which reads as nothing at all in a URL, a card, or a graph
// node; every render site here goes through this so they cannot disagree.
fun projectLabel(path: str) > str {
    return if (path == ".") "magus" else path;
}

// UP is the climb from /development/projects/ (where this section's landing renders) to
// /development/ (where each per-project page sits). The projects landing links to its
// SIBLINGS, not to children, which is what this prefix expresses.
final UP = "../";

// workspaceDependencies renders how the PROJECTS relate, as Markdown. The per-project
// pages answer "what can I run here"; this answers "what does changing it reach", which
// no page showed before.
//
// It reads magus.projectGraph()'s typed view: nodes already in topological order (so the table
// IS a valid build order, sorted by nobody here), each node's direct dependencies, and
// its blast radius - the count of projects a change can transitively affect, which is
// the number that tells a contributor whether an edit is contained or workspace-wide.
fun workspaceDependencies(graph: Graph) > str {
    final nodes = graph.nodes;
    if (nodes.len() == 0) { return ""; }

    var buf = "## Workspace dependencies\n\n"
        + "The projects above in dependency order: each row runs after everything it "
        + "depends on. Blast radius counts the projects a change here can reach, so it "
        + "is the cost of touching that project.\n\n"
        + "| project | depends on | blast radius |\n| --- | --- | --- |\n";
    var edges = "";
    foreach (n in nodes) {
        final label = projectLabel(n);
        final slug = slugifyProject(label);
        // A typed empty list, not `[]`: joining a bare list literal with the declared
        // [str] collapses the element type to any (see the note in projectCatalog).
        final deps = graph.dependsOn[n] ?? [<str>];
        var depCell = "-";
        if (deps.len() > 0) {
            var parts = "";
            foreach (d in deps) {
                if (parts != "") { parts = parts + ", "; }
                final dLabel = projectLabel(d);
                parts = parts + "[`" + dLabel + "`](" + UP + slugifyProject(dLabel) + "/)";
                // Edge direction matches the per-project run-order graphs: the arrow
                // points from a dependency to what waits on it.
                edges = edges + "    " + slugifyProject(dLabel) + "[\"" + dLabel + "\"] --> "
                    + slug + "[\"" + label + "\"]\n";
            }
            depCell = parts;
        }
        buf = buf + "| [`" + label + "`](" + UP + slug + "/) | " + depCell + " | "
            + "{graph.blastRadius[n] ?? 0}" + " |\n";
    }
    if (edges != "") {
        buf = buf + "\n```mermaid\ngraph LR\n" + edges + "```\n";
    }
    return buf;
}

// projectCatalog renders one project's target catalog as Markdown from the TYPED graph
// (TargetGraphProject) rather than by capturing `describe graph -o markdown` from
// a subprocess. Building it here means the page is assembled from the same in-process
// data the CLI renders, with no fork, no stdout to re-parse, and compile-checked field
// access on every node.
//
// A Mermaid block draws the run order from each node's declared dependencies, so the
// arrows are the real ctx.needs edges and not a hand-maintained picture.
fun projectCatalog(proj: TargetGraphProject) > str {
    // No `?? []` guards below: TargetGraphOutput.BuzzObject normalizes every optional list to
    // an empty one, so a field the Go struct tagged `omitempty` still arrives as a list
    // rather than null. That is what makes the annotation worth having - the field names
    // are compile-checked AND the values have the shape the mirror declares.
    var buf = "";
    final nodes = proj.nodes;
    final cycle = proj.cycle;
    final dependsOn = proj.dependsOn;
    if (nodes.len() == 0) {
        // A project on a non-Buzz engine has no statically extractable targets yet.
        // Engine is empty, not absent, when the project declares none.
        final engine = if (proj.engine == "") "unknown" else proj.engine;
        return "No statically extractable targets: this project runs on the `"
            + engine + "` engine.\n";
    }
    if (cycle.len() > 0) {
        buf = buf + "> **Cycle detected:** " + cycle.join(" -> ") + "\n\n";
    }
    if (dependsOn.len() > 0) {
        buf = buf + "Depends on " + dependsOn.join(", ") + ".\n\n";
    }

    buf = buf + "| target | depends on | drives |\n| --- | --- | --- |\n";
    foreach (n in nodes) {
        var drives = "";
        foreach (use in n.spells) {
            if (drives != "") { drives = drives + ", "; }
            drives = drives + use.spell;
        }
        if (drives == "") { drives = "-"; }
        var deps = "-";
        final nd = n.dependencies;
        if (nd.len() > 0) { deps = "`" + nd.join("`, `") + "`"; }
        buf = buf + "| `" + n.name + "` | " + deps + " | " + drives + " |\n";
    }

    // Per-target detail: the doc comment is the authored description, so it carries the
    // intent a table cannot.
    buf = buf + "\n";
    foreach (n in nodes) {
        if (n.doc != "") {
            buf = buf + "### `" + n.name + "`\n\n" + n.doc + "\n\n";
        }
    }

    // Run order. Only emitted when there is at least one edge - a flat list of
    // unconnected boxes tells a reader nothing.
    var edges = "";
    foreach (n in nodes) {
        foreach (d in n.dependencies) {
            edges = edges + "    " + d + " --> " + n.name + "\n";
        }
    }
    if (edges != "") {
        buf = buf + "## Run order\n\n```mermaid\ngraph LR\n" + edges + "```\n";
    }
    return buf;
}

// renderDevelopment writes the /development/ section BELOW its landing: one themed page
// per project rendering its target catalog and run-order graph, the Contributing guide,
// and a /development/projects/ index linking to the project pages and showing how they
// depend on each other. Retired /development/projects/<slug> URLs redirect to the
// flattened locations.
//
// The section LANDING is not written here - /development/ is the repository README, which
// renderRoot writes. That is why this file no longer carries a build-and-test quickstart:
// the README's "Building from source" is the one copy, and a second set of instructions
// here could only drift from it.
//
// The project set comes from magus itself (magus.ls, annotated `> Projects` for
// compile-checked field access), NOT from scanning the filesystem for MAGUS.md files.
// The scan it replaced looked only at site.root and its immediate subdirectories, so it
// found 2 of this workspace's 9 projects: the three under libs/ sit one level too deep,
// and console, proto, cmd/magus/starter and the agent-hook templates have no committed
// MAGUS.md at all. A workspace is exactly the set magus discovered, so asking magus is
// both correct and stable -- ls returns projects in sorted path order, which keeps the
// generated output byte-stable for the drift gate.
//
// Each page renders `describe graph -o markdown` for that project, which is the same
// generator that writes a committed MAGUS.md. Projects that keep one therefore render
// identical content (the drift gate holds them equal), and the four with none are no
// longer invisible. MAGUS.md stays committed for the offline and agent read paths.
export fun renderDevelopment(site: Site) > void !> any {
    // CONTRIBUTING.md (repo root) as its own page under /development/. Written whether or
    // not the workspace reported projects - it is prose about the repository, not about
    // the graph, and collectDevelopmentPages registers it on the same condition.
    if (fs\isFile(site.root + "/CONTRIBUTING.md")) {
        final cf = io\File.open(site.root + "/CONTRIBUTING.md", io\FileMode.read);
        final contributingMd = cf.readAll();
        cf.close();
        renderDevelopmentPage("Contributing", CONTRIBUTING_DESC,
            contributingMd, "development/contributing/", "development/contributing/_index.md", site);
    }

    final projects = site.targets.projects;
    if (projects.len() == 0) { return; }

    foreach (proj in projects) {
        final name = projectLabel(proj.path);
        final slug = slugifyProject(name);
        final md = projectCatalog(proj);
        renderDevelopmentPage(name + " targets", projectPageDesc(name),
            md, "development/" + slug + "/", "development/" + slug + "/_index.md", site);
        // Redirect the old nested URL to the flattened one so inbound links survive.
        site.collectAlias("development/projects/" + slug, "development/" + slug + "/");
    }

    // Project cards (Related-card look), one per project. Raw HTML with slash-terminated
    // hrefs so each links straight to the project page. They sit on /development/projects/,
    // and the project pages are its SIBLINGS rather than its children, so each href climbs
    // one level (UP) before naming the slug.
    var projectCards = "";
    foreach (proj in projects) {
        final name = projectLabel(proj.path);
        // The card subtitle carries the project's real shape - which toolchains it
        // binds - so a reader can tell a Go library from the docs site without
        // opening it. Falls back to the generic line for a project with no spells.
        var desc = "target catalog and run-order graph";
        final n = proj.nodes;
        if (n.len() > 0) {
            desc = "{n.len()} targets";
        }
        projectCards = projectCards
            + "        <a class=\"related-card\" href=\"" + UP + slugifyProject(name) + "/\">"
            + "<span class=\"related-card-title\">" + escapeAttr(name) + "</span>"
            + "<span class=\"related-card-desc\">" + escapeAttr(desc) + "</span></a>\n";
    }

    // The project-level view, rendered through the markdown pipeline for its table and
    // Mermaid block and then spliced into the raw page. renderContentHTML is skipped
    // for the same reason the page is raw at all: its link rewrite would strip the
    // trailing slash off every project href here.
    final depsMd = workspaceDependencies(site.graph);
    var depsSection = "";
    if (depsMd != "") {
        depsSection = wrapTables(tagMermaid(markdown\toHtml(depsMd)));
    }

    // The projects index answers one question - what is in this workspace and what does
    // touching it reach - and nothing else. Raw HTML (skips the markdown pipeline) so the
    // card hrefs keep their trailing slash.
    final devHtml = template\render(`<h1 id="projects">Projects</h1>
<p>magus is built and tested by magus: this repository is itself a magus workspace, so the targets, spells, caching, and wards documented for your projects run this one too. Below is every project in it, drawn from the workspace's own graph rather than written by hand.</p>
<h2 id="project-graphs">Project graphs</h2>
<p>One card per magus project in this repository, each linking to that project's runnable targets and run-order graph - the same content as its committed <code>MAGUS.md</code>, rendered here with the site's theming, search, and live Mermaid diagrams.</p>
    <div class="related-grid">
{{{projectCards}}}    </div>
{{{depsSection}}}`, {"projectCards": projectCards, "depsSection": depsSection});
    renderDevelopmentPageRaw("Projects", PROJECTS_DESC,
        devHtml, "Projects project target catalogs workspace dependencies dependency order blast radius run order graph",
        "development/projects/", "development/projects/_index.md", site);
}
