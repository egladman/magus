// engine/feeds.buzz - the site's Atom 1.0 syndication feeds: the blog feed and the
// releases feed. Each reads the finished Site and writes an XML feed under
// gen/public/atom/. Flat-imported by render.buzz; each writer takes a `site: Site`
// and runs once, post-walk, gated on a configured base URL.
namespace feeds;

import "fs";
import "result";
import "semver";
import "assert";
import "engine/types" as _;
import "../libs/ssg/text" as _;
import "../libs/ssg/feed" as _;

// renderBlogAtom writes gen/public/atom/blog.atom.xml: an Atom 1.0 feed of
// site.blogPosts, newest first. Per <entry>: title, link (absolute), id (same URL),
// updated (post date), summary (description), author. Feed-level updated = newest
// post's date. Gated on site.config.baseURL so it can ship dark until the host is confirmed.
export fun renderBlogAtom(site: Site) > result\Result::<bool> {
    try {
        if (site.inputs.config.baseURL == "") { return result\ok::<bool>(true); }
        if (site.blogPosts.len() == 0) { return result\ok::<bool>(true); }
        final sorted = site.blogPosts.sort(fun (a: BlogPost, b: BlogPost) > bool {
            if (a.date != b.date) { return strLess(b.date, b: a.date); }
            return strLess(a.base, b: b.base);
        });
        final feedUpdated = atomDate(sorted[0].date);
        final body = mut [<str>];
        body.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
            + "<feed xmlns=\"http://www.w3.org/2005/Atom\">\n"
            + "  " + xmlElement("title", text: site.inputs.config.title + " blog") + "\n"
            + "  " + xmlSelfClose("link", attrs: xmlAttribute("href", value: site.inputs.config.baseURL + "blog/") + xmlAttribute("rel", value: "alternate")) + "\n"
            + "  " + xmlSelfClose("link", attrs: xmlAttribute("href", value: site.inputs.config.baseURL + "public/atom/blog.atom.xml") + xmlAttribute("rel", value: "self")) + "\n"
            + "  " + xmlElement("id", text: site.inputs.config.baseURL + "blog/") + "\n"
            + "  " + xmlElement("updated", feedUpdated) + "\n");
        foreach (p in sorted) {
            final entryUrl = site.inputs.config.baseURL + p.url;
            body.append("  <entry>\n"
                + "    " + xmlElement("title", text: p.title) + "\n"
                + "    " + xmlSelfClose("link", attrs: xmlAttribute("href", value: entryUrl)) + "\n"
                + "    " + xmlElement("id", entryUrl) + "\n"
                + "    " + xmlElement("updated", text: atomDate(p.date)) + "\n"
                + "    " + xmlElement("summary", text: p.description) + "\n"
                + "  </entry>\n");
        }
        body.append("</feed>\n");
        fs\mkdirAll(site.inputs.outDir + "/public/atom");
        fs\writeFile(site.inputs.outDir + "/public/atom/blog.atom.xml", content: body.join(""));
        // Register it: pruneStaleOutputs deletes a directory whose index.html is no
        // longer produced, and /public/atom/ has no page of its own.
        site.writtenPaths["public/atom/blog.atom.xml"] = true;
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err);
    }
}


// releaseEntryTitle is a feed entry's title: the version, marked when it is a prerelease so
// a reader does not take a candidate for the latest stable release.
fun releaseEntryTitle(version: str) > str {
    if (!semver\isStable(version)) { return version + " (prerelease)"; }
    return version;
}

// renderReleasesAtom writes gen/public/atom/releases.atom.xml from parsed
// releases (newest first as authored). Per <entry>: title = releaseEntryTitle, link =
// site.config.repoURL/releases/tag/<ver>, id = same, updated = release date, summary = the section
// body. Feed-level updated = newest entry's date, a candidate's included, as Atom defines it.
// Gated on site.config.baseURL and on having at least one released version.
export fun renderReleasesAtom(site: Site) > result\Result::<bool> {
    try {
        if (site.inputs.config.baseURL == "") { return result\ok::<bool>(true); }
        if (site.inputs.releases.len() == 0) { return result\ok::<bool>(true); }
        final feedUpdated = atomDate(site.inputs.releases[0].date);
        final body = mut [<str>];
        body.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
            + "<feed xmlns=\"http://www.w3.org/2005/Atom\">\n"
            + "  " + xmlElement("title", text: site.inputs.config.title + " releases") + "\n"
            + "  " + xmlSelfClose("link", attrs: xmlAttribute("href", value: site.inputs.config.repoURL + "/releases") + xmlAttribute("rel", value: "alternate")) + "\n"
            + "  " + xmlSelfClose("link", attrs: xmlAttribute("href", value: site.inputs.config.baseURL + "public/atom/releases.atom.xml") + xmlAttribute("rel", value: "self")) + "\n"
            + "  " + xmlElement("id", text: site.inputs.config.repoURL + "/releases") + "\n"
            + "  " + xmlElement("updated", feedUpdated) + "\n");
        foreach (r in site.inputs.releases) {
            final ver = r.version;
            final link = site.inputs.config.repoURL + "/releases/tag/" + ver;
            body.append("  <entry>\n"
                + "    " + xmlElement("title", text: releaseEntryTitle(ver)) + "\n"
                + "    " + xmlSelfClose("link", attrs: xmlAttribute("href", value: link)) + "\n"
                + "    " + xmlElement("id", link) + "\n"
                + "    " + xmlElement("updated", text: atomDate(r.date)) + "\n"
                + "    " + xmlElementAttribute("summary", attrs: xmlAttribute("type", value: "text"), text: r.body.trim()) + "\n"
                + "  </entry>\n");
        }
        body.append("</feed>\n");
        fs\mkdirAll(site.inputs.outDir + "/public/atom");
        fs\writeFile(site.inputs.outDir + "/public/atom/releases.atom.xml", content: body.join(""));
        // Register it: pruneStaleOutputs deletes a directory whose index.html is no
        // longer produced, and /public/atom/ has no page of its own.
        site.writtenPaths["public/atom/releases.atom.xml"] = true;
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err);
    }
}

test "releaseEntryTitle marks a candidate and leaves a release as its version" {
    assert\equal(releaseEntryTitle("v0.5.0-rc.1"), want: "v0.5.0-rc.1 (prerelease)", message: "a candidate is marked");
    assert\equal(releaseEntryTitle("v0.4.3"), want: "v0.4.3", message: "a release is its version");
    assert\equal(releaseEntryTitle("v0.4.3+build-1"), want: "v0.4.3+build-1", message: "build metadata is not a prerelease");
}
