// engine/gates.buzz - the build-correctness layer: it serves nothing, it PROVES the site
// is correct and records its provenance. Two jobs:
//   1. Provenance - loadMeta/buildCommits read the git history behind each page (the
//      "Last updated" line and its History disclosure).
//   2. Gates - after every page is written, throw on any dangling link or missing asset
//      (assetIntegrityCheck), any page unreachable from the homepage (orphanCheck), and any
//      previously-shipped URL that started 404-ing (abandonedLinkCheck). pruneStaleOutputs
//      deletes outputs whose source is gone; writeSiteManifest/updateUrlLock write the
//      integrity manifest and URL ledger.
// All take a `site: Site` - free functions, not Site methods, so engine/types.buzz stays
// leaf-only and cycle-free.
namespace gates;

import "os";
import "fs";
import "io";
import "std";
import "engine/types" as _;
import "lib/text" as _;
import "lib/csp" as _;
import "lib/html" as _;
// The conventions lint's pure half: lintMarkdown/pathReferences decide WHAT is wrong,
// conventionsCheck below is the part allowed to read the tree and say so.
import "lib/conventions" as _;

// loadMeta populates the commit-metadata fields once, shelling out to git. The
// GitHub source-navigation links (edit/blame/history/blob) use the git symbolic ref
// HEAD, which GitHub resolves to the repo's default branch: honest (it names the
// canonical line, not a fabricated branch), rename-proof (survives a default-branch
// rename), and identical on every branch so a feature-branch render never drifts -
// the reason the old hardcoded "main" existed, now solved without the lie.
export fun loadMeta(site: Site) > void !> any {
    if (site.metaLoaded) { return; }
    site.metaPrefix = capture("git -C " + site.root + " rev-parse --show-prefix");
    site.metaBranch = "HEAD";
    site.metaFull = capture("git -C " + site.root + " rev-parse HEAD");
    site.metaShort = capture("git -C " + site.root + " rev-parse --short HEAD");
    site.metaStamp = capture("TZ=UTC git -C " + site.root + " show -s --date=format-local:'%Y-%m-%dT%H:%M:%SZ' --format=%cd HEAD");
    site.metaCommits = buildCommits(site);
    site.metaLoaded = true;
}

// axisReport lists pages reachable by fewer than three KINDS of route - tree, sequence, topic.
// See Site.pageAxes for why kinds rather than link count.
//
// It REPORTS rather than throws, deliberately. orphanCheck can throw because its bar is
// objective: a page is reachable or it is not. "Three axes" is an editorial target, and a gate
// that fails the build the moment someone adds a page - before they have tagged it - trains
// people to reach for an escape hatch. Print the shortfall, let it be burned down, and promote
// it to a throw once the number is at zero and staying there.
export fun axisReport(site: Site) > void !> any {
    var thin: mut [str] = mut [<str>];
    foreach (p in site.docPages) {
        final n = site.pageAxes[p.url];
        if (n == null) { continue; }
        if (n! < 3) { thin.append(p.url + " (" + "{n!}" + ")"); }
    }
    if (thin.len() == 0) { return; }
    final ordered = thin.sort(fun (a: str, b: str) > bool { return strLess(a, b); });
    std\print("  link axes: {ordered.len()} page(s) reachable by fewer than 3 kinds of route (tree, sequence, topic)");
    var shown = 0;
    foreach (u in ordered) {
        if (shown >= 10) { break; }
        std\print("    " + u);
        shown = shown + 1;
    }
    if (ordered.len() > 10) { std\print("    ... and {ordered.len() - 10} more"); }
}

// assetIntegrityCheck throws on any dangling href/src in the written output, so a
// renamed bundle or forgotten alias fails the build instead of shipping a 404.
export fun assetIntegrityCheck(site: Site) > void !> any {
    final files: mut [str] = mut [<str>];
    walkGen("", files, site);
    foreach (f in files) {
        if (f.endsWith(".html") == false and f.endsWith(".xml") == false and f.endsWith(".txt") == false) {
            // Non-textual asset: nothing to scan for refs.
        } else {
            final fh = io\File.open(site.outDir + "/" + f, io\FileMode.read);
            final html = fh.readAll();
            fh.close();
            final parts = f.split("/");
            var pageDir = "";
            if (parts.len() > 1) { pageDir = parts.sub(0, parts.len() - 1).join("/"); }
            foreach (target in scanReferencesInHTML(html, pageDir)) {
                if (checkPathExists(target, site) == false) {
                    throw "asset integrity: " + f + " references missing " + target;
                }
            }
        }
    }
}

// orphanCheck proves every docs page is reachable by BFS from the nav roots, so a
// page with no inbound link fails the build instead of shipping unreachable.
export fun orphanCheck(site: Site) > void !> any {
    // Every written page, keyed the way pageKey() yields, so BFS can tell a page
    // link from an asset link.
    final files: mut [str] = mut [<str>];
    walkGen("", files, site);
    var isPage: mut {str: bool} = mut {};
    foreach (f in files) {
        if (f == "index.html") { isPage[""] = true; }
        else { if (f.endsWith("/index.html")) { isPage[f.sub(0, f.len() - 11)] = true; } }
    }

    var visited: mut {str: bool} = mut {};
    var queue: mut [str] = mut [<str>];
    foreach (r in ["", "documentation", "blog", "download", "tour", "playground", "search", "public", "development"]) {
        if (isPage[r] != null and visited[r] == null) { visited[r] = true; queue.append(r); }
    }
    var head = 0;
    while (head < queue.len()) {
        final key = queue[head];
        head = head + 1;
        var path = site.outDir + "/index.html";
        if (key != "") { path = site.outDir + "/" + key + "/index.html"; }
        final fh = io\File.open(path, io\FileMode.read);
        final html = fh.readAll();
        fh.close();
        foreach (ref in scanReferencesInHTML(html, key)) {
            final k = pageKey(ref);
            if (isPage[k] != null and visited[k] == null) {
                visited[k] = true;
                queue.append(k);
            }
        }
    }

    var orphans: mut [str] = mut [<str>];
    foreach (p in site.docPages) {
        var dk = p.url;
        if (dk.endsWith("/")) { dk = dk.sub(0, dk.len() - 1); }
        if (visited[dk] == null) { orphans.append(p.url); }
    }
    if (orphans.len() > 0) {
        throw "orphaned pages: {orphans.len()} docs renderPage(s) unreachable from site navigation (add a link from an overview page): " + orphans.join(", ");
    }
}


export fun capture(cmd: str) > str !> any {
    final tmp = os\tmpFilename("sitegen");
    final code = os\execute(["sh", "-c", cmd + " > " + tmp + " 2>/dev/null"]);
    if (code != 0) {
        fs\removeAll(tmp);
        return "";
    }
    final f = io\File.open(tmp, io\FileMode.read);
    final result = f.readAll();
    f.close();
    fs\removeAll(tmp);
    return result.trim();
}

// Map of repo-relative source path -> "full|short|date" of the newest commit that touched
// it, from ONE git log (newest-first, first sighting wins) instead of a git call per page.
// ">>>" can't begin a repo path, so it marks each commit header; file names follow until
// the next. Run with `git -C ..` so pathspecs and written paths are magus/-relative,
// matching site.metaPrefix.
// HISTORY_MAX caps the per-file history depth in the "History" disclosure. The log is one
// git spawn, so a higher cap is cheap; a low one keeps the <details> panel from bloating on
// hot-edit files.
final HISTORY_MAX = 8;

// buildCommits parses one git-log pass:
//   - metaCommits: path -> "full|short|stamp" of the FIRST (newest) sighting; drives the
//     always-visible "Last updated" footer line.
//   - metaHistory: path -> up to HISTORY_MAX "full|short|stamp|subject" entries, newest-
//     first; drives the collapsed history panel.
// The log prints "SUBJ:<subject>" after each ">>>" header so both fields ride together
// without a second git spawn.
export fun buildCommits(site: Site) > {str: str} !> any {
    var m: mut {str: str} = mut {};
    site.metaHistory = mut {};
    final log = capture("TZ=UTC git -C " + site.root + " log --first-parent --diff-merges=first-parent --name-only "
        + "--date=format-local:'%Y-%m-%dT%H:%M:%SZ' "
        + "--format='>>>%H|%h|%cd%nSUBJ:%s' -- README.md docs blog CHANGELOG.md");
    var curHeader = "";
    var curSubject = "";
    foreach (line in log.split("\n")) {
        if (line.startsWith(">>>")) {
            curHeader = line.sub(3);
            curSubject = "";
        } else if (line.startsWith("SUBJ:")) {
            curSubject = line.sub(5);
        } else if (line != "" and curHeader != "") {
            // Newest sighting wins for the "last updated" line.
            if (m[line] == null) { m[line] = curHeader; }
            // Append to per-file history (newest-first) until HISTORY_MAX.
            var hist = site.metaHistory[line];
            if (hist == null) { hist = mut [<str>]; }
            if (hist.len() < HISTORY_MAX) {
                hist.append(curHeader + "|" + curSubject);
            }
            site.metaHistory[line] = hist;
        }
    }
    return m;
}

// checkPathExists returns true when target (gen-root-relative, no leading slash)
// resolves to a real file under gen/. Directory refs (URL ending in "/" or a plain
// slugged path) resolve to their index.html; assets pass through verbatim.
// fs\isFile / fs\isDir, not os\execute(["test", ...]). This is the hottest filesystem
// predicate in the render by a wide margin: assetIntegrityCheck calls it for EVERY href
// and src on every written page, and each call took up to three forks. Tens of thousands
// of fork+exec pairs is what put the render's kernel time at more than twice its user
// time - the gate that proves the site has no dangling link cost more than rendering the
// site did.
export fun checkPathExists(target: str, site: Site) > bool !> any {
    // Empty target = gen/'s root, always the index.html landing. This shows up
    // when a page links to "../" (Parent Directory in an autoindex root) and the
    // resolver pops back to the root.
    if (target == "") { return fs\isFile(site.outDir + "/index.html"); }
    if (fs\isFile(site.outDir + "/" + target)) { return true; }
    if (fs\isDir(site.outDir + "/" + target)) {
        return fs\isFile(site.outDir + "/" + target + "/index.html");
    }
    if (target.endsWith("/")) {
        return fs\isFile(site.outDir + "/" + target + "index.html");
    }
    return false;
}

// scanReferencesInHTML pulls every href="..." and src="..." out of html, skipping
// external URLs, mailto:, javascript:, data:, and pure fragments. Each reference
// is returned as a gen-root-relative path (resolved against pageDir).
export fun scanReferencesInHTML(html: str, pageDir: str) > [str] {
    var refs: mut [str] = mut [<str>];
    var seen: mut {str: bool} = mut {};
    var rest = html;
    while (true) {
        final iHref = rest.indexOf("href=\"");
        final iSrc = rest.indexOf("src=\"");
        var i: int = -1;
        var advance = 0;
        if (iHref != null and iSrc != null) {
            if (iHref < iSrc) { i = iHref; advance = 6; } else { i = iSrc; advance = 5; }
        } else if (iHref != null) { i = iHref; advance = 6; }
        else if (iSrc != null) { i = iSrc; advance = 5; }
        else { i = -1; }
        if (i < 0) { return refs; }
        rest = rest.sub(i + advance);
        final end = rest.indexOf("\"");
        if (end == null) { return refs; }
        final raw = rest.sub(0, end);
        rest = rest.sub(end + 1);
        if (raw == "") { continue; }
        if (raw.startsWith("http://") or raw.startsWith("https://") or raw.startsWith("//")
            or raw.startsWith("#") or raw.startsWith("mailto:") or raw.startsWith("javascript:")
            or raw.startsWith("data:") or raw.startsWith("tel:")) { continue; }
        // Root-absolute paths (leading /) are the deploy-time reference form (404.html's
        // exception, the manifest, etc.); they resolve at the deploy base, not gen/'s root,
        // so we can't check them locally without threading in basePath. Skip.
        if (raw.startsWith("/")) { continue; }
        // .go/.buzz refs point at their GitHub location (repo-root-relative), not a site
        // asset - the markdown module rewrites .md links but leaves these untouched. Skip.
        if (raw.endsWith(".go") or raw.endsWith(".buzz")) { continue; }
        // Strip a URL #fragment; the file only needs to exist, the fragment is
        // client-side.
        var path = raw;
        final hash = path.indexOf("#");
        if (hash != null) { path = path.sub(0, hash); }
        if (path == "") { continue; }
        // Also drop a query string.
        final q = path.indexOf("?");
        if (q != null) { path = path.sub(0, q); }
        if (path == "") { continue; }
        final resolved = resolvePath(pageDir, path);
        if (seen[resolved] == null) {
            seen[resolved] = true;
            refs.append(resolved);
        }
    }
    // No trailing return: the loop is `while (true)` with no break, so every exit
    // is one of the returns above and anything here is unreachable.
}

// walkGen recursively enumerates every written file under gen/ so the integrity check
// reads each once.
export fun walkGen(rel: str, acc: mut [str], site: Site) > void !> any {
    var dir = site.outDir;
    if (rel != "") { dir = site.outDir + "/" + rel; }
    foreach (name in fs\listDir(dir)) {
        var childRel = name;
        if (rel != "") { childRel = rel + "/" + name; }
        if (fs\isDir(site.outDir + "/" + childRel)) {
            walkGen(childRel, acc, site);
        } else {
            acc.append(childRel);
        }
    }
}

// pruneStaleOutputs deletes gen/ output whose source no longer produces it - a
// renamed/removed page, a deleted post, a dropped alias, a release out of CHANGELOG.md.
// gen/ is not wiped before each render, so this keeps it from accumulating orphans: for
// every "<dir>/index.html" not in writtenPaths and not in alwaysKeep, delete the whole
// directory (sibling index.md and all). Runs before assetIntegrityCheck/orphanCheck so
// neither trips on a stale page's dangling reference to content removed with it.
export fun pruneStaleOutputs(site: Site) > void !> any {
    // Outputs never eligible for pruning: paths a normal render always rewrites regardless
    // of docs/blog content, plus the playground's committed WASM/editor bundle, which this
    // render never touches (build-playground / build-playground-editor refresh it out of
    // band).
    final alwaysKeep: mut {str: bool} = mut {
        "index.html": true, "index.md": true, "404.html": true,
        // The tracked files that live inside the output tree. gen/install is the POSIX
        // sh installer; public/release/index.json and its Ed25519 signature are the
        // release manifest `magus self update` reads, written by `magus-utils
        // release-index` at tag time because only a tag build holds the signing key.
        // Nothing here writes any of the three, so this list is also where you find them.
        "install": true,
        "public/release/index.json": true, "public/release/index.json.sig": true,
        "sitemap.xml": true, "robots.txt": true, "manifest.webmanifest": true,
        "service-worker.js": true, "search-index.json": true, "site-manifest.sha256": true,
        "site.css": true, "console.css": true, "ui-panels.css": true, "theme.css": true, "theme.js": true, "main.js": true,
        "search/index.html": true,
        "playground/index.html": true, "playground/buzz.wasm": true,
        "playground/wasm_exec.js": true, "playground/editor.js": true,
        // /console/ is owned by the standalone console/ project (copied in at deploy). The
        // docs render only emits a redirect stub there via the reference/console alias, which
        // writeAliases already registers in writtenPaths - so no alwaysKeep entry needed.
    };
    final acc: mut [str] = mut [<str>];
    walkGen("", acc, site);
    final staleDirs: mut {str: bool} = mut {};
    foreach (path in acc) {
        if (alwaysKeep[path] != null) { continue; }
        if (path.startsWith("assets/")) { continue; }   // scoped delete+recopy above already keeps this clean
        if (path.endsWith("/index.html") == false) { continue; }   // only page-shaped files drive pruning
        if (site.writtenPaths[path] != null) { continue; }
        staleDirs[path.sub(0, path.len() - 11)] = true;   // len("/index.html") == 11
    }
    foreach (dir in staleDirs.keys()) {
        // Pruning keys off a missing index.html but deletes the whole directory, so a
        // directory holding produced NON-page outputs must survive its page going away.
        // /public/atom/ (the Atom feeds) is exactly that: real files, no page of its own.
        var produced = false;
        foreach (w in site.writtenPaths.keys()) {
            if (w.startsWith(dir + "/")) { produced = true; }
        }
        if (produced) { continue; }
        std\print("  pruning stale " + dir + "/ (no longer produced)");
        fs\removeAll(site.outDir + "/" + dir);
    }
}

// writeSiteManifest emits gen/site-manifest.sha256: one "<sha256>  <path>\n" line (standard
// sha256sum(1) format, so `sha256sum -c` verifies it directly) per file shipped under gen/,
// repo-relative, sorted. Called from generate() AFTER generateJsBundles(), not from
// site_render(), because generateJsBundles() writes gen/assets/mermaid.js and hljs.js
// (served assets) only after site_render() returns - computing the manifest earlier would
// omit them. Excludes its own output path (a file cannot hash itself).
export fun writeSiteManifest(site: Site) > void !> any {
    final acc: mut [str] = mut [<str>];
    walkGen("", acc, site);
    final sorted = acc.sort(fun (a: str, b: str) > bool { return strLess(a, b); });
    var body = "";
    foreach (rel in sorted) {
        if (rel == "site-manifest.sha256") { continue; }
        body = body + fileSha256(site.outDir + "/" + rel) + "  " + rel + "\n";
    }
    fs\writeFile(site.outDir + "/site-manifest.sha256", body);
}

// pageKey normalizes a scanReferencesInHTML result (a gen-root-relative path with no
// trailing slash - "spells/go", "index.html", "assets/x.png") to a page key: "" for
// the home page, else the directory that holds the page's index.html. Asset paths
// pass through unchanged and simply never match a real page key.
export fun pageKey(resolved: str) > str {
    var r = resolved;
    if (r.endsWith("/index.html")) { r = r.sub(0, r.len() - 11); }  // len("/index.html") == 11
    if (r == "index.html") { return ""; }
    if (r.endsWith("/")) { r = r.sub(0, r.len() - 1); }
    return r;
}


// URL_LOCK is the committed, append-only ledger of every URL the site has ever
// shipped (one per line, sorted). RETIRED_URLS lists URLs intentionally removed,
// exempting them from the abandoned-link gate.
final URL_LOCK = "active.urls.lock";
final RETIRED_URLS = "retired.urls.lock";

// readURLSet reads a newline-delimited URL file into a set, skipping blanks and
// "#" comments. Missing file -> empty set (the bootstrap case for URL_LOCK).
export fun readURLSet(path: str) > {str: bool} !> any {
    var set: mut {str: bool} = mut {};
    if (fs\isFile(path) == false) { return set; }
    final f = io\File.open(path, io\FileMode.read);
    final content = f.readAll();
    f.close();
    foreach (line in content.split("\n")) {
        final t = line.trim();
        if (t != "" and t.startsWith("#") == false) { set[t] = true; }
    }
    return set;
}

// abandonedLinkCheck is the parity gate: every URL the site has shipped before
// (recorded in URL_LOCK) must still resolve, so a renamed or deleted page can't
// silently start 404-ing on inbound links and bookmarks. To retire a URL on
// purpose, either add a redirect (frontmatter `aliases:`, whose stub keeps the old
// URL resolving) or list it in retired.urls.lock. Runs every render; the lock only
// grows (updateUrlLock, under the rw charm).
export fun abandonedLinkCheck(site: Site) > void !> any {
    final locked = readURLSet(URL_LOCK);
    final retired = readURLSet(RETIRED_URLS);
    var abandoned: mut [str] = mut [<str>];
    foreach (url in locked.keys()) {
        if (retired[url] == null and checkPathExists(url, site) == false) {
            abandoned.append(url);
        }
    }
    if (abandoned.len() > 0) {
        final sorted = abandoned.sort(fun (a: str, b: str) > bool { return strLess(a, b); });
        throw "abandoned links: {sorted.len()} previously-shipped URL(s) no longer resolve. Add a redirect (frontmatter aliases:) or list them in retired.urls.lock: " + sorted.join(", ");
    }
}

// updateUrlLock folds this build's URLs into URL_LOCK and rewrites it sorted. It
// only adds - a URL that drops out of the build stays in the ledger so the gate
// keeps demanding a redirect or an explicit retirement for it. Called under the rw
// charm so a plain (checking) render never mutates the tree.
export fun updateUrlLock(site: Site) > void !> any {
    var set = readURLSet(URL_LOCK);
    foreach (u in site.pageUrls.keys()) { set[u] = true; }
    var lines: mut [str] = mut [<str>];
    foreach (u in set.keys()) { lines.append(u); }
    final sorted = lines.sort(fun (a: str, b: str) > bool { return strLess(a, b); });
    var body = "";
    foreach (u in sorted) { body = body + u + "\n"; }
    fs\writeFile(URL_LOCK, body);
}

// LINT_SKIP_DIRS never hold prose this lint has an opinion about: build output, installed
// packages, committed third-party bytes, and the client source tree. Matched by NAME at any
// depth, like isNeverContentDir - a nested node_modules is the reason that rule exists.
final LINT_SKIP_DIRS = ["gen", "node_modules", "vendor", "src", "assets"];

fun lintSkipDir(name: str) > bool {
    foreach (d in LINT_SKIP_DIRS) {
        if (name == d) { return true; }
    }
    return false;
}

// collectMarkdown appends every .md file under dir (recursively) to acc, as a path relative
// to the walk root.
fun collectMarkdown(base: str, rel: str, acc: mut [str]) > void !> any {
    var dir = base;
    if (rel != "") { dir = base + "/" + rel; }
    foreach (name in fs\listDir(dir)) {
        var childRel = name;
        if (rel != "") { childRel = rel + "/" + name; }
        if (isDirectory(dir + "/" + name)) {
            if (lintSkipDir(name)) { continue; }
            collectMarkdown(base, childRel, acc);
        } else {
            if (name.endsWith(".md")) { acc.append(childRel); }
        }
    }
}

// pathExists is the one filesystem question the conventions lint asks.
fun pathExists(p: str) > bool !> any {
    return fs\exists(p);
}

// conventionsCheck holds the docs corpus to the conventions page it ships. It runs from
// `lint`, NOT from the render, on purpose: a prose nit must not fail `build`. A gate that
// fails the wrong target teaches people that the failing target is unreliable, and the next
// real breakage in it gets waved through.
//
// Two tiers, the same split assetIntegrityCheck and axisReport already draw here:
//
//   THROWS on the objective rules. A `$ ` prompt in a command block and a pinned version
//   standing in for example output are facts about the text, with no judgment in them.
//
//   REPORTS the broken repo paths. Whether an inline path is a claim about this repo or an
//   illustration of the reader's is a question the text does not answer (see
//   looksLikeRepoPath for the cases that defeated the first draft), so this prints and lets
//   the number be burned down. Promote it to a throw once it sits at zero - the same path
//   axisReport is on.
//
// Every violation is collected before either happens. Failing on the first would turn a
// three-minute fix into three round trips.
export fun conventionsCheck(root: str, docs: str) > void !> any {
    var files: mut [str] = mut [<str>];
    collectMarkdown(root + "/" + docs, "", files);
    final sorted = files.sort(fun (a: str, b: str) > bool { return strLess(a, b); });

    final broken: mut [str] = mut [<str>];
    final violations: mut [str] = mut [<str>];
    var checked = 0;

    // The docs corpus, addressed as docs/<rel> so a finding names a path you can open.
    foreach (rel in sorted) {
        checked = checked + 1;
        collectFindings(root, file: docs + "/" + rel, abs: root + "/" + docs + "/" + rel,
            violations: violations, broken: broken);
    }
    // The repo-root prose, where a stale path does the most damage: it is the first thing a
    // newcomer reads, and a backticked path in a sentence is invisible to every markdown
    // linter, because it is not a link.
    foreach (name in ["README.md", "CONTRIBUTING.md"]) {
        if (pathExists(root + "/" + name)) {
            checked = checked + 1;
            collectFindings(root, file: name, abs: root + "/" + name,
                violations: violations, broken: broken);
        }
    }

    if (broken.len() > 0) {
        std\print("  conventions: {broken.len()} inline path(s) that no longer resolve");
        foreach (b in broken) { std\print("    " + b); }
    }
    if (violations.len() > 0) {
        var body = "";
        foreach (v in violations) { body = body + "\n  " + v; }
        throw "conventions: {violations.len()} violation(s) of docs/conventions.md across {checked} file(s):"
            + body + "\n\nEach rule is documented on that page. Fix the prose, not the lint.";
    }
    std\print("conventions: {checked} files checked, no violations");
}

// collectFindings runs both halves over one file and sorts what they report into the tier
// that throws and the tier that prints.
fun collectFindings(root: str, file: str, abs: str, violations: mut [str], broken: mut [str]) > void !> any {
    final md = fs\readFile(abs);
    foreach (f in lintMarkdown(file, md)) {
        violations.append(f.file + ":" + "{f.line}" + ": [" + f.rule + "] " + f.message);
    }
    if (pathCheckApplies(file) == false) { return; }
    foreach (f in pathReferences(file, md)) {
        if (pathExists(root + "/" + f.path) == false) {
            broken.append(f.file + ":" + "{f.line}" + ": " + f.message);
        }
    }
}
