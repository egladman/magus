// engine/gates.buzz - the build-correctness layer: it serves nothing, it PROVES the site
// is correct and records its provenance. Two jobs:
//   1. Provenance - loadMeta/buildCommits read the git history behind each page (the
//      "Last updated" line and its History disclosure).
//   2. Gates - after every page is written, throw on any dangling link or missing asset
//      (assetIntegrityCheck), any page unreachable from the homepage (orphanCheck), and any
//      previously-shipped URL that started 404-ing (abandonedLinkCheck). pruneStaleOutputs
//      deletes outputs whose source is gone; writeSiteManifest/updateUrlLock write the
//      integrity manifest and URL ledger.
// All take a `site: Site` - free functions, not Site methods, so engine/types.buzz stays
// leaf-only and cycle-free.
namespace gates;

import "os";
import "fs";
import "io";
import "std";
import "engine/types" as _;
import "engine/route" as _;
import "lib/text" as _;
import "lib/csp" as _;
import "lib/html" as _;

// MAX_BACKLINKS caps a page's "Referenced by" list. Past a dozen the list stops telling a
// reader who points here and starts being a second table of contents: the busiest pages in
// this corpus are referenced by most of it, and a hundred rows at the foot of an article is
// a wall, not a cross-reference. The overflow is counted, not listed.
final MAX_BACKLINKS = 12;

// resolveBacklinks substitutes each written page's BACKLINK_MARKER for its "Referenced by"
// block, or removes the marker when nothing links there. It runs over gen/ rather than over
// site.writtenPaths because a few always-rewritten pages (the /search/ tool page) never
// register a written path, and a marker left in the shipped HTML is a comment nobody
// intended to publish.
//
// Ordering matters twice: it must run after every page is written (the link graph is a
// whole-corpus aggregate) and before anything fingerprints gen/ - the service worker's
// cache version and site-manifest.sha256 both digest these exact bytes - and before the
// integrity gate, so the links it injects are checked like any others.
export fun resolveBacklinks(site: Site) > void {
    var files: [str] = mut [<str>];
    walkGen("", files, site);
    foreach (f in files) {
        if (f.endsWith(".html") == false) { continue; }
        final fh = io\File.open(site.outDir + "/" + f, io\FileMode.read);
        final body = fh.readAll();
        fh.close();
        if (body.indexOf(BACKLINK_MARKER) == null) { continue; }
        fs\writeFile(site.outDir + "/" + f, body.replace(BACKLINK_MARKER, backlinksFor(pageUrlOf(f), site)));
    }
}

// pageUrlOf turns a gen-relative output path into the clean URL its page renders under -
// the key Site.backlinks and Site.pageAnchors use ("index.html" for the home page, since
// that is the spelling renderRoot registers).
fun pageUrlOf(f: str) > str {
    if (f == "index.html") { return "index.html"; }
    if (f.endsWith("/index.html")) { return f.sub(0, f.len() - 10); }   // keep the trailing slash
    return f;
}

// backlinksFor renders one page's "Referenced by" block from the collected link graph:
// every page whose prose links here, by title, capped and alphabetical. Alphabetical
// because there is no meaningful rank among references - walk order would just expose the
// filesystem - and a stable order keeps the drift gate quiet.
fun backlinksFor(url: str, site: Site) > str {
    final sources = site.backlinks[url];
    if (sources == null) { return ""; }
    var dir = url;
    if (dir == "index.html") { dir = ""; }
    if (dir.endsWith("/")) { dir = dir.sub(0, dir.len() - 1); }

    var rows: [{str: str}] = mut [<{str: str}>];
    foreach (src in sources!) {
        // The home page is not in docPages (it renders from the repo README), so it has no
        // lookupTitle; it is still a page a reader can go to, and "Home" is what the
        // breadcrumb already calls it.
        var title = "Home";
        var href = relativePath(dir, "index.html");
        if (src != "index.html") {
            title = site.lookupTitle(src);
            href = relativePath(dir, src);
        }
        if (title == "") { continue; }
        rows.append(mut {"title": title, "href": href, "key": title + "|" + src});
    }
    final ordered = rows.sort(fun (a: {str: str}, b: {str: str}) > bool { return strLess(a["key"]!, b["key"]!); });
    var shown: [{str: str}] = mut [<{str: str}>];
    var hidden = 0;
    foreach (r in ordered) {
        if (shown.len() < MAX_BACKLINKS) { shown.append(r); } else { hidden = hidden + 1; }
    }
    return backlinkBlock(shown, hidden);
}

// loadMeta populates the commit-metadata fields once, shelling out to git. The
// GitHub source-navigation links (edit/blame/history/blob) use the git symbolic ref
// HEAD, which GitHub resolves to the repo's default branch: honest (it names the
// canonical line, not a fabricated branch), rename-proof (survives a default-branch
// rename), and identical on every branch so a feature-branch render never drifts -
// the reason the old hardcoded "main" existed, now solved without the lie.
export fun loadMeta(site: Site) > void {
    if (site.metaLoaded) { return; }
    site.metaPrefix = capture("git -C " + site.root + " rev-parse --show-prefix");
    site.metaBranch = "HEAD";
    site.metaFull = capture("git -C " + site.root + " rev-parse HEAD");
    site.metaShort = capture("git -C " + site.root + " rev-parse --short HEAD");
    site.metaStamp = capture("TZ=UTC git -C " + site.root + " show -s --date=format-local:'%Y-%m-%dT%H:%M:%SZ' --format=%cd HEAD");
    site.metaCommits = buildCommits(site);
    site.metaLoaded = true;
}

// axisReport lists pages reachable by fewer than three KINDS of route - tree, sequence, topic.
// See Site.pageAxes for why kinds rather than link count.
//
// It REPORTS rather than throws, deliberately. orphanCheck can throw because its bar is
// objective: a page is reachable or it is not. "Three axes" is an editorial target, and a gate
// that fails the build the moment someone adds a page - before they have tagged it - trains
// people to reach for an escape hatch. Print the shortfall, let it be burned down, and promote
// it to a throw once the number is at zero and staying there.
export fun axisReport(site: Site) > void {
    var thin: [str] = mut [<str>];
    foreach (p in site.docPages) {
        final n = site.pageAxes[p.url];
        if (n == null) { continue; }
        if (n! < 3) { thin.append(p.url + " (" + "{n!}" + ")"); }
    }
    if (thin.len() == 0) { return; }
    final ordered = thin.sort(fun (a: str, b: str) > bool { return strLess(a, b); });
    std\print("  link axes: {ordered.len()} page(s) reachable by fewer than 3 kinds of route (tree, sequence, topic)");
    var shown = 0;
    foreach (u in ordered) {
        if (shown >= 10) { break; }
        std\print("    " + u);
        shown = shown + 1;
    }
    if (ordered.len() > 10) { std\print("    ... and {ordered.len() - 10} more"); }
}

// curationReport lists the editorial gaps a page-by-page reviewer cannot see but a
// whole-corpus pass can: pages shipping no description of their own, and authored pages in
// the two hand-written trees that have not been sequenced.
//
// Report-only, for axisReport's reason (read its note): a description and a reading order
// are editorial calls, and a gate that fails the build the moment someone adds a page -
// before they have written its blurb - teaches people to reach for the escape hatch rather
// than write the blurb. Print the shortfall, let it be burned down, promote it to a throw
// once the number is at zero and staying there.
export fun curationReport(site: Site) > void {
    var thin: [str] = mut [<str>];
    var unordered: [str] = mut [<str>];
    // "<source dir> #<order>" -> the page that claimed it, so a second page claiming the
    // same slot is reported instead of silently letting the title decide the sort.
    var claimed: {str: str} = mut {};
    var dupes: [str] = mut [<str>];
    foreach (p in site.docPages) {
        // A synthesized overview's stock blurb says only that the directory has pages in
        // it, which is what the reader can already see - it wants an authored page.
        if (p.desc == "" or p.desc == SECTION_STOCK_DESC) { thin.append(p.url); }

        final synthesized = p.srcRel.endsWith("/_index.md");
        final curated = p.url.startsWith("concepts/") or p.url.startsWith("guides/");
        if (synthesized or curated == false or isGenerated(p.srcRel, site)) { continue; }
        // An overview is the root of the sequence it introduces, not a step in it: the
        // pager walks its children, and an order: on the section page itself would only
        // claim a slot in its PARENT's sequence, which is not what an author sequencing
        // "concepts/" means by it.
        if (p.overview) { continue; }
        if (p.order == ORDER_UNSET) {
            unordered.append(p.url);
        } else {
            final dir = sourceDirectory(p.srcRel);
            final key = dir + " #{p.order}";
            if (claimed[key] != null) { dupes.append(p.url + " (order {p.order}, also " + claimed[key]! + ")"); }
            else { claimed[key] = p.url; }
        }
    }
    reportList("descriptions", thin, "page(s) with no description of their own");
    reportList("reading order", unordered, "authored concepts/guides page(s) with no order:");
    reportList("reading order", dupes, "page(s) sharing an order: with a sibling");
}

// ORDER_UNSET mirrors DocPage.order's absent-order sentinel (engine/types.buzz's
// UNORDERED). A third copy of the number, for the same reason types.buzz gives for its
// second: each file reads the order from its own corpus and stays import-light.
final ORDER_UNSET = 1000000;

// sourceDirectory is the directory holding a page's source file, the scope an `order:` has
// to be unique within (the pager sorts a directory's siblings, not a whole section).
fun sourceDirectory(srcRel: str) > str {
    final parts = srcRel.split("/");
    if (parts.len() <= 1) { return ""; }
    return parts.sub(0, parts.len() - 1).join("/");
}

// reportList prints one axisReport-shaped finding: a count line, then the first ten,
// sorted. Nothing at all when the list is empty.
fun reportList(label: str, items: [str], what: str) > void {
    if (items.len() == 0) { return; }
    final ordered = items.sort(fun (a: str, b: str) > bool { return strLess(a, b); });
    std\print("  " + label + ": {ordered.len()} " + what);
    var shown = 0;
    foreach (u in ordered) {
        if (shown >= 10) { break; }
        std\print("    " + u);
        shown = shown + 1;
    }
    if (ordered.len() > 10) { std\print("    ... and {ordered.len() - 10} more"); }
}

// assetIntegrityCheck throws on any dangling href/src in the written output, so a
// renamed bundle or forgotten alias fails the build instead of shipping a 404. Also scans
// the emitted .md mirrors (the "View markdown source" siblings) the same way, so a mirror
// link left in source-layout form fails the build instead of shipping a dangling one.
//
// A reference's #fragment is checked too, against the anchor set renderPage recorded for
// the target page (Site.pageAnchors). A link whose path resolves and whose fragment does
// not is the failure mode a path-only gate is blind to, and it is the one that actually
// happens: a heading gets reworded, every deep link into it keeps resolving to the top of
// the page, and nothing notices. Fragments pointing at something that is not a rendered
// page (an asset, a redirect stub, the console app) are skipped - there is no anchor set
// to judge them against.
export fun assetIntegrityCheck(site: Site) > void {
    var files: [str] = mut [<str>];
    walkGen("", files, site);
    foreach (f in files) {
        if (f.endsWith(".html") == false and f.endsWith(".xml") == false
            and f.endsWith(".txt") == false and f.endsWith(".md") == false) {
            // Non-textual asset: nothing to scan for refs.
        } else if (f == "llms-full.txt") {
            // The whole corpus concatenated: every page's links are relative to that
            // page's own directory, so there is no single base to resolve them against
            // here. Each page's own mirror is scanned above, which is where those links
            // actually have to work.
        } else {
            final fh = io\File.open(site.outDir + "/" + f, io\FileMode.read);
            final body = fh.readAll();
            fh.close();
            final parts = f.split("/");
            var pageDir = "";
            if (parts.len() > 1) { pageDir = parts.sub(0, parts.len() - 1).join("/"); }
            var targets: [str] = mut [<str>];
            if (f.endsWith(".md")) { targets = scanReferencesInMarkdown(body, pageDir); }
            else { targets = scanReferencesInHTML(body, pageDir); }
            foreach (target in targets) {
                final path = refPath(target);
                if (checkPathExists(path, site) == false) {
                    throw "asset integrity: " + f + " references missing " + path;
                }
                final frag = refFragment(target);
                if (frag != "") {
                    final anchors = site.pageAnchors[fragmentPageUrl(path)];
                    if (anchors != null and anchors![frag] == null) {
                        throw "asset integrity: " + f + " references missing anchor #" + frag
                            + " on " + fragmentPageUrl(path) + " (the heading it named is gone or was reworded)";
                    }
                }
            }
        }
    }
}

// orphanCheck proves every docs page is reachable by BFS from the nav roots, so a
// page with no inbound link fails the build instead of shipping unreachable.
export fun orphanCheck(site: Site) > void {
    // Every written page, keyed the way pageKey() yields, so BFS can tell a page
    // link from an asset link.
    var files: [str] = mut [<str>];
    walkGen("", files, site);
    var isPage: {str: bool} = mut {};
    foreach (f in files) {
        if (f == "index.html") { isPage[""] = true; }
        else { if (f.endsWith("/index.html")) { isPage[f.sub(0, f.len() - 11)] = true; } }
    }

    var visited: {str: bool} = mut {};
    var queue: [str] = mut [<str>];
    foreach (r in ["", "documentation", "blog", "download", "tour", "playground", "search", "public", "development"]) {
        if (isPage[r] != null and visited[r] == null) { visited[r] = true; queue.append(r); }
    }
    var head = 0;
    while (head < queue.len()) {
        final key = queue[head];
        head = head + 1;
        var path = site.outDir + "/index.html";
        if (key != "") { path = site.outDir + "/" + key + "/index.html"; }
        final fh = io\File.open(path, io\FileMode.read);
        final html = fh.readAll();
        fh.close();
        foreach (ref in scanReferencesInHTML(html, key)) {
            // A scanned ref may carry a #fragment; reachability is a property of the page.
            final k = pageKey(refPath(ref));
            if (isPage[k] != null and visited[k] == null) {
                visited[k] = true;
                queue.append(k);
            }
        }
    }

    var orphans: [str] = mut [<str>];
    foreach (p in site.docPages) {
        var dk = p.url;
        if (dk.endsWith("/")) { dk = dk.sub(0, dk.len() - 1); }
        if (visited[dk] == null) { orphans.append(p.url); }
    }
    if (orphans.len() > 0) {
        throw "orphaned pages: {orphans.len()} docs renderPage(s) unreachable from site navigation (add a link from an overview page): " + orphans.join(", ");
    }
}


export fun capture(cmd: str) > str {
    final tmp = os\tmpFilename("sitegen");
    final code = os\execute(["sh", "-c", cmd + " > " + tmp + " 2>/dev/null"]);
    if (code != 0) {
        fs\delete(tmp);
        return "";
    }
    final f = io\File.open(tmp, io\FileMode.read);
    final result = f.readAll();
    f.close();
    fs\delete(tmp);
    return result.trim();
}

// Map of repo-relative source path -> "full|short|date" of the newest commit that touched
// it, from ONE git log (newest-first, first sighting wins) instead of a git call per page.
// ">>>" can't begin a repo path, so it marks each commit header; file names follow until
// the next. Run with `git -C ..` so pathspecs and written paths are magus/-relative,
// matching site.metaPrefix.
// HISTORY_MAX caps the per-file history depth in the "History" disclosure. The log is one
// git spawn, so a higher cap is cheap; a low one keeps the <details> panel from bloating on
// hot-edit files.
final HISTORY_MAX = 8;

// buildCommits parses one git-log pass:
//   - metaCommits: path -> "full|short|stamp" of the FIRST (newest) sighting; drives the
//     always-visible "Last updated" footer line.
//   - metaHistory: path -> up to HISTORY_MAX "full|short|stamp|subject" entries, newest-
//     first; drives the collapsed history panel.
// The log prints "SUBJ:<subject>" after each ">>>" header so both fields ride together
// without a second git spawn.
export fun buildCommits(site: Site) > {str: str} {
    var m: {str: str} = mut {};
    site.metaHistory = mut {};
    final log = capture("TZ=UTC git -C " + site.root + " log --first-parent --diff-merges=first-parent --name-only "
        + "--date=format-local:'%Y-%m-%dT%H:%M:%SZ' "
        + "--format='>>>%H|%h|%cd%nSUBJ:%s' -- README.md docs blog CHANGELOG.md");
    var curHeader = "";
    var curSubject = "";
    foreach (line in log.split("\n")) {
        if (line.startsWith(">>>")) {
            curHeader = line.sub(3);
            curSubject = "";
        } else if (line.startsWith("SUBJ:")) {
            curSubject = line.sub(5);
        } else if (line != "" and curHeader != "") {
            // Newest sighting wins for the "last updated" line.
            if (m[line] == null) { m[line] = curHeader; }
            // Append to per-file history (newest-first) until HISTORY_MAX.
            var hist = site.metaHistory[line];
            if (hist == null) { hist = mut [<str>]; }
            if (hist.len() < HISTORY_MAX) {
                hist.append(curHeader + "|" + curSubject);
            }
            site.metaHistory[line] = hist;
        }
    }
    return m;
}

// checkPathExists returns true when target (gen-root-relative, no leading slash)
// resolves to a real file under gen/. Directory refs (URL ending in "/" or a plain
// slugged path) resolve to their index.html; assets pass through verbatim.
export fun checkPathExists(target: str, site: Site) > bool {
    // Empty target = gen/'s root, always the index.html landing. This shows up
    // when a page links to "../" (Parent Directory in an autoindex root) and the
    // resolver pops back to the root.
    if (target == "") { return os\execute(["test", "-f", site.outDir + "/index.html"]) == 0; }
    if (os\execute(["test", "-f", site.outDir + "/" + target]) == 0) { return true; }
    if (os\execute(["test", "-d", site.outDir + "/" + target]) == 0) {
        return os\execute(["test", "-f", site.outDir + "/" + target + "/index.html"]) == 0;
    }
    if (target.endsWith("/")) {
        return os\execute(["test", "-f", site.outDir + "/" + target + "index.html"]) == 0;
    }
    return false;
}

// normalizeGenRef applies the skip rules shared by every reference scan below (external,
// #, mailto:, javascript:, data:, tel:, root-absolute, .go/.buzz refs) to one raw href/src
// or markdown link target, then resolves what remains against pageDir into a gen-root-
// relative path. null when the raw ref should not be checked - factored out so a fix to
// the skip rules reaches both the HTML scan and the markdown-mirror scan.
fun normalizeGenRef(raw: str, pageDir: str) > str? {
    if (raw == "") { return null; }
    if (raw.startsWith("http://") or raw.startsWith("https://") or raw.startsWith("//")
        or raw.startsWith("#") or raw.startsWith("mailto:") or raw.startsWith("javascript:")
        or raw.startsWith("data:") or raw.startsWith("tel:")) { return null; }
    // Root-absolute paths (leading /) are the deploy-time reference form (404.html's
    // exception, the manifest, etc.); they resolve at the deploy base, not gen/'s root,
    // so we can't check them locally without threading in basePath. Skip.
    if (raw.startsWith("/")) { return null; }
    // .go/.buzz refs point at their GitHub location (repo-root-relative), not a site
    // asset - the markdown module rewrites .md links but leaves these untouched. Skip.
    if (raw.endsWith(".go") or raw.endsWith(".buzz")) { return null; }
    // Split the #fragment off the path. Both halves are checked, separately: the path has
    // to name a file on disk, the fragment an anchor that file offers - so the fragment
    // rides along on the returned ref as "<path>#<fragment>" rather than being dropped.
    var path = raw;
    var frag = "";
    final hash = path.indexOf("#");
    if (hash != null) { frag = path.sub(hash + 1); path = path.sub(0, hash); }
    if (path == "") { return null; }
    // Also drop a query string.
    final q = path.indexOf("?");
    if (q != null) { path = path.sub(0, q); }
    if (path == "") { return null; }
    final resolved = resolvePath(pageDir, path);
    if (frag == "") { return resolved; }
    return resolved + "#" + frag;
}

// refPath is the file half of a scanned reference ("spells/go#ops" -> "spells/go").
export fun refPath(ref: str) > str {
    final hash = ref.indexOf("#");
    if (hash == null) { return ref; }
    return ref.sub(0, hash);
}

// refFragment is the anchor half of a scanned reference, "" when it carries none.
export fun refFragment(ref: str) > str {
    final hash = ref.indexOf("#");
    if (hash == null) { return ""; }
    return ref.sub(hash + 1);
}

// fragmentPageUrl maps a resolved reference path to the clean page URL Site.pageAnchors is
// keyed by: "" for the home page, else the directory with a trailing slash. Both spellings
// of a page's file reach the same key, since the HTML scan resolves to the directory and
// the Markdown-mirror scan resolves to its index.md. An asset path simply produces a key
// no page owns, and the anchor check skips it.
export fun fragmentPageUrl(resolved: str) > str {
    var r = resolved;
    if (r.endsWith("/index.html")) { r = r.sub(0, r.len() - 11); }
    if (r.endsWith("/index.md")) { r = r.sub(0, r.len() - 9); }
    if (r == "index.html" or r == "index.md" or r == "") { return ""; }
    if (r.endsWith("/")) { return r; }
    return r + "/";
}

// scanReferencesInHTML pulls every href="..." and src="..." out of html, skipping
// external URLs, mailto:, javascript:, data:, and pure fragments. Each reference
// is returned as a gen-root-relative path (resolved against pageDir).
export fun scanReferencesInHTML(html: str, pageDir: str) > [str] {
    var refs: [str] = mut [<str>];
    var seen: {str: bool} = mut {};
    var rest = html;
    while (true) {
        final iHref = rest.indexOf("href=\"");
        final iSrc = rest.indexOf("src=\"");
        var i: int = -1;
        var advance = 0;
        if (iHref != null and iSrc != null) {
            if (iHref < iSrc) { i = iHref; advance = 6; } else { i = iSrc; advance = 5; }
        } else if (iHref != null) { i = iHref; advance = 6; }
        else if (iSrc != null) { i = iSrc; advance = 5; }
        else { i = -1; }
        if (i < 0) { return refs; }
        rest = rest.sub(i + advance);
        final end = rest.indexOf("\"");
        if (end == null) { return refs; }
        final raw = rest.sub(0, end);
        rest = rest.sub(end + 1);
        final resolved = normalizeGenRef(raw, pageDir);
        if (resolved != null and seen[resolved!] == null) {
            seen[resolved!] = true;
            refs.append(resolved!);
        }
    }
    return refs;
}

// scanReferencesInMarkdown pulls every relative "](target)" (a link or an image) out of an
// emitted .md mirror, skipping fenced code blocks - a link-looking string inside one is
// code, not prose - and applying the same skip rules scanReferencesInHTML does. Each
// reference is returned as a gen-root-relative path (resolved against pageDir), gating the
// mirror the same way assetIntegrityCheck already gates the HTML.
export fun scanReferencesInMarkdown(md: str, pageDir: str) > [str] {
    var refs: [str] = mut [<str>];
    var seen: {str: bool} = mut {};
    var inside = false;
    foreach (part in md.split("```")) {
        if (inside == false) {
            // Mask inline code the same way the fence toggle masks blocks: a call site
            // like `f["op"](ctx, opts)` carries a "](...)" that is code, not a link.
            var code = false;
            foreach (chunk in part.split("`")) {
                if (code == false) {
                    var rest = chunk;
                    var idx = rest.indexOf("](");
                    while (idx != null) {
                        rest = rest.sub(idx + 2);
                        final end = rest.indexOf(")");
                        if (end == null) { idx = null; } else {
                            final raw = rest.sub(0, end);
                            rest = rest.sub(end + 1);
                            // A link destination cannot carry a raw space or backtick.
                            if (raw.indexOf(" ") == null) {
                                final resolved = normalizeGenRef(raw, pageDir);
                                if (resolved != null and seen[resolved!] == null) {
                                    seen[resolved!] = true;
                                    refs.append(resolved!);
                                }
                            }
                            idx = rest.indexOf("](");
                        }
                    }
                }
                code = (code == false);
            }
        }
        inside = (inside == false);
    }
    return refs;
}

// walkGen recursively enumerates every written file under gen/ so the integrity check
// reads each once.
export fun walkGen(rel: str, acc: [str], site: Site) > void {
    var dir = site.outDir;
    if (rel != "") { dir = site.outDir + "/" + rel; }
    foreach (name in fs\list(dir)) {
        var childRel = name;
        if (rel != "") { childRel = rel + "/" + name; }
        if (os\execute(["test", "-d", site.outDir + "/" + childRel]) == 0) {
            walkGen(childRel, acc, site);
        } else {
            acc.append(childRel);
        }
    }
}

// pruneStaleOutputs deletes gen/ output whose source no longer produces it - a
// renamed/removed page, a deleted post, a dropped alias, a release out of CHANGELOG.md.
// gen/ is not wiped before each render, so this keeps it from accumulating orphans: for
// every "<dir>/index.html" not in writtenPaths and not in alwaysKeep, delete the whole
// directory (sibling index.md and all). Runs before assetIntegrityCheck/orphanCheck so
// neither trips on a stale page's dangling reference to content removed with it.
export fun pruneStaleOutputs(site: Site) > void {
    // Outputs never eligible for pruning: paths a normal render always rewrites regardless
    // of docs/blog content, plus the playground's committed WASM/editor bundle, which this
    // render never touches (build-playground / build-playground-editor refresh it out of
    // band).
    final alwaysKeep: {str: bool} = mut {
        "index.html": true, "index.md": true, "404.html": true,
        "install": true,
        "sitemap.xml": true, "robots.txt": true, "manifest.webmanifest": true,
        "service-worker.js": true, "search-index.json": true, "site-manifest.sha256": true,
        "site.css": true, "console.css": true, "ui-panels.css": true, "theme.css": true, "theme.js": true, "main.js": true,
        "search/index.html": true,
        "playground/index.html": true, "playground/buzz.wasm": true,
        "playground/wasm_exec.js": true, "playground/editor.js": true,
        // /console/ is owned by the standalone console/ project (copied in at deploy). The
        // docs render only emits a redirect stub there via the reference/console alias, which
        // writeAliases already registers in writtenPaths - so no alwaysKeep entry needed.
    };
    final acc: [str] = mut [<str>];
    walkGen("", acc, site);
    final staleDirs: {str: bool} = mut {};
    foreach (path in acc) {
        if (alwaysKeep[path] != null) { continue; }
        if (path.startsWith("assets/")) { continue; }   // scoped delete+recopy above already keeps this clean
        if (path.endsWith("/index.html") == false) { continue; }   // only page-shaped files drive pruning
        if (site.writtenPaths[path] != null) { continue; }
        staleDirs[path.sub(0, path.len() - 11)] = true;   // len("/index.html") == 11
    }
    foreach (dir in staleDirs.keys()) {
        // Pruning keys off a missing index.html but deletes the whole directory, so a
        // directory holding produced NON-page outputs must survive its page going away.
        // /public/atom/ (the Atom feeds) and /public/release/ (the signed release
        // manifest) are exactly that: real files, no page of their own.
        var produced = false;
        foreach (w in site.writtenPaths.keys()) {
            if (w.startsWith(dir + "/")) { produced = true; }
        }
        if (produced) { continue; }
        std\print("  pruning stale " + dir + "/ (no longer produced)");
        fs\delete(site.outDir + "/" + dir);
    }
}

// writeSiteManifest emits gen/site-manifest.sha256: one "<sha256>  <path>\n" line (standard
// sha256sum(1) format, so `sha256sum -c` verifies it directly) per file shipped under gen/,
// repo-relative, sorted. Called from generate() AFTER generateJsBundles(), not from
// site_render(), because generateJsBundles() writes gen/assets/mermaid.js and hljs.js
// (served assets) only after site_render() returns - computing the manifest earlier would
// omit them. Excludes its own output path (a file cannot hash itself).
export fun writeSiteManifest(site: Site) > void {
    final acc: [str] = mut [<str>];
    walkGen("", acc, site);
    final sorted = acc.sort(fun (a: str, b: str) > bool { return strLess(a, b); });
    var body = "";
    foreach (rel in sorted) {
        if (rel == "site-manifest.sha256") { continue; }
        body = body + fileSha256(site.outDir + "/" + rel) + "  " + rel + "\n";
    }
    fs\writeFile(site.outDir + "/site-manifest.sha256", body);
}

// pageKey normalizes a scanReferencesInHTML result (a gen-root-relative path with no
// trailing slash - "spells/go", "index.html", "assets/x.png") to a page key: "" for
// the home page, else the directory that holds the page's index.html. Asset paths
// pass through unchanged and simply never match a real page key.
export fun pageKey(resolved: str) > str {
    var r = resolved;
    if (r.endsWith("/index.html")) { r = r.sub(0, r.len() - 11); }  // len("/index.html") == 11
    if (r == "index.html") { return ""; }
    if (r.endsWith("/")) { r = r.sub(0, r.len() - 1); }
    return r;
}


// URL_LOCK is the committed, append-only ledger of every URL the site has ever
// shipped (one per line, sorted). RETIRED_URLS lists URLs intentionally removed,
// exempting them from the abandoned-link gate.
final URL_LOCK = "active.urls.lock";
final RETIRED_URLS = "retired.urls.lock";

// readURLSet reads a newline-delimited URL file into a set, skipping blanks and
// "#" comments. Missing file -> empty set (the bootstrap case for URL_LOCK).
export fun readURLSet(path: str) > {str: bool} {
    var set: {str: bool} = mut {};
    if (os\execute(["test", "-f", path]) != 0) { return set; }
    final f = io\File.open(path, io\FileMode.read);
    final content = f.readAll();
    f.close();
    foreach (line in content.split("\n")) {
        final t = line.trim();
        if (t != "" and t.startsWith("#") == false) { set[t] = true; }
    }
    return set;
}

// abandonedLinkCheck is the parity gate: every URL the site has shipped before
// (recorded in URL_LOCK) must still resolve, so a renamed or deleted page can't
// silently start 404-ing on inbound links and bookmarks. To retire a URL on
// purpose, either add a redirect (frontmatter `aliases:`, whose stub keeps the old
// URL resolving) or list it in retired.urls.lock. Runs every render; the lock only
// grows (updateUrlLock, under the rw charm).
export fun abandonedLinkCheck(site: Site) > void {
    final locked = readURLSet(URL_LOCK);
    final retired = readURLSet(RETIRED_URLS);
    var abandoned: [str] = mut [<str>];
    foreach (url in locked.keys()) {
        if (retired[url] == null and checkPathExists(url, site) == false) {
            abandoned.append(url);
        }
    }
    if (abandoned.len() > 0) {
        final sorted = abandoned.sort(fun (a: str, b: str) > bool { return strLess(a, b); });
        throw "abandoned links: {sorted.len()} previously-shipped URL(s) no longer resolve. Add a redirect (frontmatter aliases:) or list them in retired.urls.lock: " + sorted.join(", ");
    }
}

// updateUrlLock folds this build's URLs into URL_LOCK and rewrites it sorted. It
// only adds - a URL that drops out of the build stays in the ledger so the gate
// keeps demanding a redirect or an explicit retirement for it. Called under the rw
// charm so a plain (checking) render never mutates the tree.
export fun updateUrlLock(site: Site) > void {
    var set = readURLSet(URL_LOCK);
    foreach (u in site.pageUrls.keys()) { set[u] = true; }
    var lines: [str] = mut [<str>];
    foreach (u in set.keys()) { lines.append(u); }
    final sorted = lines.sort(fun (a: str, b: str) > bool { return strLess(a, b); });
    var body = "";
    foreach (u in sorted) { body = body + u + "\n"; }
    fs\writeFile(URL_LOCK, body);
}
