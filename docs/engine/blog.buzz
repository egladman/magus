// engine/blog.buzz - the blog: a single post (renderBlogPost, driven per file by
// walkBlog), the paginated index (renderBlogIndex), and their shared prev/next
// pager (renderBlogPager). Each post runs through renderPage like any doc. Two
// predicates over the post files sit above them: isPublishablePost, which every walk
// in the render shares, and findReleasePost, which picks the announcement bar's link.
namespace blog;

import "markdown";
import "fs";
import "io";
import "std";
import "serialize";
import "template";
import "lib/text" as _;
import "lib/url" as _;
import "lib/date" as _;
import "lib/html" as _;
import "engine/meta" as _;
import "engine/types" as _;
import "engine/page" as _;

// isPublishablePost reports whether blog/<name> should be rendered at all: a .md file that
// is not the index, not an _underscored fixture, and not marked `draft: true` in its
// frontmatter.
//
// A draft stays committed in the repo and renders NOWHERE - no post page, no blog index
// entry, no feed item, no announcement-bar link - so unfinished writing can be reviewed in
// a pull request without shipping to the site. The underscore prefix already skipped a
// file, but that is the fixture convention and it forces a rename to publish; `draft:` is a
// one-word edit inside the file and survives the rename.
//
// Every place that enumerates posts calls this, which is also why it exists: the name
// predicate was copied across four walks (walkBlog, the hasBlogPosts precompute,
// renderBlogPager, the landing's recentPosts) and the draft test lived in exactly one of
// them, so the front door already hid a draft the blog index went on listing.
export fun isPublishablePost(site: Site, name: str) > bool !> any {
    if (name.endsWith(".md") == false or name == "index.md" or name.startsWith("_")) {
        return false;
    }
    final f = io\File.open(site.root + "/" + site.blog + "/" + name, io\FileMode.read);
    final md = f.readAll();
    f.close();
    return serialize\jsonDecode(markdown\frontmatter(md)).q("draft").booleanValue() == false;
}

// findReleasePost sets site.releaseBlogURL to the post whose frontmatter `release:` names
// the newest release's version, or leaves it "" when no post claims it.
//
// The claim lives on the POST, not on the release manifest: a release need not have a post
// at all, and releases/*.yaml mirrors the Go ReleaseManifest that freezes index.json's v1
// schema, so an optional docs-only field has no business there. It also means a post can be
// written and merged ahead of the tag it names, and starts announcing itself the moment
// that tag exists.
export fun findReleasePost(site: Site) > void !> any {
    // Cleared up front, like loadReleases does with site.releases: `serve` re-renders into
    // a Site that already ran, and a post that stops claiming the release must stop linking.
    site.releaseBlogURL = "";
    if (site.releases.len() == 0) { return; }
    final ver = site.releases[0].version;
    final dir = fs\join(site.root, site.blog);
    if (fs\isDir(dir) == false) { return; }
    foreach (name in fs\listDir(dir)) {
        if (isPublishablePost(site, name) == false) { continue; }
        final f = io\File.open(dir + "/" + name, io\FileMode.read);
        final md = f.readAll();
        f.close();
        if (serialize\jsonDecode(markdown\frontmatter(md)).q("release").stringValue() == ver) {
            site.releaseBlogURL = site.blog + "/" + blogURLPath(name) + "/";
            return;
        }
    }
}

// renderBlogPost renders one blog/<file>.md as its own directory-index page. base is the
// basename (e.g. "2026-07-01-hello-blog.md"); the URL is date-scoped blog/YYYY/MM/DD/slug/
// (via blogURLPath), so permalinks sort by date and never collide across years. Post
// metadata is captured into site.blogPosts for the index page.
export fun renderBlogPost(base: str, site: Site) > void !> any {
    final rel = site.blog + "/" + base;
    final f = io\File.open(site.root + "/" + rel, io\FileMode.read);
    final md = f.readAll();
    f.close();

    final fm = serialize\jsonDecode(markdown\frontmatter(md));
    var title = fm.q("title").stringValue();
    if (title == "") { title = deriveTitle(md, base); }
    final date = fm.q("date").stringValue();

    // Frontmatter `date` is the byline; the filename's YYYY-MM-DD- prefix is the canonical
    // URL scope. Require them to agree so the permalink and the printed date can't drift; a
    // missing or mismatched prefix is a hard error, not a silent divergence.
    final dateDir = blogDateDirectory(base);
    if (date != "") {
        // Frontmatter dates decode as full RFC3339; take the calendar day and re-slash it to
        // compare against the filename's "YYYY/MM/DD" scope. (str.replace is first-match only,
        // so build by split.)
        final fp = date.split("T")[0].split("-");   // ["2026","07","01"]
        var fmDir = "";
        if (fp.len() >= 3) { fmDir = fp[0] + "/" + fp[1] + "/" + fp[2]; }
        if (dateDir == null) {
            throw "blog: " + rel + " has frontmatter date " + date
                + " but the filename lacks a matching YYYY-MM-DD- prefix";
        }
        if (dateDir != fmDir) {
            throw "blog: " + rel + " frontmatter date " + date
                + " disagrees with the filename date prefix";
        }
    }

    final slug = blogSlug(base);
    final urlPath = blogURLPath(base);        // "2026/07/01/hello-blog"
    final url = site.blog + "/" + urlPath + "/";
    // Blog posts sit at gen/blog/<urlPath>/index.html. The link rewriter needs both the flat
    // directory ("blog") and the date-scoped clean directory ("blog/<urlPath>") so
    // cross-references (../../documentation/) resolve at the post's real depth.
    final html = renderContentHTML(markdown\toHtml(md), site.blog, site.blog + "/" + urlPath);

    var desc = fm.q("description").stringValue();
    if (desc == "") { desc = deriveDescription(html); }
    if (desc == "") { desc = site.config.description; }

    // Dateline: a byline under the post's H1 - date, author, and a permalink to the canonical
    // URL. Inside the <article> after the title, so it reads as post metadata, not page
    // chrome. Guarded on an H1 and a date; a title-less or undated post skips it.
    var article = html;
    final h1End = html.indexOf("</h1>");
    if (h1End != null and date != "") {
        final author = fm.q("author").stringValue();
        var meta = "<p class=\"blog-post-meta\"><time datetime=\"" + blogDateAttr(date)
            + "\">" + blogDate(date) + "</time>";
        if (author != "") { meta = meta + " &middot; " + author; }
        meta = meta + " &middot; <a href=\"" + site.config.baseURL + url + "\" rel=\"bookmark\">Permalink</a></p>\n";
        final cut = h1End + 5;   // length of "</h1>"
        article = html.sub(0, cut) + "\n" + meta + html.sub(cut);
    }

    // Reverse-chronological pager: blog posts pair prev/next by date, not filename.
    final pager = renderBlogPager(base, site);

    final doc = renderPage(title, desc, article, rel, pager, url, readingTime(md), parseTags(md), generatedFrom(md), site);
    makeOutputDir(site.outDir + "/" + site.blog + "/" + urlPath, rel, url);
    final of = io\File.open(site.outDir + "/" + site.blog + "/" + urlPath + "/index.html", io\FileMode.write);
    of.write(doc);
    of.close();
    fs\writeFile(fs\join(site.outDir, site.blog, urlPath, "index.md"), md);

    site.addRecord(url, title, desc, md);
    foreach (a in fm.q("aliases").listValue()) { site.collectAlias(a.stringValue(), url); }

    site.blogPosts.append(BlogPost{
        base = base, slug = slug, urlPath = urlPath, title = title,
        date = date, description = desc, url = url, tags = parseTags(md).join("||"),
    });
}


// renderBlogPager renders the prev/next links between posts, ordered by date newest-first
// so "prev" is newer and "next" is older (timeline intuition). Falls back to filename order
// when a post lacks a date.
fun renderBlogPager(base: str, site: Site) > str !> any {
    // Rebuild the ordering deterministically from disk (site.blogPosts may be partial
    // during the walk). Newest first.
    var posts: mut [BlogPost] = mut [<BlogPost>];
    foreach (name in fs\listDir(fs\join(site.root, site.blog))) {
        if (isPublishablePost(site, name)) {
            final f = io\File.open(site.root + "/" + site.blog + "/" + name, io\FileMode.read);
            final md = f.readAll();
            f.close();
            final fm = serialize\jsonDecode(markdown\frontmatter(md));
            var t = fm.q("title").stringValue();
            if (t == "") { t = deriveTitle(md, name); }
            posts.append(BlogPost{ base = name, date = fm.q("date").stringValue(), title = t });
        }
    }
    if (posts.len() < 2) { return ""; }
    // Sort by date DESC, tiebreak by filename ASC so ordering is stable when two
    // posts share a date.
    final ordered = posts.sort(fun (a: BlogPost, b: BlogPost) > bool {
        if (a.date != b.date) { return strLess(b.date, a.date); }
        return strLess(a.base, b.base);
    });

    var pos = -1;
    var i = 0;
    while (i < ordered.len()) {
        if (ordered[i].base == base) { pos = i; }
        i = i + 1;
    }
    if (pos < 0) { return ""; }

    // Posts are date-scoped (blog/YYYY/MM/DD/slug/), so a sibling link isn't a flat
    // "../<slug>/": relativePath walks from this post's dir to the target and writes the
    // minimal climb, correct across any shared date prefix.
    final fromDir = site.blog + "/" + blogURLPath(base);
    var body = "";
    // Previous = newer post (earlier in ordered), Next = older post (later).
    if (pos > 0) {
        final prev = ordered[pos - 1];
        final href = relativePath(fromDir, site.blog + "/" + blogURLPath(prev.base) + "/");
        body = body + "      <a class=\"page-nav-prev\" href=\"" + href + "\">"
            + "<span class=\"page-nav-dir\">Newer</span>"
            + "<span class=\"page-nav-title\">" + prev.title + "</span></a>\n";
    }
    if (pos < ordered.len() - 1) {
        final nxt = ordered[pos + 1];
        final href = relativePath(fromDir, site.blog + "/" + blogURLPath(nxt.base) + "/");
        body = body + "      <a class=\"page-nav-next\" href=\"" + href + "\">"
            + "<span class=\"page-nav-dir\">Older</span>"
            + "<span class=\"page-nav-title\">" + nxt.title + "</span></a>\n";
    }
    if (body == "") { return ""; }
    return "    <nav class=\"page-nav\" aria-label=\"Pagination\">\n" + body + "    </nav>\n";
}


// renderBlogIndex writes gen/blog/index.html, a reverse-chronological list of the collected
// posts. Runs AFTER renderBlogPost has populated site.blogPosts. A plain <ul> under
// renderPage(), so it inherits nav/breadcrumb/footer.
export fun renderBlogIndex(site: Site) > void !> any {
    // Newest first, tiebreak by base for determinism.
    final sorted = site.blogPosts.sort(fun (a: BlogPost, b: BlogPost) > bool {
        if (a.date != b.date) { return strLess(b.date, a.date); }
        return strLess(a.base, b.base);
    });

    // View-model per post; date/description are optional (gated by hasDate/hasDesc).
    var posts: mut [{str: any}] = mut [<{str: any}>];
    foreach (p in sorted) {
        final rec = mut {<str: any>};
        rec["urlPath"] = p.urlPath;
        rec["title"] = p.title;
        rec["hasDate"] = p.date != "";
        if (p.date != "") {
            rec["dateAttr"] = blogDateAttr(p.date);
            rec["dateDisplay"] = blogDate(p.date);
        }
        rec["hasDesc"] = p.description != "";
        rec["description"] = p.description;
        posts.append(rec);
    }
    // Same card component the home page uses for "Recent writing", so the two read as
    // one system rather than a styled front door and a bare <ul> behind it. The date
    // takes .landing-card-mark, the slot the home page's 01/02/03 numerals sit in - it
    // is the small muted monospace label, and a date is exactly that.
    final body = template\render(`<h1>Blog</h1>
<p class="landing-section-lede">Why things are the way they are, at more length than a documentation page should go to.</p>
{{#hasPosts}}
<div class="landing-cards landing-cards-compact">
{{#posts}}
  <a class="landing-card" href="{{urlPath}}/">{{#hasDate}}<time class="landing-card-mark" datetime="{{dateAttr}}">{{dateDisplay}}</time>{{/hasDate}}<span class="landing-card-title">{{title}}</span>{{#hasDesc}}<span class="landing-card-body">{{description}}</span>{{/hasDesc}}</a>
{{/posts}}
</div>
{{/hasPosts}}
{{^hasPosts}}
<p>No posts yet.</p>
{{/hasPosts}}
`, {"hasPosts": sorted.len() > 0, "posts": posts});

    final title = "Blog";
    final desc = "The magus blog. Release notes, deep dives, and behind-the-scenes writeups.";
    final url = site.blog + "/";
    // srcRel is a blog/index.md marker (no source file) so renderPage() picks the "blog"
    // nav key and roots the breadcrumb. Alias its commit-footer key to the newest post's
    // commit so "Last updated" is a stable snapshot, not HEAD - which would drift every
    // commit and break the drift gate.
    if (sorted.len() > 0) {
        final rec = site.metaCommits[site.metaPrefix + site.blog + "/" + sorted[0].base];
        if (rec != null) { site.metaCommits[site.metaPrefix + site.blog + "/index.md"] = rec; }
    }
    final doc = renderPage(title, desc, body, site.blog + "/index.md", "", url, "", mut [], "", site);
    fs\mkdirAll(fs\join(site.outDir, site.blog));
    final of = io\File.open(site.outDir + "/" + site.blog + "/index.html", io\FileMode.write);
    of.write(doc);
    of.close();
    // A real page, so it belongs in the search index and sitemap. No frontmatter
    // tags/description; the resolved desc above rides through.
    site.pageUrls[url] = true;
    // Build a fake mini record so addRecord's shape stays consistent.
    final recStub = "---\ntitle: " + title + "\ndescription: " + desc + "\ntags: []\n---\nBlog listing.\n";
    site.addRecord(url, title, desc, recStub);
    std\print("  blog index -> " + site.outDir + "/" + site.blog + "/index.html");
}
