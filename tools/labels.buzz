// This repository's label taxonomy, printed as the `gh label` commands that bring a
// repository to it. It never runs them: labels are host state a person changes.
//
//	magus buzz tools/labels.buzz -- [--repo <owner/name>]
//
// Two families, told apart by prefix and color: a person's intent (`merge-queue:
// <method>`, `advice: silence[ <advisor>]`) and the queue's answer (`queue: <state>`).
// The queue's labels mirror MARK_LABELS, MARK_COLORS and MARK_DESCRIPTIONS in
// internal/queue/provider/github.buzz, which creates a missing one itself; creating them
// here settles colors on a repository that already has them.
namespace labels;

import "flags";
import "std";

import "assert";

object Label {
    name: str,
    color: str,
    description: str,
}

final METHODS = ["squash", "rebase", "merge"];

// GitHub's defaults (this repository has never had an issue), the orphans #372 left, and
// the queue's marks before they moved to `queue:`.
final RETIRED = [
    "merge-queue: queued", "merge-queue: kicked back", "merge-queue: needs regeneration",
    "magus:regenerate:requested", "magus:regenerate:done",
    "bug", "documentation", "duplicate", "enhancement", "good first issue", "help wanted", "invalid", "question", "wontfix",
];

fun intentLabels() > [Label] {
    final acc = mut [<Label>];
    foreach (m in METHODS) {
        acc.append(Label{ name = "merge-queue: {m}", color = "0E8A16",
            description = "Queue this pull request, or the stack it tops, to merge by {m}" });
    }
    return acc;
}

final ANSWERS = [
    Label{ name = "queue: queued", color = "1d76db", description = "The queue holds it; the merge-queue status says what it waits on" },
    Label{ name = "queue: kicked back", color = "b60205", description = "The queue kicked it back; its newest queue comment says why" },
    Label{ name = "queue: needs regeneration", color = "fbca04", description = "Merge the base in, regenerate, push; the queue then takes it" },
    Label{ name = "advice: silence", color = "e4e669", description = "Mutes every advisor on this pull request; advice: silence <name> mutes one" },
];

// quote leaves a word bare when a shell reads it as one, and double-quotes it otherwise.
// No label here holds a character a double quote would still expand.
fun quote(s: str) > str {
    foreach (c in [" ", ";", "'", "(", ")", "&", "|", "<", ">"]) {
        if (s.indexOf(c) != null) {
            return "\"" + s + "\"";
        }
    }
    return s;
}

fun line(args: [str]) > str {
    final words = mut [<str>];
    foreach (a in args) {
        words.append(quote(a));
    }
    return words.join(" ");
}

// commands is every `gh label` command, deletes first so a rename never meets its old name.
export fun commands(repo: str) > [str] {
    final acc = mut [<str>];
    foreach (name in RETIRED) {
        acc.append(line(["gh", "label", "delete", "-R", repo, name, "--yes"]));
    }
    foreach (l in intentLabels()) {
        acc.append(line(["gh", "label", "edit", "-R", repo, l.name, "--color", l.color, "--description", l.description]));
    }
    foreach (l in ANSWERS) {
        acc.append(line(["gh", "label", "create", "-R", repo, l.name, "--color", l.color, "--description", l.description, "--force"]));
    }
    return acc;
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: [<str>], valued: ["--repo"]);
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "labels: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\nusage: magus buzz tools/labels.buzz -- [--repo <owner/name>]";
    }
    foreach (c in commands(parsed.values["--repo"] ?? "egladman/magus")) {
        std\print(c);
    }
}

test "every label GitHub would accept: a six-digit color and a description of at most 100 characters" {
    final all = mut [<Label>];
    foreach (l in intentLabels()) { all.append(l); }
    foreach (l in ANSWERS) { all.append(l); }
    foreach (l in all) {
        assert\equal(l.color.len(), want: 6, message: "{l.name}'s color");
        assert\equal(l.description != "" and l.description.len() <= 100, want: true, message: "{l.name}'s description");
        foreach (c in ["\"", "$", "\\", "`", "!"]) {
            assert\equal(l.name.indexOf(c) == null and l.description.indexOf(c) == null, want: true, message: "{l.name} survives double quotes");
        }
    }
}

test "a person's labels and the queue's never share a prefix" {
    foreach (l in ANSWERS) {
        assert\equal(l.name.startsWith("merge-queue: "), want: false, message: l.name);
    }
    foreach (name in RETIRED) {
        foreach (l in ANSWERS) {
            assert\equal(name != l.name, want: true, message: "{name} is retired and created");
        }
    }
}

test "the commands delete, then edit the intent labels, then create the answers" {
    final got = commands("o/r");
    assert\equal(got.len(), want: RETIRED.len() + METHODS.len() + ANSWERS.len(), message: "one command per label");
    assert\equal(got[0], want: `gh label delete -R o/r "merge-queue: queued" --yes`, message: "an old mark");
    assert\equal(got[5], want: `gh label delete -R o/r bug --yes`, message: "a bare word stays bare");
    assert\equal(got[RETIRED.len()],
        want: `gh label edit -R o/r "merge-queue: squash" --color 0E8A16 --description "Queue this pull request, or the stack it tops, to merge by squash"`,
        message: "an intent label keeps its name");
    assert\equal(got[got.len() - 1],
        want: `gh label create -R o/r "advice: silence" --color e4e669 --description "Mutes every advisor on this pull request; advice: silence <name> mutes one" --force`,
        message: "the mute");
}
