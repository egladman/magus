// This repository's file linter: the conventions on its non-Go files that no compiler or
// off-the-shelf linter checks. The root lint-files target runs it:
//
//	magus buzz tools/lint.buzz
//
// Each rule is a file tools/lint/<rule>.buzz exporting reads(), the globs it reads, and
// check(files), which returns a Finding per violation. The runner walks the tree once,
// hands each rule the files its globs match, prints every finding as
// `path:line:col: message [rule]` with the fix indented under it, and exits 1 when there
// is any. A glob that matches nothing is itself a finding: a rule reading a file the tree
// no longer has is misconfigured, not clean.
namespace lint;

import "assert";
import "fs";
import "os";
import "path";
import "std";
import "magus/lint";
import "tools/lint/buzz-glue-is-wired-as-plain-argv" as buzzglue;
import "tools/lint/generate-drift-throw-names-the-engine-drift-code" as generatedrift;
import "tools/lint/landing-rotator-slots-match-headline-count" as landing;
import "tools/lint/lockfiles-are-sorted" as lockfiles;

export object Rule {
    name: str,
    reads: [str],
    check: fun (files: [Path]) > [Finding] !> any,
}

// rules is every rule that runs. A rule file nothing names here never runs.
export fun rules() > [Rule] {
    return [
        Rule{ name = "lockfiles-are-sorted", reads = lockfiles\reads(), check = lockfiles\check },
        Rule{ name = "generate-drift-throw-names-the-engine-drift-code", reads = generatedrift\reads(), check = generatedrift\check },
        Rule{ name = "landing-rotator-slots-match-headline-count", reads = landing\reads(), check = landing\check },
        Rule{ name = "buzz-glue-is-wired-as-plain-argv", reads = buzzglue\reads(), check = buzzglue\check },
    ];
}

// PRUNED are the directories the walk never enters: VCS metadata, local state, installed
// dependencies and generated output hold nothing this repository authors.
final PRUNED = {".git": true, ".magus": true, "node_modules": true, "gen": true};

// PRUNED_PATHS are pruned by their whole path: other checkouts of this repository, whose
// files would each be reported twice.
final PRUNED_PATHS = {".claude/worktrees": true};

// walk returns every file under root outside the pruned trees, as root-relative paths.
export fun walk(root: str) > [str] !> any {
    final acc = mut [<str>];
    walkInto(root, rel: "", acc: acc);
    return acc;
}

fun walkInto(root: str, rel: str, acc: mut [str]) > void !> any {
    final dir = if (rel == "") root else root + "/" + rel;
    foreach (name in fs\listDir(dir)) {
        final p = if (rel == "") name else rel + "/" + name;
        if (!fs\isDir(root + "/" + p)) {
            acc.append(p);
        } else if (PRUNED[name] == null and PRUNED_PATHS[p] == null) {
            walkInto(root, rel: p, acc: acc);
        }
    }
}

// select returns the files each of reads matches, and the globs matching none.
export fun select(files: [str], reads: [str]) > obj{ matched: [Path], unmatched: [str] } !> any {
    final matched = mut [<Path>];
    final unmatched = mut [<str>];
    foreach (glob in reads) {
        var hit = false;
        foreach (f in files) {
            if (path\matches(glob, path: f)) {
                hit = true;
                break;
            }
        }
        if (!hit) {
            unmatched.append(glob);
        }
    }
    foreach (f in files) {
        if (path\matchesAny(reads, path: f)) {
            matched.append(Path{ value = f });
        }
    }
    return .{ matched = matched, unmatched = unmatched };
}

// run applies each rule to the files it reads and returns every finding, stamped with
// its rule.
export fun run(rules: [Rule], files: [str]) > [Finding] !> any {
    final found = mut [<Finding>];
    foreach (r in rules) {
        final sel = select(files, reads: r.reads);
        foreach (glob in sel.unmatched) {
            found.append(Finding{ path = "tools/lint/" + r.name + ".buzz", rule = r.name,
                message = "reads " + glob + ", which matches no file in the tree",
                fix = "Restore the file, or update the rule's reads() to what it reads now." });
        }
        if (sel.unmatched.len() > 0) {
            continue;
        }
        foreach (f in r.check(sel.matched)) {
            found.append(Finding{ path = f.path, line = f.line, col = f.col, rule = r.name,
                message = f.message, fix = f.fix, url = f.url });
        }
    }
    return found;
}

// render is a finding as the runner prints it.
export fun render(f: Finding) > str {
    var pos = f.path;
    if (f.line > 0) {
        pos = pos + ":{f.line}";
        if (f.col > 0) {
            pos = pos + ":{f.col}";
        }
    }
    var s = pos + ": " + f.message + " [" + f.rule + "]";
    if (f.fix != "") {
        s = s + "\n    " + f.fix.replace("\n", with: "\n    ");
    }
    if (f.url != "") {
        s = s + "\n    see: " + f.url;
    }
    return s;
}

export fun main(args: [str]) > void !> any {
    final all = rules();
    final found = run(all, files: walk("."));
    foreach (f in found) {
        std\print(render(f));
    }
    if (found.len() > 0) {
        std\print("lint: {found.len()} finding(s)");
        os\exit(1);
    }
    std\print("lint: {all.len()} rules, no findings");
}

test "render names the position, message, rule and indented fix" {
    assert\equal(render(Finding{ path = "a.lock", line = 3, rule = "r", message = "b follows c", fix = "Move it.\nSecond line." }),
        want: "a.lock:3: b follows c [r]\n    Move it.\n    Second line.", message: "full");
    assert\equal(render(Finding{ path = "a.lock", line = 3, col = 7, rule = "r", message = "m" }), want: "a.lock:3:7: m [r]", message: "column");
    assert\equal(render(Finding{ path = "a.lock", rule = "r", message = "gone" }), want: "a.lock: gone [r]", message: "no line");
}

test "every finding is stamped with the rule that found it" {
    final rule = Rule{ name = "always", reads = ["*.lock"],
        check = fun (files: [Path]) > [Finding] !> any => [Finding{ path = files[0].value, message = "m" }] };
    final got = run([rule], files: ["x.lock", "y.txt"]);
    assert\equal(got.len(), want: 1, message: "one finding");
    assert\equal(got[0].rule, want: "always", message: "stamped");
    assert\equal(got[0].path, want: "x.lock", message: "the matched file");
}

test "a glob that matches nothing is a finding, and its rule does not run" {
    final rule = Rule{ name = "absent", reads = ["x.lock", "gone.json"],
        check = fun (files: [Path]) > [Finding] !> any => [Finding{ message = "ran" }] };
    assert\equal(run([rule], files: ["x.lock"]).len(), want: 1, message: "only the unmatched glob");
    assert\equal(run([rule], files: ["x.lock"])[0].message, want: "reads gone.json, which matches no file in the tree", message: "message");
}

test "the walk prunes what no rule reads" {
    final root = fs\tempDir("lint-walk-");
    foreach (p in ["a.lock", "gen/b.lock", "x/node_modules/c.lock", ".claude/worktrees/w/d.lock", ".claude/settings.json"]) {
        fs\mkdirAll(fs\dirname(root + "/" + p));
        fs\writeFile(root + "/" + p, content: "");
    }
    final got = walk(root);
    assert\equal(got.len(), want: 2, message: "two files survive");
    assert\contains(got, item: "a.lock", message: "top level");
    assert\contains(got, item: ".claude/settings.json", message: ".claude outside worktrees");
}
