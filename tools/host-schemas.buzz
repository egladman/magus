// host-schemas.buzz refreshes the agent-host schemas vendored under
// testdata/hosts, and says when one has moved upstream.
//
// The schemas are what host_schema_test.go grades this repository's hook configs and
// rendered verdicts against. Vendoring them is what keeps that test off the network;
// this script is the other half, because a vendored copy with nothing that re-fetches
// it is a snapshot that quietly ages into a claim about a host that no longer exists.
//
// Two modes, and the split is the same one tools/registry.buzz makes for the same
// reason: reading upstream and WRITING from it are different acts, and only one of them
// should be able to change the tree.
//
//	HOST_SCHEMAS_MODE=verify  magus buzz tools/host-schemas.buzz   re-fetch, report drift, write nothing
//	HOST_SCHEMAS_MODE=fetch   magus buzz tools/host-schemas.buzz   re-fetch and write the moved files
//
// verify is the default, so a mistyped mode reports rather than overwrites.
//
// Only the rows the provenance table marks `published` can be refreshed. A `derived` or
// `derived-from-binary` row is ours, transcribed by hand from a host that publishes no
// schema for that surface, and its URL serves prose or a shipped artifact rather than
// bytes to diff, so this names it and moves on rather than pretending to have checked it.
//
// Run from the workspace root: every path here is relative to it, the way `magus buzz`
// resolves them.
namespace hosts;

import "std";
import "fs";
import "os";
import "http";
import "crypto";
import "archive";

final SOURCES = "testdata/hosts/SOURCES.md";
final DIR = "testdata/hosts";

// code reads a column the table quotes in backticks, which is every path and URL.
// Split rather than replace because this file runs WITHOUT --embedded, so strict mode
// applies and a two-argument method call is the form that does not parse.
fun code(cells: [str], index: int) > str {
    return cells[index].split("`")[1];
}

// plain reads an unquoted column.
fun plain(cells: [str], index: int) > str {
    return cells[index].trim();
}

// checkUpstream digests the bundles the `derived` rows were transcribed FROM, and reports
// how many have moved.
//
// It is the half the first table cannot cover. Those rows hash OUR transcription, so they
// answer "has anyone edited our file" and never "has the host changed the thing we copied".
// A derived schema with no watch on its source is a snapshot that ages into a claim about a
// host that no longer exists, which is the same failure vendoring was adopted to prevent.
//
// REPORTS, never writes. The bundle is minified JavaScript and the schema is a reading of
// it, so there is nothing to regenerate: a moved digest means a person re-reads the
// validator. That is why this has no fetch arm while the published rows above do.
fun checkUpstream() > int !> any {
    var rows = 0;
    var moved = 0;
    var inTable = false;
    foreach (line in fs\readFile(SOURCES).split("\n")) {
        if (line.startsWith("## Upstream artifacts")) { inTable = true; continue; }
        // Any later heading ends the table; without this the parser walks the rest of the
        // file and reads a prose backtick as a row.
        if (inTable and line.startsWith("## ")) { break; }
        if (!inTable or !line.startsWith("| `")) { continue; }
        final cells = line.split("|");
        if (cells.len() < 7) { continue; }

        final pkg = code(cells, index: 1);
        // plain, not code: a version is a bare number in the table, and reading it as a
        // backticked cell indexes past the end of a split that found no backtick.
        final version = plain(cells, index: 2);
        final inner = code(cells, index: 3);
        final marker = code(cells, index: 4);
        final recorded = code(cells, index: 5);
        rows = rows + 1;

        // The registry's own tarball URL, which is immutable per version: the point of
        // pinning here rather than at a vendor download that rebuilds under its own URL.
        // A scoped name (@cursor/sdk) puts only the unscoped half in the filename, while
        // the path keeps the scope. An if rather than a ternary: this file runs without
        // --embedded, where upstream-strict parsing rejects the compact form.
        final scope = pkg.split("/");
        var name = scope[0];
        if (scope.len() > 1) {
            name = scope[1];
        }
        final tarball = "https://registry.npmjs.org/" + pkg + "/-/" + name + "-" + version + ".tgz";
        final digest = digestInsideTarball(tarball, inner: inner, marker: marker);
        if (digest == recorded) {
            std\print("same {pkg}@{version} {inner}");
            continue;
        }
        moved = moved + 1;
        std\print("MOVED {pkg}@{version} {inner}: upstream hashes {digest}, the table records {recorded}; re-read the validator by hand");
    }
    if (rows == 0) {
        throw "host-schemas: {SOURCES} has no Upstream artifacts table, so no derived row's source is watched";
    }
    return moved;
}

// SLICE is how much of the file after the marker gets digested.
//
// It has to be STABLE and big enough to cover the declaration a schema was read from.
// "Big enough" is the half that was got wrong: this was 512 bytes on the claim that it
// "holds SyncHookJSONOutput's whole body", and it does not. Measured in sdk.d.ts, the body's
// scalar fields end around marker+490 and the hookSpecificOutput union runs to marker+1187,
// so a 512-byte window stopped at the literal text `hookSpecificOutput?: ` and digested none
// of the twenty arms after it. Adding an arm -- the exact upstream change this tripwire was
// built to catch -- moved nothing inside the window and reported `same`.
//
// 2048 covers that declaration with headroom and still fails closed, because a marker the
// tool cannot find is an error. When a new row's declaration is longer than this, raise it
// rather than trimming the row: a window that ends mid-declaration is a tripwire that
// reports success for the change it exists to see.
//
// Changing it invalidates every recorded digest at once, so it is a constant rather than a
// per-row column nobody would tune correctly.
final SLICE = 2048;

// digestInsideTarball fetches an npm tarball and returns the sha256 of a WINDOW of one file
// inside it, starting at marker.
//
// archive\readFile rather than uncompress: only one entry is wanted, and unpacking a whole
// package to read it costs the disk and leaves a tree to clean up. The tarball still lands
// on disk because the archive module works on paths, and it is removed before returning.
//
// `package/` is the prefix npm gives every entry, so the recorded path stays the one a
// reader sees in the published package rather than carrying that prefix around.
fun digestInsideTarball(url: str, inner: str, marker: str) > str !> any {
    final tgz = fs\tempFile("magus-upstream");
    fs\writeFile(tgz, content: http\get(url, opts: {"fail": true}).body);
    final body = archive\readFile(tgz, name: "package/" + inner);
    fs\remove(tgz);

    final at = body.indexOf(marker);
    // Loud, because this is the one way a slice can go quietly wrong. A renamed
    // declaration or a reordered chunk leaves the marker absent, and digesting some other
    // window would report a match against a region nobody chose.
    if (at == null) {
        throw "host-schemas: {url} carries {inner} but not \"{marker}\"; the declaration moved, so the recorded marker is stale and nothing was checked";
    }
    var end = at + SLICE;
    if (end > body.len()) {
        end = body.len();
    }
    return crypto\sha256Hex(body.sub(at, len: end - at));
}

export fun main() > void !> any {
    final mode = os\env("HOST_SCHEMAS_MODE") ?? "verify";
    if (mode != "verify" and mode != "fetch") {
        throw "host-schemas: HOST_SCHEMAS_MODE must be verify or fetch; got \"" + mode + "\"";
    }

    var checked = 0;
    var moved = 0;
    foreach (line in fs\readFile(SOURCES).split("\n")) {
        // The upstream table below has the same row shape and different columns, so this
        // loop has to stop where it starts or it reads a package name as a file path.
        if (line.startsWith("## Upstream artifacts")) { break; }
        // Every data row opens with a backticked file path; the header and the
        // separator do not, which is what keeps this from parsing them as rows.
        if (!line.startsWith("| `")) { continue; }
        final cells = line.split("|");
        if (cells.len() < 7) { continue; }

        final file = code(cells, index: 1);
        final origin = plain(cells, index: 2);
        if (origin != "published") {
            std\print("skip {file}: {origin}, so " + code(cells, index: 3) + " has no bytes to diff; re-read it by hand");
            continue;
        }

        final url = code(cells, index: 3);
        final recorded = code(cells, index: 5);
        final body = http\get(url, opts: {"fail": true}).body;
        final digest = crypto\sha256Hex(body);
        checked = checked + 1;

        if (digest == recorded) {
            std\print("same {file}");
            continue;
        }
        moved = moved + 1;
        if (mode == "fetch") {
            fs\writeFile(DIR + "/" + file, content: body);
            std\print("wrote {file}: sha256 is now {digest}, so put that and today's date in {SOURCES}");
            continue;
        }
        std\print("MOVED {file}: upstream hashes {digest}, the table records {recorded}");
    }

    // A table that matched no row means the format changed under this parser, and a
    // silent zero would read exactly like a clean run.
    if (checked == 0) {
        throw "host-schemas: {SOURCES} named no published row, so nothing was checked";
    }

    // Counted apart from `moved`, because the two have different remedies and one message
    // covering both sends a reader to a mode that cannot help them: fetch rewrites a
    // published schema from upstream bytes, and an upstream bundle has none to rewrite
    // from. A moved bundle is read by a person.
    final upstreamMoved = checkUpstream();
    if (mode == "fetch") {
        std\print("fetched {checked} published schema(s); {moved} changed");
        return;
    }
    // verify only. A moved schema is a finding, not an error to swallow: the tree still
    // holds the old bytes, and whoever refreshes them owns the test failures that follow.
    if (moved > 0) {
        throw "host-schemas: {moved} of {checked} vendored schema(s) moved upstream. Re-run with HOST_SCHEMAS_MODE=fetch, then update the sha256 and read date in {SOURCES} in the same commit as whatever had to change with them";
    }
    // Its own arm, and deliberately no fetch instruction: the bundle is minified
    // JavaScript, our schema is a READING of it, and no mode here can redo that reading.
    if (upstreamMoved > 0) {
        throw "host-schemas: {upstreamMoved} upstream bundle(s) changed since the derived schemas were read. Re-read the validator in the named file, update the derived schemas and both digests in {SOURCES}, and record today as the read date";
    }
    std\print("checked {checked} published schema(s) and every upstream bundle; all match what {SOURCES} records");
}
