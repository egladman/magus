// This repository's GitHub Actions steps for the merge queue, here so
// .github/workflows/queue.yaml and queue-apply.yaml carry no shell of their own. It is
// this repository's glue, not part of magus. Each step is one invocation of `magus
// queue`, the magus the workflow built from main:
//
//	magus buzz tools/gha-queue.buzz -- plan --depth <n>         plan the queue; write the validation matrix
//	magus buzz tools/gha-queue.buzz -- validate --change <id>   validate one change of the plan
//	magus buzz tools/gha-queue.buzz -- planned --run <id>       write whether validation run <id> plans at all
//	magus buzz tools/gha-queue.buzz -- apply --run <id> --base <branch> [--app <slug> --committer <who>]
//	                                                            merge what the run uploads onto the base,
//	                                                            as the queue app when one is named
//
// The `--` hands the rest to the script; without it magus would parse the flags itself.
// What the runner provides (GITHUB_REPOSITORY, RUNNER_TEMP, GITHUB_OUTPUT, the token) is
// read from its environment; everything the workflow decides is an argument. The decisions (which changes the matrix holds,
// each command's argv, whether anything merged) are pure functions tested at the
// bottom; the process calls are not, since exercising them means running the queue.
//
// Applying never runs pull-request code: the apply step runs magus, git and gh from main's
// checkout, and main's own regeneration on a merge the workspace proved runs none of the
// change's code.
namespace queue;

import "flags";
import "fs";
import "os";
import "proc";
import "serialize";

import "assert";

// main's workflows the apply step starts after a merge the queue made with the job's
// Actions token, which starts none. A merge GitHub's auto-merge made starts them itself.
final DISPATCH = ["ci.yaml", "cd.yaml", "queue.yaml"];

fun encode(doc: {str: any}) > str {
    return serialize\jsonEncode(serialize\Boxed.init(doc));
}

// need reads what the runner provides; it is never how a workflow passes an input.
fun need(name: str) > str !> any {
    final v = os\env(name) ?? "";
    if (v == "") {
        throw "queue: {name} is not set; the runner provides it";
    }
    return v;
}

// validatedIDs lists the changes the plan gives a validation job: the first `depth` of
// each partition. The rest wait for the run the next merge starts.
export fun validatedIDs(plan: str) > [str] !> any {
    final doc = serialize\jsonDecode(plan);
    final depth = doc.q("depth").integerValue();
    final ids = mut [<str>];
    foreach (partition in doc.q("partitions").listValue()) {
        final changes = partition.listValue();
        var i = 0;
        while (i < changes.len() and i < depth) {
            ids.append(changes[i].q("id").stringValue());
            i = i + 1;
        }
    }
    return ids;
}

// outputs renders the plan job's $GITHUB_OUTPUT lines: the validation matrix and its size.
export fun outputs(ids: [str]) > str {
    final include = mut [<{str: str}>];
    foreach (id in ids) {
        include.append({"change": id});
    }
    return "matrix=" + encode({"include": include}) + "\ncount={ids.len()}\n";
}

// planArgs passes no --facts: the queue asks this checkout's magus workspace itself.
export fun planArgs(dir: str, depth: str) > [str] {
    return ["queue", "plan", "--changes", dir + "/changes.json", "--provider", "github", "--depth", depth,
        "--out", dir + "/plan.json"];
}

// SCRATCH puts every cache a hook writes in the candidate's own scratch directory: a
// cache shared between candidates would let one change's hook plant a result, or a
// module, another candidate's gate then trusts. The queue sets them, so the hook lines
// stay ones a person can run as they are.
final SCRATCH = ["--scratch-env", "MAGUS_CACHE_DIR=magus", "--scratch-env", "GOCACHE=go-build",
    "--scratch-env", "GOMODCACHE=go-mod", "--scratch-env", "XDG_CACHE_HOME=cache"];

// validateArgs keeps $MERGEQUEUE_ONTO literal: the queue sets it for each hook.
// The plan arrives on stdin; validate() feeds it.
export fun validateArgs(dir: str, change: str) > [str] {
    final args = mut ["queue", "validate", "--stdin", "--only", change, "--verdicts", dir + "/verdicts",
        "--gate", `magus affected ci --base "$MERGEQUEUE_ONTO" --no-default-charms`,
        "--regenerate", `magus affected generate:rw --base "$MERGEQUEUE_ONTO"`];
    foreach (a in SCRATCH) {
        args.append(a);
    }
    return args;
}

// applyArgs polls every 15s: each poll is two API requests on the job's Actions token,
// which GitHub limits to 1,000 an hour per repository. The regeneration is main's own,
// run in magus's sandbox on exactly the projects that generate the files a merge needs
// regenerated; the queue runs it only once the workspace proves the change touches none
// of their code. committer and app are the queue app's, from the workflow; empty, the
// provider names who commits each update commit and the credential is the job's token.
export fun applyArgs(run: str, repo: str, committer: str, app: str) > [str] {
    final args = mut ["queue", "apply", "--provider", "github", "--status-context", "merge-queue", "--interval", "15s",
        "--regenerate", `MAGUS_SANDBOX_ENABLED=1 magus run generate:rw $MERGEQUEUE_UNITS`];
    foreach (a in SCRATCH) {
        args.append(a);
    }
    if (committer != "") {
        args.append("--committer");
        args.append(committer);
    }
    if (app != "") {
        args.append("--app");
        args.append(app);
    }
    args.append("run:{repo}/runs/{run}");
    return args;
}

// queueMerged reports whether apply's JSONL events record a merge the queue made itself,
// one not marked by_provider.
export fun queueMerged(events: str) > bool !> any {
    foreach (line in events.split("\n")) {
        if (!line.trim().startsWith("\{")) {
            continue;
        }
        final e = serialize\jsonDecode(line);
        if (e.q("kind").stringValue() == "merged" and !e.q("by_provider").booleanValue()) {
            return true;
        }
    }
    return false;
}

// dispatches names the workflows to start on main: all of them when the queue merged
// something itself on the job's Actions token, whose merges start none. The queue app's
// merges start them themselves, so with an app nothing is dispatched.
export fun dispatches(queueMerged: bool, app: str) > [str] {
    if (!queueMerged or app != "") {
        return [<str>];
    }
    return DISPATCH;
}

// Credential is apply's optional pair: the queue app's slug and the committer its bot
// pushes as, both empty when the job runs on its own Actions token.
object Credential {
    app: str,
    committer: str,
}

// credentialOf pairs apply's --app and --committer. setup-magus reports the two together
// or neither, so one without the other is a workflow bug.
export fun credentialOf(app: str, committer: str) > Credential !> any {
    if ((app == "") != (committer == "")) {
        throw "queue: apply takes --app and --committer together or neither";
    }
    return Credential{ app = app, committer = committer };
}

// planRan reads `gh run view --json status,jobs` of a validation run: whether its plan
// job runs, or null while the run has not said. queue.yaml skips the plan on a pull
// request event without merge intent, and a run cancelled while it waited for the one
// ahead of it ends with no plan job at all.
export fun planRan(view: str) > bool? !> any {
    final run = serialize\jsonDecode(view);
    foreach (job in run.q("jobs").listValue()) {
        if (job.q("name").stringValue() == "queue plan") {
            return job.q("conclusion").stringValue() != "skipped";
        }
    }
    if (run.q("status").stringValue() == "completed") {
        return false;
    }
    return null;
}

// capture runs cmd without echoing its stdout, and raises with its stderr on failure.
fun capture(cmd: str, args: [str]) > str !> any {
    final res = proc\exec(cmd, args: args, opts: {"quiet": true, "allow_failure": true});
    if (!res.ok) {
        throw "queue: {cmd} {args.join(" ")}: exit {res.code}: {res.stderr}";
    }
    return res.stdout;
}

fun queueDir() > str !> any {
    final dir = need("RUNNER_TEMP") + "/queue";
    fs\mkdirAll(dir);
    return dir;
}

fun plan(depth: str) > void !> any {
    final dir = queueDir();
    final changes = capture("magus", args: ["queue", "ls", "--provider", "github", "--base", "main"]);
    fs\writeFile(dir + "/changes.json", content: changes + "\n");
    proc\exec("magus", args: planArgs(dir, depth: depth), opts: {});
    final ids = validatedIDs(fs\readFile(dir + "/plan.json"));
    fs\appendFile(need("GITHUB_OUTPUT"), content: outputs(ids));
}

fun validate(change: str) > void !> any {
    final dir = queueDir();
    proc\exec("magus", args: validateArgs(dir, change: change), opts: {"stdin": fs\readFile(dir + "/plan.json")});
}

// planned polls every 10s, one API request each, for as long as the validation run
// waits on the run ahead of it.
fun planned(run: str) > void !> any {
    final args = ["run", "view", run, "--repo", need("GITHUB_REPOSITORY"), "--json", "status,jobs"];
    while (true) {
        final ran = planRan(capture("gh", args: args));
        if (ran != null) {
            fs\appendFile(need("GITHUB_OUTPUT"), content: "ran={ran!}\n");
            return;
        }
        os\sleep(10000.0);
    }
}

fun apply(run: str, base: str, cred: Credential) > void !> any {
    final repo = need("GITHUB_REPOSITORY");
    final args = applyArgs(run, repo: repo, committer: cred.committer, app: cred.app);
    final applied = proc\exec("magus", args: args, opts: {"allow_failure": true});
    // A failed apply still dispatches main's runs for whatever merged before it stopped.
    foreach (workflow in dispatches(queueMerged(applied.stdout), app: cred.app)) {
        proc\exec("gh", args: ["workflow", "run", workflow, "--repo", repo, "--ref", base], opts: {});
    }
    if (!applied.ok) {
        os\exit(applied.code);
    }
}

final usage = "usage: magus buzz tools/gha-queue.buzz -- <step> <flags>\n"
    + "  plan --depth <n>\n"
    + "  validate --change <id>\n"
    + "  planned --run <id>\n"
    + "  apply --run <id> --base <branch> [--app <slug> --committer <name <email>>]";

// options parses one step's flags, all valued. Each name in required must be given a
// value; optional ones may be empty. Anything the step does not declare is refused.
export fun options(step: str, argv: [str], required: [str], optional: [str]) > {str: str} !> any {
    final valued = mut [<str>];
    foreach (name in required) { valued.append(name); }
    foreach (name in optional) { valued.append(name); }
    final parsed = flags\parse(argv, switches: [<str>], valued: valued);
    if (parsed.unknown.len() > 0) {
        throw "queue: {step} does not take {parsed.unknown.join(" ")}\n{usage}";
    }
    foreach (name in required) {
        if ((parsed.values[name] ?? "") == "") {
            throw "queue: {step} needs {name}\n{usage}";
        }
    }
    return parsed.values;
}

export fun main(args: [str]) > void !> any {
    if (args.len() == 0) {
        throw "queue: no step given\n{usage}";
    }
    final step = args[0];
    final argv = args.sub(1);
    if (step == "plan") {
        plan(options(step, argv: argv, required: ["--depth"], optional: [<str>])["--depth"]!);
    } else if (step == "validate") {
        validate(options(step, argv: argv, required: ["--change"], optional: [<str>])["--change"]!);
    } else if (step == "planned") {
        planned(options(step, argv: argv, required: ["--run"], optional: [<str>])["--run"]!);
    } else if (step == "apply") {
        final o = options(step, argv: argv, required: ["--run", "--base"], optional: ["--app", "--committer"]);
        apply(o["--run"]!, base: o["--base"]!, cred: credentialOf(o["--app"] ?? "", committer: o["--committer"] ?? ""));
    } else {
        throw "queue: unknown step \"{step}\"\n{usage}";
    }
}

fun planDoc(depth: int, partitions: [[str]]) > str {
    final groups = mut [<[{str: str}]>];
    foreach (ids in partitions) {
        final group = mut [<{str: str}>];
        foreach (id in ids) {
            group.append({"id": id, "head": "abc"});
        }
        groups.append(group);
    }
    return encode({"schema": "mergequeue.plan/v1", "depth": depth, "partitions": groups});
}

test "apply runs once the plan job runs, and not when it was skipped or never made" {
    final view = fun (status: str, conclusion: str?) > str {
        final jobs = mut [<{str: any}>];
        if (conclusion != null) {
            jobs.append({"name": "queue plan", "conclusion": conclusion!});
        }
        return encode({"status": status, "jobs": jobs});
    };
    assert\equal(planRan(view("in_progress", conclusion: "skipped")), want: false, message: "no merge intent");
    assert\equal(planRan(view("in_progress", conclusion: "success")), want: true, message: "planned");
    assert\equal(planRan(view("completed", conclusion: "failure")), want: true, message: "apply resets stale statuses whatever the plan did");
    assert\equal(planRan(view("in_progress", conclusion: "")), want: true, message: "running");
    assert\equal(planRan(view("completed", conclusion: null)), want: false, message: "cancelled before it started");
    assert\equal(planRan(view("queued", conclusion: null)), want: null, message: "still waiting");
}

test "each partition gives its first depth changes a validation job" {
    final ids = validatedIDs(planDoc(2, partitions: [["1", "2", "3"], ["4"]]));
    assert\equal(ids, want: ["1", "2", "4"], message: "depth 2 over partitions of three and one");
}

test "a plan with no partitions validates nothing" {
    assert\equal(validatedIDs(`{"depth": 3, "partitions": null}`).len(), want: 0, message: "null partitions");
    assert\equal(validatedIDs(`{"depth": 3}`).len(), want: 0, message: "absent partitions");
}

test "outputs render a compact matrix and its count" {
    assert\equal(outputs(["1", "4"]), want: `matrix={"include":[{"change":"1"},{"change":"4"}]}` + "\ncount=2\n", message: "two jobs");
    assert\equal(outputs([<str>]), want: `matrix={"include":[]}` + "\ncount=0\n", message: "no jobs");
}

test "validation hooks are lines a person can run, with MERGEQUEUE_ONTO unexpanded and caches the queue keeps private" {
    assert\equal(validateArgs("/t/queue", change: "482"), want: ["queue", "validate", "--stdin", "--only", "482",
        "--verdicts", "/t/queue/verdicts",
        "--gate", `magus affected ci --base "$MERGEQUEUE_ONTO" --no-default-charms`,
        "--regenerate", `magus affected generate:rw --base "$MERGEQUEUE_ONTO"`,
        "--scratch-env", "MAGUS_CACHE_DIR=magus", "--scratch-env", "GOCACHE=go-build",
        "--scratch-env", "GOMODCACHE=go-mod", "--scratch-env", "XDG_CACHE_HOME=cache"], message: "argv");
}

test "apply follows the validation run as its source and regenerates in the sandbox" {
    assert\equal(applyArgs("99", repo: "o/r", committer: "", app: ""), want: ["queue", "apply", "--provider", "github", "--status-context", "merge-queue",
        "--interval", "15s",
        "--regenerate", `MAGUS_SANDBOX_ENABLED=1 magus run generate:rw $MERGEQUEUE_UNITS`,
        "--scratch-env", "MAGUS_CACHE_DIR=magus", "--scratch-env", "GOCACHE=go-build",
        "--scratch-env", "GOMODCACHE=go-mod", "--scratch-env", "XDG_CACHE_HOME=cache", "run:o/r/runs/99"], message: "argv");
}

test "with the queue app, apply commits as its bot and checks the status is pinned to it" {
    final args = applyArgs("99", repo: "o/r", committer: "q[bot] <7+q[bot]@users.noreply.github.com>", app: "q");
    assert\equal(args.len(), want: 23, message: "two flags more");
    assert\equal(args[18], want: "--committer", message: "the committer flag");
    assert\equal(args[19], want: "q[bot] <7+q[bot]@users.noreply.github.com>", message: "one argument, spaces and all");
    assert\equal(args[20], want: "--app", message: "the app flag");
    assert\equal(args[21], want: "q", message: "the app's slug");
    assert\equal(args[22], want: "run:o/r/runs/99", message: "the source stays last");
}

test "apply takes the queue app's slug and committer together or neither" {
    assert\equal(credentialOf("", committer: "").app, want: "", message: "setup-magus minted nothing");
    final cred = credentialOf("q", committer: "q[bot] <7+q[bot]@users.noreply.github.com>");
    assert\equal(cred.app, want: "q", message: "slug");
    assert\equal(cred.committer, want: "q[bot] <7+q[bot]@users.noreply.github.com>", message: "committer");
    foreach (pair in [["q", ""], ["", "c"]]) {
        var refused = false;
        try {
            credentialOf(pair[0], committer: pair[1]);
        } catch (e) {
            refused = true;
        }
        assert\equal(refused, want: true, message: pair.join(","));
    }
}

test "each step takes the flags it declares and refuses the rest" {
    final o = options("apply", argv: ["--run", "7", "--base=main", "--app", "", "--committer", ""], required: ["--run", "--base"], optional: ["--app", "--committer"]);
    assert\equal(o["--run"], want: "7", message: "a valued flag");
    assert\equal(o["--base"], want: "main", message: "the =value form");
    assert\equal(o["--app"], want: "", message: "an optional flag may be empty");
    foreach (argv in [["--depth"], ["--depth", ""], ["3"], ["--depth", "3", "--extra", "x"]]) {
        var refused = false;
        try {
            options("plan", argv: argv, required: ["--depth"], optional: [<str>]);
        } catch (e) {
            refused = true;
        }
        assert\equal(refused, want: true, message: argv.join(" "));
    }
}

test "plan args carry the depth and leave the affected sets to the workspace" {
    final args = planArgs("/t/queue", depth: "3");
    assert\equal(args[0], want: "queue", message: "magus queue");
    assert\equal(args[7], want: "3", message: "depth");
    assert\equal(args[8], want: "--out", message: "no facts command");
    assert\equal(args.len(), want: 10, message: "argv length");
}

test "main's runs are dispatched only when the queue merged something itself" {
    final github = `{"schema":"mergequeue.event/v1","kind":"merged","change":"4","commit":"abc","by_provider":true}`;
    final queue = `{"schema":"mergequeue.event/v1","kind":"merged","change":"5","commit":"def"}`;
    final waiting = `{"schema":"mergequeue.event/v1","kind":"waiting","change":"6","reason":"r"}`;
    assert\equal(queueMerged(waiting + "\n"), want: false, message: "nothing merged");
    assert\equal(queueMerged(github + "\n" + waiting + "\n"), want: false, message: "GitHub's auto-merge started main's runs itself");
    assert\equal(queueMerged(github + "\n" + queue + "\n"), want: true, message: "the queue's own merge started none");
    assert\equal(dispatches(false, app: "").len(), want: 0, message: "no dispatch");
    assert\equal(dispatches(true, app: ""), want: ["ci.yaml", "cd.yaml", "queue.yaml"], message: "every workflow of main");
    assert\equal(dispatches(true, app: "q").len(), want: 0, message: "the app's merges started them themselves");
}
