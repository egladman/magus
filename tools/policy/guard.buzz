// This repository's rules for the coding agents that work on it, registered from the root
// magusfile with magus\guard.command, magus\guard.spawn and magus\guard.write. They are this
// repository's preference, not a magus default: nothing here is compiled into or shipped
// with magus. Copy them as a reference for your own repository's policy.
//
// Edits apply at once when they tighten a rule. A loosening waits until it is committed,
// because the guard runs the committed copy of this file beside the working tree's and keeps
// the stricter answer.
//
// Rules, each keyed on facts the guard hands over (parsed programs, titles, paths), never
// on prose:
//   ci-watch (deny): a gh invocation that blocks until CI or the merge queue finishes.
//   ci-batch-poll (advise once per session): one pull request's CI read piecemeal.
//   queue-poll (advise once per session): the merge queue's state read through GitHub.
//   admin-merge (deny): `gh pr merge --admin`, which lands a pull request past the queue.
//   pr-watch (deny): a pull request's own state (merged, auto-merge, mergeability) read
//     again and again, which the host's PR monitor reports as it changes.
//   worker-runs-gate (deny): the gate run by a subagent whose role is not integrate.
//   detached-push-unqualified (deny): `git push <remote> HEAD:<name>` from a detached HEAD
//     to a branch the checkout does not know the remote has.
//   foreign-binary (deny): a magus binary built in one checkout of magus run against another.
//   go-into-checkout (deny): `go -C` into another checkout of magus, bootstrap link aside.
//   stale-binary (advise once per state): the ./magus answering this hook was built from
//     sources that have since moved, by the stamp go-build links into it.
//   change-role-spawn-not-isolated (deny, spawn): a code-changing worker sharing a checkout.
//   changelog-unreleased-edit (deny, write): a hand edit adding to CHANGELOG.md's
//     [Unreleased] section, once changes/unreleased/ exists.
namespace agentpolicy;

import "std";
import "magus";
import "fs";
import "path";
import "crypto";

// The one command that answers CI for every open pull request.
final board = "gh pr list --state open --json number,mergeable,statusCheckRollup";

final ciWatchDenial = "Ask for the board once, when you need the answer:\n"
    + "  {board}\n"
    + "Watching costs a wake-up per completion and buys nothing, because GREEN CHANGES NOTHING: "
    + "the human merges, not you. Poll that command instead while you are acting on a RED run.\n"
    + "The merge queue is the same: `magus queue ls` lists every change with merge intent and its "
    + "state in one call, so ask it rather than watching a queue.yaml or queue-apply.yaml run.";

final ciBatchAdvice = "You are reading one pull request's CI. Ask for the whole board at once:\n"
    + "  {board}\n"
    + "One call answers every open pull request, and green changes nothing: the human merges.";

final queuePollAdvice = "You are reading the merge queue's state through GitHub piecemeal. Ask the "
    + "queue itself: `magus queue ls` lists every change with merge intent and its state in one call.";

final adminMergeDenial = "`--admin` merges past the merge queue: nothing validates the pull request "
    + "on main, and nothing orders it against the others. Queue it instead:\n"
    + "  gh pr merge <number> --auto --squash\n"
    + "(or --rebase). The queue validates it on main's tip and merges it; `magus queue ls` shows "
    + "where it stands. Bypassing the queue is the human's call, made from their own terminal.";

final prWatchDenial = "Watching a pull request's state costs a call per pass and learns nothing the host "
    + "will not tell you. Let the host report it: in Claude Code's desktop app, turn on the pull "
    + "request's CI monitor, which wakes the session on a failure, a conflict or a new comment. A "
    + "queued pull request's place is one `magus queue ls` away, asked once.";

final gateDenial ="The gate runs once per branch, by the orchestrator or by a worker spawned as "
    + "`<parent>/integrate <job>`, never by a worker mid-change. Finish with the narrow validation "
    + "your brief names and report; the gate runs once your branch is integrated. "
    + "`magus affected ci --plan` stays open to you: it runs nothing.";

final isolationDenial = "A worker that changes code gets its own checkout: spawn it with "
    + "`isolation: \"worktree\"`, and have it detach onto its branch (`git switch --detach <branch>`) "
    + "as its first act. Measured 09-22: 312 writes from 7 workers sharing a checkout landed in the "
    + "orchestrator's tree, and no isolated writer's did. Thinking roles (plan, review, research, "
    + "scout, integrate) may share it.";

final changelogDenial = "This checkout collects changelog entries as fragments, so CHANGELOG.md's "
    + "[Unreleased] section is assembled, not edited: add your entry as "
    + "`changes/unreleased/<branch>.md`, in the same shape (a `### Added` or `### Fixed` heading and "
    + "a bullet). A fix to a released version's section is untouched by this rule.";

// The roles a spawn title names for work that changes the tree: the conventional commit types.
final changeRoles = ["feat", "fix", "refactor", "perf", "docs", "test", "chore"];

// judge is the command rule the root magusfile registers.
export fun judge(req: CommandRequest) > GuardVerdict {
    final programs = mut [<Program>];
    foreach (c in req.commands) {
        programs.append(Program{ name = c.program, args = c.args, repeats = c.repeats, path = c.path });
    }
    final denial = decideBinaries(programs, where: Where{ dir = req.dir, workspace = req.workspace }, disk: onDisk());
    if (denial != "") {
        return magus\guard.deny(denial);
    }
    var checkout: Checkout? = null;
    if (req.checkout != null) {
        checkout = Checkout{ detached = req.checkout!.branch == "", remoteBranches = req.checkout!.remoteBranches };
    }
    final once = fun (key: str) > bool {
        return magus\guard.once(key);
    };
    final verdict = decide(programs, caller: Caller{ role = req.role, title = req.parent }, checkout: checkout, once: once);
    if (verdict.decision != "allow" or rebuilds(programs)) {
        return verdict;
    }
    return decideStale(hookBinary(req.workspace), once: once);
}

// judgeSpawn is the spawn rule the root magusfile registers.
export fun judgeSpawn(req: SpawnRequest) > GuardVerdict {
    return decideSpawn(req.kind, title: req.description, isolated: req.isolated);
}

// judgeWrite is the write rule the root magusfile registers. The two facts it reads from
// disk, whether this checkout collects fragments and what CHANGELOG.md holds now, are read
// only for a write to CHANGELOG.md.
export fun judgeWrite(req: WriteRequest) > GuardVerdict !> any {
    if (req.workspace == "" or req.path != req.workspace + "/CHANGELOG.md") {
        return magus\guard.allow();
    }
    final fragments = fs\exists(req.workspace + "/changes/unreleased");
    var current = "";
    if (fs\exists(req.path)) {
        current = fs\readFile(req.path);
    }
    return decideChangelog(fragments, current: current, content: req.content, oldText: req.oldText, newText: req.newText);
}

// Program is one program a command runs, copied out of the request because a Buzz test
// cannot build the host's CommandInvocation.
object Program {
    name: str,
    args: [str],
    repeats: bool,
    // path is the file the line names the program by, "" when found on PATH or unknown.
    path: str = "",
}

// Caller is who runs a command: role is root or worker (a lease binds it), and title is
// the description it was itself spawned with, empty for a person or the orchestrator.
object Caller {
    role: str,
    title: str,
}

// Checkout is the git state a push leaves from, handed over only for a line that pushes.
object Checkout {
    detached: bool,
    remoteBranches: [str],
}

// Where is where a command runs: the directory the host reported, and the workspace root
// holding it. Either is "" when unknown.
object Where {
    dir: str,
    workspace: str,
}

// Disk answers the three questions the binary rules ask the filesystem, passed in so the
// tests below can describe a tree without building one.
object Disk {
    // isCheckout: dir is the root of a checkout of magus.
    isCheckout: fun (dir: str) > bool,
    // hasBinary: dir holds a file named magus.
    hasBinary: fun (dir: str) > bool,
    // sameFile: a and b name one file, however each is spelled.
    sameFile: fun (a: str, b: str) > bool,
}

// The first line of go.mod in a checkout of magus, and in nothing else.
final moduleLine = "module github.com/egladman/magus";

fun onDisk() > Disk {
    return Disk{
        isCheckout = fun (dir: str) > bool {
            final mod = fs\readFile("{dir}/go.mod") catch "";
            return mod.split("\n")[0].trim() == moduleLine;
        },
        hasBinary = fun (dir: str) > bool {
            return fs\exists("{dir}/magus") catch true;
        },
        sameFile = fun (a: str, b: str) > bool {
            final x = fs\stat(a) catch null;
            final y = fs\stat(b) catch null;
            if (x == null or y == null) { return false; }
            return x!.size == y!.size and x!.mtime == y!.mtime and x!.mode == y!.mode;
        },
    };
}

// decideBinaries is the denial for a line that runs one checkout's build tools against
// another checkout of magus, "" when nothing on the line does. Every fact it needs must be
// known before the line runs: a path held in a variable, or a relative one with no
// directory to resolve it against, is unknown and passes.
export fun decideBinaries(programs: [Program], where: Where, disk: Disk) > str {
    foreach (p in programs) {
        final denial = foreignBinary(p, where: where, disk: disk);
        if (denial != "") { return denial; }
        final goDenial = goIntoCheckout(p, where: where, disk: disk);
        if (goDenial != "") { return goDenial; }
    }
    return "";
}

// foreignBinary: `<checkout A>/magus` run against checkout B, both checkouts of magus. The
// binary carries A's guard rules, host declarations and spell bytecode, so its verdicts
// describe A and what it regenerates lands in B unmarked. A magus run against a workspace
// that is not a checkout of magus (a benchmark tree, a fixture) is magus used as a tool,
// and passes.
fun foreignBinary(p: Program, where: Where, disk: Disk) > str {
    if (p.name != "magus" or p.path == "") { return ""; }
    final built = path\clean(fs\dirname(p.path));
    final isCheckout = disk.isCheckout;
    if (!isCheckout(built)) { return ""; }
    var target = where.workspace;
    final root = flagValue(p.args, long: "--root", short: "");
    if (root != null) {
        target = absolute(root!, dir: where.dir);
    }
    if (target == "" or target == built or !isCheckout(target)) { return ""; }
    final sameFile = disk.sameFile;
    if (sameFile("{target}/magus", p.path)) { return ""; }
    return ("`{p.path}` was built in {built}, and this line runs it against {target}, another checkout "
        + "of magus. A binary carries the guard rules, host declarations and spell bytecode of the tree "
        + "it was built from, so its verdicts describe {built}, and what it regenerates lands in {target} "
        + "unmarked. Run {target}'s own binary: `{target}/magus --root {target} ...`. "
        + ownBinaryHint(target, disk: disk)).trim();
}

// goIntoCheckout: `go -C <dir>` out of this workspace and into a checkout of magus, for a
// verb one of that checkout's targets covers. The pure raw-tool rule passes a -C that
// leaves the workspace, since a foreign tree is not its to funnel; a checkout of magus is.
// The one exception is the bootstrap link into a checkout with no binary yet.
fun goIntoCheckout(p: Program, where: Where, disk: Disk) > str {
    if (p.name != "go") { return ""; }
    final call = goCall(p.args);
    if (call.chdir == "" or !escapes(call.chdir) or call.args.len() == 0) { return ""; }
    final verb = call.args[0];
    final covered = ["build", "test", "vet", "run", "generate"].indexOf(verb) != null
        or (verb == "mod" and call.args.len() > 1 and call.args[1] == "tidy");
    if (!covered) { return ""; }
    final root = absolute(call.chdir, dir: where.dir);
    final isCheckout = disk.isCheckout;
    if (root == "" or !isCheckout(root)) { return ""; }
    if (bootstrapLink(call.args, root: root)) {
        final hasBinary = disk.hasBinary;
        if (!hasBinary(root)) { return ""; }
        return "Not a bootstrap: {root} already has a magus binary. Rebuild it with "
            + "`{root}/magus --root {root} run go-build .`. If that binary cannot load the tree "
            + "(MGS1021 after a pull or merge), move it aside first, then link: "
            + "`mv {root}/magus {root}/magus.old`, then `go -C {root} build -o magus ./cmd/magus`.";
    }
    return ("`go -C {root} {verb}` runs a toolchain command in another checkout of magus, outside its "
        + "cache and its drift tracking. Run the target from that checkout: "
        + "`{root}/magus --root {root} run <target> .`. " + ownBinaryHint(root, disk: disk)).trim();
}

// ownBinaryHint is how to get root a binary of its own, "" when it has one.
fun ownBinaryHint(root: str, disk: Disk) > str {
    final hasBinary = disk.hasBinary;
    if (hasBinary(root)) { return ""; }
    return "It has none yet: link one with `go -C {root} build -o magus ./cmd/magus`, then stamp it "
        + "with `{root}/magus --root {root} run go-build .`.";
}

// GoCall is a go command's -C directory, "" for none, and its argv from the subcommand on
// with -C removed. go accepts -C first, before the subcommand or right after it.
object GoCall {
    chdir: str,
    args: [str],
}

fun goCall(args: [str]) > GoCall {
    var chdir = "";
    var rest = args;
    if (rest.len() > 1 and rest[0] == "-C") {
        chdir = rest[1];
        rest = rest.sub(2);
    } else if (rest.len() > 0 and rest[0].startsWith("-C=")) {
        chdir = rest[0].sub(3);
        rest = rest.sub(1);
    }
    if (chdir == "" and rest.len() > 2 and rest[1] == "-C") {
        chdir = rest[2];
        rest = [rest[0]] + rest.sub(3);
    } else if (chdir == "" and rest.len() > 1 and rest[1].startsWith("-C=")) {
        chdir = rest[1].sub(3);
        rest = [rest[0]] + rest.sub(2);
    }
    return GoCall{ chdir = chdir, args = rest };
}

// bootstrapLink: `build -o magus ./cmd/magus` and nothing else, landing as root/magus.
fun bootstrapLink(args: [str], root: str) > bool {
    if (args.len() == 0 or args[0] != "build") { return false; }
    var output = "";
    final pkgs = mut [<str>];
    var i = 1;
    while (i < args.len()) {
        final a = args[i];
        if (a == "-o" and i + 1 < args.len()) {
            output = args[i + 1];
            i = i + 1;
        } else if (a.startsWith("-o=")) {
            output = a.sub(3);
        } else if (a.startsWith("-")) {
            return false;
        } else {
            pkgs.append(a);
        }
        i = i + 1;
    }
    return pkgs.len() == 1 and path\clean(pkgs[0]) == "cmd/magus" and output != ""
        and absolute(output, dir: root) == "{root}/magus";
}

// escapes: a -C naming a directory outside the workspace, read textually as the raw-tool
// rule reads it.
fun escapes(dir: str) > bool {
    final clean = path\clean(dir);
    return path\isAbs(clean) or clean == ".." or clean.startsWith("../");
}

// absolute is p made absolute against dir and cleaned, "" when p is relative and dir is
// unknown, or p itself is unknown.
fun absolute(p: str, dir: str) > str {
    if (p == "") { return ""; }
    if (path\isAbs(p)) { return path\clean(p); }
    if (dir == "") { return ""; }
    return path\clean("{dir}/{p}");
}

// The sources a ./magus answers from: the guard rules and hook plumbing compiled into it,
// the skills it serves, and the host declarations and spell bytecode it embeds, which are
// what a magusfile loads against. go-build links a digest of each into the binary.
final stampGlobs = [
    "internal/guard/*.go", "internal/interp/bindings/guard_*.go", "cmd/magus/shell*.go",
    "cmd/magus/guard_*.go", "internal/agent/*.go", "internal/agent/skills/*/SKILL.md",
    "internal/spell/gen/decls/*.buzz", "internal/spell/gen/*.bo",
];

// stampFiles are the stamped files under root, root-relative, tests left out: a test is
// not linked into the binary. fs\glob answers relative to the working directory, so both
// sides are made absolute before one is cut from the other.
fun stampFiles(root: str) > [str] !> any {
    final base = path\abs(root);
    final files = mut [<str>];
    foreach (pattern in stampGlobs) {
        foreach (found in fs\glob("{base}/{pattern}")) {
            final rel = path\abs(found.value).sub(base.len() + 1);
            if (!rel.endsWith("_test.go")) {
                files.append(rel);
            }
        }
    }
    return files;
}

fun digestOf(file: str) > str !> any {
    return crypto\sha256File(file).sub(0, len: 12);
}

// buildStamp is what go-build links into ./magus: `<path>=<digest>` for every stamped file
// under root, comma-separated.
export fun buildStamp(root: str) > str !> any {
    final entries = mut [<str>];
    foreach (rel in stampFiles(root)) {
        final digest = digestOf("{root}/{rel}");
        entries.append("{rel}={digest}");
    }
    return entries.join(",");
}

// movedSince lists the stamped files under root whose content is not what stamp recorded:
// changed, added, or removed. A file no newer than builtAt, the binary's mtime, is the one
// the build read, so only newer files are hashed.
export fun movedSince(root: str, stamp: str, builtAt: double) > [str] !> any {
    final recorded = mut {<str: str>};
    final order = mut [<str>];
    foreach (entry in stamp.split(",")) {
        final at = entry.indexOf("=");
        if (at != null) {
            final rel = entry.sub(0, len: at!);
            recorded[rel] = entry.sub(at! + 1);
            order.append(rel);
        }
    }
    final moved = mut [<str>];
    final present = mut {<str: bool>};
    foreach (rel in stampFiles(root)) {
        present[rel] = true;
        final was = recorded[rel];
        if (was == null) {
            moved.append(rel);
        } else if (fs\stat("{root}/{rel}").mtime > builtAt and digestOf("{root}/{rel}") != was!) {
            moved.append(rel);
        }
    }
    foreach (rel in order) {
        if (!(present[rel] ?? false)) {
            moved.append(rel);
        }
    }
    return moved;
}

// HookBinary is what the stale-binary rule knows about the magus answering the hook:
// whether it is this workspace's own ./magus, whether go-build stamped it, and which
// stamped sources moved since.
object HookBinary {
    ours: bool,
    stamped: bool,
    moved: [str],
}

// hookBinary reads HookBinary off the filesystem. A binary that is not this workspace's
// own ./magus (one on PATH, another checkout's) has no sources here to be stale against.
fun hookBinary(workspace: str) > HookBinary {
    final none = HookBinary{ ours = false, stamped = false, moved = [<str>] };
    if (workspace == "") { return none; }
    final bin = magus\guard.binary();
    final own = "{workspace}/magus";
    final sameFile = onDisk().sameFile;
    if (bin.path == "" or (bin.path != own and !sameFile(own, bin.path))) { return none; }
    if (bin.stamp == "") {
        return HookBinary{ ours = true, stamped = false, moved = [<str>] };
    }
    final built = fs\stat(bin.path) catch null;
    if (built == null) { return none; }
    final moved = movedSince(workspace, stamp: bin.stamp, builtAt: built!.mtime) catch [<str>];
    return HookBinary{ ours = true, stamped = true, moved = moved };
}

final unstampedAdvice = "./magus carries no go-build stamp: it was linked by a bare `go build` "
    + "(the bootstrap) or before stamps existed, so its embedded spell bytecode and host "
    + "declarations are whatever the link found, and nothing can say which sources its verdicts "
    + "come from. Stamp it: `./magus run go-build .`.";

// decideStale advises once per moved set that the ./magus answering this hook was built
// from other sources than the checkout holds now: proven by content, not by mtimes. It
// never denies: running a stale binary is how it gets rebuilt.
export fun decideStale(bin: HookBinary, once: fun (key: str) > bool) > GuardVerdict {
    if (!bin.ours) {
        return magus\guard.allow();
    }
    if (!bin.stamped) {
        if (once("stale-binary:unstamped")) { return magus\guard.advise(unstampedAdvice); }
        return magus\guard.allow();
    }
    if (bin.moved.len() == 0 or !once("stale-binary:" + bin.moved.join(","))) {
        return magus\guard.allow();
    }
    var named = bin.moved;
    var more = "";
    if (named.len() > 5) {
        more = " and {named.len() - 5} more";
        named = named.sub(0, len: 5);
    }
    final text = "./magus was built before {bin.moved.len()} of its sources moved: {named.join(", ")}{more}. "
        + "This verdict, and the workspace it loads, come from the PREVIOUS sources. "
        + "Rebuild: `./magus run go-build .`.";
    var declsMoved = false;
    foreach (rel in bin.moved) {
        if (rel.startsWith("internal/spell/gen/decls/")) { declsMoved = true; }
    }
    if (!declsMoved) {
        return magus\guard.advise(text);
    }
    return magus\guard.advise(text + " " + deadlockEscape);
}

// deadlockEscape is the way out for a binary that cannot load the tree and so cannot
// rebuild itself.
final deadlockEscape = "The host declarations moved, so the next load may fail with MGS1021, and a "
    + "binary that cannot load the tree cannot rebuild itself. The escape, one command at a time: "
    + "`mv magus magus.old`, `go build -o magus ./cmd/magus` (if that fails with `undefined:` in a "
    + "gen/ package, the merge kept one side's generated code: restore those gen/ directories from "
    + "the side that produced them, or three-way merge them with `git merge-file`, then link again), "
    + "then `./magus run go-build .`.";

// rebuilds: the line is itself the rebuild, which a staleness advisory would only delay.
fun rebuilds(programs: [Program]) > bool {
    foreach (p in programs) {
        if (p.name == "magus") {
            final ops = operandsOf(p.args, valueFlags: magusValueFlags);
            if (ops.len() > 1 and ops[0] == "run") {
                final target = ops[1].split(":")[0];
                if (target == "go-build" or target == "spells-generate" or target == "generate") {
                    return true;
                }
            }
        }
        if (p.name == "go" and goCall(p.args).args.len() > 0 and goCall(p.args).args[0] == "build") {
            return true;
        }
    }
    return false;
}

// decide is judge over plain records, with the once-per-session gate passed in so the tests
// below can count firings without a guard session.
export fun decide(programs: [Program], caller: Caller, checkout: Checkout?, once: fun (key: str) > bool) > GuardVerdict {
    if (runsGate(programs) and !mayGate(caller)) {
        return magus\guard.deny(gateDenial);
    }
    if (checkout != null) {
        final denial = unqualifiedPush(programs, checkout: checkout!);
        if (denial != "") {
            return magus\guard.deny(denial);
        }
    }
    final calls = ghCalls(programs);
    foreach (call in calls) {
        if (blocksOnCI(call)) {
            return magus\guard.deny(ciWatchDenial);
        }
        if (runs(call, first: "pr", second: "merge") and hasFlag(call.args, long: "--admin")) {
            return magus\guard.deny(adminMergeDenial);
        }
        if (call.repeats and readsPRState(call)) {
            return magus\guard.deny(prWatchDenial);
        }
    }
    foreach (call in calls) {
        if (pollsQueue(call)) {
            if (once("queue-poll")) { return magus\guard.advise(queuePollAdvice); }
            return magus\guard.allow();
        }
    }
    foreach (call in calls) {
        if (readsOneCI(call)) {
            if (once("ci-batch-poll")) { return magus\guard.advise(ciBatchAdvice); }
            return magus\guard.allow();
        }
    }
    return magus\guard.allow();
}

// decideSpawn denies a new code-changing worker that would share the spawning checkout. A
// continue starts nothing, and a title in no known form names no role, so both pass.
export fun decideSpawn(kind: str, title: str, isolated: bool) > GuardVerdict {
    if (kind == "spawn" and !isolated and changeRoles.indexOf(titleRole(title)) != null) {
        return magus\guard.deny(isolationDenial);
    }
    return magus\guard.allow();
}

// decideChangelog denies a CHANGELOG.md write that adds a line to [Unreleased] while the
// checkout collects fragments. A write whose text the host did not describe is unknown,
// not empty, and passes.
export fun decideChangelog(fragments: bool, current: str, content: str, oldText: str, newText: str) > GuardVerdict {
    if (!fragments) {
        return magus\guard.allow();
    }
    var after = content;
    if (after == "") {
        if (oldText == "") {
            return magus\guard.allow();
        }
        final at = current.indexOf(oldText);
        if (at == null) {
            return magus\guard.allow();
        }
        after = current.sub(0, len: at!) + newText + current.sub(at! + oldText.len());
    }
    final before = unreleasedLines(current);
    foreach (line in unreleasedLines(after)) {
        if (before.indexOf(line) == null) {
            return magus\guard.deny(changelogDenial);
        }
    }
    return magus\guard.allow();
}

// unreleasedLines are the non-blank lines of text's `## [Unreleased]` section.
fun unreleasedLines(text: str) > [str] {
    final lines = mut [<str>];
    var inside = false;
    foreach (line in text.split("\n")) {
        if (line.startsWith("## ")) {
            inside = line.startsWith("## [Unreleased]");
        } else if (inside and line.trim() != "") {
            lines.append(line);
        }
    }
    return lines;
}

// titleRole is the role a `<parent>/<role> <job>` title names, "" for any other form.
fun titleRole(title: str) > str {
    final words = title.split(" ");
    if (words.len() != 2) {
        return "";
    }
    final head = words[0].split("/");
    if (head.len() < 2) {
        return "";
    }
    return head[head.len() - 1];
}

// mayGate: a person or the orchestrator (no lease, no spawn title), or an integrate worker.
fun mayGate(caller: Caller) > bool {
    if (caller.role != "worker" and caller.title == "") {
        return true;
    }
    return titleRole(caller.title) == "integrate";
}

// The magus flags that take the next word as their value.
final magusValueFlags = [
    "-o", "--output", "--tee", "-j", "--concurrency", "--concurrency-profile", "--root",
    "--skip", "--timeout", "--target-timeout", "--stall-timeout", "--shard", "--n-shards",
    "--log-level", "--log-format", "--cache-dir", "--max-failures", "--race", "--depth",
];

// runsGate: `magus affected ci` or `magus run ci`, with or without a charm, and not the
// --plan form, which runs nothing.
fun runsGate(programs: [Program]) > bool {
    foreach (p in programs) {
        if (p.name == "magus") {
            final ops = operandsOf(p.args, valueFlags: magusValueFlags);
            if (ops.len() > 1 and (ops[0] == "affected" or ops[0] == "run")
                and (ops[1] == "ci" or ops[1].startsWith("ci:"))
                and !hasFlag(p.args, long: "--plan")) {
                return true;
            }
        }
    }
    return false;
}

// The git push flags that take the next word as their value.
final pushValueFlags = ["-C", "-o", "--push-option", "--repo", "--receive-pack", "--exec"];

// unqualifiedPush names what is wrong with a `git push <remote> HEAD:<name>` from a detached
// HEAD whose <name> the checkout has no remote-tracking branch for, "" when nothing is. Git
// refuses that push: with no branch behind HEAD it cannot tell a branch from a tag.
fun unqualifiedPush(programs: [Program], checkout: Checkout) > str {
    if (!checkout.detached) {
        return "";
    }
    foreach (p in programs) {
        if (p.name == "git") {
            final ops = operandsOf(p.args, valueFlags: pushValueFlags);
            if (ops.len() > 2 and ops[0] == "push") {
                final remote = ops[1];
                foreach (spec in ops.sub(2)) {
                    var ref = spec;
                    if (ref.startsWith("+")) { ref = ref.sub(1); }
                    if (ref.startsWith("HEAD:")) {
                        final name = ref.sub(5);
                        if (!name.startsWith("refs/") and checkout.remoteBranches.indexOf("{remote}/{name}") == null) {
                            return "HEAD is detached and {remote} has no branch `{name}` this checkout knows of, so git "
                                + "cannot tell a branch from a tag and refuses the push; a `;` or a background run hides "
                                + "that. Name the branch in full: `git push {remote} HEAD:refs/heads/{name}`.";
                        }
                    }
                }
            }
        }
    }
    return "";
}

// GhCall is one gh invocation: its arguments, and whether something runs it again and
// again (a polling loop, or the watch program).
object GhCall {
    args: [str],
    repeats: bool,
}

fun ghCalls(programs: [Program]) > [GhCall] {
    final calls = mut [<GhCall>];
    foreach (c in programs) {
        if (c.name == "gh") {
            calls.append(GhCall{ args = c.args, repeats = c.repeats });
        } else if (c.name == "watch") {
            // `watch [flags] gh ...` reruns gh every interval.
            foreach (i, arg in c.args) {
                if (arg == "gh") {
                    calls.append(GhCall{ args = c.args.sub(i + 1), repeats = true });
                    break;
                }
            }
        }
    }
    return calls;
}

// blocksOnCI: `gh run watch`, the --watch form of `gh run view` and `gh pr checks`, and any
// CI or queue read a loop or watch repeats. Reading a result that already exists is left
// to the advisories: the rule is about the WAITING.
fun blocksOnCI(call: GhCall) > bool {
    if (runs(call, first: "run", second: "watch")) {
        return true;
    }
    if (hasFlag(call.args, long: "--watch") and (runs(call, first: "run", second: "view") or runs(call, first: "pr", second: "checks"))) {
        return true;
    }
    return call.repeats and (readsOneCI(call) or pollsQueue(call));
}

// readsOneCI: one pull request's or one commit's checks, where the board answers them all.
fun readsOneCI(call: GhCall) > bool {
    if (runs(call, first: "pr", second: "checks")) {
        return true;
    }
    if (runs(call, first: "pr", second: "view") and jsonFields(call.args).indexOf("statusCheckRollup") != null) {
        return true;
    }
    final ops = operandsOf(call.args, valueFlags: ghValueFlags);
    if (ops.len() > 1 and ops[0] == "api") {
        foreach (suffix in ["/check-runs", "/check-suites", "/status", "/statuses"]) {
            if (ops[1].endsWith(suffix)) { return true; }
        }
    }
    return false;
}

// pollsQueue: the merge queue's runs or its marks on a pull request, read through GitHub.
fun pollsQueue(call: GhCall) > bool {
    if (runs(call, first: "run", second: "list") or runs(call, first: "run", second: "view")) {
        return isQueueWorkflow(flagValue(call.args, long: "--workflow", short: "-w") ?? "");
    }
    if (runs(call, first: "pr", second: "view") or runs(call, first: "pr", second: "checks")) {
        var aimed = false;
        foreach (arg in call.args) {
            if (arg.indexOf("queue") != null) { aimed = true; }
        }
        if (!aimed) { return false; }
        final fields = jsonFields(call.args);
        return runs(call, first: "pr", second: "checks")
            or fields.indexOf("labels") != null
            or fields.indexOf("statusCheckRollup") != null;
    }
    return false;
}

// The --json fields that describe a pull request's own lifecycle rather than its content.
final prStateFields = ["state", "merged", "mergedAt", "closed", "autoMergeRequest", "mergeStateStatus",
    "mergeable", "reviewDecision"];

// readsPRState: a read of a pull request's own lifecycle, through `gh pr view --json` naming
// one of prStateFields, `gh pr status`, or `gh api` on the pull request itself
// (`repos/<owner>/<name>/pulls/<n>`, not its files, commits or reviews).
fun readsPRState(call: GhCall) > bool {
    if (runs(call, first: "pr", second: "status")) {
        return true;
    }
    if (runs(call, first: "pr", second: "view")) {
        foreach (field in jsonFields(call.args)) {
            if (prStateFields.indexOf(field) != null) { return true; }
        }
        return false;
    }
    final ops = operandsOf(call.args, valueFlags: ghValueFlags);
    if (ops.len() > 1 and ops[0] == "api") {
        final parts = ops[1].split("/");
        return parts.len() == 5 and parts[0] == "repos" and parts[3] == "pulls" and (std\parseInt(parts[4]) ?? 0) > 0;
    }
    return false;
}

fun isQueueWorkflow(name: str) > bool {
    return name.startsWith("queue") and (name.endsWith(".yaml") or name.endsWith(".yml"));
}

// runs reports whether call's first two operands are first and second: `gh pr checks`.
fun runs(call: GhCall, first: str, second: str) > bool {
    final ops = operandsOf(call.args, valueFlags: ghValueFlags);
    return ops.len() > 1 and ops[0] == first and ops[1] == second;
}

// The gh flags that take the next word as their value, so it is not read as an operand.
final ghValueFlags = [
    "-R", "--repo", "-w", "--workflow", "-b", "--branch", "-L", "--limit", "-q", "--jq",
    "--json", "-i", "--interval", "-t", "--template", "-u", "--user", "-s", "--state",
    "-e", "--event", "-c", "--commit", "-X", "--method", "-H", "--header", "-f", "-F",
    "--field", "--raw-field",
];

// operandsOf are args with every flag, and the value of each flag in valueFlags, left out.
fun operandsOf(args: [str], valueFlags: [str]) > [str] {
    final ops = mut [<str>];
    var skip = false;
    foreach (arg in args) {
        if (skip) {
            skip = false;
        } else if (arg.startsWith("-")) {
            skip = arg.indexOf("=") == null and valueFlags.indexOf(arg) != null;
        } else {
            ops.append(arg);
        }
    }
    return ops;
}

fun hasFlag(args: [str], long: str) > bool {
    foreach (arg in args) {
        if (arg == long or arg.startsWith(long + "=")) { return true; }
    }
    return false;
}

// flagValue is the value given to a flag spelled long or short ("" when it has no short
// form), or null when the flag is absent.
fun flagValue(args: [str], long: str, short: str) > str? {
    foreach (i, arg in args) {
        if ((arg == long or (short != "" and arg == short)) and i + 1 < args.len()) {
            return args[i + 1];
        }
        if (arg.startsWith(long + "=")) {
            return arg.sub(long.len() + 1);
        }
    }
    return null;
}

// jsonFields lists the fields a --json flag asks for.
fun jsonFields(args: [str]) > [str] {
    final value = flagValue(args, long: "--json", short: "") ?? "";
    if (value == "") { return [<str>]; }
    return value.split(",");
}

// request is the programs a command runs, each spelled as its argv. A leading "loop:" marks
// the program as repeated by a polling loop, and a program word holding a slash is its path.
fun request(argvs: [[str]]) > [Program] {
    final programs = mut [<Program>];
    foreach (argv in argvs) {
        var words = argv;
        var repeats = false;
        if (words[0] == "loop:") {
            repeats = true;
            words = words.sub(1);
        }
        var name = words[0];
        var file = "";
        if (name.indexOf("/") != null) {
            file = name;
            name = fs\basename(name);
        }
        programs.append(Program{ name = name, args = words.sub(1), repeats = repeats, path = file });
    }
    return programs;
}

// counter is a fresh once-per-session gate.
fun counter() > fun (key: str) > bool {
    final seen = mut {<str: bool>};
    return fun (key: str) > bool {
        if (seen[key] ?? false) { return false; }
        seen[key] = true;
        return true;
    };
}

// person is an unattributed caller: no lease binds it and no spawn titled it.
fun person() > Caller {
    return Caller{ role = "root", title = "" };
}

// ask runs one command as a person with no push facts and a fresh gate.
fun ask(argv: [str]) > GuardVerdict {
    return decide(request([argv]), caller: person(), checkout: null, once: counter());
}

test "a gh call that blocks until CI finishes is denied" {
    foreach (argv in [
        ["gh", "run", "watch", "34069443069"],
        ["gh", "run", "watch", "34069443069", "--exit-status", "--interval", "60"],
        ["gh", "pr", "checks", "183", "--watch"],
        ["gh", "run", "view", "34069443069", "--watch"],
        ["gh", "--repo", "egladman/magus", "pr", "checks", "183", "--watch=true"],
    ]) {
        final v = ask(argv);
        std\assert(v.decision == "deny", message: argv.join(" "));
        std\assert(v.reason.indexOf("GREEN CHANGES NOTHING") != null, message: "keeps the reason");
        std\assert(v.reason.indexOf(board) != null, message: "names the board");
    }
}

test "a CI read that a loop or watch repeats is a watch too" {
    final looped = decide(request([["loop:", "gh", "pr", "checks", "183"], ["loop:", "sleep", "30"]]), caller: person(), checkout: null, once: counter());
    std\assert(looped.decision == "deny", message: "a while loop over gh pr checks");
    std\assert(ask(["watch", "-n", "30", "gh", "pr", "view", "183", "--json", "statusCheckRollup"]).decision == "deny", message: "the watch program over gh pr view");
}

test "watching the merge queue's runs is denied, naming the queue" {
    foreach (argv in [
        ["loop:", "gh", "run", "list", "--workflow", "queue.yaml"],
        ["watch", "gh", "run", "list", "--workflow=queue-apply.yaml"],
        ["loop:", "gh", "run", "view", "--workflow", "queue-apply.yaml"],
    ]) {
        final v = ask(argv);
        std\assert(v.decision == "deny", message: argv.join(" "));
        std\assert(v.reason.indexOf("magus queue ls") != null, message: "names the queue's own answer");
    }
}

test "reading one pull request's CI is advised once per session" {
    final once = counter();
    foreach (argv in [
        ["gh", "pr", "checks", "183"],
        ["gh", "pr", "view", "183", "--json", "state,statusCheckRollup"],
        ["gh", "api", "repos/egladman/magus/commits/abc123/check-runs"],
    ]) {
        std\assert(ask(argv).decision == "advise", message: argv.join(" "));
    }
    final first = decide(request([["gh", "pr", "checks", "183"]]), caller: person(), checkout: null, once: once);
    std\assert(first.decision == "advise", message: "the first read is advised");
    std\assert(first.reason.indexOf(board) != null, message: "names the board");
    std\assert(decide(request([["gh", "pr", "checks", "184"]]), caller: person(), checkout: null, once: once).decision == "allow", message: "and only once");
}

test "polling the merge queue through GitHub is advised once per session" {
    final once = counter();
    foreach (argv in [
        ["gh", "run", "list", "--workflow", "queue.yaml"],
        ["gh", "run", "list", "-w", "queue-apply.yaml", "--limit", "5"],
        ["gh", "pr", "view", "212", "--json", "labels", "--jq", ".labels[] | select(.name == \"queue\")"],
        ["gh", "pr", "view", "212", "--json", "statusCheckRollup", "--jq", ".statusCheckRollup[] | select(.context == \"magus/queue\")"],
    ]) {
        final v = ask(argv);
        std\assert(v.decision == "advise", message: argv.join(" "));
        std\assert(v.reason.indexOf("magus queue ls") != null, message: "names the queue's answer, not the board");
    }
    final poll = request([["gh", "run", "list", "--workflow", "queue.yaml"]]);
    std\assert(decide(poll, caller: person(), checkout: null, once: once).decision == "advise", message: "first");
    std\assert(decide(poll, caller: person(), checkout: null, once: once).decision == "allow", message: "only once");
}

test "the board itself, an unrelated gh run list, and other programs stay silent" {
    foreach (argv in [
        ["gh", "pr", "list", "--state", "open", "--json", "number,mergeable,statusCheckRollup"],
        ["gh", "run", "list", "--branch", "main", "--limit", "5"],
        ["gh", "run", "list", "--workflow", "ci.yaml"],
        ["gh", "run", "view", "34069443069", "--log"],
        ["gh", "pr", "view", "183", "--json", "labels"],
        ["watch", "-n", "5", "free", "-m"],
        ["git", "status"],
    ]) {
        std\assert(ask(argv).decision == "allow", message: argv.join(" "));
    }
}

test "an admin merge is denied, naming the queue's entry" {
    foreach (argv in [
        ["gh", "pr", "merge", "12", "--admin", "--squash"],
        ["gh", "pr", "merge", "--squash", "--admin", "12"],
        ["gh", "-R", "egladman/magus", "pr", "merge", "12", "--admin=true", "--rebase"],
    ]) {
        final v = ask(argv);
        std\assert(v.decision == "deny", message: argv.join(" "));
        std\assert(v.reason.indexOf("--auto --squash") != null, message: "names the entry");
    }
}

test "a pull request's state read again and again is denied, naming the monitor" {
    foreach (argvs in [
        [["loop:", "gh", "pr", "view", "300", "--json", "state,autoMergeRequest"], ["loop:", "sleep", "60"]],
        [["watch", "-n", "60", "gh", "pr", "view", "300", "--json", "mergeStateStatus"]],
        [["loop:", "gh", "api", "repos/egladman/magus/pulls/300", "--jq", ".merged"]],
        [["loop:", "gh", "pr", "status"]],
    ]) {
        final v = decide(request(argvs), caller: person(), checkout: null, once: counter());
        std\assert(v.decision == "deny", message: argvs[0].join(" "));
        std\assert(v.reason.indexOf("CI monitor") != null, message: "names the host's monitor");
    }
}

test "one read of a pull request's state, and a loop over its content, stay silent" {
    foreach (argvs in [
        [["gh", "pr", "view", "300", "--json", "state,autoMergeRequest"]],
        [["gh", "api", "repos/egladman/magus/pulls/300"]],
        [["loop:", "gh", "pr", "view", "300", "--json", "title,body"]],
        [["loop:", "gh", "api", "repos/egladman/magus/pulls/300/files"]],
    ]) {
        final v = decide(request(argvs), caller: person(), checkout: null, once: counter());
        std\assert(v.decision == "allow", message: argvs[0].join(" "));
    }
}

test "queuing a pull request and other gh calls stay silent" {
    foreach (argv in [
        ["gh", "pr", "merge", "12", "--auto", "--squash"],
        ["gh", "pr", "merge", "12", "--disable-auto"],
        ["gh", "pr", "view", "12", "--json", "autoMergeRequest"],
        ["gh", "api", "repos/egladman/magus/collaborators/egladman/permission", "--jq", ".permission == \"admin\""],
    ]) {
        std\assert(ask(argv).decision == "allow", message: argv.join(" "));
    }
}

test "a worker whose role is not integrate may not run the gate" {
    final gate = request([["magus", "affected", "ci", "--no-default-charms"]]);
    foreach (caller in [
        Caller{ role = "worker", title = "orchestrator/feat guard-command" },
        Caller{ role = "root", title = "v050-prep/fix naming-advisory" },
        Caller{ role = "worker", title = "" },
    ]) {
        final v = decide(gate, caller: caller, checkout: null, once: counter());
        std\assert(v.decision == "deny", message: "{caller.role} {caller.title}");
        std\assert(v.reason.indexOf("integrate") != null, message: "names who may gate");
    }
    final worker = Caller{ role = "worker", title = "orchestrator/review guard-command" };
    foreach (argv in [
        ["magus", "run", "ci", "."],
        ["magus", "affected", "ci:rw"],
        ["magus", "-j", "4", "affected", "ci"],
    ]) {
        std\assert(decide(request([argv]), caller: worker, checkout: null, once: counter()).decision == "deny", message: argv.join(" "));
    }
}

test "the orchestrator, a person, an integrate worker and the plan form may gate" {
    final gate = request([["magus", "affected", "ci", "--no-default-charms"]]);
    std\assert(decide(gate, caller: person(), checkout: null, once: counter()).decision == "allow", message: "an unattributed caller");
    final integrator = Caller{ role = "worker", title = "orchestrator/integrate local-command-policy" };
    std\assert(decide(gate, caller: integrator, checkout: null, once: counter()).decision == "allow", message: "an integrate worker");
    final worker = Caller{ role = "worker", title = "orchestrator/feat guard-command" };
    final plan = request([["magus", "affected", "ci", "--plan", "--no-default-charms"]]);
    std\assert(decide(plan, caller: worker, checkout: null, once: counter()).decision == "allow", message: "the plan runs nothing");
    final narrow = request([["magus", "run", "go::go-test", ".", "--", "-run", "Guard"]]);
    std\assert(decide(narrow, caller: worker, checkout: null, once: counter()).decision == "allow", message: "narrow validation");
}

test "a detached push to a branch the remote lacks is denied, naming the full ref" {
    final detached = Checkout{ detached = true, remoteBranches = ["origin/main", "origin/naming-advisory"] };
    final v = decide(request([["git", "push", "origin", "HEAD:local-command-policy"]]), caller: person(), checkout: detached, once: counter());
    std\assert(v.decision == "deny", message: "an unknown branch");
    std\assert(v.reason.indexOf("git push origin HEAD:refs/heads/local-command-policy") != null, message: "names the fix");
    final forced = decide(request([["git", "-C", "../wt", "push", "-u", "origin", "+HEAD:topic"]]), caller: person(), checkout: detached, once: counter());
    std\assert(forced.decision == "deny", message: "a forced push, a -C and a flag");
}

test "a push the remote can place stays silent" {
    final detached = Checkout{ detached = true, remoteBranches = ["origin/main", "origin/naming-advisory"] };
    foreach (argv in [
        ["git", "push", "-q", "origin", "HEAD:naming-advisory"],
        ["git", "push", "origin", "HEAD:refs/heads/x"],
        ["git", "push", "origin", "main"],
    ]) {
        std\assert(decide(request([argv]), caller: person(), checkout: detached, once: counter()).decision == "allow", message: argv.join(" "));
    }
    final onBranch = Checkout{ detached = false, remoteBranches = [<str>] };
    std\assert(decide(request([["git", "push", "origin", "HEAD:new-branch"]]), caller: person(), checkout: onBranch, once: counter()).decision == "allow", message: "HEAD names a branch");
}

test "a code-changing spawn without its own checkout is denied" {
    foreach (title in ["orchestrator/feat guard-command", "v050-prep/fix naming-advisory", "orchestrator/docs changelog-fragments"]) {
        final v = decideSpawn("spawn", title: title, isolated: false);
        std\assert(v.decision == "deny", message: title);
        std\assert(v.reason.indexOf("isolation: \"worktree\"") != null, message: "names the fix");
    }
}

test "a thinking role, an isolated worker, a continue and an untitled spawn pass" {
    std\assert(decideSpawn("spawn", title: "v050-prep/review naming-advisory", isolated: false).decision == "allow", message: "a review");
    std\assert(decideSpawn("spawn", title: "orchestrator/feat guard-command", isolated: true).decision == "allow", message: "isolated");
    std\assert(decideSpawn("continue", title: "", isolated: false).decision == "allow", message: "a continue");
    std\assert(decideSpawn("spawn", title: "audit the store", isolated: false).decision == "allow", message: "no title grammar");
}

// fakeDisk is a tree where checkouts are checkouts of magus, binaries hold a ./magus, and
// two paths are one file only when spelled alike.
fun fakeDisk(checkouts: [str], binaries: [str]) > Disk {
    return Disk{
        isCheckout = fun (dir: str) > bool { return checkouts.indexOf(dir) != null; },
        hasBinary = fun (dir: str) > bool { return binaries.indexOf(dir) != null; },
        sameFile = fun (a: str, b: str) > bool { return a == b; },
    };
}

// Two checkouts of magus side by side, each with its own binary, and a benchmark tree.
final twoCheckouts = fakeDisk(["/w/a", "/w/b"], binaries: ["/w/a", "/w/b"]);
final inB = Where{ dir = "/w/b", workspace = "/w/b" };

fun binaryDenial(argvs: [[str]], where: Where, disk: Disk) > str {
    return decideBinaries(request(argvs), where: where, disk: disk);
}

test "another checkout's binary run against this one is denied, naming this one's binary" {
    foreach (argv in [
        ["/w/a/magus", "describe", "projects"],
        ["/w/a/magus", "run", "go-build", "."],
        ["/w/a/magus", "--root", ".", "ls"],
        ["/w/a/magus", "--root", "/w/b", "ls"],
    ]) {
        final denial = binaryDenial([argv], where: inB, disk: twoCheckouts);
        std\assert(denial.indexOf("was built in /w/a") != null, message: argv.join(" "));
        std\assert(denial.indexOf("`/w/b/magus --root /w/b ...`") != null, message: "names the right binary");
    }
    final bare = binaryDenial([["/w/a/magus", "ls"]], where: inB, disk: fakeDisk(["/w/a", "/w/b"], binaries: ["/w/a"]));
    std\assert(bare.indexOf("go -C /w/b build -o magus ./cmd/magus") != null, message: "names the bootstrap when there is no binary");
}

test "a binary run against its own checkout, on PATH, unknown, or on a non-magus tree stays silent" {
    foreach (argv in [
        ["/w/a/magus", "--root", "/w/a", "run", "go-build", "."],
        ["/w/a/magus", "--root", "../a", "ls"],
        ["/w/b/magus", "run", "lint", "."],
        ["magus", "ls"],
        ["/w/a/magus", "--root", "", "ls"],
    ]) {
        std\assert(binaryDenial([argv], where: inB, disk: twoCheckouts) == "", message: argv.join(" "));
    }
    final bench = Where{ dir = "/w/b/benchmarks/repo", workspace = "/w/b/benchmarks/repo" };
    std\assert(binaryDenial([["/w/b/magus", "affected", "ci", "--plan"]], where: bench, disk: twoCheckouts) == "", message: "magus as a tool on another workspace");
    std\assert(binaryDenial([["/opt/bin/magus", "ls"]], where: inB, disk: twoCheckouts) == "", message: "a binary outside any checkout");
    std\assert(binaryDenial([["/w/a/magus", "--root", "b", "ls"]], where: Where{ dir = "", workspace = "/w/b" }, disk: twoCheckouts) == "", message: "a relative root with no directory is unknown");
    final aliased = Disk{
        isCheckout = twoCheckouts.isCheckout,
        hasBinary = twoCheckouts.hasBinary,
        sameFile = fun (a: str, b: str) > bool { return true; },
    };
    std\assert(binaryDenial([["/w/a/magus", "--root", "/w/b", "ls"]], where: inB, disk: aliased) == "", message: "two spellings of one file");
}

test "go -C into another checkout of magus is denied for a verb its targets cover" {
    foreach (argv in [
        ["go", "-C", "/w/a", "test", "./..."],
        ["go", "test", "-C", "../a", "./..."],
        ["go", "-C=/w/a", "vet", "./..."],
        ["go", "-C", "/w/a", "mod", "tidy"],
    ]) {
        final denial = binaryDenial([argv], where: inB, disk: twoCheckouts);
        std\assert(denial.indexOf("/w/a/magus --root /w/a run <target> .") != null, message: argv.join(" "));
    }
}

test "go -C into a foreign tree, inside the workspace, or for an uncovered verb stays silent" {
    final disk = fakeDisk(["/w/a", "/w/b"], binaries: ["/w/a", "/w/b"]);
    foreach (argv in [
        ["go", "-C", "/elsewhere", "test", "./..."],
        ["go", "-C", "sub", "test", "./..."],
        ["go", "-C", "/w/a", "version"],
        ["go", "-C", "/w/a", "env", "GOPATH"],
        ["go", "test", "./..."],
    ]) {
        std\assert(binaryDenial([argv], where: inB, disk: disk) == "", message: argv.join(" "));
    }
}

test "the bootstrap link into another checkout passes only while it has no binary" {
    final fresh = fakeDisk(["/w/a", "/w/b"], binaries: ["/w/b"]);
    foreach (argv in [
        ["go", "-C", "/w/a", "build", "-o", "magus", "./cmd/magus"],
        ["go", "build", "-C", "/w/a", "-o", "/w/a/magus", "cmd/magus/"],
    ]) {
        std\assert(binaryDenial([argv], where: inB, disk: fresh) == "", message: argv.join(" "));
    }
    final built = binaryDenial([["go", "-C", "/w/a", "build", "-o", "magus", "./cmd/magus"]], where: inB, disk: twoCheckouts);
    std\assert(built.indexOf("Not a bootstrap") != null, message: "a binary already there");
    std\assert(built.indexOf("mv /w/a/magus /w/a/magus.old") != null, message: "names the deadlock escape");
    std\assert(binaryDenial([["go", "-C", "/w/a", "build", "-o", "bin/magus", "./cmd/magus"]], where: inB, disk: fresh).indexOf("run <target>") != null, message: "another output is an ordinary build");
}

fun stale(moved: [str]) > HookBinary {
    return HookBinary{ ours = true, stamped = true, moved = moved };
}

test "a ./magus whose sources moved is advised once per moved set, naming them" {
    final once = counter();
    final v = decideStale(stale(["internal/guard/shell.go"]), once: once);
    std\assert(v.decision == "advise", message: "moved");
    std\assert(v.reason.indexOf("internal/guard/shell.go") != null, message: "names the file");
    std\assert(v.reason.indexOf("./magus run go-build .") != null, message: "names the rebuild");
    std\assert(v.reason.indexOf("magus.old") == null, message: "no deadlock talk for a Go source");
    std\assert(decideStale(stale(["internal/guard/shell.go"]), once: once).decision == "allow", message: "once per set");
    std\assert(decideStale(stale(["internal/guard/shell.go", "internal/guard/guard.go"]), once: once).decision == "advise", message: "a new set speaks again");

    final decls = decideStale(stale(["internal/spell/gen/decls/magus.buzz"]), once: counter());
    std\assert(decls.reason.indexOf("mv magus magus.old") != null, message: "host declarations name the escape");
    std\assert(decls.reason.indexOf("git merge-file") != null, message: "and the gen/ repair");

    final many = decideStale(stale(["a", "b", "c", "d", "e", "f", "g"]), once: counter());
    std\assert(many.reason.indexOf("and 2 more") != null, message: "caps the list");
}

test "an unstamped ./magus is advised once; another binary and an unmoved one stay silent" {
    final once = counter();
    final unstamped = HookBinary{ ours = true, stamped = false, moved = [<str>] };
    std\assert(decideStale(unstamped, once: once).decision == "advise", message: "unstamped");
    std\assert(decideStale(unstamped, once: once).decision == "allow", message: "once");
    std\assert(decideStale(HookBinary{ ours = false, stamped = false, moved = [<str>] }, once: counter()).decision == "allow", message: "not ours");
    std\assert(decideStale(stale([<str>]), once: counter()).decision == "allow", message: "nothing moved");
}

test "the rebuild itself is not held up by the staleness it cures" {
    foreach (argv in [
        ["./magus", "run", "go-build", ".", "-s"],
        ["./magus", "run", "spells-generate:rw", "."],
        ["go", "build", "-o", "magus", "./cmd/magus"],
    ]) {
        std\assert(rebuilds(request([argv])), message: argv.join(" "));
    }
    std\assert(!rebuilds(request([["./magus", "run", "lint", "."]])), message: "any other run");
}

test "the stamp records every stamped source, and movedSince names what changed" {
    final root = fs\tempDir("stamp") catch "";
    std\assert(root != "", message: "a temp dir");
    fs\mkdirAll("{root}/internal/guard") catch void;
    fs\mkdirAll("{root}/internal/spell/gen/decls") catch void;
    fs\writeFile("{root}/internal/guard/shell.go", content: "package guard\n") catch void;
    fs\writeFile("{root}/internal/guard/shell_test.go", content: "package guard\n") catch void;
    fs\writeFile("{root}/internal/spell/gen/decls/magus.buzz", content: "export final a = 1;\n") catch void;

    final stamp = buildStamp(root) catch "";
    std\assert(stamp.indexOf("internal/guard/shell.go=") != null, message: "a rule source");
    std\assert(stamp.indexOf("internal/spell/gen/decls/magus.buzz=") != null, message: "a host declaration");
    std\assert(stamp.indexOf("shell_test.go") == null, message: "a test is not linked in");
    std\assert((movedSince(root, stamp: stamp, builtAt: 0.0) catch ["error"]).len() == 0, message: "nothing moved");

    fs\writeFile("{root}/internal/spell/gen/decls/magus.buzz", content: "export final a = 2;\n") catch void;
    fs\writeFile("{root}/internal/guard/policy.go", content: "package guard\n") catch void;
    fs\remove("{root}/internal/guard/shell.go") catch void;
    final moved = movedSince(root, stamp: stamp, builtAt: 0.0) catch [<str>];
    std\assert(moved.join(",") == "internal/guard/policy.go,internal/spell/gen/decls/magus.buzz,internal/guard/shell.go", message: moved.join(","));
    fs\removeAll(root) catch void;
}

// A CHANGELOG.md as it stands on main: an [Unreleased] section above a released one.
final changelog = "# Changelog\n\n## [Unreleased]\n\n### Added\n\n- **An entry.** Text.\n\n## [v0.4.3] - 2026-09-06\n\n### Fixed\n\n- **A fix.** Text.\n";

test "adding to [Unreleased] by hand is denied once fragments exist" {
    final edit = decideChangelog(true, current: changelog, content: "", oldText: "- **An entry.** Text.\n", newText: "- **An entry.** Text.\n- **Mine.** More.\n");
    std\assert(edit.decision == "deny", message: "an edit");
    std\assert(edit.reason.indexOf("changes/unreleased/") != null, message: "names the fragment path");
    final write = decideChangelog(true, current: changelog, content: changelog.replace("### Added\n", "### Added\n\n- **Mine.**\n"), oldText: "", newText: "");
    std\assert(write.decision == "deny", message: "a whole-file write");
}

test "a released section's fix, a checkout without fragments and an unknown edit pass" {
    std\assert(decideChangelog(true, current: changelog, content: "", oldText: "- **A fix.** Text.", newText: "- **A fix.** Text, corrected.").decision == "allow", message: "a past release");
    std\assert(decideChangelog(false, current: changelog, content: "", oldText: "- **An entry.** Text.\n", newText: "- **Mine.**\n").decision == "allow", message: "no fragments yet");
    std\assert(decideChangelog(true, current: changelog, content: "", oldText: "", newText: "").decision == "allow", message: "a shape magus does not read");
    final cut = changelog.replace("## [Unreleased]\n\n### Added\n\n- **An entry.** Text.\n\n", "## [Unreleased]\n\n## [v0.5.0] - 2026-09-24\n\n### Added\n\n- **An entry.** Text.\n\n");
    std\assert(decideChangelog(true, current: changelog, content: cut, oldText: "", newText: "").decision == "allow", message: "a release cut moves lines out");
}
