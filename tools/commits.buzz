// The one conventional-commit rule this repository enforces, shared by
// the pull request title check (the pr-title target) and tools/git-hooks/commit-msg.buzz,
// so the two cannot disagree about what a subject may look like.
//
// Squash merges make a pull request's title the subject that lands on main, so the title
// is the enforcement point. Branch commits are squashed away and keep the repository's
// lowercase imperative style with no prefix; the hook checks only commits made directly on
// the base branch, which land as written.
namespace commits;

import "std";

// The accepted types. Each names a kind of change a reader filters history by; `style`
// is left out because the formatters own whitespace and a commit that only reformats
// is a `chore`.
export fun types() > [str] {
    return ["build", "chore", "ci", "docs", "feat", "fix", "perf", "refactor", "revert", "test"];
}

// commitlint's default header-max-length, counted in bytes because Buzz strings are
// byte-indexed. Subjects on main already run past git's customary 72 when a semicolon
// joins two clauses.
export fun maxLength() > int {
    return 100;
}

// typeOf returns subject's type with the scope and `!` stripped, or "" when it has no
// `<type>: ` prefix. It does not check the type is known; problem does.
export fun typeOf(subject: str) > str {
    var head = headerOf(subject) ?? "";
    if (head.endsWith("!")) {
        head = head.sub(0, len: head.len() - 1);
    }
    final open = head.indexOf("(");
    if (open != null) {
        head = head.sub(0, len: open);
    }
    return head;
}

// isBreaking reports whether subject marks a breaking change with `!` before its colon.
export fun isBreaking(subject: str) > bool {
    return (headerOf(subject) ?? "").endsWith("!");
}

fun headerOf(subject: str) > str? {
    final colon = subject.indexOf(": ");
    if (colon == null) { return null; }
    return subject.sub(0, len: colon);
}

// problem returns "" when subject is `<type>[(<scope>)][!]: <description>`, and otherwise
// the reason it is not, phrased to be printed as is.
//
// The description keeps the repository's own style: it must not open in sentence case
// ("Add x", "A fix"), so "add x" and an identifier such as "MGS1039" or "README" both
// pass, and it must not end with a period.
export fun problem(subject: str) > str {
    final form = "want `<type>(<scope>): <description>`, e.g. `fix(cache): keep the key stable across runs`";
    if (subject.len() > maxLength()) {
        return "{subject.len()} bytes, over the {maxLength()} a subject may run";
    }
    final header = headerOf(subject);
    if (header == null) {
        return "no `<type>: ` prefix; " + form;
    }
    var head = header;
    final description = subject.sub(head.len() + 2);
    if (head.endsWith("!")) {
        head = head.sub(0, len: head.len() - 1);
    }
    final open = head.indexOf("(");
    if (open != null) {
        if (!head.endsWith(")")) {
            return "unclosed scope in `{head}`; " + form;
        }
        final scope = head.sub(open + 1, len: head.len() - open - 2);
        if (scope == "" or scope.lower() != scope or scope.indexOf(" ") != null) {
            return "scope `{scope}` must be lowercase with no spaces";
        }
    }
    final kind = typeOf(subject);
    if (types().indexOf(kind) == null) {
        return "unknown type `{kind}`; want one of " + types().join(", ");
    }
    if (description.trim() == "" or description.startsWith(" ")) {
        return "empty description after `{head}: `";
    }
    if (description.endsWith(".")) {
        return "description ends with a period";
    }
    // An all-caps first word is an identifier; a lone capital ("A", "I") is prose.
    var word = description;
    final space = description.indexOf(" ");
    if (space != null) { word = description.sub(0, len: space); }
    final first = word.sub(0, len: 1);
    if (first != first.lower() and (word.len() == 1 or word != word.upper())) {
        return "description opens in sentence case (`{word}`); write it lowercase imperative";
    }
    return "";
}

test "a conventional subject in the repository's style passes" {
    std\assert(problem("feat: add a commit-msg git hook") == "", message: "bare type");
    std\assert(problem("fix(cache): keep the key stable across runs") == "", message: "scoped");
    std\assert(problem("feat(agent/harness)!: install git hooks on apply") == "", message: "breaking marker with a nested scope");
    std\assert(problem("docs: README framing; one line per audience") == "", message: "semicolons are prose, not structure");
    std\assert(problem("fix: MGS1039 reports the missing import") == "", message: "an identifier may open the description");
}

test "the type and breaking marker are read past the scope" {
    std\assert(typeOf("feat(cache)!: drop the v1 key") == "feat", message: "scoped and breaking");
    std\assert(typeOf("chore: bump go") == "chore", message: "bare type");
    std\assert(typeOf("add a hook") == "", message: "no prefix");
    std\assert(isBreaking("chore!: drop go 1.24"), message: "breaking without a scope");
    std\assert(isBreaking("feat(cache)!: drop the v1 key"), message: "breaking after a scope");
    std\assert(!isBreaking("feat(cache): add a key"), message: "not breaking");
    std\assert(!isBreaking("feat: say hi!"), message: "a bang in the description is prose");
}

test "a subject outside the form names what is wrong" {
    std\assert(problem("add a commit-msg hook").startsWith("no `<type>: ` prefix"), message: "the repository's branch style has no type");
    std\assert(problem("feature: add a hook").startsWith("unknown type `feature`"), message: "unknown type");
    std\assert(problem("feat(Cache): add").startsWith("scope `Cache`"), message: "uppercase scope");
    std\assert(problem("feat(cache: add").startsWith("unclosed scope"), message: "unclosed scope");
    std\assert(problem("feat: Add a hook") == "description opens in sentence case (`Add`); write it lowercase imperative", message: "sentence case");
    std\assert(problem("feat: A hook for commits") == "description opens in sentence case (`A`); write it lowercase imperative", message: "a lone capital is prose");
    std\assert(problem("feat: add a hook.") == "description ends with a period", message: "trailing period");
    std\assert(problem("feat:  add").startsWith("empty description"), message: "double space");
    std\assert(problem("feat: " + "x".repeat(100)).endsWith("over the 100 a subject may run"), message: "too long");
}
