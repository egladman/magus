{
  "schema_version": 2,
  "id": "codex",
  "display": {
    "name": "Codex"
  },
  "config": {
    "path": ".codex/hooks.json"
  },
  "skills": {"paths": [".agents/skills"], "form": "both"},
  "managed_entries": [
    {
      "path": ["hooks", "PreToolUse"],
      "entries": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "__MAGUS_AGENT_NAME=codex sh docs/guides/integrations/agents/magus-hook-command.sh",
              "statusMessage": "magus guard: checking command"
            }
          ]
        },
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "__MAGUS_AGENT_NAME=codex sh docs/guides/integrations/agents/magus-hook-path.sh",
              "statusMessage": "magus guard: checking file"
            }
          ]
        },
        {
          "matcher": "Read",
          "hooks": [
            {
              "type": "command",
              "command": "__MAGUS_AGENT_NAME=codex sh docs/guides/integrations/agents/magus-hook-observe.sh",
              "statusMessage": "magus: recording read"
            }
          ]
        },
        {
          "matcher": "mcp__.*",
          "hooks": [
            {
              "type": "command",
              "command": "__MAGUS_AGENT_NAME=codex HOST_EVENT_RAW=1 sh docs/guides/integrations/agents/magus-hook-command.sh",
              "statusMessage": "magus guard: checking MCP tool call"
            }
          ]
        }
      ]
    },
    {
      "path": ["hooks", "PermissionRequest"],
      "entries": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "__MAGUS_AGENT_NAME=codex sh docs/guides/integrations/agents/magus-hook-command.sh",
              "statusMessage": "magus guard: checking approval"
            }
          ]
        }
      ]
    },
    {
      "path": ["hooks", "SessionStart"],
      "entries": [
        {
          "matcher": "compact",
          "hooks": [
            {
              "type": "command",
              "command": "REHYDRATE_FORMAT=json REHYDRATE_RULES=AGENTS.md sh docs/guides/integrations/agents/magus-rehydrate.sh",
              "statusMessage": "magus: restating this checkout's rules"
            }
          ]
        }
      ]
    },
    {
      "path": ["hooks", "Stop"],
      "entries": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__MAGUS_AGENT_NAME=codex sh docs/guides/integrations/agents/magus-checkpoint.sh",
              "statusMessage": "magus: recording where the work stands"
            }
          ]
        }
      ]
    }
  ],
  "prompts": [
    {
      "path": ".codex/rules/magus.rules",
      "content": "# Written by magus agent harness apply --id codex. magus agent harness remove deletes it.\n#\n# Every git push raises an approval request. The magus PermissionRequest hook answers it:\n# a push a passing gate covers is approved without asking, an ungated push is left to\n# the person, and a push from a leased worker is refused.\nprefix_rule(\n    pattern = [\"git\", \"push\"],\n    decision = \"prompt\",\n    justification = \"magus: publishing a commit no passing gate covers needs your approval\",\n)\n"
    }
  ]
}
