{
  "schema_version": 2,
  "id": "claude-code",
  "display": {
    "name": "Claude Code"
  },
  "config": {
    "path": ".claude/settings.json"
  },
  "skills": {"paths": [".claude/skills"], "form": "both"},
  "managed_entries": [
    {
      "path": ["hooks", "PreToolUse"],
      "entries": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "magus buzz -s docs/guides/integrations/agents/magus-hook-command.buzz",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "Edit|Write|NotebookEdit",
          "hooks": [
            {
              "type": "command",
              "command": "magus buzz -s docs/guides/integrations/agents/magus-hook-path.buzz",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "^mcp__magus__",
          "hooks": [
            {
              "type": "command",
              "command": "HOST_EVENT_RAW=1 magus buzz -s docs/guides/integrations/agents/magus-hook-command.buzz",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "Read",
          "hooks": [
            {
              "type": "command",
              "command": "magus buzz -s docs/guides/integrations/agents/magus-hook-observe.buzz",
              "timeout": 10
            }
          ]
        },
        {
          "matcher": "Agent|Task",
          "hooks": [
            {
              "type": "command",
              "command": "HOST_EVENT_RAW=1 magus buzz -s docs/guides/integrations/agents/magus-hook-command.buzz",
              "timeout": 10
            }
          ]
        }
      ]
    },
    {
      "path": ["hooks", "SessionStart"],
      "entries": [
        {
          "matcher": "compact",
          "hooks": [
            {
              "type": "command",
              "command": "sh docs/guides/integrations/agents/magus-rehydrate.sh",
              "timeout": 10
            }
          ]
        }
      ]
    },
    {
      "path": ["hooks", "Stop"],
      "entries": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh docs/guides/integrations/agents/magus-checkpoint.sh",
              "timeout": 10
            }
          ]
        }
      ]
    }
  ]
}
