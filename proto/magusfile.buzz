import "magus";
import "magus/spell/buf";
import "magus/spell/go";
import "project/../docs";
import "project/../console";
import "../hack/drift" as drift;
import "../hack/index" as index;
import "fs";
import "vcs";

magus\project({
    // go because buf.gen.yaml runs its plugins through `go tool`.
    "spells": [buf, go],
    "outputs": ["gen/**"],
    // generate stays cached, unlike the other drift gates: it calls a remote buf
    // plugin, and uncached runs exhaust the BSR rate limit.
});

// generate runs buf codegen and fails if a committed generated tree drifted.
// buf-build keeps the proto comments protoc-gen-go strips; cmd/magus-protodocs reads them.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    // TODO: a protoc-gen-go bump (pinned by the root go.mod) reruns nothing. Declaring
    // ../go.mod would rerun on every dependency bump; this wants a per-target version probe.
    ctx.needs(index_generate);
    // The TS client trees are declared here, not by docs and console: only this target
    // produces them, and two claims on one path is MGS4002. gen/** is restated because
    // writesFiles replaces the spell baseline.
    ctx.writesFiles("gen/**", docs\file("src/gen/**"), console\file("src/gen/**"));
    // The root generate gate never runs buf, so this gates all three trees itself.
    final GENERATED = ["gen", fs\join("..", "docs", "src", "gen"),
                       fs\join("..", "console", "src", "gen")];
    final before = drift\hashes(GENERATED);
    buf["buf-generate"](ctx);
    buf["buf-build"](ctx, {"args": ["-o", "gen/descriptor.binpb"]});
    if (ctx.hasCharm("rw")) { return; }
    final changed = drift\changedSince(before, GENERATED);
    if (changed.len() > 0) {
        var body = vcs\dirtyDiff(changed);
        if (body.len() > 4000) {
            body = body.sub(0, len: 4000)
                + "\n... truncated; `magus query output <ref>` has it all";
        }
        if (body != "") {
            magus\log.info("generate: what changed on this runner:\n" + body);
        }
        // Blind to a file buf should have deleted: a .proto rename's old tree is unchanged.
        throw "generate: regeneration changed generated files; re-run "
            + "`magus run generate:rw proto` and commit: " + changed.join(", ")
            + drift\secondCause;
    }
}

// Renders MAGUS.md, this project's target catalog.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("MAGUS.md");
    ctx.readsFiles("magusfile.buzz", "../magus.yaml", "../internal/render/target_graph.go",
                   "../internal/render/md/md.go", "../internal/hint/cli_command.go");
    index\render("proto");
}

export fun lint(ctx: magus\Context, args: [str]) > void { buf["buf-lint"](ctx); }
export fun ci(ctx: magus\Context, args: [str]) > void {
    // TODO: add buf-breaking. It must resolve the default branch (no hardcoded "main"),
    // skip when proto/buf.yaml is absent at that ref, and pass subdir=proto; the stock
    // op assumes the module sits at the git root.
    ctx.needs(generate, lint);
}
