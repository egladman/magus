{
  // The ROOT project's own Markdown. Every project carries its own dprint.json extending
  // dprint-base.json, so rules live with the project, the way biome.json already does.
  //
  // Patterns are "./"-anchored: a slash-less dprint pattern matches at any depth, so a
  // bare "*.md" would sweep every project from here.
  //
  // dprint DISCOVERS nested configs, so a run started at the workspace root also formats
  // each child project under that child's own config. That is dprint's monorepo model and
  // cannot be excluded away - a parent exclude does not prune a subtree that owns a
  // config. `magus run format <project>` still scopes correctly, because the op runs in
  // that project's directory.
  "extends": "./dprint-base.json",
  //
  // internal/agent/agents-section.md is here because it is EMBEDDED and then pasted into
  // AGENTS.md, which this config does format. Left out, the source drifted from
  // dprint's normal form and `magus agent sample` emitted a block that dirtied the
  // tree the moment a human followed its own paste instruction. A generated block and
  // its destination have to agree on a formatter.
  "includes": ["./*.md", "./benchmarks/**/*.md", "./tapes/**/*.md", "./internal/agent/agents-section.md"],
  // MAGUS.md is generated outright. CHANGELOG.md is a HYBRID: hand-authored prose with a
  // generated block inside (changelog-generate), so formatting it oscillates - dprint
  // rewrites the block, the generator puts it back. Excluded until that generator emits
  // dprint-normal output.
  //
  // AGENTS.md was excluded here for the same reason and no longer is: no generator writes
  // it. `magus agent install` PRINTS its block for a human to paste, so dprint formats the
  // file once and nothing puts it back.
  "excludes": ["./MAGUS.md", "./CHANGELOG.md"]
}
