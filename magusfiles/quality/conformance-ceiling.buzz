// The conformance ceiling policy the lint target holds a change to, and its verdict. magus
// measures the base revision and the head; the comparison is this file's. Counts come from
// the base revision on every run, so nothing here records one, and lowering an anchor edits
// magus.yaml, never this file.
namespace conformanceceiling;

import "assert";
import "magus";

// Conformance names the metrics held to a conformance ceiling. The rest stay advice,
// printed and never failing: most of what they flag is a size or a shape chosen on purpose.
export object Conformance {
    checks: [str],

    // holds reports whether metric is held to a ceiling.
    fun holds(metric: str) > bool {
        return this.checks.indexOf(metric) != null;
    }

    // judge compares head's rows with base's under this policy. A touched file may not hold more
    // violations of a checked metric than it held at the base, and an item past its anchor at the
    // base may not move further past it. A violation follows its declaration, not its path: one
    // whose digest equals a base violation's of the same metric only moved, so neither side
    // counts it, equal IDs pairing first so a new copy is what counts. A violation left over
    // pairs with the base violation of its key and ID, which is the same item edited: it counts
    // in no file, and is growth when it moved further past the anchor.
    fun judge(base: magus\ConformanceBase, head: [magus\ConformanceDistribution]) > Verdict {
        final was = this.placed(base.distributions);
        final now = this.placed(head);
        final pairedWas = mut {<int: bool>};
        final pairedNow = mut {<int: bool>};
        final byDigest = mut {<str: [int]>};
        foreach (j, b in was) {
            if (b.item.digest != "") {
                final id = "{b.key.metric.value}\n{b.item.digest}";
                final at = byDigest[id] ?? [<int>];
                byDigest[id] = at + [j];
            }
        }
        pairByDigest(was, now: now, byDigest: byDigest, pairedWas: pairedWas, pairedNow: pairedNow, sameID: true);
        pairByDigest(was, now: now, byDigest: byDigest, pairedWas: pairedWas, pairedNow: pairedNow, sameID: false);

        final byID = mut {<str: int>};
        foreach (j, b in was) {
            if (!(pairedWas[j] ?? false)) {
                byID["{keyLabel(b.key)}\n{b.item.id}"] = j;
            }
        }
        final packages = mut {<str: magus\ConformancePackage>};
        foreach (p in base.packages) {
            packages[p.dir] = p;
        }
        final growth = mut [<Growth>];
        foreach (i, h in now) {
            if (pairedNow[i] ?? false) {
                continue;
            }
            final paired = byID["{keyLabel(h.key)}\n{h.item.id}"];
            if (paired -> j) {
                if (!(pairedWas[j] ?? false)) {
                    pairedWas[j] = true;
                    pairedNow[i] = true;
                    final metric = h.key.metric.value;
                    var measure = h.item.measure;
                    if (metric == "imported-packages") {
                        measure = measure - movedImports(h.item, base: packages);
                    }
                    if (further(metric, now: measure, was: was[j].item.measure)) {
                        growth.append(Growth{ key = h.key, value = h.value, item = h.item, was = was[j].item.measure });
                    }
                }
            }
        }

        final ceilings = mut [<Ceiling>];
        foreach (row in head) {
            if (!this.holds(row.key.metric.value)) {
                continue;
            }
            final label = keyLabel(row.key);
            final metric = row.key.metric.value;
            final after = mut [<magus\ConformanceItem>];
            foreach (i, h in now) {
                if (!(pairedNow[i] ?? false) and keyLabel(h.key) == label) {
                    if (metric == "imported-packages") {
                        final moved = movedImports(h.item, base: packages);
                        if (moved > 0 and !past(metric, measure: h.item.measure - moved, value: row.value)) {
                            continue;
                        }
                    }
                    after.append(h.item);
                }
            }
            final before = mut [<magus\ConformanceItem>];
            foreach (j, b in was) {
                if (!(pairedWas[j] ?? false) and keyLabel(b.key) == label) {
                    before.append(b.item);
                }
            }
            foreach (file in base.touched) {
                final items = itemsIn(after, metric: metric, file: file);
                final count = itemsIn(before, metric: metric, file: file).len();
                if (items.len() > count) {
                    ceilings.append(Ceiling{ key = row.key, value = row.value, file = file, base = count, head = items.len(), violations = items });
                }
            }
        }
        return Verdict{ ceilings = ceilings, growth = growth };
    }

    // placed is each violation of a checked metric in rows, in row order.
    fun placed(rows: [magus\ConformanceDistribution]) > [Placed] {
        final all = mut [<Placed>];
        foreach (row in rows) {
            if (!this.holds(row.key.metric.value)) {
                continue;
            }
            foreach (it in row.violations) {
                all.append(Placed{ key = row.key, value = row.value, item = it });
            }
        }
        return all;
    }
}

export final POLICY = Conformance{
    checks = ["file-lines", "func-lines", "clone-tokens", "export-scope", "imported-packages", "main-logic", "store-path-export", "file-split"],
};

// Verdict is what a change crossed: the touched files whose count of violations rose, and the
// items already past their anchor at the base that moved further past it.
export object Verdict {
    ceilings: [Ceiling],
    growth: [Growth],
}

// Ceiling is one touched file whose violations of key rose past its count at the base: base and
// head are the two counts, violations the head's items in the file, and value the key's anchor.
export object Ceiling {
    key: magus\ConformanceKey,
    value: int,
    file: str,
    base: int,
    head: int,
    violations: [magus\ConformanceItem],
}

// Growth is an item past value, its key's anchor, at the base and further past it at head: was
// is its measure at the base and item its head violation.
export object Growth {
    key: magus\ConformanceKey,
    value: int,
    item: magus\ConformanceItem,
    was: int,
}

// Placed is one violation beside its row's key and anchor.
export object Placed {
    key: magus\ConformanceKey,
    value: int,
    item: magus\ConformanceItem,
}

// pairByDigest pairs each unpaired head violation with the first unpaired base one of its
// metric and digest; sameID asks for an equal ID too. An empty digest pairs with nothing.
fun pairByDigest(was: [Placed], now: [Placed], byDigest: {str: [int]}, pairedWas: mut {int: bool}, pairedNow: mut {int: bool}, sameID: bool) > void {
    foreach (i, h in now) {
        if ((pairedNow[i] ?? false) or h.item.digest == "") {
            continue;
        }
        foreach (j in byDigest["{h.key.metric.value}\n{h.item.digest}"] ?? [<int>]) {
            if (!(pairedWas[j] ?? false) and (!sameID or was[j].item.id == h.item.id)) {
                pairedWas[j] = true;
                pairedNow[i] = true;
                break;
            }
        }
    }
}

// past reports whether measure is past value: above it for a ceiling, at or under it for the
// file-split floor.
export fun past(metric: str, measure: int, value: int) > bool {
    if (metric == "file-split") {
        return measure <= value;
    }
    return measure > value;
}

// further reports whether now is further past the anchor than was.
export fun further(metric: str, now: int, was: int) > bool {
    if (metric == "file-split") {
        return now < was;
    }
    return now > was;
}

// movedImports counts the imports of it, an imported-packages item, that only follow moved
// declarations: new since base, each declaration it reaches had its digest at base in a package
// the importer already imported.
export fun movedImports(it: magus\ConformanceItem, base: {str: magus\ConformancePackage}) > int {
    final importer = base[it.id];
    if (importer == null) {
        return 0;
    }
    final held = mut {<str: bool>};
    foreach (imported in importer!.imports) {
        foreach (d in base[imported]?.digests ?? [<str>]) {
            held[d] = true;
        }
    }
    var n = 0;
    foreach (imp in it.imports) {
        if (imp.digests.len() == 0 or importer!.imports.indexOf(imp.dir) != null) {
            continue;
        }
        var reached = true;
        foreach (d in imp.digests) {
            if (!(held[d] ?? false)) {
                reached = false;
            }
        }
        if (reached) {
            n = n + 1;
        }
    }
    return n;
}

// itemsIn is the items of metric that name file. An item counts in every file it names: a clone
// group in each member's file, and an imported-packages package in every file directly inside it.
export fun itemsIn(items: [magus\ConformanceItem], metric: str, file: str) > [magus\ConformanceItem] {
    final found = mut [<magus\ConformanceItem>];
    foreach (it in items) {
        foreach (member in it.id.split(", ")) {
            final hash = member.indexOf("#");
            final name = if (hash != null) member.sub(0, len: hash!) else member;
            if ((metric == "imported-packages" and member == dir(file)) or (metric != "imported-packages" and name == file)) {
                found.append(it);
                break;
            }
        }
    }
    return found;
}

// dir is file's directory, "." for a file at the root.
fun dir(file: str) > str {
    final parts = file.split("/");
    if (parts.len() < 2) {
        return ".";
    }
    return parts.sub(0, len: parts.len() - 1).join("/");
}

// keyLabel names a row's metric, population and scope as a person reads them.
export fun keyLabel(key: magus\ConformanceKey) > str {
    final metric: str = key.metric.value;
    final population: str = key.population.value;
    final scope: str = key.scope;
    if (scope != "") {
        return "{metric} {population} {scope}";
    }
    return "{metric} {population}";
}

final FUNC_LINES = magus\ConformanceKey{ metric = magus\ConformanceMetric.funcLines, population = magus\ConformancePopulation.source };
final CLONES = magus\ConformanceKey{ metric = magus\ConformanceMetric.cloneTokens, population = magus\ConformancePopulation.source };
final IMPORTS = magus\ConformanceKey{ metric = magus\ConformanceMetric.importedPackages, population = magus\ConformancePopulation.source };

fun item(id: str, measure: int = 0, digest: str = "") > magus\ConformanceItem {
    return magus\ConformanceItem{ id = id, measure = measure, digest = digest };
}

fun rows(key: magus\ConformanceKey, items: [magus\ConformanceItem], value: int = 0) > [magus\ConformanceDistribution] {
    return [magus\ConformanceDistribution{ key = key, value = value, violations = items }];
}

fun base(rows: [magus\ConformanceDistribution], touched: [str], packages: [magus\ConformancePackage] = [<magus\ConformancePackage>]) > magus\ConformanceBase {
    return magus\ConformanceBase{ commit = "0123456789abcdef", distributions = rows, packages = packages, touched = touched };
}

fun held(checks: [str]) > Conformance {
    return Conformance{ checks = checks };
}

// splitBase is a base where internal/w imports lib, and types too when importsTypes is set. That
// package holds digests, else one it never imported does.
fun splitBase(importsTypes: bool, digests: [str]) > magus\ConformanceBase {
    final home = if (importsTypes) "types" else "other";
    final imports = if (importsTypes) ["lib", "types"] else ["lib"];
    return base([<magus\ConformanceDistribution>], touched: ["internal/w/w.go"], packages: [
        magus\ConformancePackage{ dir = "internal/w", imports = imports },
        magus\ConformancePackage{ dir = home, digests = digests }]);
}

// splitHead is a head where internal/w also imports types/agent, past its anchor of 2, reaching
// declarations with digests.
fun splitHead(digests: [str]) > [magus\ConformanceDistribution] {
    final it = magus\ConformanceItem{ id = "internal/w", measure = 3, imports = [
        magus\ConformanceImport{ dir = "lib", digests = ["d9"] },
        magus\ConformanceImport{ dir = "types", digests = ["d2"] },
        magus\ConformanceImport{ dir = "types/agent", digests = digests }] };
    return rows(IMPORTS, items: [it], value: 2);
}

test "a metric in checks is held and any other is advice" {
    assert\equal(POLICY.holds("func-lines"), want: true, message: "held");
    assert\equal(POLICY.holds("shared-reach"), want: false, message: "advice");
}

test "a file whose count rose is a ceiling naming both counts" {
    final got = held(["func-lines"]).judge(base(rows(FUNC_LINES, items: [item("a.go#F")]), touched: ["a.go"]),
        head: rows(FUNC_LINES, items: [item("a.go#F"), item("a.go#G")])).ceilings;
    assert\equal(got.len(), want: 1, message: "one ceiling");
    assert\equal(got[0].file, want: "a.go", message: "the file");
    assert\equal(got[0].base, want: 0, message: "F paired by ID, so only G counts");
    assert\equal(got[0].head, want: 1, message: "G");
    assert\equal(got[0].violations[0].id, want: "a.go#G", message: "the new violation");
}

test "a file whose count held or dropped passes" {
    final got = held(["func-lines"]).judge(base(rows(FUNC_LINES, items: [item("a.go#F"), item("b.go#F")]), touched: ["a.go", "b.go"]),
        head: rows(FUNC_LINES, items: [item("a.go#G")]));
    assert\equal(got.ceilings.len(), want: 0, message: "a.go holds one, as before");
}

test "only touched files and checked metrics are judged" {
    final head = rows(FUNC_LINES, items: [item("a.go#F")]);
    assert\equal(held(["func-lines"]).judge(base([<magus\ConformanceDistribution>], touched: ["b.go"]), head: head).ceilings.len(), want: 0,
        message: "untouched");
    assert\equal(held(["file-lines"]).judge(base([<magus\ConformanceDistribution>], touched: ["a.go"]), head: head).ceilings.len(), want: 0,
        message: "unchecked");
}

test "a clone group counts in each member's file, a package in each file directly inside it" {
    final clones = held(["clone-tokens"]).judge(base([<magus\ConformanceDistribution>], touched: ["a.go", "b.go"]),
        head: rows(CLONES, items: [item("a.go#F, b.go#G")])).ceilings;
    assert\equal(clones.len(), want: 2, message: "both members");
    final pkg = held(["imported-packages"]).judge(base([<magus\ConformanceDistribution>], touched: ["internal/a/a.go", "internal/a/b/b.go"]),
        head: rows(IMPORTS, items: [item("internal/a")])).ceilings;
    assert\equal(pkg.len(), want: 1, message: "directly inside");
    assert\equal(pkg[0].file, want: "internal/a/a.go", message: "not the nested file");
}

test "a pure move, or a move and a rename, passes" {
    final b = base(rows(FUNC_LINES, items: [item("a.go#F", digest: "d1")]), touched: ["a.go", "b.go", "sub/b.go"]);
    assert\equal(held(["func-lines"]).judge(b, head: rows(FUNC_LINES, items: [item("b.go#F", digest: "d1")])).ceilings.len(), want: 0,
        message: "move");
    assert\equal(held(["func-lines"]).judge(b, head: rows(FUNC_LINES, items: [item("sub/b.go#G", digest: "d1")])).ceilings.len(), want: 0,
        message: "move and rename");
}

test "a move with an edited body, a copy beside its original, or a move with no digest is charged" {
    final edited = held(["func-lines"]).judge(base(rows(FUNC_LINES, items: [item("a.go#F", digest: "d1")]), touched: ["a.go", "b.go"]),
        head: rows(FUNC_LINES, items: [item("b.go#F", digest: "d2")])).ceilings;
    assert\equal(edited.len(), want: 1, message: "edited");
    assert\equal(edited[0].file, want: "b.go", message: "at its new file");
    final copied = held(["func-lines"]).judge(base(rows(FUNC_LINES, items: [item("a.go#F", digest: "d1")]), touched: ["a.go", "b.go"]),
        head: rows(FUNC_LINES, items: [item("a.go#F", digest: "d1"), item("b.go#F", digest: "d1")])).ceilings;
    assert\equal(copied.len(), want: 1, message: "copy");
    assert\equal(copied[0].file, want: "b.go", message: "the copy, not the original");
    final bare = held(["func-lines"]).judge(base(rows(FUNC_LINES, items: [item("a.go#F")]), touched: ["a.go", "b.go"]),
        head: rows(FUNC_LINES, items: [item("b.go#F")])).ceilings;
    assert\equal(bare.len(), want: 1, message: "no digest");
}

test "a digest pairs only within a metric" {
    final got = held(["func-lines", "clone-tokens"]).judge(base(rows(CLONES, items: [item("a.go#F", digest: "d1")]), touched: ["b.go"]),
        head: rows(FUNC_LINES, items: [item("b.go#F", digest: "d1")])).ceilings;
    assert\equal(got.len(), want: 1, message: "charged");
}

test "a split into a new package passes; a changed declaration, another importer's, or no digest is charged" {
    final p = held(["imported-packages"]);
    assert\equal(p.judge(splitBase(true, digests: ["d1", "d2"]), head: splitHead(["d1"])).ceilings.len(), want: 0, message: "split");
    final changed = p.judge(splitBase(true, digests: ["d1", "d2"]), head: splitHead(["d1", "d3"])).ceilings;
    assert\equal(changed.len(), want: 1, message: "changed declaration");
    assert\equal(changed[0].head, want: 1, message: "one count");
    assert\equal(p.judge(splitBase(false, digests: ["d1"]), head: splitHead(["d1"])).ceilings.len(), want: 1, message: "another importer's");
    assert\equal(p.judge(splitBase(true, digests: ["d1"]), head: splitHead([<str>])).ceilings.len(), want: 1, message: "no digest");
}

test "an item past its anchor that grows is growth, and counts in no file" {
    final got = held(["func-lines"]).judge(base(rows(FUNC_LINES, items: [item("a.go#Judge", measure: 328, digest: "d1")], value: 167), touched: ["a.go"]),
        head: rows(FUNC_LINES, items: [item("a.go#Judge", measure: 957, digest: "d2")], value: 167));
    assert\equal(got.ceilings.len(), want: 0, message: "the file holds one, as before");
    assert\equal(got.growth.len(), want: 1, message: "growth");
    assert\equal(got.growth[0].was, want: 328, message: "its base measure");
    assert\equal(got.growth[0].item.measure, want: 957, message: "its head measure");
}

test "an item past its anchor may shrink, or be edited at its size" {
    final b = base(rows(FUNC_LINES, items: [item("a.go#F", measure: 300, digest: "d1")], value: 167), touched: ["a.go"]);
    final p = held(["func-lines"]);
    assert\equal(p.judge(b, head: rows(FUNC_LINES, items: [item("a.go#F", measure: 290, digest: "d2")], value: 167)).growth.len(), want: 0,
        message: "shrunk");
    assert\equal(p.judge(b, head: rows(FUNC_LINES, items: [item("a.go#F", measure: 300, digest: "d3")], value: 167)).growth.len(), want: 0,
        message: "edited at its size");
}

test "a file-split sibling grows past its floor by shrinking" {
    final key = magus\ConformanceKey{ metric = magus\ConformanceMetric.fileSplit, population = magus\ConformancePopulation.source };
    final got = held(["file-split"]).judge(base(rows(key, items: [item("a_b.go", measure: 900)], value: 1500), touched: ["a_b.go"]),
        head: rows(key, items: [item("a_b.go", measure: 800)], value: 1500));
    assert\equal(got.growth.len(), want: 1, message: "further under the floor");
}

test "a package past its anchor that only follows a moved declaration has not grown" {
    final b = magus\ConformanceBase{ commit = "c", touched = ["internal/w/w.go"], packages = [
        magus\ConformancePackage{ dir = "internal/w", imports = ["lib", "types"] },
        magus\ConformancePackage{ dir = "types", digests = ["d1"] }],
        distributions = rows(IMPORTS, items: [magus\ConformanceItem{ id = "internal/w", measure = 2 }], value: 1) };
    final head = rows(IMPORTS, items: [magus\ConformanceItem{ id = "internal/w", measure = 3, imports = [
        magus\ConformanceImport{ dir = "lib", digests = ["d9"] },
        magus\ConformanceImport{ dir = "types", digests = ["d2"] },
        magus\ConformanceImport{ dir = "types/agent", digests = ["d1"] }] }], value: 1);
    assert\equal(held(["imported-packages"]).judge(b, head: head).growth.len(), want: 0, message: "moved");
}
