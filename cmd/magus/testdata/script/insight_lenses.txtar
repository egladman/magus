# insight has five lenses. Four (hotspots, affinity, ownership, trend) read the git
# commit log; volatility reads run-outcome history instead (a Wilson-scored flakiness
# signal from the shared runtime-history file, NOT git) and so behaves the same with or
# without a VCS repo present. report stitches all four VCS lenses plus graph stats into
# one Markdown doc.
#
# With no git repo at all, the VCS lenses fail loudly rather than silently reporting
# nothing - but the failure just forwards git's raw exit status instead of naming the
# actual problem (this is not a git repository). Worth fixing, not fixed here.
! exec magus insight hotspots
stderr 'git log: exit status 128'
! stdout .

# volatility does not touch git, so it succeeds even with no repository and no history
# file: an empty result (header only, no rows) rather than an error.
exec magus insight volatility
stdout 'volatility \(threshold 0\.050, from run-outcome history\)'
stdout 'SCORE\s+VOL\?\s+PASS\s+FAIL\s+VOLCNT\s+SAMPLES\s+LAST\s+PROJECT:TARGET'

# Build a real git history so the VCS lenses have something to read: three commits,
# touching two different files, under one author.
exec git init
exec git config user.email test@example.com
exec git config user.name Test
exec git add magus.yaml .gitignore magusfile.buzz spells/acme/spell.buzz
exec git commit -m initial
cp spells/acme/spell.buzz.v2 spells/acme/spell.buzz
exec git add spells/acme/spell.buzz
exec git commit -m touch-acme
cp magusfile.buzz.v2 magusfile.buzz
exec git add magusfile.buzz
exec git commit -m touch-root

# hotspots: churn x complexity, one row per project (a single-project fixture here, so
# one data row). Counts and dates churn with the fixture, so only the shape is
# asserted: header columns, and a data row for the root project ("." is the path, not
# a directory name, so it stays stable no matter what testscript names the work dir).
exec magus insight hotspots
stdout 'project hotspots \(last 500 commits\)'
stdout 'COMMITS\s+AUTH\s+LAST\s+BR\s+PROJECT'
stdout '(?m)^\s*\d+\s+\d+\s+\S+\s+\d+\s+\.$'

# affinity: projects that change together. One project can never co-occur with
# itself, so the pairs table is legitimately empty - still a pass, still has its
# header.
exec magus insight affinity
stdout 'affinity pairs \(last 500 commits\)'
stdout 'COUNT\s+HIDDEN\s+PROJECTS'

# ownership: author concentration and bus factor. A single-author fixture always
# lands at 100% share and bus-factor-one "yes" - that is a structural property of
# the fixture, not a churny count, so it is safe to assert.
exec magus insight ownership
stdout 'ownership \(last 500 commits\)'
stdout 'SHARE\s+AUTH\s+BF1\s+STALE\s+PRIMARY\s+PROJECT'
stdout '(?m)^\s*100%\s+\d+\s+yes\s'

# trend: rising vs cooling activity. Delta/recent/earlier counts churn with the
# fixture, so only the header and that a data row exists for the root project are
# asserted.
exec magus insight trend
stdout 'trend \(last 500 commits\)'
stdout 'DELTA\s+RECENT\s+EARLIER\s+PROJECT'
stdout '(?m)^\s*[+-]?\d+\s+\d+\s+\d+\s+\.$'

# report: every lens plus graph stats as one Markdown doc, meant to be committed as
# INSIGHT.md. Assert the section structure, not the churny numbers inside it.
exec magus insight report
stdout '^# Insight'
stdout '^## Hotspots'
stdout '^## Affinity'
stdout '^## Ownership'
stdout '^## Trend'
stdout '^## Graph stats'

# Each lens accepts -o text|json|yaml|name; the model carries "path": "." the same
# way the text table does, so this stays stable too.
exec magus insight hotspots -o json
stdout '"definition":'
stdout '"path": "\."'

exec magus insight hotspots -o yaml
stdout '^definition:'
stdout '(?m)^\s*-?\s*path: \.$'

# An unknown lens name is a usage error, not a crash - and the error surfaces the
# full lens list so the fix is obvious without re-running -h.
! exec magus insight bogus
stderr 'unknown lens "bogus"'
stderr 'hotspots\s+churn x complexity'
stderr 'affinity\s+projects that change together'
stderr 'ownership\s+author concentration'
stderr 'trend\s+rising vs cooling activity'
stderr 'volatility\s+targets whose pass/fail record flaps'

-- magus.yaml --
concurrency: 2
-- .gitignore --
.magus/
-- magusfile.buzz --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(); }
-- spells/acme/spell.buzz --
import "magus/target";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
-- spells/acme/spell.buzz.v2 --
import "magus/target";
export fun mgs_getName() > str { return "acme"; }
// touched for insight's hotspots/trend history
fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
-- magusfile.buzz.v2 --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
// touched for insight's hotspots/trend history
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(); }
