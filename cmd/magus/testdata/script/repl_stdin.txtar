# `magus buzz --workspace` is the interactive Buzz interpreter that DOES carry the magus.*
# namespace (unlike `magus buzz`, see buzz_run.txtar). It has no non-interactive
# form, so testscript's stdin+exec pairing is the only way to drive it here: feed
# REPL input lines as stdin and read the transcript back off stdout. With stdin
# not a terminal it still starts, banners, prompts, evaluates, and exits 0 at EOF
# rather than requiring a real tty - that is what makes it testable at all.

stdin repl_session.txt
exec magus buzz --workspace
stdout 'magus buzz --workspace \(\.help for commands\)'
stdout 'Type \.exit to quit, \.help for commands\.'

# a plain expression evaluates and the result comes back after a prompt
stdout '> 2'

# a dot-command lists the others
stdout '\.exit / \.quit\s+exit the REPL'
stdout '\.help\s+show this message'

-- repl_session.txt --
1 + 1
.help
.exit
