# magus tail refuses to run without an interactive terminal (isInteractiveTTY,
# cmd/magus/x.go - shared with `magus x`). It advertises an override two ways:
# MAGUS_ASSUME_INTERACTIVE=1, or assume_interactive: true in magus.yaml. An
# advertised escape hatch that does not actually work is worse than no escape
# hatch at all, so this exercises BOTH override paths, not just the refusal.

# No TTY, no override: refused with the documented remedy, exit 2.
! exec magus tail
stderr 'magus: tail requires an interactive terminal; pipe the output instead'
stderr '\(set assume_interactive: true in magus\.yaml or MAGUS_ASSUME_INTERACTIVE=1 to override\)'

exec magus tail -h
stderr 'Usage: magus tail \[-f\] \[-n N\] \[target\]'
stderr 'Requires an interactive terminal'

# The root project is excluded from cwd resolution (it is the workspace, not
# a project), so tail from the root with nothing else to resolve reports that
# plainly rather than a confusing cache miss.
env MAGUS_ASSUME_INTERACTIVE=1
! exec magus tail
stderr 'magus tail: not inside a project directory'
env MAGUS_ASSUME_INTERACTIVE=

cd api

# --- override path 1: MAGUS_ASSUME_INTERACTIVE=1 ---
# The env var only lifts the TTY gate; it does not conjure a cached log. With
# none for this project yet, the command proceeds past the gate and fails on
# its OWN terms - proof the gate, and only the gate, was bypassed.
env MAGUS_ASSUME_INTERACTIVE=1
! exec magus tail
stderr 'magus tail: no cache entries found for project "api" - run a build first'
env MAGUS_ASSUME_INTERACTIVE=

# Without the override restored, the gate is back.
! exec magus tail
stderr 'magus: tail requires an interactive terminal; pipe the output instead'

# --- override path 2: assume_interactive: true in magus.yaml ---
# Same missing-cache failure with no env var at all - the yaml key alone lifts
# the gate just as MAGUS_ASSUME_INTERACTIVE=1 did above.
cp ../magus.yaml.assume ../magus.yaml
! exec magus tail
stderr 'magus tail: no cache entries found for project "api" - run a build first'

# With a real cached log in place, tail streams it - the override's only
# effect is lifting the gate; nothing downstream in the tail path is touched.
exec magus run lint
exec magus tail
stdout 'acme-tail-marker'

-- magus.yaml --
concurrency: 2
-- magus.yaml.assume --
concurrency: 2
assume_interactive: true
-- magusfile.buzz --
import "magus";
magus.project({});
-- api/magusfile.buzz --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(); }
-- spells/acme/spell.buzz --
import "magus/target";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "echo", args = ["acme-tail-marker"]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
