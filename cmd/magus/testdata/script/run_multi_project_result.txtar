# The structured result across a FAN-OUT, which is the case a single-project fixture
# cannot catch.
#
# buildStep's Outputs are WORKSPACE-relative ("api/dist/*.txt"), unlike
# Project.AllOutputs which is project-relative. Globbing them against the project dir
# looked for api/api/dist/*.txt and found nothing. The ROOT project hid it, because at
# the root the two spellings are identical, so every single-project test passed while
# every sub-project silently reported no artifacts.

# Each project carries its OWN value and its OWN artifacts. A flat list could not say
# which project produced which file.
exec magus run bundle:rw -o json
stdout '"path": "\."'
stdout '"value": "root-v1"'
stdout '"path": "dist/root\.txt"'
stdout '"path": "api"'
stdout '"value": "api-v1"'
stdout '"path": "api/dist/api\.txt"'
stdout '"count": 2'

# A script reading the run's records sees both projects' artifacts, workspace-relative
# so they stay unique, and each project's value with the project beside it.
[windows] skip 'no kernel API proves the peers of an anonymous pipe'
exec bash -c 'set -o pipefail; magus run bundle:rw | magus buzz results.buzz'
stdout '^artifact \. dist/root\.txt$'
stdout '^artifact api api/dist/api\.txt$'
stdout '^value \. root-v1$'
stdout '^value api api-v1$'

-- results.buzz --
import "std";
import "pipe";

fun main(args: [str]) > void !> any {
    foreach (rec in pipe\all()) {
        if (rec.@"type" == "run.target.result") {
            foreach (a in pipe\outputs(rec)) {
                std\print("artifact {a.project} {a.path}");
            }
        }
        if (rec.@"type" == "run.target.value") {
            std\print("value {rec.project} {pipe\value(rec)}");
        }
    }
}
-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "proc";
import "spells/acme";
import "project/api";
magus.project({ "spells": [acme] });
export fun bundle(ctx: magus\Context, args: [str]) > str !> any {
    ctx.writesFiles("dist/*.txt");
    proc\exec("sh", ["-c", "mkdir -p dist && echo root > dist/root.txt"]);
    return "root-v1";
}
-- api/magusfile.buzz --
import "magus";
import "proc";
import "spells/acme";
magus.project({ "spells": [acme] });
export fun bundle(ctx: magus\Context, args: [str]) > str !> any {
    ctx.writesFiles("dist/*.txt");
    proc\exec("sh", ["-c", "mkdir -p dist && echo api > dist/api.txt"]);
    return "api-v1";
}
-- spells/acme/spell.buzz --
import "magus/spell";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command { return Command{bin = "acme", args = ["lint", "."]}; }
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
