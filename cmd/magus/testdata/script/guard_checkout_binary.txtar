# A job checkout whose magusfile reaches for a binding this magus does not ship is judged
# by the checkout's own ./magus, and the verdict names the binary that judged. A placed
# ./magus behind HEAD is asked too: its own stale-binary rules name the bootstrap. The job
# checkout is a linked worktree of the session's repository: no other root is trusted.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
env XDG_CACHE_HOME=$WORK/home/cache
cd session
exec git init -q -b main
exec git config user.email test@example.com
exec git config user.name Test
exec git add magus.yaml magusfile.buzz
exec git commit -q -m session
exec git checkout -q -b job
cp $WORK/jobsrc/magusfile.buzz magusfile.buzz
cp $WORK/jobsrc/go.mod go.mod
exec git add magusfile.buzz go.mod
exec git commit -q -m base
exec git commit -q --allow-empty -m 'extend the bindings'
exec git checkout -q main
exec git worktree add -q $WORK/job job
cp $WORK/jobsrc/magus $WORK/job/magus
chmod 755 $WORK/job/magus
# The glue starts the session checkout's own build, which is what anchors the session.
exec sh -c 'cp "$(command -v magus)" magus'
exec sh -c 'printf "{\"session_id\":\"checkout-binary\",\"hook_event_name\":\"PreToolUse\",\"cwd\":\"%s\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"magus --root %s/job run go-test .\"}}\n" "$PWD" "$WORK" > call.json'

stdin call.json
exec $WORK/session/magus shell --agent-name claude-code --transport buzz
! stdout '^judged by '

# A live row that stands at the job checkout pins its ./magus, and the hand-off follows.
exec magus job fork pinned --instructions 'judge by the checkout binary' --write-paths magusfile.buzz --check 'lint .' --checkout $WORK/job
exec magus job pin pinned
stdout '^pinned .*/job/magus for pinned: sha256:'

stdin call.json
exec $WORK/session/magus shell --agent-name claude-code --transport buzz
stdout '^judged by .*/job/magus for .*session/magus'

env STUB_BUILT_AT=HEAD~1
stdin call.json
exec $WORK/session/magus shell --agent-name claude-code --transport buzz
stdout '^judged by .*/job/magus for .*magus'

-- session/magus.yaml --
{}
-- session/magusfile.buzz --
import "magus";

magus\project({
    "sources": ["*.buzz"],
    "no_language": "fixture workspace: only the session side of a delegated judgment matters here",
    "targets": {"lint": {"timeout": "5m"}},
});
-- jobsrc/go.mod --
module github.com/egladman/magus

go 1.25
-- jobsrc/magusfile.buzz --
import "magus";

magus\project({
    "sources": ["*.buzz"],
    "no_language": "fixture workspace: a tree that extends the bindings past this magus",
});
magus\guard.command(fun (req: CommandRequest) > GuardVerdict {
    return magus\guard.verdictFromTheFuture();
});
-- jobsrc/magus --
#!/bin/sh
here=$(cd "$(dirname "$0")" && pwd)
if [ "$1" = version ]; then
    git -C "$here" rev-parse "${STUB_BUILT_AT:-HEAD}"
    exit 0
fi
cat >/dev/null
echo "judged by $here/magus for $__MAGUS_DELEGATED_BY"
