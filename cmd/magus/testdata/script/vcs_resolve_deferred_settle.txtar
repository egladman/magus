# A cherry-pick of several commits settles once, at its last pick, over everything the
# sequence changed; under magus.settle=defer the hooks start no magus at all, and
# `magus vcs resolve` regenerates what every deferred batch changed in one run. A settle
# another magus's lock holds back waits for it rather than failing. The generator reads
# IN.txt and IN2.txt into OUT.txt.

exec git init
exec git config user.email test@example.com
exec git config user.name Test
exec git config commit.gpgsign false
exec git checkout -b main
exec git add magus.yaml magusfile.buzz .gitignore .gitattributes IN.txt IN2.txt OUT.txt
exec git commit -m initial
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/xdg
env XDG_STATE_HOME=$WORK/home/state
exec magus init -vcs git
exists .git/hooks/post-commit

# Three commits: two generator inputs, then one that touches none.
exec git checkout -b side
cp IN.a.txt IN.txt
exec git commit -am 'input a'
cp IN2.b.txt IN2.txt
exec git commit -am 'input b'
cp NOTES.txt NOTES
exec git add NOTES
exec git commit -m notes

# --- one settle for the whole sequence -----------------------------------------
# The last pick changes no input; the settle still regenerates what the first two did.
exec git checkout -b sequence main
exec git cherry-pick side~3..side
stderr 'magus: this cherry-pick changed generator inputs; ran magus run generate:rw \.; staged 1 regenerated file\(s\)'
cmp OUT.txt OUT.ab.txt
exec git commit --amend --no-edit
exec git status --porcelain --untracked-files=no
! stdout .

# --- deferred across two batches -----------------------------------------------
exec git checkout -b deferred main
exec git -c magus.settle=defer cherry-pick side~2
stderr 'magus.settle is defer, so this operation was not regenerated'
! stderr 'changed generator inputs'
exec git -c magus.settle=defer cherry-pick side~2..side
exists .git/magus-settle-deferred
cmp OUT.txt OUT.base.txt
exec git status --porcelain --untracked-files=no
! stdout .
exec magus vcs resolve
stdout 'vcs resolve: ran magus run generate:rw \.; staged 1 regenerated file\(s\)'
! exists .git/magus-settle-deferred
exec git diff --cached --name-only
stdout '^OUT\.txt$'
exec git commit --amend --no-edit
exec git show HEAD:OUT.txt
stdout '^generated: a\+b$'
exec magus vcs resolve
stdout 'nothing to resolve'

# --- a settle waits for another magus's lock -----------------------------------
exec git checkout -b waited main
exec magus run holdslow . &
exec bash -c 'for i in $(seq 200); do [ -f ready ] && exit 0; sleep 0.05; done; exit 1'
exec bash -c 'git cherry-pick side~3..side >pick.out 2>&1' &
exec bash -c 'for i in $(seq 1200); do grep -q "waiting up to" pick.out 2>/dev/null && exit 0; sleep 0.05; done; exit 1'
exec touch release
wait
exec cat pick.out
stdout 'locked by another magus process \(held by pid [0-9]+ .*run holdslow.*; waiting up to 2m0s for it'
stdout 'magus: this cherry-pick changed generator inputs; ran magus run generate:rw \.; staged 1 regenerated file\(s\)'
cmp OUT.txt OUT.ab.txt

-- magus.yaml --
default_charms: [rw]
-- .gitignore --
.magus/
ready
release
pick.out
-- .gitattributes --
# BEGIN magus-generated - do not edit this section manually
*.go diff=golang
*.py diff=python
*.rs diff=rust
*.md diff=markdown
*.ts diff=typescript
*.tsx diff=typescript
*.buzz diff=buzz
/OUT.txt merge=magus linguist-generated
# END magus-generated
-- magusfile.buzz --
import "magus";
import "fs";
import "proc";
magus\project({
    "name": "acme-root",
    "sources": ["IN.txt", "IN2.txt"],
    "targets": {
        "generate": {"skip_cache": "writes on every run; a replay would skip the write"},
        "holdslow": {"skip_cache": "holds the project"},
    },
});
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("OUT.txt");
    fs\writeFile("OUT.txt", "generated: " + fs\readLines("IN.txt")[0] + "+" + fs\readLines("IN2.txt")[0] + "\n");
}
// holdslow holds the project until a release file appears, bounded so a stuck script
// cannot hang CI. The cherry-pick it holds back rewrites IN.txt and IN2.txt mid-run;
// declaring them keeps that from reading as holdslow editing its own sources.
export fun holdslow(ctx: magus\Context, args: [str]) > void !> any {
    ctx.modifiesExistingFiles("IN.txt", "IN2.txt");
    proc\exec("sh", ["-c", "touch ready; for i in $(seq 1200); do [ -f release ] && exit 0; sleep 0.05; done"]);
}
-- IN.txt --
base
-- IN2.txt --
base2
-- OUT.txt --
generated: base+base2
-- OUT.base.txt --
generated: base+base2
-- OUT.ab.txt --
generated: a+b
-- IN.a.txt --
a
-- IN2.b.txt --
b
-- NOTES.txt --
not a generator input
