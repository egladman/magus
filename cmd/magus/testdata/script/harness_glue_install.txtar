# A workspace outside magus holds no docs/guides/integrations/agents, so the glue its hook
# lines run is the copy `magus agent harness install` writes into .magus/harness/hooks,
# stamped with its version and digest. buzzed's hooks named the docs path for days and
# every call there failed. Verify and doctor name a missing, edited or outdated copy, each
# with the one remedy, and the remedy fixes it.

[windows] skip 'the wiring is POSIX sh'

mkdir spells/harness/claude-code
cp $__MAGUS_TEMPLATES/../../../../spells/harness/claude-code/spell.buzz spells/harness/claude-code/spell.buzz
env CLAUDE_PROJECT_DIR=$WORK

# Install copies every script a hook runs, and the module they import, stamped.
exec magus agent harness install --id claude-code
stdout 'installed claude-code: \.magus/harness/hooks/magus-command\.buzz'
exists .magus/harness/hooks/lib/hook.buzz
grep '^// generated by: magus agent harness install; glue-version: magus\.guard-template/v1alpha1; glue-content: [0-9a-f]{12}; do not edit, re-run to update$' .magus/harness/hooks/magus-command.buzz
! exists docs
exec magus agent harness verify --id claude-code
stdout '^verified claude-code harness'

# The PreToolUse line the settings hold runs the copy, and answers 0 or 2, never 1.
exec magus describe harness claude-code -o 'template={{range .wired}}{{if eq .key "hooks.PreToolUse"}}{{(index (index .entries 0).hooks 0).command}}{{end}}{{end}}'
cp stdout $WORK/pre.sh
grep ' -s \.magus/harness/hooks/magus-command\.buzz -- --agent-name claude-code$' $WORK/pre.sh
stdin touch.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit [02]$'
! stderr 'could not judge'

# A deleted copy fails verify and doctor, naming the remedy.
rm .magus/harness/hooks/magus-command.buzz
! exec magus agent harness verify --id claude-code
stdout 'hook glue \.magus/harness/hooks/magus-command\.buzz is missing'
stdout 'run `magus agent harness install`'
! exec magus doctor
stdout 'guard-wiring: harness wiring is incomplete'
stdout 'magus-command\.buzz is missing.*run `magus agent harness install`'

# The remedy writes it back.
exec magus agent harness install --id claude-code
stdout 'installed claude-code: \.magus/harness/hooks/magus-command\.buzz'
exec magus agent harness verify --id claude-code
stdout '^verified claude-code harness'

# An edited copy is drift, and install overwrites it: the stamp says not to edit it.
exec sh -c 'echo "// mine" >> .magus/harness/hooks/magus-observe.buzz'
! exec magus agent harness verify --id claude-code
stdout 'hook glue \.magus/harness/hooks/magus-observe\.buzz was edited after install'
exec magus agent harness install --id claude-code
exec magus agent harness verify --id claude-code
stdout '^verified claude-code harness'

# A copy another magus stamped with an older glue version names both versions.
cp old.buzz .magus/harness/hooks/magus-duration.buzz
! exec magus agent harness verify --id claude-code
stdout 'hook glue \.magus/harness/hooks/magus-duration\.buzz is glue version 1, and this magus ships version magus\.guard-template/v1alpha1; run `magus agent harness install`'
exec magus agent harness install --id claude-code
exec magus agent harness verify --id claude-code

# A workspace that holds the glue's sources links a copy to them, as a checkout of magus
# does: the linker replaces the stamped copy, and install leaves the link.
mkdir src/lib
cp $__MAGUS_TEMPLATES/magus-observe.buzz src/magus-observe.buzz
cp $__MAGUS_TEMPLATES/lib/hook.buzz src/lib/hook.buzz
stdin links.json
exec magus agent harness link --stdin -o json
stdout '"\.magus/harness/hooks/magus-observe\.buzz"'
exec magus agent harness install --id claude-code
! stdout 'magus-observe\.buzz'
exec magus agent harness verify --id claude-code
stdout '^verified claude-code harness'
rm src/magus-observe.buzz
! exec magus agent harness verify --id claude-code
stdout 'hook glue \.magus/harness/hooks/magus-observe\.buzz links to a file that does not exist'

-- magus.yaml --
{}
-- magusfile.buzz --
import "magus";
import "spells/harness/claude-code" as claude;
magus\harness.provider(claude);
-- touch.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"touch x"}}
-- links.json --
{"links":{".magus/harness/hooks/magus-observe.buzz":"src/magus-observe.buzz"}}
-- old.buzz --
import "std";

fun main(args: [str]) > void { }
// generated by: magus agent harness install; glue-version: 1; glue-content: 1d69a75712c7; do not edit, re-run to update
