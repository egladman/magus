# A settle that regenerates during a cherry-pick ends with no pick in progress: no
# CHERRY_PICK_HEAD and no sequencer state, whether the pick was clean or concluded by
# hand after a conflict. The generator reads IN.txt and IN2.txt into OUT.txt.

exec git init
exec git config user.email test@example.com
exec git config user.name Test
exec git config commit.gpgsign false
exec git checkout -b main
exec git add magus.yaml magusfile.buzz .gitignore .gitattributes IN.txt IN2.txt OUT.txt
exec git commit -m initial
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/xdg
env XDG_STATE_HOME=$WORK/home/state
exec magus init -vcs git
exists .git/hooks/post-commit

exec git checkout -b side
cp IN.a.txt IN.txt
exec git commit -am 'input a'
cp IN2.b.txt IN2.txt
exec git commit -am 'input b'

# --- a clean single pick ---------------------------------------------------------
exec git checkout -b single main
exec git cherry-pick side~1
stderr 'staged 1 regenerated file\(s\)'
! exists .git/CHERRY_PICK_HEAD
! exists .git/sequencer
exec git status
! stdout 'cherry-pick'

# --- a clean sequence ------------------------------------------------------------
exec git checkout -f -b sequence main
exec git cherry-pick side~2..side
stderr 'staged 1 regenerated file\(s\)'
! exists .git/CHERRY_PICK_HEAD
! exists .git/sequencer
exec git status
! stdout 'cherry-pick'

# --- a conflicted last pick, concluded with --continue ---------------------------
exec git checkout -f -b conflicted main
cp IN2.c.txt IN2.txt
exec git commit -am 'input c'
! exec git cherry-pick side~2..side
exists .git/CHERRY_PICK_HEAD
cp IN2.b.txt IN2.txt
exec git add IN2.txt
env GIT_EDITOR=true
exec git cherry-pick --continue
stderr 'nothing was regenerated; once the cherry-pick finishes, run `magus vcs resolve && git commit --amend --no-edit`'
! stderr 'local changes would be overwritten'
! exists .git/CHERRY_PICK_HEAD
! exists .git/sequencer
exec git status
! stdout 'cherry-pick'
exists .git/magus-settle-deferred
exec magus vcs resolve
stdout 'staged 1 regenerated file\(s\)'
exec git commit --amend --no-edit
exec git show HEAD:OUT.txt
stdout '^generated: a\+b$'
! exists .git/magus-settle-deferred

# --- a conflicted single pick, concluded with git commit -------------------------
exec git checkout -f -b by-commit main
cp IN2.c.txt IN2.txt
exec git commit -am 'input c'
! exec git cherry-pick side
exists .git/CHERRY_PICK_HEAD
cp IN2.b.txt IN2.txt
exec git add IN2.txt
exec git commit --no-edit
! exists .git/CHERRY_PICK_HEAD
exec git status
! stdout 'cherry-pick'
exec git show HEAD:OUT.txt
stdout '^generated: base\+b$'

-- magus.yaml --
default_charms: [rw]
-- .gitignore --
.magus/
-- .gitattributes --
# BEGIN magus-generated - do not edit this section manually
*.go diff=golang
*.py diff=python
*.rs diff=rust
*.md diff=markdown
*.ts diff=typescript
*.tsx diff=typescript
*.buzz diff=buzz
*.yaml diff=yaml
*.yml diff=yaml
/OUT.txt merge=magus linguist-generated
# END magus-generated
-- magusfile.buzz --
import "magus";
import "fs";
magus\project({
    "name": "acme-root",
    "sources": ["IN.txt", "IN2.txt"],
    "targets": {
        "generate": {"skip_cache": "writes on every run; a replay would skip the write"},
    },
});
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("OUT.txt");
    fs\writeFile("OUT.txt", "generated: " + fs\readLines("IN.txt")[0] + "+" + fs\readLines("IN2.txt")[0] + "\n");
}
-- IN.txt --
base
-- IN2.txt --
base2
-- OUT.txt --
generated: base+base2
-- IN.a.txt --
a
-- IN2.b.txt --
b
-- IN2.c.txt --
c
