# A job may claim a whole directory when every file under it is a declared output: a
# generated tree overlaps no job that edits by hand, so MGS3018 stands down, and the claim
# holds the output glob under it, so MGS3044 has nothing to report. One file that is not an
# output keeps the refusal and the message names it. A bare ** stays refused.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
env GIT_AUTHOR_NAME=Ana
env GIT_AUTHOR_EMAIL=ana@example.com
env GIT_COMMITTER_NAME=Ana
env GIT_COMMITTER_EMAIL=ana@example.com
exec git init -q -b main
exec git add -A
exec git commit -q -m 'a generator and its output'

exec magus job fork pages/gen --write-paths 'src/in.txt,gen' --check 'test .'
stdout '^forked pages/gen, declared, with 2 write path\(s\)\.'
! stderr 'MGS3018'
! stderr 'MGS3044'

! exec magus job fork pages/mixed --write-paths 'src/in.txt,hand' --check 'test .'
! stdout .
stderr 'MGS3018'
stderr 'hand/notes\.txt is not a declared output'

! exec magus job fork pages/src --write-paths 'src' --check 'test .'
! stdout .
stderr 'MGS3018'
stderr 'src/in\.txt is not a declared output'

! exec magus job fork pages/root --write-paths '**' --check 'test .'
! stdout .
stderr 'MGS3018'

-- .gitignore --
.magus/
-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "proc";

// generate writes the pages from the input.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("src/*.txt");
    ctx.writesFiles("gen/**", "hand/*.out");
    proc\exec("sh", ["-c", "mkdir -p gen && cat src/*.txt > gen/page.out"]);
}

// test reads the input.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("src/*.txt");
    proc\exec("sh", ["-c", "true"]);
}
-- src/in.txt --
input
-- gen/page.out --
input
-- gen/more/other.out --
input
-- hand/page.out --
input
-- hand/notes.txt --
by hand
