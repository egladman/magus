# TRANSPORT PARITY: the shipped guard templates, executed against real host events.
#
# The sibling gate in dogfood_test.go checks that every host DECLARES a stance for
# every decision and surface. A declaration can be sincere and still wrong, because
# nothing there runs the file: the OpenCode plugin declared a correct stance for
# months while invoking a subcommand that no longer existed, so it never received a
# verdict to have a stance about, and every session it guarded ran unguarded.
#
# These cases close that hole for the POSIX sh templates. They run the real files
# (GUARD_TEMPLATES is an absolute path to docs/guides/integrations/agents, never a
# copy) against the event shapes their hosts actually send, and assert the response
# a host would receive. `magus` here is the CLI under test, resolved off PATH the
# same way the templates resolve it in a session.
#
# Every case is labeled `# case: <surface>/<decision>`; TestTransportCorpusCoversTheContract
# in dogfood_test.go fails when the guard contract grows a cell no case covers.

# jq comes from the machine, not from mise, and that is deliberate: jq is a runtime
# dependency of the TEMPLATES a user installs into their host, not of building magus,
# so pinning it in this repo's toolchain would assert something false. CI runs on
# ubuntu-latest, which ships jq, so these cases execute there. Do not "fix" this skip
# by adding jq to mise.toml - mise.toml is a root-level source, and touching it puts
# every project in the workspace into the affected set.
[!exec:jq] skip 'the guard templates pipe events through jq, which is not installed'
[windows] skip 'POSIX sh templates; Windows hosts wire the same verdict differently'

env GUARD_AGENT_NAME=testscript

# --- magus-guard-command.sh: the Claude Code and Codex shape ------------------

# case: command/deny
stdin deny-command.json
exec sh $GUARD_TEMPLATES/magus-guard-command.sh
stdout '"permissionDecision":"deny"'
stdout '"permissionDecisionReason":"Verify in place'
stdout 'whole-tree git stash'

# case: command/advise
stdin advise-command.json
exec sh $GUARD_TEMPLATES/magus-guard-command.sh
stdout '"additionalContext":"'
! stdout 'permissionDecision'

# case: command/pass
# An allowed call must produce NOTHING. A host reads an empty response as allow, so
# a template that emitted an envelope here would turn every benign command into a
# decision the host has to interpret.
stdin pass-command.json
exec sh $GUARD_TEMPLATES/magus-guard-command.sh
! stdout .

# --- magus-guard-path.sh: the same hosts, their file-writing tool -------------

# case: path/advise
stdin advise-path.json
exec sh $GUARD_TEMPLATES/magus-guard-path.sh
stdout '"additionalContext":"'
stdout 'magus memory put'

# case: path/pass
stdin pass-path.json
exec sh $GUARD_TEMPLATES/magus-guard-path.sh
! stdout .

# case: path/deny
# The notes store is the one rule that denies on this surface, and it fires only where a
# workspace DECLARES one - so this runs in a subdirectory that does, leaving every other
# case judged against a tree with no notes store at all.
#
# This case is why the deny arm exists. Before it, HOST_RESPONSE rendered only `advise`,
# so a deny produced EMPTY stdout while magus exited 2, and the tail below read
# empty-plus-nonzero as a broken guard and exited 0 - which every host takes as allow. The
# rule looked enforced and blocked nothing.
cd notes-ws
stdin $WORK/deny-path.json
exec sh $GUARD_TEMPLATES/magus-guard-path.sh
stdout '"permissionDecision":"deny"'
stdout 'NOTES store'
stdout 'magus memory put'
cd $WORK

# --- cursor-guard.sh: one file, both events, a different response dialect -----

# case: command/deny
stdin cursor-shell-deny.json
exec sh $GUARD_TEMPLATES/cursor-guard.sh
stdout '"permission":"deny"'
stdout '"agent_message":"Verify in place'
stdout 'whole-tree git stash'

# case: command/pass
# Cursor is the one host that must answer on an allow rather than stay silent.
stdin cursor-shell-pass.json
exec sh $GUARD_TEMPLATES/cursor-guard.sh
stdout '"permission":"allow"'

# case: command/advise
# Cursor declares advise=none: it sends nothing on an allow, so an advise is
# indistinguishable from a pass here. Pinning that keeps the declaration honest -
# if this ever carries the advisory text, the declaration is what is now wrong.
stdin cursor-shell-advise.json
exec sh $GUARD_TEMPLATES/cursor-guard.sh
stdout '"permission":"allow"'
! stdout 'magus memory put'

# case: path/advise
# Declared advise=human: the prose goes to stderr for the person, and stdout stays
# empty because Cursor would not read a verdict on this event.
stdin cursor-file.json
exec sh $GUARD_TEMPLATES/cursor-guard.sh
! stdout .
stderr 'DECLARED OUTPUT|magus:'

# --- magus-guard-observe.sh: the verdict-free one ------------------------------
#
# It declares no guard coverage, so the contract gate above owes it no case and
# would never have asked for one. That exemption is exactly how an untested shell
# artifact ships: the OpenCode plugin in the header note declared a correct stance
# and was still broken, because nothing ran it. These cases run it.
#
# There is no `# case: <surface>/<decision>` label on purpose. An observation is
# not a verdict on a surface, and labeling it would make TestTransportCorpusCovers-
# TheContract count a cell the guard contract does not have.

# It records a read and says NOTHING to the host. A read is not a decision, so any
# stdout here would be a response the host has to interpret on every file it opens.
stdin observe-read.json
exec sh $GUARD_TEMPLATES/magus-guard-observe.sh
! stdout .
! stderr .

# A payload it cannot parse is dropped silently. Under `set -e` this exited non-zero
# with jq's parse error on stderr, on EVERY read - and some hosts read a non-zero
# pre-tool hook as "block this call", which would stop the agent reading anything.
stdin observe-garbage.json
exec sh $GUARD_TEMPLATES/magus-guard-observe.sh
! stdout .
! stderr .

# A search event names no read path, so there is nothing to record and nothing to
# say. Recording the event whole here would put the query text in the trail.
stdin observe-search.json
exec sh $GUARD_TEMPLATES/magus-guard-observe.sh
! stdout .
! stderr .

# --- fail-open: a missing magus must degrade the way each template promises ---

env GUARD_MAGUS_BIN=$WORK/nonexistent-magus

# The observer stays silent and exits 0 when magus is absent. Unlike a guard, it
# enforces nothing, so an announcement per read would report only that an optional
# record was skipped.
stdin observe-read.json
exec sh $GUARD_TEMPLATES/magus-guard-observe.sh
! stdout .
! stderr .

# The command template announces itself. An unguarded session you know about beats
# one you do not.
stdin deny-command.json
exec sh $GUARD_TEMPLATES/magus-guard-command.sh
stdout 'magus guard is NOT running'

# The path template stays silent by default: for most hosts an empty response means
# allow. That is the deliberate trade - this surface can now DENY, so failing open here
# means an unavailable guard lets a notes write through, and announcing it on every file
# edit was judged the worse noise. GUARD_FAILED_RESPONSE is the opt-in for a host that
# would rather hear about it.
stdin advise-path.json
exec sh $GUARD_TEMPLATES/magus-guard-path.sh
! stdout .

# Cursor allows explicitly, because Cursor fails open on a hook crash anyway and
# pretending otherwise would give false assurance.
stdin cursor-shell-deny.json
exec sh $GUARD_TEMPLATES/cursor-guard.sh
stdout '"permission":"allow"'

-- deny-command.json --
{"session_id": "s1", "tool_name": "Bash", "tool_input": {"command": "git stash"}}
-- advise-command.json --
{"session_id": "s1", "tool_name": "Bash", "tool_input": {"command": "git push"}}
-- pass-command.json --
{"session_id": "s1", "tool_name": "Bash", "tool_input": {"command": "ls -la"}}
-- advise-path.json --
{"session_id": "s1", "tool_name": "Write", "tool_input": {"file_path": "AGENTS.md"}}
-- pass-path.json --
{"session_id": "s1", "tool_name": "Write", "tool_input": {"file_path": "README.md"}}
-- deny-path.json --
{"session_id": "s1", "tool_name": "Write", "tool_input": {"file_path": "notes/team-conventions.md"}}
-- notes-ws/magus.yaml --
knowledge:
  notes:
    shared: notes
-- notes-ws/magusfile.buzz --
import "magus";

magus\project({
    "sources": ["*.md", "notes/**/*.md"],
    "no_language": "fixture workspace: only the guard's view of a declared notes store matters here",
});
-- notes-ws/notes/team-conventions.md --
---
magus:
    id: team-conventions
    title: How this team works
    anchors:
        - kind: project
          target: .
---

Prose a person wrote.
-- observe-read.json --
{"session_id": "s1", "transcript_path": "/tmp/t.jsonl", "tool_name": "Read", "tool_input": {"file_path": "README.md"}}
-- observe-garbage.json --
not json at all
-- observe-search.json --
{"session_id": "s1", "tool_name": "Grep", "tool_input": {"pattern": "AWS_SECRET_ACCESS_KEY", "path": "internal/"}}
-- cursor-shell-deny.json --
{"command": "git stash", "cwd": ".", "sandbox": false}
-- cursor-shell-pass.json --
{"command": "ls -la", "cwd": ".", "sandbox": false}
-- cursor-shell-advise.json --
{"command": "git push", "cwd": ".", "sandbox": false}
-- cursor-file.json --
{"file_path": "AGENTS.md", "edits": []}
