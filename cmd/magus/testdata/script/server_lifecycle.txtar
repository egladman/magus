# `magus server` manages the server; `magus server broker` reports on the broker. These
# paths must all work with nothing running - management itself has to detect and
# report that absence correctly, since it is the thing users reach for when
# something seems stuck.
#
# MAGUS_SERVER_ENABLED=false and MAGUS_BROKER=off (set by the test harness) govern
# whether an ordinary command USES the server or the broker; they do not change what
# `magus server` or `magus server broker status` do. Every assertion below holds either way.
#
# We deliberately never run `magus server start` or `magus server broker`: each would spawn a
# real background process on a real socket shared machine-wide, which would step on
# the actual developer environment and any other agent running concurrently. Only
# argument validation and nothing-running paths are covered here.

# All of magus server's usage/error text goes to stderr, not stdout.

# Bare `magus server` is a usage error (exit 2): a target is required. An explicit
# -h, asserted further down, is the way to ask "what can I do here" and exits 0.
! exec magus server
stderr 'target required'
stderr 'usage: magus server <start\|stop\|status\|reload\|broker> \[flags\]'
stderr 'start   Start the server'
stderr 'stop    Send a graceful shutdown request to the running server \(needs it running\)'
stderr 'reload  Re-read configuration without restarting'
stderr 'status  Whether the server and broker are up'
stderr 'broker  The per-user process holding this host''s capacity'

exec magus server -h
stderr 'usage: magus server <start\|stop\|status\|reload\|broker> \[flags\]'

# `status` with no server running reports it as a row and still prints the
# rest, the way systemctl status reports a stopped unit. It starts nothing.
exec magus server status
stdout 'server +- +not running'
stdout 'broker +- +not running'
! exec magus server status --probe=liveness

# Neither top-level verb survives the move under `server`.
! exec magus status
stderr 'unknown subcommand "status"'
! exec magus broker status
stderr 'unknown subcommand "broker"'

# `server stop` with no server running must fail loudly rather than silently
# succeed - a silent success would hide that the developer's mental model of "a
# server is up" is wrong.
! exec magus server stop
stderr 'no server is running'

exec magus server stop -h
stderr 'usage: magus server stop \[flags\]'
stderr 'Send a graceful shutdown request to the running server'
stderr 'magus server broker stop --services'

exec magus server start -h
stderr 'usage: magus server start \[--foreground\] \[flags\]'
stderr 'auto-backgrounds'
stderr '\-foreground'

# The broker's status chains the same way: non-zero with none running, naming the
# policy in force.
! exec magus server broker status
stderr 'no broker is running \(broker: off\)'

! exec magus server broker stop
stderr 'no broker is running'

! exec magus server broker stop --services
stderr 'no broker is running'

exec magus server broker -h
stderr 'usage: magus server broker \[status\|stop\|units\] \[flags\]'
stderr 'unix socket only'

! exec magus server broker bogus
stderr 'unknown target "bogus"'

# `server reload` re-reads config without restarting the server. With no server running
# there is nothing holding an old config - every one-shot command reads magus.yaml as it
# runs - so it says so and exits 0. Exiting non-zero here would make it unusable in a
# script that just wants to be sure nothing stale is cached.
exec magus server reload
stderr 'no server is running'

exec magus server reload -h
stderr 'usage: magus server reload'
stderr 'without restarting the server'

# `job run` lists the server's own jobs when called bare - this doubles as its
# own help text, and as the listing the "no job named" error below points
# back to.
exec magus job run
stderr 'usage: magus job run <name>'
stderr 'sync-graph'
stderr 'rotate-logs'
stderr 'clear-cache'

! exec magus job run badname
stderr 'no job named "badname", run `magus job run` to list them'

# A real job name against no server is a documented no-op (so a VCS hook
# can call it unconditionally) rather than an error - it exits 0 with no
# output at all.
exec magus job run sync-graph
! stdout .
! stderr .
exec magus job run clear-cache
! stdout .
! stderr .

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "spells/acme";
magus\project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(ctx); }
-- spells/acme/spell.buzz --
import "magus/spell";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
