# `magus server` manages the persistent daemon. These paths must all work
# with no daemon actually running - server management itself has to detect
# and report that absence correctly, since it is the thing users reach for
# when something seems stuck.
#
# MAGUS_DAEMON_ENABLED=false (set by the test harness) governs whether a
# per-invocation magus command USES a daemon; it does not change what
# `magus server` itself does, since managing the daemon is orthogonal to
# whether other commands would talk to one. Every assertion below holds
# with the flag either way.
#
# We deliberately never run `magus server start` (no --foreground either):
# it would spawn a real background daemon on a real socket shared machine-
# wide, which would step on the actual developer environment and any other
# agent running concurrently. Only argument validation and no-daemon-running
# paths are covered here.

# All of magus server's usage/error text goes to stderr, not stdout.

# Bare `magus server` is a usage error (exit 2): a target is required. An explicit
# -h, asserted further down, is the way to ask "what can I do here" and exits 0.
! exec magus server
stderr 'target required'
stderr 'usage: magus server <start\|stop\|status\|reload> \[flags\]'
stderr 'start   start a persistent daemon'
stderr 'stop    send a graceful shutdown request'
stderr 'reload  re-read configuration without restarting'
stderr 'status  is the daemon up, and where do I reach it'
stderr '`magus status` is this workspace and this machine'

exec magus server -h
stderr 'usage: magus server <start\|stop\|status\|reload> \[flags\]'

# `status` IS a target, and with no daemon it fails loudly rather than printing
# an empty report: a script chaining on it and a person who meant `magus status`
# both need that said out loud. The pointer to the other verb is the second half
# of the contract, because the two are the pair people confuse.
! exec magus server status
stderr 'no daemon is running'
stderr 'still reports this workspace and this machine'

# `server stop` with no daemon running must fail loudly rather than
# silently succeed - a silent success would hide that the developer's
# mental model of "a daemon is up" is wrong.
! exec magus server stop
stderr 'no running daemon found'

# --services (stop just the hosted services, not the daemon) shares the
# same no-daemon-found path.
! exec magus server stop --services
stderr 'no running daemon found'

exec magus server stop -h
stderr 'usage: magus server stop \[flags\]'
stderr 'Send a graceful shutdown request to a running daemon'
stderr '\-services'

exec magus server start -h
stderr 'usage: magus server start \[--foreground\] \[flags\]'
stderr 'auto-backgrounds'
stderr '\-foreground'

# `job run` lists the daemon's own jobs when called bare - this doubles as its
# own help text, and as the listing the "no job named" error below points
# back to.
exec magus job run
stderr 'usage: magus job run <name>'
stderr 'sync-graph'
stderr 'rotate-logs'
stderr 'clear-cache'

! exec magus job run badname
stderr 'no job named "badname"; run `magus job run` to list them'

# A real job name against no daemon is a documented no-op (so a VCS hook
# can call it unconditionally) rather than an error - it exits 0 with no
# output at all.
exec magus job run sync-graph
! stdout .
! stderr .
exec magus job run clear-cache
! stdout .
! stderr .

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(ctx); }
-- spells/acme/spell.buzz --
import "magus/spell";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }

# `server reload` re-reads config without restarting the daemon. With no daemon running
# there is nothing holding an old config - every one-shot command reads magus.yaml as it
# runs - so it says so and exits 0. Exiting non-zero here would make it unusable in a
# script that just wants to be sure nothing stale is cached.
exec magus server reload
stderr 'no running daemon'

exec magus server reload -h
stderr 'usage: magus server reload'
stderr 'without restarting the daemon'
