# `magus job fork` refuses a write path naming an existing directory (MGS3018), project
# roots included, and writes no row: the workspace root and a sub-project root are refused
# like any other directory. A file and a path the job creates fork. Every job declares a
# paths goal, because a writing job without a check or a goal is refused before its paths
# are read.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
exec magus init -local -vcs git
mkdir src/pkg
cp $WORK/code.go src/pkg/code.go
mkdir console
cp $WORK/console.buzz console/magusfile.buzz

! exec magus job fork wave/dir --check 'test .' --write-paths src/pkg
stderr 'MGS3018'
stderr '"src/pkg", inside project "."'
stderr 'A write path names files'
stderr 'List the files the job will edit'
! exec magus job fork wave/glob --check 'test .' --write-paths 'src/**'
stderr '"src/\*\*" \(matching the directory "src"\)'

stdin $WORK/root.json
! exec magus job fork --stdin
stderr 'MGS3018'
stderr '"\.", the workspace root'
stderr 'A write path names files'
stdin $WORK/console.json
! exec magus job fork --stdin
stderr 'MGS3018'
stderr '"console", the root of project "console"'
exec magus ls jobs -o name
! stdout .

stdin $WORK/file.json
exec magus job fork --stdin
stdin $WORK/new.json
exec magus job fork --stdin
exec magus ls jobs -o name
stdout '^wave/file$'
stdout '^wave/new$'

-- code.go --
package pkg
-- console.buzz --
export fun build() > void {}
-- root.json --
{"schema_version": 11, "id": "wave/root", "write_paths": ["."],
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["src/pkg/code.go"]}]}
-- console.json --
{"schema_version": 11, "id": "wave/console", "write_paths": ["console"],
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["console/magusfile.buzz"]}]}
-- file.json --
{"schema_version": 11, "id": "wave/file", "write_paths": ["src/pkg/code.go"],
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["src/pkg/code.go"]}]}
-- new.json --
{"schema_version": 11, "id": "wave/new", "write_paths": ["src/fresh"],
 "goals": [{"id": "created", "kind": "paths", "expect": "present", "paths": ["src/fresh"]}]}
