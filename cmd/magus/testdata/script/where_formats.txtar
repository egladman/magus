# `magus where <project|file>` answers "where does this live on disk". It is the
# path-resolution verb agents use to turn a workspace-relative name into something they
# can hand to another tool, so its plain form is deliberately bare: a path and nothing
# else, safe to substitute directly into a command.

exec magus where .
stdout '/'

# The bare form is bare: no braces, no label, nothing to strip before substituting.
! stdout '\{'
! stdout 'workspace'

# Structured forms carry the same answer with its label, for a caller resolving several.
#
# These assertions used to read `stdout '\{|/'` - an alternation matching a plain path
# just as happily as an opening brace. where in fact ignored -o entirely and printed
# text for every format, and the test passed throughout, because there was no input on
# which it could fail. Assert the json SHAPE, which text cannot satisfy.
exec magus where . -o json
stdout '"workspace"'
stdout '"matches"'
stdout '"kind": "project"'

# rel is carried next to the absolute path: a caller that just resolved a name usually
# needs it back in workspace-relative form to hand to another magus command.
stdout '"rel"'

exec magus where . -o yaml
stdout 'workspace:'
stdout 'matches:'
stdout 'kind: project'

# A name that matches nothing fails rather than printing an empty line. An empty
# result substituted into a shell command becomes a silently wrong path.
! exec magus where no-such-project-here
stderr 'no projects or files match'

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(ctx); }
-- spells/acme/spell.buzz --
import "magus/spell";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
