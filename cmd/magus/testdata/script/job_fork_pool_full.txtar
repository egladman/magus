# A fork says when this machine's build budget is full, so the forker waits before
# starting the job's worker, which never waits for a seat itself. A broker turned off is
# never asked, and one that does not answer has no budget to report: both fork quietly.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
env GIT_AUTHOR_NAME=Ana
env GIT_AUTHOR_EMAIL=ana@example.com
env GIT_COMMITTER_NAME=Ana
env GIT_COMMITTER_EMAIL=ana@example.com
exec git init -q
exec magus init -local -vcs git
exec git add -A
exec git commit -q -m 'start'

exec magus job fork -h
stderr 'When this machine''s build budget is full it says how full and which run has held'
stderr 'which never waits for a seat'

exec magus job fork wave/off --write-paths code.go --check 'test .'
stdout '^forked wave/off'
! stdout 'build budget'

env MAGUS_BROKER=best-effort
env XDG_RUNTIME_DIR=$WORK/run
exec magus job fork wave/unanswered --write-paths code.go --check 'test .'
stdout '^forked wave/unanswered'
! stdout 'build budget'

-- code.go --
package pkg
