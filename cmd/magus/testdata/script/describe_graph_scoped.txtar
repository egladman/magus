# A MAGUS.md scoped to one project is a function of that project alone.
#
# `magus affected` only regenerates the indexes of projects a change touches. An index
# that embedded workspace-wide sizes and anchors went stale whenever another project
# moved the graph, and the drift surfaced later in an unrelated change's gate.
#
# A scoped index is a breadcrumb leaf. The workspace index links each project that
# declares a MAGUS.md and inlines only the root project and the ones that declare none.

exec magus describe graph -o markdown libs/foo
cp stdout scoped-before.md
exec magus describe graph -o markdown
cp stdout whole-before.md

# The heading is the directory name here: the fixture is not a git checkout, so there
# is no repo-relative path to label it with.
# The leaf is exactly: heading, up link, depends-on links, query, its target table.
cmp scoped-before.md want-leaf.md

# The workspace index links libs/foo and leaves its table to the leaf. The root and
# `other`, which declares no index, stay inline.
grep '\[libs/foo\]\(libs/foo/MAGUS\.md\)' whole-before.md
! grep '\(other/MAGUS\.md\)' whole-before.md
grep -count=2 '^## Project: ' whole-before.md
grep '^## Project: other$' whole-before.md
! grep '^## Project: libs/foo' whole-before.md
! grep 'Builds foo\.' whole-before.md
grep 'Builds other\.' whole-before.md
grep '^\| Kind' whole-before.md
! grep '^\| Kind' scoped-before.md
! grep 'schema v' scoped-before.md

# Move the graph from outside libs/foo: a target, a Go file, a doc full of links.
cp other-grown.buzz other/magusfile.buzz
cp notes.md other/notes.md
cp extra.go other/extra.go

exec magus describe graph -o markdown libs/foo
cp stdout scoped-after.md
exec magus describe graph -o markdown
cp stdout whole-after.md

cmp scoped-before.md scoped-after.md
! cmp whole-before.md whole-after.md

# A project path that names nothing is an error, not an empty index.
! exec magus describe graph -o markdown libs/fo
stderr 'unknown project "libs/fo"; did you mean "libs/foo"'

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
// Builds the workspace.
export fun build(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles("MAGUS.md");
}
-- libs/foo/magusfile.buzz --
import "magus";
magus\project({ "depends_on": ["../..", "../../other"] });
// Builds foo.
export fun build(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles("MAGUS.md");
}
-- other/magusfile.buzz --
import "magus";
// Builds other.
export fun build(ctx: magus\Context, args: [str]) > void {}
-- other-grown.buzz --
import "magus";
// Builds other.
export fun build(ctx: magus\Context, args: [str]) > void {}
// Tests other.
export fun test(ctx: magus\Context, args: [str]) > void { ctx.needs(build); }
-- notes.md --
# Notes

See [a](https://a.example/), [b](https://b.example/), [c](https://c.example/),
[d](https://d.example/), [e](https://e.example/), [f](https://f.example/),
[g](https://g.example/), [h](https://h.example/), [i](https://i.example/),
[j](https://j.example/), [k](https://k.example/).
-- extra.go --
package other

func Extra() int { return 1 }
-- want-leaf.md --
# foo

<!-- Generated by `magus describe graph -o markdown`. Do not edit by hand. -->

Up: [workspace index](../../MAGUS.md)

Depends on: [(workspace root)](../../MAGUS.md), other

Query: `magus query project=libs/foo`

| Target  | What it does |
| ------- | ------------ |
| `build` | Builds foo.  |

