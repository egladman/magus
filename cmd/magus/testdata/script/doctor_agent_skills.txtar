# An installed skill is a generated copy stamped with the binary's skill and
# knowledge-schema versions, so a magus upgrade leaves every checkout's copy behind
# with nothing else noticing. doctor's agent skills check is what notices.
#
# doctor exits nonzero here for reasons unrelated to skills (a minimal fixture does
# not satisfy every check), so these assert on THIS check's line rather than on the
# overall status - the alternative is a fixture that has to stay perfect forever.

# Nothing installed is ADVICE rather than a failure: a checkout with no skills is a
# choice, and the finding names the command that changes it.
! exec magus doctor
stdout 'agent-skills: not installed'
stdout 'magus agent install'

# After an install every location reports current. AGENTS.md is PASTED rather than
# installed - magus never writes it - so copying `agent starter` here stands in for
# the developer, and grading it proves the printed block round-trips.
exec magus agent install .claude/skills
exec magus agent starter
cp stdout AGENTS.md
! exec magus doctor
stdout 'agent-skills: 2 install location\(s\) current'

# A stale install fails, and unlike the verb this replaced it carries a remedy magus
# can run. When a harness descriptor owns the skills path, the Fix goes through
# harness install --id rather than a bare agent install --dir.
cp stale.md .claude/skills/magus-query/SKILL.md
! exec magus doctor
stdout 'agent-skills: installed skills are behind this binary: \.claude/skills'
exec magus doctor --fix --dry-run
stdout 'would fix agent-skills: magus agent harness install --id script-host'

# A skill a RENAME orphaned carries the stamp, so the same reinstall clears it: install
# removes what magus wrote and no longer ships. The finding says nothing about a
# reinstall falling short, and the Fix is still the harness install.
mkdir .claude/skills/magus-renamed-away
cp orphan.md .claude/skills/magus-renamed-away/SKILL.md
! exec magus doctor
stdout 'agent-skills: installed skills are behind this binary: \.claude/skills'
! stdout 'a reinstall alone will not fix it'
! stdout 'a reinstall leaves'
exec magus doctor --fix --dry-run
stdout 'would fix agent-skills: magus agent harness install --id script-host'
exec magus agent harness install --id script-host
stdout 'removed skill this binary no longer ships: \.claude/skills/magus-renamed-away'
! exists .claude/skills/magus-renamed-away
! exec magus doctor
stdout 'agent-skills: 2 install location\(s\) current'

# An empty directory has no stamp to prove magus wrote it, so install leaves it. The
# finding stays a failure, names the directory as stale with the command that removes
# it, and offers no --fix: a reinstall would change nothing.
mkdir .claude/skills/magus-empty
! exec magus doctor
stdout 'agent-skills: installed skills are behind this binary: \.claude/skills; a reinstall leaves these directories, remove them by hand: \.claude/skills/magus-empty'
stdout 'rmdir \.claude/skills/magus-empty'
exec magus doctor --fix --dry-run
! stdout 'would fix agent-skills'
exec magus agent harness install --id script-host
exists .claude/skills/magus-empty
rm .claude/skills/magus-empty
! exec magus doctor
stdout 'agent-skills: 2 install location\(s\) current'

-- orphan.md --
---
name: magus-renamed-away
---
body a past magus wrote and this one no longer ships
<!-- generated by: magus agent install; agent-skill-version: 39; knowledge-schema-version: 9; do not edit -->
-- stale.md --
---
name: magus-query
---
body
<!-- generated by: magus agent install; agent-skill-version: 0; knowledge-schema-version: 1; do not edit -->
-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "spells/acme";
import "spells/script-host" as scripthost;
magus\harness.provider(scripthost);
magus\project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(ctx); }
-- spells/acme/spell.buzz --
import "magus/spell";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
-- spells/script-host/spell.buzz --
import "magus/spell";

export fun mgs_getName() > str { return "script-host"; }

export fun harness_config(target: Target, cb: fun(any)) > {str: any} {
    return {"path": "hooks.json"};
}

export fun harness_skills(target: Target, cb: fun(any)) > {str: any} {
    return {"paths": [".claude/skills"], "form": "both"};
}

export fun harness_entries(target: Target, cb: fun(any)) > [any] {
    return [];
}
