# A writing job's fork permits, as the integrator's, each declared output a target
# regenerates from sources inside its write paths when the output sits outside them: a flag
# registry feeds a manpage in another project and a lock file beside it. It prints one line
# counting them. An output a deny path touches is still refused (MGS3044). An output the
# paths hold (the rules page) is not named, nor is one git ignores (coverage), nor anything
# for a read-only job. A glob deviation in the record accepts them all. describe job carries
# the block for the holder, and json gets a field. An apply that widens the paths judges
# only the outputs the added paths bring in.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
env GIT_AUTHOR_NAME=Ana
env GIT_AUTHOR_EMAIL=ana@example.com
env GIT_COMMITTER_NAME=Ana
env GIT_COMMITTER_EMAIL=ana@example.com
exec git init -q -b main
exec git add -A
exec git commit -q -m 'registry and its generated pages'

! exec magus job fork flags/locked --write-paths 'cli/*.go,docs/rules/*.md' --deny-paths cli/testdata/api.lock --check 'test .'
! stdout .
stderr '^\[error\] 1 problem:$'
stderr '^  1\. \[MGS3044\] write_paths: \.:man-generate regenerates cli/testdata/api\.lock from cli/\*\*/\*\.go'
stderr '^permitted 1:$'
stderr 'docs/manpage/\*\.md sits outside them \(permitted: the integrator regenerates it\)'
stderr '^note: 1 regenerated output\(s\) outside the write paths are permitted'
exec magus ls jobs -o name
! stdout .

exec magus job fork flags/shell --write-paths 'cli/*.go,docs/rules/*.md' --check 'test .'
stdout '^forked flags/shell, declared, with 2 write path\(s\)\.'
stderr '^note: 2 regenerated output\(s\) outside the write paths are permitted: the integrator owns them$'

stdin $WORK/fork.json
exec magus job fork --stdin
cmp stdout $WORK/fork.out
! stderr 'regenerated output'

exec magus describe job flags/shell
stdout '^regenerated outside the write paths, from sources inside them$'
stdout '^  docs/manpage/\*\.md \(docs:content-generate\)$'
! stdout 'docs/rules/\*\.md \('
! stdout 'coverage'

exec magus describe job flags/shell -o json
stdout '"regenerated_outside"'
stdout '"output": "cli/testdata/api\.lock"'
stdout '"target": "\.:man-generate"'
stdout '"source": "cli/registry\.go"'

exec magus job fork flags/survey --read-only --criteria 'read the registry'
! stdout 'regenerated outside'

stdin $WORK/widen.json
exec magus job apply -f -
stdout '^  write_paths \+docs/manpage/\*\.md$'
! stdout 'docs:content-generate'

-- fork.json --
{"schema_version": 11, "id": "flags/glob", "write_paths": ["cli/*.go", "docs/rules/*.md"],
 "check": {"target": "test", "project": "."},
 "deviations": [{"code": "MGS3044", "subject": "**", "reason": "the integrator regenerates every one"}]}
-- fork.out --
forked flags/glob, declared, with 2 write path(s). Its holder reads the terms with `magus describe job flags/glob` and takes it with `magus job exec flags/glob`
model tier: standard (rank 1), default: "the declared default" at magus/modeltiers
referenced outside the write paths: files that use what the write paths define
  unknown, no symbol index answered; `magus graph build` builds one
-- widen.json --
{"schema_version": 11, "id": "flags/shell", "write_paths": ["cli/*.go", "docs/rules/*.md", "docs/manpage/*.md"],
 "check": {"target": "test", "project": "."}}
-- .gitignore --
.magus/
coverage/
-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "proc";

// man_generate writes the API lock from the flag registry.
export fun man_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["cli/**/*.go"]);
    ctx.writesFiles(["cli/testdata/api.lock"]);
    proc\exec("sh", ["-c", "cat cli/*.go > cli/testdata/api.lock"]);
}

// test writes coverage git never sees.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["cli/**/*.go"]);
    ctx.writesFiles(["coverage/*.out"]);
    proc\exec("sh", ["-c", "mkdir -p coverage && touch coverage/cli.out"]);
}
-- cli/registry.go --
package cli
-- cli/testdata/api.lock --
package cli
-- docs/magusfile.buzz --
import "magus";
import "proc";
import "project/.." as ws;

// content_generate renders the manpage and the rules pages from the flag registry.
export fun content_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles([ws\file("cli/registry.go")]);
    ctx.writesFiles(["manpage/*.md", "rules/*.md"]);
    proc\exec("sh", ["-c", "true"]);
}
-- docs/manpage/magus-shell.md --
# magus shell
-- docs/rules/guard.md --
# guard
