# The settledness oracle for derived target ordering. The fixture is the
# entangled shape hand-wiring used to be the only answer for: base's
# first-generate writes SEED.md, site's page-generate derives page.md from it,
# and base's index-generate derives index.txt from every .md it reads -
# page.md included. site, nested in base, depends_on "..", so base runs first,
# and no step order can put page-generate before index-generate: at project
# granularity the data flow is a cycle. Target by target it is acyclic
# (first-generate -> page-generate -> index-generate), which is what the
# scheduler derives from the declarations; the against-the-grain hop is settled
# by re-running index-generate once its input actually moved. The upstream is a
# project of its own because a depends_on may not name the root (MGS1061).
#
# The workspace is ws/, so audit's probe log sits outside it and is no undeclared
# write (MGS4011).
cd ws

# The committed state is settled for seed "one". Move the seed.
cp seed2.txt base/src/seed.txt

# ONE invocation must settle the whole chain.
exec magus run assemble base base/site
# The settle re-run is accounted like a batch step - a limiter slot, the inflight
# set, a journal result event with its own captured log - so it REPORTS like one.
# The repro line comes from the cache's result record and from nowhere else, so it
# is the observable difference between settling through the cache and dispatching
# straight at the interpreter, which produced no record at all and made a stalled
# settle indistinguishable from a run that forgot to exit. Match the repro line,
# NOT the target name: the settle log line above already names the target, so an
# assertion on that alone passes either way.
stderr 'magus run index-generate'
cmp base/SEED.md want-seed.md
cmp base/site/page.md want-page.md
cmp base/index.txt want-index.txt

# audit is a skip-cache VERIFIER: its fallback reads overlap page-generate's
# writes exactly as index-generate's do, but it declares no writes, so settling
# must leave it alone - it ran once in the batch and that is all. Re-running
# verifiers on the post-batch tail is how a stalled scanner once wedged a green
# gate for an hour.
cmp ../audit.log want-audit-once

# A second identical invocation changes nothing: the settle step re-runs a
# reader only when a writer's bytes moved, and nothing moves on a settled tree.
cp base/index.txt index.settled
exec magus run assemble base base/site
cmp base/index.txt index.settled
cmp ../audit.log want-audit-twice

-- ws/magus.yaml --
concurrency: 2
-- ws/magusfile.buzz --
import "magus";
-- ws/base/src/seed.txt --
one
-- ws/base/SEED.md --
one
-- ws/base/index.txt --
one
page: one
-- ws/want-seed.md --
two
-- ws/want-page.md --
page: two
-- ws/want-index.txt --
two
page: two
-- ws/seed2.txt --
two
-- ws/base/magusfile.buzz --
import "magus";
import "proc";
magus\project({
    "sources": ["src/*.txt", "**/*.md"],
    "targets": {
        "index-generate": {"skip_cache": "derives from the whole tree; no input glob can key it"},
        "audit": {"skip_cache": "a verdict about the current tree; a replay would skip the check"},
    },
});
export fun first_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["src/seed.txt"]);
    ctx.writesFiles(["SEED.md"]);
    proc\exec("sh", ["-c", "cp src/seed.txt SEED.md"]);
}
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["index.txt"]);
    proc\exec("sh", ["-c", "cat SEED.md site/page.md > index.txt"]);
}
export fun audit(ctx: magus\Context, args: [str]) > void !> any {
    proc\exec("sh", ["-c", "echo ran >> ../../audit.log"]);
}
export fun assemble(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(first_generate);
    ctx.needs(index_generate);
    ctx.needs(audit);
}
-- ws/want-audit-once --
ran
-- ws/want-audit-twice --
ran
ran
-- ws/base/site/page.md --
page: one
-- ws/base/site/magusfile.buzz --
import "magus";
import "proc";
import "project/.." as base;
magus\project({ "depends_on": [".."], "sources": ["*.md"] });
export fun page_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles([base\file("SEED.md")]);
    ctx.writesFiles(["page.md"]);
    proc\exec("sh", ["-c", "sed 's/^/page: /' ../SEED.md > page.md"]);
}
export fun assemble(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(page_generate);
}
