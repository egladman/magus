# A fork records the model tier its job runs at, and the step that chose it: the job when
# it names a tier or a model, else the workspace's matrix, else the declared default. Fork
# prints the line, describe job prints it again with the skill variant, and ls jobs shows
# the tier when the job names no model. A dry-run apply assigns nothing and runs no matrix.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
exec magus init -local -vcs git
cp $WORK/matrix.buzz magusfile.buzz
cp $WORK/code.go a.go
cp $WORK/code.go b.go
cp $WORK/code.go c.go
cp $WORK/code.go d.go
cp $WORK/code.go e.go
cp $WORK/code.go f.go

# The matrix answers for a one-file job.
stdin $WORK/small.json
exec magus job fork --stdin
stdout '^model tier: routine \(rank 0\), matrix: "1 file in 1 project" at magusfile\.buzz$'
exec magus describe job wave/small
stdout '^model tier: routine \(rank 0\), matrix: "1 file in 1 project" at magusfile\.buzz$'
stdout '^skills: full$'

# It declines for a wider one, and the shipped default decides.
stdin $WORK/wide.json
exec magus job fork --stdin
stdout '^model tier: bounded \(rank 1\), default: "the declared default" at magus/modeltiers$'
exec magus describe job wave/wide
stdout '^skills: short$'

# A job naming a tier wins and the matrix is not asked.
stdin $WORK/named.json
exec magus job fork --stdin
stdout '^model tier: design \(rank 2\), job: "the job names the tier design"$'

# A model that maps to no tier is kept as the job's word and takes the default's rank.
stdin $WORK/model.json
exec magus job fork --stdin
stdout '^model tier: bounded \(rank 1\), job: "the job names the model haiku, which no model tier maps to"$'

# ls jobs shows the tier where the job names no model, and the model where it does.
exec magus ls jobs
stdout 'wave/small +- +declared +routine '
stdout 'wave/wide +- +declared +bounded '
stdout 'wave/named +- +declared +design '
stdout 'wave/model +- +declared +haiku '

# A dry-run apply writes nothing and assigns no tier; the real one creates the job with one.
stdin $WORK/applied.json
exec magus job apply --stdin --dry-run
stdout '^would create wave/applied with 1 write path\(s\)$'
! stdout 'model tier'
exec magus ls jobs -o name
! stdout 'wave/applied'
stdin $WORK/applied.json
exec magus job apply --stdin
stdout '^created wave/applied, declared, with 1 write path\(s\)$'
stdout '^model tier: routine \(rank 0\), matrix: "1 file in 1 project" at magusfile\.buzz$'

-- matrix.buzz --
import "magus";
import "magus/agent";
import "magus/modeltiers" as modeltiers;

object Choice { tier: modeltiers\ModelTier, skills: magus\agent\SkillVariant, reason: str }

fun choose(req: ModelTierRequest) > Choice? {
    if (req.writeFiles != 1 or req.writeProjects.len() != 1) { return null; }
    return Choice{
        tier = modeltiers\ModelTier.routine,
        skills = magus\agent\SkillVariant.full,
        reason = "{req.writeFiles} file in {req.writeProjects.len()} project",
    };
}

magus\modelTier(choose);
-- code.go --
package pkg
-- small.json --
{"api_version": "magus.job/v1alpha1", "id": "wave/small", "paths": {"write": ["a.go"]},
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["a.go"]}]}
-- wide.json --
{"api_version": "magus.job/v1alpha1", "id": "wave/wide", "paths": {"write": ["b.go", "c.go"]},
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["b.go", "c.go"]}]}
-- named.json --
{"api_version": "magus.job/v1alpha1", "id": "wave/named", "paths": {"write": ["d.go"]}, "agent": {"model": {"tier": "design"}, "worker": {"type": "resumed"}},
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["d.go"]}]}
-- model.json --
{"api_version": "magus.job/v1alpha1", "id": "wave/model", "paths": {"write": ["e.go"]}, "agent": {"model": {"id": "haiku"}, "worker": {"type": "resumed"}},
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["e.go"]}]}
-- applied.json --
{"api_version": "magus.job/v1alpha1", "id": "wave/applied", "paths": {"write": ["f.go"]},
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["f.go"]}]}
