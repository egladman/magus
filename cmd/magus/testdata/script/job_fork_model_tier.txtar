# A fork records the model tier its job runs at, and the step that chose it. A fork
# names its model (ADR 0043), so the row decides: a tier by name, or a model the
# harness maps, or one no tier maps to, which takes the default's rank. A declared
# matrix is never asked. Fork prints the line, describe job prints it again with the
# skill variant, and ls jobs shows the model the row names. A dry-run apply assigns
# nothing.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
exec magus init -local -vcs git
cp $WORK/matrix.buzz magusfile.buzz
cp $WORK/code.go a.go
cp $WORK/code.go d.go
cp $WORK/code.go e.go
cp $WORK/code.go f.go

# A row naming a tier takes it, and the matrix that would answer for a one-file job is not asked.
stdin $WORK/small.json
exec magus job fork --stdin
stdout '^model tier: economy \(rank 0\), row: "the job names the tier economy"$'
! stdout 'matrix'
exec magus describe job wave/small
stdout '^model tier: economy \(rank 0\), row: "the job names the tier economy"$'
stdout '^skills: '

stdin $WORK/named.json
exec magus job fork --stdin
stdout '^model tier: principal \(rank 2\), row: "the job names the tier principal"$'

# A model that maps to no tier is kept as the row's word and takes the default's rank.
stdin $WORK/model.json
exec magus job fork --stdin
stdout '^model tier: standard \(rank 1\), row: "the job names the model haiku, which no model tier maps to"$'

# ls jobs shows the tier a row names, and the model where it names one.
exec magus ls jobs
stdout 'wave/small +- +declared +economy '
stdout 'wave/named +- +declared +principal '
stdout 'wave/model +- +declared +haiku '

# A dry-run apply writes nothing and assigns no tier; the real one creates the row with one.
stdin $WORK/applied.json
exec magus job apply --stdin --dry-run
stdout '^would create wave/applied with 1 write path\(s\)$'
! stdout 'model tier'
exec magus ls jobs -o name
! stdout 'wave/applied'
stdin $WORK/applied.json
exec magus job apply --stdin
stdout '^created wave/applied, declared, with 1 write path\(s\)$'
stdout '^model tier: economy \(rank 0\), row: "the job names the tier economy"$'

-- matrix.buzz --
import "magus";
import "magus/modeltiers" as modeltiers;

object Choice { tier: modeltiers\ModelTier, skills: magus\SkillVariant, reason: str }

fun choose(req: ModelTierRequest) > Choice? {
    if (req.writeFiles != 1 or req.writeProjects.len() != 1) { return null; }
    return Choice{
        tier = modeltiers\ModelTier.economy,
        skills = magus\SkillVariant.full,
        reason = "{req.writeFiles} file in {req.writeProjects.len()} project",
    };
}

magus\modelTier(choose);
-- code.go --
package pkg
-- small.json --
{"api_version": "magus.job/v1alpha1", "id": "wave/small", "criteria": "the scripted job", "model": "economy", "write_paths": ["a.go"],
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["a.go"]}]}
-- named.json --
{"api_version": "magus.job/v1alpha1", "id": "wave/named", "criteria": "the scripted job", "write_paths": ["d.go"], "model": "principal",
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["d.go"]}]}
-- model.json --
{"api_version": "magus.job/v1alpha1", "id": "wave/model", "criteria": "the scripted job", "write_paths": ["e.go"], "model": "haiku",
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["e.go"]}]}
-- applied.json --
{"api_version": "magus.job/v1alpha1", "id": "wave/applied", "criteria": "the scripted job", "model": "economy", "write_paths": ["f.go"],
 "goals": [{"id": "edited", "kind": "paths", "expect": "changed", "paths": ["f.go"]}]}
