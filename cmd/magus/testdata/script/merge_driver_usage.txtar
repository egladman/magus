# magus merge-driver is the VCS merge driver git/hg invoke for declared output
# files: on a merge conflict in a path matching a declared Output glob, it keeps the
# version the VCS already staged instead of leaving conflict markers, and an explicit
# `magus run <target>` settles the result afterwards. Users never type this command
# themselves - `magus init` wires it into .git/config (or .hgrc) once per clone - so
# what is worth pinning here is the usage/argument contract. The resolution itself is
# unit-tested in merge_driver_test.go, which needs a workspace whose target declares
# the conflicted path as its own output.

# Bare `magus merge-driver` is a usage error (exit 2). It used to exit 0, which for a
# MERGE DRIVER is the wrong signal to hand back: 0 is how the driver tells git the
# conflict was resolved. git always passes all five placeholders so this path is only
# reachable by a human, but 0 also disagreed with the 1-argument case, which errored.
! exec magus merge-driver
stderr 'expected 5 arguments'
stderr 'Usage: magus merge-driver %O %A %B %L %P'
stderr 'git and hg invoke this'
stderr 'Wire it once per clone with .magus init.'

# The wrong number of arguments (git/hg always pass exactly 5) is a distinct,
# nonzero-exit error path.
! exec magus merge-driver onlyonearg
stderr '\[error\] magus merge-driver: expected 5 arguments \(ancestor result other markerSize path\), got 1'

# Five arguments naming a path no project declares as an Output. magus has no
# regeneration that would settle it later, so it fails and lets the VCS write ordinary
# conflict markers rather than silently picking a side of a hand-merged file.
! exec magus merge-driver base.txt local.txt other.txt 0 local.txt
stderr '\[error\] merge-driver: no project declares "local.txt" as an output; cannot resolve'

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(ctx); }
-- spells/acme/spell.buzz --
import "magus/spell";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
-- base.txt --
base
-- local.txt --
local
-- other.txt --
other
