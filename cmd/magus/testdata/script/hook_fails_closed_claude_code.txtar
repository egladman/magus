# A Claude Code hook that cannot judge refuses its call. Claude Code runs the call of a
# hook that exits anything but 0 or 2, and one session logged 2,158 such failures while
# its ./magus could not read magus.yaml. The rendered wiring turns any other exit into 2,
# and magus answers its own startup failure with 2, passing only the repair the workspace
# declares: a release for a consumer, the bootstrap for a checkout of magus. A stop that
# cannot be judged ends instead, with the 1 Claude Code shows and does not block on.
#
# Each case runs the wiring `magus describe harness` renders, as the host would.

[windows] skip 'the wiring is POSIX sh'

env SAVED_PATH=$PATH

# --- a workspace that installs a release ----------------------------------------

# The workspace imports the shipped spell from its own tree, as a workspace does.
mkdir $WORK/release/spells/harness/claude-code
cp $__MAGUS_TEMPLATES/../../../../spells/harness/claude-code/spell.buzz $WORK/release/spells/harness/claude-code/spell.buzz

cd $WORK/release
exec magus describe harness claude-code -o 'template={{range .wired}}{{if eq .key "hooks.PreToolUse"}}{{(index (index .entries 0).hooks 0).command}}{{end}}{{end}}'
cp stdout $WORK/pre.sh
exec magus describe harness claude-code -o 'template={{range .wired}}{{if eq .key "hooks.Stop"}}{{(index (index .entries 0).hooks 0).command}}{{end}}{{end}}'
cp stdout $WORK/stop.sh
mkdir docs/guides/integrations
symlink docs/guides/integrations/agents -> $__MAGUS_TEMPLATES
env CLAUDE_PROJECT_DIR=$WORK/release

# A magus.yaml this magus cannot read refuses an ordinary call and names the update.
cp $WORK/unreadable.yaml magus.yaml
stdin $WORK/touch.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit 2$'
stderr 'magus guard could not judge this call, so it is refused'
stderr 'cannot unmarshal'
stderr '`magus self update`'

# A read is refused as well: nothing loaded to say which reads the workspace guards.
stdin $WORK/read.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit 2$'

# The update it names passes.
stdin $WORK/self-update.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit 0$'
! stderr .

# A stop ends unjudged rather than sending the agent back to work.
stdin $WORK/stop.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/stop.sh
stdout '^exit 1$'
stderr 'magus guard could not judge this stop, so it ends unjudged'

# A bad MAGUS_* value refuses the same way, and the update still passes.
cp $WORK/readable.yaml magus.yaml
env MAGUS_CONCURRENCY=many
stdin $WORK/touch.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit 2$'
stderr 'MAGUS_CONCURRENCY'
stderr '`magus self update`'
stdin $WORK/self-update.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit 0$'
env MAGUS_CONCURRENCY=

# No magus anywhere: the hook exits 127, which the wiring turns into a refusal.
env PATH=/usr/bin:/bin
stdin $WORK/touch.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit 2$'
stderr '127 means no magus was found'
env PATH=$SAVED_PATH

# --- a checkout of magus, which builds its own ./magus -----------------------------

cd $WORK/source
mkdir docs/guides/integrations
symlink docs/guides/integrations/agents -> $__MAGUS_TEMPLATES
env CLAUDE_PROJECT_DIR=$WORK/source

# Unreadable config: the bootstrap and the checkout hook are its repair, not a release.
cp $WORK/source-unreadable.yaml magus.yaml
stdin $WORK/touch.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit 2$'
stderr 'GOEXPERIMENT=jsonv2 go run -trimpath ./cmd/magus run go-build --no-cache \.'
stderr 'hack/dev/bootstrap-checkout.buzz -- --here --verify-ready'
! stderr 'self update'
stdin $WORK/bootstrap.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit 0$'
stdin $WORK/self-update.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit 2$'

# No magus anywhere: refused, the bootstrap with it, since nothing is left to judge it.
env PATH=/usr/bin:/bin
stdin $WORK/bootstrap.json
exec sh -c 'sh "$0"; echo "exit $?"' $WORK/pre.sh
stdout '^exit 2$'
stderr '127 means no magus was found'
env PATH=$SAVED_PATH

-- release/magusfile.buzz --
import "magus";
import "spells/harness/claude-code" as claude;
magus\harness.provider(claude);
-- release/magus.yaml --
{}
-- unreadable.yaml --
knowledge:
  conformance:
    checks:
      dep-fanout:
        max: 3
-- readable.yaml --
{}
-- source/go.mod --
module github.com/egladman/magus

go 1.25
-- source/magusfile.buzz --
-- source/magus.yaml --
{}
-- source-unreadable.yaml --
checkout:
  bootstrap: hack/dev/bootstrap-checkout.buzz
knowledge:
  conformance:
    checks:
      dep-fanout:
        max: 3
-- touch.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"touch x"}}
-- read.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Read","tool_input":{"file_path":"magus.yaml"}}
-- self-update.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"magus self update"}}
-- bootstrap.json --
{"session_id":"s1","hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"GOEXPERIMENT=jsonv2 go run -trimpath ./cmd/magus run go-build --no-cache ."}}
-- stop.json --
{"session_id":"s1","hook_event_name":"Stop","stop_hook_active":false}
