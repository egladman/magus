# The rehydration brief, through the real CLI.
#
# What this covers that the unit tests cannot: that `--brief` is reachable on the
# session verb at all, and that every section survives the trip through the output
# machinery in both text and JSON. A brief a host wires and cannot invoke fails
# silently, because a session-start hook's stdout is nobody's error channel.

env XDG_STATE_HOME=$WORK/state

exec magus session --brief
stdout 'magus brief: read from this checkout just now'
stdout 'tree: '
# The checkout carries a hook config and an instruction file, so both trailers are
# the positive arm rather than the "none here" one.
stdout 'guard wiring: host/hooks\.json'
stdout 'rules live in AGENTS\.md'
stdout 're-read them'

exec magus session --brief -o json
stdout '"workspace"'
stdout '"tree"'
stdout '"guard_wiring"'
stdout '"rules"'

# The listing is untouched: --brief is a second reading of the same store's question,
# not a replacement for it.
exec magus session
stdout 'no sessions recorded yet'

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
magus.project({"sources": ["*.md"]});
-- AGENTS.md --
# rules

The workspace's own instructions live here.
-- harnesses/brief-host.json --
{"schema_version":2,"id":"brief-host","display":{"name":"Brief Host"},"config":{"path":"host/hooks.json"},"skills":{"paths":[".agents/skills"],"form":"both"},"managed_entries":[{"path":["hooks","before"],"entries":[{"match":"run","commands":[{"type":"command","command":"sh magus-command.sh"}]}]}]}
-- host/hooks.json --
{"hooks":{"before":[{"match":"run","commands":[{"type":"command","command":"sh magus-command.sh"}]}]}}
-- magus-command.sh --
#!/bin/sh
# Stands in for the real shipped script: `magus session --brief` reports guard
# wiring only for a harness `magus agent harness verify` actually confirms
# answers (internal/agent/harness_probe.go), not merely one whose config carries
# the right text.
cat >/dev/null
printf 'deny'
