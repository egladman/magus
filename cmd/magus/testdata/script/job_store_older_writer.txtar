# The job store is refused by its schema, never by the commit that wrote it. A header
# stamped by a build from the far future is written freely by this build, and a header
# that requires a feature this build lacks is refused with MGS3051 on read and write.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
env GIT_AUTHOR_NAME=Ana
env GIT_AUTHOR_EMAIL=ana@example.com
env GIT_COMMITTER_NAME=Ana
env GIT_COMMITTER_EMAIL=ana@example.com
cd shop
exec git init -q -b main
exec git add -A
exec git commit -q -m 'shop'

exec magus job fork scout/first --read-only --criteria 'read the tests'

# A build from commit 8a9d, committed in 2099, wrote the store.
exec sh -c 'f=$(find "$XDG_STATE_HOME" -name jobs.jsonl) && sed "1s/}\$/,\"writer\":{\"commit\":\"8a9d\",\"time\":\"2099-01-01T00:00:00Z\"}}/" "$f" > "$f.new" && mv "$f.new" "$f"'

exec magus job fork scout/second --read-only --criteria 'read the tests'
exec magus ls jobs --all
stdout 'scout/first'
stdout 'scout/second'

# The store now requires a feature this build lacks.
exec sh -c 'f=$(find "$XDG_STATE_HOME" -name jobs.jsonl) && sed "1s/}\$/,\"requires\":[\"jobs-v99\"]}/" "$f" > "$f.new" && mv "$f.new" "$f"'

! exec magus job fork scout/third --read-only --criteria 'read the tests'
stderr '\[MGS3051\]'
stderr 'requires "jobs-v99"'
stderr 'update magus'

# A run, the bootstrap's go-build included, never needs to write the store.
exec magus run test .

-- shop/.gitignore --
.magus/
-- shop/magus.yaml --
jobs:
  stale_after: 1s
-- shop/magusfile.buzz --
import "magus";

export fun test(ctx: magus\Context, args: [str]) > void !> any {
}
