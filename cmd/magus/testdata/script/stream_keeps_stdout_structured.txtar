# Streaming a target's output must not contaminate the structured answer.
#
# Stdout carries the machine-readable result of -o json|yaml|jsonl|template and
# nothing else. Everything magus says to a human - status lines, notices, failure
# dumps - is on stderr already.
#
# MAGUS_LOG_STREAM=1 (which CI sets, so a green run leaves a record of what it was
# doing) used to send a target's stdout to os.Stdout as well. A build whose target
# printed anything then emitted a stdout no JSON parser would accept: the document
# arrived with pnpm and test chatter in front of it. This asserts the two streams
# stay separated with streaming ON, which is the configuration that broke.

env MAGUS_LOG_STREAM=1

exec magus run noisy -o json
stdout '^\{'
! stdout 'CHATTER_ON_STDOUT'
stderr 'CHATTER_ON_STDOUT'

# yaml: same rule, different serializer.
exec magus run noisy -o yaml
! stdout 'CHATTER_ON_STDOUT'

# template renders one field; anything else on stdout makes it unusable in a
# shell substitution, which is the documented way to read a single value.
exec magus run noisy -o 'template={{.target}}'
stdout '^noisy$'

# And with streaming off, stdout is still only the structured answer.
env MAGUS_LOG_STREAM=0
exec magus run noisy -o json
stdout '^\{'
! stdout 'CHATTER_ON_STDOUT'

# -- -o jsonl: EVERY line on BOTH streams is a record. The run is UNCACHED and its
# target composes a member through ctx.needs, so the member executes, prints, and
# completes as a stage: the shape that used to stream the member's raw output to
# stderr and emit no run.step, because jsonl did not withhold. Streaming stays on to
# show a structured run withholds whatever MAGUS_LOG_STREAM says. The output is in
# the run log behind the ref run.target.result names, not on either stream.
env MAGUS_LOG_STREAM=1
exec magus run composite --no-cache -o jsonl
jsonl-records
stdout '"type":"run.target.result"'
stdout '"type":"run.scope"'
stdout '"type":"run.step".*"target":"member"'
! stdout 'MEMBER_CHATTER'
! stderr 'MEMBER_CHATTER'

# -s changes which records a structured run carries, never whether a line is one.
exec magus run composite --no-cache -o jsonl -s
jsonl-records
! stderr 'MEMBER_CHATTER'

# A failing member still leaves both streams parseable: its output is behind the ref.
! exec magus run broken --no-cache -o jsonl
jsonl-records
stdout '"type":"run.target.result".*"status":"failed"'
! stderr 'BROKEN_CHATTER'

-- magus.yaml --
concurrency: 1
-- magusfile.buzz --
import "magus";
import "std";

magus\project({});

// Writes to the target's OWN stdout, which is the stream that used to leak.
export fun noisy(ctx: magus\Context, args: [str]) > void {
    std\print("CHATTER_ON_STDOUT");
}

export fun member(ctx: magus\Context, args: [str]) > void {
    std\print("MEMBER_CHATTER");
}

export fun composite(ctx: magus\Context, args: [str]) > void {
    ctx.needs(member);
}

export fun broken(ctx: magus\Context, args: [str]) > void {
    std\print("BROKEN_CHATTER");
    throw "broken on purpose";
}
