# `magus job fork --fix` never moves a checkpoint: a revision the repository does not hold
# stays the MGS3041 error, with or without -s, and nothing is forked or checked out.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
env GIT_AUTHOR_NAME=Ana
env GIT_AUTHOR_EMAIL=ana@example.com
env GIT_COMMITTER_NAME=Ana
env GIT_COMMITTER_EMAIL=ana@example.com
exec git init -q -b main
exec git add -A
exec git commit -q -m 'shop'

! exec magus job fork moved --read-only --criteria 'read the pricing code' --checkpoint 0123456789abcdef0123456789abcdef01234567 --checkout $WORK/moved --fix
stderr '\[MGS3041\] checkpoint: checkpoint "0123456789abcdef0123456789abcdef01234567" names no revision this repository holds'
! stderr 'refreshed the checkpoint'
! exists $WORK/moved

! exec magus -s job fork moved --read-only --criteria 'read the pricing code' --checkpoint 0123456789abcdef0123456789abcdef01234567 --checkout $WORK/moved --fix
stderr '\[MGS3041\]'
! stderr 'refreshed the checkpoint'
! exists $WORK/moved
exec magus ls jobs -o name
! stdout .

-- .gitignore --
.magus/
-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";

// test has nothing to check; the job here only reads.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
}
