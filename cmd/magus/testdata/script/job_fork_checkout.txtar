# `magus job fork --checkout <dir>` makes the job's own checkout at the forker's revision
# and records it on the job. The job is taken there and nowhere else, and once it ends
# magus removes the checkout when it holds no work.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
env GIT_AUTHOR_NAME=Ana
env GIT_AUTHOR_EMAIL=ana@example.com
env GIT_COMMITTER_NAME=Ana
env GIT_COMMITTER_EMAIL=ana@example.com
cd shop
exec git init -q -b main
exec git add -A
exec git commit -q -m 'shop'

exec magus job fork scout --read-only --criteria 'read the pricing code' --checkout $WORK/scout
stdout '^checkout .*scout: made for job scout at '
stdout 'placed no magus: the forking checkout runs magus from PATH'
exists $WORK/scout/magusfile.buzz

exec magus describe job scout
stdout '^checkout .*scout: made for job scout'

! exec magus job exec scout
stderr 'owns the checkout .*scout, which its fork made for it'

! exec magus job fork scout --read-only --criteria 'again' --checkout $WORK/elsewhere
stderr 'already owns the checkout .*scout'
! exists $WORK/elsewhere

exec magus job exit scout
stdout '^ended scout, recorded no_return'
stdout '^checkout .*scout: removed once job scout ended'
! exists $WORK/scout

-- shop/.gitignore --
.magus/
-- shop/magus.yaml --
concurrency: 2
-- shop/magusfile.buzz --
import "magus";

// test has nothing to check; the job here only reads.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
}
