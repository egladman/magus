# Only `magus tail -f` needs a terminal. Plain `magus tail` prints the last -n
# lines to stdout and exits, which is exactly what a script, a CI step, or an
# agent wants - so gating the whole command on isInteractiveTTY made the useful
# half unreachable for every non-human caller.
#
# The old gate covered both, and an assume_interactive config key existed largely
# to undo it. Narrowing the gate removed the need for the key, so the key is gone;
# this file pins the narrowed behaviour that replaced it.

# FOLLOW without a terminal is refused, and the message says what to do instead
# rather than naming a config key to set.
! exec magus tail -f
stderr 'magus: tail -f requires an interactive terminal; drop -f to print the last lines and exit'
! stderr 'assume_interactive'

exec magus tail -h
stderr 'Usage: magus tail \[-f\] \[-n <count>\] \[target\]'
stderr 'Only -f requires an interactive terminal'

# NON-follow with no terminal proceeds past the gate entirely and fails on its
# OWN terms - the root project is excluded from cwd resolution, so there is
# nothing to resolve here. That it reaches this error at all is the point.
! exec magus tail
stderr 'magus tail: not inside a project directory'

cd api

# Still no terminal, still no gate: the failure is the missing cache entry, which
# is the command's own business rather than the terminal's.
! exec magus tail
stderr 'magus tail: no cache entries found for project "api" - run a build first'

# And with a real cached log, a headless `magus tail` streams it to stdout. This
# is the case the old gate made impossible.
exec magus run lint
exec magus tail
stdout 'acme-tail-marker'

# -n is honoured headless too, so a caller can bound what it reads.
exec magus tail -n 1
stdout 'acme-tail-marker'

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
magus.project({});
-- api/magusfile.buzz --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(ctx); }
-- spells/acme/spell.buzz --
import "magus/target";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "echo", args = ["acme-tail-marker"]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
