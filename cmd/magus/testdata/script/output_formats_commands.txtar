# The output-format matrix for the structured commands OUTSIDE describe.
#
# Same contract as describe_output_formats.txtar and the same reason: a field added to
# one format and forgotten in another is invisible until someone scripts against the
# format that lost it. Asserting the pair succeeds and produces output catches that
# without pinning bytes, so the tests do not have to be rewritten every time a count
# changes.
#
# Commands whose exit status is nonzero on a minimal fixture (doctor fails unrelated
# checks here) are asserted with `!` and keyed on their output instead - the point is
# the FORMAT rendering, not the verdict.

# -- ls ----------------------------------------------------------------------
exec magus ls
stdout 'acme'
exec magus ls -o json
stdout '"projects"'
exec magus ls -o yaml
stdout 'projects:'
exec magus ls -o name

# -- status ------------------------------------------------------------------
# Daemon is off in these scripts, so status reports the local view. That is the
# interesting case anyway: the lock and symbol-index sections are workspace-local and
# populated with no daemon at all.
exec magus status
exec magus status -o json
stdout '"telemetry"'
stdout '"cache"'
exec magus status -o yaml
stdout 'telemetry:'

# -- doctor ------------------------------------------------------------------
# Nonzero here (a minimal fixture does not satisfy every check), so assert the shape
# of the rendering rather than the verdict.
! exec magus doctor
stdout 'stale worktrees'
! exec magus doctor -o json
stdout '"checks"'
! exec magus doctor -o yaml
stdout 'checks:'

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(ctx); }
-- spells/acme/spell.buzz --
import "magus/target";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
