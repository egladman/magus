# magus agent install writes the skills into every named destination directory
exec magus agent install .claude/skills
exists .claude/skills/magus-query/SKILL.md
exists .claude/skills/magus-run/SKILL.md
exists .claude/skills/magus-vcs-hygiene/SKILL.md
exists .claude/skills/magus-architecture-review/SKILL.md
exists .claude/skills/magus-delegate-multi-agent/SKILL.md
grep 'name: magus-query' .claude/skills/magus-query/SKILL.md
grep 'name: magus-delegate-multi-agent' .claude/skills/magus-delegate-multi-agent/SKILL.md
grep 'agent-skill-version: \d' .claude/skills/magus-query/SKILL.md

# several destinations in one call; the destination is the caller's choice
exec magus agent install .opencode/skills .agents/skills
exists .opencode/skills/magus-query/SKILL.md
exists .agents/skills/magus-query/SKILL.md

# install OFFERS the AGENTS.md block on stderr and never writes the file.
# The offer is a hint, so this is the one stretch that turns hints back on.
env MAGUS_HINTS_ENABLED=true
exec magus agent install .agents/skills --force
stderr 'magus does not write AGENTS.md'
stderr 'magus:skills:begin'
! exists AGENTS.md

# an AGENTS.md that already exists is left byte-identical
cp theirs.md AGENTS.md
exec magus agent install .agents/skills --force
cmp AGENTS.md theirs.md

# once the block is pasted and current, install stops reprinting it
exec magus agent sample
cp stdout AGENTS.md
exec magus agent install .agents/skills --force
! stderr 'magus:skills:begin'
env MAGUS_HINTS_ENABLED=false

# a second skill-dir install refuses to clobber without --force
! exec magus agent install .claude/skills
stderr 'already exists'

# --force overwrites in place, and may follow the positional
exec magus agent install .claude/skills --force
exists .claude/skills/magus-query/SKILL.md

# a skill this binary no longer ships is REPORTED, not removed: pruning is opt-in,
# because install writes files it can name and a prune deletes ones the caller has
# not seen. Both copies below are stamped, so both are magus's to delete - only the
# flag decides whether it does.
mkdir .claude/skills/magus-retired
cp .claude/skills/magus-query/SKILL.md .claude/skills/magus-retired/SKILL.md
env MAGUS_HINTS_ENABLED=true
exec magus agent install .claude/skills --force
stderr 'still in place.*Remove them with --prune'
exists .claude/skills/magus-retired/SKILL.md

# a hand-authored skill carries no stamp, so it is never a candidate either way
mkdir .claude/skills/magus-local-development
cp mine.md .claude/skills/magus-local-development/SKILL.md
exec magus agent install .claude/skills --force --prune -v
stderr 'removed skill this binary no longer ships'
# nothing stale after a prune, so the hint stays silent - it is not a banner
! stderr 'Remove them with --prune'
env MAGUS_HINTS_ENABLED=false
! exists .claude/skills/magus-retired/SKILL.md
exists .claude/skills/magus-local-development/SKILL.md
cmp .claude/skills/magus-local-development/SKILL.md mine.md

# absolute destinations are refused unless --global is set; --tar is the supported
# way to install skills outside the working tree
! exec magus agent install /tmp/abs/skills
stderr 'outside the working tree'
exec magus agent install --tar
stdout 'magus-query/SKILL.md'

# no destination is an explicit error
! exec magus agent install
stderr 'destination directory'

# the hook evaluates a command from a host event and renders any dialect.
# A deny EXITS NON-ZERO as well as rendering: a host that reads only the status must
# block, and one that reads the payload gets the same verdict either way. Exiting 0 on a
# deny is what made the guard look installed while enforcing nothing.
stdin command.txt
! exec magus hook -o name
stdout 'deny'
stdin command.txt
! exec magus hook -o 'template={{if eq .decision "deny"}}{"permissionDecision":"deny","permissionDecisionReason":{{toJson .reason}}}{{end}}'
stdout 'permissionDecision'

# arguments work without stdin, and a benign command passes
stdin pass-command.txt
exec magus hook
stdout 'pass'

-- command.txt --
git stash
-- pass-command.txt --
git status
-- mine.md --
---
name: magus-local-development
description: "workspace rules I wrote myself"
---

# Local rules

magus never wrote this file and never deletes it.
-- theirs.md --
# My agents notes

keep me
