# A tool between two magus stages changes nothing: the reader follows the pipe back
# through it, from the kernel, to the magus writing into it, and waits as it would for
# an adjacent stage. The tool's own arguments are never read.
[windows] skip 'no kernel API proves the writer of an anonymous pipe'

exec bash -c 'set -o pipefail; magus run holdslow . | cat | magus run consume .'
stderr 'magus: waiting for pid [0-9]+ \(.*run holdslow'
! stderr 'locked by another magus process'
grep 'done' consumed

rm consumed
exec bash -c 'set -o pipefail; magus run holdslow . | tee copy | cat | magus run consume .'
! stderr 'locked by another magus process'
grep 'done' consumed
grep 'done' copy

# A tool that no magus feeds proves nothing: a lock held elsewhere is refused at once.
# holdslow left a ready file above; without removing it the wait below passes before
# holdgate holds the lock.
rm ready
exec magus run holdgate . &
exec bash -c 'for i in $(seq 200); do [ -f ready ] && exit 0; sleep 0.05; done; exit 1'
exec bash -c 'echo x | cat | magus run consume .; [ $? -eq 75 ]'
stderr 'locked by another magus process'
! stderr 'waiting for pid'
exec touch release
wait

-- magus.yaml --
{}
-- .gitignore --
.magus/
-- magusfile.buzz --
import "magus";
import "io";
import "fs";
import "proc";

magus\project({
    "name": "pipe-root",
    "targets": {
        "holdslow": {"skip_cache": "holds the project"},
        "holdgate": {"skip_cache": "holds the project until the script releases it"},
        "consume": {"skip_cache": "reads stdin per invocation"},
    },
});

export fun holdslow(ctx: magus\Context, args: [str]) > void !> any {
    proc\exec("sh", ["-c", "touch ready; sleep 2"]);
    io\stdout.write("done\n");
}

// holdgate holds the project until a release file appears, bounded so a stuck
// script cannot hang CI.
export fun holdgate(ctx: magus\Context, args: [str]) > void !> any {
    proc\exec("sh", ["-c", "touch ready; for i in $(seq 400); do [ -f release ] && exit 0; sleep 0.05; done"]);
}

export fun consume(ctx: magus\Context, args: [str]) > void !> any {
    fs\writeFile("consumed", io\stdin.readAll());
}
