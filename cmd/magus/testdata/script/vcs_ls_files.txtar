# `magus vcs ls-files` lists the paths a commit of this change would want, and stages
# nothing: the person stages what it lists. Each assertion that matters is on git's index
# after `git add`, not on stdout alone.

exec git init
exec git config user.email test@example.com
exec git config user.name Test
exec git checkout -b main
exec git add magus.yaml magusfile.buzz src/a.txt src/b.txt out/gen.txt libs/x/magusfile.buzz libs/x/c.txt
exec git commit -m initial

# A source edit with the output it regenerated: the source is listed, the output is held
# back, and stderr names the group and the flag that lists it.
cp src/a.new.txt src/a.txt
cp out/gen.new.txt out/gen.txt
exec magus vcs ls-files
stdout '^src/a\.txt$'
! stdout 'out/gen\.txt'
stderr 'generated'
stderr '--include-generated'

exec magus vcs ls-files --include-generated
stdout '^src/a\.txt$'
stdout '^out/gen\.txt$'

# The listing feeds git add, and only what it listed reaches the index.
exec magus vcs ls-files -o name
cp stdout list.txt
exec git add --pathspec-from-file=list.txt
exec git diff --cached --name-only
stdout '^src/a\.txt$'
! stdout 'out/gen\.txt'

# A path whose whole change is already staged leaves the listing.
exec magus vcs ls-files
! stdout 'src/a\.txt'
stderr '--include-staged'
exec magus vcs ls-files --include-staged
stdout '^src/a\.txt$'

exec git add out/gen.txt
exec git commit -m source-and-output

# An untracked file is listed only when asked, and an unclaimed one only when asked again.
cp src/a.newer.txt src/new.txt
cp src/a.newer.txt notes.txt
exec magus vcs ls-files
! stdout .
stderr '--include-untracked'
exec magus vcs ls-files --include-untracked
stdout '^src/new\.txt$'
! stdout 'notes\.txt'
stderr '--include-unclaimed'
exec magus vcs ls-files --include-untracked --include-unclaimed
stdout '^notes\.txt$'
exec git add src/new.txt notes.txt
exec git commit -m untracked

# Patterns are write-path globs read from where you stand, and they only narrow.
cp src/a.newer.txt src/a.txt
cp src/a.newer.txt src/b.txt
cp src/a.newer.txt libs/x/c.txt
exec magus vcs ls-files 'src/a*'
stdout '^src/a\.txt$'
! stdout 'src/b\.txt'
exec magus vcs ls-files --exclude src/a.txt,libs/**
stdout '^src/b\.txt$'
! stdout 'src/a\.txt'
! stdout 'libs/x/c\.txt'
exec magus vcs ls-files --project libs/x
stdout '^libs/x/c\.txt$'
! stdout '^src/'
cd src
exec magus vcs ls-files b.txt
stdout '^src/b\.txt$'
! stdout 'src/a\.txt'
cd $WORK

# A pattern matching no dirty path is said, not answered with silence.
exec magus vcs ls-files 'nothing/**'
! stdout .
stderr 'nothing/\*\* matches no dirty path'

exec git add src libs
exec git commit -m narrowed

# -o json carries the listing and what it left out; an output no source change accounts
# for carries the drift code.
cp out/gen.newer.txt out/gen.txt
exec magus vcs ls-files -o json
stdout '"files": \[\]'
stdout '"group": "unexplained"'
stdout '"flag": "--include-unexplained"'
stdout '"code": "MGS4'
exec magus vcs ls-files --include-unexplained
stdout '^out/gen\.txt$'

-- magus.yaml --
default_charms: [rw]
-- .gitignore --
.magus/
.gitignore
list.txt
*.new.txt
*.newer.txt
-- magusfile.buzz --
import "magus";
magus\project({
    "name": "acme-root",
    "sources": ["magusfile.buzz", "src/**"],
});
export fun generate(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles("out/gen.txt");
}
-- libs/x/magusfile.buzz --
import "magus";
magus\project({
    "name": "acme-x",
    "sources": ["**"],
});
-- libs/x/c.txt --
lib one
-- src/a.txt --
source one
-- src/b.txt --
b one
-- src/a.new.txt --
source two
-- src/a.newer.txt --
source three
-- out/gen.txt --
generated one
-- out/gen.new.txt --
generated two
-- out/gen.newer.txt --
generated three
