# `magus refs <symbol>` lists where an ingested code symbol is defined and
# referenced, drawn from a SCIP index (see knowledge.symbols in config). This
# fixture never declares one, so every case here exercises the "no index"
# path - which is the interesting contract: refs distinguishes "nothing
# could ever match, go build the index" from "the index exists but this
# name isn't in it", and only the first case is reachable without a real
# SCIP toolchain (scip-go et al) wired into the workspace. That second
# message ("magus refs: no node matches %q") lives in cmd/magus/refs.go but
# is not covered here for that reason.

# No index at all: the message diagnoses the cause (no index was ever
# built) rather than reporting a bare "not found", and names the remedy
# command on its own line rather than folding it into one sentence.
! exec magus refs Foo
stderr 'magus refs: no symbol index has been built, so there are no symbols to match "Foo"'
stderr 'build one with `magus graph build`'
stderr 'auto-indexer also keeps it current while `magus server start` runs'

# Missing the symbol argument entirely is a distinct, earlier error.
! exec magus refs
stderr 'magus refs: requires a symbol ID or name'

# The no-index check runs before format dispatch, so every -o value hits the
# same plain-text stderr message rather than a JSON/YAML-shaped error.
! exec magus refs Foo -o json
stderr 'magus refs: no symbol index has been built'
! exec magus refs Foo -o yaml
stderr 'magus refs: no symbol index has been built'
! exec magus refs Foo -o name
stderr 'magus refs: no symbol index has been built'

# Nothing is printed to stdout on this path - the whole finding is on stderr.
! exec magus refs Foo
! stdout .

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(ctx); }
-- spells/acme/spell.buzz --
import "magus/target";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
