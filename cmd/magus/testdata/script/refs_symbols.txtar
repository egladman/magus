# `magus refs <symbol>` lists where an ingested code symbol is defined and
# referenced, drawn from a SCIP index (see knowledge.symbols in config).
#
# This fixture's only spell (acme) exposes no `scip` op, so the workspace
# declares NO symbol index. That is the case this file pins, and the reason it
# is interesting: an unmatched name here is a VERIFIED absence. There is no
# code-symbol layer to have missed, so magus asserts that positively rather
# than leaving the reader to wonder whether it simply could not look.
#
# The other verdict - "unknown", where a project declares an index that was
# never built - needs a real SCIP toolchain (scip-go et al) wired into the
# workspace, so it is covered by the unit tests in cmd/magus and
# internal/handler/mcp instead.

# The verdict is stated, not implied by an empty result. Exit 2, because the
# request cannot be carried out as stated: the name names nothing, and magus
# verified that rather than guessing it.
! exec magus refs Foo
stderr 'magus refs: no node matches "Foo"'
stderr 'verdict: absent \(magus searched everything it could reach, so this is not there\)'

# Exit 2, not 1: the name named nothing and magus verified that, so the request cannot be
# carried out as stated. An unknown verdict would be exit 1 instead.

# An absent verdict must NOT suggest building an index. Nothing is missing, so
# the remedy would send the reader somewhere with nothing to fix.
! stderr 'graph build'
! stderr 'outside coverage'

# Missing the symbol argument entirely is a distinct, earlier error.
! exec magus refs
stderr 'magus refs: requires a symbol ID or name'

# The verdict is decided before format dispatch, so every -o value hits the
# same plain-text stderr message rather than a JSON/YAML-shaped error.
! exec magus refs Foo -o json
stderr 'verdict: absent'
! exec magus refs Foo -o yaml
stderr 'verdict: absent'
! exec magus refs Foo -o name
stderr 'verdict: absent'

# Nothing is printed to stdout on this path - the whole finding is on stderr.
! exec magus refs Foo
! stdout .

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(ctx); }
-- spells/acme/spell.buzz --
import "magus/spell";
export fun mgs_getName() > str { return "acme"; }
fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
