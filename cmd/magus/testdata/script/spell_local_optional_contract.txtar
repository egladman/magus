# A workspace-local Buzz spell must get the FULL optional contract, not just the two
# hooks a minimal load needs.
#
# It did not. loadBuzzSpell built the spell without WithVersionProbe, WithLanguage or
# WithOpaque, so a descriptor that carried mgs_getTools, mgs_getLanguage and
# mgs_isOpaque faithfully had all three dropped on the floor. The consequences were
# silent and unequal: a declared version probe never ran and never entered the cache
# key, so a local spell's toolchain could drift with nothing invalidating; the spell
# reported no language; and an opaque spell was treated as transparent.
#
# Built-in spells were unaffected - they are constructed on a different path that
# already wired all of it - which is exactly why nothing caught this. Hence a fixture
# spell here rather than relying on the built-ins.

# mgs_getName and mgs_listTargets always worked; they are the baseline.
exec magus describe spells acme
stdout 'acme'
stdout 'targets: lint'

# mgs_isOpaque, mgs_getLanguage, mgs_getTools: the three that were lost.
exec magus describe spells acme -o json
stdout '"opaque": true'
stdout '"language": "acme-lang"'
stdout '"version_probe": true'

# version_probe true is only a claim that a probe EXISTS. --versions runs it, which is
# the half that debugs a drifted toolchain, and reports the cache-key fragment the
# value produces - the thing that decides whether a target replays.
exec magus describe spells acme --versions
stdout 'versions \(probed just now, never cached\)'
stdout 'acme-probe-ok'
stdout 'key: spell:acme:version=acme-probe-ok'

# On the model, so every format carries it. An agent reading -o json needs it most.
exec magus describe spells acme --versions -o json
stdout '"tool": "acme"'
stdout '"version": "acme-probe-ok"'
stdout '"cache_key": "spell:acme:version=acme-probe-ok"'

-- magus.yaml --
concurrency: 2
-- magusfile.buzz --
import "magus";
import "spells/acme" as acme;
magus.project({ "spells": [acme] });
export fun lint(ctx: magus\Context, args: [str]) > void { acme.lint(ctx); }
-- spells/acme/spell.buzz --
import "magus/spell";
export fun mgs_getName() > str { return "acme"; }

// A deterministic stand-in for a real toolchain probe: `echo` exists everywhere and
// its output is fixed, so this asserts magus's plumbing rather than whatever versions
// happen to be installed on the machine running the test.
export fun mgs_getTools() > {str: Tool} {
    return {"acme": Tool{probe = Command{bin = "echo", args = ["acme-probe-ok"]}}};
}
export fun mgs_getLanguage() > Language { return Language{name = "acme-lang"}; }
export fun mgs_isOpaque() > bool { return true; }

fun lint(target: Target) > Command {
    return Command{bin = "acme", args = ["lint", "."]};
}
export fun mgs_listTargets() > {str: fun(Target) Command} { return {"lint": lint}; }
