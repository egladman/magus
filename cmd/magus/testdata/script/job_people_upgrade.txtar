# A dependency upgrade split one job per project, each checked by that project's own
# test, taken by two people in two worktrees and verified one job at a time.
# docs/guides/jobs/other-work.md shows these commands and every golden below verbatim
# (TestJobGuideMatchesItsScripts holds it to that).
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
env GIT_AUTHOR_NAME=Ana
env GIT_AUTHOR_EMAIL=ana@example.com
env GIT_COMMITTER_NAME=Ana
env GIT_COMMITTER_EMAIL=ana@example.com
env GIT_AUTHOR_DATE=2026-10-01T09:00:00Z
env GIT_COMMITTER_DATE=2026-10-01T09:00:00Z
cd shop
exec git init -q -b main
exec git add -A
exec git commit -q -m 'pin left-pad 1.2 everywhere'

stdin $WORK/plan.jsonl
exec magus job apply --stdin
cmp stdout $WORK/apply.out
exec git worktree add -q ../ana
exec git worktree add -q ../ben

cd ../ana
exec magus job exec upgrade/api
cd ../ben
exec magus job exec upgrade/web
exec magus ls jobs -o template='{{range .jobs}}{{.id}}  {{.checkout_root}}{{"\n"}}{{end}}'
cp stdout $WORK/raw
exec sh -c 'sed -e "s|$WORK|~/src|g" "$WORK/raw"'
cmp stdout $WORK/holders.out

cd ../ana
cp $WORK/deps-1.3.txt api/deps.txt
exec git commit -q -am 'bump left-pad to 1.3 in api'
exec sh -c 'ref=$(magus run test api -o jsonl | sed -n "s/.*\"ref\":\"\(out[0-9a-f]*\)\".*/\1/p") && sed -e "s/out<hex>/$ref/" "$WORK/api.json" > "$WORK/filed.json"'
stdin $WORK/filed.json
exec magus job exit upgrade/api --stdin
cd ../ben
cp $WORK/deps-1.3.txt web/deps.txt
exec git commit -q -am 'bump left-pad to 1.3 in web'
exec sh -c 'ref=$(magus run test web -o jsonl | sed -n "s/.*\"ref\":\"\(out[0-9a-f]*\)\".*/\1/p") && sed -e "s/out<hex>/$ref/" "$WORK/web.json" > "$WORK/filed.json"'
stdin $WORK/filed.json
exec magus job exit upgrade/web --stdin

cd ../shop
exec magus job wait upgrade/api
cp stdout $WORK/raw
exec sh -c 'sed -e "s/out[0-9a-f]\{12\}/out<hex>/g" "$WORK/raw"'
cmp stdout $WORK/wait-api.out
exec magus job wait upgrade/web
exec magus ls jobs --all
cp stdout $WORK/raw
exec sh -c 'sed -e "s|$WORK|~/src|g" "$WORK/raw"'
cmp stdout $WORK/ls-done.out

-- shop/.gitignore --
.magus/
-- shop/magus.yaml --
concurrency: 2
-- shop/api/magusfile.buzz --
import "magus";
import "proc";

// test checks the pinned left-pad version.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["deps.txt"]);
    proc\exec("grep", ["-q", "^left-pad ", "deps.txt"]);
}
-- shop/api/deps.txt --
left-pad 1.2
-- shop/web/magusfile.buzz --
import "magus";
import "proc";

// test checks the pinned left-pad version.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["deps.txt"]);
    proc\exec("grep", ["-q", "^left-pad ", "deps.txt"]);
}
-- shop/web/deps.txt --
left-pad 1.2
-- deps-1.3.txt --
left-pad 1.3
-- plan.jsonl --
{"api_version": "magus.job/v1alpha1", "id": "upgrade/api", "agent": {"instructions": "api runs left-pad 1.3", "worker": {"type": "resumed"}}, "write_paths": ["api/deps.txt"], "check": {"target": "test", "project": "api"}}
{"api_version": "magus.job/v1alpha1", "id": "upgrade/web", "agent": {"instructions": "web runs left-pad 1.3", "worker": {"type": "resumed"}}, "write_paths": ["web/deps.txt"], "check": {"target": "test", "project": "web"}}
-- api.json --
{"api_version": "magus.job-result/v1alpha1", "changed_paths": ["api/deps.txt"], "validation": {"command": "magus run test api", "output_ref": "out<hex>"}, "unresolved_risks": []}
-- web.json --
{"api_version": "magus.job-result/v1alpha1", "changed_paths": ["web/deps.txt"], "validation": {"command": "magus run test web", "output_ref": "out<hex>"}, "unresolved_risks": []}
-- apply.out --
created upgrade/api, declared, with 1 write path(s)
model tier: bounded (rank 1), default: "the declared default" at magus/modeltiers
created upgrade/web, declared, with 1 write path(s)
model tier: bounded (rank 1), default: "the declared default" at magus/modeltiers
-- holders.out --
upgrade/api  ~/src/ana
upgrade/web  ~/src/ben
-- wait-api.out --
verified upgrade/api, recorded pass
its holder reports it ran magus run test api
goal check: verified (out<hex>)
footprint: where its diff since the checkpoint landed
  api/deps.txt:1-1
-- ls-done.out --
JOB          HOLDER  STATE  MODEL    PATHS  PROOF     CHECK
upgrade/api  ana     pass   bounded  1      alone     magus run test api
upgrade/web  ben     pass   bounded  1      disjoint  magus run test web

not merged onto main: 2
  upgrade/api at 4482968: 1 commit(s) at 4482968 are not on main; merge 4482968 into main, or state why it stays off: `magus job apply --stdin` with {"api_version":"magus.job/v1alpha1","id":"upgrade/api","left_unmerged":"<why>"}
  upgrade/web at c2385b8: 1 commit(s) at c2385b8 are not on main; merge c2385b8 into main, or state why it stays off: `magus job apply --stdin` with {"api_version":"magus.job/v1alpha1","id":"upgrade/web","left_unmerged":"<why>"}
in flight: never fetched; `magus queue ls --provider <provider> --base <branch>` reads the open changes
