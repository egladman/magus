# A read-only job declaring no check or goal passes on the result its holder files, unless
# that result names an unresolved risk: then the row stays exited for the root to read.
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/home/state
env GIT_AUTHOR_NAME=Ana
env GIT_AUTHOR_EMAIL=ana@example.com
env GIT_COMMITTER_NAME=Ana
env GIT_COMMITTER_EMAIL=ana@example.com
cd shop
exec git init -q -b main
exec git add -A
exec git commit -q -m 'shop'

exec sh -c 'ref=$(magus buzz --record probes/pricing.buzz 2>&1 >/dev/null | sed -n "s/^ref  \(out[0-9a-f]*\)$/\1/p") && sed "s/out<hex>/$ref/" "$WORK/risky.in.json" > "$WORK/risky.json" && sed "s/out<hex>/$ref/" "$WORK/clean.in.json" > "$WORK/clean.json"'

exec magus job fork scout/risky --read-only --criteria 'run the gate'
exec magus job exec scout/risky
stdin $WORK/risky.json
exec magus job exit scout/risky --stdin
stdout '^exited scout/risky, recorded exited'
! stdout 'returned:'
exec magus ls jobs
stdout 'scout/risky .*exited'

exec magus job fork scout/clean --read-only --criteria 'list the tax rules'
exec magus job exec scout/clean
stdin $WORK/clean.json
exec magus job exit scout/clean --stdin
stdout '^exited scout/clean, recorded pass: returned: its holder filed a result'

-- risky.in.json --
{"schema_version": 2, "job": "scout/risky",
 "changed_paths": [],
 "validation": {"command": "magus buzz --record probes/pricing.buzz", "output_ref": "out<hex>"},
 "unresolved_risks": ["gate FAILED, exited 75"]}
-- clean.in.json --
{"schema_version": 2, "job": "scout/clean",
 "changed_paths": [],
 "validation": {"command": "magus buzz --record probes/pricing.buzz", "output_ref": "out<hex>"},
 "unresolved_risks": []}
-- shop/.gitignore --
.magus/
-- shop/magus.yaml --
concurrency: 2
-- shop/magusfile.buzz --
import "magus";

export fun test(ctx: magus\Context, args: [str]) > void !> any {
}
-- shop/pricing/total.sh --
total() { echo $(( $1 + $2 )); }
-- shop/probes/pricing.buzz --
import "std";

fun main(args: [str]) > void !> any {
    std\print("ok");
}
