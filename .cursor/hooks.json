{
  "hooks": {
    "beforeMCPExecution": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz -- --agent-name cursor --reports-skills",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz -- --agent-name cursor --reports-skills",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz -- --agent-name cursor --reports-skills",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz -- --agent-name cursor --reports-skills",
        "matcher": "Shell|Write|StrReplace|Delete|Edit|NotebookEdit|Grep|Glob|Read|WebSearch|WebFetch|MCP:.*",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz -- --agent-name cursor --reports-skills",
        "matcher": "Shell|Write|StrReplace|Delete|Edit|NotebookEdit|Grep|Glob|Read|WebSearch|WebFetch|MCP:.*",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz -- --agent-name cursor --reports-skills",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz -- --agent-name cursor --reports-skills",
        "matcher": "Shell|Write|StrReplace|Delete|Edit|NotebookEdit|Grep|Glob|Read|Task",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz -- --agent-name cursor --reports-skills",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz -- --agent-name cursor --reports-skills",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/proofread-reply.buzz -- --agent-name cursor",
        "loop_limit": 1,
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz -- --agent-name cursor --reports-skills",
        "timeout": 10
      }
    ]
  },
  "version": 1
}
