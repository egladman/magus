test "list keeps auto-merge pull requests against the base and drops drafts and plain ones" {
    final got = changesFrom([`[
        {"number": 7, "draft": false, "auto_merge": {"merge_method": "squash"}, "title": "add x",
         "user": {"login": "priya"}, "base": {"ref": "main"},
         "head": {"sha": "abc", "ref": "feat", "repo": {"full_name": "acme/acme"}}},
        {"number": 8, "draft": false, "auto_merge": null, "title": "plain",
         "user": {"login": "eli"}, "base": {"ref": "main"},
         "head": {"sha": "def", "ref": "other", "repo": {"full_name": "acme/acme"}}},
        {"number": 9, "draft": true, "auto_merge": {"merge_method": "merge"}, "title": "draft",
         "user": {"login": "eli"}, "base": {"ref": "main"},
         "head": {"sha": "fed", "ref": "wip", "repo": {"full_name": "acme/acme"}}},
        {"number": 10, "draft": false, "auto_merge": {"merge_method": "merge"}, "title": "elsewhere",
         "user": {"login": "eli"}, "base": {"ref": "release"},
         "head": {"sha": "0de", "ref": "rel", "repo": {"full_name": "acme/acme"}}}
    ]`], repo: "acme/acme", base: "main", stacks: {<str: str>}, labeled: {<str: str>}).value!;
    assert\equal(got.len(), want: 1, message: "only the auto-merge pull request against main is queued");
    final one = serialize\Boxed.init(got[0]);
    assert\equal(one.q("id").stringValue(), want: "7", message: "id is the number as a string");
    assert\equal(one.q("head").stringValue(), want: "abc", message: "head sha");
    assert\equal(one.q("ref").stringValue(), want: "refs/pull/7/head", message: "a fetchable ref");
    assert\equal(one.q("branch").stringValue(), want: "feat", message: "a same-repository branch can take a push");
    assert\equal(one.q("fork").booleanValue(), want: false, message: "fork is always said");
    assert\equal(one.q("method").stringValue(), want: "squash", message: "the method chosen with auto-merge");
    assert\equal(one.q("parent").stringValue(), want: "", message: "not a stack member");
    assert\equal(one.q("author").stringValue(), want: "priya", message: "the author's login");
}

test "a fork is listed as one, with no branch to push to" {
    final got = changesFrom([`[{"number": 3, "draft": false, "auto_merge": {"merge_method": "squash"},
        "title": "t", "user": {"login": "x"}, "base": {"ref": "main"},
        "head": {"sha": "abc", "ref": "feat", "repo": {"full_name": "x/acme"}}}]`], repo: "acme/acme", base: "main", stacks: {<str: str>}, labeled: {<str: str>}).value!;
    final one = serialize\Boxed.init(got[0]);
    assert\equal(one.q("branch").stringValue(), want: "", message: "the queue cannot push to a fork");
    assert\equal(one.q("fork").booleanValue(), want: true, message: "so the queue can refuse it by name");
}

// GitHub will not take auto-merge on a pull request it says conflicts; the label queues
// it anyway, and the queue settles the conflict or kicks it back.
final SINGLES = `[
    {"number": 40, "draft": false, "auto_merge": null, "title": "conflicting", "mergeable": false, "mergeable_state": "dirty",
     "base": {"ref": "main"}, "labels": [{"name": "merge-queue: rebase"}],
     "head": {"sha": "a40", "ref": "c", "repo": {"full_name": "acme/acme"}}},
    {"number": 41, "draft": false, "auto_merge": {"merge_method": "squash"}, "title": "both",
     "base": {"ref": "main"}, "labels": [{"name": "merge-queue: merge"}],
     "head": {"sha": "a41", "ref": "b", "repo": {"full_name": "acme/acme"}}},
    {"number": 42, "draft": false, "auto_merge": null, "title": "elsewhere",
     "base": {"ref": "release"}, "labels": [{"name": "merge-queue: squash"}],
     "head": {"sha": "a42", "ref": "e", "repo": {"full_name": "acme/acme"}}},
    {"number": 43, "draft": false, "auto_merge": null, "title": "kicked",
     "base": {"ref": "main"}, "labels": [{"name": "queue: kicked back"}],
     "head": {"sha": "a43", "ref": "k", "repo": {"full_name": "acme/acme"}}}
]`;

test "a queue label on a pull request outside a stack queues it whatever GitHub says of its mergeability" {
    final singles = labeledSingles([SINGLES], base: "main").value!;
    assert\equal(singles.len(), want: 1, message: "auto-merge wins over a label, another base is not this queue's, and a mark is no intent");
    assert\equal(singles[0], want: {"number": "40", "label": "merge-queue: rebase", "method": "rebase"}, message: "the label's method");
    final got = changesFrom([SINGLES], repo: "acme/acme", base: "main", stacks: {<str: str>}, labeled: {"40": "rebase"}).value!;
    assert\equal(got.len(), want: 2, message: "the labeled one and the auto-merge one");
    final one = serialize\Boxed.init(got[0]);
    assert\equal([one.q("id").stringValue(), one.q("method").stringValue(), one.q("parent").stringValue()], want: ["40", "rebase", ""], message: "queued alone with its label's method");
    assert\equal(serialize\Boxed.init(got[1]).q("method").stringValue(), want: "squash", message: "auto-merge's method");
    assert\equal(changesFrom([SINGLES], repo: "acme/acme", base: "main", stacks: {<str: str>}, labeled: {<str: str>}).value!.len(), want: 1,
        message: "a label nobody with write access applied queues nothing");
    final target = targetFrom(`{"base": {"ref": "main"}, "auto_merge": null, "labels": [{"name": "merge-queue: merge"}]}`, method: "squash").value!;
    assert\equal(target["method"], want: "merge", message: "the label as it stands at the re-check");
    assert\equal(intent(`{"auto_merge": null, "labels": [{"name": "merge-queue: merge"}]}`, repo: "acme/acme", hdrs: {<str: str>}).value!, want: true, message: "the label is its intent");
    assert\equal(intent(`{"auto_merge": null, "labels": [{"name": "queue: kicked back"}]}`, repo: "acme/acme", hdrs: {<str: str>}).value!, want: false, message: "a mark is not");
    assert\equal(requeueLine("40", method: "rebase", fork: false, label: "merge-queue: rebase", top: "40"),
        want: "Queue it again once fixed: `gh pr edit 40 --add-label \"merge-queue: rebase\"`", message: "by its own label");
}

final STACK = `[
    {"number": 20, "draft": false, "auto_merge": null, "title": "bottom", "user": {"login": "ann"},
     "base": {"ref": "main"}, "labels": [],
     "stack": {"id": 5, "position": 1, "size": 2, "base": {"ref": "main", "sha": "b"}},
     "head": {"sha": "a20", "ref": "s1", "repo": {"full_name": "acme/acme"}}},
    {"number": 21, "draft": false, "auto_merge": null, "title": "top", "user": {"login": "ann"},
     "base": {"ref": "s1"}, "labels": [{"name": "merge-queue: Squash"}, {"name": "merge-queue: squash"}],
     "stack": {"id": 5, "position": 2, "size": 2, "base": {"ref": "main", "sha": "b"}},
     "head": {"sha": "a21", "ref": "s2", "repo": {"full_name": "acme/acme"}}},
    {"number": 22, "draft": true, "auto_merge": null, "title": "draft", "user": {"login": "bo"},
     "base": {"ref": "main"}, "labels": [],
     "head": {"sha": "a22", "ref": "d", "repo": {"full_name": "acme/acme"}}}
]`;

test "a labeled stack top queues the stack, each member naming the one below" {
    final tops = stackTops([STACK], base: "main").value!;
    assert\equal(tops.len(), want: 1, message: "one labeled top");
    assert\equal(tops[0]["number"], want: "21", message: "the top");
    assert\equal(tops[0]["method"], want: "squash", message: "the label's method");
    assert\equal(tops[0]["label"], want: "merge-queue: squash", message: "only a method's exact name is intent");
    assert\equal(stackTops([STACK], base: "release").value!.len(), want: 0, message: "a stack on another trunk is not this queue's");
    final got = changesFrom([STACK], repo: "acme/acme", base: "main", stacks: {"5": "squash"}, labeled: {<str: str>}).value!;
    assert\equal(got.len(), want: 2, message: "both members");
    assert\equal(serialize\Boxed.init(got[0]).q("parent").stringValue(), want: "", message: "the bottom sits on the trunk");
    assert\equal(serialize\Boxed.init(got[1]).q("parent").stringValue(), want: "20", message: "the top names the bottom");
    assert\equal(serialize\Boxed.init(got[1]).q("base").stringValue(), want: "main", message: "a member merges on the stack's base");
    assert\equal(changesFrom([STACK], repo: "acme/acme", base: "main", stacks: {<str: str>}, labeled: {<str: str>}).value!.len(), want: 0, message: "an unlabeled stack is not queued");
    final top = stackTopIn([STACK], sid: "5").value!;
    assert\equal(top["number"], want: "21", message: "a member finds its stack's top");
    assert\equal(top["label"], want: "merge-queue: squash", message: "and the label that queues it");
}

test "every open pull request the listing leaves out is unqueued" {
    final queued = changesFrom([STACK], repo: "acme/acme", base: "main", stacks: {"5": "squash"}, labeled: {<str: str>}).value!;
    final got = unqueuedFrom([STACK], repo: "acme/acme", queued: queued).value!;
    assert\equal(got.len(), want: 1, message: "the draft");
    final one = serialize\Boxed.init(got[0]);
    assert\equal(one.q("id").stringValue(), want: "22", message: "by id");
    assert\equal(one.q("head").stringValue(), want: "a22", message: "and head");
    assert\equal(one.q("repo").stringValue(), want: "acme/acme", message: "and the repository a mark is cleared in");
    assert\equal(one.q("mark").stringValue(), want: "", message: "showing no mark");
    assert\equal(one.q("title").stringValue(), want: "draft", message: "and what a person reads it by");
    assert\equal(one.q("author").stringValue(), want: "bo", message: "who opened it");
    assert\equal(one.q("branch").stringValue(), want: "d", message: "the branch a job's checkout joins it by");
    assert\equal(one.q("base").stringValue(), want: "main", message: "and the branch it targets");
}

final MARKED = `[
    {"number": 30, "draft": false, "auto_merge": null, "title": "left", "user": {"login": "ann"},
     "base": {"ref": "main"}, "labels": [{"name": "bug"}, {"name": "queue: queued"}],
     "stack": {"id": 6, "position": 1, "size": 1, "base": {"ref": "main", "sha": "b"}},
     "head": {"sha": "a30", "ref": "l", "repo": {"full_name": "acme/acme"}}},
    {"number": 31, "draft": false, "auto_merge": null, "title": "kicked", "user": {"login": "ann"},
     "base": {"ref": "main"}, "labels": [{"name": "queue: kicked back"}],
     "head": {"sha": "a31", "ref": "k", "repo": {"full_name": "acme/acme"}}},
    {"number": 32, "draft": false, "auto_merge": null, "title": "generator", "user": {"login": "ann"},
     "base": {"ref": "main"}, "labels": [{"name": "queue: needs regeneration"}],
     "stack": {"id": 7, "position": 1, "size": 1, "base": {"ref": "main", "sha": "b"}},
     "head": {"sha": "a32", "ref": "g", "repo": {"full_name": "acme/acme"}}}
]`;

test "an unqueued pull request carries the mark its labels show" {
    final got = unqueuedFrom([MARKED], repo: "acme/acme", queued: [<any>]).value!;
    assert\equal(serialize\Boxed.init(got[0]).q("mark").stringValue(), want: "queued", message: "a queued mark left behind");
    assert\equal(serialize\Boxed.init(got[1]).q("mark").stringValue(), want: "kicked_back", message: "a kick-back's mark");
    assert\equal(serialize\Boxed.init(got[2]).q("mark").stringValue(), want: "needs_regeneration", message: "a generator change's mark");
}

test "the provider never reads its own mark labels as merge intent" {
    foreach (m in MARKS) {
        final label = MARK_LABELS[m] ?? "";
        assert\equal(label.startsWith("queue: ") and !label.startsWith(QUEUE_LABEL), want: true, message: "{m}'s label is the queue's, not a person's");
    }
    assert\equal(stackTops([MARKED], base: "main").value!.len(), want: 0, message: "a stack top showing a mark is not queued by it");
    assert\equal(changesFrom([MARKED], repo: "acme/acme", base: "main", stacks: {<str: str>}, labeled: {<str: str>}).value!.len(), want: 0, message: "nothing is queued");
}

fun opsText(ops: [{str: str}]) > str {
    final parts = mut [<str>];
    foreach (o in ops) {
        parts.append("{o["op"] ?? ""} {o["label"] ?? ""}");
    }
    return parts.join("; ");
}

test "a mark adds its own label and removes every other mark's, and nothing already right" {
    assert\equal(opsText(markOps([<str>], want: "queued")), want: "add queue: queued", message: "queued from nothing");
    assert\equal(opsText(markOps(["bug", "queue: queued"], want: "queued")), want: "", message: "already queued takes no write");
    assert\equal(opsText(markOps(["queue: queued"], want: "kicked_back")), want: "remove queue: queued; add queue: kicked back", message: "a kick-back swaps them");
    assert\equal(opsText(markOps(["queue: kicked back"], want: "queued")), want: "add queue: queued; remove queue: kicked back", message: "queued again swaps them back");
    assert\equal(opsText(markOps(["queue: queued", "queue: kicked back"], want: "needs_regeneration")),
        want: "remove queue: queued; remove queue: kicked back; add queue: needs regeneration", message: "one status at a time");
    assert\equal(opsText(markOps(["queue: queued", "queue: kicked back", "queue: needs regeneration", "merge-queue: squash", "bug"], want: "")),
        want: "remove queue: queued; remove queue: kicked back; remove queue: needs regeneration; remove merge-queue: squash",
        message: "none clears every status and the intent label, and keeps the rest");
    assert\equal(opsText(markOps(["bug"], want: "")), want: "", message: "none on nothing takes no write");
    assert\equal(opsText(markOps(["merge-queue: squash"], want: "queued")), want: "add queue: queued", message: "a status leaves the intent label alone");
}

test "the closed pull requests still showing a queue label are one search, read into records apply unlabels" {
    assert\equal(closedQuery("o/r"), want: "repo:o/r is:pr is:closed label:\"queue: queued\",\"queue: kicked back\",\"queue: needs regeneration\","
        + "\"merge-queue: merge\",\"merge-queue: squash\",\"merge-queue: rebase\"", message: "every status and intent label, any of them");
    final got = closedFrom([`{"total_count": 2, "items": [{"number": 41, "state": "closed"}, {"number": 42, "state": "closed"}]}`, `{"items": []}`], repo: "o/r").value!;
    assert\equal(got.len(), want: 2, message: "every item on every page");
    assert\equal(serialize\Boxed.init(got[1]).q("id").stringValue(), want: "42", message: "by number");
    assert\equal(serialize\Boxed.init(got[1]).q("repo").stringValue(), want: "o/r", message: "in the repository a mark is cleared in");
}

test "a mark's label is created with a short description GitHub accepts" {
    foreach (m in MARKS) {
        final description = MARK_DESCRIPTIONS[m] ?? "";
        assert\equal(description != "" and description.len() <= 100, want: true, message: "{m}'s description");
        assert\equal((MARK_COLORS[m] ?? "").len(), want: 6, message: "{m}'s color");
    }
}

fun labelRefusal(status: int, body: str) > str {
    final created = labelCreated("queue: kicked back", status: status, body: body);
    return created.error?.message ?? "";
}

test "creating a label the repository has succeeds, and any other refusal names GitHub's reason" {
    assert\equal(labelRefusal(201, body: `{}`), want: "", message: "created");
    assert\equal(labelRefusal(422, body: `{"message": "Validation Failed", "errors": [{"resource": "Label", "code": "already_exists", "field": "name"}]}`),
        want: "", message: "already there");
    assert\equal(labelRefusal(422, body: `{"message": "Validation Failed", "errors": [{"resource": "Label", "code": "invalid", "field": "description"}]}`),
        want: "github: create the label 'queue: kicked back': HTTP 422: Validation Failed (description invalid)", message: "a description too long");
    assert\equal(labelRefusal(422, body: `{"message": "Validation Failed", "errors": [{"code": "already_exists", "field": "name"}, {"code": "custom", "message": "description is too long"}]}`),
        want: "github: create the label 'queue: kicked back': HTTP 422: Validation Failed (name already_exists; description is too long)",
        message: "existing does not excuse an invalid one");
    assert\equal(labelRefusal(403, body: "forbidden"), want: "github: create the label 'queue: kicked back': HTTP 403: forbidden", message: "no permission");
}

test "the labeler is the last actor to apply the label" {
    final body = `[
        {"event": "labeled", "label": {"name": "merge-queue: squash"}, "actor": {"login": "triager"}},
        {"event": "commented", "actor": {"login": "x"}},
        {"event": "labeled", "label": {"name": "merge-queue: squash"}, "actor": {"login": "maint"}},
        {"event": "labeled", "label": {"name": "bug"}, "actor": {"login": "other"}}
    ]`;
    assert\equal(labelerFrom(body, label: "merge-queue: squash").value!, want: "maint", message: "latest application wins");
}

test "merged changes are the ones merged into the base at a head the change carries" {
    final body = `{"data": {"repository": {"pullRequest": {"commits": {
        "pageInfo": {"hasNextPage": true, "endCursor": "c2"},
        "nodes": [
        {"commit": {"oid": "h4", "associatedPullRequests": {"pageInfo": {"hasNextPage": false}, "nodes": [
            {"number": 4, "state": "MERGED", "baseRefName": "main", "headRefOid": "h4", "mergeCommit": {"oid": "m4", "parents": {"totalCount": 1}}},
            {"number": 9, "state": "OPEN", "baseRefName": "main", "headRefOid": "h4", "mergeCommit": null}]}}},
        {"commit": {"oid": "h5", "associatedPullRequests": {"pageInfo": {"hasNextPage": false}, "nodes": [
            {"number": 5, "state": "MERGED", "baseRefName": "main", "headRefOid": "h5", "mergeCommit": {"oid": "m5", "parents": {"totalCount": 2}}},
            {"number": 6, "state": "MERGED", "baseRefName": "release", "headRefOid": "h5", "mergeCommit": {"oid": "m6", "parents": {"totalCount": 1}}},
            {"number": 7, "state": "MERGED", "baseRefName": "main", "headRefOid": "later", "mergeCommit": {"oid": "m7", "parents": {"totalCount": 1}}}]}}}
    ]}}}}}`;
    final merged = mergedFrom(body, base: "main").value!;
    assert\equal(merged.len(), want: 2, message: "an open one, one merged elsewhere and one merged at another head are not");
    final four = serialize\Boxed.init(merged[0]);
    final five = serialize\Boxed.init(merged[1]);
    assert\equal(four.q("method").stringValue(), want: "squash", message: "one parent");
    assert\equal(five.q("method").stringValue(), want: "merge", message: "two parents");
    assert\equal(five.q("commit").stringValue(), want: "m5", message: "the commit on the base");
    assert\equal(nextPage(body).value!, want: "c2", message: "and where the next page starts");
}

test "an approval counts only at the commit asked about" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "new", "reviewDecision": "APPROVED",
        "reviews": {"nodes": [{"state": "APPROVED", "submittedAt": "2026-01-01T00:00:00Z", "authorCanPushToRepository": true, "author": {"login": "a"}, "commit": {"oid": "old"}}]}}}}}`;
    assert\equal(approvalFrom([body],commit: "old", required: 1).value!["approved"], want: true, message: "approved at old");
    final atNew = approvalFrom([body],commit: "new", required: 1).value!;
    assert\equal(atNew["approved"], want: false, message: "not approved at a commit nobody reviewed");
    assert\equal(atNew["head"], want: "new", message: "the current head rides along");
    assert\equal(atNew["reason"], want: "0 of 1 approvals at this commit", message: "says why");
    assert\equal(atNew["approvedCommit"], want: "old", message: "names the commit the approvals stand at");
}

test "the commit approvals carry over from is the one approved most recently" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "new", "reviewDecision": "APPROVED",
        "reviews": {"nodes": [
            {"state": "APPROVED", "submittedAt": "2026-01-03T00:00:00Z", "authorCanPushToRepository": true, "author": {"login": "b"}, "commit": {"oid": "second"}},
            {"state": "APPROVED", "submittedAt": "2026-01-01T00:00:00Z", "authorCanPushToRepository": true, "author": {"login": "a"}, "commit": {"oid": "first"}},
            {"state": "APPROVED", "submittedAt": "2026-01-02T00:00:00Z", "authorCanPushToRepository": true, "author": {"login": "c"}, "commit": {"oid": "first"}}
        ]}}}}}`;
    assert\equal(approvalFrom([body],commit: "new", required: 1).value!["approvedCommit"], want: "second", message: "whatever order the reviewers come in");
    assert\equal(approvalFrom([body],commit: "new", required: 2).value!["approvedCommit"], want: "first", message: "among the commits holding enough");
}

test "a reviewer's latest decisive review wins, and changes requested blocks" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": "CHANGES_REQUESTED",
        "reviews": {"nodes": [
            {"state": "APPROVED", "authorCanPushToRepository": true, "author": {"login": "a"}, "commit": {"oid": "abc"}},
            {"state": "COMMENTED", "authorCanPushToRepository": true, "author": {"login": "a"}, "commit": {"oid": "abc"}},
            {"state": "CHANGES_REQUESTED", "authorCanPushToRepository": true, "author": {"login": "b"}, "commit": {"oid": "abc"}}
        ]}}}}}`;
    final got = approvalFrom([body],commit: "abc", required: 1).value!;
    assert\equal(got["approved"], want: false, message: "changes requested blocks");
    assert\equal(got["reason"], want: "changes requested", message: "a comment does not undo an approval, and says why not");
    assert\equal(got["approvedCommit"], want: "", message: "nothing carries over past a change request");
}

test "only a reviewer who can push counts, whatever reviewDecision says" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": "APPROVED",
        "reviews": {"nodes": [
            {"state": "APPROVED", "submittedAt": "2026-01-02T00:00:00Z", "authorCanPushToRepository": false, "author": {"login": "drive-by"}, "commit": {"oid": "abc"}},
            {"state": "APPROVED", "submittedAt": "2026-01-02T00:00:00Z", "author": {"login": "unsaid"}, "commit": {"oid": "abc"}},
            {"state": "APPROVED", "submittedAt": "2026-01-02T00:00:00Z", "authorCanPushToRepository": true, "author": null, "commit": {"oid": "abc"}},
            {"state": "APPROVED", "submittedAt": "2026-01-01T00:00:00Z", "authorCanPushToRepository": true, "author": {"login": "writer"}, "commit": {"oid": "old"}}
        ]}}}}}`;
    final got = approvalFrom([body],commit: "abc", required: 1).value!;
    assert\equal(got["approved"], want: false, message: "a stale APPROVED decision and approvals from accounts that cannot push approve nothing");
    assert\equal(got["reason"], want: "0 of 1 approvals at this commit", message: "counts the writer's review only, at the commit it covers");
    assert\equal(got["approvedCommit"], want: "old", message: "the writer's approval still stands where it was given");
}

test "reviews lists the approvals approval_at counts, with the id a dismissal takes" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": "APPROVED",
        "reviews": {"nodes": [
            {"databaseId": 11, "state": "APPROVED", "authorCanPushToRepository": false, "author": {"login": "drive-by"}, "commit": {"oid": "old"}},
            {"databaseId": 12, "state": "APPROVED", "authorCanPushToRepository": true, "author": {"login": "writer"}, "commit": {"oid": "old"}},
            {"databaseId": 13, "state": "APPROVED", "authorCanPushToRepository": true, "author": {"login": "owner"}, "commit": {"oid": "older"}},
            {"databaseId": 14, "state": "COMMENTED", "authorCanPushToRepository": true, "author": {"login": "owner"}, "commit": {"oid": "abc"}},
            {"databaseId": 15, "state": "APPROVED", "authorCanPushToRepository": true, "author": {"login": "gone"}, "commit": {"oid": "old"}},
            {"databaseId": 16, "state": "DISMISSED", "authorCanPushToRepository": true, "author": {"login": "gone"}, "commit": {"oid": "old"}},
            {"databaseId": 17, "state": "CHANGES_REQUESTED", "authorCanPushToRepository": true, "author": {"login": "critic"}, "commit": {"oid": "abc"}}
        ]}}}}}`;
    final got = serialize\Boxed.init(reviewsFrom([body]).value!);
    assert\equal(got.q("head").stringValue(), want: "abc", message: "the head, read with the reviews");
    final seen = mut [<str>];
    foreach (r in got.q("approving").listValue()) {
        seen.append("{r.q("reviewer").stringValue()}:{r.q("id").stringValue()}@{r.q("commit").stringValue()}");
    }
    final listed = seen.join(" ");
    assert\equal(seen.len(), want: 2, message: "a reviewer who cannot push, a dismissed approval and a change request are no approvals: " + listed);
    assert\equal(seen.indexOf("writer:12@old") != null and seen.indexOf("owner:13@older") != null, want: true, message: "a comment leaves an approval standing: " + listed);
}

test "reviews read every page, a later page's review replacing an earlier one" {
    final first = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": "APPROVED",
        "reviews": {"pageInfo": {"hasNextPage": true, "endCursor": "c1"}, "nodes": [
            {"databaseId": 1, "state": "APPROVED", "authorCanPushToRepository": true, "author": {"login": "ann"}, "commit": {"oid": "old"}},
            {"databaseId": 2, "state": "APPROVED", "authorCanPushToRepository": true, "author": {"login": "bob"}, "commit": {"oid": "old"}}
        ]}}}}}`;
    final second = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": "APPROVED",
        "reviews": {"pageInfo": {"hasNextPage": false, "endCursor": "c2"}, "nodes": [
            {"databaseId": 3, "state": "DISMISSED", "authorCanPushToRepository": true, "author": {"login": "ann"}, "commit": {"oid": "old"}},
            {"databaseId": 4, "state": "APPROVED", "authorCanPushToRepository": true, "author": {"login": "cy"}, "commit": {"oid": "abc"}}
        ]}}}}}`;
    assert\equal(reviewsNext(first).value!, want: "c1", message: "the first page names where the second starts");
    assert\equal(reviewsNext(second).value!, want: "", message: "the last page names none");
    final seen = mut [<str>];
    foreach (r in serialize\Boxed.init(reviewsFrom([first, second]).value!).q("approving").listValue()) {
        seen.append(r.q("reviewer").stringValue());
    }
    assert\equal(seen.len(), want: 2, message: "ann's approval was dismissed on the second page: " + seen.join(" "));
    assert\equal(seen.indexOf("bob") != null and seen.indexOf("cy") != null, want: true, message: "bob from the first page, cy from the second: " + seen.join(" "));
    assert\equal(approvalFrom([first, second], commit: "abc", required: 1).value!["approved"], want: true, message: "approval_at counts the second page too");
}

test "reviews of a pull request that does not exist is an error" {
    var failed = false;
    failed = reviewsFrom([`{"data": {"repository": {"pullRequest": null}}}`]).error != null;
    assert\equal(failed, want: true, message: "no head");
}

test "a dismissal is done on 200, re-read on 422, and an error otherwise" {
    assert\equal(dismissal({"status": 200, "body": ""}, review: "12").value!, want: "done", message: "dismissed");
    assert\equal(dismissal({"status": 422, "body": ""}, review: "12").value!, want: "reread", message: "no longer approving");
    final refused = dismissal({"status": 403, "body": "Resource not accessible by integration"}, review: "12");
    assert\equal(refused.error?.message ?? "", want: "github: dismiss review 12: HTTP 403: Resource not accessible by integration", message: "a token without pull-requests write");
    assert\equal(dismissedFrom(`{"id": 12, "state": "DISMISSED"}`, review: "12").value!, want: true, message: "already dismissed is done");
    final standing = dismissedFrom(`{"id": 12, "state": "COMMENTED"}`, review: "12");
    assert\equal(standing.error?.message ?? "", want: "github: dismiss review 12: GitHub refused it, and it is COMMENTED, not dismissed", message: "a refusal that left the review standing");
}

test "a change request from an account that cannot push blocks nothing" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": "APPROVED",
        "reviews": {"nodes": [
            {"state": "APPROVED", "authorCanPushToRepository": true, "author": {"login": "writer"}, "commit": {"oid": "abc"}},
            {"state": "CHANGES_REQUESTED", "authorCanPushToRepository": false, "author": {"login": "drive-by"}, "commit": {"oid": "abc"}}
        ]}}}}}`;
    assert\equal(approvalFrom([body],commit: "abc", required: 1).value!["approved"], want: true, message: "as on GitHub, where it does not count either");
}

test "no review requirement approves with no reviews" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": null,
        "reviews": {"nodes": []}}}}}`;
    assert\equal(approvalFrom([body],commit: "abc", required: 0).value!["approved"], want: true, message: "nothing is required");
}

test "a requirement the rulesets do not show still needs one approval at the commit" {
    final body = `{"data": {"repository": {"pullRequest": {"headRefOid": "abc", "reviewDecision": "REVIEW_REQUIRED",
        "reviews": {"nodes": []}}}}}`;
    final got = approvalFrom([body],commit: "abc", required: 0).value!;
    assert\equal(got["approved"], want: false, message: "classic protection or code owners");
    assert\equal(got["reason"], want: "0 of 1 approvals at this commit", message: "at least one");
}

test "required approvals come from the strictest pull_request rule" {
    assert\equal(requiredFrom(`[
        {"type": "deletion"},
        {"type": "pull_request", "parameters": {"required_approving_review_count": 1}},
        {"type": "pull_request", "parameters": {"required_approving_review_count": 2}}
    ]`).value!, want: 2, message: "the larger count");
    assert\equal(requiredFrom(`[]`).value!, want: 0, message: "no rules, no requirement");
}

test "a pull request merges on its stack's base with its auto-merge method" {
    final member = targetFrom(`{"base": {"ref": "s1"}, "stack": {"base": {"ref": "main"}}, "auto_merge": null}`, method: "squash").value!;
    assert\equal(member["base"], want: "main", message: "the stack's base, not the branch below");
    assert\equal(member["method"], want: "squash", message: "the method it was queued with");
    final plain = targetFrom(`{"base": {"ref": "main"}, "auto_merge": {"merge_method": "REBASE"}}`, method: "squash").value!;
    assert\equal(plain["base"], want: "main", message: "its own base");
    assert\equal(plain["method"], want: "rebase", message: "auto-merge's method, as the contract spells it");
}

test "the other pull requests from a branch share it" {
    assert\equal(sharedFrom([`[{"number": 7}, {"number": 40}]`], number: "7").value!, want: ["40"], message: "all but its own");
}

test "describe lists the methods the repository allows" {
    final bot = {"name": "q[bot]", "email": "7+q[bot]@users.noreply.github.com"};
    final got = describeFrom(`{"allow_merge_commit": false, "allow_squash_merge": true, "allow_rebase_merge": true}`, rules: `[]`, setup: null, committer: bot).value!;
    assert\equal(got["methods"], want: ["squash", "rebase"], message: "allowed methods");
    assert\equal(got["stackMerge"], want: "atomic", message: "GitHub merges a stack in one call");
    assert\equal(got["queueLabel"], want: "merge-queue: ", message: "the label a stack is queued by, before its method");
    assert\equal(got["committer"], want: bot, message: "the app's bot commits");
    assert\equal(got["requiredApprovals"], want: 0, message: "no rule requires a review, and describe says so rather than leaving it out");
}

test "the app's bot commits under its noreply address" {
    assert\equal(botFrom("acme-magus-queue", user: `{"login": "acme-magus-queue[bot]", "id": 41898282}`).value!,
        want: {"name": "acme-magus-queue[bot]", "email": "41898282+acme-magus-queue[bot]@users.noreply.github.com"}, message: "the bot's user id");
}

test "an active pull_request ruleset rule narrows methods to what it allows" {
    final got = describeFrom(`{"allow_merge_commit": true, "allow_squash_merge": true, "allow_rebase_merge": true}`,
        rules: `[{"type": "pull_request", "parameters": {"allowed_merge_methods": ["squash", "rebase"], "required_approving_review_count": 1}}]`, setup: null, committer: null).value!;
    assert\equal(got["methods"], want: ["squash", "rebase"], message: "the repo settings allow merge too, but the ruleset does not");
    assert\equal(got["requiredApprovals"], want: 1, message: "the approvals the same rule requires");
}

test "a required_linear_history rule drops merge even when settings and rulesets both allow it" {
    final got = describeFrom(`{"allow_merge_commit": true, "allow_squash_merge": true, "allow_rebase_merge": true}`,
        rules: `[{"type": "required_linear_history"}]`, setup: null, committer: null).value!;
    assert\equal(got["methods"], want: ["squash", "rebase"], message: "a merge commit is never linear");
}

test "no rule targeting the base leaves the settings untouched" {
    final got = describeFrom(`{"allow_merge_commit": true, "allow_squash_merge": false, "allow_rebase_merge": false}`, rules: `[]`, setup: null, committer: null).value!;
    assert\equal(got["methods"], want: ["merge"], message: "a ruleset on another branch never reaches this call, since the rules are read for the base branch alone");
}

test "a read-only token takes the methods its ruleset names" {
    final got = describeFrom(`{"full_name": "o/r"}`,
        rules: `[{"type": "pull_request", "parameters": {"allowed_merge_methods": ["squash", "rebase"]}}]`, setup: null, committer: null).value!;
    assert\equal(got["methods"], want: ["squash", "rebase"], message: "absent settings are unknown, not off");
}

test "a read-only token with no ruleset naming methods is an error naming why" {
    final read = describeFrom(`{"full_name": "o/r"}`, rules: `[]`, setup: null, committer: null);
    assert\contains(read.error?.message ?? "", item: "push access", message: "the error names the missing permission");
}

test "an empty intersection is an error naming why" {
    final read = describeFrom(`{"allow_merge_commit": true, "allow_squash_merge": false, "allow_rebase_merge": false}`,
        rules: `[{"type": "pull_request", "parameters": {"allowed_merge_methods": ["squash"]}}]`, setup: null, committer: null);
    assert\contains(read.error?.message ?? "", item: "no merge method", message: "the error names why, not just that it failed");
}

test "the merge carries the queued method and the author's title, pinned to the sha" {
    final body = mergeBody(`{"auto_merge": {"merge_method": "rebase", "commit_title": "feat: x (#7)", "commit_message": ""}}`, commit: "abc", method: "rebase", message: "* x").value!;
    assert\equal(body["merge_method"], want: "rebase", message: "the queued method");
    assert\equal(body["sha"], want: "abc", message: "pinned to the tested commit");
    assert\equal(body["commit_title"], want: "feat: x (#7)", message: "the author's title");
    assert\equal(body["commit_message"], want: null, message: "a rebase takes no message");
}

test "a squash carries the pull request title and the change's own commits" {
    final body = mergeBody(`{"number": 7, "title": "feat: add x", "auto_merge": {"merge_method": "squash"}}`, commit: "abc", method: "squash", message: "* add x\n\n* fix typo").value!;
    assert\equal(body["merge_method"], want: "squash", message: "squash");
    assert\equal(body["commit_title"], want: "feat: add x (#7)", message: "the title as subject, GitHub's shape");
    assert\equal(body["commit_message"], want: "* add x\n\n* fix typo", message: "no queue commit, no co-author trailer");
    final authored = mergeBody(`{"number": 7, "title": "t", "auto_merge": {"merge_method": "squash", "commit_title": "mine", "commit_message": "my body"}}`, commit: "abc", method: "squash", message: "* x").value!;
    assert\equal(authored["commit_title"], want: "mine", message: "the author's own title wins");
    assert\equal(authored["commit_message"], want: "my body", message: "the author's own body wins");
}

test "merge_change waits for auto-merge while the pull request is open at the commit" {
    final at = "abc";
    assert\equal(awaitFrom(`{"state": "open", "merged": false, "head": {"sha": "abc"}, "auto_merge": {"merge_method": "squash"}}`, commit: at).value!["next"],
        want: "wait", message: "GitHub has yet to merge it");
    assert\equal(awaitFrom(`{"state": "closed", "merged": true, "head": {"sha": "abc"}, "auto_merge": null}`, commit: at).value!["next"],
        want: "merged", message: "GitHub merged it, and auto-merge is cleared by then");
    final moved = awaitFrom(`{"state": "open", "merged": false, "head": {"sha": "def"}, "auto_merge": {"merge_method": "squash"}}`, commit: at).value!;
    assert\equal(moved["next"], want: "refuse", message: "a new head is not what was validated");
    assert\equal(moved["reason"], want: "head moved to def before GitHub merged it", message: "says where it moved");
    assert\equal(awaitFrom(`{"state": "open", "merged": false, "head": {"sha": "abc"}, "auto_merge": null}`, commit: at).value!["reason"],
        want: "auto-merge was disabled before GitHub merged it", message: "a withdrawn intent is not merged by the queue either");
    assert\equal(awaitFrom(`{"state": "closed", "merged": false, "head": {"sha": "abc"}, "auto_merge": null}`, commit: at).value!["reason"],
        want: "closed before GitHub merged it", message: "closed unmerged");
}

test "a merge the app's call raced is GitHub's unless the app's bot made it" {
    assert\equal(mergedByOther(`{"merged_by": {"login": "egladman"}}`, app: "q").value!, want: true, message: "auto-merge merges as whoever enabled it");
    assert\equal(mergedByOther(`{"merged_by": {"login": "q[bot]"}}`, app: "q").value!, want: false, message: "the app's own merge, its answer lost");
    assert\equal(mergedByOther(`{"merged_by": {"login": "github-actions[bot]"}}`, app: "q").value!, want: true, message: "another integration's merge");
}

test "list_green keeps the open pull requests whose head carries the status at success" {
    final body = `{"data": {"repository": {"pullRequests": {
        "pageInfo": {"hasNextPage": true, "endCursor": "p2"},
        "nodes": [
        {"number": 4, "headRefOid": "h4", "commits": {"nodes": [{"commit": {"oid": "h4", "status": {"context": {"state": "SUCCESS"}}}}]}},
        {"number": 5, "headRefOid": "h5", "commits": {"nodes": [{"commit": {"oid": "h5", "status": {"context": {"state": "PENDING"}}}}]}},
        {"number": 6, "headRefOid": "h6", "commits": {"nodes": [{"commit": {"oid": "h6", "status": null}}]}},
        {"number": 7, "headRefOid": "h7", "commits": {"nodes": [{"commit": {"oid": "older", "status": {"context": {"state": "SUCCESS"}}}}]}}
    ]}}}}`;
    final got = greenFrom(body, repo: "acme/acme").value!;
    assert\equal(got.len(), want: 1, message: "pending, no status and a stale commit are not green");
    final four = serialize\Boxed.init(got[0]);
    assert\equal(four.q("id").stringValue(), want: "4", message: "id");
    assert\equal(four.q("repo").stringValue(), want: "acme/acme", message: "repo");
    assert\equal(four.q("head").stringValue(), want: "h4", message: "head");
    assert\equal(greenNext(body).value!, want: "p2", message: "and where the next page starts");
}

fun kickFacts(code: str, paths: [str], commits: [str], candidate: str) > result\Result::<str> {
    return kickMarker({"code": code, "paths": paths, "with": commits, "candidate_commit": candidate});
}

test "a red gate's kick-back links the run, reproduces it locally and lists the files" {
    final io = QueueKickBackRequest{
        id = "300", repo = "", head = "", base = "main", method = "squash", fork = false, code = "KICK_RED", candidateCommit = "c0ffee",
        report = "The merge queue built this change at `4d028a1474d1` onto `main` at `9f2e01234567`, and the gate failed on it and passed without it.\n",
        claim = "the gate exited 1",
        source = "egladman/magus/runs/123",
        reproduce = QueueReproduction{ gate = "magus run ci --no-default-charms", regenerate = "magus run generate:rw" },
        paths = ["libs/a.go"], with = ["abc123 touch a"],
    };
    final got = kickComment(io, web: "https://github.com", requeue: requeueLine("300", method: "squash", fork: false, label: "", top: "")).value!;
    final want = [
        "### Merge queue: kicked back",
        "",
        "The merge queue built this change at `4d028a1474d1` onto `main` at `9f2e01234567`, and the gate failed on it and passed without it.",
        "",
        "The run reported:",
        "",
        "```text",
        "the gate exited 1",
        "```",
        "",
        "[Validation run](https://github.com/egladman/magus/actions/runs/123)",
        "",
        "<details><summary><b>Reproduce locally</b></summary>",
        "",
        "```sh",
        "gh run download 123 -R egladman/magus -n mergequeue-plan -D mq-300",
        "magus queue validate --only 300 --stdin --verdicts mq-300/verdicts < mq-300/plan.json \\",
        `  --gate 'magus run ci --no-default-charms' \`,
        `  --regenerate 'magus run generate:rw'`,
        "```",
        "",
        "The queue appends the change's affected projects to each hook line. "
            + "Run it in a checkout of `main` whose `origin` is egladman/magus; the plan artifact is kept for a day.",
        "",
        "</details>",
        "",
        "<details><summary>Files (1)</summary>",
        "",
        "- `libs/a.go`",
        "",
        "Commits on `main` that changed them:",
        "",
        "- `abc123 touch a`",
        "",
        "</details>",
        "",
        "Queue it again once fixed: `gh pr merge 300 --auto --squash`",
        "",
        kickFacts("KICK_RED", paths: ["libs/a.go"], commits: ["abc123 touch a"], candidate: "c0ffee").value!,
    ];
    assert\equal(got, want: want.join("\n") + "\n", message: "the whole comment");
}

test "a conflict planning found links the run and reproduces nothing" {
    final io = QueueKickBackRequest{
        id = "7", repo = "", head = "", base = "main", method = "rebase", fork = false, code = "KICK_CONFLICT",
        report = "It conflicts.\n\nMerge `main` in.\n", source = "o/r/runs/9",
    };
    final got = kickComment(io, web: "https://github.com", requeue: requeueLine("7", method: "rebase", fork: false, label: "", top: "")).value!;
    assert\equal(got, want: "### Merge queue: kicked back\n\nIt conflicts.\n\nMerge `main` in.\n\n[Validation run](https://github.com/o/r/actions/runs/9)\n\n"
        + "Queue it again once fixed: `gh pr merge 7 --auto --rebase`\n\n" + kickFacts("KICK_CONFLICT", paths: [<str>], commits: [<str>], candidate: "").value! + "\n",
        message: "no reproduce block, no files");
    assert\equal(kickComment(QueueKickBackRequest{ id = "7", repo = "", head = "", base = "", method = "", fork = false, report = "r" }, web: "https://github.com", requeue: "").value!,
        want: "### Merge queue: kicked back\n\nr\n\n" + kickFacts("", paths: [<str>], commits: [<str>], candidate: "").value! + "\n", message: "a directory source links nothing");
}

test "a change needing regeneration names its label and is queued again once regenerated" {
    final io = QueueKickBackRequest{
        id = "8", repo = "", head = "", base = "main", method = "squash", fork = false, code = "KICK_REGENERATION",
        report = "The merge queue cannot merge this change: it changes what regenerates gen/x.go.\n",
    };
    final got = kickComment(io, web: "https://github.com", requeue: requeueLine("8", method: "squash", fork: false, label: "", top: "")).value!;
    assert\equal(got, want: "### Merge queue: kicked back\n\n"
        + "The merge queue cannot merge this change: it changes what regenerates gen/x.go.\n\n"
        + "This is why it carries the label `queue: needs regeneration`: "
        + "merging it needs generated files regenerated by code it changes, which the queue does not run. "
        + "Merge `main` in, regenerate them, and push: then the merge leaves them as they are.\n\n"
        + "Queue it again once fixed: `gh pr merge 8 --auto --squash`\n\n"
        + kickFacts("KICK_REGENERATION", paths: [<str>], commits: [<str>], candidate: "").value! + "\n", message: "the label follows the reason");
}

test "what a verdict carries renders inert: file names, commits and the run's claim" {
    final io = QueueKickBackRequest{
        id = "9", repo = "", head = "", base = "main", method = "", fork = false, code = "KICK_RED", report = "r",
        claim = "``` \n@everyone <!-- x -->\n````",
        paths = ["a`b.go", "x\ny.md", "@org/team", "--> <img src=x>", "``` fence"], with = ["abc @someone"],
    };
    final got = kickComment(io, web: "https://github.com", requeue: "").value!;
    final marker = kickFacts("KICK_RED", paths: ["a`b.go", "x\ny.md", "@org/team", "--> <img src=x>", "``` fence"], commits: ["abc @someone"], candidate: "").value!;
    final want = [
        "### Merge queue: kicked back", "", "r", "",
        "The run reported:", "",
        "`````text", "``` ", "@everyone <!-- x -->", "````", "`````", "",
        "<details><summary>Files (5)</summary>", "",
        "- ``a`b.go``",
        "- `\"x\\ny.md\"`",
        "- `@org/team`",
        "- `--> <img src=x>`",
        "- ```` ``` fence ````",
        "", "Commits on `main` that changed them:", "",
        "- `abc @someone`",
        "", "</details>", "",
        marker,
    ];
    assert\equal(got, want: want.join("\n") + "\n", message: "every value a span or a fence longer than any backtick run in it");
    final inner = marker.sub(KICK_MARKER.len(), len: marker.len() - KICK_MARKER.len() - KICK_MARKER_END.len());
    foreach (c in ["-", "<", ">", "!", "@"]) {
        assert\equal(inner.indexOf(c) == null, want: true, message: "the marker's JSON holds no raw {c}");
    }
    final facts = serialize\jsonDecode(inner);
    assert\equal(facts.q("paths").listValue()[3].stringValue(), want: "--> <img src=x>", message: "an escape reads back as the character");
    assert\equal(facts.q("with").listValue()[0].stringValue(), want: "abc @someone", message: "and a mention too");
}

test "a kick-back lists a bounded number of files" {
    final paths = mut [<str>];
    var i = 0;
    while (i < MAX_LISTED + 3) {
        paths.append("f{i}");
        i = i + 1;
    }
    final lines = kickComment(QueueKickBackRequest{ id = "9", repo = "", head = "", base = "", method = "", fork = false, report = "r", paths = paths }, web: "https://github.com", requeue: "").value!.split("\n");
    assert\equal(lines[4], want: "<details><summary>Files ({MAX_LISTED + 3})</summary>", message: "the count is every file");
    assert\equal(lines[6 + MAX_LISTED], want: "- and 3 more", message: "the list stops at MAX_LISTED");
}

test "a hook line's single quotes survive sh quoting" {
    assert\equal(shQuote("echo 'hi' there"), want: `'echo '\''hi'\'' there'`, message: "each quote closes, escapes and reopens");
    assert\equal(shQuote(`magus run x "$HOME"`), want: `'magus run x "$HOME"'`, message: "the variable stays literal");
    final lines = reproduction("5", run: {"repo": "o/r", "id": "2"}, repoArg: "o/r", base: "main", gate: "test 'x' = x", regenerate: "");
    assert\equal(lines[4], want: "magus queue validate --only 5 --stdin --verdicts mq-5/verdicts < mq-5/plan.json \\", message: "continued");
    assert\equal(lines[5], want: `  --gate 'test '\''x'\'' = x'`, message: "no regeneration: the gate line ends the command");
}

test "a stack queued by its top's label re-queues through that label, and a fork not at all" {
    assert\equal(requeueLine("11", method: "squash", fork: false, label: "merge-queue: squash", top: "12"),
        want: "Queue the stack again once fixed: `gh pr edit 12 --add-label \"merge-queue: squash\"`", message: "the top's label");
    assert\equal(requeueLine("11", method: "merge", fork: true, label: "", top: ""), want: "", message: "a fork");
}

test "only this credential's earlier kick-backs are minimized, never the new one" {
    final body = `{"data": {"repository": {"pullRequest": {"comments": {"pageInfo": {"hasNextPage": true, "endCursor": "p2"}, "nodes": [
        {"id": "old", "viewerDidAuthor": true, "isMinimized": false, "body": "x\n<!-- mergequeue: {} -->\n"},
        {"id": "done", "viewerDidAuthor": true, "isMinimized": true, "body": "<!-- mergequeue: {} -->"},
        {"id": "human", "viewerDidAuthor": false, "isMinimized": false, "body": "<!-- mergequeue: {} -->"},
        {"id": "chat", "viewerDidAuthor": true, "isMinimized": false, "body": "a note"},
        {"id": "quoted", "viewerDidAuthor": true, "isMinimized": false, "body": "<!-- mergequeue: {} -->\na note quoting one"},
        {"id": "new", "viewerDidAuthor": true, "isMinimized": false, "body": "<!-- mergequeue: {} -->"}
    ]}}}}}`;
    assert\equal(staleKicks(body, keep: "new").value!, want: ["old"], message: "stale");
    assert\equal(commentsNext(body).value!, want: "p2", message: "and where the next page starts");
}

test "a label and a branch are escaped for the URL they go in" {
    assert\equal(escape("merge-queue: squash"), want: "merge-queue%3a%20squash", message: "a label");
    assert\equal(escape("ann:feat/x-1"), want: "ann%3afeat%2fx-1", message: "an owner and branch");
}

test "a long status description is cut to what GitHub accepts" {
    final parts = mut [<str>];
    var i = 0;
    while (i < 200) {
        parts.append("x");
        i = i + 1;
    }
    final long = parts.join("");
    assert\equal(statusBody("pending", context: "merge-queue", description: long)["description"].len(), want: 140, message: "140 bytes");
    assert\equal(statusBody("success", context: "merge-queue", description: "ok")["description"], want: "ok", message: "a short one is untouched");
}

test "a run names its repository and id, and its artifacts download from the API" {
    final run = parseRunSpec("acme/widgets/runs/7").value!;
    assert\equal(run["repo"], want: "acme/widgets", message: "repository");
    assert\equal(run["id"], want: "7", message: "run id");
    final got = artifactsFrom(`{"artifacts": [{"id": 100, "name": "mergequeue-plan"}]}`, base: "https://api.github.com", repo: "acme/widgets").value!;
    assert\equal(serialize\Boxed.init(got[0]).q("url").stringValue(), want: "https://api.github.com/repos/acme/widgets/actions/artifacts/100/zip", message: "zip url");
}

fun runJSON(event: str, branch: str, headRepo: str) > str {
    return serialize\jsonEncode({"id": 7, "status": "in_progress", "event": event, "head_branch": branch, "path": ".github/workflows/queue.yaml",
        "repository": {"full_name": "acme/widgets"}, "head_repository": {"full_name": headRepo}});
}


test "a run says what started it and what it ran" {
    final push = serialize\Boxed.init(originFrom(runJSON("push", branch: "main", headRepo: "acme/widgets"), repo: "acme/widgets").value!);
    assert\equal(push.q("repo").stringValue(), want: "acme/widgets", message: "repository");
    assert\equal(push.q("headRepo").stringValue(), want: "acme/widgets", message: "head repository");
    assert\equal(push.q("headBranch").stringValue(), want: "main", message: "branch");
    assert\equal(push.q("event").stringValue(), want: "push", message: "event");
    assert\equal(push.q("branchEvent").booleanValue(), want: true, message: "a push runs the branch's own workflow file");
    assert\equal(push.q("definition").stringValue(), want: ".github/workflows/queue.yaml", message: "workflow file");
    final dispatched = serialize\Boxed.init(originFrom(runJSON("workflow_dispatch", branch: "main", headRepo: "acme/widgets"), repo: "acme/widgets").value!);
    assert\equal(dispatched.q("branchEvent").booleanValue(), want: true, message: "so does a dispatch");
}

test "a run a pull request started never runs the branch's own workflow file" {
    foreach (event in ["pull_request", "pull_request_review", "pull_request_target", "workflow_run", "schedule"]) {
        final got = serialize\Boxed.init(originFrom(runJSON(event, branch: "main", headRepo: "mallory/widgets"), repo: "acme/widgets").value!);
        assert\equal(got.q("branchEvent").booleanValue(), want: false, message: event);
        assert\equal(got.q("headRepo").stringValue(), want: "mallory/widgets", message: "a fork's head repository is reported as it is");
    }
}

test "a run of another repository than the source names is an error" {
    final refused = originFrom(runJSON("push", branch: "main", headRepo: "acme/widgets"), repo: "acme/other").error != null;
    assert\equal(refused, want: true, message: "the listing names the run's own repository");
}

test "the GraphQL endpoint follows the REST one" {
    assert\equal(graphqlURL("https://api.github.com"), want: "https://api.github.com/graphql", message: "github.com");
    assert\equal(graphqlURL("https://github.acme.com/api/v3"), want: "https://github.acme.com/api/graphql", message: "Enterprise");
    assert\equal(slug("https://github.com/acme/acme.git", host: "github.com"), want: "acme/acme", message: "the Actions remote");
}

final RULES = `[
    {"type": "pull_request", "ruleset_id": 3, "parameters": {"required_approving_review_count": 1}},
    {"type": "required_status_checks", "ruleset_id": 9, "parameters": {"required_status_checks": [
        {"context": "merge-queue", "integration_id": 15368}, {"context": "ci gate"}]}},
    {"type": "required_status_checks", "ruleset_id": 4, "parameters": {"required_status_checks": [
        {"context": "merge-queue", "integration_id": 15368}]}}
]`;

final CLASSIC = `{"protection": {"required_status_checks": {"contexts": ["lint", "merge-queue"],
    "checks": [{"context": "lint", "app_id": null}, {"context": "merge-queue", "app_id": 812}]}}}`;

test "required checks come from rulesets and classic protection, once per ruleset and pin" {
    final got = requiredChecksFrom(RULES, branch: CLASSIC).value!;
    assert\equal(got.len(), want: 5, message: "merge-queue in each ruleset, ci gate, lint, merge-queue from 812");
    assert\equal(got[0], want: {"context": "merge-queue", "integration": "15368", "ruleset": "9"}, message: "a ruleset pin names its ruleset");
    assert\equal(got[1], want: {"context": "ci gate", "integration": "", "ruleset": "9"}, message: "no pin accepts anyone");
    assert\equal(got[2], want: {"context": "merge-queue", "integration": "15368", "ruleset": "4"}, message: "each ruleset needs its own pin");
    assert\equal(got[3], want: {"context": "lint", "integration": "", "ruleset": ""}, message: "classic protection names no ruleset");
    assert\equal(got[4], want: {"context": "merge-queue", "integration": "812", "ruleset": ""}, message: "classic pins by app_id");
    final old = requiredChecksFrom("[]", branch: `{"protection": {"required_status_checks": {"contexts": ["build"]}}}`).value!;
    assert\equal(old, want: [{"context": "build", "integration": "", "ruleset": ""}], message: "contexts alone, pinned to nothing");
    assert\equal(requiredChecksFrom("[]", branch: `{"protected": false}`).value!.len(), want: 0, message: "an unprotected base requires nothing");
}

test "a check's events are the workflow runs that reported it" {
    final reports = reportsFrom(`{"check_runs": [
        {"name": "ci gate", "check_suite": {"id": 1}}, {"name": "ci gate", "check_suite": {"id": 2}},
        {"name": "ci gate", "check_suite": {"id": 1}}, {"name": "codecov", "check_suite": {"id": 5}}]}`,
        runs: `{"workflow_runs": [{"check_suite_id": 1, "event": "pull_request"}, {"check_suite_id": 2, "event": "push"}]}`).value!;
    assert\equal(contextEvents(reports, context: "ci gate"), want: ["pull_request", "push"], message: "each event once");
    assert\equal(contextEvents(reports, context: "codecov").len(), want: 0, message: "another app's check has no workflow event");
}

test "the sampled heads are pull requests from this repository, newest first" {
    final body = `[{"head": {"sha": "f0", "repo": {"full_name": "x/acme"}}}, {"head": {"sha": "a1", "repo": {"full_name": "acme/acme"}}},
        {"head": {"sha": "b2", "repo": {"full_name": "acme/acme"}}}]`;
    assert\equal(sampleHeads(body, repo: "acme/acme").value!, want: ["a1", "b2"], message: "a fork's runs are not this repository's");
    assert\equal(sampleHeads("[]", repo: "acme/acme").value!.len(), want: 0, message: "no pull request, no sample");
    final runs = `{"check_runs": [{"name": "lint"}, {"name": "ci gate"}]}`;
    assert\equal(carriesRequired(runs, wanted: [{"context": "ci gate"}]).value!, want: true, message: "a finished head carries the gate");
    assert\equal(carriesRequired(runs, wanted: [{"context": "deploy"}]).value!, want: false, message: "one still running does not");
}

test "only a ruleset holding the queue's rule alone is rewritten in place" {
    final own = `{"name": "magus merge queue", "rules": [{"type": "required_status_checks", "parameters": {"required_status_checks": [{"context": "merge-queue"}]}}]}`;
    assert\equal(ownRuleset(own).value!, want: RULESET_NAME, message: "the printed ruleset");
    final more = `{"name": "main", "rules": [{"type": "deletion"}, {"type": "required_status_checks", "parameters": {"required_status_checks": [{"context": "merge-queue"}]}}]}`;
    assert\equal(ownRuleset(more).value!, want: "", message: "a PUT would drop the deletion rule");
}

test "the registration link pre-fills a private app with the queue's permissions" {
    assert\equal(registrationURL("https://github.com", repo: "acme/widgets", org: false),
        want: "https://github.com/settings/apps/new?name=acme-magus-queue&url=https%3a%2f%2fgithub.com%2facme%2fwidgets&public=false&webhook_active=false&" + APP_PERMISSIONS,
        message: "a user's app");
    assert\equal(registrationURL("https://github.com", repo: "acme/widgets", org: true).startsWith("https://github.com/organizations/acme/settings/apps/new?"),
        want: true, message: "an organization's app");
}

final AT = {"repo": "acme/widgets", "base": "main", "context": "merge-queue", "web": "https://github.com"};

test "an App ID is a positive integer as GitHub writes one" {
    foreach (s in ["1", "812", "2034567"]) {
        assert\equal(isAppID(s), want: true, message: s);
    }
    foreach (s in ["", "0", "0812", "+812", "-812", "812 ", "8.12", "Iv23li", "1e3"]) {
        assert\equal(isAppID(s), want: false, message: s);
    }
}

test "the app is a slug, with its App ID after a colon where GitHub hides it" {
    assert\equal(parseApp("").value!, want: {"slug": "", "id": ""}, message: "none");
    assert\equal(parseApp("magus-queue").value!, want: {"slug": "magus-queue", "id": ""}, message: "a slug");
    assert\equal(parseApp("magus-queue:2034567").value!, want: {"slug": "magus-queue", "id": "2034567"}, message: "a slug and its App ID");
    foreach (value in [":2034567", "magus-queue:", "magus-queue:0812", "magus-queue:Iv23li", "magus-queue:1:2"]) {
        final parsed = parseApp(value);
        assert\isTrue(parsed.error != null, message: value);
        final reason = parsed.error!.message;
        assert\equal(reason, want: "github: the app '{value}' is not <slug> or <slug>:<App ID>, an App ID being a positive integer with no leading zero", message: value);
    }
}

test "the apps a user or an organization registered are listed under their own settings" {
    assert\equal(appsPage("https://github.com", owner: "acme", org: false), want: "https://github.com/settings/apps", message: "a user's");
    assert\equal(appsPage("https://github.com", owner: "acme", org: true), want: "https://github.com/organizations/acme/settings/apps", message: "an organization's");
}

test "setup allows auto-merge and pins a context required from anyone to the app" {
    final checks = [{"context": "merge-queue", "integration": "", "ruleset": "9"}, {"context": "ci gate", "integration": "", "ruleset": "4"}];
    final reports = [{"name": "ci gate", "event": "pull_request"}];
    final app = {"slug": "acme-magus-queue", "id": "812", "client_id": "Iv23li", "name": "acme magus queue"};
    final repo = `{"allow_auto_merge": false, "owner": {"type": "User"}}`;
    final setup = serialize\Boxed.init(setupFrom(AT, repoBody: repo, checks: checks, reports: reports, rulesets: {"9": RULESET_NAME}, app: app, steps: true).value!);
    assert\equal(setup.q("credential").q("id").stringValue(), want: "812", message: "the app posts the status");
    assert\equal(setup.q("settings").listValue()[0].q("value").stringValue(), want: "false", message: "auto-merge is off");
    assert\equal(setup.q("requiredChecks").listValue()[1].q("events").listValue()[0].stringValue(), want: "pull_request", message: "the event it was seen on");
    final steps = setup.q("steps").listValue();
    assert\equal(steps[0].q("title").stringValue(), want: "Allow auto-merge (Settings > General > Pull Requests > Allow auto-merge)", message: "auto-merge first");
    assert\equal(steps.len(), want: 6, message: "auto-merge, install, environment, variable, key, the pin");
    assert\equal(steps[0].q("command").stringValue(), want: "gh api -X PATCH repos/acme/widgets -F allow_auto_merge=true", message: "auto-merge");
    assert\equal(steps[4].q("title").stringValue().indexOf("https://github.com/settings/apps/acme-magus-queue") != null, want: true, message: "a user's app page");
    final pin = steps[5].q("command").stringValue();
    assert\equal(pin.startsWith("gh api -X PUT repos/acme/widgets/rulesets/9 --input - <<'EOF'\n"), want: true, message: "the queue's own ruleset, rewritten");
    assert\equal(pin.indexOf(`"integration_id":812`) != null, want: true, message: "pinned to the app");
    assert\equal(pin.indexOf(`"strict_required_status_checks_policy":false`) != null, want: true, message: "no strict up-to-date");
}

test "setup requires the status from the app in a ruleset of its own when nothing requires it" {
    final app = {"slug": "acme-magus-queue", "id": "812", "client_id": "Iv23li", "name": "acme magus queue"};
    final repo = `{"allow_auto_merge": true, "owner": {"type": "User"}}`;
    final steps = serialize\Boxed.init(setupFrom(AT, repoBody: repo, checks: [<{str: str}>], reports: [<{str: str}>], rulesets: {<str: str>}, app: app, steps: true).value!).q("steps").listValue();
    assert\equal(steps.len(), want: 5, message: "install, environment, variable, key, the ruleset");
    final ruleset = steps[4].q("command").stringValue();
    assert\equal(ruleset.startsWith("gh api -X POST repos/acme/widgets/rulesets --input - <<'EOF'\n"), want: true, message: "a ruleset of its own");
    assert\equal(ruleset.indexOf(`"integration_id":812`) != null, want: true, message: "pinned to the app");
    assert\equal(ruleset.indexOf(`"refs/heads/main"`) != null, want: true, message: "on the base");
}

test "with an app, setup installs it, stores its credential and moves the pin" {
    final checks = [{"context": "merge-queue", "integration": "15368", "ruleset": "9"}, {"context": "merge-queue", "integration": "15368", "ruleset": ""}];
    final app = {"slug": "acme-magus-queue", "id": "812", "client_id": "Iv23li", "name": "acme magus queue"};
    final repo = `{"allow_auto_merge": true, "owner": {"type": "Organization"}}`;
    final setup = serialize\Boxed.init(setupFrom(AT, repoBody: repo, checks: checks, reports: [<{str: str}>], rulesets: {"9": RULESET_NAME}, app: app, steps: true).value!);
    assert\equal(setup.q("credential").q("id").stringValue(), want: "812", message: "the app posts the status");
    assert\equal(setup.q("app").q("installURL").stringValue(), want: "https://github.com/apps/acme-magus-queue/installations/new", message: "install link");
    assert\equal(setup.q("app").q("secret").stringValue(), want: APP_SECRET, message: "the secret setup-magus reads");
    final steps = setup.q("steps").listValue();
    assert\equal(steps.len(), want: 6, message: "install, environment, variable, key, two pins");
    assert\equal(steps[2].q("command").stringValue(), want: "gh variable set MAGUS_QUEUE_APP_CLIENT_ID --repo acme/widgets --body 'Iv23li'", message: "the client id, read from the app");
    assert\equal(steps[3].q("command").stringValue(),
        want: keyCommand("acme/widgets", slug: "acme-magus-queue", appPage: "https://github.com/organizations/acme/settings/apps/acme-magus-queue"),
        message: "the key, from an organization's app page");
    final pin = steps[4].q("command").stringValue();
    assert\equal(pin.startsWith("gh api -X PUT repos/acme/widgets/rulesets/9 --input - <<'EOF'\n"), want: true, message: "the queue's own ruleset, rewritten");
    assert\equal(pin.indexOf(`"integration_id":812`) != null, want: true, message: "pinned to the app");
    assert\equal(steps[5].q("title").stringValue(), want: "Pin merge-queue to 812 (acme magus queue) in the branch protection of main", message: "the app by id and name");
    assert\equal(steps[5].q("url").stringValue(), want: "https://github.com/acme/widgets/settings/branches", message: "classic protection is edited by hand");
}

test "the key command stores the newest download, deletes every one and changes nothing on a rerun" {
    assert\equal(keyCommand("acme/widgets", slug: "magus-queue", appPage: "https://github.com/settings/apps/magus-queue"),
        want: "(\n"
            + "  pem=$(find ~/Downloads -maxdepth 1 -name 'magus-queue.*.private-key.pem' -exec ls -t " + `{}` + " + | head -n 1)\n"
            + "  if [ -n \"$pem\" ]; then\n"
            + "    gh secret set MAGUS_QUEUE_APP_PRIVATE_KEY --repo acme/widgets --env magus-queue < \"$pem\"\n"
            + "    find ~/Downloads -maxdepth 1 -name 'magus-queue.*.private-key.pem' -delete\n"
            + "  else\n"
            + "    echo 'no magus-queue key in ~/Downloads: generate one on https://github.com/settings/apps/magus-queue unless MAGUS_QUEUE_APP_PRIVATE_KEY is listed below' >&2\n"
            + "  fi\n"
            + "  gh secret ls --repo acme/widgets --env magus-queue\n"
            + ")",
        message: "no stdin read, no set -e between storing and deleting");
}

test "an app whose client id GitHub hides is stored by gh's own prompt, and pinned by id alone" {
    final checks = [{"context": "merge-queue", "integration": "15368", "ruleset": "9"}];
    final app = {"slug": "magus-queue", "id": "2034567", "client_id": "", "name": ""};
    final setup = serialize\Boxed.init(setupFrom(AT, repoBody: `{"allow_auto_merge": true, "owner": {"type": "User"}}`, checks: checks,
        reports: [<{str: str}>], rulesets: {"9": RULESET_NAME}, app: app, steps: true).value!);
    assert\equal(setup.q("credential").q("id").stringValue(), want: "2034567", message: "the given App ID posts the status");
    final steps = setup.q("steps").listValue();
    assert\equal(steps.len(), want: 5, message: "install, environment, variable, key, pin");
    assert\equal(steps[0].q("title").stringValue(), want: "Install magus-queue on acme/widgets only", message: "one link, the install's");
    assert\equal(steps[2].q("title").stringValue(), want: "Store the app's client id, under About on https://github.com/settings/apps/magus-queue; gh asks for it", message: "where it is");
    assert\equal(steps[2].q("command").stringValue(), want: "gh variable set MAGUS_QUEUE_APP_CLIENT_ID --repo acme/widgets", message: "gh prompts; the script reads nothing");
    assert\equal(steps[4].q("title").stringValue(), want: "Pin merge-queue to 2034567 in ruleset 9 (magus merge queue)", message: "no name GitHub did not give");
    assert\equal(steps[4].q("command").stringValue(), want: heredoc("gh api -X PUT repos/acme/widgets/rulesets/9", body: {"rules": [statusRule("merge-queue", integration: "2034567")]}),
        message: "pinned to the given App ID");
}

test "without steps, setup is the facts apply checks" {
    final setup = serialize\Boxed.init(setupFrom(AT, repoBody: `{"allow_auto_merge": true}`, checks: [{"context": "merge-queue", "integration": "812", "ruleset": "9"}],
        reports: [<{str: str}>], rulesets: {<str: str>}, app: {"slug": "q", "id": "812", "name": "q"}, steps: false).value!);
    assert\equal(setup.q("statusContext").stringValue(), want: "merge-queue", message: "the context asked about");
    assert\equal(setup.q("requiredChecks").listValue()[0].q("integration").stringValue(), want: "812", message: "the pin apply compares");
    assert\equal(setup.q("steps").listValue().len(), want: 0, message: "no steps");
}

test "a required check's state is the newest run's job of its name, else its commit status, else pending" {
    final runs = `{"workflow_runs": [{"id": 9, "workflow_id": 1}, {"id": 8, "workflow_id": 1}, {"id": 7, "workflow_id": 2}]}`;
    assert\equal(latestRuns(runs).value!, want: ["9", "7"], message: "a run started again replaces the one before it");
    final jobs = [
        `{"jobs": [{"name": "ci gate", "status": "completed", "conclusion": "failure"}, {"name": "lint", "status": "in_progress", "conclusion": null}]}`,
        `{"jobs": [{"name": "ci gate", "status": "completed", "conclusion": "success"}, {"name": "docs", "status": "completed", "conclusion": "skipped"},
            {"name": "e2e", "status": "completed", "conclusion": "cancelled"}]}`,
    ];
    final status = `{"statuses": [{"context": "merge-queue", "state": "pending"}, {"context": "deploy", "state": "error"}, {"context": "lint", "state": "success"}]}`;
    final required = [
        {"context": "ci gate", "integration": "", "ruleset": "1"}, {"context": "ci gate", "integration": "", "ruleset": "2"},
        {"context": "lint", "integration": "", "ruleset": ""}, {"context": "docs", "integration": "", "ruleset": ""},
        {"context": "e2e", "integration": "", "ruleset": ""}, {"context": "deploy", "integration": "", "ruleset": ""},
        {"context": "merge-queue", "integration": "", "ruleset": ""}, {"context": "absent", "integration": "", "ruleset": ""},
    ];
    assert\equal(checksFrom(required, jobs: jobs, status: status).value!, want: [
        {"name": "ci gate", "state": "failure"},
        {"name": "lint", "state": "pending"},
        {"name": "docs", "state": "success"},
        {"name": "e2e", "state": "failure"},
        {"name": "deploy", "state": "failure"},
        {"name": "merge-queue", "state": "pending"},
        {"name": "absent", "state": "pending"},
    ], message: "the newest run wins, a job over a status, and a check two rulesets require is one check");
}
