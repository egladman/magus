// GitHub provider for the merge queue: `mergequeue --provider github`. It carries the
// provider contract (see the provider package): describe, list_changes, approval_at,
// list_green, post_status, retarget, merge_change, kick_back, mark, list_artifacts,
// required_checks, reviews and dismiss_review.
// The queue decides what to validate and merge; this file only speaks GitHub's REST and
// GraphQL APIs.
//
// # Merge intent
//
// A pull request is queued when its author (or a maintainer) enables GitHub's native
// auto-merge, and merges with the method chosen there. GitHub offers no auto-merge on a
// stacked pull request, so a stack is queued by the label "merge-queue: <method>"
// (squash, merge or rebase, exactly) on its top pull request, applied by someone with
// write access; that queues every pull request of the stack, bottom first. The same
// label on a pull request outside any stack queues it alone: GitHub's auto-merge follows
// GitHub's own mergeability, and whether a conflict or a stale generated file stops a
// merge is the queue's to decide, which it settles in its candidate or kicks back.
// Nothing here reads `mergeable`. Kicking a change back disables its auto-merge or
// removes the label from it or its stack's top, so queuing it again is how a fixed
// change re-enters.
//
// # Marks
//
// mark shows the queue's state as one label at most: "queue: queued", "queue: kicked
// back" or "queue: needs regeneration". A person's intent label reads "merge-queue:" and
// the queue's answer "queue:", so the listing never reads a mark as intent.
//
// # Credentials
//
// Three environment variables. Most reads use MERGEQUEUE_TOKEN when the
// environment carries it, else
// GITHUB_TOKEN: the validation side runs pull-request code and holds only a read-only
// Actions token. The writes use MERGEQUEUE_TOKEN and nothing else, so a job that does
// not hold the write credential cannot write by accident. That credential is the queue's
// own GitHub App, which describe and merge_change take as app, and nothing else: a run or
// a merge the job's Actions token makes starts no workflow, so a queue writing with it
// would validate changes and never merge one. The app needs contents, pull requests,
// commit statuses, actions and workflows write, and no bypass of any rule.
// list_artifacts reads with MERGEQUEUE_ARTIFACTS_TOKEN alone, the apply
// job's own token, which outlives the app's hour.
//
// # Who merges
//
// The queue posts success on its required status right before a merge. For a pull
// request with auto-merge on, GitHub then merges it on behalf of whoever enabled
// auto-merge, which starts the base branch's workflows; merge_change waits for that and
// reports it (by_provider). Only when GitHub has not merged it in time does
// merge_change merge it through the API itself, as the app, which starts them too. A
// stack, queued by label with no auto-merge, is always merged by merge_change, which is
// not yet verified on a real repository.
//
// # Listings
//
// Every listing pages to completion or fails: a cut listing would read as fewer pull
// requests, fewer merged changes or a stale labeler, each a wrong fact the queue would
// act on.
//
// # What is NOT verified here
//
// The pure halves are tested in testdata/github_tests.buzz.
// The provider package's Go tests run them, and drive describe against a fake
// GitHub. The other HTTP calls are not: verifying them means merging a real
// pull request.

import "assert";
import "os";
import "result";
import "serialize";
import "std";
import "mergequeue";
import "mergequeue/types";

final DEFAULT_API = "https://api.github.com";
final API_ENV = "GITHUB_API_URL";
final READ_REF = "GITHUB_TOKEN";
final WRITE_REF = "MERGEQUEUE_TOKEN";
// ARTIFACTS_REF is apply's own job token, which lives as long as the job.
final ARTIFACTS_REF = "MERGEQUEUE_ARTIFACTS_TOKEN";
// The label on a stack's top pull request that queues the stack, followed by one of
// METHODS exactly.
final QUEUE_LABEL = "merge-queue: ";
final METHODS = ["merge", "squash", "rebase"];
// The label each mark shows as, and what mark creates it with when the repository lacks
// it; MARKS fixes the order label operations run in. GitHub refuses a label description
// over 100 characters. A label serves every base of the repository, so its description
// names none.
final MARKS = ["queued", "kicked_back", "needs_regeneration"];
final MARK_LABELS = {"queued": "queue: queued", "kicked_back": "queue: kicked back", "needs_regeneration": "queue: needs regeneration"};
final MARK_DESCRIPTIONS = {
    "queued": "The queue holds it; the merge-queue status says what it waits on",
    "kicked_back": "The queue kicked it back; its newest queue comment says why",
    "needs_regeneration": "Merge the base in, regenerate, push; the queue then takes it",
};
final MARK_COLORS = {"queued": "1d76db", "kicked_back": "b60205", "needs_regeneration": "fbca04"};
// Roles whose label queues a stack: the ones that can enable auto-merge.
final QUEUE_ROLES = ["admin", "maintain", "write"];
// How many pages of an issue timeline the labeler check reads before it gives up and
// treats the label as unproven.
final TIMELINE_PAGES = 30;
// How long merge_change waits for an asynchronous stack merge to finish.
final ASYNC_POLLS = 60;
final ASYNC_POLL_MS = 5000.0;
// How long merge_change waits for GitHub's auto-merge to merge a pull request whose
// status just went green before merging it itself: 12 reads of the pull request, each
// one request against the job token's hourly limit.
final AUTO_MERGE_POLLS = 12;
final AUTO_MERGE_POLL_MS = 5000.0;

fun getenv(name: str) > str {
    final v = os\env(name);
    return v ?? "";
}

fun apiBase() > str {
    var base = getenv(API_ENV);
    if (base == "") {
        return DEFAULT_API;
    }
    while (base.endsWith("/")) {
        base = base.sub(0, len: base.len() - 1);
    }
    return base;
}

fun apiHost(base: str) > str {
    var h = base;
    if (h.startsWith("https://")) {
        h = h.sub(8);
    } else if (h.startsWith("http://")) {
        h = h.sub(7);
    }
    final cut = h.indexOf("/");
    if (cut != null) {
        h = h.sub(0, len: cut ?? 0);
    }
    if (h.startsWith("api.")) {
        h = h.sub(4);
    }
    return h;
}

fun slug(remote: str, host: str) > str {
    var s = remote;
    if (s.startsWith("git@" + host + ":")) {
        s = s.sub(("git@" + host + ":").len());
    } else if (s.startsWith("https://" + host + "/")) {
        s = s.sub(("https://" + host + "/").len());
    } else if (s.startsWith("ssh://git@" + host + "/")) {
        s = s.sub(("ssh://git@" + host + "/").len());
    } else {
        return "";
    }
    if (s.endsWith(".git")) {
        s = s.sub(0, len: s.len() - 4);
    }
    final parts = s.split("/");
    if (parts.len() != 2 or parts[0] == "" or parts[1] == "") {
        return "";
    }
    return parts[0] + "/" + parts[1];
}

fun remoteRepo(remote: str) > result\Result::<str> {
    try {
        final repo = slug(remote, host: apiHost(apiBase()));
        if (repo == "") {
            return result\fail::<str>("github: the remote '{remote}' is not a {apiHost(apiBase())} repository");
        }
        return result\ok::<str>(repo);
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: remoteRepo");
    }
}

// escape percent-encodes s for a URL path segment or query value.
fun escape(s: str) > str {
    final hex = s.hex();
    var encoded = "";
    var i = 0;
    while (i < s.len()) {
        final b = s.byte(i);
        if ((b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 45 or b == 46 or b == 95 or b == 126) {
            encoded = encoded + s.sub(i, len: 1);
        } else {
            encoded = encoded + "%" + hex.sub(2 * i, len: 2);
        }
        i = i + 1;
    }
    return encoded;
}

// readRef prefers the write credential where the job holds it, so apply reads with the
// token it merges with.
fun readRef() > str {
    if (getenv(WRITE_REF) != "") {
        return WRITE_REF;
    }
    return READ_REF;
}

fun headers(ref: str) > {str: str} {
    return {
        "Authorization": "Bearer " + getenv(ref),
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    };
}

// reading and writing fail with the variable's name when the credential is missing, and
// return the headers to call with.
fun reading(op: str) > result\Result::<{str: str}> {
    try {
        final ref = readRef();
        if (getenv(ref) == "") {
            return result\fail::<{str: str}>("github: {op} needs {READ_REF} or {WRITE_REF}, and neither is set");
        }
        return result\ok::<{str: str}>(headers(ref));
    } catch (err: any) {
        return result\caught::<{str: str}>(err, doing: "github: reading");
    }
}

fun writing(op: str) > result\Result::<{str: str}> {
    try {
        if (getenv(WRITE_REF) == "") {
            return result\fail::<{str: str}>("github: {op} writes, and needs {WRITE_REF}, the apply job's credential; it is not set");
        }
        return result\ok::<{str: str}>(headers(WRITE_REF));
    } catch (err: any) {
        return result\caught::<{str: str}>(err, doing: "github: writing");
    }
}

fun get(url: str, hdrs: {str: str}) > result\Result::<{str: any}> {
    try {
        return result\ok::<{str: any}>(mergequeue\request("GET", url: url, body: "", headers: hdrs));
    } catch (err: any) {
        return result\caught::<{str: any}>(err, doing: "github: get");
    }
}

fun post(url: str, body: str, hdrs: {str: str}) > result\Result::<{str: any}> {
    try {
        return result\ok::<{str: any}>(mergequeue\request("POST", url: url, body: body, headers: hdrs));
    } catch (err: any) {
        return result\caught::<{str: any}>(err, doing: "github: post");
    }
}

fun expect(res: result\Result::<{str: any}>, status: int, what: str) > result\Result::<str> {
    if (res.error -> err) {
        return result\Result::<str>{ error = err };
    }
    final answer = res.value!;
    if (answer["status"] != status) {
        return result\fail::<str>("github: {what}: HTTP {answer["status"]}: {answer["body"]}");
    }
    return result\ok::<str>("{answer["body"]}");
}

// graphqlURL derives the GraphQL endpoint from the REST one: github.com serves it beside
// the REST root, an Enterprise appliance at /api/graphql beside /api/v3.
fun graphqlURL(base: str) > str {
    if (base.endsWith("/api/v3")) {
        return base.sub(0, len: base.len() - 2) + "graphql";
    }
    return base + "/graphql";
}

fun graphql(query: str, variables: any, hdrs: {str: str}) > result\Result::<str> {
    try {
        final posted = expect(post(graphqlURL(apiBase()), body: serialize\jsonEncode({"query": query, "variables": variables}), hdrs: hdrs), status: 200, what: "GraphQL");
        if (posted.error -> err) {
            return result\Result::<str>{ error = err };
        }
        final body = posted.value!;
        final errs = serialize\jsonDecode(body).q("errors").listValue();
        if (errs.len() > 0) {
            return result\fail::<str>("github: GraphQL: {errs[0].q("message").stringValue()}");
        }
        return result\ok::<str>(body);
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: graphql");
    }
}

// pages reads a paged REST listing to its end: GitHub signals the end with a short page.
fun pages(url: str, what: str, hdrs: {str: str}) > result\Result::<[str]> {
    try {
        final bodies = mut [<str>];
        var page = 1;
        while (true) {
            final read = expect(get(url + "&per_page=100&page={page}", hdrs: hdrs), status: 200, what: what);
            if (read.error -> err) {
                return result\Result::<[str]>{ error = err };
            }
            final body = read.value!;
            bodies.append(body);
            if (serialize\jsonDecode(body).listValue().len() < 100) {
                break;
            }
            page = page + 1;
        }
        return result\ok::<[str]>(bodies);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "github: pages");
    }
}

// describeFrom reads the merge methods a repository allows, narrowed by every active
// ruleset rule the base branch's rules carry: a "pull_request" rule's
// allowed_merge_methods intersects the settings, and a "required_linear_history" rule
// rules out "merge". GitHub merges a stack in one call and needs each stacked branch
// linear on the one below.
//
// GitHub sends the allow_* settings only to a token with push access, so a read-only
// token's describe starts from every method and needs a ruleset to name the allowed ones.
fun describeFrom(body: str, rules: str, setup: any, committer: any) > result\Result::<any> {
    try {
        final r = serialize\jsonDecode(body);
        final settingsKnown = r.q("allow_squash_merge").boolean() != null;
        var methods = mut [<str>];
        if (!settingsKnown or r.q("allow_merge_commit").booleanValue()) {
            methods.append("merge");
        }
        if (!settingsKnown or r.q("allow_squash_merge").booleanValue()) {
            methods.append("squash");
        }
        if (!settingsKnown or r.q("allow_rebase_merge").booleanValue()) {
            methods.append("rebase");
        }
        var named = false;
        var linear = false;
        foreach (rule in serialize\jsonDecode(rules).listValue()) {
            final kind = rule.q("type").stringValue();
            if (kind == "required_linear_history") {
                linear = true;
            } else if (kind == "pull_request") {
                final allowed = rule.q("parameters").q("allowed_merge_methods").listValue();
                if (allowed.len() > 0) {
                    named = true;
                    final names = mut [<str>];
                    foreach (m in allowed) {
                        names.append(m.stringValue().lower());
                    }
                    final kept = mut [<str>];
                    foreach (m in methods) {
                        if (names.indexOf(m) != null) {
                            kept.append(m);
                        }
                    }
                    methods = kept;
                }
            }
        }
        if (linear) {
            final kept = mut [<str>];
            foreach (m in methods) {
                if (m != "merge") {
                    kept.append(m);
                }
            }
            methods = kept;
        }
        if (!settingsKnown and !named) {
            return result\fail::<any>("github: describe: the token cannot read the repository's merge settings (they need push access), and no ruleset on the base branch names the allowed merge methods");
        }
        if (methods.len() == 0) {
            return result\fail::<any>("github: describe: the repository settings and its rulesets on the base branch allow no merge method in common");
        }
        final approvals = requiredFrom(rules);
        if (approvals.error -> err) {
            return result\Result::<any>{ error = err };
        }
        final caps = mut {<str: any>};
        caps["stackMerge"] = "atomic";
        caps["linearStacks"] = true;
        caps["methods"] = methods;
        caps["requiredApprovals"] = approvals.value!;
        caps["queueLabel"] = QUEUE_LABEL;
        if (committer != null) {
            caps["committer"] = committer;
        }
        if (setup != null) {
            caps["setup"] = setup;
        }
        return result\ok::<any>(caps);
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: describeFrom");
    }
}

// describe reads the setup only when asked for a status context: planning asks for none,
// and its token reads nothing more than it needs. The steps cost three more reads, one
// of them needing checks read, which the apply job's token does not hold.
export fun describe(req: QueueDescribeRequest) > result\Result::<any> {
    try {
        final hdrsRead = reading("describe");
        if (hdrsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final repoRead = remoteRepo(req.remoteURL);
        if (repoRead.error -> err) { return result\Result::<any>{ error = err }; }
        final repo = repoRead.value!;
        final bodyRead = expect(get(apiBase() + "/repos/" + repo, hdrs: hdrs), status: 200, what: "describe {repo}");
        if (bodyRead.error -> err) { return result\Result::<any>{ error = err }; }
        final body = bodyRead.value!;
        final base = req.base;
        final rulesRead = fetchSetup(apiBase() + "/repos/" + repo + "/rules/branches/" + escape(base), what: "read the rules on {base}",
            needs: "metadata read on {repo}", hdrs: hdrs);
        if (rulesRead.error -> err) { return result\Result::<any>{ error = err }; }
        final rules = rulesRead.value!;
        final context = req.statusContext;
        if (context == "") {
            final plain = describeFrom(body, rules: rules, setup: null, committer: null);
            if (plain.error -> err) { return result\Result::<any>{ error = err }; }
            return result\ok::<any>({"capabilities": plain.value!});
        }
        final web = "https://" + apiHost(apiBase());
        final owner = repo.split("/")[0];
        final org = serialize\jsonDecode(body).q("owner").q("type").stringValue() == "Organization";
        final namedRead = parseApp(req.app);
        if (namedRead.error -> err) { return result\Result::<any>{ error = err }; }
        final named = namedRead.value!;
        final slug = named["slug"] ?? "";
        final given = named["id"] ?? "";
        if (slug == "") {
            return result\ok::<any>(refused("github: the merge queue writes only as its own GitHub App, and none is named; register one",
                url: registrationURL(web, repo: repo, org: org), app: "<slug>"));
        }
        final user = get(apiBase() + "/users/" + escape(slug + "[bot]"), hdrs: hdrs);
        if (user.error -> err) { return result\Result::<any>{ error = err }; }
        if (user.value!["status"] == 404) {
            return result\ok::<any>(refused("github: no GitHub App is named {slug}, since GitHub has no user {slug}[bot]; an app's slug ends the address of its settings page, and the apps are listed",
                url: appsPage(web, owner: owner, org: org), app: "<slug>"));
        }
        final userBody = expect(user, status: 200, what: "read the bot of the app {slug}");
        if (userBody.error -> err) { return result\Result::<any>{ error = err }; }
        final botRead = botFrom(slug, user: userBody.value!);
        if (botRead.error -> err) { return result\Result::<any>{ error = err }; }
        final bot = botRead.value!;
        final appRead = readApp(slug, given: given, owner: owner, org: org, hdrs: hdrs);
        if (appRead.error -> err) { return result\Result::<any>{ error = err }; }
        final app = appRead.value;
        if (app == null) {
            var reason = "github: GitHub shows the App ID of the private app {slug} to no token but its own installation's";
            if (org) {
                reason = "github: GitHub shows the App ID of the private app {slug} only to its own installation's token and, once it is installed on {owner}, to an owner of {owner}";
            }
            return result\ok::<any>(refused(reason + "; it is under About on the app's settings page", url: appsPage(web, owner: owner, org: org) + "/" + slug, app: slug + ":<id>"));
        }
        final steps = req.setupSteps;
        final branchRead = fetchSetup(apiBase() + "/repos/" + repo + "/branches/" + escape(base), what: "read the protection of {base}",
            needs: "contents read on {repo}", hdrs: hdrs);
        if (branchRead.error -> err) { return result\Result::<any>{ error = err }; }
        final branch = branchRead.value!;
        final checksRead = requiredChecksFrom(rules, branch: branch);
        if (checksRead.error -> err) { return result\Result::<any>{ error = err }; }
        final checks = checksRead.value!;
        var reports = [<{str: str}>];
        var rulesets = {<str: str>};
        if (steps) {
            final reportsRead = reportsOn(repo, base: base, wanted: checks, hdrs: hdrs);
            if (reportsRead.error -> err) { return result\Result::<any>{ error = err }; }
            reports = reportsRead.value!;
            final rulesetsRead = rulesetNames(repo, checks: checks, hdrs: hdrs);
            if (rulesetsRead.error -> err) { return result\Result::<any>{ error = err }; }
            rulesets = rulesetsRead.value!;
        }
        final at = {"repo": repo, "base": base, "context": context, "web": web};
        final setup = setupFrom(at, repoBody: body, checks: checks, reports: reports, rulesets: rulesets, app: app!, steps: steps);
        if (setup.error -> err) { return result\Result::<any>{ error = err }; }
        final caps = describeFrom(body, rules: rules, setup: setup.value!, committer: bot);
        if (caps.error -> err) { return result\Result::<any>{ error = err }; }
        return result\ok::<any>({"capabilities": caps.value!});
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: describe");
    }
}

// refused is describe declining to describe a setup: reason says what is missing, url
// where GitHub shows it, and app is the app to ask again with.
fun refused(reason: str, url: str, app: str) > any {
    return {"refused": {"reason": reason, "url": url, "app": app}};
}

// parseApp reads the queue's app as a person names it: the GitHub App's slug, followed
// by ":" and its App ID where GitHub hides the app from the token describe reads with.
// Empty names none.
fun parseApp(value: str) > result\Result::<{str: str}> {
    try {
        final cut = value.indexOf(":");
        if (cut == null) {
            return result\ok::<{str: str}>({"slug": value, "id": ""});
        }
        final slug = value.sub(0, len: cut ?? 0);
        final given = value.sub((cut ?? 0) + 1);
        if (slug == "" or !isAppID(given)) {
            return result\fail::<{str: str}>("github: the app '{value}' is not <slug> or <slug>:<App ID>, an App ID being a positive integer with no leading zero");
        }
        return result\ok::<{str: str}>({"slug": slug, "id": given});
    } catch (err: any) {
        return result\caught::<{str: str}>(err, doing: "github: parseApp");
    }
}

// appsPage lists the GitHub Apps owner registered: a user's under their settings, an
// organization's under its own.
fun appsPage(web: str, owner: str, org: bool) > str {
    if (org) {
        return web + "/organizations/" + owner + "/settings/apps";
    }
    return web + "/settings/apps";
}

// isAppID reports whether s is an App ID as GitHub writes one: a positive integer with no
// sign and no leading zero.
fun isAppID(s: str) > bool {
    if (s == "" or s.startsWith("0")) {
        return false;
    }
    var i = 0;
    while (i < s.len()) {
        final b = s.byte(i);
        if (b < 48 or b > 57) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// botFrom is the committer of what the app pushes: its bot user, from user, GitHub's
// record of "<slug>[bot]".
fun botFrom(slug: str, user: str) > result\Result::<{str: str}> {
    try {
        final login = slug + "[bot]";
        return result\ok::<{str: str}>({"name": login, "email": id(serialize\jsonDecode(user).q("id")) + "+" + login + "@users.noreply.github.com"});
    } catch (err: any) {
        return result\caught::<{str: str}>(err, doing: "github: botFrom");
    }
}

// Where queue-apply.yaml reads the queue app's credential from, which setup-magus's
// queue-app-client-id and queue-app-private-key inputs take.
final APP_ENVIRONMENT = "magus-queue";
final APP_VARIABLE = "MAGUS_QUEUE_APP_CLIENT_ID";
final APP_SECRET = "MAGUS_QUEUE_APP_PRIVATE_KEY";
// The queue app's permissions, as the registration URL names them: merge, push update
// commits, post the status, follow validation runs, and merge changes to workflow files.
final APP_PERMISSIONS = "contents=write&pull_requests=write&statuses=write&actions=write&workflows=write";
// The ruleset the printed setup creates. describe updates it in place only while it
// still holds nothing but the queue's own rule.
final RULESET_NAME = "magus merge queue";

// fetchSetup reads url for describe's setup. A 403 or 404 names the permission the read
// needs: a token without it reads the same as a missing resource.
fun fetchSetup(url: str, what: str, needs: str, hdrs: {str: str}) > result\Result::<str> {
    return checkRead(get(url, hdrs: hdrs), what: what, needs: needs);
}

// checkRead is fetchSetup on an answer already read.
fun checkRead(res: result\Result::<{str: any}>, what: str, needs: str) > result\Result::<str> {
    if (res.error -> err) {
        return result\Result::<str>{ error = err };
    }
    final answer = res.value!;
    if (answer["status"] == 403 or answer["status"] == 404) {
        return result\fail::<str>("github: {what}: HTTP {answer["status"]}: either it does not exist or the token lacks {needs}: {answer["body"]}");
    }
    return expect(res, status: 200, what: what);
}

// appFrom reads an app's integration id, client id and name.
fun appFrom(body: str) > result\Result::<{str: str}> {
    try {
        final a = serialize\jsonDecode(body);
        return result\ok::<{str: str}>({"slug": a.q("slug").stringValue(), "id": id(a.q("id")), "client_id": a.q("client_id").stringValue(), "name": a.q("name").stringValue()});
    } catch (err: any) {
        return result\caught::<{str: str}>(err, doing: "github: appFrom");
    }
}

// readApp reads the app slug names, or null when neither GitHub nor given says its id.
// GitHub answers GET /apps/<slug> for a private app with 404 to every token but the
// app's own installation's, its owner's included; an organization's owner still lists
// the apps installed there. given is the id the person named, which GitHub's own answer
// must match. What GitHub hides, the app's name and client id, stays empty.
fun readApp(slug: str, given: str, owner: str, org: bool, hdrs: {str: str}) > result\Result::<{str: str}?> {
    try {
        final res = get(apiBase() + "/apps/" + escape(slug), hdrs: hdrs);
        if (res.error -> err) {
            return result\Result::<{str: str}?>{ error = err };
        }
        if (res.value!["status"] != 404) {
            final appBody = checkRead(res, what: "read the app {slug}", needs: "access to it");
            if (appBody.error -> err) {
                return result\Result::<{str: str}?>{ error = err };
            }
            final appRead = appFrom(appBody.value!);
            if (appRead.error -> err) {
                return result\Result::<{str: str}?>{ error = err };
            }
            final app = appRead.value!;
            if (given != "" and given != (app["id"] ?? "")) {
                return result\fail::<{str: str}?>("github: describe: the app {slug} is App ID {app["id"] ?? ""}, and the id given is {given}");
            }
            return result\ok::<{str: str}?>(app);
        }
        var found = given;
        if (found == "" and org) {
            final installed = installedAppID(owner, slug: slug, hdrs: hdrs);
            if (installed.error -> err) {
                return result\Result::<{str: str}?>{ error = err };
            }
            found = installed.value!;
        }
        if (found == "") {
            return result\ok::<{str: str}?>(null);
        }
        return result\ok::<{str: str}?>({"slug": slug, "id": found, "client_id": "", "name": ""});
    } catch (err: any) {
        return result\caught::<{str: str}?>(err, doing: "github: readApp");
    }
}

// installedAppID is the App ID of the app slug installed on the organization org, or ""
// when it is not installed there or the token is not an owner's, which GitHub answers
// with 404.
fun installedAppID(org: str, slug: str, hdrs: {str: str}) > result\Result::<str> {
    try {
        var found = "";
        var page = 1;
        while (found == "") {
            final res = get(apiBase() + "/orgs/" + escape(org) + "/installations?per_page=100&page={page}", hdrs: hdrs);
            if (res.error -> err) {
                return result\Result::<str>{ error = err };
            }
            if (res.value!["status"] == 404) {
                break;
            }
            final listed = checkRead(res, what: "list the apps installed on {org}", needs: "an owner's read:org on {org}");
            if (listed.error -> err) {
                return result\Result::<str>{ error = err };
            }
            final installations = serialize\jsonDecode(listed.value!).q("installations").listValue();
            foreach (i in installations) {
                if (i.q("app_slug").stringValue() == slug) {
                    found = id(i.q("app_id"));
                }
            }
            if (installations.len() < 100) {
                break;
            }
            page = page + 1;
        }
        return result\ok::<str>(found);
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: installedAppID");
    }
}

// requiredChecksFrom reads the checks the base requires from its rulesets (rules, which
// name the ruleset each came from) and its classic branch protection (branch), once per
// context, integration and ruleset: each ruleset holding the queue's context needs its
// own pin. An integration of "" accepts a status from anyone.
fun requiredChecksFrom(rules: str, branch: str) > result\Result::<[{str: str}]> {
    try {
        final seen = mut {<str: bool>};
        final checks = mut [<{str: str}>];
        foreach (rule in serialize\jsonDecode(rules).listValue()) {
            if (rule.q("type").stringValue() != "required_status_checks") {
                continue;
            }
            foreach (c in rule.q("parameters").q("required_status_checks").listValue()) {
                final check = {"context": c.q("context").stringValue(), "integration": id(c.q("integration_id")), "ruleset": id(rule.q("ruleset_id"))};
                final key = "{check["context"] ?? ""} {check["integration"] ?? ""} {check["ruleset"] ?? ""}";
                if (seen[key] == null) {
                    seen[key] = true;
                    checks.append(check);
                }
            }
        }
        final classic = serialize\jsonDecode(branch).q("protection").q("required_status_checks");
        final pinned = classic.q("checks").listValue();
        foreach (c in pinned) {
            var integration = id(c.q("app_id"));
            if (integration == "-1") {
                integration = "";
            }
            final key = "{c.q("context").stringValue()} {integration} ";
            if (seen[key] == null) {
                seen[key] = true;
                checks.append({"context": c.q("context").stringValue(), "integration": integration, "ruleset": ""});
            }
        }
        if (pinned.len() == 0) {
            foreach (c in classic.q("contexts").listValue()) {
                final key = "{c.stringValue()}  ";
                if (seen[key] == null) {
                    seen[key] = true;
                    checks.append({"context": c.stringValue(), "integration": "", "ruleset": ""});
                }
            }
        }
        return result\ok::<[{str: str}]>(checks);
    } catch (err: any) {
        return result\caught::<[{str: str}]>(err, doing: "github: requiredChecksFrom");
    }
}

// reportsFrom pairs each check run on a commit with the event of the workflow run that
// reported it. A check run another app reports belongs to no workflow run and is left out.
fun reportsFrom(checkRuns: str, runs: str) > result\Result::<[{str: str}]> {
    try {
        final suites = mut {<str: str>};
        foreach (r in serialize\jsonDecode(runs).q("workflow_runs").listValue()) {
            suites[id(r.q("check_suite_id"))] = r.q("event").stringValue();
        }
        final seen = mut {<str: bool>};
        final reports = mut [<{str: str}>];
        foreach (c in serialize\jsonDecode(checkRuns).q("check_runs").listValue()) {
            final event = suites[id(c.q("check_suite").q("id"))] ?? "";
            final name = c.q("name").stringValue();
            if (event != "" and seen[name + " " + event] == null) {
                seen[name + " " + event] = true;
                reports.append({"name": name, "event": event});
            }
        }
        return result\ok::<[{str: str}]>(reports);
    } catch (err: any) {
        return result\caught::<[{str: str}]>(err, doing: "github: reportsFrom");
    }
}

// SAMPLED_HEADS bounds how many recent pull request heads describe reads the checks of
// before it settles for having seen none: a head pushed a moment ago has no runs yet.
final SAMPLED_HEADS = 5;

// sampleHeads lists the heads of the most recently updated pull requests from this
// repository into base, newest first: their checks are the ones a pull request here
// reports. A fork's runs are the fork's.
fun sampleHeads(body: str, repo: str) > result\Result::<[str]> {
    try {
        final heads = mut [<str>];
        foreach (pr in serialize\jsonDecode(body).listValue()) {
            if (pr.q("head").q("repo").q("full_name").stringValue() == repo and heads.len() < SAMPLED_HEADS) {
                heads.append(pr.q("head").q("sha").stringValue());
            }
        }
        return result\ok::<[str]>(heads);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "github: sampleHeads");
    }
}

// reportsOn reads which events report which checks on the newest pull request head that
// carries one of the required checks (wanted), else on the newest that carries any: a
// head whose runs have not finished carries only some of them.
fun reportsOn(repo: str, base: str, wanted: [{str: str}], hdrs: {str: str}) > result\Result::<[{str: str}]> {
    try {
        final prefix = apiBase() + "/repos/" + repo;
        final pulls = fetchSetup(prefix + "/pulls?state=all&base=" + escape(base) + "&sort=updated&direction=desc&per_page=20",
            what: "list pull requests into {base}", needs: "pull requests read on {repo}", hdrs: hdrs);
        if (pulls.error -> err) {
            return result\Result::<[{str: str}]>{ error = err };
        }
        final headsRead = sampleHeads(pulls.value!, repo: repo);
        if (headsRead.error -> err) {
            return result\Result::<[{str: str}]>{ error = err };
        }
        var chosen = "";
        var chosenRuns = "";
        foreach (head in headsRead.value!) {
            final checkRunsRead = fetchSetup(prefix + "/commits/" + head + "/check-runs?per_page=100", what: "list the checks on {head}",
                needs: "checks read on {repo}", hdrs: hdrs);
            if (checkRunsRead.error -> err) {
                return result\Result::<[{str: str}]>{ error = err };
            }
            final checkRuns = checkRunsRead.value!;
            final carriesRead = carriesRequired(checkRuns, wanted: wanted);
            if (carriesRead.error -> err) {
                return result\Result::<[{str: str}]>{ error = err };
            }
            final carries = carriesRead.value!;
            if (carries or (chosen == "" and serialize\jsonDecode(checkRuns).q("check_runs").listValue().len() > 0)) {
                chosen = head;
                chosenRuns = checkRuns;
            }
            if (carries) {
                break;
            }
        }
        if (chosen == "") {
            return result\ok::<[{str: str}]>([<{str: str}>]);
        }
        final runs = fetchSetup(prefix + "/actions/runs?head_sha=" + chosen + "&per_page=100", what: "list the workflow runs on {chosen}",
            needs: "actions read on {repo}", hdrs: hdrs);
        if (runs.error -> err) {
            return result\Result::<[{str: str}]>{ error = err };
        }
        return reportsFrom(chosenRuns, runs: runs.value!);
    } catch (err: any) {
        return result\caught::<[{str: str}]>(err, doing: "github: reportsOn");
    }
}

// carriesRequired reports whether a commit's check runs include one of the required checks.
fun carriesRequired(checkRuns: str, wanted: [{str: str}]) > result\Result::<bool> {
    try {
        foreach (c in serialize\jsonDecode(checkRuns).q("check_runs").listValue()) {
            foreach (w in wanted) {
                if (c.q("name").stringValue() == (w["context"] ?? "")) {
                    return result\ok::<bool>(true);
                }
            }
        }
        return result\ok::<bool>(false);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "github: carriesRequired");
    }
}

// rulesetNames maps each ruleset a required check comes from to its name, and "" when it
// holds anything beyond one required-status-checks rule of one check.
fun rulesetNames(repo: str, checks: [{str: str}], hdrs: {str: str}) > result\Result::<{str: str}> {
    try {
        final names = mut {<str: str>};
        foreach (c in checks) {
            final ruleset = c["ruleset"] ?? "";
            if (ruleset != "" and names[ruleset] == null) {
                final fetched = fetchSetup(apiBase() + "/repos/" + repo + "/rulesets/" + ruleset, what: "read ruleset {ruleset}",
                    needs: "metadata read on {repo}", hdrs: hdrs);
                if (fetched.error -> err) {
                    return result\Result::<{str: str}>{ error = err };
                }
                final own = ownRuleset(fetched.value!);
                if (own.error -> err) {
                    return result\Result::<{str: str}>{ error = err };
                }
                names[ruleset] = own.value!;
            }
        }
        return result\ok::<{str: str}>(names);
    } catch (err: any) {
        return result\caught::<{str: str}>(err, doing: "github: rulesetNames");
    }
}

// ownRuleset returns the ruleset's name when it holds only the queue's rule, else "".
fun ownRuleset(body: str) > result\Result::<str> {
    try {
        final r = serialize\jsonDecode(body);
        final rules = r.q("rules").listValue();
        if (rules.len() != 1 or rules[0].q("type").stringValue() != "required_status_checks"
            or rules[0].q("parameters").q("required_status_checks").listValue().len() != 1) {
            return result\ok::<str>("");
        }
        return result\ok::<str>(r.q("name").stringValue());
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: ownRuleset");
    }
}

fun contextEvents(reports: [{str: str}], context: str) > [str] {
    final events = mut [<str>];
    foreach (r in reports) {
        if ((r["name"] ?? "") == context) {
            events.append(r["event"] ?? "");
        }
    }
    return events;
}

// statusRule is the required-status-checks rule requiring context from integration, with
// strict up-to-date off: the queue validates each change on the base it merges onto.
fun statusRule(context: str, integration: str) > any {
    return {"type": "required_status_checks", "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [{"context": context, "integration_id": std\parseInt(integration) ?? 0}],
    }};
}

fun heredoc(command: str, body: any) > str {
    return command + " --input - <<'EOF'\n" + serialize\jsonEncode(body) + "\nEOF";
}

// pinSteps are the steps that make base require context from credential: a ruleset of
// its own when nothing requires it yet, a rewrite of that ruleset while it holds only
// the queue's rule, else a link to where a person edits it. A context required from
// anyone is pinned too: until it is, anyone with write access can post it.
fun pinSteps(at: {str: str}, checks: [{str: str}], rulesets: {str: str}, credential: {str: str}) > result\Result::<[any]> {
    try {
        final repo = at["repo"] ?? "";
        final context = at["context"] ?? "";
        final want = credential["id"] ?? "";
        var who = want;
        if ((credential["name"] ?? "") != "") {
            who = "{want} ({credential["name"] ?? ""})";
        }
        final steps = mut [<any>];
        var required = false;
        foreach (c in checks) {
            if ((c["context"] ?? "") != context) {
                continue;
            }
            required = true;
            final integration = c["integration"] ?? "";
            if (integration == want) {
                continue;
            }
            final ruleset = c["ruleset"] ?? "";
            final title = "Pin {context} to {who}";
            if (ruleset == "") {
                steps.append({"title": title + " in the branch protection of {at["base"] ?? ""}", "url": "{at["web"] ?? ""}/{repo}/settings/branches"});
            } else if ((rulesets[ruleset] ?? "") == RULESET_NAME) {
                steps.append({"title": title + " in ruleset {ruleset} ({RULESET_NAME})",
                    "command": heredoc("gh api -X PUT repos/{repo}/rulesets/{ruleset}", body: {"rules": [statusRule(context, integration: want)]})});
            } else {
                steps.append({"title": title + " in ruleset {ruleset}", "url": "{at["web"] ?? ""}/{repo}/rules/{ruleset}"});
            }
        }
        if (!required) {
            steps.append({"title": "Require {context} from {who} on {at["base"] ?? ""}, in a ruleset of its own (your other rulesets stay as they are)",
                "command": heredoc("gh api -X POST repos/{repo}/rulesets", body: {
                    "name": RULESET_NAME, "target": "branch", "enforcement": "active",
                    "conditions": {"ref_name": {"include": ["refs/heads/{at["base"] ?? ""}"], "exclude": [<str>]}},
                    "rules": [statusRule(context, integration: want)],
                })});
        }
        return result\ok::<[any]>(steps);
    } catch (err: any) {
        return result\caught::<[any]>(err, doing: "github: pinSteps");
    }
}

// registrationURL pre-fills a GitHub App registration for the queue: private, no webhook,
// the queue's permissions. An organization registers its apps under its own settings.
fun registrationURL(web: str, repo: str, org: bool) > str {
    final owner = repo.split("/")[0];
    var page = web + "/settings/apps/new";
    if (org) {
        page = web + "/organizations/" + owner + "/settings/apps/new";
    }
    return page + "?name=" + escape(owner + "-magus-queue") + "&url=" + escape(web + "/" + repo) + "&public=false&webhook_active=false&" + APP_PERMISSIONS;
}

// keyCommand stores the newest private key of slug downloaded to ~/Downloads in the
// environment, then deletes every downloaded key of slug whether or not storing it
// worked, and lists the environment's secrets. With no key downloaded it stores nothing,
// so a rerun after it succeeded changes nothing. find rather than a glob: zsh fails a
// glob that matches nothing.
fun keyCommand(repo: str, slug: str, appPage: str) > str {
    final keys = "find ~/Downloads -maxdepth 1 -name " + shQuote(slug + ".*.private-key.pem");
    return "(\n"
        + "  pem=$(" + keys + ` -exec ls -t {} + | head -n 1)` + "\n"
        + "  if [ -n \"$pem\" ]; then\n"
        + "    gh secret set {APP_SECRET} --repo {repo} --env {APP_ENVIRONMENT} < \"$pem\"\n"
        + "    " + keys + " -delete\n"
        + "  else\n"
        + "    echo " + shQuote("no {slug} key in ~/Downloads: generate one on {appPage} unless {APP_SECRET} is listed below") + " >&2\n"
        + "  fi\n"
        + "  gh secret ls --repo {repo} --env {APP_ENVIRONMENT}\n"
        + ")";
}

// setupFrom builds describe's setup from what GitHub answered. at carries repo, base,
// context and the web host; app is the queue app's record.
fun setupFrom(at: {str: str}, repoBody: str, checks: [{str: str}], reports: [{str: str}], rulesets: {str: str}, app: {str: str}, steps: bool) > result\Result::<any> {
    try {
        final repo = at["repo"] ?? "";
        final web = at["web"] ?? "";
        final r = serialize\jsonDecode(repoBody);
        final org = r.q("owner").q("type").stringValue() == "Organization";
        final credential = {"id": app["id"] ?? "", "name": app["name"] ?? ""};
        final required = mut [<any>];
        foreach (c in checks) {
            required.append({"context": c["context"] ?? "", "integration": c["integration"] ?? "", "events": contextEvents(reports, context: c["context"] ?? "")});
        }
        final autoMerge = r.q("allow_auto_merge").booleanValue();
        final settings = [{"name": "allow_auto_merge", "value": "{autoMerge}", "want": "true"}];
        final todo = mut [<any>];
        if (!steps) {
            return result\ok::<any>({"statusContext": at["context"] ?? "", "credential": credential, "requiredChecks": required, "settings": settings, "steps": todo});
        }
        if (!autoMerge) {
            todo.append({"title": "Allow auto-merge (Settings > General > Pull Requests > Allow auto-merge)",
                "command": "gh api -X PATCH repos/{repo} -F allow_auto_merge=true"});
        }
        final slug = app["slug"] ?? "";
        final appPage = appsPage(web, owner: repo.split("/")[0], org: org) + "/" + slug;
        final clientID = app["client_id"] ?? "";
        final appRecord = {"slug": slug, "id": app["id"] ?? "", "clientID": clientID,
            "registrationURL": registrationURL(web, repo: repo, org: org), "installURL": web + "/apps/" + slug + "/installations/new",
            "environment": APP_ENVIRONMENT, "variable": APP_VARIABLE, "secret": APP_SECRET};
        todo.append({"title": "Install {slug} on {repo} only", "url": web + "/apps/" + slug + "/installations/new"});
        todo.append({"title": "Create the {APP_ENVIRONMENT} environment, whose secrets only {at["base"] ?? ""} can read, so pull request runs never see the key",
            "command": "gh api -X PUT repos/{repo}/environments/{APP_ENVIRONMENT} -F 'deployment_branch_policy[protected_branches]=false' -F 'deployment_branch_policy[custom_branch_policies]=true'\n" +
                "gh api -X POST repos/{repo}/environments/{APP_ENVIRONMENT}/deployment-branch-policies -f name={at["base"] ?? ""} -f type=branch"});
        if (clientID == "") {
            todo.append({"title": "Store the app's client id, under About on {appPage}; gh asks for it", "command": "gh variable set {APP_VARIABLE} --repo {repo}"});
        } else {
            todo.append({"title": "Store the app's client id", "command": "gh variable set {APP_VARIABLE} --repo {repo} --body {shQuote(clientID)}"});
        }
        todo.append({"title": "Generate a private key on {appPage} (a .pem downloads), store it in the environment alone, and delete the download",
            "command": keyCommand(repo, slug: slug, appPage: appPage)});
        final pins = pinSteps(at, checks: checks, rulesets: rulesets, credential: credential);
        if (pins.error -> err) {
            return result\Result::<any>{ error = err };
        }
        foreach (s in pins.value!) {
            todo.append(s);
        }
        return result\ok::<any>({"statusContext": at["context"] ?? "", "credential": credential, "requiredChecks": required, "settings": settings, "app": appRecord, "steps": todo});
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: setupFrom");
    }
}

// id reads an identifier GitHub may send as a number or a string.
fun id(b: serialize\Boxed) > str {
    final s = b.stringValue();
    if (s != "") {
        return s;
    }
    final n = b.integerValue();
    if (n == 0) {
        return "";
    }
    return "{n}";
}

// queueLabel returns the "merge-queue: <method>" label on pr, or "".
fun queueLabel(pr: serialize\Boxed) > str {
    foreach (l in pr.q("labels").listValue()) {
        final name = l.q("name").stringValue();
        if (name.startsWith(QUEUE_LABEL) and METHODS.indexOf(queueMethod(name)) != null) {
            return name;
        }
    }
    return "";
}

fun queueMethod(label: str) > str {
    return label.sub(QUEUE_LABEL.len());
}

// stackTops lists the stacks whose top pull request carries a queue label, on base:
// {stack, number, label, method}. Whoever applied the label is checked separately.
fun stackTops(pages: [str], base: str) > result\Result::<[{str: str}]> {
    try {
        final tops = mut [<{str: str}>];
        foreach (page in pages) {
            foreach (pr in serialize\jsonDecode(page).listValue()) {
                final stack = pr.q("stack");
                final sid = id(stack.q("id"));
                if (sid == "" or stack.q("position").integerValue() != stack.q("size").integerValue()) {
                    continue;
                }
                if (stack.q("base").q("ref").stringValue() != base) {
                    continue;
                }
                final label = queueLabel(pr);
                if (label == "") {
                    continue;
                }
                tops.append({"stack": sid, "number": "{pr.q("number").integerValue()}", "label": label, "method": queueMethod(label)});
            }
        }
        return result\ok::<[{str: str}]>(tops);
    } catch (err: any) {
        return result\caught::<[{str: str}]>(err, doing: "github: stackTops");
    }
}

// labeledSingles lists the pull requests on base outside any stack that carry a queue
// label and no auto-merge: {number, label, method}. Whoever applied the label is checked
// separately, as for a stack top.
fun labeledSingles(pages: [str], base: str) > result\Result::<[{str: str}]> {
    try {
        final singles = mut [<{str: str}>];
        foreach (page in pages) {
            foreach (pr in serialize\jsonDecode(page).listValue()) {
                if (id(pr.q("stack").q("id")) != "" or pr.q("base").q("ref").stringValue() != base
                    or pr.q("auto_merge").q("merge_method").stringValue() != "") {
                    continue;
                }
                final label = queueLabel(pr);
                if (label != "") {
                    singles.append({"number": "{pr.q("number").integerValue()}", "label": label, "method": queueMethod(label)});
                }
            }
        }
        return result\ok::<[{str: str}]>(singles);
    } catch (err: any) {
        return result\caught::<[{str: str}]>(err, doing: "github: labeledSingles");
    }
}

// stackTopIn finds, in listing pages, the top pull request of stack sid: {number, label},
// both "" when the stack has no open top.
fun stackTopIn(pages: [str], sid: str) > result\Result::<{str: str}> {
    try {
        foreach (page in pages) {
            foreach (pr in serialize\jsonDecode(page).listValue()) {
                final stack = pr.q("stack");
                if (id(stack.q("id")) == sid and stack.q("position").integerValue() == stack.q("size").integerValue()) {
                    return result\ok::<{str: str}>({"number": "{pr.q("number").integerValue()}", "label": queueLabel(pr)});
                }
            }
        }
        return result\ok::<{str: str}>({"number": "", "label": ""});
    } catch (err: any) {
        return result\caught::<{str: str}>(err, doing: "github: stackTopIn");
    }
}

fun openPulls(repo: str, hdrs: {str: str}) > result\Result::<[str]> {
    return pages(apiBase() + "/repos/" + repo + "/pulls?state=open&sort=created&direction=asc", what: "list pull requests", hdrs: hdrs);
}

// changesFrom reads the open pull requests into change records: every non-draft one
// against base with auto-merge enabled or in labeled (number to method), and every
// member of a stack in stacks (stack id to method), each naming the member below it as
// its parent. A fork is listed with fork set and no branch, so the queue refuses it by
// name instead of skipping it silently.
fun changesFrom(pages: [str], repo: str, base: str, stacks: {str: str}, labeled: {str: str}) > result\Result::<[any]> {
    try {
        // stack id + "/" + position -> number, to name each member's parent
        final positions = mut {<str: str>};
        foreach (page in pages) {
            foreach (pr in serialize\jsonDecode(page).listValue()) {
                final sid = id(pr.q("stack").q("id"));
                if (sid != "") {
                    positions["{sid}/{pr.q("stack").q("position").integerValue()}"] = "{pr.q("number").integerValue()}";
                }
            }
        }
        final queued = mut [<any>];
        foreach (page in pages) {
            foreach (pr in serialize\jsonDecode(page).listValue()) {
                if (pr.q("draft").booleanValue()) {
                    continue;
                }
                final number = pr.q("number").integerValue();
                final sid = id(pr.q("stack").q("id"));
                var method = pr.q("auto_merge").q("merge_method").stringValue();
                if (method == "" and sid == "") {
                    method = labeled["{number}"] ?? "";
                }
                var target = pr.q("base").q("ref").stringValue();
                var parent = "";
                if (sid != "" and stacks[sid] != null) {
                    method = stacks[sid] ?? "";
                    target = pr.q("stack").q("base").q("ref").stringValue();
                    parent = positions["{sid}/{pr.q("stack").q("position").integerValue() - 1}"] ?? "";
                } else if (method == "" or target != base) {
                    continue;
                }
                final sameRepo = pr.q("head").q("repo").q("full_name").stringValue() == repo;
                queued.append({
                    "id": "{number}",
                    "repo": repo,
                    "head": pr.q("head").q("sha").stringValue(),
                    "ref": "refs/pull/{number}/head",
                    "branch": if (sameRepo) pr.q("head").q("ref").stringValue() else "",
                    "base": target,
                    "title": pr.q("title").stringValue(),
                    "author": pr.q("user").q("login").stringValue(),
                    "fork": !sameRepo,
                    "method": method.lower(),
                    "parent": parent,
                });
            }
        }
        return result\ok::<[any]>(queued);
    } catch (err: any) {
        return result\caught::<[any]>(err, doing: "github: changesFrom");
    }
}

// labelNames reads the names of the labels on a pull request or an issue.
fun labelNames(item: serialize\Boxed) > [str] {
    final names = mut [<str>];
    foreach (l in item.q("labels").listValue()) {
        names.append(l.q("name").stringValue());
    }
    return names;
}

// markIn is the mark names show, one of MARKS or "".
fun markIn(names: [str]) > str {
    foreach (m in MARKS) {
        if (names.indexOf(MARK_LABELS[m] ?? "") != null) {
            return m;
        }
    }
    return "";
}

// markOps is what leaves a pull request labeled names showing want's label and no other
// mark's, in order: [{op: "add" or "remove", label}]. want "" removes every one, and the
// intent label too: the queue marks none only a pull request that left it.
fun markOps(names: [str], want: str) > [{str: str}] {
    final ops = mut [<{str: str}>];
    foreach (m in MARKS) {
        final label = MARK_LABELS[m] ?? "";
        final has = names.indexOf(label) != null;
        if (m == want and !has) {
            ops.append({"op": "add", "label": label});
        } else if (m != want and has) {
            ops.append({"op": "remove", "label": label});
        }
    }
    if (want == "") {
        foreach (m in METHODS) {
            if (names.indexOf(QUEUE_LABEL + m) != null) {
                ops.append({"op": "remove", "label": QUEUE_LABEL + m});
            }
        }
    }
    return ops;
}

// closedQuery searches repo for closed pull requests showing any queue label, status or
// intent, in one query: GitHub reads comma-separated label values as any of them.
fun closedQuery(repo: str) > str {
    final labels = mut [<str>];
    foreach (m in MARKS) {
        labels.append("\"{MARK_LABELS[m] ?? ""}\"");
    }
    foreach (m in METHODS) {
        labels.append("\"{QUEUE_LABEL}{m}\"");
    }
    return "repo:{repo} is:pr is:closed label:" + labels.join(",");
}

// closedFrom reads search result pages into the closed pull requests apply unlabels.
fun closedFrom(pages: [str], repo: str) > result\Result::<[any]> {
    try {
        final closed = mut [<any>];
        foreach (page in pages) {
            foreach (item in serialize\jsonDecode(page).q("items").listValue()) {
                closed.append({"id": "{item.q("number").integerValue()}", "repo": repo});
            }
        }
        return result\ok::<[any]>(closed);
    } catch (err: any) {
        return result\caught::<[any]>(err, doing: "github: closedFrom");
    }
}

// closedPulls pages the search to its end, which a short page signals.
fun closedPulls(repo: str, hdrs: {str: str}) > result\Result::<[str]> {
    try {
        final url = apiBase() + "/search/issues?q=" + escape(closedQuery(repo));
        final bodies = mut [<str>];
        var page = 1;
        while (true) {
            final read = expect(get(url + "&per_page=100&page={page}", hdrs: hdrs), status: 200, what: "search closed pull requests with queue labels");
            if (read.error -> err) {
                return result\Result::<[str]>{ error = err };
            }
            final body = read.value!;
            bodies.append(body);
            if (serialize\jsonDecode(body).q("items").listValue().len() < 100) {
                break;
            }
            page = page + 1;
        }
        return result\ok::<[str]>(bodies);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "github: closedPulls");
    }
}

// unqueuedFrom lists every open pull request queued leaves out, drafts and forks
// included, by id and head: a queued change carrying one of their heads waits. Each
// carries the mark its labels show, so apply can clear a queued mark left behind.
fun unqueuedFrom(pages: [str], repo: str, queued: [any]) > result\Result::<[any]> {
    try {
        final listed = mut {<str: bool>};
        foreach (c in queued) {
            listed["{serialize\Boxed.init(c).q("id").stringValue()}"] = true;
        }
        final unqueued = mut [<any>];
        foreach (page in pages) {
            foreach (pr in serialize\jsonDecode(page).listValue()) {
                final number = "{pr.q("number").integerValue()}";
                if (listed[number] == null) {
                    final sameRepo = pr.q("head").q("repo").q("full_name").stringValue() == repo;
                    unqueued.append({
                        "id": number,
                        "repo": repo,
                        "head": pr.q("head").q("sha").stringValue(),
                        "mark": markIn(labelNames(pr)),
                        "title": pr.q("title").stringValue(),
                        "author": pr.q("user").q("login").stringValue(),
                        "branch": if (sameRepo) pr.q("head").q("ref").stringValue() else "",
                        "base": pr.q("base").q("ref").stringValue(),
                    });
                }
            }
        }
        return result\ok::<[any]>(unqueued);
    } catch (err: any) {
        return result\caught::<[any]>(err, doing: "github: unqueuedFrom");
    }
}

// labelerFrom reads, from a page of an issue's timeline, who last applied label.
fun labelerFrom(body: str, label: str) > result\Result::<str> {
    try {
        var who = "";
        foreach (e in serialize\jsonDecode(body).listValue()) {
            if (e.q("event").stringValue() == "labeled" and e.q("label").q("name").stringValue() == label) {
                who = e.q("actor").q("login").stringValue();
            }
        }
        return result\ok::<str>(who);
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: labelerFrom");
    }
}

// labeledByWriter reports whether the last to apply label to pull request number holds
// a role that may queue. A label is triage-level, so the label alone proves nothing. A
// timeline longer than it reads, or a role it cannot look up, proves nothing either, and
// affects that stack alone.
fun labeledByWriter(repo: str, number: str, label: str, hdrs: {str: str}) > result\Result::<bool> {
    try {
        var who = "";
        var page = 1;
        while (true) {
            if (page > TIMELINE_PAGES) {
                return result\ok::<bool>(false);
            }
            final read = expect(get(apiBase() + "/repos/" + repo + "/issues/" + number + "/timeline?per_page=100&page={page}", hdrs: hdrs), status: 200, what: "timeline of #{number}");
            if (read.error -> err) {
                return result\Result::<bool>{ error = err };
            }
            final body = read.value!;
            final labeler = labelerFrom(body, label: label);
            if (labeler.error -> err) {
                return result\Result::<bool>{ error = err };
            }
            final found = labeler.value!;
            if (found != "") {
                who = found;
            }
            if (serialize\jsonDecode(body).listValue().len() < 100) {
                break;
            }
            page = page + 1;
        }
        if (who == "") {
            return result\ok::<bool>(false);
        }
        final res = get(apiBase() + "/repos/" + repo + "/collaborators/" + escape(who) + "/permission", hdrs: hdrs);
        if (res.error -> err) {
            return result\Result::<bool>{ error = err };
        }
        final answer = res.value!;
        if (answer["status"] != 200) {
            return result\ok::<bool>(false);
        }
        return result\ok::<bool>(QUEUE_ROLES.indexOf(serialize\jsonDecode("{answer["body"]}").q("role_name").stringValue()) != null);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "github: labeledByWriter");
    }
}

final MERGED_QUERY = `query($owner: String!, $name: String!, $number: Int!, $after: String) { repository(owner: $owner, name: $name) { pullRequest(number: $number) { commits(first: 100, after: $after) { pageInfo { hasNextPage endCursor } nodes { commit { oid associatedPullRequests(first: 20) { pageInfo { hasNextPage } nodes { number state baseRefName headRefOid mergeCommit { oid parents { totalCount } } } } } } } } } }`;

// mergedFrom reads one page of a pull request's commits into the pull requests merged
// into base whose head is one of those commits. A merge commit has two parents; anything
// else is read as a squash, since a rebase of one commit looks the same from here.
fun mergedFrom(body: str, base: str) > result\Result::<[any]> {
    try {
        final commits = serialize\jsonDecode(body).q("data").q("repository").q("pullRequest").q("commits");
        final merged = mut [<any>];
        foreach (n in commits.q("nodes").listValue()) {
            final c = n.q("commit");
            final prs = c.q("associatedPullRequests");
            if (prs.q("pageInfo").q("hasNextPage").booleanValue()) {
                return result\fail::<[any]>("github: commit {c.q("oid").stringValue()} belongs to more pull requests than one page lists");
            }
            foreach (pr in prs.q("nodes").listValue()) {
                final commit = pr.q("mergeCommit").q("oid").stringValue();
                if (pr.q("state").stringValue() != "MERGED" or pr.q("baseRefName").stringValue() != base or commit == "" or pr.q("headRefOid").stringValue() != c.q("oid").stringValue()) {
                    continue;
                }
                merged.append({
                    "id": "{pr.q("number").integerValue()}",
                    "head": pr.q("headRefOid").stringValue(),
                    "commit": commit,
                    "method": if (pr.q("mergeCommit").q("parents").q("totalCount").integerValue() > 1) "merge" else "squash",
                });
            }
        }
        return result\ok::<[any]>(merged);
    } catch (err: any) {
        return result\caught::<[any]>(err, doing: "github: mergedFrom");
    }
}

// nextPage is the cursor of the page after the one in body, "" at the end.
fun nextPage(body: str) > result\Result::<str> {
    try {
        final info = serialize\jsonDecode(body).q("data").q("repository").q("pullRequest").q("commits").q("pageInfo");
        if (info.q("hasNextPage").booleanValue()) {
            return result\ok::<str>(info.q("endCursor").stringValue());
        }
        return result\ok::<str>("");
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: nextPage");
    }
}

// mergedUnder lists the pull requests merged into base whose head a queued change
// carries, each once.
fun mergedUnder(repo: str, base: str, queued: [any], hdrs: {str: str}) > result\Result::<[any]> {
    try {
        final parts = repo.split("/");
        final seen = mut {<str: bool>};
        final found = mut [<any>];
        foreach (c in queued) {
            final change = serialize\Boxed.init(c);
            if (change.q("fork").booleanValue()) {
                continue;
            }
            var after = "";
            while (true) {
                final vars = mut {<str: any>};
                vars["owner"] = parts[0];
                vars["name"] = parts[1];
                vars["number"] = std\parseInt(change.q("id").stringValue()) ?? 0;
                if (after != "") {
                    vars["after"] = after;
                }
                final queried = graphql(MERGED_QUERY, variables: vars, hdrs: hdrs);
                if (queried.error -> err) {
                    return result\Result::<[any]>{ error = err };
                }
                final body = queried.value!;
                final page = mergedFrom(body, base: base);
                if (page.error -> err) {
                    return result\Result::<[any]>{ error = err };
                }
                foreach (m in page.value!) {
                    final key = "{serialize\Boxed.init(m).q("id").stringValue()}";
                    if (seen[key] == null) {
                        seen[key] = true;
                        found.append(m);
                    }
                }
                final next = nextPage(body);
                if (next.error -> err) {
                    return result\Result::<[any]>{ error = err };
                }
                after = next.value!;
                if (after == "") {
                    break;
                }
            }
        }
        return result\ok::<[any]>(found);
    } catch (err: any) {
        return result\caught::<[any]>(err, doing: "github: mergedUnder");
    }
}

// onlyIn is the record mergedUnder reads for pull request number in listing pages, so
// a listing scoped to it reads what it carries alone; none when it is not open.
fun onlyIn(pages: [str], number: str, repo: str) > result\Result::<[any]> {
    try {
        final found = mut [<any>];
        foreach (page in pages) {
            foreach (pr in serialize\jsonDecode(page).listValue()) {
                if ("{pr.q("number").integerValue()}" == number) {
                    found.append({"id": number, "fork": pr.q("head").q("repo").q("full_name").stringValue() != repo});
                }
            }
        }
        return result\ok::<[any]>(found);
    } catch (err: any) {
        return result\caught::<[any]>(err, doing: "github: onlyIn");
    }
}

// list_changes returns the queued pull requests against the base branch, oldest first,
// the merged ones a queued one carries the head of, every other open pull request, and
// the closed ones still showing a queue label. With only, a pull request number, it
// reads the merged ones that one carries instead, and no closed ones: what classifying
// its approvals takes, at one GraphQL query per 100 of its commits rather than per
// queued pull request.
export fun list_changes(req: QueueListChangesRequest) > result\Result::<any> {
    try {
        final hdrsRead = reading("list_changes");
        if (hdrsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final repoRead = remoteRepo(req.remoteURL);
        if (repoRead.error -> err) { return result\Result::<any>{ error = err }; }
        final repo = repoRead.value!;
        final base = req.base;
        final only = req.only;
        final pullsRead = openPulls(repo, hdrs: hdrs);
        if (pullsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final pulls = pullsRead.value!;
        final stacks = mut {<str: str>};
        final topsRead = stackTops(pulls, base: base);
        if (topsRead.error -> err) { return result\Result::<any>{ error = err }; }
        foreach (top in topsRead.value!) {
            final writer = labeledByWriter(repo, number: top["number"] ?? "", label: top["label"] ?? "", hdrs: hdrs);
            if (writer.error -> err) { return result\Result::<any>{ error = err }; }
            if (writer.value!) {
                stacks[top["stack"] ?? ""] = top["method"] ?? "";
            }
        }
        final labeled = mut {<str: str>};
        final singlesRead = labeledSingles(pulls, base: base);
        if (singlesRead.error -> err) { return result\Result::<any>{ error = err }; }
        foreach (single in singlesRead.value!) {
            final writer = labeledByWriter(repo, number: single["number"] ?? "", label: single["label"] ?? "", hdrs: hdrs);
            if (writer.error -> err) { return result\Result::<any>{ error = err }; }
            if (writer.value!) {
                labeled[single["number"] ?? ""] = single["method"] ?? "";
            }
        }
        final changesRead = changesFrom(pulls, repo: repo, base: base, stacks: stacks, labeled: labeled);
        if (changesRead.error -> err) { return result\Result::<any>{ error = err }; }
        final changes = changesRead.value!;
        final unqueuedRead = unqueuedFrom(pulls, repo: repo, queued: changes);
        if (unqueuedRead.error -> err) { return result\Result::<any>{ error = err }; }
        if (only != "") {
            final scoped = onlyIn(pulls, number: only, repo: repo);
            if (scoped.error -> err) { return result\Result::<any>{ error = err }; }
            final mergedScoped = mergedUnder(repo, base: base, queued: scoped.value!, hdrs: hdrs);
            if (mergedScoped.error -> err) { return result\Result::<any>{ error = err }; }
            return result\ok::<any>({"changes": changes, "merged": mergedScoped.value!, "unqueued": unqueuedRead.value!});
        }
        final mergedRead = mergedUnder(repo, base: base, queued: changes, hdrs: hdrs);
        if (mergedRead.error -> err) { return result\Result::<any>{ error = err }; }
        final closedRead = closedPulls(repo, hdrs: hdrs);
        if (closedRead.error -> err) { return result\Result::<any>{ error = err }; }
        final closed = closedFrom(closedRead.value!, repo: repo);
        if (closed.error -> err) { return result\Result::<any>{ error = err }; }
        return result\ok::<any>({"changes": changes, "merged": mergedRead.value!, "unqueued": unqueuedRead.value!, "closed": closed.value!});
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: list_changes");
    }
}

// requiredFrom reads the approvals the base branch's rulesets require.
fun requiredFrom(body: str) > result\Result::<int> {
    try {
        var need = 0;
        foreach (rule in serialize\jsonDecode(body).listValue()) {
            if (rule.q("type").stringValue() == "pull_request") {
                final n = rule.q("parameters").q("required_approving_review_count").integerValue();
                if (n > need) {
                    need = n;
                }
            }
        }
        return result\ok::<int>(need);
    } catch (err: any) {
        return result\caught::<int>(err, doing: "github: requiredFrom");
    }
}

// standingFrom reads each reviewer's latest decisive review from every page of a GraphQL
// pull request's reviews, oldest first, keyed by login, as {state, commit, at, id}: what
// counts, as on GitHub. Only a reviewer who can push to the repository counts at all, as
// GitHub counts toward a required review: anyone can leave an approving review on a
// public repository.
fun standingFrom(pages: [str]) > result\Result::<{str: {str: str}}> {
    try {
        final latest = mut {<str: {str: str}>};
        final nodes = mut [<serialize\Boxed>];
        foreach (page in pages) {
            foreach (r in serialize\jsonDecode(page).q("data").q("repository").q("pullRequest").q("reviews").q("nodes").listValue()) {
                nodes.append(r);
            }
        }
        foreach (r in nodes) {
            final state = r.q("state").stringValue();
            if (state != "APPROVED" and state != "CHANGES_REQUESTED" and state != "DISMISSED") {
                continue;
            }
            // A deleted account has no login, and its review proves nothing either way.
            final who = r.q("author").q("login").stringValue();
            if (who == "" or !r.q("authorCanPushToRepository").booleanValue()) {
                continue;
            }
            latest[who] = {"state": state, "commit": r.q("commit").q("oid").stringValue(), "at": r.q("submittedAt").stringValue(), "id": id(r.q("databaseId"))};
        }
        return result\ok::<{str: {str: str}}>(latest);
    } catch (err: any) {
        return result\caught::<{str: {str: str}}>(err, doing: "github: standingFrom");
    }
}

// approvalFrom decides approval AT commit from the pages of a GraphQL pull-request answer.
//
// Each reviewer's latest decisive review counts, as standingFrom reads it. An approval counts only when it
// was given on commit itself: approving an older commit does not approve what the queue
// tested. When commit lacks them, approved_commit names an older commit that holds enough
// approvals, the one approved most recently (by commit id when two tie), and the queue
// decides whether commit is that one rebased with its diff unchanged. reviewDecision
// covers what rulesets do not show (classic protection, code owners), so any requirement
// it signals needs at least one approval; its APPROVED alone approves nothing, since it
// can stand on a review of an older commit.
fun approvalFrom(pages: [str], commit: str, required: int) > result\Result::<{str: any}> {
    try {
        final pr = serialize\jsonDecode(pages[0]).q("data").q("repository").q("pullRequest");
        final head = pr.q("headRefOid").stringValue();
        if (head == "") {
            return result\fail::<{str: any}>("github: approval_at: the pull request was not found");
        }
        final decision = pr.q("reviewDecision").stringValue();
        var changes = decision == "CHANGES_REQUESTED";
        final at = mut {<str: int>};
        final newestAt = mut {<str: str>};
        final standing = standingFrom(pages);
        if (standing.error -> err) {
            return result\Result::<{str: any}>{ error = err };
        }
        foreach (_, review in standing.value!) {
            final state = review["state"] ?? "";
            if (state == "CHANGES_REQUESTED") {
                changes = true;
            }
            if (state == "APPROVED") {
                final oid = review["commit"] ?? "";
                at[oid] = (at[oid] ?? 0) + 1;
                final when = review["at"] ?? "";
                if (when > (newestAt[oid] ?? "")) {
                    newestAt[oid] = when;
                }
            }
        }
        final approvals = at[commit] ?? 0;
        var need = required;
        if (decision != "" and need < 1) {
            need = 1;
        }
        var reason = "";
        if (changes) {
            reason = "changes requested";
        } else if (approvals < need) {
            reason = "{approvals} of {need} approvals at this commit";
        } else if (decision == "REVIEW_REQUIRED") {
            reason = "a required review is missing";
        }
        var approvedCommit = "";
        if (!changes and approvals < need) {
            var best = "";
            foreach (oid, n in at) {
                if (oid == commit or n < need) {
                    continue;
                }
                final when = newestAt[oid] ?? "";
                final bestWhen = newestAt[best] ?? "";
                if (best == "" or when > bestWhen or (when == bestWhen and oid > best)) {
                    best = oid;
                }
            }
            approvedCommit = best;
        }
        return result\ok::<{str: any}>({"approved": reason == "", "head": head, "reason": reason, "approvedCommit": approvedCommit});
    } catch (err: any) {
        return result\caught::<{str: any}>(err, doing: "github: approvalFrom");
    }
}

// targetFrom reads where a pull request merges and how: a stack member merges on the
// stack's base, and a pull request with auto-merge with the method chosen there, one
// outside a stack with its own queue label's method, else with the one it was queued
// with.
fun targetFrom(body: str, method: str) > result\Result::<{str: str}> {
    try {
        final pr = serialize\jsonDecode(body);
        var base = pr.q("stack").q("base").q("ref").stringValue();
        if (base == "") {
            base = pr.q("base").q("ref").stringValue();
        }
        var m = pr.q("auto_merge").q("merge_method").stringValue().lower();
        final label = queueLabel(pr);
        if (m == "" and label != "" and id(pr.q("stack").q("id")) == "") {
            m = queueMethod(label);
        }
        if (m == "") {
            m = method;
        }
        return result\ok::<{str: str}>({"base": base, "method": m});
    } catch (err: any) {
        return result\caught::<{str: str}>(err, doing: "github: targetFrom");
    }
}

// intent reports whether the pull request in body still carries merge intent: its own
// auto-merge, a queue label on it outside a stack, or, for a stack member, a queue label
// on its stack's open top.
fun intent(body: str, repo: str, hdrs: {str: str}) > result\Result::<bool> {
    try {
        final pr = serialize\jsonDecode(body);
        if (pr.q("auto_merge").q("merge_method").stringValue() != "") {
            return result\ok::<bool>(true);
        }
        final sid = id(pr.q("stack").q("id"));
        if (sid == "") {
            return result\ok::<bool>(queueLabel(pr) != "");
        }
        final pulls = openPulls(repo, hdrs: hdrs);
        if (pulls.error -> err) {
            return result\Result::<bool>{ error = err };
        }
        final topRead = stackTopIn(pulls.value!, sid: sid);
        if (topRead.error -> err) {
            return result\Result::<bool>{ error = err };
        }
        return result\ok::<bool>((topRead.value!["label"] ?? "") != "");
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "github: intent");
    }
}

// sharedFrom lists the open pull requests in pages other than number: the ones sharing
// its head branch, when pages is that branch's listing.
fun sharedFrom(pages: [str], number: str) > result\Result::<[str]> {
    try {
        final shared = mut [<str>];
        foreach (page in pages) {
            foreach (pr in serialize\jsonDecode(page).listValue()) {
                final n = "{pr.q("number").integerValue()}";
                if (n != number) {
                    shared.append(n);
                }
            }
        }
        return result\ok::<[str]>(shared);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "github: sharedFrom");
    }
}

// Backquoted: GraphQL's braces would read as interpolation in a double-quoted string.
final APPROVAL_QUERY = `query($owner: String!, $name: String!, $number: Int!, $after: String) { repository(owner: $owner, name: $name) { pullRequest(number: $number) { headRefOid reviewDecision reviews(first: 100, after: $after) { pageInfo { hasNextPage endCursor } nodes { databaseId state submittedAt authorCanPushToRepository author { login } commit { oid } } } } } }`;

// reviewsNext is the cursor of the reviews page after the one in body, "" at the end.
fun reviewsNext(body: str) > result\Result::<str> {
    try {
        final info = serialize\jsonDecode(body).q("data").q("repository").q("pullRequest").q("reviews").q("pageInfo");
        if (info.q("hasNextPage").booleanValue()) {
            return result\ok::<str>(info.q("endCursor").stringValue());
        }
        return result\ok::<str>("");
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: reviewsNext");
    }
}

// reviewPages reads every page of a pull request's reviews, oldest first, so no review is
// dropped however many there are. A page whose head differs from the first is an error:
// the reviews would then belong to two heads.
fun reviewPages(parts: [str], number: str, hdrs: {str: str}) > result\Result::<[str]> {
    try {
        final bodies = mut [<str>];
        var after = "";
        var head = "";
        while (true) {
            final vars = mut {<str: any>};
            vars["owner"] = parts[0];
            vars["name"] = parts[1];
            vars["number"] = std\parseInt(number) ?? 0;
            if (after != "") {
                vars["after"] = after;
            }
            final queried = graphql(APPROVAL_QUERY, variables: vars, hdrs: hdrs);
            if (queried.error -> err) {
                return result\Result::<[str]>{ error = err };
            }
            final body = queried.value!;
            final at = serialize\jsonDecode(body).q("data").q("repository").q("pullRequest").q("headRefOid").stringValue();
            if (bodies.len() == 0) {
                head = at;
            } else if (at != head) {
                return result\fail::<[str]>("github: #{number} moved from {head} to {at} while its reviews were read");
            }
            bodies.append(body);
            final next = reviewsNext(body);
            if (next.error -> err) {
                return result\Result::<[str]>{ error = err };
            }
            after = next.value!;
            if (after == "") {
                break;
            }
        }
        return result\ok::<[str]>(bodies);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "github: reviewPages");
    }
}

// ownerName splits a change's owner/name repo for GraphQL.
fun ownerName(repo: str, op: str) > result\Result::<[str]> {
    try {
        final parts = repo.split("/");
        if (parts.len() != 2) {
            return result\fail::<[str]>("github: {op} needs an owner/name repo, got '{repo}'");
        }
        return result\ok::<[str]>(parts);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "github: ownerName");
    }
}

export fun approval_at(req: QueueApprovalRequest) > result\Result::<any> {
    try {
        final hdrsRead = reading("approval_at");
        if (hdrsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final repo = req.repo;
        final partsRead = ownerName(repo, op: "approval_at");
        if (partsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final parts = partsRead.value!;
        final number = req.id;
        final prRead = expect(get(apiBase() + "/repos/" + repo + "/pulls/" + number, hdrs: hdrs), status: 200, what: "read #{number}");
        if (prRead.error -> err) { return result\Result::<any>{ error = err }; }
        final prBody = prRead.value!;
        final targetRead = targetFrom(prBody, method: req.method);
        if (targetRead.error -> err) { return result\Result::<any>{ error = err }; }
        final target = targetRead.value!;
        final rulesRead = expect(get(apiBase() + "/repos/" + repo + "/rules/branches/" + escape(target["base"] ?? ""), hdrs: hdrs), status: 200, what: "read the rules on {target["base"] ?? ""}");
        if (rulesRead.error -> err) { return result\Result::<any>{ error = err }; }
        final pagesRead = reviewPages(parts, number: number, hdrs: hdrs);
        if (pagesRead.error -> err) { return result\Result::<any>{ error = err }; }
        final requiredRead = requiredFrom(rulesRead.value!);
        if (requiredRead.error -> err) { return result\Result::<any>{ error = err }; }
        final aRead = approvalFrom(pagesRead.value!, commit: req.commit, required: requiredRead.value!);
        if (aRead.error -> err) { return result\Result::<any>{ error = err }; }
        final a = aRead.value!;
        final pr = serialize\jsonDecode(prBody);
        var shared = [<str>];
        final branch = pr.q("head").q("ref").stringValue();
        final owner = pr.q("head").q("repo").q("owner").q("login").stringValue();
        if (pr.q("head").q("repo").q("full_name").stringValue() == repo and branch != "") {
            final listing = pages(apiBase() + "/repos/" + repo + "/pulls?state=open&head=" + escape(owner + ":" + branch), what: "pull requests from {branch}", hdrs: hdrs);
            if (listing.error -> err) { return result\Result::<any>{ error = err }; }
            final sharedRead = sharedFrom(listing.value!, number: number);
            if (sharedRead.error -> err) { return result\Result::<any>{ error = err }; }
            shared = sharedRead.value!;
        }
        final queued = intent(prBody, repo: repo, hdrs: hdrs);
        if (queued.error -> err) { return result\Result::<any>{ error = err }; }
        return result\ok::<any>({
            "approved": a["approved"], "head": a["head"], "reason": a["reason"], "approvedCommit": a["approvedCommit"],
            "base": target["base"], "method": target["method"], "queued": queued.value!, "branchSharedWith": shared,
        });
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: approval_at");
    }
}

// reviewsFrom reads the head and the approvals standing on a pull request from the same
// GraphQL pages approval_at reads, so both count the same reviews: each push-capable
// reviewer's latest decisive review, kept when it approves.
fun reviewsFrom(pages: [str]) > result\Result::<{str: any}> {
    try {
        final pr = serialize\jsonDecode(pages[0]).q("data").q("repository").q("pullRequest");
        final head = pr.q("headRefOid").stringValue();
        if (head == "") {
            return result\fail::<{str: any}>("github: reviews: the pull request was not found");
        }
        final approving = mut [<{str: str}>];
        final standing = standingFrom(pages);
        if (standing.error -> err) {
            return result\Result::<{str: any}>{ error = err };
        }
        foreach (who, review in standing.value!) {
            if ((review["state"] ?? "") == "APPROVED") {
                approving.append({"id": review["id"] ?? "", "reviewer": who, "commit": review["commit"] ?? ""});
            }
        }
        return result\ok::<{str: any}>({"head": head, "approving": approving});
    } catch (err: any) {
        return result\caught::<{str: any}>(err, doing: "github: reviewsFrom");
    }
}

export fun reviews(req: QueueReviewsRequest) > result\Result::<any> {
    try {
        final hdrsRead = reading("reviews");
        if (hdrsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final partsRead = ownerName(req.repo, op: "reviews");
        if (partsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final pagesRead = reviewPages(partsRead.value!, number: req.id, hdrs: hdrs);
        if (pagesRead.error -> err) { return result\Result::<any>{ error = err }; }
        final read = reviewsFrom(pagesRead.value!);
        if (read.error -> err) { return result\Result::<any>{ error = err }; }
        return result\ok::<any>(read.value!);
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: reviews");
    }
}

// dismissal reads GitHub's answer to a dismissal: "done" on 200, "reread" on 422, which
// GitHub sends for a review that is no longer approving, so the caller reads its state.
// Anything else is an error naming GitHub's reason.
fun dismissal(res: {str: any}, review: str) > result\Result::<str> {
    if (res["status"] == 200) {
        return result\ok::<str>("done");
    }
    if (res["status"] == 422) {
        return result\ok::<str>("reread");
    }
    return result\fail::<str>("github: dismiss review {review}: HTTP {res["status"]}: {res["body"]}");
}

// dismissedFrom reads a review's state after a refused dismissal: one already dismissed,
// by this queue or by hand, is what the dismissal wanted.
fun dismissedFrom(body: str, review: str) > result\Result::<bool> {
    try {
        final state = serialize\jsonDecode(body).q("state").stringValue();
        if (state != "DISMISSED") {
            return result\fail::<bool>("github: dismiss review {review}: GitHub refused it, and it is {state}, not dismissed");
        }
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "github: dismissedFrom");
    }
}

export fun dismiss_review(req: QueueDismissReviewRequest) > result\Result::<Ack> {
    try {
        final hdrsRead = writing("dismiss_review");
        if (hdrsRead.error -> err) { return result\Result::<Ack>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final review = req.review.id;
        final url = apiBase() + "/repos/{req.repo}/pulls/{req.id}/reviews/{escape(review)}";
        final payload = serialize\jsonEncode({"message": req.message, "event": "DISMISS"});
        final res = mergequeue\request("PUT", url: url + "/dismissals", body: payload, headers: hdrs);
        final verdict = dismissal(res, review: review);
        if (verdict.error -> err) { return result\Result::<Ack>{ error = err }; }
        if (verdict.value! == "done") {
            return result\ok::<Ack>(Ack{ ok = true });
        }
        final reread = expect(get(url, hdrs: hdrs), status: 200, what: "read review {review}");
        if (reread.error -> err) { return result\Result::<Ack>{ error = err }; }
        final dismissed = dismissedFrom(reread.value!, review: review);
        if (dismissed.error -> err) { return result\Result::<Ack>{ error = err }; }
        return result\ok::<Ack>(Ack{ ok = dismissed.value! });
    } catch (err: any) {
        return result\caught::<Ack>(err, doing: "github: dismiss_review");
    }
}

// latestRuns lists the ids of the newest workflow run of each workflow in an
// actions/runs listing, newest first: a run started again for the same commit replaces
// the one before it.
fun latestRuns(body: str) > result\Result::<[str]> {
    try {
        final seen = mut {<str: bool>};
        final ids = mut [<str>];
        foreach (r in serialize\jsonDecode(body).q("workflow_runs").listValue()) {
            final workflow = id(r.q("workflow_id"));
            if (seen[workflow] == null) {
                seen[workflow] = true;
                ids.append(id(r.q("id")));
            }
        }
        return result\ok::<[str]>(ids);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "github: latestRuns");
    }
}

// checkState reads a finished job's conclusion as a required check's state: GitHub
// counts only success, a skip and neutral as passing.
fun checkState(status: str, conclusion: str) > str {
    if (status != "completed") {
        return "pending";
    }
    if (["success", "skipped", "neutral"].indexOf(conclusion) != null) {
        return "success";
    }
    return "failure";
}

// checksFrom states each required context at one commit: an Actions job of that name
// from jobs (one jobs listing per run, newest run first), else the commit status of that
// context from status, else pending, since nothing reported it yet.
fun checksFrom(required: [{str: str}], jobs: [str], status: str) > result\Result::<[{str: str}]> {
    try {
        final states = mut {<str: str>};
        foreach (page in jobs) {
            foreach (j in serialize\jsonDecode(page).q("jobs").listValue()) {
                final name = j.q("name").stringValue();
                if (states[name] == null) {
                    states[name] = checkState(j.q("status").stringValue(), conclusion: j.q("conclusion").stringValue());
                }
            }
        }
        foreach (s in serialize\jsonDecode(status).q("statuses").listValue()) {
            final name = s.q("context").stringValue();
            if (states[name] == null) {
                final state = s.q("state").stringValue();
                states[name] = if (state == "error") "failure" else state;
            }
        }
        final seen = mut {<str: bool>};
        final checks = mut [<{str: str}>];
        foreach (r in required) {
            final name = r["context"] ?? "";
            if (seen[name] == null) {
                seen[name] = true;
                checks.append({"name": name, "state": states[name] ?? "pending"});
            }
        }
        return result\ok::<[{str: str}]>(checks);
    } catch (err: any) {
        return result\caught::<[{str: str}]>(err, doing: "github: checksFrom");
    }
}

// required_checks reads the checks the change's base requires, from its rulesets and its
// classic protection, and each one's state at the commit. A job's state comes from the
// commit's workflow runs rather than its check runs, which need a permission (checks)
// the queue's app does not hold; actions and statuses it does.
export fun required_checks(req: QueueRequiredChecksRequest) > result\Result::<any> {
    try {
        final hdrsRead = reading("required_checks");
        if (hdrsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final repo = req.repo;
        final base = req.base;
        final commit = req.commit;
        final prefix = apiBase() + "/repos/" + repo;
        final rulesRead = expect(get(prefix + "/rules/branches/" + escape(base), hdrs: hdrs), status: 200, what: "read the rules on {base}");
        if (rulesRead.error -> err) { return result\Result::<any>{ error = err }; }
        final branchRead = expect(get(prefix + "/branches/" + escape(base), hdrs: hdrs), status: 200, what: "read the protection of {base}");
        if (branchRead.error -> err) { return result\Result::<any>{ error = err }; }
        final runsRead = expect(get(prefix + "/actions/runs?head_sha=" + escape(commit) + "&per_page=100", hdrs: hdrs), status: 200,
            what: "list the workflow runs on {commit}");
        if (runsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final latest = latestRuns(runsRead.value!);
        if (latest.error -> err) { return result\Result::<any>{ error = err }; }
        final jobs = mut [<str>];
        foreach (run in latest.value!) {
            final jobsRead = expect(get(prefix + "/actions/runs/" + run + "/jobs?per_page=100", hdrs: hdrs), status: 200, what: "list the jobs of run {run}");
            if (jobsRead.error -> err) { return result\Result::<any>{ error = err }; }
            jobs.append(jobsRead.value!);
        }
        final statusRead = expect(get(prefix + "/commits/" + escape(commit) + "/status?per_page=100", hdrs: hdrs), status: 200,
            what: "read the statuses on {commit}");
        if (statusRead.error -> err) { return result\Result::<any>{ error = err }; }
        final required = requiredChecksFrom(rulesRead.value!, branch: branchRead.value!);
        if (required.error -> err) { return result\Result::<any>{ error = err }; }
        final checked = checksFrom(required.value!, jobs: jobs, status: statusRead.value!);
        if (checked.error -> err) { return result\Result::<any>{ error = err }; }
        return result\ok::<any>(checked.value!);
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: required_checks");
    }
}

final GREEN_QUERY = `query($owner: String!, $name: String!, $context: String!, $after: String) { repository(owner: $owner, name: $name) { pullRequests(states: OPEN, first: 100, after: $after) { pageInfo { hasNextPage endCursor } nodes { number headRefOid commits(last: 1) { nodes { commit { oid status { context(name: $context) { state } } } } } } } } }`;

// greenFrom reads one page of open pull requests into the ones whose head carries the
// queried status at success: {id, repo, head}.
fun greenFrom(body: str, repo: str) > result\Result::<[any]> {
    try {
        final green = mut [<any>];
        foreach (pr in serialize\jsonDecode(body).q("data").q("repository").q("pullRequests").q("nodes").listValue()) {
            final head = pr.q("headRefOid").stringValue();
            foreach (n in pr.q("commits").q("nodes").listValue()) {
                final c = n.q("commit");
                if (c.q("oid").stringValue() == head and c.q("status").q("context").q("state").stringValue() == "SUCCESS") {
                    green.append({"id": "{pr.q("number").integerValue()}", "repo": repo, "head": head});
                }
            }
        }
        return result\ok::<[any]>(green);
    } catch (err: any) {
        return result\caught::<[any]>(err, doing: "github: greenFrom");
    }
}

// greenNext is the cursor of the page of pull requests after the one in body, "" at
// the end.
fun greenNext(body: str) > result\Result::<str> {
    try {
        final info = serialize\jsonDecode(body).q("data").q("repository").q("pullRequests").q("pageInfo");
        if (info.q("hasNextPage").booleanValue()) {
            return result\ok::<str>(info.q("endCursor").stringValue());
        }
        return result\ok::<str>("");
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: greenNext");
    }
}

// list_green lists every open pull request whose head carries the status at success,
// whatever it targets: a stacked one is retargeted onto the base once the one beneath it
// merges, and a success it carried then would count.
export fun list_green(req: QueueListGreenRequest) > result\Result::<any> {
    try {
        final hdrsRead = reading("list_green");
        if (hdrsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final repoRead = remoteRepo(req.remoteURL);
        if (repoRead.error -> err) { return result\Result::<any>{ error = err }; }
        final repo = repoRead.value!;
        final parts = repo.split("/");
        final green = mut [<any>];
        var after = "";
        while (true) {
            final vars = mut {<str: any>};
            vars["owner"] = parts[0];
            vars["name"] = parts[1];
            vars["context"] = req.context;
            if (after != "") {
                vars["after"] = after;
            }
            final queried = graphql(GREEN_QUERY, variables: vars, hdrs: hdrs);
            if (queried.error -> err) { return result\Result::<any>{ error = err }; }
            final body = queried.value!;
            final page = greenFrom(body, repo: repo);
            if (page.error -> err) { return result\Result::<any>{ error = err }; }
            foreach (g in page.value!) {
                green.append(g);
            }
            final next = greenNext(body);
            if (next.error -> err) { return result\Result::<any>{ error = err }; }
            after = next.value!;
            if (after == "") {
                break;
            }
        }
        return result\ok::<any>(green);
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: list_green");
    }
}

// statusBody is GitHub's commit-status payload. GitHub rejects a description over 140
// bytes, so a long reason is cut rather than losing the status.
fun statusBody(state: str, context: str, description: str) > any {
    var desc = description;
    if (desc.len() > 140) {
        desc = desc.sub(0, len: 137) + "...";
    }
    return {"state": state, "context": context, "description": desc};
}

export fun post_status(req: QueueStatusRequest) > result\Result::<Ack> {
    try {
        final hdrsRead = writing("post_status");
        if (hdrsRead.error -> err) { return result\Result::<Ack>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final url = apiBase() + "/repos/{req.repo}/statuses/{req.commit}";
        final payload = statusBody(req.state, context: req.context, description: req.description);
        final posted = expect(post(url, body: serialize\jsonEncode(payload), hdrs: hdrs), status: 201, what: "post_status");
        if (posted.error -> err) { return result\Result::<Ack>{ error = err }; }
        return result\ok::<Ack>(Ack{ ok = true });
    } catch (err: any) {
        return result\caught::<Ack>(err, doing: "github: post_status");
    }
}

export fun retarget(req: QueueRetargetRequest) > result\Result::<Ack> {
    try {
        final hdrsRead = writing("retarget");
        if (hdrsRead.error -> err) { return result\Result::<Ack>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final url = apiBase() + "/repos/{req.repo}/pulls/{req.id}";
        final res = mergequeue\request("PATCH", url: url, body: serialize\jsonEncode({"base": req.to}), headers: hdrs);
        final checked = expect(result\ok::<{str: any}>(res), status: 200, what: "retarget");
        if (checked.error -> err) { return result\Result::<Ack>{ error = err }; }
        return result\ok::<Ack>(Ack{ ok = true });
    } catch (err: any) {
        return result\caught::<Ack>(err, doing: "github: retarget");
    }
}

// mergeBody builds the merge payload: the method the change was queued and validated
// with, and the title and message its author chose when enabling auto-merge. Pinned to
// commit, so GitHub refuses when the head moved.
//
// A squash always carries an explicit title and message. GitHub's default message lists
// every commit on the branch, which would include an update commit the queue pushed and
// credit its committer as a co-author; message is the change's own commits instead.
fun mergeBody(pr: str, commit: str, method: str, message: str) > result\Result::<any> {
    try {
        if (method == "") {
            return result\fail::<any>("github: merge_change: the change carries no merge method");
        }
        final decoded = serialize\jsonDecode(pr);
        final am = decoded.q("auto_merge");
        final body = mut {<str: any>};
        body["sha"] = commit;
        body["merge_method"] = method;
        var title = am.q("commit_title").stringValue();
        var text = am.q("commit_message").stringValue();
        if (method == "squash") {
            if (title == "") {
                title = "{decoded.q("title").stringValue()} (#{decoded.q("number").integerValue()})";
            }
            if (text == "") {
                text = message;
            }
        }
        if (title != "") {
            body["commit_title"] = title;
        }
        if (text != "") {
            body["commit_message"] = text;
        }
        return result\ok::<any>(body);
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: mergeBody");
    }
}

// merged reports whether the pull request at url merged with commit as its head: a
// merge whose answer was lost to a retried request, not a refusal.
fun merged(url: str, commit: str, hdrs: {str: str}) > result\Result::<bool> {
    try {
        final after = get(url, hdrs: hdrs);
        if (after.error -> err) {
            return result\Result::<bool>{ error = err };
        }
        if (after.value!["status"] != 200) {
            return result\ok::<bool>(false);
        }
        final now = serialize\jsonDecode("{after.value!["body"]}");
        return result\ok::<bool>(now.q("merged").booleanValue() and now.q("head").q("sha").stringValue() == commit);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "github: merged");
    }
}

// movedFrom names the first pinned member of a stack whose head is no longer the one
// it was validated at, "" when none moved.
fun movedFrom(repo: str, through: [QueuePinnedChange], hdrs: {str: str}) > result\Result::<str> {
    try {
        foreach (p in through) {
            final number = p.id;
            final read = expect(get(apiBase() + "/repos/" + repo + "/pulls/" + number, hdrs: hdrs), status: 200, what: "read #{number}");
            if (read.error -> err) {
                return result\Result::<str>{ error = err };
            }
            final pr = serialize\jsonDecode(read.value!);
            if (pr.q("head").q("sha").stringValue() != p.commit) {
                return result\ok::<str>(number);
            }
        }
        return result\ok::<str>("");
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: movedFrom");
    }
}

// awaitFrom decides, from one read of a pull request GitHub's auto-merge should merge at
// commit, what merge_change does next: {next, reason}, next being "merged" once it
// merged there, "wait" while it is open at commit with auto-merge on, and "refuse"
// otherwise, since then neither GitHub nor the queue may merge it.
fun awaitFrom(body: str, commit: str) > result\Result::<{str: str}> {
    try {
        final pr = serialize\jsonDecode(body);
        if (pr.q("head").q("sha").stringValue() != commit) {
            return result\ok::<{str: str}>({"next": "refuse", "reason": "head moved to {pr.q("head").q("sha").stringValue()} before GitHub merged it"});
        }
        if (pr.q("merged").booleanValue()) {
            return result\ok::<{str: str}>({"next": "merged", "reason": ""});
        }
        if (pr.q("state").stringValue() != "open") {
            return result\ok::<{str: str}>({"next": "refuse", "reason": "closed before GitHub merged it"});
        }
        if (pr.q("auto_merge").q("merge_method").stringValue() == "") {
            return result\ok::<{str: str}>({"next": "refuse", "reason": "auto-merge was disabled before GitHub merged it"});
        }
        return result\ok::<{str: str}>({"next": "wait", "reason": ""});
    } catch (err: any) {
        return result\caught::<{str: str}>(err, doing: "github: awaitFrom");
    }
}

// mergedByOther reports whether anyone but app's bot merged the pull request in body:
// GitHub's auto-merge, on behalf of whoever enabled it, or a person. It tells a merge
// the app's call raced apart from one whose answer was lost.
fun mergedByOther(body: str, app: str) > result\Result::<bool> {
    try {
        return result\ok::<bool>(serialize\jsonDecode(body).q("merged_by").q("login").stringValue() != app + "[bot]");
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "github: mergedByOther");
    }
}

// mergeFailure reads GitHub's refusal of a merge call.
fun mergeFailure(res: {str: any}) > result\Result::<any> {
    try {
        return result\ok::<any>({"merged": false, "reason": "HTTP {res["status"]}: {serialize\jsonDecode("{res["body"]}").q("message").stringValue()}"});
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: mergeFailure");
    }
}

// merge_change merges through the API, never by pushing, so branch protection and
// authorship stay GitHub's: a squash is authored by the pull request's author.
//
// A pull request with auto-merge on is GitHub's to merge once the queue's status went
// green, on behalf of whoever enabled auto-merge, so merge_change first waits for that
// (by_provider). If GitHub has not merged it in time, it merges it itself, pinned to
// commit; a merge GitHub made in the meantime still reads as GitHub's.
//
// A stack run (through set) goes through merge-async, which merges every pull request of
// the stack up to this one; GitHub pins only the top's head, so every member's head is
// read first, and the queue checks what merged afterwards. It is polled until this one
// merged.
export fun merge_change(req: QueueMergeRequest) > result\Result::<any> {
    try {
        final hdrsRead = writing("merge_change");
        if (hdrsRead.error -> err) { return result\Result::<any>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final named = parseApp(req.app);
        if (named.error -> err) { return result\Result::<any>{ error = err }; }
        final app = named.value!["slug"] ?? "";
        if (app == "") {
            return result\fail::<any>("github: merge_change merges only as the queue's own GitHub App, and names none");
        }
        final repo = req.repo;
        final url = apiBase() + "/repos/" + repo + "/pulls/{req.id}";
        final commit = req.commit;
        final prRead = expect(get(url, hdrs: hdrs), status: 200, what: "merge_change: read the pull request");
        if (prRead.error -> err) { return result\Result::<any>{ error = err }; }
        final pr = prRead.value!;
        final built = mergeBody(pr, commit: commit, method: req.method, message: req.message);
        if (built.error -> err) { return result\Result::<any>{ error = err }; }
        final payload = serialize\jsonEncode(built.value!);
        final through = req.through;
        if (through.len() == 0) {
            if (serialize\jsonDecode(pr).q("auto_merge").q("merge_method").stringValue() != "") {
                final first = awaitFrom(pr, commit: commit);
                if (first.error -> err) { return result\Result::<any>{ error = err }; }
                var state = first.value!;
                var polls = 0;
                while (state["next"] == "wait" and polls < AUTO_MERGE_POLLS) {
                    os\sleep(AUTO_MERGE_POLL_MS);
                    polls = polls + 1;
                    final reread = expect(get(url, hdrs: hdrs), status: 200, what: "merge_change: read the pull request");
                    if (reread.error -> err) { return result\Result::<any>{ error = err }; }
                    final next = awaitFrom(reread.value!, commit: commit);
                    if (next.error -> err) { return result\Result::<any>{ error = err }; }
                    state = next.value!;
                }
                if (state["next"] == "merged") {
                    return result\ok::<any>({"merged": true, "byProvider": true, "reason": ""});
                }
                if (state["next"] == "refuse") {
                    return result\ok::<any>({"merged": false, "reason": state["reason"] ?? ""});
                }
            }
            final res = mergequeue\request("PUT", url: url + "/merge", body: payload, headers: hdrs);
            if (res["status"] == 200) {
                return result\ok::<any>({"merged": true, "byProvider": false, "reason": ""});
            }
            final now = get(url, hdrs: hdrs);
            if (now.error -> err) { return result\Result::<any>{ error = err }; }
            final seen = now.value!;
            if (seen["status"] == 200) {
                final awaited = awaitFrom("{seen["body"]}", commit: commit);
                if (awaited.error -> err) { return result\Result::<any>{ error = err }; }
                if ((awaited.value!["next"] ?? "") == "merged") {
                    final other = mergedByOther("{seen["body"]}", app: app);
                    if (other.error -> err) { return result\Result::<any>{ error = err }; }
                    return result\ok::<any>({"merged": true, "byProvider": other.value!, "reason": ""});
                }
            }
            return mergeFailure(res);
        }
        final movedRead = movedFrom(repo, through: through, hdrs: hdrs);
        if (movedRead.error -> err) { return result\Result::<any>{ error = err }; }
        final moved = movedRead.value!;
        if (moved != "") {
            return result\ok::<any>({"merged": false, "reason": "#{moved} moved past the head it was validated at"});
        }
        final res = mergequeue\request("PUT", url: url + "/merge-async", body: payload, headers: hdrs);
        // 409 is a merge of this stack already enqueued, which the polls below follow.
        if (res["status"] != 200 and res["status"] != 202 and res["status"] != 409) {
            return mergeFailure(res);
        }
        var polls = 0;
        while (polls < ASYNC_POLLS) {
            final done = merged(url, commit: commit, hdrs: hdrs);
            if (done.error -> err) { return result\Result::<any>{ error = err }; }
            if (done.value!) {
                return result\ok::<any>({"merged": true, "byProvider": false, "reason": ""});
            }
            os\sleep(ASYNC_POLL_MS);
            polls = polls + 1;
        }
        return result\ok::<any>({"merged": false, "reason": "the stack merge did not finish within {ASYNC_POLLS * 5} seconds"});
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: merge_change");
    }
}

// The marker line every kick-back ends with; kick_back minimizes the older comments
// ending with one.
final KICK_MARKER = "<!-- mergequeue: ";
final KICK_MARKER_END = " -->";

// MAX_LISTED bounds the files and the commits a kick-back lists, so a verdict naming
// thousands cannot make a comment GitHub refuses.
final MAX_LISTED = 50;

// kickMarker is the marker line carrying facts as JSON. Every character that could end
// the HTML comment early or mention someone is a JSON escape: only strings in facts
// hold such characters, and an escape reads back as the character.
fun kickMarker(facts: any) > result\Result::<str> {
    try {
        var json = serialize\jsonEncode(facts);
        foreach (esc in [["-", "\\u002d"], ["<", "\\u003c"], [">", "\\u003e"], ["!", "\\u0021"], ["&", "\\u0026"], ["@", "\\u0040"]]) {
            json = json.replace(esc[0], with: esc[1]);
        }
        return result\ok::<str>(KICK_MARKER + json + KICK_MARKER_END);
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: kickMarker");
    }
}

// isKick reports whether a comment body ends with a kick-back's marker line. Only the
// last line counts: a marker quoted anywhere above it is text.
fun isKick(body: str) > bool {
    final lines = body.trim().split("\n");
    final last = lines[lines.len() - 1];
    return last.startsWith(KICK_MARKER) and last.endsWith(KICK_MARKER_END);
}

// listed is the first MAX_LISTED strings of values.
fun listed(values: [str]) > [str] {
    final firsts = mut [<str>];
    foreach (v in values) {
        if (firsts.len() == MAX_LISTED) {
            break;
        }
        firsts.append(v);
    }
    return firsts;
}

// shQuote single-quotes s for sh, so a hook flag's value pastes as one argument.
fun shQuote(s: str) > str {
    return "'" + s.replace("'", with: "'\\''") + "'";
}

// requeueLine is how the author queues the change again: auto-merge with its merge
// method, or, when a label queued it, that label on it or on the stack's top pull
// request. A fork cannot be queued, so it gets none.
fun requeueLine(number: str, method: str, fork: bool, label: str, top: str) > str {
    if (fork) {
        return "";
    }
    if (label != "" and top == number) {
        return "Queue it again once fixed: `gh pr edit {number} --add-label \"{label}\"`";
    }
    if (label != "") {
        return "Queue the stack again once fixed: `gh pr edit {top} --add-label \"{label}\"`";
    }
    return "Queue it again once fixed: `gh pr merge {number} --auto --{method}`";
}

// reproduction is the collapsed block that validates the change again on a person's
// machine, exactly as the run did: the run's plan and the hook lines it ran.
fun reproduction(number: str, run: {str: str}, repoArg: str, base: str, gate: str, regenerate: str) > [str] {
    final dir = "mq-{number}";
    final lines = mut [
        "<details><summary><b>Reproduce locally</b></summary>",
        "",
        "```sh",
        "gh run download {run["id"] ?? ""} -R {repoArg} -n mergequeue-plan -D {dir}",
        "magus queue validate --only {number} --stdin --verdicts {dir}/verdicts < {dir}/plan.json \\",
    ];
    if (regenerate == "") {
        lines.append("  --gate {shQuote(gate)}");
    } else {
        lines.append("  --gate {shQuote(gate)} \\");
        lines.append("  --regenerate {shQuote(regenerate)}");
    }
    lines.append("```");
    lines.append("");
    lines.append("The queue appends the change's affected projects to each hook line. "
        + "Run it in a checkout of `{base}` whose `origin` is {repoArg}; the plan artifact is kept for a day.");
    lines.append("");
    lines.append("</details>");
    return lines;
}

// kickComment renders the kick-back comment from kick_back's record: what failed, why it
// needs regeneration when that is the code, what the run reported, the validation run,
// how to reproduce it, the files at issue, requeue (from requeueLine), and
// last the facts it was rendered from as one JSON line a workflow can read back. web is
// the provider's web root ("https://github.com"). The claim, the paths and the commits
// may come from a job that ran the change's code, so each is shown literally.
fun kickComment(req: QueueKickBackRequest, web: str, requeue: str) > result\Result::<str> {
    try {
        final number = req.id;
        final base = req.base;
        final report = req.report;
        final lines = mut ["### Merge queue: kicked back", "", report.trim()];
        if (req.code == "KICK_REGENERATION") {
            lines.append("");
            lines.append("This is why it carries the label `{MARK_LABELS["needs_regeneration"] ?? ""}`: "
                + "merging it needs generated files regenerated by code it changes, which the queue does not run. "
                + "Merge `{base}` in, regenerate them, and push: then the merge leaves them as they are.");
        }
        final claim = req.claim;
        if (claim != "") {
            lines.append("");
            lines.append("The run reported:");
            lines.append("");
            lines.append(mergequeue\codeBlock(claim).trim());
        }
        final source = req.source;
        if (source != "") {
            final runRead = parseRunSpec(source);
            if (runRead.error -> err) { return result\Result::<str>{ error = err }; }
            final run = runRead.value!;
            final host = apiHost(web);
            var repoArg = run["repo"] ?? "";
            if (host != "github.com") {
                repoArg = host + "/" + repoArg;
            }
            lines.append("");
            lines.append("[Validation run]({web}/{run["repo"] ?? ""}/actions/runs/{run["id"] ?? ""})");
            if (req.reproduce -> repro) {
                if (repro.gate != "") {
                    lines.append("");
                    foreach (line in reproduction(number, run: run, repoArg: repoArg, base: base, gate: repro.gate, regenerate: repro.regenerate)) {
                        lines.append(line);
                    }
                }
            }
        }
        final total = req.paths.len();
        final paths = listed(req.paths);
        final commits = listed(req.with);
        if (total > 0) {
            lines.append("");
            lines.append("<details><summary>Files ({total})</summary>");
            lines.append("");
            foreach (p in paths) {
                lines.append("- " + mergequeue\codeSpan(p));
            }
            if (total > paths.len()) {
                lines.append("- and {total - paths.len()} more");
            }
            if (commits.len() > 0) {
                lines.append("");
                lines.append("Commits on `{base}` that changed them:");
                lines.append("");
                foreach (c in commits) {
                    lines.append("- " + mergequeue\codeSpan(c));
                }
            }
            lines.append("");
            lines.append("</details>");
        }
        if (requeue != "") {
            lines.append("");
            lines.append(requeue);
        }
        lines.append("");
        final marker = kickMarker({
            "code": req.code,
            "paths": paths,
            "with": commits,
            "candidate_commit": req.candidateCommit,
        });
        if (marker.error -> err) { return result\Result::<str>{ error = err }; }
        lines.append(marker.value!);
        return result\ok::<str>(lines.join("\n") + "\n");
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: kickComment");
    }
}

final COMMENTS_QUERY = `query($owner: String!, $name: String!, $number: Int!, $after: String) { repository(owner: $owner, name: $name) { pullRequest(number: $number) { comments(first: 100, after: $after) { pageInfo { hasNextPage endCursor } nodes { id viewerDidAuthor isMinimized body } } } } }`;
final MINIMIZE_COMMENT = `mutation($id: ID!) { minimizeComment(input: {subjectId: $id, classifier: OUTDATED}) { minimizedComment { isMinimized } } }`;

// staleKicks reads one page of a pull request's comments into the ids of the earlier
// kick-backs this credential wrote and nobody minimized yet, keep aside.
fun staleKicks(body: str, keep: str) > result\Result::<[str]> {
    try {
        final ids = mut [<str>];
        foreach (c in serialize\jsonDecode(body).q("data").q("repository").q("pullRequest").q("comments").q("nodes").listValue()) {
            final cid = c.q("id").stringValue();
            if (cid != keep and c.q("viewerDidAuthor").booleanValue() and !c.q("isMinimized").booleanValue()
                and isKick(c.q("body").stringValue())) {
                ids.append(cid);
            }
        }
        return result\ok::<[str]>(ids);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "github: staleKicks");
    }
}

// commentsNext is the cursor of the page of comments after the one in body, "" at the
// end.
fun commentsNext(body: str) > result\Result::<str> {
    try {
        final info = serialize\jsonDecode(body).q("data").q("repository").q("pullRequest").q("comments").q("pageInfo");
        if (info.q("hasNextPage").booleanValue()) {
            return result\ok::<str>(info.q("endCursor").stringValue());
        }
        return result\ok::<str>("");
    } catch (err: any) {
        return result\caught::<str>(err, doing: "github: commentsNext");
    }
}

// minimizeOlder collapses the earlier kick-backs on the pull request as outdated, so
// only the newest reads as current.
fun minimizeOlder(repo: str, number: str, keep: str, hdrs: {str: str}) > result\Result::<bool> {
    try {
        final parts = repo.split("/");
        var after = "";
        while (true) {
            final vars = mut {<str: any>};
            vars["owner"] = parts[0];
            vars["name"] = parts[1];
            vars["number"] = std\parseInt(number) ?? 0;
            if (after != "") {
                vars["after"] = after;
            }
            final queried = graphql(COMMENTS_QUERY, variables: vars, hdrs: hdrs);
            if (queried.error -> err) { return result\Result::<bool>{ error = err }; }
            final body = queried.value!;
            final stale = staleKicks(body, keep: keep);
            if (stale.error -> err) { return result\Result::<bool>{ error = err }; }
            foreach (cid in stale.value!) {
                final minimized = graphql(MINIMIZE_COMMENT, variables: {"id": cid}, hdrs: hdrs);
                if (minimized.error -> err) { return result\Result::<bool>{ error = err }; }
            }
            final next = commentsNext(body);
            if (next.error -> err) { return result\Result::<bool>{ error = err }; }
            after = next.value!;
            if (after == "") {
                return result\ok::<bool>(true);
            }
        }
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "github: minimizeOlder");
    }
}

final DISABLE_AUTO_MERGE = `mutation($id: ID!) { disablePullRequestAutoMerge(input: {pullRequestId: $id}) { clientMutationId } }`;

fun unlabel(repo: str, number: str, label: str, hdrs: {str: str}) > result\Result::<bool> {
    try {
        final res = mergequeue\request("DELETE", url: apiBase() + "/repos/" + repo + "/issues/" + number + "/labels/" + escape(label), body: "", headers: hdrs);
        if (res["status"] != 200 and res["status"] != 404) {
            return result\fail::<bool>("github: remove the label '{label}' from #{number}: HTTP {res["status"]}: {res["body"]}");
        }
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "github: unlabel");
    }
}

// kick_back posts a new comment with the queue's report, then removes the change's merge
// intent where it lives: its own auto-merge, its own queue label, and for a stack member
// the label on its stack's top, which queues the whole stack. The author re-queues after
// a fix. Last it minimizes the earlier kick-backs on the pull request; the comment and
// the removal already happened, so a failure there is printed to stderr (the apply
// job's log) and the kick-back still succeeds.
export fun kick_back(req: QueueKickBackRequest) > result\Result::<Ack> {
    try {
        final hdrsRead = writing("kick_back");
        if (hdrsRead.error -> err) { return result\Result::<Ack>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final repo = req.repo;
        final number = req.id;
        final prRead = expect(get(apiBase() + "/repos/" + repo + "/pulls/" + number, hdrs: hdrs), status: 200, what: "kick_back: read the pull request");
        if (prRead.error -> err) { return result\Result::<Ack>{ error = err }; }
        final decoded = serialize\jsonDecode(prRead.value!);
        final own = queueLabel(decoded);
        final sid = id(decoded.q("stack").q("id"));
        var top = {"number": "", "label": ""};
        if (sid != "") {
            final pulls = openPulls(repo, hdrs: hdrs);
            if (pulls.error -> err) { return result\Result::<Ack>{ error = err }; }
            final topRead = stackTopIn(pulls.value!, sid: sid);
            if (topRead.error -> err) { return result\Result::<Ack>{ error = err }; }
            top = topRead.value!;
        }
        var label = top["label"] ?? "";
        var labeled = top["number"] ?? "";
        if (label == "" and own != "") {
            label = own;
            labeled = number;
        }
        final requeue = requeueLine(number, method: req.method, fork: req.fork, label: label, top: labeled);
        final comment = kickComment(req, web: "https://" + apiHost(apiBase()), requeue: requeue);
        if (comment.error -> err) { return result\Result::<Ack>{ error = err }; }
        final posted = expect(post(apiBase() + "/repos/" + repo + "/issues/" + number + "/comments",
            body: serialize\jsonEncode({"body": comment.value!}), hdrs: hdrs),
            status: 201, what: "kick_back: comment");
        if (posted.error -> err) { return result\Result::<Ack>{ error = err }; }
        if (decoded.q("auto_merge").q("merge_method").stringValue() != "") {
            final disabled = graphql(DISABLE_AUTO_MERGE, variables: {"id": decoded.q("node_id").stringValue()}, hdrs: hdrs);
            if (disabled.error -> err) { return result\Result::<Ack>{ error = err }; }
        }
        if (own != "") {
            final removed = unlabel(repo, number: number, label: own, hdrs: hdrs);
            if (removed.error -> err) { return result\Result::<Ack>{ error = err }; }
        }
        if ((top["label"] ?? "") != "" and (top["number"] ?? "") != number) {
            final removedTop = unlabel(repo, number: top["number"] ?? "", label: top["label"] ?? "", hdrs: hdrs);
            if (removedTop.error -> err) { return result\Result::<Ack>{ error = err }; }
        }
        final minimized = minimizeOlder(repo, number: number, keep: serialize\jsonDecode(posted.value!).q("node_id").stringValue(), hdrs: hdrs);
        if (minimized.error -> failed) {
            std\print("github: kick_back: #{number} was kicked back, but its earlier kick-back comments stay expanded: {failed.message}");
        }
        return result\ok::<Ack>(Ack{ ok = true });
    } catch (err: any) {
        return result\caught::<Ack>(err, doing: "github: kick_back");
    }
}

// createLabel creates label with its description and colour; a label created by adding it
// to a pull request has neither. One the repository already has is left as it is.
fun createLabel(repo: str, label: str, description: str, color: str, hdrs: {str: str}) > result\Result::<bool> {
    try {
        final body = serialize\jsonEncode({"name": label, "description": description, "color": color});
        final res = post(apiBase() + "/repos/" + repo + "/labels", body: body, hdrs: hdrs);
        if (res.error -> err) { return result\Result::<bool>{ error = err }; }
        return labelCreated(label, status: res.value!["status"], body: "{res.value!["body"]}");
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "github: createLabel");
    }
}

// labelCreated accepts GitHub's answer to creating label: created, or refused only
// because the repository already has it. GitHub answers 422 for an invalid label too,
// such as a description over 100 characters, and that fails with its reason.
fun labelCreated(label: str, status: any, body: str) > result\Result::<bool> {
    try {
        if (status == 201) {
            return result\ok::<bool>(true);
        }
        var reason = body;
        if (status == 422) {
            var decoded = serialize\Boxed.init(null);
            try {
                decoded = serialize\jsonDecode(body);
            } catch (e: any) {
                return result\fail::<bool>("github: create the label '{label}': HTTP 422: {body}");
            }
            final errors = decoded.q("errors").listValue();
            final details = mut [<str>];
            var exists = errors.len() > 0;
            foreach (e in errors) {
                final code = e.q("code").stringValue();
                if (code != "already_exists") {
                    exists = false;
                }
                final message = e.q("message").stringValue();
                if (message != "") {
                    details.append(message);
                } else {
                    details.append("{e.q("field").stringValue()} {code}");
                }
            }
            if (exists) {
                return result\ok::<bool>(true);
            }
            reason = decoded.q("message").stringValue();
            if (details.len() > 0) {
                reason = reason + " (" + details.join("; ") + ")";
            }
        }
        return result\fail::<bool>("github: create the label '{label}': HTTP {status}: {reason}");
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "github: labelCreated");
    }
}

// mark leaves the pull request showing the label of req's mark and no other mark's, from
// one read of its labels; a pull request already showing it takes no write.
export fun mark(req: QueueMarkRequest) > result\Result::<Ack> {
    try {
        final hdrsRead = writing("mark");
        if (hdrsRead.error -> err) { return result\Result::<Ack>{ error = err }; }
        final hdrs = hdrsRead.value!;
        final repo = req.repo;
        final number = req.id;
        final want = req.mark;
        final issueRead = expect(get(apiBase() + "/repos/" + repo + "/issues/" + number, hdrs: hdrs), status: 200, what: "mark: read #{number}");
        if (issueRead.error -> err) { return result\Result::<Ack>{ error = err }; }
        final issue = serialize\jsonDecode(issueRead.value!);
        foreach (step in markOps(labelNames(issue), want: want)) {
            final label = step["label"] ?? "";
            if (step["op"] == "remove") {
                final removed = unlabel(repo, number: number, label: label, hdrs: hdrs);
                if (removed.error -> err) { return result\Result::<Ack>{ error = err }; }
            } else {
                final created = createLabel(repo, label: label, description: MARK_DESCRIPTIONS[want] ?? "", color: MARK_COLORS[want] ?? "", hdrs: hdrs);
                if (created.error -> err) { return result\Result::<Ack>{ error = err }; }
                final added = expect(post(apiBase() + "/repos/" + repo + "/issues/" + number + "/labels", body: serialize\jsonEncode({"labels": [label]}), hdrs: hdrs),
                    status: 200, what: "mark: label #{number} '{label}'");
                if (added.error -> err) { return result\Result::<Ack>{ error = err }; }
            }
        }
        return result\ok::<Ack>(Ack{ ok = true });
    } catch (err: any) {
        return result\caught::<Ack>(err, doing: "github: mark");
    }
}

// parseRunSpec reads "<owner>/<name>/runs/<id>" into {repo, id}, or fails.
fun parseRunSpec(spec: str) > result\Result::<{str: str}> {
    try {
        final parts = spec.split("/");
        if (parts.len() != 4 or parts[0] == "" or parts[1] == "" or parts[2] != "runs" or (std\parseInt(parts[3]) ?? 0) < 1) {
            return result\fail::<{str: str}>("github: a run is <owner>/<name>/runs/<id>, got '{spec}'");
        }
        return result\ok::<{str: str}>({"repo": parts[0] + "/" + parts[1], "id": parts[3]});
    } catch (err: any) {
        return result\caught::<{str: str}>(err, doing: "github: parseRunSpec");
    }
}

// artifactsFrom reads one page of a run's artifact listing into {name, url} records.
fun artifactsFrom(body: str, base: str, repo: str) > result\Result::<[any]> {
    try {
        final artifacts = mut [<any>];
        foreach (a in serialize\jsonDecode(body).q("artifacts").listValue()) {
            artifacts.append({"name": a.q("name").stringValue(), "url": base + "/repos/" + repo + "/actions/artifacts/{a.q("id").integerValue()}/zip"});
        }
        return result\ok::<[any]>(artifacts);
    } catch (err: any) {
        return result\caught::<[any]>(err, doing: "github: artifactsFrom");
    }
}

// BRANCH_EVENTS are the events whose run executes the workflow file as the branch it
// ran on holds it. Every pull_request* event runs a file the pull request can change,
// and a fork's run reaches this repository's workflow_run followers all the same.
final BRANCH_EVENTS = ["push", "workflow_dispatch"];

// originFrom reads a run's JSON into the run record list_artifacts returns. repo is the
// repository the source named; a run of any other is an error, not a record.
fun originFrom(body: str, repo: str) > result\Result::<{str: any}> {
    try {
        final run = serialize\jsonDecode(body);
        final own = run.q("repository").q("full_name").stringValue();
        if (own != repo) {
            return result\fail::<{str: any}>("github: run {run.q("id").integerValue()} belongs to '{own}', not '{repo}'");
        }
        final event = run.q("event").stringValue();
        return result\ok::<{str: any}>({
            "repo": own,
            "headRepo": run.q("head_repository").q("full_name").stringValue(),
            "headBranch": run.q("head_branch").stringValue(),
            "event": event,
            "branchEvent": BRANCH_EVENTS.indexOf(event) != null,
            "definition": run.q("path").stringValue(),
        });
    } catch (err: any) {
        return result\caught::<{str: any}>(err, doing: "github: originFrom");
    }
}

// list_artifacts reads the run's status BEFORE listing its artifacts, so a listing that
// says complete holds every artifact the run uploaded. The same read says what started
// the run and what it ran, which the queue checks before it downloads anything. The
// headers carry the read credential for the downloads; the queue drops them on a
// redirect to the storage host.
export fun list_artifacts(req: QueueListArtifactsRequest) > result\Result::<any> {
    try {
        if (getenv(ARTIFACTS_REF) == "") {
            return result\fail::<any>("github: list_artifacts reads with {ARTIFACTS_REF}, the apply job's own token; it is not set");
        }
        final hdrs = headers(ARTIFACTS_REF);
        final runRead = parseRunSpec(req.source);
        if (runRead.error -> err) { return result\Result::<any>{ error = err }; }
        final run = runRead.value!;
        final base = apiBase();
        final prefix = base + "/repos/" + (run["repo"] ?? "") + "/actions/runs/" + (run["id"] ?? "");
        final viewRead = expect(get(prefix, hdrs: hdrs), status: 200, what: "run {run["id"] ?? ""}");
        if (viewRead.error -> err) { return result\Result::<any>{ error = err }; }
        final view = viewRead.value!;
        final originRead = originFrom(view, repo: run["repo"] ?? "");
        if (originRead.error -> err) { return result\Result::<any>{ error = err }; }
        final origin = originRead.value!;
        final status = serialize\jsonDecode(view).q("status").stringValue();
        final artifacts = mut [<any>];
        var page = 1;
        while (true) {
            final bodyRead = expect(get(prefix + "/artifacts?per_page=100&page={page}", hdrs: hdrs), status: 200, what: "artifacts of run {run["id"] ?? ""}");
            if (bodyRead.error -> err) { return result\Result::<any>{ error = err }; }
            final gotRead = artifactsFrom(bodyRead.value!, base: base, repo: run["repo"] ?? "");
            if (gotRead.error -> err) { return result\Result::<any>{ error = err }; }
            final got = gotRead.value!;
            foreach (a in got) {
                artifacts.append(a);
            }
            if (got.len() < 100) {
                break;
            }
            page = page + 1;
        }
        return result\ok::<any>({"run": origin, "complete": status == "completed", "headers": hdrs, "artifacts": artifacts});
    } catch (err: any) {
        return result\caught::<any>(err, doing: "github: list_artifacts");
    }
}

