    static extern fun debug(msg: str = "", fields: {str: str} = {<str: str>}) > void;
    static extern fun error(msg: str = "", fields: {str: str} = {<str: str>}) > void;
    static extern fun hint(msg: str = "") > void;
    static extern fun info(msg: str = "", fields: {str: str} = {<str: str>}) > void;
    static extern fun warn(msg: str = "", fields: {str: str} = {<str: str>}) > void;
}

