// Code generated by magus-utils moduledecls. DO NOT EDIT.
/// The machine and this process: platform triple, CPU count, hostname, the running magus binary, and the two members that shadow Buzz's own (exit, sleep). Running OTHER processes lives in the proc module.
//
// Buzz declarations for the os host module: the object mirrors its methods
// return, then one `export extern fun` per method. Registered with SetModuleDecls
// beside the native implementation, so the checker reads the signature while the
// runtime keeps the host binding - an extern emits no code, so it cannot shadow
// one. Edit the std.Module declaration and rerun `go generate`, never this file.

export object RetryOptions {
    backoffMs: double? = null,
    maxBackoffMs: double? = null,
}

/// Return the absolute path of the running magus binary. Pair it with fs\stat inside a long-lived watch loop to detect that the binary was rebuilt or upgraded underneath the process, which means any output it goes on to generate would be stale.
export extern fun executable() > str !> any;
/// Abort the current run with the given exit code - typically after logging an error. Does NOT call os.Exit (that would kill a shared server); it raises, ending the target, and the code becomes magus's process exit status.
export extern fun exit(code: int) > void;
/// Return the host machine's name.
export extern fun hostname() > str !> any;
/// Return the number of logical CPUs available, for sizing a command's own internal parallelism (see os\with_slots).
export extern fun numCpu() > int;
/// Return the Docker/OCI platform triple: (os, arch, variant).
export extern fun platform() > [str];
/// Call fn up to max times, retrying on error with exponential backoff; returns fn's value on success. An error a host call inside fn raised keeps its type, and one typed non-retryable stops at once; a value fn throws itself, a string included, is retried. opts is a RetryOptions: backoffMs is the first pause (default 500) and maxBackoffMs caps it (default 30000); a negative option raises.
export extern fun retry(max: int, fn: fun () > any !> any, opts: RetryOptions? = null) > any !> any;
/// Pause for the given number of milliseconds (fractional allowed), matching Buzz's os\sleep. Cancellable: if the run is interrupted it returns early with the cancellation error rather than blocking.
export extern fun sleep(ms: double) > void !> any;
/// Add env vars to subprocesses `proc\exec` / `proc\shell` start inside callback. Never touches the process's own environment - a lookup like os\env inside callback does not see them.
export extern fun withEnv(env: {str: str}, callback: fun () > void !> any) > void !> any;
