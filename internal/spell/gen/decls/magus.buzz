/// The canonical form of a magus entity name - a target, charm, or spell op. `build2` gains a '-' you did not type; `HTTPServer` breaks before its last letter. Returns the NAME, never a spell handle: a handle can only come from a literal import, because the target graph is built by reading imports statically.
export extern fun canonicalName(name: str) > str;
/// A change against base, as a Change whose methods (tier, diff, impact, affected, conformance, mergeBase) read that change. base "" is the configured base, as `magus affected` and `magus diff` read it. opts.rev reviews a committed range base...head and opts.patch a unified diff instead of the working tree. The Change records the tree it was built on (at, the checkpoint, and files, a digest of each dirty path), and each method raises once that tree moved, naming the paths that moved. Raises MGS1022 outside a workspace.
export extern fun change(base: str = "", opts: ChangeOptions? = null) > Change !> any;
/// Remove the declared outputs of the selected projects: {removed, tracked, dryRun}. Arguments are `magus clean`'s: project paths, `--cache`, `--dry-run`. With no projects, the cwd project is selected, or the whole workspace from the root. Tracked outputs stay, because they are committed. Annotate the result `> CleanReport`. opts.root and opts.dir as on doctor.
export extern fun clean(args: [str], opts: CommandOptions? = null) > CleanReport !> any;
/// Escape hatch: run `magus <sub> <args>` for a subcommand with no dedicated method (status, affected, agent, graph, ...). Its signature is the typed methods' signature with the subcommand pushed in front: magus\cmd(sub, args, [opts]) beside magus\run(args, [opts]), same argv, same opts, same ExecResult. The SUBCOMMAND is a typed argument rather than args[0] because it is the part of the invocation magus can reason about - it stays readable in the signature and greppable in the source, while the remaining argv stays free-form. Prefer the dedicated methods (run, doctor, the magus\describe methods) when one exists - magus\cmd warns when sub, or a describe noun, names one that has; a describe noun with no method (job), and any noun's text in an explicit -o format, is reached here without a warning. Returns {stdout, stderr, code, ok}; raises on non-zero exit unless opts.AllowFailure is set. opts.root sets the global --root workspace; opts.dir runs it in another directory (relative to the target's, like proc\exec); opts.quiet captures the output without echoing it to the console; opts.stdin feeds the child's standard input, which is how a credential reaches a subcommand (`graph push`) without passing through a process listing or a run log.
export extern fun cmd(sub: str, args: [str], opts: CommandOptions? = null) > ExecResult !> any;
/// Run several nested magus commands at once. Each is magus\cmd's sub, args and opts as one Subcommand record, so commands may differ in subcommand, dir and every option. They run on the slots the calling target's step holds, as many at once as it holds, so a batch runs as wide as its step was granted and never past it: declare the target's slots to widen it. With no budget on the context, as in a bare `magus buzz` script, or a caller that holds no slot, they run one at a time and a line says so. Results come back in input order. Each command's output is buffered and written to the console as one block when it ends, in the order the commands end, or every 1 MiB for one that writes more. Every started command runs to its end whatever its siblings do; then the call raises naming each command that failed, unless that command's opts.allowFailure is set, which returns its result instead: set it on every command to read every result. A cancelled run starts no further command. run and affected are refused, since this run's pool adopts them and they would wait for a slot the batch holds: call magus\run for those. A command is not handed this run's pool socket, so a nested run it starts is its own invocation, which the workspace lock refuses for any project this run holds.
export extern fun cmdAll(commands: [Subcommand]) > [ExecResult] !> any;
/// Mint a workspace diagnostic code for magus\raise: {code, origin}. text is the prefix magus.yaml's diagnostics.prefix declares followed by four digits (WS1003). Raises on an MGS, BZZ or other built-in prefix, which only magus mints, on a prefix this workspace did not declare, on a malformed code, and on any code when no prefix is declared, naming the magus.yaml key.
export extern fun diagnosticCode(text: str) > DiagnosticCode !> any;
/// Validate the workspace and return what every check found: {workspace, checks, summary}, each check {name, status, message, details} with status `ok`, `fail`, or `advice` (advice is worth knowing and never a gate). Annotate the result `> DoctorReport` for compile-checked field access. A caller branches on a check's status rather than grepping console text for the word fail. It does NOT raise when a check fails: doctor exits non-zero precisely when it has something to report, and raising would discard the report. Gate on `summary.fail` instead, which says more than an exit code does. It DOES raise when the underlying `magus doctor` subprocess itself cannot be launched or its output cannot be decoded - an infrastructure failure, not a check result. opts.root sets the global --root workspace; opts.dir runs it in another directory (relative to the target's, like proc\exec).
export extern fun doctor(args: [str], opts: CommandOptions? = null) > DoctorReport !> any;
/// Log at error level, then abort the run with exit status 1.
export extern fun fatal(msg: str = "") > void;
/// The knowledge graph at its current symbol index: {digest, indexed, projects, gaps}, digest a hex SHA-256 over each loaded project's symbol shard fingerprint. Its methods (query, explain, path, refs, stats, neighborhood, dir, dirs, layer, projectGraph, imports, symbols, precedents, unreferenced, duplication) answer from that index and raise once it moved, naming the projects whose index came or went. A target writes the Graph as a declared output that a reader of the index keys its cache on. indexed is false and digest empty when no index was ingested; gaps are the projects declaring an index magus could not read. Raises MGS1022 outside a workspace, and when the gap probe cannot run. languages names the languages whose symbol indexes to freshen; empty is every index.
export extern fun graph(languages: [str] = [<str>]) > Graph !> any;
/// True when execution charm `name` is active, letting a target body branch on a charm carried in context (e.g. has_charm("rw")).
export extern fun hasCharm(name: str) > bool;
/// The window of version-control history a metric reads, as a History whose methods are hotspots, affinity, ownership and trend. opts is a HistoryMetricsOptions: commits (default 500), since, dir, and files for file granularity. Raises MGS1022 outside a workspace.
export extern fun history(opts: HistoryMetricsOptions? = null) > History !> any;
/// One row of the declared job store, as a Job whose methods are exit, wait and register. The store is what an orchestrating agent said about work it handed out: rows are DECLARATIONS, gating no run; the agent guard reads them to grade a write. An id no row carries raises. Raises MGS1022 outside a workspace.
export extern fun job(id: str) > Job !> any;
/// Register the one function a fork calls to choose a job's model tier: fun(req: ModelTierRequest) > any, returning null to leave the declared default to decide, else an object with tier (a case of the modelTiers enum), skills (a SkillVariant) and a non-empty reason. It runs once per fork, never during a run, and a row that names its own tier or model bypasses it. The job store is read-only inside it: every job member raises, so it decides from the request and the recorded history alone. A non-null answer lacking tier, skills or a reason fails the fork. Declared at the top level of the root magusfile, once; a second call, a call from another project, or a non-function is MGS1052.
export extern fun modelTier(matrix: fun (req: ModelTierRequest) > any !> any) > void;
/// Declare the model tiers a fork assigns: an enum of your own, cheapest case first, which magus reads once at load. tiers is that enum and default one of its cases. hosts maps each harness the magusfile wired, keyed by the harness id magus\harness.provider returns, to a function from a tier to the model alias that harness spawns; bounds maps a tier to its magus\agent\ModelTierBounds (maxLive, maxContext; a zero field is no cap); skills maps a tier to the magus\agent\SkillVariant its workers load. Write each function as an exhaustive match over the enum, so a tier added later fails `magus check` until every function covers it. No model name is magus's: the aliases are yours. hosts, bounds and skills are checked at load against the enum, and the declaration must follow the magus\harness.provider calls it maps. A declaration magus cannot use is MGS1052, and so is a second call or one outside the root magusfile. magus\modelTiers(null) turns tiers off. With no call the workspace gets the magus/modeltiers module: routine, bounded, design and frontier. Adjacent tiers may share a host's alias, for a host with fewer models than tiers. This declares; it never selects a model for a call, retries or escalates, and prints nothing. The recorded outcomes per tier are magus\workspace().tierOutcomes().
export extern fun modelTiers(tiers: any, default: any = null, hosts: any = null, bounds: any = null, skills: any = null) > void;
/// One target run's captured output by its ref: {ref, project, target, failed, durationMs, output}. Annotate the result `> OutputRecord`. ref is an output ref (out1a2b3c) or a unique prefix of one. Raises on a value that is not a ref, a prefix that matches several, and a ref this checkout's output store does not hold: output lives in the checkout that ran the target. Read in-process from the workspace on the context, or inside a guard rule from the checkout the guard judges; raises MGS1022 outside both.
export extern fun output(ref: str) > OutputRecord !> any;
/// Declare this directory's project: its spell, sources, outputs, and options. A magusfile calls it once at top level. Raises MGS1022 in a `magus buzz` script, which has no workspace to declare into.
export extern fun project(config: any, opts: any = null) > void;
/// Drop into an interactive REPL at this point, with the calling scope in hand. A no-op while the magusfile is only being parsed.
export extern fun pry() > void;
/// Fail with a CODED diagnostic instead of a bare string, so a caller can branch on the code: `catch (e) { if (e.code == "WS1001") ... }`. code is a DiagnosticCode from magus\diagnosticCode, and it is checked again here against the prefix magus.yaml's diagnostics.prefix declares, so a raise from an imported spell carries the importing workspace's prefix or fails. opts.cause is the error being wrapped, usually the value from an inner catch; it is appended to the message the way Go's %w renders one, and the failure it came from stays reachable underneath. The `see:` line under the message is opts.url when given, else the page diagnostics.docs names for the code, else none.
export extern fun raise(code: DiagnosticCode, message: str, opts: RaiseOptions? = null) > void !> any;
/// Run `magus run <args>` recursively in the target's project directory and capture its output. Child invocations share the parent's concurrency budget over the local socket. Returns {stdout, stderr, code, ok}; raises on non-zero exit unless opts.AllowFailure is set. opts.root sets the global --root workspace; opts.dir runs it in another directory (relative to the target's, like proc\exec); opts.quiet captures the output without echoing it to the console; opts.stdin feeds the child's standard input.
export extern fun run(args: [str], opts: CommandOptions? = null) > ExecResult !> any;
/// Which session's guard record a read covers, as a Session whose methods are trail, marks and mark. opts.session is the host's session id, empty for the one with the newest observation; opts.since is a duration back from opts.until (`6h`) or an RFC3339 time, default 24h; opts.until is an RFC3339 time, default now. An unknown option raises, and MGS1022 outside a workspace.
export extern fun session(opts: magus\feedback\ReadOptions? = null) > Session !> any;
/// Return the project path containing dir, or null when dir is inside no project. Served in-process from the workspace on the context - no subprocess.
export extern fun where(dir: str) > str !> any;
/// The workspace this call reads, as a Workspace whose methods are the job store, the run-outcome reads, the skills, disk reclaim and drift diagnosis. dir names the checkout whose branch forkFacts and unmerged read; empty is the workspace root. Raises MGS1022 outside a workspace.
export extern fun workspace(dir: str = "") > Workspace !> any;
/// Select the workspace provider, given an imported spell handle. Declared at the top level of the root magusfile.
export extern fun workspaceProvider(spell: {str: any}) > void;
// Emitting a message without changing control flow: the four levels, plus hint. magus\fatal and magus\raise are deliberately NOT here - they END the run rather than report on it, and grouping them by how they look rather than what they do is what made this module hard to read. Inside a target every level is written to the target's captured output, in log.format, so `magus query output <ref>` holds the whole log whatever -q or -v said. The console shows a line only at or above the run's log level, passing target or failing.
export object log {
    /// Log at debug level. See magus\log.info.
    static extern fun debug(msg: str = "", fields: {str: str} = {<str: str>}) > void;
    /// Log at error level. See magus\log.info. Logging an error does not abort; magus\fatal does.
    static extern fun error(msg: str = "", fields: {str: str} = {<str: str>}) > void;
    /// Emit an advisory nudge: non-fatal, deduped, and suppressed when hints are toggled off.
    static extern fun hint(msg: str = "") > void;
    /// Log at info level. The only way to log from a magusfile; there is no separate log module.
    static extern fun info(msg: str = "", fields: {str: str} = {<str: str>}) > void;
    /// Log at warn level. See magus\log.info.
    static extern fun warn(msg: str = "", fields: {str: str} = {<str: str>}) > void;
}

// Remote cache provider selection.
export object cache {
    /// Select the remote cache provider, given an imported spell handle. Declared at the top level of the root magusfile.
    static extern fun remote(spell: {str: any}) > void;
}

// CI provider selection.
export object ci {
    /// Select the CI provider, given an imported spell handle.
    static extern fun provider(spell: {str: any}) > void;
}

// Agent-guard rules for this workspace: additive shell, spawn, command and write rules, and the decision each compiled built-in takes.
export object guard {
    /// The verdict a spawn, command, write, stop or step rule returns to let the call through with text for the agent. opts.rule names the rule, kebab-case: the verdict then reports as workspace:<rule>.
    static extern fun advise(text: str, opts: {str: any} = {<str: any>}) > GuardVerdict;
    /// The verdict a spawn, command, write, stop or step rule returns to block the call until the person approves it through the host's own prompt, with text saying why. A wiring that cannot prompt refuses the call instead. opts.rule names the rule, kebab-case: the verdict then reports as workspace:<rule>.
    static extern fun ask(text: str, opts: {str: any} = {<str: any>}) > GuardVerdict;
    /// The magus binary answering the guard: {path, stamp}. path is the running executable with symlinks resolved; stamp is the text its build passed through the linker, empty when it passed none, so a rule can tell which sources that build came from.
    static extern fun binary() > GuardBinary;
    /// Set compiled guard rules by name: each value is "off", "advise" or "deny", or {"decision": ..., "lines": int, "tokens": int, "calls": int, "chars": int} with only the parameters the rule takes (lines: read-navigation). A rule left out keeps what the profile level sets, else the decision `magus describe rules` lists. Declared at the top level of the root magusfile, once. When the magusfile is tracked, each rule takes the stricter of the committed and the working-tree setting, so a loosening applies only once committed. An unknown rule name, an unknown decision, a parameter on a rule that takes none or out of its range, declaring twice or from another project is MGS1045.
    static extern fun builtins(rules: {str: any}) > void;
    /// Register the one function the agent guard calls on every shell command an agent is about to run: fun(req: CommandRequest) > GuardVerdict. The function form of guard.shell, for a decision a program-and-args match cannot express. Declared at the top level of the root magusfile, once. Strengthen only, fails open, and is evaluated from both the committed and the working-tree sources, exactly as guard.spawn is. Registering twice, from another project, or with a non-function is MGS1045. magus ships no rule.
    static extern fun command(rule: fun (req: CommandRequest) > GuardVerdict !> any) > void;
    /// Adds one to key's tally in the calling agent's session and returns the new total, starting at 1. Only callable inside a spawn, command, write or stop rule while the guard runs it.
    static extern fun count(key: str) > int;
    /// The verdict a spawn, command, write, stop or step rule returns to add nothing: no objection, so the host's own permission flow decides the call. The guard never answers yes.
    static extern fun defer() > GuardVerdict;
    /// The verdict a spawn, command, write, stop or step rule returns to block the call, with text saying why. opts.rule names the rule, kebab-case: the verdict then reports as workspace:<rule>, is stored, and a repeat in the same session shortens to its first line.
    static extern fun deny(text: str, opts: {str: any} = {<str: any>}) > GuardVerdict;
    /// True the first time key is asked in the calling agent's session, false after. Only callable inside a spawn, command, write or stop rule while the guard runs it.
    static extern fun once(key: str) > bool;
    /// Pick the level the guard's compiled rules start from: "off", "light", "standard" or "strict". A level sets the rules it names, and a rule named in builtins overrides the level's setting for it. Unset is light. Declared at the top level of the root magusfile, once. When the magusfile is tracked, the stricter of the committed and the working-tree level applies, and a person's agents.profile in magus.yaml may raise it, never lower it. An unknown level, declaring twice or from another project is MGS1045.
    static extern fun profile(level: str) > void;
    /// A shell line with its paths, patterns and literals normalized away, so calls differing only in what they name read alike: `grep -rn foo src` and `grep -rn bar lib` are both `grep -rn <arg>`. Programs, flags, operators and redirections stay. "" for a line the shell parser cannot read.
    static extern fun shape(command: str) > str;
    /// The shape of each program a shell line runs, in order, each with its own redirections: `cd x && grep -rn foo src | head -5` is [`cd <path>`, `grep -rn <arg>`, `head -<n>`]. Programs inside a loop or a command substitution count. Empty for a line the shell parser cannot read.
    static extern fun shapes(command: str) > [str];
    /// Declare one additive shell rule matched on a resolved program name and optional arg subset. Declared at the top level of the root magusfile. decision is deny or advise; optional dialect selects the parser (posix, bash, mksh, zsh, bats).
    static extern fun shell(rule: {str: any}) > void;
    /// Register the one function the agent guard calls on every agent spawn and every continuation of an existing subagent: fun(req: SpawnRequest) > GuardVerdict. Declared at the top level of the root magusfile, once. Strengthen only: its deny blocks, its advise fills silence, and nothing it returns lifts a built-in deny. A rule that raises or returns something other than a verdict fails open with an advisory naming the failure. When the magusfile is tracked, the committed and the working-tree rule both run and the stricter answer stands. Registering twice, from another project, or with a non-function is MGS1045. magus ships no rule.
    static extern fun spawn(rule: fun (req: SpawnRequest) > GuardVerdict !> any) > void;
    /// Register the function the agent guard calls on every step of kind that a program embedding magus asks it to judge: fun(req: StepRequest) > GuardVerdict. kind is a row's kind, lowercase words joined by hyphens; a seam's name and step are refused. The rule runs after the built-in rules and the program's own Go rules, and the strictest decision wins. An unnamed verdict reports as workspace:step. Declared at the top level of the root magusfile, once per kind. Strengthen only and evaluated from both the committed and the working-tree sources, exactly as guard.command is. A rule that fails judges nothing and says so; a row nothing else judges is then denied. Registering a kind twice, from another project, or with a non-function is MGS1045. magus ships no rule.
    static extern fun step(kind: str, rule: fun (req: magus\agent\StepRequest) > GuardVerdict !> any) > void;
    /// Register the one function the agent guard calls when an agent ends its turn, on the host's Stop and SubagentStop events, after the built-in stop check lets the stop through: fun(req: StopRequest) > GuardVerdict. Its deny refuses the stop through the host's own reply, so the agent keeps working; its advise is told beside the stop. Declared at the top level of the root magusfile, once. Strengthen only and evaluated from both the committed and the working-tree sources, exactly as guard.command is; a rule that fails lets the stop through and says so, since refusing on a broken rule would hold the session open. Registering twice, from another project, or with a non-function is MGS1045. magus ships no rule.
    static extern fun stop(rule: fun (req: StopRequest) > GuardVerdict !> any) > void;
    /// Keeps value as key's last value in the calling agent's session and returns the one it replaces, "" the first time. Only callable inside a spawn, command, write or stop rule while the guard runs it.
    static extern fun swap(key: str, value: str) > str;
    /// Register the one function the agent guard calls on every file an agent writes through its host's edit tools: fun(req: WriteRequest) > GuardVerdict. Declared at the top level of the root magusfile, once. Strengthen only, fails open, and is evaluated from both the committed and the working-tree sources, exactly as guard.command is. Registering twice, from another project, or with a non-function is MGS1045. magus ships no rule.
    static extern fun write(rule: fun (req: WriteRequest) > GuardVerdict !> any) > void;
}

// Agent-host harness selection, managed installation and verification. A harness is a spell that exports the harness contract's mgs_ functions (mgs_getHarness, mgs_listEntries, mgs_getMcp, ...), the same family as cache.remote and ci.provider.
export object harness {
    /// Install every declared harness's managed assets. Returns the command outcome and raises on failure; opts.allowFailure is refused. opts.binary selects the executable whose embedded assets are installed, so a build can install from its newly linked binary.
    static extern fun install(opts: CommandOptions? = null) > ExecResult !> any;
    /// Wire an imported harness spell for this workspace. A workspace may use several (one per agent host), same append-on-repeat shape as workspace.provider. Declared at the top level of the root magusfile. Returns the harness id, which keys the hosts map of magus\modelTiers; a call that ignores it wires the harness all the same.
    static extern fun provider(spell: {str: any}) > str;
    /// Verify the declared harness id, including synthetic hook probes. Returns the command outcome and raises when verification fails; opts.allowFailure is refused. opts.binary selects the executable performing verification.
    static extern fun verify(id: str, opts: CommandOptions? = null) > ExecResult !> any;
}

// Secret provider selection, and the credentials read through it.
export object secret {
    /// Open a loopback base URL carrying the credential a grant names, for a CHILD PROCESS to be pointed at instead of the real API. magus attaches the credential upstream, so the child never holds it.
    static extern fun endpoint(grant: any) > str !> any;
    /// Select the secret provider, given an imported spell handle.
    static extern fun provider(spell: {str: any}) > void;
    /// Read a credential by reference through the selected provider. Unlike the selections, this is called from inside a target, so its failure IS something a caller can handle.
    static extern fun read(ref: str) > str !> any;
}

// Where this workspace's changes are discussed. One member: a magusfile says WHERE reviews live and does not conduct one, so opening a review, reading its threads and publishing drafts are reserved names on the provider spell instead (see spells/review.go). Wiring no provider is the ordinary state and never an error: the workspace reviews locally.
export object review {
    /// Select the review provider, given an imported spell handle.
    static extern fun provider(spell: {str: any}) > void;
}

// Where this workspace learns when its tools' release cycles reach end of life. The provider spell exports list_lifecycles (see spells/lifecycle.go) and answers for the products the spells' tools name (Tool.lifecycle); magus\describe.tool() and `magus describe tools` carry the answer, and nothing it says fails a build. One provider per workspace. Wiring none is the ordinary state: the lifecycle columns read -.
export object lifecycle {
    /// Select the lifecycle provider, given an imported spell handle. Declared at the top level of the root magusfile; wiring a second, different spell is an error.
    static extern fun provider(spell: {str: any}) > void;
}

// Typed reads of what `magus describe <noun>` prints, one method per noun: `magus\describe.spell("go")` returns the Spell records `magus describe spell go -o json` carries. A method whose noun takes a name takes it as an optional SELECTOR and returns a collection either way, so detailing one reads `[0]`. A report that carries more than its collection (a file classification's overlaps, the tools' lifecycle state) comes back whole. The methods that fork a nested magus work from a `magus buzz` script with no workspace loaded; opts.root and opts.dir are as for magus\run. Bound by hand in internal/interp/bindings (buildDescribe): a Namespace's methods are Extern by construction. A noun with no method here is reached through magus\cmd("describe", [...]).
export object describe {
    /// The charms in the workspace's inverse index: each {name, builtin, default, doc, declarations}, declarations naming every target that patches its argv for that charm. Omit `name` for every charm; an unknown name raises. Runs a nested magus.
    static extern fun charm(name: str = "", opts: CommandOptions? = null) > [CharmEntry] !> any;
    /// The projects with their spells resolved: each project's fields plus resolvedSpells and targetPolicies, as `magus describe project --evaluated` prints them. Omit `path` for every project; an unknown path raises. Runs a nested magus.
    static extern fun evaluatedProject(path: str = "", opts: CommandOptions? = null) > [EvaluatedProject] !> any;
    /// The targets `ref` names (path:target, or a bare target name for every project declaring it), as magus would run them: sources, outputs, the dependency chain, the charms and each spell's rendered command. Raises on a ref nothing matches. Runs a nested magus.
    static extern fun evaluatedTarget(ref: str, opts: CommandOptions? = null) > [EvaluatedTarget] !> any;
    /// Classify paths against the workspace's declared globs: for each, the owning project and whether it is a declared `output` (generated - regenerate it, never hand-edit), a declared `source` (it feeds cache keys and the affected set), `maintained` (magus writes it outside any target - commit it, never ignore it), or `unclaimed`. Returns a typed DoctorReport-style envelope {definition, count, files, overlaps}, not text to re-parse: this is the question "can I disregard this changed file", and a caller branches on `role` rather than grepping. Runs a nested magus.
    static extern fun file(paths: [str], opts: CommandOptions? = null) > FileReport !> any;
    /// The TARGET dependency graph of every project: {projects}, each project {path, name, engine, nodes, cycle, dependsOn} and each node {name, declared, doc, dependencies, charms, spells, crossDependencies, inputs, outputs}. This is the per-project view magus\graph().projectGraph() does not carry. Read statically from the magusfile source, so it never runs a target body. Served in-process from the workspace on the context when there is one, and through a nested magus when there is not.
    static extern fun graph(opts: CommandOptions? = null) > TargetGraph !> any;
    /// The routing index `magus describe graph -o markdown` renders (MAGUS.md), as text. `projects` scopes it to those project paths and leaves out the workspace-wide tables; omit it for the whole index. Runs a nested magus.
    static extern fun graphMarkdown(projects: [str] = [<str>], opts: CommandOptions? = null) > str !> any;
    /// Declared harnesses as typed installation plans. Omit id for every provider; a named provider returns a one-element list and an unknown name raises. No declared providers raises. opts.binary selects the executable reading its own harness assets.
    static extern fun harness(id: str = "", opts: CommandOptions? = null) > [HarnessInstallation] !> any;
    /// The MCP tools the magus server exposes: each {name, description, params}. Omit `name` for every tool; an unknown name raises. Runs a nested magus.
    static extern fun mcpTool(name: str = "", opts: CommandOptions? = null) > [MCPTool] !> any;
    /// The host modules magus exposes, with their fields, methods and rendered Buzz signatures - the records `magus describe module` prints. Omit `name` for every module; an unknown name raises. Read in-process from the host module registry.
    static extern fun module(name: str = "") > [Module] !> any;
    /// The workspace's projects: {workspace, count, projects}, each project {path, dir, spell, spells, sources, outputs, dependsOn, exclusive}. Read in-process from the workspace on the context; raises MGS1022 outside one.
    static extern fun project() > Projects !> any;
    /// The guard rules this workspace enforces: each {name, decision, catches, why}, decision `deny` or `advise`. Omit `name` for every rule; an unknown name raises. Runs a nested magus.
    static extern fun rule(name: str = "", opts: CommandOptions? = null) > [Rule] !> any;
    /// The registered spells, sorted by name: each Spell carries its targets, the language it adapts and the rest of its mgs_getLanguage record (extensions, and syntax with its comments and stubs), so a script reads a language's comment and stub syntax as typed fields. Omit `name` for every spell; an unknown name raises. Runs a nested magus.
    static extern fun spell(name: str = "", opts: CommandOptions? = null) > [Spell] !> any;
    /// The target catalog: each target NAME once, {name, kind, spells, projects}, across every project that declares it. evaluatedTarget details one project's target. Runs a nested magus.
    static extern fun target(opts: CommandOptions? = null) > [TargetEntry] !> any;
    /// Every project's tools: {workspace, count, lifecycle, tools}, each tool {project, bin, spell, installedVersion, probeError, spellBounds, workspaceBounds, effective, verdict, diagnosticCode, lifecycle, cycle, eol, support}. Probes every tool's version, and asks the wired lifecycle provider (magus\lifecycle.provider) when each installed cycle reaches its end of life; lifecycle.state says whether that answer is live, cached, offline, unreached or unwired, and support reads unknown for a row it could not answer. Served in-process from the workspace on the context when there is one, and through a nested magus when there is not.
    static extern fun tool() > ToolReport !> any;
    /// The workspace this call runs in: {root, vcsBaseRef, cacheDir, concurrency, projectCount}, as a one-element collection. Runs a nested magus.
    static extern fun workspace(opts: CommandOptions? = null) > [WorkspaceEntry] !> any;
}

// Shared services a `magus buzz` script holds, the way a target holds one through ctx.needs: routed to the broker when one is up, so the service stays warm past the script, and hosted in-process otherwise. Every lease a script still holds is released when it ends, however it ends. Raises MGS1022 outside a workspace, and from a magusfile, where ctx.needs is the way to hold one. Bound by hand in internal/interp/bindings (buildService), for the reason magus\job is.
export object service {
    /// Start, or reuse, the service a built-in spell's service op declares, and hold it until release or the script's end. Returns once it is ready. A start service already running is adopted: owned is false and magus never stops it. Raises when the spell or op is unknown, the op is not a service, or the service never becomes ready.
    static extern fun acquire(spell: str, op: str) > ServiceLease !> any;
    /// Drop a lease acquire returned, before the script ends. The service stays up while another lease holds it; the broker keeps an owned one warm for its idle window, and an in-process one stops. Each call drops one reference to the lease's service, so release a lease once.
    static extern fun release(lease: ServiceLease) > void !> any;
}

