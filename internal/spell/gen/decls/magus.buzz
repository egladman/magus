export extern fun diagnoseDrift(outputs: [str], inputs: [str] = [<str>]) > DriftResult !> any;
export extern fun diff(opts: {str: any} = {<str: any>}) > Diff !> any;
export extern fun dir(path: str) > Dir !> any;
export extern fun dirs(glob: str, opts: DirsOptions = {<str: any>}) > [Dir] !> any;
export extern fun doctor(args: [str], opts: {str: any} = {<str: any>}) > DoctorReport !> any;
export extern fun explain(node: str) > ExplainResult !> any;
export extern fun fatal(msg: str = "") > void;
export extern fun hasCharm(name: str) > bool;
export extern fun impact(base: str = "", opts: {str: any} = {<str: any>}) > Impact !> any;
export extern fun importGraph() > ImportGraph !> any;
export extern fun insight(opts: {str: any} = {<str: any>}) > InsightReport !> any;
export extern fun layer(name: str) > Layer !> any;
export extern fun neighborhood(focus: str, opts: NeighborhoodOptions = {<str: any>}) > NeighborhoodResult !> any;
export extern fun output(ref: str) > OutputRecord !> any;
export extern fun path(node: str, to: str, opts: PathOptions = {<str: any>}) > PathResult !> any;
export extern fun precedents() > {str: any} !> any;
export extern fun project(config: any, opts: any = null) > void;
export extern fun projectGraph() > Graph !> any;
export extern fun pry() > void;
export extern fun query(query: str, opts: {str: any} = {<str: any>}) > QueryResult !> any;
export extern fun raise(code: str, message: str, opts: {str: any} = {<str: any>}) > void !> any;
export extern fun refs(symbol: str, opts: {str: any} = {<str: any>}) > RefsResult !> any;
export extern fun run(args: [str], opts: {str: any} = {<str: any>}) > ExecResult !> any;
export extern fun skills(opts: {str: any} = {<str: any>}) > [Skill] !> any;
export extern fun stats(kind: str = "") > KnowledgeStats !> any;
export extern fun symbolIndexDigest() > SymbolIndexDigest !> any;
export extern fun where(dir: str) > str !> any;
// Emitting a message without changing control flow: the four levels, plus hint. magus\fatal and magus\raise are deliberately NOT here - they END the run rather than report on it, and grouping them by how they look rather than what they do is what made this surface hard to read.
export object log {
    static extern fun debug(msg: str = "", fields: {str: str} = {<str: str>}) > void;
    static extern fun error(msg: str = "", fields: {str: str} = {<str: str>}) > void;
    static extern fun hint(msg: str = "") > void;
    static extern fun info(msg: str = "", fields: {str: str} = {<str: str>}) > void;
    static extern fun warn(msg: str = "", fields: {str: str} = {<str: str>}) > void;
}

// Remote cache provider selection.
export object cache {
    static extern fun remote(spell: {str: any}) > void;
}

// CI provider selection.
export object ci {
    static extern fun provider(spell: {str: any}) > void;
}

// Additive agent-guard rules for this workspace. Strengthen only: they cannot disable a compiled built-in.
export object guard {
    static extern fun advise(text: str) > GuardVerdict;
    static extern fun allow() > GuardVerdict;
    static extern fun binary() > GuardBinary;
    static extern fun command(rule: fun (req: CommandRequest) > GuardVerdict !> any) > void;
    static extern fun count(key: str) > int;
    static extern fun deny(text: str) > GuardVerdict;
    static extern fun once(key: str) > bool;
    static extern fun shell(rule: {str: any}) > void;
    static extern fun spawn(rule: fun (req: SpawnRequest) > GuardVerdict !> any) > void;
    static extern fun write(rule: fun (req: WriteRequest) > GuardVerdict !> any) > void;
}

// Agent-host harness selection. A harness is a spell that exports the harness_config / harness_skills / harness_entries contract, the same family as cache.remote and ci.provider.
export object harness {
    static extern fun provider(spell: {str: any}) > void;
}

// Secret provider selection, and the credentials read through it.
export object secret {
    static extern fun endpoint(grant: any) > str !> any;
    static extern fun provider(spell: {str: any}) > void;
    static extern fun read(ref: str) > str !> any;
}

// Where this workspace's changes are discussed. One member: a magusfile says WHERE reviews live and does not conduct one, so opening a review, reading its threads and publishing drafts are reserved names on the provider spell instead (see spells/review.go). Wiring no provider is the ordinary state and never an error: the workspace reviews locally.
export object review {
    static extern fun provider(spell: {str: any}) > void;
}

// Where this workspace learns when its tools' release cycles reach end of life. The provider spell exports list_lifecycles (see spells/lifecycle.go) and answers for the products the spells' tools name (Tool.lifecycle); magus\describe.tool() and `magus describe tools` carry the answer, and nothing it says fails a build. One provider per workspace. Wiring none is the ordinary state: the lifecycle columns read -.
export object lifecycle {
    static extern fun provider(spell: {str: any}) > void;
}

// Workspace-level declarations made from the root magusfile.
export object workspace {
    static extern fun provider(spell: {str: any}) > void;
}

// The declared job store: what an orchestrating agent said about work it handed out, recorded so a human can see the plan the agents are running. Rows are DECLARATIONS: this store gates no run and blocks no write to the tree; the agent guard is what reads them to grade a write, and register's verdict is a fact it returns rather than a gate. The one thing the store DOES refuse is a write to a row the caller does not own. See the field docs on types.Job. This namespace, the client MCP tool (magus\job) and `magus job` (fork, exec, exit, wait) are the three WRITE doors onto it. Bound by hand in internal/interp/bindings (buildJob), not generated: a Namespace's methods are Extern by construction (see std.Namespace), so there is no Impl for codegen to reflect a trampoline from, the same reason magus\secret.read is hand-bound.
export object job {
    static extern fun clear() > int !> any;
    static extern fun exit(id: str, result: {str: any} = {<str: any>}) > Job !> any;
    static extern fun list() > JobList !> any;
    static extern fun put(id: str, opts: {str: any} = {<str: any>}) > Job !> any;
    static extern fun register(id: str, reported_base: str) > {str: any} !> any;
    static extern fun wait(id: str, result: {str: any} = {<str: any>}) > JobStatus !> any;
}

// Typed reads of what `magus describe <noun>` prints, one method per noun: `magus\describe.spell("go")` returns the Spell records `magus describe spell go -o json` carries. A method whose noun takes a name takes it as an optional SELECTOR and returns a collection either way, so detailing one reads `[0]`. A report that carries more than its collection (a file classification's overlaps, the tools' lifecycle state) comes back whole. The methods that fork a nested magus work from a `magus buzz` script with no workspace loaded; opts.root and opts.dir are as for magus\run. Bound by hand in internal/interp/bindings (buildDescribe): a Namespace's methods are Extern by construction. A noun with no method here is reached through magus\cmd("describe", [...]).
export object describe {
    static extern fun charm(name: str = "", opts: {str: any} = {<str: any>}) > [CharmEntry] !> any;
    static extern fun evaluatedProject(path: str = "", opts: {str: any} = {<str: any>}) > [EvaluatedProject] !> any;
    static extern fun evaluatedTarget(ref: str, opts: {str: any} = {<str: any>}) > [EvaluatedTarget] !> any;
    static extern fun file(paths: [str], opts: {str: any} = {<str: any>}) > FileReport !> any;
    static extern fun graph(opts: {str: any} = {<str: any>}) > TargetGraph !> any;
    static extern fun graphMarkdown(projects: [str] = [<str>], opts: {str: any} = {<str: any>}) > str !> any;
    static extern fun harness(id: str = "", opts: {str: any} = {<str: any>}) > [HarnessPlan] !> any;
    static extern fun mcpTool(name: str = "", opts: {str: any} = {<str: any>}) > [MCPTool] !> any;
    static extern fun module(name: str = "") > [Module] !> any;
    static extern fun project() > Projects !> any;
    static extern fun rule(name: str = "", opts: {str: any} = {<str: any>}) > [Rule] !> any;
    static extern fun spell(name: str = "", opts: {str: any} = {<str: any>}) > [Spell] !> any;
    static extern fun target(opts: {str: any} = {<str: any>}) > [TargetEntry] !> any;
    static extern fun tool() > ToolReport !> any;
    static extern fun workspace(opts: {str: any} = {<str: any>}) > [WorkspaceEntry] !> any;
}

// Shared services a `magus buzz` script holds, the way a target holds one through ctx.needs: routed to the broker when one is up, so the service stays warm past the script, and hosted in-process otherwise. Every lease a script still holds is released when it ends, however it ends. Raises MGS1022 outside a workspace, and from a magusfile, where ctx.needs is the way to hold one. Bound by hand in internal/interp/bindings (buildService), for the reason magus\job is.
export object service {
    static extern fun acquire(spell: str, op: str) > ServiceLease !> any;
    static extern fun release(lease: ServiceLease) > void !> any;
}

// Facts about the workspace's version control that only magus computes. The `vcs` host module is the repository itself; this namespace is magus's reading of it. Bound by hand in internal/interp/bindings (buildVCS).
export object vcs {
    static extern fun checkpoint() > VCSCheckpoint !> any;
}

// A session's guard record, read from the activity trail, and the verdicts a person gives its rows. Bound by hand in internal/interp/bindings (buildTrail).
export object trail {
    static extern fun mark(mark: FeedbackMark) > FeedbackMark !> any;
    static extern fun marks() > [FeedbackMark] !> any;
    static extern fun read(opts: {str: any} = {<str: any>}) > FeedbackTrail !> any;
    static extern fun shape(command: str) > str;
    static extern fun shapes(command: str) > [str];
}

