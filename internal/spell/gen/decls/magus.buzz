    }

    fun attention(args: [str], opts: CommandOptions? = null) > AttentionList !> any {
        return magus__Workspace__attention(this, args: args, opts: opts);
    }

    fun fileDiskAttention(message: str) > void !> any {
        magus__Workspace__fileDiskAttention(this, message: message);
    }

    fun diskReclaim() > DiskReclaim !> any {
        return magus__Workspace__diskReclaim(this);
    }

    fun bustCache(projectPath: str = "") > void !> any {
        magus__Workspace__bustCache(this, projectPath: projectPath);
    }

    fun diagnoseDrift(outputs: [str], inputs: [str] = [<str>]) > DriftResult !> any {
        return magus__Workspace__diagnoseDrift(this, outputs: outputs, inputs: inputs);
    }
}

