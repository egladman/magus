{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://magus.invalid/job/result.schema.json",
  "$comment": "Generated from JobResult by `magus-utils jobschema`. DO NOT EDIT; run `magus run job-generate .`.",
  "title": "magus job result",
  "description": "JobResult is the result a holder files for a job.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "changed_paths", "unresolved_risks"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "job": {
      "type": "string"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "output_ref"],
      "properties": {
        "command": {
          "type": "string"
        },
        "output_ref": {
          "type": "string"
        }
      }
    },
    "gate_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "output_ref"],
        "properties": {
          "gate_id": {
            "type": "string"
          },
          "output_ref": {
            "type": "string"
          }
        }
      }
    },
    "descendants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
