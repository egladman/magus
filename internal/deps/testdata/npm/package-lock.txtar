An npm v3 lock with a scoped package, a git dependency declared both ways, a
workspace link, an npm: alias, a file: path, and a workspace member whose own
node_modules shadows the hoisted copy. v1/ holds a v1 lock.

-- package.json --
{
  "name": "fixture",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "dependencies": {
    "left-pad": "^1.3.0",
    "@scope/util": "^2.0.0",
    "from-github": "github:o/from-github",
    "from-git": "^0.1.0",
    "sibling": "file:packages/sibling",
    "old-pad": "npm:left-pad@1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
-- package-lock.json --
{
  "name": "fixture",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fixture",
      "version": "1.0.0",
      "workspaces": ["packages/*"]
    },
    "node_modules/@scope/util": {
      "version": "2.0.1",
      "resolved": "https://registry.npmjs.org/@scope/util/-/util-2.0.1.tgz",
      "integrity": "sha512-x"
    },
    "node_modules/from-git": {
      "version": "0.1.0",
      "resolved": "git+ssh://git@github.com/o/from-git.git#0123456789abcdef"
    },
    "node_modules/from-github": {
      "version": "0.2.0",
      "resolved": "git+ssh://git@github.com/o/from-github.git#0123456789abcdef"
    },
    "node_modules/left-pad": {
      "version": "1.3.0",
      "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz",
      "integrity": "sha512-x"
    },
    "node_modules/old-pad": {
      "name": "left-pad",
      "version": "1.1.0",
      "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.1.0.tgz"
    },
    "node_modules/sibling": {
      "resolved": "packages/sibling",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.8.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.8.3.tgz",
      "dev": true
    },
    "packages/app": {
      "version": "0.0.0"
    },
    "packages/app/node_modules/left-pad": {
      "version": "1.2.0",
      "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.2.0.tgz"
    },
    "packages/sibling": {
      "version": "0.0.0"
    }
  }
}
-- packages/app/package.json --
{
  "name": "app",
  "dependencies": {
    "left-pad": "~1.2.0",
    "@scope/util": "^2.0.0"
  }
}
-- v1/package.json --
{"dependencies": {"left-pad": "^1.3.0", "from-git": "^0.1.0"}}
-- v1/package-lock.json --
{
  "name": "v1",
  "lockfileVersion": 1,
  "requires": true,
  "dependencies": {
    "from-git": {
      "version": "git+ssh://git@github.com/o/from-git.git#0123456789abcdef"
    },
    "left-pad": {
      "version": "1.3.0",
      "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz"
    }
  }
}
