  languageName: node
  linkType: hard

"left-pad@npm:^1.2.0, left-pad@npm:^1.3.0":
  version: 1.3.0
  resolution: "left-pad@npm:1.3.0"
  checksum: 10/abc
  languageName: node
  linkType: hard

"sibling@workspace:^, sibling@workspace:packages/sibling":
  version: 0.0.0-use.local
  resolution: "sibling@workspace:packages/sibling"
  languageName: unknown
  linkType: soft
