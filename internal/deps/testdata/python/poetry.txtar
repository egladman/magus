A poetry project that predates PEP 621: [tool.poetry] tables with a path and a git
dependency, locked by poetry.lock. pdm/ holds the same shape for pdm.lock.

-- pyproject.toml --
[tool.poetry]
name = "fixture"
version = "0.1.0"

[tool.poetry.dependencies]
python = "^3.11"
Django = "^5.0"
attrs = { version = "^24.2", extras = ["tests"] }
mylib = { path = "../mylib", develop = true }
forked = { git = "https://github.com/o/forked.git" }

[tool.poetry.dev-dependencies]
black = "^24.0"

[tool.poetry.group.test.dependencies]
pytest = "^8.0"
-- poetry.lock --
# This file is automatically @generated by Poetry 1.8.3 and should not be changed by hand.

[[package]]
name = "attrs"
version = "24.2.0"
description = "Classes Without Boilerplate"
optional = false
python-versions = ">=3.7"
files = [
    {file = "attrs-24.2.0-py3-none-any.whl", hash = "sha256:x"},
]

[[package]]
name = "black"
version = "24.10.0"
optional = false
python-versions = ">=3.9"
files = []

[[package]]
name = "django"
version = "5.1.4"
optional = false
python-versions = ">=3.10"
files = []

[[package]]
name = "forked"
version = "1.0.0"
optional = false
python-versions = "*"
files = []
develop = false

[package.source]
type = "git"
url = "https://github.com/o/forked.git"
reference = "HEAD"
resolved_reference = "0123456789abcdef"

[[package]]
name = "mylib"
version = "0.1.0"
optional = false
python-versions = "*"
files = []
develop = true

[package.source]
type = "directory"
url = "../mylib"

[[package]]
name = "pytest"
version = "8.3.4"
optional = false
python-versions = ">=3.8"
files = []

[metadata]
lock-version = "2.0"
python-versions = "^3.11"
content-hash = "x"
-- pdm/pyproject.toml --
[project]
name = "fixture"
version = "0.1.0"
dependencies = ["requests>=2", "localpkg", "forked"]
-- pdm/pdm.lock --
# This file is @generated by PDM.
# It is not intended for manual editing.

[metadata]
groups = ["default"]
strategy = ["inherit_metadata"]
lock_version = "4.5.0"
content_hash = "sha256:x"

[[package]]
name = "forked"
version = "1.0.0"
git = "https://github.com/o/forked.git"
revision = "0123456789abcdef"
summary = "a fork"
groups = ["default"]

[[package]]
name = "localpkg"
version = "0.1.0"
path = "./localpkg"
summary = "a local package"
groups = ["default"]

[[package]]
name = "requests"
version = "2.32.3"
requires_python = ">=3.8"
summary = "Python HTTP for Humans."
groups = ["default"]
