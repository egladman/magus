-- ws/Cargo.toml --
[workspace]
members = ["crates/*"]
resolver = "2"

[workspace.dependencies]
anyhow = "1"
tokio = { version = "1", features = ["full"] }
internal = { path = "crates/internal" }
-- ws/Cargo.lock --
