A crate with every dependency table, a package = rename that puts two majors of
rand in the closure, a path and a git dependency, and a [patch.crates-io] redirect.
ws/ is a virtual workspace root whose [workspace.dependencies] are its direct ones.

-- Cargo.toml --
[package]
name = "fixture"
version = "0.1.0"
edition = "2021"

[dependencies]
serde = { version = "1.0", features = ["derive"] }
rand = "0.8"
rand09 = { package = "rand", version = "0.9" }
local = { path = "../local" }
forked = { git = "https://github.com/o/forked" }
regex = { workspace = true }

[dev-dependencies]
tempfile = "3"

[build-dependencies]
cc = "1.0"

[target.'cfg(windows)'.dependencies]
winapi = "0.3"

[patch.crates-io]
serde = { git = "https://github.com/o/serde", branch = "fix" }
-- Cargo.lock --
# This file is automatically @generated by Cargo.
# It is not intended for manual editing.
version = 4

[[package]]
name = "cc"
version = "1.2.5"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "x"

[[package]]
name = "fixture"
version = "0.1.0"
dependencies = [
 "cc",
 "forked",
 "local",
 "rand 0.8.5",
 "rand 0.9.0",
 "regex",
 "serde",
 "tempfile",
 "winapi",
]

