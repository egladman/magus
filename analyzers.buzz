// analyzers.buzz is this repository's plan: the analyzers the conventions target runs.
// Each rule in hack/lint keeps its magus/lint shape and runs through the library's
// adapter. An analyzer nothing names here never runs.
//
//	magus buzz analyzers.buzz -- [--only <name>] [<path>...]
import "os";
import "magus";
import "magus/lint";
import "libs/analyzer/analyzer" as analyzer;
import "libs/analyzer/adapter" as adapter;
import "libs/analyzer/runner" as runner;
import "libs/analyzer/stubs-never-reach-main" as stubs;
