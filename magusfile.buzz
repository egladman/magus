import "magus";

// Host modules: magus layers its methods onto Buzz's stdlib (camelCase).
import "os";
import "fs";
import "http";
import "vcs";
import "archive";
import "crypto";
import "serialize";
import "io";
import "std";
import "semver";

import "magus/spell/go";
import "magus/spell/docker";
import "magus/spell/cosign";
import "magus/spell/buzz";
import "magus/spell/markdown";
import "magus/spell/bash";

import "badge" as badge;
import "coverage" as cov;

// Version-selection rules for the `release` target below. ALIASED deliberately:
// an unaliased import flat-merges the module's exports into this file's scope,
// where magus reads every exported fun as a target and rejects the ones without a
// magus\Context first parameter (MGS1008). Aliasing keeps them namespaced, which
// is the same reason docs/magusfile.buzz aliases its renderer.
import "releaser" as releaser;
import "spells/golang/gomod" as gomod;

// gopherbuzz is embedded (require + replace); binds its targets as cross-project handles.
import "project/libs/gopherbuzz" as gopherbuzz;

// Cross-shard remote cache via GitHub Actions Cache; self-gates on GITHUB_ACTIONS.
import "spells/github/actions" as github;
final cache_trusted = os\env("MAGUS_CACHE_REMOTE_TRUSTED_KEYS");
final cache_insecure = os\env("MAGUS_CACHE_REMOTE_INSECURE");
if ((cache_trusted != null and cache_trusted != "") or cache_insecure == "true" or cache_insecure == "1") {
    magus\cache.remote(github);
}

// Outputs are declared per-target with ctx.writesFiles (in each *-generate body
// below) rather than project-wide: each generated tree belongs to exactly one
// generator, so snapshotting host/gen under go-build (which never writes it) is
// both wasteful and a hazard - a go-build cache hit would restore a stale MAGUS.md.
// `magus clean --outputs` still sees them all (Project.AllOutputs unions the
// per-target sets). See docs/cache.md#per-target-inputs-and-outputs.
magus\project({
    // Declared so the root project's label is stable. Without it the label falls
    // back to the checkout's directory basename, so a worktree, a differently
    // named clone, or a CI checkout each renamed the root project and rewrote
    // every generated index naming it - which is why regenerating MAGUS.md from
    // a worktree produced spurious diffs.
    "name": "magus",
    "spells": [go, buzz, markdown, bash],
    "targets": {
        "watch": {"skip_cache": "blocks on a filesystem watch loop and never returns"},
        // serve blocks (a long-running dev-loop server), so it must never cache.
        "serve": {"skip_cache": "blocks as a long-running dev server and never returns"},
        // deploy-generate writes a gitignored tree and nothing else.
        // No ctx.writesFiles for gen/site: declared output globs are what EnsureMergeDriver
        // writes into .gitattributes, and an ignored path can never conflict.
        "deploy-generate": {"skip_cache": "assembles a gitignored deploy tree that is never snapshotted"},
        "generate": {"skip_cache": "is the drift gate itself; a replay would skip the check it exists to make", "exclusive": true},
        "ci-shard": {"skip_cache": "emits a shard plan for the current invocation, not a reusable artifact"},
        "image-build": {"skip_cache": "pushes and cosign-signs a registry digest per invocation"},
        // Both read the environment and report or act on it per invocation; a replay
        // would report the charms and credentials of whatever ran last.
        "image-registries": {"skip_cache": "reports the registry table resolved from the current environment"},
        "image-login": {"skip_cache": "authenticates to a registry per invocation; a replay would reuse stale credentials"},
        // A release must never replay a cached artifact (see cd.yaml's remote-cache
        // comment); each has a real side effect (dist/ output, or a signature over it)
        // per invocation.
        "release-build": {"skip_cache": "a release must never replay a cached artifact; each invocation produces the bytes that ship"},
        "release-sign": {"skip_cache": "signs the manifest per invocation; a replayed signature would cover different bytes"},
        // Mutates go.mod and creates VCS tags (with the cd charm) - a real,
        // order-sensitive side effect, never a cache replay. exclusive: nothing
        // else should be touching go.mod or the tag namespace while it runs.
        "release": {"skip_cache": "mutates go.mod and creates VCS tags, an order-sensitive side effect", "exclusive": true},
        // test rewrites assets/coverage.svg; a cache hit would skip the write.
        "test": {"skip_cache": "rewrites assets/coverage.svg; a hit would skip the write"},
		// Preserves the hand-authored Unreleased section in place; caching a prior
		// file would overwrite a later edit that is intentionally outside releases/.
		"changelog-generate": {"skip_cache": "preserves a hand-authored Unreleased section; a replay would overwrite a later edit"},
        // Screen-records the CLI, so the bytes it writes are never the same twice
        // (real target durations land in the frames). Caching would replay a GIF
        // recorded against different code, which is the one thing a demo must not
        // do. Deliberately NOT named *-generate: `generate` globs that suffix and
        // drift-gates it, and a non-reproducible artifact under a drift gate fails
        // every CI run by construction. See the tapes target below.
        "tapes": {"skip_cache": "screen-records the CLI, so its bytes differ every run and a replay would show different code"},
    },
});

fun version() > str {
    final v = vcs\describe();
    if (v == "") { return "unknown"; }
    return v;
}

fun commit() > str {
    final c = vcs\shortHash();
    if (c == "") { return "unknown"; }
    return c;
}

// Commit record date (RFC3339) for reproducible builds; empty => "unknown".
fun build_date() > str {
    final c: Commit = vcs\commit();
    if (c.date == "") { return "unknown"; }
    return c.date;
}

fun ld_flags() > str {
    return "-w -s"
        + " -X main.version=" + version()
        + " -X main.commit=" + commit()
        + " -X main.buildDate=" + build_date();
}

// Compiles the version-stamped magus binary.
export fun go_build(ctx: magus\Context, args: [str]) > void {
    ctx.needs(gopherbuzz\build);
    go["go-build"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {
        "args": ["-trimpath",
            "-ldflags", ld_flags(),
            "-o", "magus",
            "./cmd/magus"],
    });
}

// Compiles magus-dev, the binary THIS worktree points its own git tooling at. Paired with
// hack/install-dogfood.sh, which registers it as the worktree's merge driver.
//
// A second binary rather than reusing ./magus, for one reason: ./magus is rebuilt constantly
// while iterating, and the merge driver resolves conflicts with whatever binary it was
// registered against. Rebuilding the driver's binary in the middle of a rebase swaps the
// tool under a running git operation. magus-dev moves only when install-dogfood is re-run,
// so a rebase resolves with one known build from start to finish.
//
// Why this exists at all: the driver registration prefers `magus` on PATH (see
// gitMergeDriverCommand in vcs/git.go), which is right for a normal workspace - it survives
// an upgrade-in-place - and wrong for magus's own worktrees, where PATH holds a RELEASE and
// the change under test is in the working tree. That gap is not cosmetic: the released
// driver regenerated the whole site once per conflicted file, so a rebase touching a handful
// of generated files looked like a hang, while the fix had been in the tree the whole time.
// No ctx.writesFiles here, matching go_build: the declared-output globs are what
// EnsureMergeDriver writes into .gitattributes, and declaring a gitignored binary there
// marks a path that can never be tracked and so can never conflict.
export fun dogfood(ctx: magus\Context, args: [str]) > void {
    ctx.needs(gopherbuzz\build);
    go["go-build"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {
        "args": ["-trimpath",
            "-ldflags", ld_flags(),
            "-o", "magus-dev",
            "./cmd/magus"],
    });
}

// One registry this project publishes to. The field names follow OCI distribution
// vocabulary deliberately, because the loose usage is what makes this area painful:
//
//   registry    the server, host[:port]. `docker login` authenticates against THIS.
//               ghcr.io, docker.io, 123456789012.dkr.ecr.us-east-1.amazonaws.com
//   repository  the namespaced path within a registry holding one set of related
//               manifests: egladman/magus, team-a/app, library/nginx
//   tag         a MUTABLE pointer to one manifest inside a repository: latest, v1.2.3
//   digest      the immutable content address: sha256:...
//   reference   the whole addressable string, [registry/]repository[:tag][@digest]
//   image       strictly the ARTIFACT (manifest + config + layers), not its name.
//               "image" is used for the reference constantly, including by Docker's
//               own docs; this file does not, which is why no field is called one.
//
// `host` is the registry and `repository` is a repository reference (registry plus
// repository path, never a tag - tags are appended per build). They are SEPARATE
// fields rather than one string with the tag glued on because the thing you
// authenticate against and the thing you push to are not the same, and how they
// differ is per-provider:
//
//   GHCR / Docker Hub   login ghcr.io            push ghcr.io/egladman/magus
//   Harbor              login harbor.example.com push harbor.example.com/team-a/app
//                       (the first path segment is a Harbor project, and a robot
//                       account is often scoped to exactly one of them)
//   ECR                 login <acct>.dkr.ecr.<region>.amazonaws.com
//                       push  <acct>.dkr.ecr.<region>.amazonaws.com/myapp
//   Artifact Registry   login us-central1-docker.pkg.dev
//                       push  us-central1-docker.pkg.dev/proj/repo/app
//
// Deriving one from the other is a per-provider transformation, which is precisely
// why it belongs in Buzz rather than in a magus feature: see the "auth realm" section
// in docs/guides/tips.md for how to compute `host` from `repository` when a provider
// makes you.
//
// `user_ref` and `token_ref` are SECRET REFERENCES resolved through this workspace's
// secret provider - environment variable names under the built-in provider, which is
// what CI needs because a workflow env block is the only thing that can read a
// repository secret. They live here rather than in a workflow so that adding a
// registry stays a one-line change in one file.
object Registry {
    host: str = "",
    repository: str = "",
    user_ref: str = "",
    token_ref: str = "",
}

final GHCR = Registry{
    host = "ghcr.io",
    repository = "ghcr.io/egladman/magus",
    user_ref = "GHCR_USERNAME",
    token_ref = "GHCR_TOKEN",
};

final DOCKERHUB = Registry{
    host = "docker.io",
    repository = "docker.io/egladman/magus",
    user_ref = "DOCKERHUB_USERNAME",
    token_ref = "DOCKERHUB_TOKEN",
};

// A release publishes to BOTH. Every tag across both goes into a SINGLE buildx
// invocation, so a variant is built exactly once and both registries receive the
// identical digest. A second `docker buildx build` aimed at Docker Hub would rebuild
// every layer rather than reuse them: a fresh CD runner starts with an empty
// BuildKit cache, so what makes the second registry free is that there is no second
// build, not a cache that survives between two.
final REGISTRIES = [GHCR, DOCKERHUB];

fun image_tag() > str { return "magus:" + commit(); }

// The build-args every variant stamps into the binary through the Dockerfiles' ldflags.
fun image_stamps() > [str] {
    return ["--build-arg", "VERSION=" + version(),
        "--build-arg", "COMMIT=" + commit(),
        "--build-arg", "DATE=" + build_date()];
}

// Builds one variant, pushes it to every registry, and signs it in each.
//
// `tags` are bare tag names, expanded across `registries` into -t flags on one
// buildx invocation: the variant is built once no matter how many registries or
// tags it lands under.
//
// --sbom attaches a per-platform SPDX document and --provenance a max-detail SLSA
// statement, both as in-toto attestation manifests inside the pushed index, and
// both produced by the build that was already running - BuildKit scans the
// filesystem it just assembled rather than pulling the image back to inspect it.
// They also force the result to be an index even for a single platform, which is
// why containerimage.digest below is always an index digest.
//
// cosign then runs once per REGISTRY, not once per digest. The push is
// content-addressed and shared, but a signature is a separate object stored in the
// repository beside the image it covers, so GHCR's copy does not vouch for Docker
// Hub's - the digest being signed is the same one both times.
fun publish_variant(ctx: magus\Context, dockerfile: str, platforms: str, registries: [Registry], tags: [str], meta: str) > [str] {
    var args = mut ["-f", dockerfile];
    foreach (a in image_stamps()) { args.append(a); }
    foreach (reg in registries) {
        foreach (t in tags) { args.append("-t"); args.append(reg.repository + ":" + t); }
    }
    args.append("--platform"); args.append(platforms);
    args.append("--sbom=true");
    args.append("--provenance=mode=max");
    args.append("--metadata-file"); args.append(meta);
    args.append("--push");
    args.append(".");
    docker["docker-buildx"](ctx.withCwd("."), {"args": args});

    final digest = serialize\jsonDecode(fs\readFile(meta)).q("containerimage.digest").stringValue();
    var pushed = mut [<str>];
    foreach (reg in registries) {
        cosign["cosign-sign"](ctx, {"args": [reg.repository + "@" + digest]});
        foreach (t in tags) { pushed.append(reg.repository + ":" + t); }
    }
    return pushed;
}

// Appends a runnable summary of what was pushed to the GitHub Actions job summary.
//
// This lives HERE, not in a workflow `run:` block, for the same reason image-login
// does: the target already knows the references it pushed, so a workflow step that
// re-derives them (`jq -r '."image.name"' snapshot-meta.json`) is parsing magus's own
// output back out of a file magus wrote. That is the shell-parsing shape this
// magusfile avoids everywhere else, and it drifts the moment the tag scheme changes.
//
// Self-gating on $GITHUB_STEP_SUMMARY rather than a charm, matching the second half
// of ci_shard below: outside Actions the variable is unset and this is a no-op, so a
// local `magus run image-build:snapshot` needs no extra flag to stay quiet.
fun write_image_summary(refs: [str]) > void {
    final summaryPath = os\env("GITHUB_STEP_SUMMARY");
    if (summaryPath == null or ("" + summaryPath) == "") { return; }
    if (refs.len() == 0) { return; }

    var md = "## Container images\n\n| Reference | Pull |\n| --- | --- |\n";
    foreach (r in refs) {
        md = md + "| `" + r + "` | `docker pull " + r + "` |\n";
    }
    md = md + "\nRun one against this workspace:\n\n```sh\ndocker run --rm -v \"$PWD\":/workspace "
        + refs[0] + " ls\n```\n";

    final sp = "" + summaryPath;
    var existing = "";
    if (fs\exists(sp)) { existing = fs\readFile(sp); }
    fs\writeFile(sp, existing + md);
}

// The platform a local --load build targets, named EXPLICITLY rather than left to
// buildx's default.
//
// Single-arch is not a preference here, it is a constraint: `docker buildx build
// --load` cannot load a multi-platform result into the docker image store, so a local
// build has exactly one architecture whatever anyone wants. Passing it explicitly
// means the build log says which one, instead of the reader having to know what the
// builder's default happens to be on this machine.
//
// The default is the HOST's architecture, so an M-series Mac builds arm64 and runs it
// natively. `linux/` is hard-coded against the host OS on purpose - the artifact is a
// container image, so darwin/windows are never the target even when they are the host.
//
// The `amd64` / `arm64` charms override it, for reproducing a failure that only
// happens on the other architecture. That path goes through QEMU emulation, so expect
// it to be slow; it is a debugging tool, not a second default.
fun load_platform(ctx: magus\Context) > str {
    if (ctx.has_charm("amd64")) { return "linux/amd64"; }
    if (ctx.has_charm("arm64")) { return "linux/arm64"; }
    return "linux/" + os\platform()[1];
}

// Builds one variant single-arch into the local daemon under image_tag(): no
// registry, no signature. What `magus run image-build` does outside CI, and what
// image_scan hands to trivy.
fun load_variant(ctx: magus\Context, dockerfile: str) > void {
    var args = mut ["-f", dockerfile];
    foreach (a in image_stamps()) { args.append(a); }
    args.append("-t"); args.append(image_tag());
    args.append("--platform"); args.append(load_platform(ctx));
    args.append("--load");
    args.append(".");
    docker["docker-buildx"](ctx.withCwd("."), {"args": args});
}

// Three PUBLISH modes and one local mode, and which you get is a charm because the
// default must be the harmless one: a bare `magus run image-build` on a laptop loads
// an image into the local daemon and pushes nothing.
//
//   :cd        a v* tag. Both variants, both registries, release tags.
//   :snapshot  a merge to main. Static only, GHCR only, tagged with the short commit.
//   :static    local build of the static variant instead of the cgo default.
//   (none)     local build of the cgo variant.
//
// A local build is single-architecture and says so - see load_platform(). Stack
// `:amd64` or `:arm64` on either local mode to cross-build through emulation
// (`magus run image-build:static,arm64`).
//
// `snapshot`, not `dev`: this pushes and cosign-signs a real artifact to a real
// registry, so naming it after the audience rather than the act was misleading -
// the actual development path is the no-charm default. Snapshot is the established
// term (Maven, Gradle, Debian) for a build published from a moving branch rather
// than a release, which is exactly what this is.
//
// A snapshot signature carries ci.yaml's certificate identity rather than cd.yaml's,
// which is what makes the documented release verify command reject one.
//
// Otherwise loads one single-arch image locally: CGO/glibc (Dockerfile) by default,
// or the static/no-libc variant (Dockerfile.static) under the `static` charm - the
// same default-cgo/opt-in-static convention as release_build() in this file.
export fun image_build(ctx: magus\Context, args: [str]) > void {
    final registries = publish_registries(ctx);
    var pushed = mut [<str>];
    if (ctx.has_charm("cd")) {
        foreach (r in publish_variant(ctx, "Dockerfile.static", "linux/amd64,linux/arm64",
            registries, [version(), "latest"], "static-meta.json")) { pushed.append(r); }
        foreach (r in publish_variant(ctx, "Dockerfile", "linux/amd64",
            registries, [version() + "-cgo", "latest-cgo"], "cgo-meta.json")) { pushed.append(r); }
        write_image_summary(pushed);
    } else if (ctx.has_charm("snapshot")) {
        foreach (r in publish_variant(ctx, "Dockerfile.static", "linux/amd64,linux/arm64",
            registries, [commit()], "snapshot-meta.json")) { pushed.append(r); }
        write_image_summary(pushed);
    } else if (ctx.has_charm("static")) {
        load_variant(ctx, "Dockerfile.static");
    } else {
        load_variant(ctx, "Dockerfile");
    }
}

// Which registries the active mode pushes to. image_build and image_registries both
// read it, so the build and the login step it depends on cannot disagree about
// which credentials a run needs.
fun publish_registries(ctx: magus\Context) > [Registry] {
    if (ctx.has_charm("cd")) { return REGISTRIES; }
    if (ctx.has_charm("snapshot")) { return [GHCR]; }
    return [];
}

// Narrows a registry list to one host, for the `magus run image-login:cd docker.io`
// form. Selection is BY HOST, deliberately not by position: an index silently
// selects a different registry the moment REGISTRIES is reordered or the charm
// changes how many there are (`:snapshot` has one, `:cd` has two, so "index 1" is a valid
// registry under one and out of range under the other), and it is unreadable in a
// workflow besides. A host that is not in the list is an error naming the ones that
// are, rather than a silent no-op.
fun select_registries(registries: [Registry], host: str) > [Registry] {
    if (host == "") { return registries; }
    var hosts = "";
    foreach (reg in registries) {
        if (reg.host == host) { return [reg]; }
        if (hosts != "") { hosts = hosts + ", "; }
        hosts = hosts + reg.host;
    }
    throw "no registry \"" + host + "\" for these charms; this mode publishes to: " + hosts;
}

// Reports the registries `magus run image-build` under the SAME charms will push to,
// and whether the credentials each one needs are actually present in the environment.
// The diagnostic half of the pair image_login() completes: this one answers "where
// does this go and am I set up for it", touches nothing, and needs no credentials to
// be useful.
//
//     magus run image-registries:cd              # both, for a release
//     magus run image-registries:snapshot             # GHCR only, for a per-commit image
//     magus run image-registries:cd docker.io    # just that one
//     magus run image-registries:cd,verify       # ...and FAIL if any are missing
//
// The `verify` charm turns the report into a gate. CI runs it that way as a preflight,
// so a missing secret fails on a named variable before checkout, QEMU, buildx and a
// multi-arch compile have burned runner time - and so the step's own log states the
// contract the workflow's env block is there to satisfy. Without the charm it only
// reports, which is what you want locally where a missing token is not an error yet.
//
// A bare `magus run image-registries` reports nothing to do: the local --load build
// pushes nowhere and needs no credentials.
export fun image_registries(ctx: magus\Context, args: [str]) > void {
    var host = "";
    if (args.len() > 0) { host = args[0]; }
    final registries = select_registries(publish_registries(ctx), host);
    if (registries.len() == 0) {
        magus\info("image-registries: this build pushes nowhere; add the cd or snapshot charm to see a release or snapshot target");
        return;
    }
    // The CREDENTIALS column costs a provider round trip - and a prompt, on a provider
    // that has one - so it is only filled when `verify` asked for it. Without the charm
    // this target reads nothing and can never surprise anyone with an unlock dialog.
    final checking = ctx.has_charm("verify");
    var table = pad("REGISTRY", 12) + pad("REPOSITORY", 28) + pad("USERNAME REF", 20) + pad("TOKEN REF", 20) + "CREDENTIALS";
    foreach (reg in registries) {
        var state = "not checked (add the verify charm)";
        if (checking) { state = credential_state(reg); }
        table = table + "\n" + pad(reg.host, 12) + pad(reg.repository, 28)
            + pad(reg.user_ref, 20) + pad(reg.token_ref, 20)
            + state;
    }
    // Lead line, then the table: magus\info prefixes only its FIRST line with a level
    // marker, which would otherwise shift the header out of line with its columns.
    magus\info("image-build under these charms publishes to:\n" + table);

    if (!checking) { return; }
    var unready = mut [<str>];
    foreach (reg in registries) {
        if (credential_state(reg) != "ready") { unready.append(reg.host); }
    }
    if (unready.len() > 0) {
        throw "image-registries: no usable credentials for " + unready.join(", ")
            + "; set the variables named above (in CI they come from repository secrets)";
    }
}

// Whether both of a registry's credentials can be resolved.
//
// ONLY called under the `verify` charm, and that gating is the point rather than a
// detail. Checking resolvability means actually RESOLVING, and resolving means asking
// the provider - which for 1Password or a vault is a biometric or password prompt. A
// status table that pops an unlock dialog just to print "ready" is the single most
// infuriating thing this feature could do, and it is exactly what an ungated probe
// would cause: `magus run image-registries` is a look-around command, not a request
// for credentials.
//
// So the plain report lists references without touching them, and `:verify` - a user
// explicitly asking "am I set up" - is the only path that resolves.
//
// try/catch rather than testing a return value, because a provider signals "not
// available" by THROWING: $VAR unset for the built-in, a locked vault or expired
// session for a spell. Presence is not testable without asking.
fun credential_state(reg: Registry) > str {
    var missing = mut [<str>];
    if (!resolvable(reg.user_ref)) { missing.append(reg.user_ref); }
    if (!resolvable(reg.token_ref)) { missing.append(reg.token_ref); }
    if (missing.len() == 0) { return "ready"; }
    return "missing " + missing.join(", ");
}

fun resolvable(ref: str) > bool {
    try {
        magus\secret.read(ref);
        return true;
    } catch (e) {
        return false;
    }
}

fun pad(s: str, width: int) > str {
    var padded = s;
    while (padded.len() < width) { padded = padded + " "; }
    return padded + " ";
}

// Logs in to every registry the active mode publishes to, resolving each one's
// credentials through the workspace's secret provider.
//
//     magus run image-login:cd                   # both, before image-build:cd
//     magus run image-login:snapshot                  # GHCR only
//     magus run image-login:cd docker.io         # just that one
//
// This is the whole reason the references are a field on Registry. A CI step is then
// one line with no shell parsing a list, the same line that works on a laptop, and it
// cannot disagree with `image-build` about which registries need credentials because
// both read publish_registries().
//
// TWO separate protections keep the token out of what magus persists, and neither one
// makes the other redundant:
//
//   - It reaches docker on STDIN, never argv. magus captures a command's arguments
//     into the run log and the output store, so `-p <token>` would write the secret to
//     both. opts.stdin is not captured.
//   - It was resolved through magus\secret.read, so magus recognises the value and
//     redacts it from captured output. That covers what this file does not control:
//     docker itself, or any later tool, echoing the token back.
export fun image_login(ctx: magus\Context, args: [str]) > void {
    var host = "";
    if (args.len() > 0) { host = args[0]; }
    final registries = select_registries(publish_registries(ctx), host);
    if (registries.len() == 0) {
        throw "image-login: these charms publish nowhere, so there is nothing to log in to - add the cd or snapshot charm (`magus run image-login:cd` or `:snapshot`)";
    }
    foreach (reg in registries) {
        final user = magus\secret.read(reg.user_ref);
        final token = magus\secret.read(reg.token_ref);
        os\exec("docker", args: ["login", reg.host, "-u", user, "--password-stdin"],
            dir: ".", opts: {"stdin": token});
        magus\info("image-login: " + reg.host + " authenticated as " + user);
    }
}

// Scans the image with trivy; the rw charm writes SARIF and gates on HIGH/CRITICAL.
export fun image_scan(ctx: magus\Context, args: [str]) > void {
    ctx.needs(image_build);
    if (ctx.has_charm("rw")) {
        fs\makeDirectory("dist");
        os\exec("trivy", ["image",
            "--format", "sarif",
            "--output", fs\join("dist", "trivy.sarif"),
            "--severity", "HIGH,CRITICAL",
            "--exit-code", "1",
            image_tag()]);
    } else {
        os\exec("trivy", ["image", image_tag()]);
    }
}

// Renders the roff man pages into manpage/ (repo root). These are a DISTRIBUTION
// artifact - the .1 source the `man` command reads, shipped with releases - so they
// stay owned here at the root, NOT in the docs project. The docs project owns the
// Markdown manpages (docs/manpage/*.md) instead; both flavors are serialized from the
// same internal/manpage registry by cmd/magus-manpage (see its -format flag).
//
// It also refreshes api.lock, the drift-gated snapshot of the public CLI surface,
// because that is serialized from the SAME registry - the two can only disagree if
// one is regenerated without the other. It had no producing target at all before,
// so TestAPIUpToDate's remedy was a raw `go generate` that `magus run generate`
// never performed.
export fun man_generate(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles("manpage/*.1", "internal/manpage/testdata/api.lock");
    fs\makeDirectory("manpage");
    os\exec("go", ["run", "./cmd/magus-manpage", "-format", "roff", "-out", "manpage"]);
    os\exec("go", ["generate", "./internal/manpage/..."]);
}

// CHANGELOG.md is a root artifact. Keeping its generator beside the file avoids a
// reverse docs -> root output edge while letting docs publication depend on the same
// execution stage.
export fun changelog_generate(ctx: magus\Context, args: [str]) > void {
    ctx.readsFiles("releases/*.yaml", "cmd/magus-utils/**/*.go", "internal/**/*.go",
        "go.mod", "go.sum", "go.work", "go.work.sum");
    ctx.modifiesExistingFiles("CHANGELOG.md");
    os\exec("go", ["run", "./cmd/magus-utils", "generate-changelog",
        "-releases", "./releases", "-changelog", "./CHANGELOG.md"]);
}

// Regenerates the runtime BuzzObject maps before anything imports a host binding.
// Its reflection lives only in magus-utils while writing this Go file; the emitted
// methods use direct field access, so Magus never reflects at a Buzz boundary.
export fun types_generate(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles("types/buzzobject_gen.go");
    os\exec("go", ["generate", "./types"]);
}

// Regenerates the Go host bindings (std -> internal/interp/bindings/gen) from std.Module declarations.
export fun bindings_generate(ctx: magus\Context, args: [str]) > void {
    ctx.needs(types_generate);
    ctx.writesFiles("internal/interp/bindings/gen/*.go");
    os\exec("go", ["generate", "./std/..."]);
}

// Regenerates the compiled built-in spell bytecode (internal/spellruntime/gen)
// and the Buzz value-type mirrors (internal/spellruntime/gen/types), both driven
// by the go:generate directives in internal/spellruntime.
//
// Both trees are declared: undeclared, magus classified them as ordinary source,
// so `magus describe file` told a reader a generated file was safe to hand-edit
// and the agent guard's generated-file advisory stayed silent on every one of them.
export fun spells_generate(ctx: magus\Context, args: [str]) > void {
    ctx.needs(types_generate);
    ctx.writesFiles("internal/spellruntime/gen/*.bo", "internal/spellruntime/gen/types/*.buzz");
    os\exec("go", ["generate", "./internal/spellruntime/..."]);
}

// Regenerates the testify mocks (mockery, driven by .mockery.yaml) into each mocked
// interface's gen/ subdir. Mocks are committed and drift-gated like every other
// generated tree; mockery is pinned in the go.mod tool block.
export fun mocks_generate(ctx: magus\Context, args: [str]) > void {
    ctx.needs(types_generate);
    ctx.writesFiles("**/gen/mocks/*.go");
    os\exec("go", ["tool", "mockery"]);
}

// Reinstalls the agent skills from their embedded sources in cmd/magus/skills.
//
// The installed copies are GENERATED, and declaring them says so: without this
// they classified as ordinary source, so `magus describe file .claude/skills/...`
// reported a hand-editable file and the agent guard stayed silent on the one edit
// that is always wrong. CLAUDE.md has said "edit the sources, not the installed
// copies" all along; this is the declaration that makes the tooling say it too.
//
// AGENTS.md is deliberately NOT declared. Only its marked section is managed -
// bytes outside the markers are hand-owned - so calling the whole file generated
// would tell a reader never to edit a file they are meant to edit. `magus graph
// verify` still checks that section's stamp.
export fun skills_generate(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles(".claude/skills/**", ".agents/skills/**", ".opencode/skills/**");
    magus\cmd(["agent", "install", ".claude/skills", "--force"], {"quiet": true});
    magus\cmd(["agent", "install", ".agents/skills", "--force"], {"quiet": true});
    magus\cmd(["agent", "install", ".opencode/skills", "--force"], {"quiet": true});
    magus\cmd(["agent", "install-agents-md"], {"quiet": true});
}

// Regenerates the CLI config-flag plumbing from internal/config/config.go. One
// generator invocation, four trees: the flag/bind plumbing beside the CLI, the
// schema field list, and the env applier next to config itself. All four are
// declared - undeclared they classified as ordinary source, so magus told a
// reader they were safe to hand-edit.
export fun config_generate(ctx: magus\Context, args: [str]) > void {
    ctx.needs(types_generate);
    ctx.writesFiles("cmd/magus/gen/*.go", "schema/gen/*.go", "internal/config/gen/*.go",
                "cmd/magus/completions/*");
    os\exec("go", ["generate", "./cmd/magus/..."]);
}

// The committed docs Markdown (Buzz module reference, spell docs, Markdown manpages)
// is generated by the DOCS project now, not here: it is docs-site content, so the docs
// project owns generating and drift-gating it (see docs/magusfile.buzz's
// content-generate target). This root magusfile only owns the roff manpages
// (man-generate above), which are a distribution artifact rather than site content.

// Renders MAGUS.md via `magus describe graph`.
export fun md_generate(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles("MAGUS.md");
    final doc = magus\describe(["graph", "-o", "markdown"], {"quiet": true}).stdout;
    fs\writeFile("MAGUS.md", doc + "\n");
}

// Exports both graphs the browser Graph Explorer can load, so its demo is this
// workspace's real graph rather than a fixture that would drift from the wire shape the
// adapter expects. Written into gen/ because they are generated, not authored: the
// knowledge graph previously sat at docs/graph.json as a hand-run export with no
// generating target at all, which made it stale by construction with nothing to say so.
// Whole-workspace scope is why this lives at the root rather than in docs/ - a describe
// from inside a project only sees that project.
export fun graph_generate(ctx: magus\Context, args: [str]) > void {
    ctx.writesFiles("gen/*.json");
    fs\mkdirall("gen");
    // The knowledge graph (nodes/links). No dedicated binding for `graph export`, so
    // magus.cmd is the documented escape hatch.
    final knowledge = magus\cmd(["graph", "export", "--static", "-o", "json"], {"quiet": true}).stdout;
    fs\writeFile(fs\join("gen", "knowledge-graph.json"), knowledge);
    // The target graph ({definition, projects}), the same bytes as
    // `magus describe graph -o json`, which is what the explorer's target adapter reads.
    final targets = magus\describe(["graph", "-o", "json"], {"quiet": true}).stdout;
    fs\writeFile(fs\join("gen", "target-graph.json"), targets);
}

// workspace_go_mods gathers the Go spell's structured view for every workspace
// module. The policy that compares those records lives beside that spell in
// spells/golang/gomod.buzz; Magus core only supplies the typed project inventory.
fun workspace_go_mods(ctx: magus\Context) > [any] {
    final projects: Projects = magus\ls();
    var modules: [any] = mut [<any>];
    foreach (project in projects.projects) {
        if (fs\exists(project.dir + "/go.mod")) {
            final result = go["go-mod-json"](ctx.withCwd(project.dir));
            modules.append({"dir": project.dir, "json": result.stdout});
        }
    }
    return modules;
}

// The Go spell's Buzz companion derives the flags; go-mod-edit alone renders or
// writes go.mod. Without rw, Go's -print mode must equal the checked-in file.
export fun mod_sync(ctx: magus\Context, args: [str]) > void {
    // modifiesExistingFiles, not writesFiles: go.mod is hand-authored and committed, and
    // this target amends its replace directives rather than producing the file. Declaring
    // it an OUTPUT made mod-sync snapshot it, so a later cache hit could replay a
    // pre-release go.mod straight over the version bump `release` had just written - the
    // two-owners hazard MGS1020 reports. As a modification it still hashes into the key.
    ctx.modifiesExistingFiles("go.mod");
    final flags = gomod\replaceArgs(go["go-mod-json"](ctx).stdout, modules: workspace_go_mods(ctx));
    if (flags.len() == 0) { return; }
    final edited = go["go-mod-edit"](ctx, {"args": flags});
    if (ctx.has_charm("rw")) { return; }
    if (edited.stdout != fs\readFile("go.mod")) {
        throw "MGS1016: go.mod has workspace-local replace drift; run `magus run mod-sync:rw` to apply the derived replacements";
    }
}

// Renders the insight report (hotspots, affinity, ownership, trend) and, with the
// `gha` charm, appends it to a host output path supplied via env. The final CI step;
// never gates. The env var name (MAGUS_INSIGHT_OUTPUT_PATH) is generic on purpose;
// the host that sets it (the workflow) is what knows it's GitHub Actions and
// points it at $GITHUB_STEP_SUMMARY. The `gha` charm also opts the render into the
// safe Mermaid subset so older or partial renderers handle it.
export fun postflight(ctx: magus\Context, args: [str]) > void {
    final hasGha = ctx.has_charm("gha");
    var styleArgs = ["report", "--workspace"];
    if (hasGha) { styleArgs = ["report", "--workspace", "--mermaid-style", "safe"]; }
    final doc = magus\insight(styleArgs).stdout;

    if (hasGha) {
        final outputPath = os\env("MAGUS_INSIGHT_OUTPUT_PATH");
        if (outputPath != null and outputPath != "") {
            var existing = "";
            if (fs\exists(outputPath)) { existing = fs\readFile(outputPath); }
            fs\writeFile(outputPath, existing + doc + "\n");
            magus\info("postflight: appended insight report");
            return;
        }
    }
    // Default: print to stdout so a local `magus run postflight` is useful too.
    magus\info(doc);
}

// Regenerates every *-generate sibling, then gates on drift (exclusive, scoped to
// cwd). Drift = regeneration dirtied a previously-clean tree, via vcs.isDirty (not
// a raw git/porcelain shell-out), so uncommitted-but-current generated files pass;
// only a regeneration that changes a clean file fails (a generator input changed
// but its output was not re-run and committed).
export fun generate(ctx: magus\Context, args: [str]) > void {
    final clean_before = vcs\isDirty() == false;
    ctx.needs(mod_sync);
    ctx.needs(ctx.glob("*-generate", "!deploy-generate"));
    if (ctx.has_charm("rw")) { return; }

    if (clean_before and vcs\isDirty()) {
        throw "generate: regeneration changed generated files; re-run "
            + "`magus run generate:rw` and commit";
    }
}

// Records every VHS tape in tapes/ into assets/gen/. Each tape drives a real magus
// binary through a real terminal, so the GIFs are documentation that cannot quietly
// go stale the way a pasted transcript does - re-record and the drift is visible.
//
// Opt-in, never wired into `generate` or `ci`: a render takes tens of seconds, needs
// vhs (and the ttyd/ffmpeg it pulls in) on PATH, and produces a different file every
// time. Run it when the CLI's output actually changes, then commit the result.
//
// The GIFs are declared outputs all the same, so `magus describe file` reports them
// as generated and the agent guard warns on a hand-edit - the same treatment
// assets/coverage.svg gets.
export fun tapes(ctx: magus\Context, args: [str]) > void {
    // Declared, or the tapes and the script that stages their workspace would be
    // unclaimed: `magus describe file tapes/core-loop.tape` reported no owner, so
    // editing a tape invalidated nothing and told a reader it affected no target.
    ctx.readsFiles("tapes/*.tape", "tapes/demo-init.sh");
    ctx.writesFiles("assets/gen/*.gif");
    if (os\which("vhs") == "") {
        throw "tapes: vhs not found on PATH; install it with `brew install vhs` "
            + "(see tapes/README.md)";
    }
    foreach (tape in fs\glob("tapes/*.tape")) {
        magus\info("recording {tape}");
        os\exec("vhs", [tape], ".", {});
    }
}

// Builds one (goos, goarch) release binary and archives it into dist/, writing a
// standard one-line <asset>.sha256 sidecar alongside it (sha256sum-compatible format).
// No cross-job aggregation needed: CD's publish job later does
// `cat dist/*.sha256 > dist/SHA256SUMS`, a plain shell one-liner, not a magus target.
// release-build's cgo and static (charm) modes both call this, differing only in
// CGO_ENABLED and the asset suffix.
fun build_release_variant(ctx: magus\Context, goos: str, goarch: str, cgo: bool, suffix: str) > void {
    fs\makeDirectory("dist");
    final v = version();
    var binary = "magus";
    if (goos == "windows") { binary = "magus.exe"; }

    final stage = fs\join("dist", goos + "-" + goarch + suffix);
    fs\makeDirectory(stage);

    var env = mut {"GOOS": goos, "GOARCH": goarch, "GOEXPERIMENT": "jsonv2"};
    if (cgo) {
        env["CGO_ENABLED"] = "1";
        // CC/PKG_CONFIG_PATH are set by the CD workflow only where the native toolchain
        // isn't already on the default search path (currently just windows/MSYS2);
        // empty on Linux/macOS, where apt/brew already put libzstd.pc/liblzma.pc where
        // pkg-config looks by default.
        final cc = os\env("MAGUS_CGO_CC");
        if (cc != null and cc != "") { env["CC"] = cc; }
        // PKG_CONFIG pins the exact pkg-config binary cgo runs, so it can never fall
        // back to a broken one earlier on PATH (Strawberry Perl's on the Windows runner).
        final pkgbin = os\env("MAGUS_CGO_PKG_CONFIG");
        if (pkgbin != null and pkgbin != "") { env["PKG_CONFIG"] = pkgbin; }
        final pkgcfg = os\env("MAGUS_CGO_PKG_CONFIG_PATH");
        if (pkgcfg != null and pkgcfg != "") { env["PKG_CONFIG_PATH"] = pkgcfg; }
    } else {
        env["CGO_ENABLED"] = "0";
    }

    // The -static archives have to drop Buzz FFI, or the name is a lie. Its provider reaches
    // dlopen through purego's //go:cgo_import_dynamic, which gives the binary a PT_INTERP and
    // a libc dependency even under CGO_ENABLED=0 - so the archive we ship as "static" needed a
    // dynamic loader, and would not run on a musl or scratch host. zdef() reports FFI
    // unsupported in that build; the default (cgo) archives keep it. Same reasoning and the
    // same tag as Dockerfile.static.
    var build_args = mut ["-trimpath"];
    if (!cgo) { build_args.append("-tags"); build_args.append("noffi"); }
    build_args.append("-ldflags"); build_args.append(ld_flags());
    build_args.append("-o"); build_args.append(fs\join(stage, binary));
    build_args.append("./cmd/magus");
    go["go-build"](ctx.withEnv(env), {"args": build_args});

    final asset = fs\join("dist", "magus_" + v + "_" + goos + "_" + goarch + suffix + ".tar.gz");
    archive\compress(stage, asset, {});
    fs\delete(stage);

    final digest = crypto\hash(crypto\HashAlgorithm.Sha256, fs\readFile(asset));
    fs\writeFile(asset + ".sha256", digest + "  " + fs\basename(asset) + "\n");
}

// Resolves which platform to build: the explicit (goos, goarch) args when given, else
// the current runner's own native platform. So a bare `magus run release-build` (with
// or without the static charm) builds exactly one binary — the one you're standing
// on — never a silent "all 5" surprise.
fun release_target_platform(goos: str, goarch: str) > [str] {
    if (goos != null and goos != "") { return [goos, goarch]; }
    // GOOS/GOARCH in the environment cross-target this build (the standard Go convention), so CD can
    // ask one runner for another platform's binary - e.g. the arm64 macOS job cross-builds darwin/amd64
    // static via `GOOS=darwin GOARCH=amd64 magus run release-build:static`. Empty env falls to native.
    final envos = os\env("GOOS");
    final envarch = os\env("GOARCH");
    if (envos != null and envos != "" and envarch != null and envarch != "") { return [envos, envarch]; }
    final p = os\platform();
    return [p[0], p[1]];
}

// Builds one release binary for one platform. Default is dynamically-linked (cgo):
// internal/codec's zstd/xz fast path needs a real C toolchain + libzstd/liblzma for
// whatever (goos, goarch) you ask for, so cross-compiling this variant only works if
// you already have that toolchain around — CD never does, sticking to each native
// job's own platform. The `static` charm (`magus run release-build:static`) switches
// to a CGO_ENABLED=0 build instead: pure Go cross-compiles trivially, so unlike the
// cgo default it's cheap to run for every platform from one machine — CD's
// release-static job loops `release-build:static` once per platform with explicit
// args. Reads has_charm directly (see docs/charms.md's function-target pattern, e.g.
// build:container): this is a magusfile function target with no spell, so :static
// trips the soft undeclared-charm typo-guard warning — expected here, same as that
// example.
export fun release_build(ctx: magus\Context, goos: str, goarch: str) > void {
    // dist/* is skip_cache (never snapshotted), but declaring it keeps
    // `magus clean --outputs` aware of the release artifacts via AllOutputs.
    ctx.writesFiles("dist/*");
    // The UNSUFFIXED archive is the static one, and the cgo build carries "-cgo". That is
    // the same convention as the image tags (`latest` static, `latest-cgo` cgo), and it was
    // inverted here: the archives spelled static with a suffix and gave the bare name to
    // cgo, so the identical default was named two opposite ways across one release. The
    // installer has always defaulted to VARIANT=static and the download guides have always
    // linked the static asset, so this renames what people already take, rather than
    // changing which build they get.
    final p = release_target_platform(goos, goarch);
    if (ctx.has_charm("static")) {
        build_release_variant(ctx, p[0], p[1], false, "");
    } else {
        build_release_variant(ctx, p[0], p[1], true, "-cgo");
    }
}

// Signs dist/SHA256SUMS with the Ed25519 key in the MAGUS_SIGNING_KEY secret (see
// cmd/magus-utils/sign.go), then self-verifies the signature against the embedded
// release pubkey (internal/releasekey) before the release goes out — a cheap
// regression guard, safe to run here (unlike setup-magus, which can't depend on the
// magus source tree since it's reused by arbitrary external repos).
export fun release_sign(ctx: magus\Context, args: [str]) > void {
    os\exec("go", ["run", "./cmd/magus-utils", "sign", fs\join("dist", "SHA256SUMS")]);
    os\exec("go", ["run", "./cmd/magus-utils", "verify",
        fs\join("dist", "SHA256SUMS"), fs\join("dist", "SHA256SUMS.sig")]);
}

// release cuts a version across the workspace in the order Go's multi-module
// convention requires - the part that is easy to get wrong by hand:
//
//   1. tag each nested module (libs/<name>/vX.Y.Z) - each has to be
//      independently `go get`-able before anything downstream can require it
//      at a real version instead of v0.0.0.
//   2. rewrite root go.mod's `require .../libs/<name> v0.0.0` lines to the
//      real vX.Y.Z, now that those tags exist to resolve to.
//   3. tag root vX.Y.Z last - only now does the root tag's own go.mod
//      resolve its nested requires to something `go get` can fetch, instead
//      of the unreleased v0.0.0 that makes `go get github.com/egladman/magus`
//      fail for everyone outside this repo (see docs/reference/go-sdk.md).
//
// go.mod's `replace` directives are left exactly as they are: they are
// ignored by any downstream consumer (replace is never transitive) and are
// the standard pattern for local development inside the same repo - go.mod
// carries a comment saying so, precisely so nobody "cleans them up" later.
//
// Dry run by default, and PER MODULE. `magus run release` with no arguments
// surveys every module - its current version and the three legal next ones - and
// releases nothing. Name a module to release it:
//
//      magus run release -- magus=0.4.0
//      magus run release -- libs/gopherbuzz=0.2.0
//      magus run release:cd -- magus=0.4.0 libs/gopherbuzz=0.2.0
//
// A module you do NOT name is not released. That is the point: these modules
// version INDEPENDENTLY, each on its own cadence, because Go already gives each
// its own tag namespace. Deriving every tag from one number would chain
// gopherbuzz's public API to magus's release schedule for no reason.
//
// The three candidates are COMPUTED, never chosen. Deciding which one a change
// deserves is a judgement about what breaks for a consumer; that belongs to the
// developer. magus supplies the mechanism and stops there.
//
// Neither path ever pushes - a human reviews the tags and pushes deliberately.

export fun release(ctx: magus\Context, args: [str]) > void {
    // `cd` rather than a release-only charm: image_build above already uses it to
    // mean "this is the real delivery path, do the side-effectful thing" (push and
    // sign, there; tag and rewrite go.mod, here). One word for one concept beats a
    // second one that has to be learned separately.
    final deliver = ctx.has_charm("cd");
    final dirty = vcs\isDirty();
    final modules = releaser\releasableModules(magus\ls().projects);

    // Parse `key=version`. Anything unnamed is surveyed, never released.
    var wanted = mut {};
    foreach (a in args) {
        if (a == "") { continue; }
        final eq = a.indexOf("=");
        if (eq == null) {
            throw "release: expected <module>=<version>, got `" + a
                + "` - run `magus run release` with no arguments to list the modules";
        }
        final key = a.sub(0, eq);
        var v = a.sub(eq + 1);
        if (v.startsWith("v")) { v = v.sub(1); }
        semver\parse(v); // raises with a clear message on anything not valid semver
        wanted[key] = v;
    }

    // Survey ALWAYS, before anything else: it is the whole interface for choosing
    // a version, and printing it up front means the numbers you act on are the
    // numbers you just read.
    foreach (m in modules) {
        final cur = releaser\currentVersion(m["prefix"]);
        final n = releaser\nextFor(cur);
        var at = "at " + cur;
        if (cur == "") { at = "unreleased"; }
        magus\info("release: " + m["key"] + " - " + at
            + ", next: patch " + n.patch + " | minor " + n.minor + " | major " + n.major);
    }

    if (wanted.keys().len() == 0) {
        magus\info("release: nothing named, nothing released - e.g. `magus run release -- magus=0.4.0`");
        return;
    }

    // Reject an unknown key BEFORE doing anything: a typo must not quietly release
    // nothing while reporting success.
    foreach (key in wanted.keys()) {
        var known = false;
        foreach (m in modules) {
            if (m["key"] == key) { known = true; }
        }
        if (!known) {
            throw "release: unknown module `" + key
                + "` - run `magus run release` with no arguments to list them";
        }
    }

    if (deliver and dirty) { throw "release: tree is dirty; commit before releasing"; }

    // Refuse a version that is not one of the three offered. Cutting a release is
    // tedious precisely because a wrong number is silent - nothing catches a typo
    // that lands v0.40.0 instead of v0.4.0 until someone tries to depend on it, and
    // a tag is the one artifact you cannot quietly take back. The candidates are
    // computed from the current stable release, so the only way to reach a distant
    // version is to release your way there deliberately.
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null) { continue; }
        final cur = releaser\currentVersion(m["prefix"]);
        if (!releaser\isCandidate(v, cur)) {
            final n = releaser\nextFor(cur);
            throw "release: " + m["key"] + " v" + v + " is not a legal next version from "
                + cur + " - choose " + n.patch + ", " + n.minor + " or " + n.major
                + " (a prerelease or +metadata build of one of those is fine)";
        }
    }

    // Refuse an existing tag before creating ANY of them, so a partial release
    // cannot leave half the modules tagged.
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null) { continue; }
        final tag = m["prefix"] + "v" + v;
        if (vcs\tags(pattern: tag).len() > 0) {
            throw "release: tag " + tag + " already exists";
        }
    }

    if (!deliver) {
        magus\info("release: DRY RUN - add the cd charm to execute");
        if (dirty) { magus\info("release: NOTE - tree is dirty; cd will refuse until it is clean"); }
    }

    // 1. Nested modules first: the root's go.mod must require a version that
    // already exists as a tag by the time the root itself is tagged.
    // See mod-sync: release amends require versions in a committed go.mod, it does not
    // produce the file, and two targets declaring one output is MGS1020.
    ctx.modifiesExistingFiles("go.mod");
    var gomod = fs\readFile("go.mod");
    var rewrote = false;
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null or m["root"] != "") { continue; }
        magus\info("release: tag " + m["prefix"] + "v" + v);
        if (deliver) { os\exec(vcs\exe(), ["tag", m["prefix"] + "v" + v]); }
        // Only a Go module is required by the root's go.mod; a library in another
        // language is tag-only, so there is nothing to repoint.
        if (m["gomodule"] != "") {
            magus\info("release: go.mod  " + m["gomodule"] + "  ->  v" + v);
            gomod = releaser\rewriteRequire(gomod, m["gomodule"], "v" + v);
            rewrote = true;
        }
    }
    if (deliver and rewrote) { fs\writeFile("go.mod", gomod); }

    // 2. Root tag LAST, so it captures the go.mod rewrite above.
    final rootV = wanted["magus"];
    if (rootV != null) {
        magus\info("release: tag v" + rootV);
        if (deliver) { os\exec(vcs\exe(), ["tag", "v" + rootV]); }
    }

    if (deliver) {
        magus\info("release: done - nothing was pushed. Push the tags deliberately when ready.");
    } else {
        magus\info("release: dry run only - nothing was tagged or written");
    }
}

// Rebuilds on every debounced change until interrupted; fs.watch BLOCKS, try/catch keeps it alive.
export fun watch(ctx: magus\Context, args: [str]) > void {
    magus\info("watching cmd/ and internal/ — rebuilding on change (Ctrl-C to stop)");
    fs\watch(["cmd", "internal"], fun(changed: [str]) > bool {
        magus\info("change detected — rebuilding");
        try {
            go_build(ctx, []);
        } catch (e) {
            magus\warn("build failed, still watching: " + e);
        }
        return false;
    });
}

// Renders a Go coverage badge locally (no third-party service, no network).
fun total_coverage(func_out: str) > str {
    final lines = func_out.split("\n");
    final fields = lines[lines.len() - 1].split("");
    final cell = fields[fields.len() - 1];
    if (cell.endsWith("%")) { return cell.sub(0, cell.len() - 1); }
    return cell;
}

// Tests with race detection, coverage, and a drift-gated coverage badge.
export fun test(ctx: magus\Context, args: [str]) > void {
    // Declared because this target WRITES the badge below and gates on its drift.
    // Undeclared, a declaration-based staging review would skip it as unclaimed while ci still failed on
    // it being stale - the workspace's account of itself disagreeing with what a
    // target actually does, which is the disagreement declarations exist to end.
    ctx.writesFiles("assets/coverage.svg");
    final clean_before = vcs\isDirty([fs\join("assets", "coverage.svg")]) == false;
    ctx.needs(format);
    go["go-test"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["-race", "-covermode=atomic", "-coverprofile=coverage.out"]});
    // Measure hand-written code only. Generated files (protobuf accessors, mocks,
    // the Buzz mirrors) are hundreds of functions no test will ever call, so
    // leaving them in makes the figure a statement about the code generators and
    // rewards writing tests for getters to hold the floor up. coverage.buzz
    // detects them by Go's canonical marker, never by path - this repo keeps
    // hand-maintained files inside a gen/ directory. coverage.out stays on disk
    // unfiltered so `go tool cover -html=coverage.out` still shows everything.
    fs\writeFile("coverage.hand.out",
        cov\stripGenerated(fs\readFile("coverage.out"),
            prefix: cov\modulePath(fs\readFile("go.mod")) + "/"));
    final pct = total_coverage(os\exec("go", ["tool", "cover", "-func=coverage.hand.out"]).stdout);
    if (std\parseInt(pct.split(".")[0]) < 60) {
        throw "test: coverage " + pct + "% is below the 60% floor; investigate the regression or lower the floor deliberately";
    }
    fs\writeFile(fs\join("assets", "coverage.svg"), badge\coverage("go coverage", percent: pct, radius: 3));
    if (ctx.has_charm("rw")) { return; }
    if (clean_before and vcs\isDirty([fs\join("assets", "coverage.svg")])) {
        throw "test: assets/coverage.svg is stale; re-run `magus run test:rw` and commit the badge";
    }
}

// buzz-check and buzz-run lived here and are gone: they ran the upstream `buzz`
// toolchain and magus's embedded engine over cmd/magus/starter/spells, whose only two
// files (a .bzz and a .tl) were deleted with the lua/teal interpreter in b60e99be. They
// have been checking an absent directory and passing ever since, which this repo treats
// as worse than no gate.
//
// They are deleted rather than repointed because there is no standalone Buzz left to
// aim them at. Every .buzz here imports "magus"/"magus/spell" and uses embedding-only
// constructs, so a non-embedded parse rejects all 62 of them; that is by design, not
// drift. What they were meant to protect is already covered: spells/examples/**
// by TestExamplesParseAndRecord (ParseEmbedded), every spells/<dir>/spell.buzz by the
// registry compile that doctor's spell-contract check exercises, and every magusfile by
// doctor's magusfile-syntax check. Reviving them means first having standalone Buzz and
// pinning `buzz` in mise.toml, which is not the case today.

// Gates the build on workspace health by running `magus doctor`.
export fun preflight(ctx: magus\Context, args: [str]) > void { magus\doctor([]); }

// Compiles one artifact: the host binary, or the container image under the `container` charm.
export fun build(ctx: magus\Context, args: [str])  > void {
    ctx.needs(format);
    if (ctx.has_charm("container")) {
        ctx.needs(image_build);
    } else {
        ctx.needs(go_build);
    }
}
// Formats first, then golangci-lint, go vet, govulncheck, markdownlint, and shellcheck.
// golangci-lint and govulncheck go through the go spell's ops rather than a raw os\exec, so
// the spell's version probes (mgs_getVersionCommands) reach the cache key - without them a
// linter upgrade changes which code passes while every cache entry replays the old verdict.
// Neither runs through `go tool`: that COMPILES the tool with whichever go leads PATH, which
// is how CI built the linter with a different toolchain than it analyzed with, and panicked.
// shellcheck covers the shell magus SHIPS - the completion script users source into their
// shell and the install script served at /magus/install - which was unlinted until it broke
// in a way only a user would have noticed.
// The proto contract self-gates: the `proto` project owns its buf-lint/ci, run by
// `magus affected ci` when it's affected - the root does not reach into it.
export fun lint(ctx: magus\Context, args: [str]) > void {
    ctx.needs(format);
    go["golangci-lint"](ctx);
    go["go-vet"](ctx);
    go["govulncheck"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}));
    markdown.markdownlint(ctx);
    // NOT markdown.typos here, deliberately. The op walks the whole project directory,
    // and this project is the Go tree - 487 of its hits are code comments using British
    // spellings, which is a separate decision from gating prose. The docs project runs
    // it (see docs/magusfile.buzz lint), because that is where the prose actually is.
    bash["shellcheck"](ctx);
}
// Regenerates, then formats Go and tidies `go.mod`. Markdown is linted (not formatted):
// markdownlint runs in lint; there is no markdown FORMATTER any more - biome (used for all
// TypeScript/CSS) has no markdown support, and prettier was dropped rather than kept solely
// to format markdown.
export fun format(ctx: magus\Context, args: [str]) > void { ctx.needs(generate); go["go-fmt"](ctx); go["go-mod-tidy"](ctx); }

// Runs the CI gates through their declared dependencies.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, build, test);
}

// Exercises the completion scripts magus SHIPS, each inside the official image for its
// shell. Not part of ci: it needs a docker daemon, and a gate that silently skips when a
// tool is missing is how the zsh recipe stayed broken - it told users to append a script
// to ~/.zshrc that registers nothing, and nothing ever ran it to find out.
//
// One image per shell, pinned to a major-version tag, and nothing is installed into any
// of them: each image already carries its shell. There is no magus binary inside, so the
// checks assert the STATIC candidates; the project completions shell out to `magus ls`
// and are legitimately empty there.
//
// TODO: zsh is uncovered - it has no official image (zshusers/zsh is community-run), so
// the one shell with a confirmed bug is the one still untested. Revisit if an official
// image appears, or if a pinned community digest becomes acceptable.
// TODO: fish is uncovered for the same reason; upstream declined to publish an official
// image in fish-shell/fish-shell#3440.
export fun completion_test(ctx: magus\Context, args: [str]) > void {
    if (os\which("docker") == "") {
        throw "completion-test needs a docker daemon: it runs each shell's official image";
    }
    // dotnet/sdk, not mcr.microsoft.com/powershell: the PowerShell team's own images are
    // deprecated in MCR, and the SDK image is what Microsoft points at for LTS pwsh.
    final checks = {
        "bash:5": "bash hack/completion-checks/bash.sh",
        "mcr.microsoft.com/dotnet/sdk:8.0": "pwsh -NoProfile -File hack/completion-checks/pwsh.ps1",
    };
    foreach (image, cmd in checks) {
        os\execSh("docker run --rm -v \"$PWD\":/w -w /w " + image + " " + cmd);
    }
}

// Translates a `magus affected --plan` (read on stdin) into GitHub Actions shard-matrix
// outputs; the gha charm writes $GITHUB_OUTPUT, otherwise the matrix is only previewed.
export fun ci_shard(ctx: magus\Context, args: [str]) > void {
    var input = "";
    if (!os\stdinIsTerminal()) {
        input = io.stdin.readAll();
    }
    if (input == "") {
        throw "ci-shard: no shard plan on stdin — pipe one in: magus affected ci --plan | magus run ci-shard:gha";
    }
    final plan = serialize\jsonDecode(input);
    var include = mut [];
    foreach (row in plan.q("matrix").listValue()) {
        include.append({"shard": row.q("shard").stringValue(), "projects": row.q("projects").stringValue()});
    }
    final block = "matrix=" + serialize\jsonEncode({"include": include}) + "\n"
        + "count=" + plan.q("count").integerValue() + "\n"
        + "max_parallel=" + plan.q("max_parallel").integerValue() + "\n";

    if (!ctx.has_charm("gha")) {
        magus\info("ci-shard preview (add the gha charm — `magus run ci-shard:gha` — to write $GITHUB_OUTPUT):\n" + block);
        return;
    }
    final path = os\env("GITHUB_OUTPUT");
    var p = "";
    if (path != null) { p = "" + path; }
    if (p == "") {
        throw "ci-shard: the gha charm is set but $GITHUB_OUTPUT is unset — run this inside a GitHub Actions step";
    }
    var existing = "";
    if (fs\exists(p)) { existing = fs\readFile(p); }
    fs\writeFile(p, existing + block);

    // Render an actionable, portable summary to the job step summary.
    final summaryPath = os\env("GITHUB_STEP_SUMMARY");
    if (summaryPath != null and ("" + summaryPath) != "") {
        final sp = "" + summaryPath;
        var md = "## Affected CI plan\n\n"
            + plan.q("count").integerValue() + " shard(s), max parallel "
            + plan.q("max_parallel").integerValue() + "\n\n"
            + "| Shard | Projects |\n| --- | --- |\n";
        foreach (row in plan.q("matrix").listValue()) {
            var projects = row.q("projects").stringValue();
            if (projects == ".") { projects = "magus"; }
            if (projects.startsWith(". ")) { projects = "magus" + projects.sub(1, projects.len()); }
            md = md + "| " + row.q("shard").stringValue() + " | " + projects + " |\n";
        }
        md = md + "\n**What this means:** each shard runs the listed projects concurrently within the declared limit. "
            + "To inspect why a project was selected, run `magus affected ci --explain` locally. "
            + "[Affected CI guide](https://eli.gladman.cc/magus/guides/affected/) · "
            + "[CI target guide](https://eli.gladman.cc/magus/concepts/targets/ci/)\n";
        var existingSummary = "";
        if (fs\exists(sp)) { existingSummary = fs\readFile(sp); }
        fs\writeFile(sp, existingSummary + md);
    }
}

// rebuild_console rebuilds console/gen with the console project's own esbuild build
// (pnpm run build), installing its deps first on a cold tree. Run from the console/
// dir so pnpm resolves that project's package.json.
// Always let pnpm validate the install, matching console/magusfile.buzz. An interrupted
// install leaves a node_modules that EXISTS but is incomplete, and the isDir guard this
// replaced read that as ready and handed the missing packages to esbuild. On a warm tree
// --frozen-lockfile is about a second and changes nothing.
fun rebuild_console() > void {
    os\exec("pnpm", ["install", "--frozen-lockfile"], "console", {});
    os\exec("pnpm", ["run", "build"], "console", {});
}

// rerender_docs re-renders docs/gen via the docs project's fast `render` target.
// It shells out to magus rather than calling render.site_render in-process because
// docs/render.buzz flat-imports its helpers (render_text, render_html, ...) with
// plain names that resolve relative to the CWD - only inside the docs project dir,
// never the workspace root - so a sub-invocation (which sets CWD=docs) is the only
// way those imports resolve. Prefer $MAGUS (the running binary's resolved path, set
// for magus child processes) and fall back to `magus` on PATH.
fun rerender_docs() > void {
    var bin = os\env("MAGUS");
    if (bin == null or ("" + bin) == "") { bin = "magus"; }
    os\exec("" + bin, ["run", "render", "docs"], ".", {});
}

// missing_input phrases a deploy-generate precondition that ANOTHER project owns.
//
// Naming one single-project command teaches the wrong habit: the reader runs it, gets the
// next precondition, runs another, and learns the set by failing once per producer. So name
// every producer in one command. `magus run <target> [project...]` takes a LIST - `magus run
// build docs console` is one dispatch over both - which is the idiom this message teaches.
//
// Deliberately NOT "magus affected build" or "magus run build /". Both would include this
// project, and neither can order it after the producers: the root declares no dependency on
// docs or console, so there is no edge to schedule on. It cannot declare one either - docs
// already depends on the root, so the reverse edge closes a cycle. That missing edge is
// exactly why this runtime check exists instead of ctx.needs, and why the remedy has to name
// the producers rather than a whole-workspace verb that would just fail here first.
//
// The command leads the sentence: a long cause line is elided with an ellipsis in run
// output, so anything after the first clause may never reach the reader.
//
// Defined ABOVE deploy-generate's doc comment, not between it and the target: the extractor
// binds the immediately preceding comment run to the next declaration, so sitting in that
// gap silently stole the target's doc string out of the graph.
fun missing_input(path: str, project: str) > str {
    return "deploy-generate: " + path
        + " is missing - run `magus run build docs console` first (one dispatch, both "
        + "producers). The " + project + " project owns it, and this target reads across "
        + "that boundary without depending on it, so no run order builds it for you.";
}

// deploy-generate assembles gen/site: the exact tree the Pages deploy publishes, docs at
// the root of it and the console app under /console/.
//
// It lives here rather than in the Pages workflow because that workflow is meant to be thin -
// set up a toolchain, name targets, upload the artifact - and the layout below is portable
// logic that would otherwise be GitHub-specific shell. It is also what makes the deploy
// reproducible locally: run the same three commands, then serve gen/site, and what you see
// is what publishes.
//
// It ASSEMBLES ONLY. It used to drive the two builds itself (magus\run of docs generate and
// console build) so one command reproduced the deploy, and that tripped MGS3001: a root
// target that writes into a descendant project's tree breaks the boundary the cache and the
// affected set are computed over. The ward is right, and the fix is not to widen the parent's
// footprint - it is for each project to write its own tree. So the caller runs the two
// builds, then this. That is still three target names and no logic in the workflow, which is
// what the thin-workflow rule actually asks for.
//
// Named -generate, and excluded from the umbrella by name. The root `generate` target above
// is `ctx.needs(ctx.glob("*-generate", "!deploy-generate"))`: the suffix would otherwise
// enrol a full tree copy in every `magus run generate`, to satisfy a drift gate over output
// that is deliberately gitignored. Before negation existed the only remedy was to avoid the
// name - which is what the `tapes` target above still records, and what this target was first
// called (build-site). Renaming around a matcher hides the reason at both ends: the glob does
// not say what it is missing, and the target does not say why it is called something else.
// "!deploy-generate" says it once, where it applies.
//
// NOT site-generate: the docs project already exports a target by that name, and two targets
// called the same thing in one workspace - one rendering docs/gen, one assembling the whole
// deploy - is a coin flip every time someone types it. NOT website-generate either: this repo
// renamed website/ to docs/ deliberately, so "website" is retired vocabulary. "site" itself is
// the house term (the Site type, site_render, site_publish, docs/site/), which is exactly why
// it needed a qualifier here rather than a replacement.
export fun deploy_generate(ctx: magus\Context, args: [str]) > void {
    final DOCS_GEN = "docs/gen";
    final CONSOLE_GEN = "console/gen";
    // gen/site, not a new top-level name: gen/ is what every project in this workspace
    // calls its generated output (docs/gen, console/gen, proto/gen, and this project's own
    // gen/*.json). The root's gen/*.json output glob is file-level, so the two do not
    // overlap. Inventing a second convention for "generated output" would only ever be a
    // thing to explain.
    final OUT = "gen/site";

    // Both trees are generated now, not committed, so "missing" no longer means someone
    // deleted a file - it means a build did not run, or silently produced nothing. Publishing
    // that would replace a working site with an empty one, so say which command is missing.
    if (!fs\exists(DOCS_GEN + "/index.html")) {
        throw missing_input(DOCS_GEN + "/index.html", "docs");
    }
    if (!fs\exists(CONSOLE_GEN + "/index.html")) {
        throw missing_input(CONSOLE_GEN + "/index.html", "console");
    }

    // Rebuilt from empty every time: a stale page left behind by a previous assembly would
    // publish as a live URL that no source produces any more.
    if (fs\exists(OUT)) { fs\delete(OUT); }
    fs\copyDir(DOCS_GEN, OUT);
    // The console project OWNS /console/, so its subtree is replaced wholesale. This discards
    // the docs render's /console/ redirect stub, which exists only to satisfy the docs
    // asset-integrity gate, so the real app wins - the same precedence `serve` gets from
    // longest-prefix mount routing.
    if (fs\exists(OUT + "/console")) { fs\delete(OUT + "/console"); }
    fs\copyDir(CONSOLE_GEN, OUT + "/console");

    magus\info("assembled " + OUT + " - docs at /, console at /console/");
}

// serve is the workspace-root dev loop for BOTH deployables. ONE web server hosts the
// two rendered gen/ trees (generated, not committed) with the GitHub Pages pathing - "/" serves docs/gen and
// "/console/" serves console/gen, where the console SPA SHADOWS the docs render's
// /console/ redirect stub (longest-prefix routing in http.server's mounts mode),
// exactly like the deploy that assembles docs/gen at the root and console/gen under
// /console/. It spans both projects, so it lives at the workspace root rather than in
// either one. On a source change it HOT-REBUILDS the affected project's gen/: a docs
// or blog edit re-renders docs/gen (the fast docs `render` target, not the heavy
// drift-gated generate), a console-source edit rebuilds console/gen (pnpm run build).
// A static file server reads current bytes off disk, so each rebuild is picked up on
// the next request with no server restart. http.server runs in the background and
// fs.watch blocks, so the loop stays up until Ctrl-C.
//
// This rebuilds docs/console CONTENT, never magus itself - it does NOT trip the
// self-rebuild anti-pattern CLAUDE.md warns against.
export fun serve(ctx: magus\Context, args: [str]) > void {
    final DOCS_GEN = "docs/gen";
    final CONSOLE_GEN = "console/gen";
    if (!fs\isDir(DOCS_GEN)) { throw "serve: " + DOCS_GEN + " not found - run `magus run build docs` first"; }
    if (!fs\isDir(CONSOLE_GEN)) { throw "serve: " + CONSOLE_GEN + " not found - run `magus run build console` first"; }

    // No port -> http.server scans from 8080 for the first free one and returns it, so
    // the printed URL is correct even when 8080 is busy. "/console/" is longer than
    // "/", so a /console/ request routes (longest-prefix) to the console tree.
    final port = http\server({"mounts": {"/": DOCS_GEN, "/console/": CONSOLE_GEN}});
    magus\info("serving the deploy at http://localhost:{port}/");
    magus\info("  /          -> " + DOCS_GEN + "  (docs)");
    magus\info("  /console/  -> " + CONSOLE_GEN + "  (console SPA, shadows the docs /console/ redirect)");
    magus\info("watching docs/ + blog/ (re-render docs) and console/ sources (rebuild console); Ctrl-C to stop");

    // Watch SOURCES only, never the gen/ output trees: fs.watch's built-in ignore
    // prunes any dir named gen/ or node_modules/, so watching docs/, blog/, and
    // console/ never observes a rebuild's own writes and so cannot self-retrigger a
    // rebuild loop. Each try/catch keeps a failed rebuild from ending the watch.
    // Staleness tripwire. This loop regenerates COMMITTED output (docs/gen) from inside a
    // long-lived process, so if magus itself is rebuilt underneath it, every later rebuild
    // writes bytes produced by the old logic: fresh mtimes, no error, wrong content. The
    // daemon's adoption gate (internal/proc/identity.go) cannot catch this - it compares a
    // client against a server across IPC, and here there is no second party, only one
    // process that has quietly gone out of date.
    // Refuse rather than reload: CLAUDE.md forbids a watch-rebuild loop for magus itself,
    // so the correct move is to stop generating and make the human restart.
    final exe = os\executable();
    final exeStamp = fun() > str {
        try {
            final st = fs\stat(exe);
            // Bracket access, not st.size: `size` is a built-in map METHOD, so dot access
            // returns the method rather than the stat field.
            return "{st["mtime"]}:{st["size"]}";
        } catch (e) {
            // Binary already gone (a `go run` temp build is deleted once up). Nothing to
            // compare against, so the tripwire simply stays quiet.
            return "";
        }
    };
    final startStamp = exeStamp();

    fs\watch(["docs", "blog", "console"], fun(changed: [str]) > bool {
        final nowStamp = exeStamp();
        if (startStamp != "" and nowStamp != "" and nowStamp != startStamp) {
            // One record, not four: this is a single event, and each magus.error is its own
            // log line. The REMEDY stays inside the error rather than moving to magus.hint,
            // even though a remedy is what hints are for: emitMagusHint only fires when
            // interactive.Enabled(), so a hint is silently dropped for an agent or in CI -
            // precisely the callers that cannot infer the fix themselves. The watch is
            // ending here, so losing the remedy leaves no way forward. Hints carry what is
            // safe to lose; this is not.
            magus\error("serve: the magus binary changed while this server was running (" + exe
                + "); this process still runs the OLD code, so anything it regenerates now would be stale."
                + " Stop it (Ctrl-C) and start it again to pick up the new build.");
            // Advisory, and safe to lose: the general rule behind this one instance.
            magus\hint("a long-lived magus keeps regenerating with the logic it started with; restart it after a rebuild");
            return true; // end the watch; a stale generator must not keep writing gen/
        }
        var docsHit = false;
        var consoleHit = false;
        foreach (p in changed) {
            if (p.startsWith("console/")) {
                consoleHit = true;
            } else {
                docsHit = true; // docs/* or blog/* re-renders the docs site
            }
        }
        if (docsHit) {
            magus\info("docs/blog change - re-rendering " + DOCS_GEN);
            try {
                rerender_docs();
            } catch (e) {
                magus\warn("docs render failed, still watching: " + e);
            }
        }
        if (consoleHit) {
            magus\info("console change - rebuilding " + CONSOLE_GEN);
            try {
                rebuild_console();
            } catch (e) {
                magus\warn("console build failed, still watching: " + e);
            }
        }
        return false;
    });
}
