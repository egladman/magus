// Outputs are declared per target with ctx.writesFiles: a project-wide set would let
// a go-build hit restore a stale MAGUS.md.
magus\project({
    "tools": policy\all,
    // Without it the label is the checkout's basename, so each worktree renames the project.
    "name": "magus",
    // Only this edge puts a .proto edit in the affected set and orders proto's generate first.
    // libs/figure: go-build embeds figure.buzz.
    "depends_on": ["proto", "libs/figure"],
    "layers": {
        "internal/httpx": "transport",
        "internal/handler/*": "handler",
        "internal/service": "service",
        "internal/service/*": "service",
        "internal/cache": "repository",
        "internal/graph/knowledge": "repository",
        "internal/server": "composition",
    },
    // buzz claims **/*.buzz, which go_build keys on, and builds the Buzz symbol index
    // (scip-buzz) beside the Go one.
    "spells": [go, markdown, bash, buzz],
    // Tool configs no spell glob matches. Each changes what a target does, so an
    // undeclared one replays a stale verdict. Files doctor lists as undeclared stay
    // out when nothing reads them. Never add .gitattributes: magus writes it.
    "sources": [
        ".golangci.yml",
        ".mockery.yaml",
        ".markdownlintignore",
        "dprint-base.json",     // dprint.json extends it; the markdown spell declares only dprint.json
        "mise.toml",
        "magus.yaml",
        "Dockerfile",
        "Dockerfile.static",
        "hack/docs/screenshot.mjs",
        ".*/hooks.json",
        ".codex/rules/*.rules",
        "opencode.json",
        // Claude Code keeps its hooks in settings.json, which the glob above misses.
        ".claude/settings.json",
        "spells/harness/**/*.buzz",
        // No spell claims these, so a refresh would not invalidate the tests that read them.
        "testdata/hosts/**/*.json",
        // Per directory, not **/testdata/**: some testdata files are generate outputs.
        "internal/hint/testdata/*",
        "internal/job/testdata/*",
        "benchmarks/agent/internal/bench/testdata/*",
        // Embedded in the binary, and no other glob matches it.
        "internal/selfupdate/release-keys.json",
    ],
    "targets": {
        "watch": {"skip_cache": "blocks on a filesystem watch loop and never returns"},
        "serve": {"skip_cache": "blocks as a long-running dev server and never returns"},
        // No ctx.writesFiles: output globs feed .gitattributes, where gen/site cannot conflict.
        "deploy-generate": {"skip_cache": "assembles a gitignored deploy tree that is never snapshotted"},
        // No isolation flag; see docs/decisions/0001.
        "generate": {"skip_cache": "is the drift gate itself; a replay would skip the check it exists to make"},
        "harness-drift": {"skip_cache": "plans with the running binary's harness planner, which no input glob can key"},
        "index-generate": {"skip_cache": "output derives from the entire knowledge graph, which no input glob can key"},
        "graph-generate": {"skip_cache": "output derives from the entire knowledge graph, which no input glob can key"},
        "symbol-digest-generate": {"skip_cache": "digests the symbol index in the cache, which no input glob can key; it runs before any replay of a target reading gen/symbol-index.json, so those stay cacheable"},
        "agent-bench-report": {"skip_cache": "reads benchmark run artifacts under benchmarks/agent/results, which change independently of this tree"},
        "agent-bench-run": {"skip_cache": "launches paid agent sessions and writes benchmarks/agent/results; a replay would be a run that never happened"},
        "go-build": {"skip_cache": "declares no outputs, so a replay would skip the link and restore no binary"},
        "image-build": {"skip_cache": "pushes and cosign-signs a registry digest per invocation"},
        "image-registries": {"skip_cache": "reports the registry table resolved from the current environment"},
        "spell-publish": {"skip_cache": "pushes to a registry per invocation; a replay would publish nothing"},
        "spell-lock": {"skip_cache": "asks a registry under update, and writes no magus.lock while no remote spell is declared"},
        // image-scan has no skip_cache: the docker spell's trivy probe keys it on the database.
        "release-build": {"skip_cache": "a release must never replay a cached artifact; each invocation produces the bytes that ship"},
        "release-sign": {"skip_cache": "signs the manifest per invocation; a replayed signature would cover different bytes"},
        "release-index": {"skip_cache": "signs the index per invocation and, with cd, pushes a branch; a replay would publish nothing"},
        "release-publish": {"skip_cache": "reads whether the GitHub Release exists, which no file input carries"},
        "release-manifest": {"skip_cache": "reads the published release and main's manifest, which no file input carries"},
        "release": {"skip_cache": "mutates go.mod and creates VCS tags, an order-sensitive side effect"},
        // memory_mb: -race shadow memory in every test binary exhausts a 16GB runner.
        // Linux pipepeer tests read their children's /proc entries.
        "test": {
            "timeout": "15m",
            "memory_mb": 10240,
            "sandbox": {"allow": if (os\platform()[0] == "linux") [{"path": "/proc", "mode": "ro"}] else []},
        },
        "coverage-render": {"skip_cache": "reads the console's figure and the assembled site, which it cannot declare as inputs"},
        "security": {
            "skip_cache": "depends on trivy's license classifier version, which no cache key can see",
            "timeout": "15m",
        },
        // The timeout rides the context, so it bounds every target ci composes.
        // Members reached through ctx.needs run inline and never cache; see MGS1009.
        "ci": {
            "skip_cache": "composes the gates and reads nothing itself; its key is the whole tree, so it can never replay",
            "timeout": "45m",
        },
        "pr-title": {"skip_cache": "judges the pull request event, which no file input carries"},
        "pr-changelog": {"skip_cache": "judges the pull request event and the base ref, which no file input carries"},
        "pr-description": {"skip_cache": "judges the title and description its flags carry, which no file input holds"},
        "git-hooks-install": {"skip_cache": "reconciles the git hooks directory, which is outside the tree and no input carries"},
        "git-hooks-remove": {"skip_cache": "reconciles the git hooks directory, which is outside the tree and no input carries"},
        "termcast-record": {"skip_cache": "records a real session, so its bytes differ every run and a replay would show different code"},
        "termcast-showcase": {"skip_cache": "drives a live interactive session, so its bytes differ every run"},
    },
});

// releases\rootReleaseTag rejects verified-refinements and per-module tags such as
// libs/gopherbuzz/v0.1.0.
fun exact_release_tag() > str !> any {
    return releases\rootReleaseTag(tag_names_on_head());
}

// Unpatterned: a glob stops at "/", and the release checks need the namespaced tags.
fun tag_names_on_head() > [str] !> any {
    final head = vcs\commit().id;
    var names = mut [<str>];
    foreach (t in vcs\tags()) {
        if (t.id == head) { names.append(t.name); }
    }
    return names;
}

// A root tag on HEAD beats describe, which picks arbitrarily among a release commit's
// per-module tags. `v[0-9]*` keeps describe off verified-refinements and libs/<name>/v*.
fun version() > str !> any {
    try {
        final tag = exact_release_tag();
        if (tag != "") {
            if (vcs\isDirty()) { return tag + "-dirty"; }
            return tag;
        }
        final v = vcs\cmd(["describe", "--tags", "--always", "--dirty", "--match", "v[0-9]*"],
            {"quiet": true}).stdout.trim();
        if (v == "") { return "unknown"; }
        return v;
    } catch (e) {
        return "unknown";
    }
}

fun commit() > str !> any {
    try {
        return vcs\commit().short;
    } catch (e) {
        return "unknown";
    }
}

fun build_date() > str !> any {
    try {
        final c: Commit = vcs\commit();
        return c.date;
    } catch (e) {
        return "unknown";
    }
}

// Set by release.yaml, never read from the runner, so it can match the keyless
// signature's job_workflow_ref.
fun built_by() > str !> any { return os\env("BUILT_BY") ?? ""; }

fun ld_flags() > str !> any {
    return "-w -s"
        + " -X main.version=" + version()
        + " -X main.commit=" + commit()
        + " -X main.buildDate=" + build_date()
        + " -X main.builtBy=" + built_by();
}

// Compiles the version-stamped magus binary.
export fun go_build(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(gopherbuzz\build);
    // The embedded spell type mirrors are an output, so the link must follow their
    // regeneration; ctx.readsFiles would replace the **/*.go footprint, not add to it.
    ctx.needs(spells_generate);
    // Read after spells_generate so it records the declarations this link embeds.
    final stamp = agentpolicy\buildStamp(".");
    go["go-build"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {
        "args": ["-trimpath",
            "-ldflags", ld_flags() + " -X github.com/egladman/magus/internal/interp/bindings.buildStamp=" + stamp,
            "-o", "magus",
            "./cmd/magus"],
    });
}

// host is what login authenticates against and repository is where a push goes;
// they differ per provider. user_ref and token_ref are secret references.
object Registry {
    host: str = "",
    repository: str = "",
    user_ref: str = "",
    token_ref: str = "",
}

final GHCR = Registry{
    host = "ghcr.io",
    repository = "ghcr.io/egladman/magus",
    user_ref = "GHCR_USERNAME",
    token_ref = "GHCR_TOKEN",
};

// Declared rather than derived from the git remote, so a fork cannot publish to its
// own namespace.
final GHCR_GRAPH = Registry{
    host = "ghcr.io",
    repository = "ghcr.io/egladman/magus/knowledge-graph",
    user_ref = "GHCR_USERNAME",
    token_ref = "GHCR_TOKEN",
};

final GHCR_SPELLS = Registry{
    host = "ghcr.io",
    repository = "ghcr.io/egladman/magus/spells",
    user_ref = "GHCR_USERNAME",
    token_ref = "GHCR_TOKEN",
};

// TODO: Docker Hub publishing is disabled until DOCKERHUB_USERNAME / DOCKERHUB_TOKEN
// exist as repository secrets; uncomment and restore DOCKERHUB to REGISTRIES then.
// final DOCKERHUB = Registry{
//     host = "docker.io",
//     repository = "docker.io/egladman/magus",
//     user_ref = "DOCKERHUB_USERNAME",
//     token_ref = "DOCKERHUB_TOKEN",
// };

// Every tag goes into one buildx invocation, so each registry gets the identical digest.
final REGISTRIES = [GHCR];

fun image_tag() > str !> any { return "magus:" + commit(); }

fun image_stamps() > [str] !> any {
    return ["--build-arg", "VERSION=" + version(),
        "--build-arg", "COMMIT=" + commit(),
        "--build-arg", "DATE=" + build_date()];
}

// unpublished narrows registries to the ones a release image is pushed to: all of them
// under the mutable charm, otherwise those not yet carrying tag. A release's version tag is
// write-once, and the floating tags beside it (latest) move only when it is pushed.
fun unpublished(ctx: magus\Context, registries: [Registry], tag: str) > [Registry] !> any {
    final targets = mut [<Registry>];
    foreach (reg in registries) {
        final tags = registry_tags(reg.repository, user: magus\secret.read(reg.user_ref),
            token: magus\secret.read(reg.token_ref));
        if (publish_action(ctx, unit: reg.repository + ":" + tag, published: tags.indexOf(tag) != null) != releases\KEEP) {
            targets.append(reg);
        }
    }
    return targets;
}

// --sbom and --provenance make the result an index even for one platform.
// cosign runs per registry: a signature is stored beside the image in each repository.
fun publish_variant(ctx: magus\Context, dockerfile: str, platforms: str, registries: [Registry], tags: [str], meta: str) > [str] !> any {
    if (registries.len() == 0) { return []; }
    var args = mut ["-f", dockerfile];
    foreach (a in image_stamps()) { args.append(a); }
    foreach (reg in registries) {
        foreach (t in tags) { args.append("-t"); args.append(reg.repository + ":" + t); }
    }
    args.append("--platform"); args.append(platforms);
    args.append("--sbom=true");
    args.append("--provenance=mode=max");
    args.append("--metadata-file"); args.append(meta);
    args.append("--push");
    args.append(".");
    docker["docker-buildx"](ctx.withCwd("."), {"args": args});

    final digest = serialize\jsonDecode(fs\readFile(meta)).q("containerimage.digest").stringValue();
    var pushed = mut [<str>];
    foreach (reg in registries) {
        cosign["cosign-sign"](ctx, {"args": [reg.repository + "@" + digest]});
        foreach (t in tags) { pushed.append(reg.repository + ":" + t); }
    }
    return pushed;
}

fun write_image_summary(ctx: magus\Context, refs: [str]) > void !> any {
    if (!ctx.hasCharm("gha")) { return; }
    final summaryPath = os\env("GITHUB_STEP_SUMMARY");
    if (summaryPath == null or ("{summaryPath}") == "") {
        throw "image-build: the gha charm is set but $GITHUB_STEP_SUMMARY is unset; run this inside a GitHub Actions step";
    }
    if (refs.len() == 0) { return; }

    var md = "## Container images\n\n| Reference | Pull |\n| --- | --- |\n";
    foreach (r in refs) {
        md = md + "| `" + r + "` | `docker pull " + r + "` |\n";
    }
    md = md + "\nRun one against this workspace:\n\n```sh\ndocker run --rm -v \"$PWD\":/workspace "
        + refs[0] + " ls\n```\n";

    final sp = "{summaryPath}";
    var existing = "";
    if (fs\exists(sp)) { existing = fs\readFile(sp); }
    fs\writeFile(sp, existing + md);
}

// `--load` cannot load a multi-platform result, so a local build is one architecture.
// Always linux/: the artifact is a container image whatever the host OS.
fun load_platform(ctx: magus\Context) > str !> any {
    exclusive_charms(ctx, "amd64", "arm64", "WS1001", "which platform to build for");
    if (ctx.hasCharm("amd64")) { return "linux/amd64"; }
    if (ctx.hasCharm("arm64")) { return "linux/arm64"; }
    return "linux/" + os\platform()[1];
}

// Charms are an unordered set, so reading two in sequence would invent a precedence.
// WS is this workspace's code prefix; magus\raise refuses MGS.
fun exclusive_charms(ctx: magus\Context, a: str, b: str, code: str, question: str) > void !> any {
    if (ctx.hasCharm(a) and ctx.hasCharm(b)) {
        magus\raise(code, message: "the `" + a + "` and `" + b
            + "` charms both answer " + question + " - name one",
            opts: {"url": "https://eli.gladman.cc/magus/recommendations/#one-charm-answers-one-question"});
    }
}

fun load_variant(ctx: magus\Context, dockerfile: str) > void !> any {
    var args = mut ["-f", dockerfile];
    foreach (a in image_stamps()) { args.append(a); }
    args.append("-t"); args.append(image_tag());
    args.append("--platform"); args.append(load_platform(ctx));
    args.append("--load");
    args.append(".");
    docker["docker-buildx"](ctx.withCwd("."), {"args": args});
}

// Builds the image locally, or with `cd` pushes and signs it; `stable` and `unstable`
// pick the channel. A commit-channel signature carries cd.yaml's identity, so the
// release verify command rejects it.
export fun image_build(ctx: magus\Context, args: [str]) > void !> any {
    final registries = publish_registries(ctx);
    var pushed = mut [<str>];
    if (ctx.hasCharm("cd")) {
        final ch = channel(ctx);
        if (ch == "commit") {
            foreach (r in publish_variant(ctx, "Dockerfile.static", "linux/amd64,linux/arm64",
                registries, [commit()], "commit-meta.json")) { pushed.append(r); }
        } else {
            var staticTags = [version()];
            var dynamicTags = [version() + "-dynamic"];
            if (ch == "stable") {
                staticTags = [version(), "latest"];
                dynamicTags = [version() + "-dynamic", "latest-dynamic"];
            }
            foreach (r in publish_variant(ctx, "Dockerfile.static", "linux/amd64,linux/arm64",
                unpublished(ctx, registries: registries, tag: staticTags[0]), staticTags, "static-meta.json")) { pushed.append(r); }
            foreach (r in publish_variant(ctx, "Dockerfile", "linux/amd64",
                unpublished(ctx, registries: registries, tag: dynamicTags[0]), dynamicTags, "dynamic-meta.json")) { pushed.append(r); }
        }
        write_image_summary(ctx, refs: pushed);
    } else if (ctx.hasCharm("dynamic")) {
        load_variant(ctx, "Dockerfile");
    } else {
        load_variant(ctx, "Dockerfile.static");
    }
}

fun publish_registries(ctx: magus\Context) > [Registry] !> any {
    if (!ctx.hasCharm("cd")) { return []; }
    if (channel(ctx) == "commit") { return [GHCR]; }
    return REGISTRIES;
}

// `tagged` derives the channel from the release tag, so cutting a candidate needs only a tag.
fun channel(ctx: magus\Context) > str !> any {
    exclusive_charms(ctx, "stable", "unstable", "WS1002", "which channel to publish to");
    final wantTagged = ctx.hasCharm("tagged");
    final wantStable = ctx.hasCharm("stable");
    final wantUnstable = ctx.hasCharm("unstable");
    if (wantTagged and (wantStable or wantUnstable)) {
        magus\raise("WS1002", message: "the `tagged` charm reads which channel to publish "
            + "to off the release tag, so naming `stable` or `unstable` beside it answers "
            + "that question twice - name one",
            opts: {"url": "https://eli.gladman.cc/magus/recommendations/#one-charm-answers-one-question"});
    }
    if (!wantStable and !wantUnstable and !wantTagged) { return "commit"; }

    final v = version();
    if (v == "unknown") {
        throw "image: a channel charm needs a version and this tree reports none - magus "
            + "reads it from `git describe`, so a shallow clone with no tags cannot supply "
            + "one. Fetch tags, or drop the charm to publish to the commit channel.";
    }
    if (wantTagged) {
        final tag = exact_release_tag();
        if (tag == "") {
            throw "image: `tagged` reads the channel off the release tag HEAD sits on, and "
                + "HEAD is not tagged - `" + v + "` describes distance past the nearest tag "
                + "rather than a release. Tag the release first, or name `stable`/`unstable`.";
        }
        if (semver\parse(tag).prerelease == "") { return "stable"; }
        return "unstable";
    }

    // describe() gives an untagged commit a prerelease (v0.4.0-3-gabc123), so stable rejects
    // untagged builds too.
    final pre = semver\parse(v).prerelease;
    if (wantStable and pre != "") {
        throw "image: `" + v + "` carries the prerelease `" + pre + "`, so it cannot go to "
            + "the stable channel - that is the channel `latest` follows. Use `unstable` "
            + "for it, or run this from a stable release tag.";
    }
    if (wantUnstable and pre == "") {
        throw "image: `" + v + "` is a stable version, so `unstable` would file it under a "
            + "channel it does not belong to. Use `stable` for it.";
    }
    if (wantStable) { return "stable"; }
    return "unstable";
}

// By host, never index: how many registries there are depends on the charms.
fun select_registries(registries: [Registry], host: str) > [Registry] !> any {
    if (host == "") { return registries; }
    var hosts = "";
    foreach (reg in registries) {
        if (reg.host == host) { return [reg]; }
        if (hosts != "") { hosts = hosts + ", "; }
        hosts = hosts + reg.host;
    }
    throw "no registry \"{host}\" for these charms; this mode publishes to: {hosts}";
}

// Reports where image-build under the same charms pushes and, with `verify`, fails when a
// credential does not resolve.
export fun image_registries(ctx: magus\Context, args: [str]) > void !> any {
    var host = "";
    if (args.len() > 0) { host = args[0]; }
    final registries = select_registries(publish_registries(ctx), host);
    if (registries.len() == 0) {
        magus\log.info("image-registries: this build pushes nowhere; add the cd charm to see where a delivery goes (`:cd` per-commit, `:cd,stable` a release)");
        return;
    }
    // Resolving can open a provider's unlock prompt, so only `verify` resolves.
    final checking = ctx.hasCharm("verify");
    var table = pad("REGISTRY", 12) + pad("REPOSITORY", 28) + pad("USERNAME REF", 20) + pad("TOKEN REF", 20) + "CREDENTIALS";
    foreach (reg in registries) {
        var state = "not checked (add the verify charm)";
        if (checking) { state = credential_state(reg); }
        table = table + "\n" + pad(reg.host, 12) + pad(reg.repository, 28)
            + pad(reg.user_ref, 20) + pad(reg.token_ref, 20)
            + state;
    }
    // magus\log.info prefixes only its first line, so the table follows a lead line.
    magus\log.info("image-build under these charms publishes to:\n" + table);

    if (!checking) { return; }
    var unready = mut [<str>];
    foreach (reg in registries) {
        if (credential_state(reg) != "ready") { unready.append(reg.host); }
    }
    if (unready.len() > 0) {
        throw "image-registries: no usable credentials for " + unready.join(", ")
            + "; set the variables named above (in CI they come from repository secrets)";
    }
}

// A provider signals a missing secret by throwing, so presence is only testable by resolving.
fun credential_state(reg: Registry) > str {
    var missing = mut [<str>];
    if (!resolvable(reg.user_ref)) { missing.append(reg.user_ref); }
    if (!resolvable(reg.token_ref)) { missing.append(reg.token_ref); }
    if (missing.len() == 0) { return "ready"; }
    return "missing " + missing.join(", ");
}

fun resolvable(ref: str) > bool {
    try {
        magus\secret.read(ref);
        return true;
    } catch (e) {
        return false;
    }
}

fun pad(s: str, width: int) > str !> any {
    var padded = s;
    while (padded.len() < width) { padded = padded + " "; }
    return padded + " ";
}

// Scans the image with trivy; the rw charm writes SARIF and gates on HIGH/CRITICAL.
// Through the spell op, not proc\exec, so trivy's database keys the cache.
export fun image_scan(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(image_build);
    if (ctx.hasCharm("rw")) {
        fs\mkdirAll("dist");
        docker["trivy-image"](ctx, {"args": [
            "--format", "sarif",
            "--output", fs\join("dist", "trivy.sarif"),
            "--severity", "HIGH,CRITICAL",
            "--exit-code", "1",
            image_tag()]});
    } else {
        docker["trivy-image"](ctx, {"args": [image_tag()]});
    }
}

// Runs govulncheck and gates on dependency license terms.
// magus is GPL-3.0-or-later, so compatible copyleft is ignored explicitly and anything
// unrecognized fails. GPL-2.0-only, CDDL, EPL, MPL-1.1 and BSD-4-Clause are incompatible.
export fun security(ctx: magus\Context, args: [str]) > void !> any {
    // Parsed first so a bad argument fails before generate runs.
    final inheritedFatal = advisories\inheritedFatal(args);
    // govulncheck parses generated .go files, so it must follow generate or race mockery.
    ctx.needs(generate);
    advisories\govulncheck(ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), go: go, inheritedFatal: inheritedFatal);
    proc\exec("trivy", ["fs", "--scanners", "license",
        "--severity", "HIGH,CRITICAL",
        "--ignored-licenses", "AGPL-3.0,AGPL-3.0-only,AGPL-3.0-or-later,"
            + "GPL-3.0,GPL-3.0-only,GPL-3.0-or-later,GPL-2.0-or-later,"
            + "LGPL-2.1,LGPL-2.1-only,LGPL-2.1-or-later,"
            + "LGPL-3.0,LGPL-3.0-only,LGPL-3.0-or-later",
        "--exit-code", "1",
        // .magus is magus's own cache, which lint's graph build rewrites while this walks
        // the tree: a shard renamed mid-walk failed the scan. .claude/worktrees holds whole
        // other checkouts in a local clone. Neither carries a dependency's license.
        "--skip-dirs", ".magus,.claude/worktrees",
        "."], ".", {});
}

// Renders the roff man pages into manpage/ and refreshes internal/cli/testdata/api.lock,
// both serialized from the internal/cli registry. The Markdown manpages belong to docs/.
export fun man_generate(ctx: magus\Context, args: [str]) > void !> any {
    // Both lines compile internal/spell, which go:embeds generated files, so every generator
    // writing Go under internal/ or types/gen must finish first or MGS4008 refuses the run.
    ctx.needs(spells_generate, job_generate, bindings_generate, langservice_generate,
              mcp_tools_generate, config_generate, mocks_generate);
    ctx.readsFiles("cmd/magus-manpage/**/*.go", "internal/**/*.go", "types/**/*.go",
        "go.mod", "go.sum", "go.work", "go.work.sum",
        "internal/spell/gen/types/*.buzz",
        "internal/spell/gen/decls/*.buzz", "internal/job/gen/*.json");
    ctx.writesFiles("manpage/*.1", "internal/cli/testdata/api.lock");
    fs\mkdirAll("manpage");
    proc\exec("go", ["run", "./cmd/magus-manpage", "-format", "roff", "-out", "manpage"]);
    proc\exec("go", ["generate", "./internal/cli/..."]);
}

fun pull_request_event(ctx: magus\Context, target: str) > serialize\Boxed? !> any {
    if (!ctx.hasCharm("gha")) { return null; }
    final path = os\env("GITHUB_EVENT_PATH") ?? "";
    if (path == "" or !fs\exists(path)) {
        throw "{target}: the gha charm is set but $GITHUB_EVENT_PATH names no file; run it in a pull_request workflow";
    }
    return serialize\jsonDecode(fs\readFile(path)).q("pull_request");
}

fun pull_request_title(ctx: magus\Context, args: [str], target: str) > str !> any {
    final title = args.join(" ");
    if (title != "") { return title; }
    final event = pull_request_event(ctx, target: target);
    if (event == null) {
        throw "{target}: no title: pass one after `--`, or add the gha charm in a pull_request workflow";
    }
    return event?.q("title").stringValue() ?? "";
}

// Fails a pull request title that is not a conventional commit subject, or whose
// description opens in the past tense or sells instead of saying what changed.
export fun pr_title(ctx: magus\Context, args: [str]) > void !> any {
    final title = pull_request_title(ctx, args: args, target: "pr-title");
    final problems = mut [<str>];
    final problem = commits\problem(title);
    if (problem != "") {
        problems.append(problem);
    } else {
        foreach (wordy in wording\wordingProblems(title, conventional: true)) {
            problems.append(wordy);
        }
    }
    if (problems.len() > 0) {
        throw "pr-title: \"{title}\": {problems.join("; ")}";
    }
    magus\log.info("pr-title: \"{title}\" is a conventional commit subject");
}

// Fails a pull request whose title or description the prose judge in libs/conventions/prose
// finds a fault in, the judge the guard's pull-request-text rule runs, so the two cannot
// disagree. Each area the branch touches that the description never names is asked about
// as a warning, which fails nothing. --title and --body carry the text; the workflow, not
// this target, reads the event.
export fun pr_description(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(conventions\judge_build);
    final parsed = flags\parse(args, switches: [<str>], valued: ["--title", "--body"], required: ["--title", "--body"]);
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "pr-description: unexpected arguments {args.join(" ")}; pass --title=<title> --body=<description>";
    }
    final text = "{parsed.values["--title"] ?? ""}\n{parsed.values["--body"] ?? ""}";
    final problems = mut [<str>];
    final judge = descriptions\judgeRunner(".");
    foreach (f in judge(text)) {
        problems.append(descriptions\judgedProblem(f));
    }
    final changed = mut [<str>];
    foreach (f in vcs\changedFiles(vcs\base())) { changed.append(f.value); }
    foreach (question in descriptions\areaQuestions(descriptions\unnamedAreas(descriptions\areasOf(".", paths: changed), text: text))) {
        magus\log.warn("pr-description: {question}");
    }
    if (problems.len() > 0) {
        throw "pr-description: the description breaks the prose rules (docs/conventions.md):\n  " + problems.join("\n  ");
    }
    magus\log.info("pr-description: the title and description pass the prose rules");
}

// Fails a feat, fix, perf or breaking pull request that ships code without a changelog
// fragment under changes/unreleased/, and any malformed fragment.
export fun pr_changelog(ctx: magus\Context, args: [str]) > void !> any {
    final title = pull_request_title(ctx, args: args, target: "pr-changelog");
    final base = vcs\base();
    var changed = mut [<str>];
    foreach (f in vcs\changedFiles(base)) { changed.append(f.value); }
    var added = mut [<str>];
    foreach (path in changelog\fragments(changed)) {
        if (fs\exists(path)) { added.append(path); }
    }
    final malformed = changelog\lint(added);
    if (malformed.len() > 0) {
        throw "pr-changelog: malformed changelog fragment(s); changes/README.md has the format:\n  "
            + malformed.join("\n  ");
    }
    final problem = changelog\problem(title, changed: changed, added: added);
    if (problem != "") {
        throw "pr-changelog: against {base}: {problem}";
    }
    final owed = changelog\owed(title, changed: changed);
    if (owed.len() == 0) {
        magus\log.info("pr-changelog: \"{title}\" owes no entry against {base}");
        return;
    }
    magus\log.info("pr-changelog: {added.len()} changelog fragment(s) cover {owed.len()} shipped path(s)");
}

// Installs a shim in git's hooks directory for every hack/git-hooks/<hook>.buzz.
// Without rw it only reports what it would change.
export fun git_hooks_install(ctx: magus\Context, args: [str]) > void !> any {
    githooks\install(ctx, dir: "hack/git-hooks");
}

// Deletes the shims git_hooks_install wrote, and no hook anything else wrote.
export fun git_hooks_remove(ctx: magus\Context, args: [str]) > void !> any {
    githooks\remove(ctx, dir: "hack/git-hooks");
}

// Regenerates everything derived from the boundary registry: the runtime boundary list,
// the Go-to-Buzz encoders, the Buzz-to-Go decoders and the spell contract's signatures.
export fun types_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("internal/interp/bindings/gen/boundary_list.go",
        "internal/interp/bindings/gen/boundary_objects.go",
        "internal/interp/bindings/gen/decode/decode.go",
        "internal/interp/bindings/gen/decode/inbound_list_test.go",
        "internal/interp/bindings/gen/decode/contract.go");
    proc\exec("go", ["generate", "./cmd/magus-utils"]);
}

// Regenerates the Go host bindings (std -> internal/interp/bindings/gen) from
// std.Module declarations. The exclusions keep gen/'s hand-written tests and
// types_generate's files out of its outputs.
export fun bindings_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(types_generate, spells_generate, job_generate, langservice_generate);
    ctx.readsFiles("**/*.go", "go.mod", "go.sum", "go.work", "go.work.sum",
        "internal/spell/gen/types/*.buzz",
        "internal/spell/gen/decls/*.buzz", "internal/job/gen/*.json");
    ctx.writesFiles("internal/interp/bindings/gen/*.go",
        "!internal/interp/bindings/gen/*_test.go",
        "!internal/interp/bindings/gen/boundary_*.go");
    proc\exec("go", ["generate", "./std/..."]);
}

// Regenerates the magusfile API lock through TestMagusAPILocked.
// -count=1 is load-bearing: a cached pass writes no file.
export fun magusfile_api_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(bindings_generate);
    ctx.writesFiles("internal/interp/bindings/testdata/magus-api.lock");
    go["go-test"](ctx.withEnv({"UPDATE_MAGUS_API_LOCK": "1", "GOEXPERIMENT": "jsonv2"}),
        {"args": ["-count=1", "-run", "TestMagusAPILocked",
            "./internal/interp/bindings/"]});
}

