// Renders MAGUS.md via `magus describe graph`.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["MAGUS.md"]);
    final doc = magus\describe.graphMarkdown();
    fs\writeFile("MAGUS.md", doc + "\n");
}

// Writes gen/symbol-index.json, the symbol index digest. A target reading the index needs
// this one: being skip_cache, it runs before any replay of that reader.
export fun symbol_digest_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["gen/symbol-index.json"]);
    final d = magus\graph();
    final gaps: mut [str] = mut [<str>];
    foreach (g in d.gaps) { gaps.append(g.project.path); }
    final record: {str: any} = {"digest": d.digest, "indexed": d.indexed, "projects": d.projects, "gaps": gaps};
    final body = json\stringify(record, "  ") + "\n";
    final path = fs\join("gen", "symbol-index.json");
    if (fs\exists(path) and fs\readFile(path) == body) { return; }
    fs\mkdirAll("gen");
    fs\writeFile(path, body);
}

// Writes hack/policy/gen/proofread-decisions.json, RULES and MINIMUMS alone: a stdin run
// has no files, and proofread refuses a PATHS glob that matches no argument.
export fun proofread_decisions_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["hack/policy/proofread.buzz"]);
    ctx.writesFiles(["hack/policy/gen/proofread-decisions.json"]);
    final body = json\stringify(decisions\table([<str>]), "  ") + "\n";
    final path = fs\join("hack", "policy", "gen", "proofread-decisions.json");
    if (fs\exists(path) and fs\readFile(path) == body) { return; }
    fs\mkdirAll(fs\join("hack", "policy", "gen"));
    fs\writeFile(path, body);
}

// Exports the knowledge and target graphs the browser Graph Explorer loads; with cd it
// also publishes the knowledge graph.
export fun graph_generate(ctx: magus\Context, args: [str]) > void !> any {
    // Declared although gitignored: console's build consumes the pair.
    ctx.writesFiles(["gen/knowledge-graph.json", "gen/target-graph.json"]);
    fs\mkdirAll("gen");
    final knowledge = magus\cmd("graph", args: ["export", "--reproducible", "-o", "json"], opts: magus\CommandOptions{quiet = true}).stdout;
    fs\writeFile(fs\join("gen", "knowledge-graph.json"), knowledge);
    // The CLI's bytes, not magus\describe.graph(): the console reads the -o json field names.
    final targets = magus\cmd("describe", args: ["graph", "-o", "json"], opts: magus\CommandOptions{quiet = true}).stdout;
    fs\writeFile(fs\join("gen", "target-graph.json"), targets);
    // ci strips cd, so the gate never pushes.
    if (ctx.hasCharm("cd")) {
        publish_graph(ctx);
    }
}

// Pushes the knowledge store shard by shard, so a reader fetches only the shards it lacks.
// Tags follow channel(), matching the image built from the same merge.
fun publish_graph(ctx: magus\Context) > void !> any {
    final reg = GHCR_GRAPH;
    final user = magus\secret.read(reg.user_ref);
    final token = magus\secret.read(reg.token_ref);
    var tags = [commit()];
    if (channel(ctx) != "commit") {
        tags = [version(), "latest"];
    }
    foreach (tag in tags) {
        _ = magus\cmd("graph", args: ["push", "--ref", reg.repository + ":" + tag, "--username", user],
            opts: magus\CommandOptions{stdin = token});
    }
    magus\log.info("graph-generate: published {reg.repository} as {tags.len()} tag(s)");
}

// Publishes every spell the binary ships as an OCI artifact under GHCR_SPELLS, tagged
// with the release version, write-once: a spell whose repository already carries the tag
// is kept unless the run is mutable. Without cd it only prints each pinned reference.
export fun spell_publish(ctx: magus\Context, args: [str]) > void !> any {
    final listed = json\parse(magus\cmd("spell", args: ["ls", "magus/spell", "-o", "json"],
        opts: magus\CommandOptions{quiet = true}).stdout);
    final reg = GHCR_SPELLS;
    var shipped = mut {<str: str>};
    foreach (s in listed["spells"]) {
        final name = "{s["name"]}";
        final ref = "{s["reference"]}";
        if (!ref.startsWith(reg.repository + "/" + name + "@")) {
            throw "spell-publish: magus ships " + name + " as " + ref + ", outside GHCR_SPELLS ("
                + reg.repository + "); the two must name one repository";
        }
        shipped[name] = ref;
    }
    if (!ctx.hasCharm("cd")) {
        foreach (_, ref in shipped) {
            magus\log.info(ref);
        }
        return;
    }
    final tag = exact_release_tag();
    if (tag == "") {
        throw "spell-publish: HEAD is not on a release tag, and each spell is published under "
            + "the release version. Tag the release first; without cd this prints what would publish.";
    }
    final user = magus\secret.read(reg.user_ref);
    final token = magus\secret.read(reg.token_ref);
    foreach (name, _ in shipped) {
        final repo = reg.repository + "/" + name;
        final published = registry_tags(repo, user: user, token: token).indexOf(tag) != null;
        if (publish_action(ctx, unit: repo + ":" + tag, published: published) == releases\KEEP) { continue; }
        _ = magus\cmd("spell", args: ["push", "magus/spell/" + name, repo + ":" + tag,
            "--username", user], opts: magus\CommandOptions{stdin = token});
    }
}

// Owns magus.lock. Plain, it verifies every pinned digest without resolving a tag; only
// under update does it ask the registry and rewrite the lock. ci strips update.
export fun spell_lock(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["magus.yaml"]);
    ctx.writesFiles(["magus.lock"]);
    if (ctx.hasCharm("update")) {
        _ = magus\cmd("spell", args: ["lock", "--update"]);
        return;
    }
    _ = magus\cmd("spell", args: ["lock"]);
}

// Logs counts from the history metrics (hotspots, ownership, affinity, volatility).
export fun postflight(ctx: magus\Context, args: [str]) > void !> any {
    final hot = magus\history().hotspots();
    final own = magus\history().ownership();
    final aff = magus\history().affinity();
    final vol = magus\workspace().volatility();
    magus\log.info("hotspots: {hot.files.len()} file(s) ranked by churn against complexity");
    magus\log.info("ownership: {own.projects.len()} project(s) attributed");
    magus\log.info("affinity: {aff.pairs.len()} coupled project pair(s)");
    magus\log.info("volatility: {vol.targets.len()} target(s) with recorded run history");
}

// Regenerates every *-generate sibling, then gates on drift (scoped to cwd).
// Whole-tree, unlike the engine's declared-output check, so it catches a generator
// writing a path nobody declared.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    // Hashed before the generators run so the gate works on a dirty tree; requiring a
    // clean tree would make the pre-push check skip.
    var dirtyBefore: mut [str] = mut [<str>];
    foreach (f in vcs\status().files) { dirtyBefore.append(f.value); }
    // vcs\status collapses an untracked directory to one path; recursive hashing is only
    // for declared generated directories.
    final before = drift\vcsHashes(dirtyBefore);
    final rw = ctx.hasCharm("rw");
    final saved = if (rw) "" else drift\saveFiles(dirtyBefore);
    // Not diagnoseDrift: that classifies against one target's declarations.
    var dirtyNow: mut [str] = mut [<str>];
    try {
        gomod\replaceWorkspaceModules(ctx, go, ".");
        // symbol-digest-generate writes a gitignored file, so it has no drift to gate, and it
        // builds the full symbol index; the targets reading that file need it themselves.
        ctx.needs(ctx.glob("*-generate", "!deploy-generate", "!symbol-digest-generate"));
    } catch (err: any) {
        if (!rw) {
            foreach (f in vcs\status().files) { dirtyNow.append(f.value); }
            final moved = drift\vcsChangedSince(before, dirtyNow);
            final outputs = drift\declaredOutputs(moved);
            drift\restore(outputs, saved: saved, dirtyBefore: dirtyBefore);
            throw "{err}" + drift\leftNote(drift\leftAlone(moved, outputs: outputs));
        }
        throw err;
    }
    if (rw) { return; }

    foreach (f in vcs\status().files) { dirtyNow.append(f.value); }
    final changed = drift\vcsChangedSince(before, dirtyNow);
    if (changed.len() > 0) {
        final detail = ": " + changed.join(", ");
        // The diff, not just names: this gate's reader has a CI log, not the tree.
        var body = vcs\dirtyDiff(changed);
        if (body.len() > 4000) {
            body = body.sub(0, len: 4000)
                + "\n... truncated; `magus query output <ref>` has it all";
        }
        if (body != "") {
            magus\log.info("generate: what changed on this runner:\n" + body);
        }
        final outputs = drift\declaredOutputs(changed);
        drift\restore(outputs, saved: saved, dirtyBefore: dirtyBefore);
        // MGS4006 matches types.ClassifyDrift's code for the same condition.
        throw "MGS4006: generate: regeneration changed generated files, and they are "
            + "left as they were; run `magus run generate:rw` to write them, then commit. "
            + "Drift in another project needs `magus affected generate:rw` first"
            + detail + drift\leftNote(drift\leftAlone(changed, outputs: outputs)) + drift\secondCause;
    }
}

// Re-records tapes/core-loop.capture from a real magus on a real pseudo-terminal.
// Not named *_generate: generate would drift-gate bytes that differ every run.
