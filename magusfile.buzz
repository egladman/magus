// The `on.push.tags` filter. `*` stops at "/", so a per-module tag publishes nothing.
final RELEASE_TAG_REFSPEC = "v*";

final RELEASE_WORKFLOW = ".github/workflows/release.yaml";

// Every release archive in dist/, one releases\assetGlob per tool, sorted by path.
fun release_archives() > [str] !> any {
    final archives = mut [<str>];
    foreach (tool in releases\TOOLS) {
        foreach (p in fs\glob(releases\assetGlob(tool))) { archives.append(p.value); }
    }
    _ = archives.sort(fun (a: str, b: str) > bool => a < b);
    return archives;
}

// Maps an asset arch token to its GOARM level, or "" for arches without one. ARMv7
// traps on ARMv6, so each ships its own asset. Linux only: Go would build windows/arm.
fun goarm_level(goos: str, goarch: str) > str {
    if (goarch != "armv6" and goarch != "armv7") { return ""; }
    if (goos != "linux") {
        throw "release-build: " + goarch + " is a linux-only asset, so `" + goos + " "
            + goarch + "` is not a platform this project ships - use `linux " + goarch + "`.";
    }
    if (goarch == "armv6") { return "6"; }
    return "7";
}

// Reads the module list from the shipped binary, not go.mod: the two variants link
// different modules.
fun write_notices(stage: str, tool: str, binary: str) > void !> any {
    final modcache = proc\exec("go", ["env", "GOMODCACHE"], ".").stdout.split(separator: "\n")[0];
    final listing = proc\exec("go", ["version", "-m", fs\join(stage, binary)], ".").stdout;

    final body = mut ["THIRD-PARTY NOTICES\n\n"
        + tool + " is licensed under the terms in the accompanying LICENSE file. It links the\n"
        + "modules below, each under its own terms, reproduced here in full. This list is read\n"
        + "from the shipped binary, so it describes THIS artifact rather than the module graph\n"
        + "in general.\n\n"];
    var missing = mut [<str>];
    var count = 0;

    foreach (line in listing.split(separator: "\n")) {
        final f = line.split(separator: "\t");
        if (f.len() < 4) { continue; }
        if (f[1] != "dep") { continue; }
        if (f[2].startsWith("github.com/egladman/magus")) { continue; }

        final text = read_module_license(modcache, f[2], f[3]);
        if (text == "") { missing.append(f[2] + "@" + f[3]); continue; }
        body.append("==============================================================================\n"
            + f[2] + " " + f[3] + "\n"
            + "==============================================================================\n\n"
            + text + "\n\n");
        count = count + 1;
    }

    if (missing.len() > 0) {
        throw "release-build: no license found for " + "{missing.len()}"
            + " module(s), refusing to write an incomplete THIRD-PARTY-NOTICES: "
            + missing.join(separator: ", ");
    }
    fs\writeFile(fs\join(stage, "THIRD-PARTY-NOTICES"), body.join(""));
    magus\log.info("notices: documented {count} third-party modules");
}

fun read_module_license(modcache: str, path: str, version: str) > str !> any {
    final dir = fs\join(modcache, escape_module_path(path) + "@" + version);
    foreach (name in ["LICENSE", "LICENSE.md", "LICENSE.txt", "LICENSE", "LICENSE.txt",
                      "COPYING", "COPYING.md", "COPYING.txt"]) {
        final p = fs\join(dir, name);
        if (fs\exists(p)) { return fs\readFile(p); }
    }
    return "";
}

// The module cache's case encoding: an uppercase letter becomes "!" plus its lowercase.
fun escape_module_path(path: str) > str {
    final escaped = mut [<str>];
    var i = 0;
    while (i < path.len()) {
        final ch = path.sub(i, len: 1);
        final lower = ch.lower();
        if (lower != ch) { escaped.append("!" + lower); } else { escaped.append(ch); }
        i = i + 1;
    }
    return escaped.join("");
}

// release_asset is tool's archive path in dist/, refused before any write when its upload
// glob would miss it.
fun release_asset(tool: str, v: str, goos: str, goarch: str, suffix: str) > str !> any {
    final asset = fs\join("dist", releases\assetName(tool, version: v, goos: goos, goarch: goarch, suffix: suffix));
    final glob = releases\assetGlob(tool);
    // Against the upload glob, not the basename: a "/" in the version turns the name into
    // a path the glob misses, and the build stays green.
    if (!releases\matchesGlob(glob, releases\toSlash(asset))) {
        throw "release-build: the asset would be `" + asset + "`, which `"
            + glob + "` does not match, so the release upload would not find "
            + "it. Version `" + v + "` is what names it; check that HEAD's root release tag "
            + "resolves.";
    }
    return asset;
}

fun exe_name(tool: str, goos: str) > str {
    if (goos == "windows") { return tool + ".exe"; }
    return tool;
}

// archive_release_stage puts the license texts, readme and BUILDINFO beside tool's binary
// in stage, archives stage as asset, and writes the asset's digest beside it.
fun archive_release_stage(stage: str, tool: str, binary: str, readme: str, asset: str, buildinfo: str) > void !> any {
    // GPL-3.0 section 4 and the dependencies' licenses require their texts beside the binary.
    fs\copyFile("LICENSE", fs\join(stage, "LICENSE"));
    fs\copyFile(readme, fs\join(stage, "README.md"));
    write_notices(stage, tool: tool, binary: binary);
    fs\writeFile(fs\join(stage, "BUILDINFO"), buildinfo
        + "\nRun `go version -m " + tool + "` for the full module list and build settings.\n");

    _ = archive\compress(stage, asset);
    fs\removeAll(stage);

    // sha256File returns hex; crypto.hash returns raw bytes `sha256sum -c` cannot read.
    final digest = crypto\sha256File(asset);
    fs\writeFile(asset + ".sha256", digest + "  " + fs\basename(asset) + "\n");
}

fun build_release_variant(ctx: magus\Context, goos: str, goarch: str, cgo: bool, suffix: str) > void !> any {
    // Before any write, so a refused platform leaves no trace.
    // armv6/armv7 are asset names; they fold to GOARCH=arm plus GOARM.
    final goarm = goarm_level(goos, goarch);

    final v = version();
    final asset = release_asset("magus", v: v, goos: goos, goarch: goarch, suffix: suffix);
    // proofread links no C, so its static archive serves every host and a dynamic build
    // would only duplicate it.
    var proofreadAsset = "";
    if (!cgo) {
        proofreadAsset = release_asset("proofread", v: v, goos: goos, goarch: goarch, suffix: suffix);
    }

    fs\mkdirAll("dist");
    final binary = exe_name("magus", goos: goos);

    final stage = fs\join("dist", goos + "-" + goarch + suffix);
    fs\mkdirAll(stage);

    var env = mut {"GOOS": goos, "GOARCH": goarch, "GOEXPERIMENT": "jsonv2"};
    if (goarm != "") { env["GOARCH"] = "arm"; env["GOARM"] = goarm; }
    if (cgo) {
        env["CGO_ENABLED"] = "1";
        final cc = os\env("MAGUS_CGO_CC");
        if (cc != null and cc != "") { env["CC"] = cc; }
        // Pinned so cgo never runs an earlier pkg-config on PATH (Strawberry Perl's on Windows).
        final pkgbin = os\env("MAGUS_CGO_PKG_CONFIG");
        if (pkgbin != null and pkgbin != "") { env["PKG_CONFIG"] = pkgbin; }
        final pkgcfg = os\env("MAGUS_CGO_PKG_CONFIG_PATH");
        if (pkgcfg != null and pkgcfg != "") { env["PKG_CONFIG_PATH"] = pkgcfg; }
    } else {
        env["CGO_ENABLED"] = "0";
    }

    // An untagged build is what `go install` produces, so it must work anywhere. Static opts
    // out of FFI with noffi: purego's cgo_import_dynamic adds a PT_INTERP even at
    // CGO_ENABLED=0. The codec tags need system dev headers, so only dynamic opts in.
    var build_args = mut ["-trimpath"];
    if (cgo) { build_args.append("-tags"); build_args.append("liblzma,libzstd"); }
    else { build_args.append("-tags"); build_args.append("noffi"); }
    build_args.append("-ldflags"); build_args.append(ld_flags());
    build_args.append("-o"); build_args.append(fs\join(stage, binary));
    build_args.append("./cmd/magus");
    go["go-build"](ctx.withEnv(env), {"args": build_args});

    // Readable when a dynamic build cannot start for want of a library.
    var variant = "static";
    if (cgo) { variant = "dynamic"; }
    var platform = goos + "/" + goarch;
    if (goarm != "") { platform = platform + " (GOARM=" + goarm + ")"; }
    final info = " " + v + "\n"
        + "commit:   " + commit() + "\n"
        + "built:    " + build_date() + "\n"
        + "platform: " + platform + "\n"
        + "variant:  " + variant + "\n";
    archive_release_stage(stage, tool: "magus", binary: binary, readme: "README.md", asset: asset,
        buildinfo: "magus" + info);

    if (proofreadAsset == "") { return; }
    final pbinary = exe_name("proofread", goos: goos);
    final pstage = fs\join("dist", "proofread-" + goos + "-" + goarch + suffix);
    fs\mkdirAll(pstage);
    // -C runs the build inside proofread's own module, so -o climbs back out to dist/. The flags are
    // proofread-build's: proofread stamps no version, which BUILDINFO records instead.
    final up = proofread\home.split("/").map(fun (i: int, s: str) > str => "..").join("/");
    go["go-build"](ctx.withEnv(env), {"args": ["-C", proofread\home, "-trimpath",
        "-o", up + "/" + releases\toSlash(fs\join(pstage, pbinary)), "./" + proofread\command]});
    // The embedded tagger model is trained on CC BY-SA 4.0 data, which requires its attribution.
    fs\copyFile(fs\join(proofread\home, proofread\attribution), fs\join(pstage, "ATTRIBUTION-wordclass"));
    archive_release_stage(pstage, tool: "proofread", binary: pbinary,
        readme: fs\join(proofread\home, "README.md"), asset: proofreadAsset, buildinfo: "proofread" + info);
}

fun release_target_platform(goos: str, goarch: str) > [str] !> any {
    if (goos != null and goos != "") { return [goos, goarch]; }
    final envos = os\env("GOOS");
    final envarch = os\env("GOARCH");
    if (envos != null and envos != "" and envarch != null and envarch != "") { return [envos, envarch]; }
    final p = os\platform();
    return [p[0], p[1]];
}

// Builds one release binary for one platform. Default is static; the `dynamic` charm
// opts into the cgo build. The platform comes from args: a target's second parameter
// binds the whole argument list, whatever it is named.
export fun release_build(ctx: magus\Context, args: [str]) > void !> any {
    // `**`: this target stages into dist/<goos>-<goarch>/, which `*` would miss.
    ctx.writesFiles(["dist/**"]);
    // Every release run builds here first, however its tag was pushed.
    _ = proc\exec("go", args: ["run", "./cmd/magus-utils", "dev-shims"], dir: ".");
    var goos = "";
    var goarch = "";
    if (args.len() == 1) {
        throw "release-build: got one argument; pass both goos and goarch, e.g. -- linux armv7";
    }
    if (args.len() >= 2) { goos = args[0]; goarch = args[1]; }
    // The static archive carries "_static" and the dynamic one the bare name, as with
    // busybox-static. A "_" field keeps the name splittable on its arch.
    final p = release_target_platform(goos, goarch);
    if (ctx.hasCharm("dynamic")) {
        build_release_variant(ctx, p[0], p[1], true, "");
    } else {
        build_release_variant(ctx, p[0], p[1], false, "_static");
    }
}

// Signs dist/SHA256SUMS with the Ed25519 key in MAGUS_SIGNING_KEY, then verifies the
// written signature against the active release key this binary embeds, so a mis-set
// key fails here rather than in every client's self-update.
export fun release_sign(ctx: magus\Context, args: [str]) > void !> any {
    final manifest = fs\join("dist", "SHA256SUMS");
    final sigPath = manifest + ".sig";
    // The version header selfupdate's ParseManifest requires, added last before signing.
    fs\writeFile(manifest, releases\manifestWithVersion(fs\readFile(manifest), version: version()));
    // A dry run signs nothing and returns "", leaving no .sig to check.
    final key = magus\secret.read("MAGUS_SIGNING_KEY");
    if (crypto\signFile(crypto\SignAlgorithm.Ed25519, path: manifest, key: key) == "") { return; }
    releases\verifySignature(fs\readFile(manifest), sig: fs\readFile(sigPath),
        pubHex: releases\activeReleaseKey(fs\readFile(releases\KEYRING)), sigPath: sigPath);
    magus\log.info("signed {manifest} -> {sigPath}, verified against the release key");
}

// release_tag is the release tag HEAD sits on, which every publishing target publishes
// under.
fun release_tag(target: str) > str !> any {
    final tag = exact_release_tag();
    if (tag == "") {
        throw target + ": HEAD is not on a release tag, and a release is published under one;"
            + " check the tag out first";
    }
    return tag;
}

// publish_action decides, and says, what a publishing target does with one unit; the rule
// is releases\publishAction. unit names it the way a person would look it up.
fun publish_action(ctx: magus\Context, unit: str, published: bool) > str {
    final action = releases\publishAction(published: published, mutable: ctx.hasCharm("mutable"));
    if (action == releases\KEEP) {
        magus\log.info("{unit} is already published; keeping it (the mutable charm replaces it)");
    } else if (action == releases\REPLACE) {
        magus\log.warn("{unit} is already published; replacing it under the mutable charm");
    }
    return action;
}

// registry_tags lists the tags an OCI repository carries. `magus spell ls` reads any OCI
// repository's tags, image or spell. A repository never pushed to carries none, which the
// distribution spec reports as NAME_UNKNOWN. The read is authenticated because GHCR answers
// an anonymous read of a private package and of a missing one with the same denial.
fun registry_tags(repository: str, user: str, token: str) > [str] !> any {
    final res = magus\cmd("spell", args: ["ls", repository, "--username", user, "-o", "json"],
        opts: magus\CommandOptions{quiet = true, allowFailure = true, stdin = token});
    if (!res.ok) {
        if (res.stderr.indexOf("NAME_UNKNOWN") != null) { return []; }
        throw "cannot list the tags of {repository}, so whether a release is already published"
            + " there is unknown: {res.stderr.trim()}";
    }
    final tags = mut [<str>];
    final listed = json\parse(res.stdout)["tags"];
    if (listed == null) { return tags; }
    foreach (t in listed) { tags.append("{t}"); }
    return tags;
}

// release_assets names the assets tag's GitHub Release carries, or null when there is no
// such release. A release that exists with assets missing is still published: an upload
// was interrupted, and replacing it takes the mutable charm like any other.
fun release_assets(tag: str) > [str]? !> any {
    final res = proc\exec("gh", args: ["release", "view", tag, "--json", "assets", "--jq", ".assets[].name"],
        dir: ".", opts: proc\ExecOptions{quiet = true, allowFailure = true});
    if (!res.ok) {
        if (res.stderr.indexOf("release not found") != null) { return null; }
        throw "release: cannot read the {tag} GitHub Release: {res.stderr.trim()}";
    }
    final names = mut [<str>];
    foreach (line in res.stdout.split("\n")) {
        if (line.trim() != "") { names.append(line.trim()); }
    }
    return names;
}

// download_release fetches tag's published release into dist/ and verifies it before
// anything reads it: SHA256SUMS names tag, lists every archive present with its digest, and
// carries a signature by the release key. A partial download hashes perfectly well, so an
// unverified one is never trusted.
fun download_release(tag: str) > void !> any {
    fs\mkdirAll("dist");
    _ = proc\exec("gh", args: ["release", "download", tag, "--dir", "dist", "--clobber"], dir: ".", opts: proc\ExecOptions{quiet = true});
    final sumsPath = fs\join("dist", "SHA256SUMS");
    final sigPath = sumsPath + ".sig";
    var problems = mut [<str>];
    if (!fs\exists(sumsPath) or !fs\exists(sigPath)) {
        problems.append("SHA256SUMS or its signature is missing");
    } else {
        final have = mut {<str: str>};
        foreach (a in release_archives()) {
            have[fs\basename(a)] = crypto\sha256File(a);
        }
        problems = releases\sumsProblems(tag, sums: fs\readFile(sumsPath), have: have).cloneMutable();
    }
    if (problems.len() > 0) {
        throw "release: the published {tag} release does not verify, so nothing may build on it."
            + " Rebuild it and replace it with the mutable charm:\n  " + problems.join("\n  ");
    }
    releases\verifySignature(fs\readFile(sumsPath), sig: fs\readFile(sigPath),
        pubHex: releases\activeReleaseKey(fs\readFile(releases\KEYRING)), sigPath: sigPath);
}

// Publishes this tag's GitHub Release, write-once. With no release yet it signs the
// archives the release-build jobs left in dist/ and creates the release; with one it
// downloads and verifies that release into dist/ instead, so every later step reads the
// bytes people download rather than a rebuild of them. Replacing a published release takes
// the mutable charm. Without cd it signs and stops short of GitHub.
export fun release_publish(ctx: magus\Context, args: [str]) > void !> any {
    final tag = release_tag("release-publish");
    final action = publish_action(ctx, unit: "the {tag} GitHub Release", published: release_assets(tag) != null);
    if (action == releases\KEEP) {
        download_release(tag);
        return;
    }
    final archives = release_archives();
    if (archives.len() == 0) {
        throw "release-publish: dist/ holds no release archive; the release-build jobs leave them there";
    }
    final missing = releases\missingStaticTools(archives.map(fun (i: int, a: str) > str => fs\basename(a)));
    if (missing.len() > 0) {
        throw "release-publish: every static platform ships each of " + releases\TOOLS.join(", ")
            + ", and dist/ lacks " + missing.join(", ") + "; check release.yaml's upload paths";
    }
    final sums = mut [<str>];
    foreach (a in archives) { sums.append(fs\readFile(a + ".sha256")); }
    fs\writeFile(fs\join("dist", "SHA256SUMS"), content: sums.join(""));
    release_sign(ctx, args: args);
    if (!ctx.hasCharm("cd")) {
        magus\log.info("release-publish: DRY RUN - signed dist/SHA256SUMS; add the cd charm to {action} the {tag} release");
        return;
    }
    final files = archives + ["dist/SHA256SUMS", "dist/SHA256SUMS.sig"];
    if (action == releases\CREATE) {
        final create = mut ["release", "create", tag, "--generate-notes"];
        // Never left to the default, which hands a candidate the repository's latest pointer
        // that audit's compat job and `magus self update` follow.
        if (!semver\isStable(tag)) { create.append("--prerelease"); }
        _ = proc\exec("gh", args: create + files, dir: ".");
    } else {
        _ = proc\exec("gh", args: ["release", "upload", tag, "--clobber"] + files, dir: ".");
    }
}

// Cuts this tag's release manifest from its published release and hands it to main's
// signed index. Cut in the tag's tree, so its notes are the fragments the tag shipped;
// staged on a branch off main, so the index keeps every release main already lists, which
// an index built from an older tag's tree would drop. Main already carrying this manifest
// is done. release-index.yaml signs the index on that branch and opens the pull request,
// so this target never holds the signing key.
export fun release_manifest(ctx: magus\Context, args: [str]) > void !> any {
    final tag = release_tag("release-manifest");
    download_release(tag);
    final manifestPath = fs\join("releases", tag + ".yaml");
    _ = vcs\cmd(["fetch", "--no-tags", "origin", "+refs/heads/main:refs/remotes/origin/main"], vcs\CommandOptions{quiet = true});
    final onMain = vcs\cmd(["show", "origin/main:" + manifestPath], vcs\CommandOptions{quiet = true, allowFailure = true});
    if (publish_action(ctx, unit: "main's " + manifestPath, published: onMain.ok) == releases\KEEP) {
        // cut converges on main's copy when it names these archives, and refuses one naming others.
        fs\writeFile(manifestPath, content: onMain.stdout);
    }
    _ = proc\exec("go", args: ["run", "./cmd/magus-utils", "cut", "-version", tag, "-artifacts", "./dist",
        "-unreleased", "./changes/unreleased", "-out", "./releases"], dir: ".");
    final manifest = fs\readFile(manifestPath);
    if (onMain.ok and manifest == onMain.stdout) {
        magus\log.info("release-manifest: main already carries {manifestPath}; the index has nothing new");
        return;
    }
    if (!ctx.hasCharm("cd")) {
        magus\log.info("release-manifest: DRY RUN - add the cd charm to stage {manifestPath} for main's index");
        return;
    }
    final branch = releases\manifestBranch(tag);
    final dir = fs\tempDir("release-manifest-");
    _ = vcs\cmd(["worktree", "add", "--detach", dir, "origin/main"], vcs\CommandOptions{quiet = true});
    fs\writeFile(fs\join(dir, manifestPath), content: manifest);
    _ = vcs\cmd(["add", "--", manifestPath], vcs\CommandOptions{dir = dir, quiet = true});
    _ = vcs\cmd(["-c", "user.name=github-actions[bot]",
        "-c", "user.email=41898282+github-actions[bot]@users.noreply.github.com",
        "commit", "-m", "chore(release): stage the {tag} release manifest"], vcs\CommandOptions{dir = dir, quiet = true});
    // Force: a rerun stages the same manifest on the same branch, which only this target writes.
    _ = vcs\cmd(["push", "--force", "origin", "HEAD:refs/heads/" + branch], vcs\CommandOptions{dir = dir, quiet = true});
    _ = vcs\cmd(["worktree", "remove", "--force", dir], vcs\CommandOptions{quiet = true});
    _ = proc\exec("gh", args: ["workflow", "run", "release-index.yaml", "--ref", branch,
        "-f", "reason=the {tag} release"], dir: ".");
    magus\log.info("release-manifest: staged {manifestPath} on {branch}; release-index.yaml signs main's index with it and opens the pull request");
}

// Builds docs/gen/public/release/index.json from releases/*.yaml, signs it, regenerates
// what derives from the new manifest, and under cd publishes the change as a pull request.
// args[0] names what produced the index, as a sentence fragment. A pull request because
// main's ruleset refuses a workflow's direct push.
export fun release_index(ctx: magus\Context, args: [str]) > void !> any {
    if (args.len() == 0 or args[0].trim() == "") {
        throw "release-index: pass what produced this index as a sentence fragment,"
            + " e.g. -- \"the v0.4.0 release\"; it names the commit and the pull request";
    }
    // rw is refused: this target writes into docs, and rw arms the cross-project write
    // audit (MGS3001).
    if (ctx.hasCharm("rw")) {
        throw "release-index: drop the rw charm (locally: magus run release-index"
            + " --no-default-charms . -- <reason>) - rw arms the cross-project write"
            + " audit against the docs files this target must touch";
    }
    final reason = args[0];
    var buildArgs = mut ["run", "./cmd/magus-utils", "release-index",
        "-releases", "./releases", "-out", "./docs/gen/public/release"];
    final key = os\env("MAGUS_SIGNING_KEY");
    if (key == null or key == "") {
        if (ctx.hasCharm("cd")) {
            throw "release-index: cd publishes the signed pair and MAGUS_SIGNING_KEY is not set";
        }
        magus\log.info("release-index: MAGUS_SIGNING_KEY is not set; building unsigned (-no-sign) for this rehearsal");
        buildArgs.append("-no-sign");
    }
    _ = proc\exec("go", buildArgs);
    // Regenerated here or the pull request fails its own drift gate. The fan-out, not
    // ctx.needs(generate), whose gate would throw at the drift this publishes; a nested run
    // on this project deadlocks (MGS3007). docs takes a nested run because a handle on it
    // would close a root->docs->root cycle.
    ctx.needs(ctx.glob("*-generate", "!deploy-generate"));
    _ = magus\run(["generate:rw", "docs"]);

    final paths = releases\releaseIndexPaths();
    if (!vcs\isDirty(paths)) {
        magus\log.info("release-index: the signed index already matches releases/; nothing to publish");
        return;
    }
    if (!ctx.hasCharm("cd")) {
        magus\log.info("release-index: DRY RUN - the regenerated index differs; add the cd charm to branch, push, and open the pull request");
        return;
    }

    final branch = releases\releaseIndexBranch(vcs\commit().short);
    final subject = releases\releaseIndexSubject(reason);
    _ = vcs\cmd(["switch", "-c", branch]);
    _ = vcs\cmd(["add", "--"] + paths);
    // -c on this one commit leaves the developer's git config untouched.
    _ = vcs\cmd(["-c", "user.name=github-actions[bot]",
        "-c", "user.email=41898282+github-actions[bot]@users.noreply.github.com",
        "commit", "-m", subject]);
    // Force: a re-run regenerates the same branch, which only this target writes.
    _ = vcs\cmd(["push", "--force", "origin", branch]);

    final open = proc\exec("gh", args: ["pr", "list", "--head", branch, "--state", "open",
        "--json", "number", "--jq", ".[].number"], dir: ".", opts: proc\ExecOptions{quiet = true}).stdout.trim();
    if (open != "") {
        magus\log.info("release-index: a pull request for " + branch + " is already open");
        return;
    }
    // Repository settings can forbid workflows from opening pull requests; the pushed
    // branch is the deliverable, so a refusal only warns.
    final created = proc\exec("gh", args: ["pr", "create", "--base", "main", "--head", branch,
        "--title", subject, "--body", releases\releaseIndexPrBody()],
        dir: ".", opts: proc\ExecOptions{allowFailure = true});
    if (!created.ok) {
        magus\log.warn(releases\releaseIndexPrFallback(os\env("GITHUB_REPOSITORY") ?? "",
            branch: branch));
    }
}

// A noted verdict passes; it puts a finding in the transcript without stopping the release.
object Verdict {
    ok: bool = false,
    note: bool = false,
    name: str = "",
    detail: str = "",
}

fun passed(name: str, detail: str) > Verdict { return Verdict{ok = true, name = name, detail = detail}; }
fun failed(name: str, detail: str) > Verdict { return Verdict{ok = false, name = name, detail = detail}; }
fun noted(name: str, detail: str) > Verdict {
    return Verdict{ok = true, note = true, name = name, detail = detail};
}

// refs/heads only: a remote branch never shadows a tag's short name.
fun local_branches() > [str] !> any {
    var names = mut [<str>];
    final listing = vcs\cmd(["for-each-ref", "--format=%(refname:lstrip=2)", "refs/heads"],
        vcs\CommandOptions{quiet = true}).stdout;
    foreach (line in listing.split("\n")) {
        final name = line.trim();
        if (name != "") { names.append(name); }
    }
    return names;
}

// Neither the tag trigger nor the build jobs' upload paths derive from RELEASE_TAG_REFSPEC
// and releases\assetGlob, so only this notices one side edited alone. release-publish
// globs dist/ by releases\assetGlob itself, but sees only what the build jobs uploaded.
fun verify_release_workflow() > [Verdict] !> any {
    if (!fs\exists(RELEASE_WORKFLOW)) {
        return [failed("workflow", RELEASE_WORKFLOW + " is missing, so the tag trigger cannot be confirmed")];
    }
    final body = fs\readFile(RELEASE_WORKFLOW);
    var checks = mut [<Verdict>];
    if (body.indexOf("- '" + RELEASE_TAG_REFSPEC + "'") == null) {
        checks.append(failed("workflow tag trigger",
            RELEASE_WORKFLOW + " no longer triggers on `" + RELEASE_TAG_REFSPEC + "`"));
    } else {
        checks.append(passed("workflow tag trigger", "`" + RELEASE_TAG_REFSPEC + "` is what "
            + RELEASE_WORKFLOW + " triggers on"));
    }
    final uploads = body.split("actions/upload-artifact@").len() - 1;
    var unlisted = mut [<str>];
    foreach (tool in releases\TOOLS) {
        if (body.split(releases\assetGlob(tool)).len() - 1 < uploads) { unlisted.append(releases\assetGlob(tool)); }
    }
    if (unlisted.len() > 0) {
        checks.append(failed("workflow upload paths", "not every one of the " + "{uploads}"
            + " upload-artifact steps in " + RELEASE_WORKFLOW + " lists " + unlisted.join(", ")
            + ", so the release would publish without those archives"));
    } else {
        checks.append(passed("workflow upload paths", "every upload-artifact step in "
            + RELEASE_WORKFLOW + " lists each tool's archives"));
    }
    return checks;
}

// Every check that must hold before a tag exists: the Go module proxy caches a tag
// within the hour, so a failed release burns the version. Returns every verdict
// rather than stopping at the first.
fun release_checks(wouldBeTags: [str], rootVersion: str) > [Verdict] !> any {
    var checks = mut [<Verdict>];
    final onHead = tag_names_on_head();
    final branches = local_branches();

    // (a) A branch named like a tag is noted, never refused: git supports it. A bare
    // `git push <remote> <tag>` is then ambiguous; push refs/tags/<tag>.
    foreach (tag in wouldBeTags) {
        var collides = false;
        foreach (b in branches) {
            if (b == tag) { collides = true; }
        }
        if (collides) {
            checks.append(noted("branch collision", "a branch named `" + tag + "` exists beside this "
                + "tag. The two namespaces are separate, so both are legal and magus reads tags by "
                + "written name either way. Bare-name git spellings are ambiguous while both exist: "
                + "push it as `git push <remote> refs/tags/" + tag + "`, since `git push <remote> "
                + tag + "` is refused as matching more than one ref"));
        } else {
            checks.append(passed("branch collision", "no branch is named `" + tag + "`"));
        }
    }

    // (e) release_build's refusal, asked before a tag burns the version.
    final shims = proc\exec("go", args: ["run", "./cmd/magus-utils", "dev-shims"], dir: ".",
        opts: proc\ExecOptions{quiet = true, allowFailure = true});
    if (shims.ok) {
        checks.append(passed("development-only shims", shims.stdout.trim()));
    } else {
        checks.append(failed("development-only shims", shims.stderr.trim()));
    }

    // (b) Simulates version() with these tags on HEAD. Gated only on a root tag: a
    // library-only release publishes no assets.
    final root = releases\rootReleaseTag(wouldBeTags + onHead);
    if (root == "") {
        var stamped = "the nearest tag by distance";
        final near = wouldBeTags + onHead;
        if (near.len() > 0) { stamped = "one of " + near.join(", ") + ", chosen arbitrarily"; }
        checks.append(passed("asset names", "no root release tag would sit on HEAD, so "
            + RELEASE_WORKFLOW + " does not run and nothing is published. A local "
            + "`magus run release-build` on this commit stamps " + stamped
            + ", and refuses when that carries a separator"));
    } else {
        var offenders = mut [<str>];
        foreach (tool in releases\TOOLS) {
            foreach (p in [["linux", "amd64"], ["linux", "arm64"], ["darwin", "amd64"],
                           ["darwin", "arm64"], ["windows", "amd64"], ["windows", "arm64"]]) {
                foreach (suffix in ["_static", ""]) {
                    // toSlash: fs\join uses the rehearsing machine's separator.
                    final asset = fs\join("dist", releases\assetName(tool, version: root, goos: p[0], goarch: p[1], suffix: suffix));
                    if (!releases\matchesGlob(releases\assetGlob(tool), releases\toSlash(asset))) {
                        offenders.append(asset);
                    }
                }
            }
        }
        if (offenders.len() > 0) {
            checks.append(failed("asset names", "HEAD would stamp version `" + root + "`, naming assets "
                + "like `" + offenders[0] + "` that its tool's upload glob cannot match. The "
                + "build would be green and the release would publish nothing. " + "{offenders.len()}"
                + " of the assets release.yaml builds are affected."));
        } else {
            checks.append(passed("asset names", "version `" + root + "` names assets each tool's "
                + "upload glob matches on every platform release.yaml builds"));
        }
    }

    if (rootVersion == "") {
        checks.append(passed("publish prerequisites", "no root version named, so nothing publishes"));
        return checks;
    }
    final rootTag = "v" + rootVersion;

    // (c) What `magus-utils cut` needs, asked before any binary is built.
    final manifest = fs\join("releases", rootTag + ".yaml");
    if (fs\exists(manifest)) {
        checks.append(failed("release manifest", manifest + " already exists, and release manifests "
            + "are immutable once committed; `magus-utils cut` would refuse after the binaries "
            + "were built"));
    } else {
        checks.append(passed("release manifest", manifest + " is absent, as cut requires"));
    }

    final fragments = fs\glob(changelog\FRAGMENT_DIR + "*.md");
    if (fragments.len() == 0) {
        checks.append(failed("changelog", changelog\FRAGMENT_DIR + " holds no changelog fragments, so "
            + "`magus-utils cut` would refuse and this release would publish binaries with no notes. "
            + "Write the entries before tagging"));
    } else {
        // pr-changelog lints only the fragments a pull request adds, so lint them all here.
        var paths = mut [<str>];
        foreach (f in fragments) { paths.append(f.value); }
        final malformed = changelog\lint(paths);
        if (malformed.len() > 0) {
            checks.append(failed("changelog", "`magus-utils cut` would refuse " + changelog\FRAGMENT_DIR
                + ": " + malformed.join("\n")));
        } else {
            checks.append(passed("changelog", changelog\FRAGMENT_DIR + " holds {fragments.len()} fragment(s) for cut to fold"));
        }
    }

    // (d) The trigger from both sides: the root tag must start a release and a module tag
    // must not.
    if (!releases\matchesGlob(RELEASE_TAG_REFSPEC, rootTag)) {
        checks.append(failed("workflow trigger", "`" + rootTag + "` does not match "
            + RELEASE_WORKFLOW + "'s `" + RELEASE_TAG_REFSPEC + "` trigger, so pushing it would "
            + "publish nothing"));
    } else {
        checks.append(passed("workflow trigger", "`" + rootTag + "` matches `" + RELEASE_TAG_REFSPEC
            + "` and starts the release"));
    }
    foreach (tag in wouldBeTags) {
        if (tag == rootTag) { continue; }
        if (releases\matchesGlob(RELEASE_TAG_REFSPEC, tag)) {
            checks.append(failed("workflow trigger", "the module tag `" + tag + "` also matches `"
                + RELEASE_TAG_REFSPEC + "`, so pushing it would start a second release run"));
        } else {
            checks.append(passed("workflow trigger", "the module tag `" + tag + "` starts no release run"));
        }
    }

    return checks;
}

// Cuts versions in Go's multi-module order: tag each nested module, rewrite root go.mod's
// requires to those tags, then tag the root. Dry run by default; name <module>@<version>
// to release one, and unnamed modules stay put. go.mod's replace directives stay because
// replace is never transitive. It never pushes.

export fun release(ctx: magus\Context, args: [str]) > void !> any {
    final deliver = ctx.hasCharm("cd");
    final dirty = vcs\isDirty();
    final modules = releases\releasableModules(magus\describe.project().projects);

    var wanted = mut {};
    foreach (a in args) {
        if (a == "") { continue; }
        // `@`, as in `go get`. Searched from index 1 so an npm-scoped `@scope/pkg` key parses.
        var at = a.sub(1).indexOf("@");
        if (at != null) { at = at + 1; }
        if (at == null) {
            throw "release: expected <module>@<version>, got `" + a
                + "` - run `magus run release` with no arguments to list the modules";
        }
        final key = a.sub(0, at);
        var v = a.sub(at + 1);
        if (v.startsWith("v")) { v = v.sub(1); }
        _ = semver\parse(v); // raises on anything not valid semver
        wanted[key] = v;
    }

    final branches = local_branches();
    foreach (m in modules) {
        final cur = releases\currentVersion(m["prefix"]);
        final n = releases\nextVersions(cur);
        var at = "at " + cur;
        if (cur == "") { at = "unreleased"; }
        magus\log.info("release: {m["key"]} - {at}"
            + ", next: patch {n.patch} | minor {n.minor} | major {n.major}");
        foreach (c in [n.patch, n.minor, n.major]) {
            final tag = m["prefix"] + c;
            foreach (b in branches) {
                if (b == tag) {
                    magus\log.warn("release:   a BRANCH named `" + tag + "` exists; that candidate "
                        + "would make the tag ambiguous to every tool resolving a short ref");
                }
            }
        }
    }

    if (wanted.keys().len() == 0) {
        magus\log.info("release: nothing named, nothing released - e.g. `magus run release -- magus@0.4.0`");
        return;
    }

    // Before anything else, so a typo cannot release nothing and report success.
    foreach (key in wanted.keys()) {
        var known = false;
        foreach (m in modules) {
            if (m["key"] == key) { known = true; }
        }
        if (!known) {
            throw "release: unknown module `" + key
                + "` - run `magus run release` with no arguments to list them";
        }
    }

    // Only the three computed candidates: a tag cannot be quietly taken back.
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null) { continue; }
        final cur = releases\currentVersion(m["prefix"]);
        if (!releases\isCandidate(v, cur)) {
            final n = releases\nextVersions(cur);
            throw "release: {m["key"]} v{v} is not a legal next version from {cur}"
                + " - choose {n.patch}, {n.minor} or {n.major}"
                + " (a prerelease or +metadata build of one of those is fine)";
        }
    }

    // From v2 the module path must end in /vN, and `go get` resolves the path, not the tag.
    // Refused rather than fixed: a rename rewrites every import.
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null) { continue; }
        final major = semver\parse(v).major;
        if (major < 2) { continue; }
        var path = "{m["gomodule"]}";
        // The root's gomodule is "" by design, so its path comes from go.mod.
        if (m["root"] != "") { path = releases\modulePath(fs\readFile("go.mod")); }
        if (releases\needsMajorSuffix(path, major: major)) {
            throw "release: " + m["key"] + " v" + v + " needs a module path ending in /v"
                + major + ", but go.mod declares `" + path + "`. Go resolves the path, not "
                + "the tag, so this would publish a version nobody can `go get`. Rename the "
                + "module and its imports first, in their own commit, then release.";
        }
    }

    // Before creating any tag, so a failure cannot leave half the modules tagged.
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null) { continue; }
        final tag = m["prefix"] + "v" + v;
        if (vcs\tags(pattern: tag).len() > 0) {
            throw "release: tag " + tag + " already exists";
        }
    }

    // These all run and print; under cd a single failure refuses the release.
    var wouldBeTags = mut [<str>];
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null) { continue; }
        wouldBeTags.append(m["prefix"] + "v" + v);
    }
    var rootVersion = "";
    if (wanted["magus"] != null) { rootVersion = "{wanted["magus"]}"; }

    var failures = 0;
    foreach (c in verify_release_workflow() + release_checks(wouldBeTags, rootVersion: rootVersion)) {
        if (c.note) {
            magus\log.warn("release: NOTE " + c.name + " - " + c.detail);
        } else if (c.ok) {
            magus\log.info("release: OK   " + c.name + " - " + c.detail);
        } else {
            failures = failures + 1;
            magus\log.warn("release: FAIL " + c.name + " - " + c.detail);
        }
    }
    // Both refusals follow the whole transcript, so one problem cannot hide another.
    if (failures > 0 and deliver) {
        throw "release: " + failures + " release check(s) failed; nothing was tagged. "
            + "Drop the cd charm to rehearse until they pass.";
    }
    if (deliver and dirty) { throw "release: tree is dirty; commit before releasing"; }

    if (!deliver) {
        magus\log.info("release: DRY RUN - add the cd charm to execute");
        if (dirty) { magus\log.info("release: NOTE - tree is dirty; cd will refuse until it is clean"); }
        if (failures > 0) {
            magus\log.info("release: NOTE - " + failures + " release check(s) failed; cd will refuse until they pass");
        }
    }

    // 1. Nested modules first: the root's go.mod must require tags that already exist.
    // Declared as modified: release amends go.mod, and two targets declaring one output
    // is MGS1020.
    ctx.writesFiles(["go.mod"], editsExistingSource: true);
    var gomod = fs\readFile("go.mod");
    var rewrote = false;
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null or m["root"] != "") { continue; }
        magus\log.info("release: tag " + m["prefix"] + "v" + v);
        if (deliver) { _ = vcs\cmd(["tag", m["prefix"] + "v" + v]); }
        // Ask go.mod, not the manifest: golangci-lint compiles libs/testpairing, and the root
        // never imports it.
        if (m["gomodule"] != "" and gomod.indexOf(m["gomodule"] + " v") == null) {
            magus\log.info("release: go.mod  " + m["gomodule"] + "  - not required by the root; tag only");
        } else if (m["gomodule"] != "") {
            magus\log.info("release: go.mod  " + m["gomodule"] + "  ->  v" + v);
            gomod = releases\rewriteRequire(gomod, m["gomodule"], "v" + v);
            rewrote = true;
        }
    }
    if (deliver and rewrote) { fs\writeFile("go.mod", gomod); }

    // 2. Root tag LAST, so it captures the go.mod rewrite above.
    final rootV = wanted["magus"];
    if (rootV != null) {
        magus\log.info("release: tag v" + rootV);
        if (deliver) { _ = vcs\cmd(["tag", "v" + rootV]); }
    }

    if (deliver) {
        magus\log.info("release: done - nothing was pushed. Push the tags deliberately when ready.");
    } else {
        magus\log.info("release: dry run only - nothing was tagged or written");
    }
}

// Rebuilds on every debounced change until interrupted.
export fun watch(ctx: magus\Context, args: [str]) > void !> any {
    magus\log.info("watching cmd/ and internal/ - rebuilding on change (Ctrl-C to stop)");
    fs\watch(["cmd", "internal"], fun(changed: [str]) > bool {
        magus\log.info("change detected - rebuilding");
        try {
            go_build(ctx, []);
        } catch (e) {
            magus\log.warn("build failed, still watching: " + e);
        }
        return false;
    });
}

// Runs the PR advisors' `test "..." {}` blocks under a plain `magus buzz -t`, from each
// script's own directory so their bare `import "advice"` resolves.
export fun advice_test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles([".github/actions/advice/*.buzz", ".github/actions/ci-outcome/*.buzz", ".github/actions/magus/*.buzz"]);
    foreach (dir in [".github/actions/advice", ".github/actions/ci-outcome", ".github/actions/magus"]) {
        foreach (script in fs\glob(dir + "/*.buzz")) {
            _ = magus\cmd("buzz", args: ["-t", fs\basename(script.value)], opts: magus\CommandOptions{dir = dir});
        }
    }
}

// Tests with race detection.
// The published badge is coverage_render's.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    // generate writes MAGUS.md and the *.lock fixtures this suite reads; without the
    // edge, coverage-render's parallel needs(generate, test) is MGS4008 at doctor time.
    ctx.needs(generate);
    ctx.needs(advice_test);
    // extended adds the tests that need a C toolchain and a docker daemon.
    if (ctx.hasCharm("extended")) {
        ctx.needs(compress_cgo_test, completion_test);
    }
    // Declared so coverage_render finds the profiles after a cache hit.
    // A glob: a narrowed run writes only keyed profiles.
    ctx.writesFiles([".magus/coverage*.out"]);
    // ctx.readsFiles replaces the target's footprint, so the suite's whole tree is restated.
    // The Markdown and fixtures are enumerated: a test reading a file outside these roots
    // replays a stale pass when that file changes.
    ctx.readsFiles(["**/*.go", "**/*.txtar", "**/*.s", "**/*.S", "**/*.c", "**/*.h",
                    "go.mod", "go.sum", "go.work", "go.work.sum",
                    "**/*.buzz", "mise.toml", "magus.yaml",
                    "**/*.lock",
                    "internal/agent/skills/**", "internal/agent/agents-section.md",
                    "docs/reference/codes/**/*.md",
                    "docs/guides/jobs.md", "docs/guides/jobs/*.md",
                    "internal/hint/testdata/*", "internal/job/testdata/*",
                    "internal/queue/testdata/**",
                    "benchmarks/agent/internal/bench/testdata/*",
                    "internal/selfupdate/release-keys.json"]);
    ctx.readsFiles(["benchmarks/agent/internal/pricing/rates.json"]);
    // Go tests inspect the CI and queue workflows; lint checks every workflow.
    ctx.readsFiles([".github/actions/setup-magus/action.yml", "docs/gen/install",
                    ".github/workflows/ci.yaml", ".github/workflows/queue.yaml"]);
    ctx.readsFiles(["docs/guides/integrations/agents/*.buzz",
                    "docs/guides/integrations/agents/lib/*.buzz", "docs/guides/integrations/agents/*.json",
                    "docs/guides/integrations/agents/*.ts", "docs/src/styles/site.css"]);
    // TestNodeKindPaletteDrift reads these console sources.
    ctx.readsFiles(["console/src/styles/base/tokens.css", "console/src/apps/graph/graph.css",
                    "console/src/apps/graph/main.ts", "console/src/apps/graph/shapes.ts"]);
    ctx.readsFiles(["MAGUS.md"]);
    // The guard's pull-request-text test runs the binary proofread-build links.
    ctx.needs(buzz_test, proofreadlib\proofread_build);
    // Explicit args replace go-test's `./...` default and the `-- -run` passthrough, hence
    // `args`. cmd/magus runs without -race: its TestScripts re-exec the raced binary hundreds
    // of times, and the engine's concurrency lives in the raced packages.
    go["go-test"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}),
        {"args": ["-race", "-covermode=atomic", "-coverprofile=" + cov\profilePath(COVERAGE_PROFILE, args: args)] + raced_packages() + args});
    go["go-test"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}),
        {"args": ["-covermode=atomic", "-coverprofile=" + cov\profilePath(CMD_MAGUS_PROFILE, args: args), CMD_MAGUS_PKG] + args});
    cov\settle(cov\Profiles{ whole = COVERAGE_PROFILE, cmd = CMD_MAGUS_PROFILE, hand = COVERAGE_HAND_PROFILE,
        every = ".magus/coverage*.out" }, args: args, gomod: fs\readFile("go.mod"));
    // No percentage floor: removing well-covered code would trip one. The
    // touched-functions-keep-change-risk-under-10 lint rule holds each changed
    // file's covered lines against its base instead.
}

final CMD_MAGUS_PKG = "./cmd/magus";
final CMD_MAGUS_PROFILE = ".magus/coverage.cmd.out";

final COVERAGE_PROFILE = ".magus/coverage.out";
final COVERAGE_HAND_PROFILE = ".magus/coverage.hand.out";

fun raced_packages() > [str] !> any {
    final module = cov\modulePath(fs\readFile("go.mod"));
    final skip = module + CMD_MAGUS_PKG.sub(1);
    var raced = mut [<str>];
    foreach (line in proc\exec("go", ["list", "./..."], ".", proc\ExecOptions{quiet = true}).stdout.split("\n")) {
        final pkg = line.trim();
        if (pkg != "" and pkg != skip) { raced.append(pkg); }
    }
    // An empty listing makes `go test` run the current directory alone, silently.
    if (raced.len() < 2) {
        throw "test: `go list ./...` named " + "{raced.len()}" + " package(s) to race; expected the whole module";
    }
    return raced;
}


// Unions one platform's module profiles into block -> ran. A block absent from every
// profile was never compiled there, which differs from compiled and never entered.
fun coverage_blocks_ran(profiles: [str]) > {str: bool} !> any {
    final blocks = mut {<str: bool>};
    foreach (path in profiles) {
        foreach (key, ran in cov\coveredBlocks(fs\readFile(path))) {
            if (ran or blocks[key] == null) { blocks[key] = ran; }
        }
    }
    return blocks;
}

// Renders the three language coverage badges into gen/site/assets/.
// Not named *-generate: generate would pull in the race-enabled suite. Reads
// console/coverage.txt, so run `magus run test console` first; the console
// imports this project, so it cannot be a need.
export fun coverage_render(ctx: magus\Context, args: [str]) > void !> any {
    // generate first: the denominator reads every Go file the generators write.
    ctx.needs(generate, test, gopherbuzz\test, diagnostics\test,
        conventionslib\test, testpairing\test, scipbuzz\test, xdg\test, textlib\test, cmdline\test, termkit\test, buzz_test);
    ctx.writesFiles(["gen/site/assets/go-coverage.svg", "gen/site/assets/buzz-coverage.svg",
        "gen/site/assets/typescript-coverage.svg"]);
    if (!fs\exists("gen/site/index.html")) {
        throw "coverage-render: gen/site/index.html not found; run `magus run deploy-generate .` first, since it rebuilds gen/site from empty";
    }
    final typescript = "console/coverage.txt";
    if (!fs\exists(typescript)) {
        throw "coverage-render: " + typescript + " not found; run `magus run test console` first";
    }

    // The denominator is every Go block in every module whatever its build constraints, so
    // a file only another platform compiles counts at zero. The unfiltered profile: the
    // denominator never enumerates generated files.
    final tables = cov\staticBlockTables();
    final go_totals = cov\treeTotals(tables, blocks: coverage_blocks_ran(
        [COVERAGE_PROFILE, "libs/gopherbuzz/coverage.out", "libs/diagnostics/coverage.out",
         "libs/conventions/coverage.out", "libs/testpairing/coverage.out",
         "libs/scipbuzz/coverage.out", "libs/xdg/coverage.out", "libs/text/coverage.out", "libs/cmdline/coverage.out", "libs/termkit/coverage.out"]));
    final go_pct = cov\formatPercent(go_totals["covered"], statements: go_totals["statements"]);
    final buzz_pct = fs\readFile("coverage/buzz/coverage.txt").trim();
    final typescript_pct = fs\readFile(typescript).trim();

    fs\mkdirAll("gen/site/assets");
    fs\writeFile("gen/site/assets/go-coverage.svg", content: badges\coverage("go coverage", percent: go_pct, radius: 3));
    fs\writeFile("gen/site/assets/buzz-coverage.svg", content: badges\coverage("buzz coverage", percent: buzz_pct, radius: 3));
    fs\writeFile("gen/site/assets/typescript-coverage.svg", content: badges\coverage("typescript coverage", percent: typescript_pct, radius: 3));
    magus\log.info("coverage: go " + go_pct + "% ({go_totals["covered"]}/{go_totals["statements"]} statements), buzz "
        + buzz_pct + "%, typescript " + typescript_pct + "%");
}

// Runs the in-file `test "..." {}` blocks in this repo's Buzz modules through magus's
// embedded engine, and writes their merged line coverage.
// Not the buzz
// spell's buzz-test op: that forks upstream `buzz` and would sweep in every magusfile.
export fun buzz_test(ctx: magus\Context, args: [str]) > void !> any {
    // hack/lint/run.buzz's tests run the binary proofread-build links, and
    // no-throw's run TypeScript from libs/textsearch/node_modules.
    // Graph-handle examples must refresh the index before their child processes take it.
    ctx.needs(proofreadlib\proofread_build, proofread_decisions_generate, textsearch\install, symbol_digest_generate);
    ctx.readsFiles(["gen/symbol-index.json"]);
    ctx.readsFiles(["spells/**/*.buzz", "docs/lib/*.buzz", "std/lib/*.buzz", "hack/dev/*.buzz", "hack/remote/*.buzz", "hack/bench/*.buzz",
        "hack/ci/*.buzz", "hack/retro/*.buzz", "hack/retro/testdata/**", "hack/magusfile/*.buzz", "hack/policy/*.buzz", "hack/lint/*.buzz", "hack/lint/*.mjs", "hack/testdata/*", "changes/testdata/*", "docs/templates/changelog.mustache",
        "releases/*.yaml", "hack/policy/gen/proofread-decisions.json", ".github/workflows/pr.yaml"]);
    // lcov.info is the profile the buzz spell declares for change risk.
    ctx.writesFiles(["coverage/buzz/*.lcov", "coverage/buzz/coverage.txt", "coverage/buzz/lcov.info"]);
    // proofread_build above links the binary that hack/lint/run.buzz invokes.
    fs\mkdirAll("coverage/buzz");
    final fragments = mut [<str>];
    foreach (run in buzzcov\runs()) {
        _ = magus\cmd("buzz", args: run.argv, opts: magus\CommandOptions{dir = run.dir});
        buzzcov\keep(fragments, run: run);
    }
    final report = buzzcov\report(fragments);
    fs\writeFile("coverage/buzz/coverage.txt", content: report.percent + "\n");
    fs\writeFile("coverage/buzz/lcov.info", content: report.tracefile);
}

// No doctor gate: the advice action reports its findings without blocking.
// No preflight target: CI pipes `magus affected generate` into its shard plan instead.

// Compiles one artifact: the host binary, or the container image under the `container` charm.
export fun build(ctx: magus\Context, args: [str])  > void {
    if (ctx.hasCharm("container")) {
        ctx.needs(image_build);
    } else {
        ctx.needs(go_build);
    }
}
// Builds .magus/custom-gcl, the golangci-lint carrying this repo's own linters.
// Runs in libs/testpairing because `golangci-lint custom` reads .custom-gcl.yml from its
// cwd. No declared outputs, for go-build's reason, so a read-only run leaves no binary.
export fun install_linter(ctx: magus\Context, args: [str]) > void !> any {
    // The custom linters read Go sources that format may rewrite. Keep the reader after
    // that writer whenever lint runs on its own as well as under the CI composition.
    ctx.needs(format);
    ctx.readsFiles(["libs/testpairing/.custom-gcl.yml", "libs/testpairing/go.mod",
                    "libs/testpairing/go.sum", "libs/testpairing/**/*.go",
                    "libs/conventions/go.mod", "libs/conventions/go.sum",
                    "libs/conventions/**/*.go",
                    "libs/proofread/go.mod", "libs/proofread/go.sum", "libs/proofread/**/*.go"]);
    // Removed first so the link gets a fresh inode: macOS keys the code signature on the
    // inode, and an in-place rewrite gets the next exec SIGKILLed.
    fs\remove(".magus/custom-gcl");
    // custom-gcl's version salt hashes only plugin dirs with a path, and libs/proofread
    // enters through a go.mod replace, so a rebuilt binary would replay stale findings.
    fs\removeAll(".magus/golangci-lint");
    _ = proc\exec("golangci-lint", ["custom"], "libs/testpairing");
}

// Measures the change's base for the conformance ceiling rule, which only reads the measure.
// The user cache keeps one per base commit and configuration, so this replays nothing itself.
export fun conformance_base(ctx: magus\Context, args: [str]) > void !> any {
    final commit = magus\change(vcs\base()).mergeBase();
    magus\log.info("conformance base measured at {commit}");
}

// Holds the repository's non-Go files to conventions no off-the-shelf linter checks;
// each rule is hack/lint/<rule>.buzz, and hack/lint/run.buzz reports drift between their
// reads and this footprint. A tree glob stops at a nested project, hence the named paths.
export fun conventions(ctx: magus\Context, args: [str]) > void !> any {
    // This rule reads broad source and prose globs. Run every formatter CI uses first so
    // the scheduler can order those writes before its reads (MGS4008).
    ctx.needs(format, gopherbuzz\format, diagnostics\format, conventionslib\format,
        testpairing\format, scipbuzz\format, xdg\format, textlib\format, cmdline\format, termkit\format,
        proofreadlib\proofread_build, conformance_base, textsearch\install);
    ctx.readsFiles(["hack/lint/*.buzz",
                    "spells/**/*.buzz", "internal/queue/provider/*.buzz", "hack/**/*.buzz",
                    "hack/README.md",
                    ".github/**/*.buzz",
                    "**/*.lock", "docs/**/*.lock", "proto/buf.lock",
                    "**/package.json", "console/package.json", "docs/package.json",
                    "docs/guides/integrations/agents/package.json", "libs/textsearch/package.json",
                    "**/magusfile.buzz", "console/magusfile.buzz", "docs/magusfile.buzz",
                    "docs/guides/integrations/agents/magusfile.buzz",
                    "libs/conventions/magusfile.buzz", "libs/proofread/magusfile.buzz",
                    "libs/result/result.buzz", "libs/result/*.go",
                   // proofread's staleness check hashes the labeled cases the binary embeds.
                    "libs/proofread/internal/calibrate/cases/*.txtar", "libs/proofread/proofread.buzz",
                    "libs/proofread/testdata/*.css",
                    "libs/proofread/testdata/commit-history.txtar",
                    "libs/diagnostics/magusfile.buzz",
                    "libs/figure/magusfile.buzz", "libs/gopherbuzz/magusfile.buzz",
                    "libs/testpairing/magusfile.buzz", "libs/textsearch/magusfile.buzz",
                    "libs/scipbuzz/magusfile.buzz", "libs/xdg/magusfile.buzz", "libs/text/magusfile.buzz", "libs/termkit/magusfile.buzz",
                    "testdata/latex/onepage/magusfile.buzz",
                    "libs/cmdline/magusfile.buzz", "libs/kustomize/*.buzz",
                    "libs/kustomize/testdata/*.yaml",
                    "proto/magusfile.buzz", "docs/tour/*.buzz",
                    ".golangci.yml", ".mockery.yaml", ".markdownlintignore", ".markdownlint.json",
                    ".gitattributes", "dprint-base.json",
                    "mise.toml", "magus.yaml", "hack/lint/sdk-exports.jsonl", "hack/lint/no-throw.jsonl",
                    "internal/agent/catalog.go", "internal/agent/skills/*/SKILL.md",
                    ".agents/skills/*/SKILL.md", ".claude/skills/*/SKILL.md", ".gitignore",
                    "types/diagnostic.go",
                    ".github/workflows/*.yaml", ".github/actions/setup-magus/action.yml",
                    "docs/guides/integrations/agents/codex-hooks.json",
                    "docs/site/landing.buzz", "docs/src/styles/site.css",
                    "docs/site/diagrams/*.buzz", "libs/figure/figure.buzz",
                    "**/*.md", "console/**/*.md", "docs/**/*.md",
                    "docs/guides/integrations/agents/**/*.md",
                    "libs/conventions/**/*.md", "libs/proofread/**/*.md",
                    "libs/diagnostics/**/*.md", "libs/figure/**/*.md",
                    "libs/gopherbuzz/**/*.md", "libs/testpairing/**/*.md",
                    "libs/textsearch/**/*.md", "libs/scipbuzz/**/*.md", "libs/xdg/**/*.md", "libs/text/**/*.md", "libs/termkit/**/*.md",
                    "libs/cmdline/**/*.md", "libs/kustomize/**/*.md",
                    "proto/**/*.md",
                    "**/*_test.go", "libs/conventions/**/*_test.go", "libs/proofread/**/*_test.go",
                    "libs/diagnostics/**/*_test.go", "libs/figure/**/*_test.go",
                    "libs/gopherbuzz/**/*_test.go", "libs/testpairing/**/*_test.go",
                    "libs/scipbuzz/**/*_test.go", "libs/xdg/**/*_test.go", "libs/text/**/*_test.go", "libs/termkit/**/*_test.go",
                    "libs/cmdline/**/*_test.go",
                    "**/*.go",
                    "libs/conventions/**/*.go", "libs/proofread/go.mod", "libs/proofread/go.sum",
                    "libs/proofread/**/*.go", "libs/proofread/train/**/*.go",
                    "libs/diagnostics/**/*.go", "libs/figure/**/*.go", "libs/gopherbuzz/**/*.go",
                    "libs/scipbuzz/**/*.go", "libs/testpairing/**/*.go", "libs/xdg/**/*.go", "libs/text/**/*.go", "libs/termkit/**/*.go",
                    "libs/cmdline/**/*.go", "libs/embed/**/*.go", "libs/embed/train/**/*.go",
                    "**/*.ts", "console/**/*.ts", "docs/**/*.ts",
                    "docs/guides/integrations/agents/**/*.ts", "libs/textsearch/**/*.ts",
                    "docs/guides/integrations/agents/**/*.tsx",
                    "**/*.js", "console/**/*.js", "docs/**/*.js",
                    "**/*.buzz", "console/**/*.buzz", "docs/**/*.buzz",
                    "docs/guides/integrations/agents/**/*.buzz", "libs/conventions/**/*.buzz",
                    "libs/diagnostics/**/*.buzz", "libs/figure/**/*.buzz", "libs/gopherbuzz/**/*.buzz",
                    "libs/scipbuzz/**/*.buzz", "libs/testpairing/**/*.buzz", "libs/textsearch/**/*.buzz",
                    "libs/xdg/**/*.buzz", "libs/text/**/*.buzz", "libs/cmdline/**/*.buzz", "libs/termkit/**/*.buzz", "libs/embed/**/*.buzz",
                    "libs/embed/train/**/*.buzz", "libs/proofread/train/**/*.buzz",
                    "proto/**/*.buzz",
                    "**/*.css", "console/**/*.css", "docs/**/*.css",
                    "**/*.html", "console/**/*.html", "docs/**/*.html",
                    "**/*.mjs", "console/**/*.mjs",
                    "**/*.yaml", "console/**/*.yaml", "docs/**/*.yaml",
                    "docs/guides/integrations/agents/**/*.yaml", "libs/textsearch/**/*.yaml",
                    "proto/**/*.yaml",
                    "**/*.yml", "libs/testpairing/**/*.yml",
                    "proto/**/*.proto", "**/*.txtar"]);
    // Rules reading magus\graph() unscoped freshen every index.
    // Freshen them all under this lock: the child is refused it (MGS3007).
    _ = magus\graph().precedents();
    _ = magus\cmd("buzz", args: ["hack/lint/run.buzz"]);
}

// Fails when a local host installation lacks what its wired harness spell renders,
// naming each file and the command that merges it. It only reads: magus never writes
// host config. The reads are what `magus describe harness` plans from.
export fun harness_drift(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["magusfile.buzz", "hack/magusfile/harness.buzz", "spells/harness/**/*.buzz",
                    ".claude/settings.json", ".cursor/hooks.json", ".codex/hooks.json",
                    ".codex/rules/*.rules", "opencode.json"]);
    final plans = mut [<magus\HarnessInstallation>];
    foreach (id in magus\cmd("describe", args: ["harness", "-o", "name"], opts: magus\CommandOptions{quiet = true}).stdout.trim().split("\n")) {
        if (id != "") { plans.append(magus\describe.harness(id)); }
    }
    final report = hostconfig\stale(plans);
    if (report.failure != "") {
        magus\log.info(report.merges);
        throw report.failure;
    }
}

// golangci-lint over the root module through .magus/custom-gcl, built first; the stock
// binary the go spell would run cannot read .golangci.yml.
export fun golangci_lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install_linter);
    ctx.readsFiles(["libs/testpairing/.custom-gcl.yml", "libs/**/*.go", "libs/**/go.mod", "libs/**/go.sum",
                    "**/*.go", "go.mod", "go.sum", "go.work", "go.work.sum", ".golangci.yml"]);
    golangci\run(".", if (ctx.hasCharm("rw")) ["--fix"] else []);
}

// Builds the linter first, then golangci-lint, go vet, markdownlint,
// shellcheck, and the actionlint cantrip. govulncheck lives in `security`. install_linter compiles
// golangci-lint with the go on PATH, so mise must pin one go for build and analysis.
//
// Files after `--` scope it to them, as a job's lint goal passes the files it writes: each
// tool runs over those files or the packages holding them, and only a finding at one of
// them fails. The scoped run needs no format or generate, whose drift elsewhere in the tree
// is not the files' to meet; harness-drift and the wasm build judge the whole tree too, so
// they are left to bare lint, the integrator's.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    if (args.len() > 0) {
        ctx.needs(proofreadlib\proofread_build);
    } else {
        ctx.needs(install_linter, conventions, harness_drift);
    }
    // Not go["golangci-lint"]: that runs the stock binary off PATH. These reads key the
    // custom linter by content.
    ctx.readsFiles(["libs/testpairing/.custom-gcl.yml",
                    "libs/**/*.go", "libs/**/go.mod", "libs/**/go.sum"]);
    // Restated because readsFiles replaces the footprint; see `test`.
    ctx.readsFiles(["**/*.go", "**/*.s", "**/*.S", "**/*.c", "**/*.h",
                    "go.mod", "go.sum", "go.work", "go.work.sum", ".golangci.yml",
                    "**/*.md", ".markdownlintignore",
                    "**/*.sh", "**/*.bash", ".shellcheckrc",
                    ".github/workflows/*.yaml",
                    "mise.toml", "magus.yaml"]);
    if (args.len() > 0) {
        lintFiles(ctx, args: args);
        return;
    }
    golangci\run(".", []);
    // golangci-lint stops at a go.mod, so each other module gets its own run of the
    // tree-wide conventions.
    foreach (mod in fs\glob("libs/**/go.mod")) {
        golangci\lintLib(fs\dirname(mod.value), false);
    }
    go["go-vet"](ctx);
    // Type-checks the playground for wasm, which nothing else in ci does. Stock go, not
    // TinyGo; not ./..., since the server does not build for wasm.
    os\withEnv({"GOOS": "js", "GOARCH": "wasm"}, fun () > void !> any {
        _ = proc\exec("go", ["build", "-o", "/dev/null", "./cmd/buzz-playground"]);
    });
    markdown.markdownlint(ctx);
    // Named rather than walked: markdown.typos walks the project directory, which here is
    // the whole workspace.
    final prose = ["README.md", "CONTRIBUTING.md", "AGENTS.md", "changes"];
    ctx.readsFiles(["_typos.toml", "README.md", "CONTRIBUTING.md", "AGENTS.md",
        "changes/**/*.md", "changes/testdata/*"]);
    _ = proc\exec("typos", ["--format", "brief"] + prose);
    bash["shellcheck"](ctx);
    _ = proc\exec("actionlint", []);

    // Every unreleased fragment: pr-changelog lints only those a pull request adds.
    var paths = mut [<str>];
    foreach (f in fs\glob(changelog\FRAGMENT_DIR + "*.md")) { paths.append(f.value); }
    final malformed = changelog\lint(paths);
    if (malformed.len() > 0) {
        throw "lint: malformed changelog fragment(s); changes/README.md has the format:\n  "
            + malformed.join("\n  ");
    }
}

// lintFiles is lint over the files among args that exist; only a finding at one of them fails.
fun lintFiles(ctx: magus\Context, args: [str]) > void !> any {
    final files = mut [<str>];
    foreach (a in args) {
        if (fs\exists(a)) { files.append(a); }
    }
    if (files.len() == 0) {
        return;
    }
    golangci\linkOnce();
    final failures = mut [<str>];
    // The rules judge from the symbol indexes.
    // magus\graph().precedents() freshens them, as in conventions.
    _ = magus\graph().precedents();
    if (!magus\cmd("buzz", args: ["hack/lint/run.buzz", "--"] + files, opts: magus\CommandOptions{allowFailure = true}).ok) {
        failures.append("hack/lint/run.buzz reported findings above");
    }
    final libs = mut [<str>];
    foreach (mod in fs\glob("libs/**/go.mod")) { libs.append(fs\dirname(mod.value)); }
    final packages = golangci\packagesOf(files, libs: libs);
    foreach (module, pkgs in packages) {
        foreach (issue in golangci\issuesAt(module, packages: pkgs, files: files)) {
            failures.append(issue);
        }
    }
    // Each tool prints its own findings; a failing one is named and the rest still run.
    foreach (argv in scopedTools(ctx, files: files, goPackages: packages["."] ?? [<str>])) {
        if (!proc\exec(argv[0], argv.sub(1, len: argv.len() - 1), opts: proc\ExecOptions{allowFailure = true}).ok) {
            failures.append("{argv[0]} reported findings above");
        }
    }
    final fragments = files.filter(fun (i: int, f: str) > bool => f.startsWith(changelog\FRAGMENT_DIR) and f.endsWith(".md"));
    foreach (m in changelog\lint(fragments)) {
        failures.append(m);
    }
    if (failures.len() > 0) {
        final listed = failures.join("\n  ");
        throw "lint: {failures.len()} failure(s) at the files:\n  {listed}";
    }
}

// scopedTools is the argv of each tool lintFiles runs beyond golangci-lint; goPackages are
// the root module's packages holding files.
fun scopedTools(ctx: magus\Context, files: [str], goPackages: [str]) > [[str]] {
    final tools = mut [<[str]>];
    if (goPackages.len() > 0) {
        tools.append(["go", "vet"] + goPackages);
    }
    final md = files.filter(fun (i: int, f: str) > bool => f.endsWith(".md"));
    if (md.len() > 0) {
        tools.append(["markdownlint"] + md);
        ctx.readsFiles(["_typos.toml"]);
        tools.append(["typos", "--format", "brief"] + md);
    }
    final shells = files.filter(fun (i: int, f: str) > bool => f.endsWith(".sh") or f.endsWith(".bash"));
    if (shells.len() > 0) {
        tools.append(["shellcheck"] + shells);
    }
    final workflows = files.filter(fun (i: int, f: str) > bool => f.startsWith(".github/workflows/") and f.endsWith(".yaml"));
    if (workflows.len() > 0) {
        // Cantrip, the same command lint runs. docs/glossary/cantrip.md
        tools.append(["actionlint"] + workflows);
    }
    return tools;
}
// Regenerates, then formats Go, tidies `go.mod` and formats Markdown.
export fun format(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(generate);
    // Edited, not produced: gofmt amends authored code, which must stay off the replay path.
    ctx.writesFiles(["**/*.go", "go.mod", "go.sum",
        "libs/gopherbuzz/benchmarks/comparison/go.mod",
        "libs/gopherbuzz/benchmarks/comparison/go.sum"], editsExistingSource: true);
    go["go-fmt"](ctx);
    go["go-mod-tidy"](ctx);
    // Not a project, so no project's format tidies it.
    go["go-mod-tidy"](ctx.withCwd("libs/gopherbuzz/benchmarks/comparison"));
    // Keep in step with dprint.json's `includes`.
    ctx.writesFiles(["*.md", "benchmarks/**/*.md", "tapes/**/*.md",
        "internal/agent/agents-section.md"], editsExistingSource: true);
    markdown["dprint"](ctx);
}

// Runs the CI gates through their declared dependencies.
// Under `--inherited=fatal` security runs in the body: ctx.needs hands a dependency no args.
export fun ci(ctx: magus\Context, args: [str]) > void !> any {
    // Only ci rewrites files: format first, so lint, build and test read the formatted
    // tree. lint reads libs/**/*.go and test reads **/*.go, which each nested module's
    // format rewrites (MGS4008).
    ctx.needs(format, gopherbuzz\format, diagnostics\format, conventionslib\format,
        testpairing\format, scipbuzz\format, xdg\format, textlib\format, cmdline\format, termkit\format);
    if (!advisories\inheritedFatal(args)) {
        ctx.needs(lint, build, test, security);
        return;
    }
    ctx.needs(lint, build, test);
    security(ctx, args: args);
}

// Exercises the completion scripts magus ships, each inside the official image for its
// shell. Requires a docker daemon rather than skipping without one.
//
// TODO: zsh is uncovered - it has no official image (zshusers/zsh is community-run), so
// the one shell with a confirmed bug is the one still untested. Revisit if an official
// image appears, or if a pinned community digest becomes acceptable.
// TODO: fish is uncovered for the same reason; upstream declined to publish an official
// image in fish-shell/fish-shell#3440.
export fun completion_test(ctx: magus\Context, args: [str]) > void !> any {
    // config-generate writes the completions this reads (MGS4008).
    ctx.needs(config_generate);
    ctx.readsFiles(["hack/ci/completion-checks/*", "cmd/magus/completions/*"]);
    try {
        _ = proc\which("docker");
    } catch (e) {
        throw "completion-test needs a docker daemon: it runs each shell's official image";
    }
    // dotnet/sdk: Microsoft's own PowerShell images are deprecated in MCR.
    final checks = {
        "bash:5": "bash hack/ci/completion-checks/bash.sh",
        "mcr.microsoft.com/dotnet/sdk:8.0": "pwsh -NoProfile -File hack/ci/completion-checks/pwsh.ps1",
    };
    final root = vcs\root();
    foreach (image, cmd in checks) {
        var argv = mut ["-v", root + ":/w", "-w", "/w", image];
        foreach (part in cmd.split(" ")) { argv.append(part); }
        docker["docker-run"](ctx, {"args": argv});
    }
}

// Turns a results tree into the benchmark report. `-- --results <dir>` picks another tree
// under benchmarks/agent, `-- --synthetic` reports on a generated control tree, and
// `-- --publish <provider>` files the result.
export fun agent_bench_report(ctx: magus\Context, args: [str]) > void !> any {
    // Edited, not produced: report.md is ignored, and a declared output lands in
    // .gitattributes.
    ctx.writesFiles(["benchmarks/agent/report.md"], editsExistingSource: true);
    ctx.writesFiles(["benchmarks/agent/reports/**/*.md"]);
    var results = "results";
    var publish = "";
    var synthetic = false;
    var i = 0;
    while (i < args.len()) {
        if (args[i] == "--synthetic") {
            synthetic = true;
            i = i + 1;
        } else if (args[i] == "--results" and i + 1 < args.len()) {
            results = args[i + 1];
            i = i + 2;
        } else if (args[i] == "--publish" and i + 1 < args.len()) {
            publish = args[i + 1];
            i = i + 2;
        } else {
            throw "agent-bench-report: unknown argument " + args[i] + " (want --synthetic, --results <dir>, --publish <provider>)";
        }
    }
    // Outside the tree: under benchmarks/agent it would be an undeclared, unignored path.
    final bin = fs\join(fs\tempDir("benchreport-"), "benchreport");
    go["go-build"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {
        "args": ["-o", bin, "./benchmarks/agent/cmd/benchreport"],
    });
    final agent = "benchmarks/agent";
    var steps = mut [];
    if (synthetic) {
        steps.append(["makefixture", fs\join(agent, "results-synthetic"), "-model", "claude-opus-5"]);
        results = "results-synthetic/results";
    }
    // No -p: the price table is compiled in, so a published figure cannot depend on the cwd.
    steps.append(["extract", fs\join(agent, results), "-o", fs\join(agent, "metrics.jsonl")]);
    steps.append(["analyze", fs\join(agent, "metrics.jsonl"), "-o", fs\join(agent, "analysis.json"),
                  "--seed", "20260902"]);
    steps.append(["report", fs\join(agent, "analysis.json"), "-o", fs\join(agent, "report.md")]);
    foreach (step in steps) {
        _ = proc\exec(bin, step);
    }
    magus\log.info("benchmark report written to benchmarks/agent/report.md");
    if (publish != "") {
        publish_report(agent, results, publish);
    }
}

// Files report.md as reports/<date>/<provider>/<model>.md with the environment stamped
// after its title. The provider is an argument because a model id does not carry it.
fun publish_report(agent: str, results: str, provider: str) > void !> any {
    final report = fs\readFile(fs\join(agent, "report.md"));
    final analysis = json\parse(fs\readFile(fs\join(agent, "analysis.json")));
    final names = mut [<str>];
    foreach (model in analysis["models"]) {
        names.append("{model}");
    }
    final models = names.join(", ");
    final count = names.len();
    if (count != 1) {
        throw "agent-bench-report: --publish files a report under one model, and `" + results
            + "` carries " + "{count}" + " (" + models + ")";
    }
    // The version string carries a second line when a server of another build was up.
    var version = "unknown";
    foreach (entry in fs\listDir(fs\join(agent, results))) {
        final meta = fs\join(agent, results, entry, "meta.json");
        if (fs\exists(meta)) {
            final record = json\parse(fs\readFile(meta));
            version = "{record["magus_version"]}".split("\n")[0];
            break;
        }
    }
    final now = time\nowIso();
    final stamp = "Published " + now + " from `" + results + "`: {analysis["runs"]} scored run(s), "
        + "model " + models + " (" + provider + "), " + version + ", host " + os\platform().join("/") + ".";
    final title = report.split("\n")[0];
    final dir = fs\join(agent, "reports", now.sub(0, len: 10), provider);
    final target = fs\join(dir, models + ".md");
    fs\mkdirAll(dir);
    fs\writeFile(target, report.replace(title + "\n", title + "\n\n" + stamp + "\n"));
    magus\log.info("benchmark report published to " + target);
}

// Builds swegrade, the grader a SWE-bench trial's eval log is piped through, into
// benchmarks/agent/bin. Undeclared like ./magus.
export fun swegrade_build(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["benchmarks/agent/cmd/swegrade/*.go", "internal/json/*.go", "go.mod", "go.sum"]);
    go["go-build"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {
        "args": ["-o", "benchmarks/agent/bin/swegrade", "./benchmarks/agent/cmd/swegrade"],
    });
}

// Runs a benchmark manifest (default pilot.manifest) with CLAUDE_BENCH_TOKEN read
// through the secret provider, so the launching shell never holds it.
export fun agent_bench_run(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(swegrade_build);
    var manifest = "pilot.manifest";
    if (args.len() > 0) { manifest = args[0]; }
    final token = magus\secret.read("CLAUDE_BENCH_TOKEN");
    os\withEnv({"CLAUDE_CODE_OAUTH_TOKEN": token}, callback: fun () > void !> any {
        _ = proc\exec("./run.sh", args: ["--manifest", manifest], dir: "benchmarks/agent");
    });
}

// Runs cmd/magus's agent eval, which skips in the ordinary test target because it
// spends tokens. MAGUS_AGENT_EVAL_VARIANTS, _REPS, _RESULTS and CLAUDE_CODE_EXECPATH pass through.
export fun agent_eval(ctx: magus\Context, args: [str]) > void !> any {
    // Each run gets a fresh HOME, where the claude CLI's own login cannot follow, so
    // the agent needs a token from the secret provider.
    final token = magus\secret.read("CLAUDE_BENCH_TOKEN");
    final env = mut {"GOEXPERIMENT": "jsonv2", "MAGUS_AGENT_EVAL": "1", "CLAUDE_CODE_OAUTH_TOKEN": token};
    foreach (name in ["MAGUS_AGENT_EVAL_VARIANTS", "MAGUS_AGENT_EVAL_REPS", "MAGUS_AGENT_EVAL_RESULTS",
                      "CLAUDE_CODE_EXECPATH"]) {
        env[name] = os\env(name) ?? "";
    }
    go["go-test"](ctx.withEnv(env),
        {"args": ["-run=^TestAgentEval$", "-count=1", "-timeout=2h", "-v", "./cmd/magus/"] + args});
}

// Replays each eval set under testdata/retrieval through query, refs and explain and
// prints recall, MRR and nDCG per set; no score fails it. MAGUS_EVAL_CANDIDATE unseals
// the judged holdout for one recorded read, MAGUS_EVAL_REPORT_ONLY=1 permits a further
// read that chooses nothing, and MAGUS_RETRIEVAL_EVAL_BASELINE names a file to write the
// report to for a person to review. Not a `test` charm: this reads the knowledge graph in
// the cache and those three variables, and so cannot share test's cache entry.
export fun retrieval_eval_test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["testdata/retrieval/*"]);
    ctx.writesFiles(["testdata/retrieval/baseline.jsonl"], editsExistingSource: true);
    final env = mut {"GOEXPERIMENT": "jsonv2"};
    foreach (name in ["MAGUS_EVAL_CANDIDATE", "MAGUS_EVAL_REPORT_ONLY", "MAGUS_RETRIEVAL_EVAL_BASELINE"]) {
        env[name] = os\env(name) ?? "";
    }
    go["go-test"](ctx.withEnv(env),
        {"args": ["-tags", "retrievaleval", "-run=^TestRetrievalEval$", "-count=1", "-timeout=2h", "-v", "./cmd/magus/"] + args});
}

// Runs internal/compress's tests under the cgo tags, which the ordinary test target
// cannot reach. Requires libzstd and liblzma rather than skipping without them. Not
// `test:cgo`: charms patch argv, and this needs CGO_ENABLED in the environment.
export fun compress_cgo_test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["internal/compress/*.go"]);
    foreach (lib in ["libzstd", "liblzma"]) {
        _ = proc\exec("pkg-config", ["--exists", lib], ".");
    }
    // Explicit args replace go-test's `./...`, so this compiles one package under cgo.
    go["go-test"](ctx.withEnv({"CGO_ENABLED": "1", "GOEXPERIMENT": "jsonv2"}),
        {"args": ["-race", "-tags", "liblzma,libzstd", "./internal/compress/"]});
}

// Drives the installed Claude Code, Codex, Cursor and OpenCode headless against a wired
// workspace; see docs/guides/integrations/agents.md. Not `go-test` with forwarded args:
// a target is what a policy can name, and this one spends model tokens.
export fun agent_harness_test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["internal/agent/harness/**", "libs/testkit/e2e/**"]);
    go["go-test"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}),
        {"args": ["-tags", "e2e", "-run", "^TestHosts$", "-count=1", "./internal/agent/harness/"]});
}

// Names every producer in one command: the root cannot depend on docs or console, since
// docs depends on the root. The command leads because run output elides long lines.
// Keep this above deploy-generate's doc comment, or the target loses its doc.
fun missing_input(path: str, project: str) > str {
    return "deploy-generate: " + path
        + " is missing - run `magus run build docs console` first (one dispatch, both "
        + "producers). The " + project + " project owns it, and this target reads across "
        + "that boundary without depending on it, so no run order builds it for you.";
}

// deploy-generate assembles gen/site: the exact tree the Pages deploy publishes, docs at
// the root and the console under /console/. It only assembles: writing into the docs or
// console trees trips MGS3001, so the caller runs their builds first.
export fun deploy_generate(ctx: magus\Context, args: [str]) > void !> any {
    final DOCS_GEN = "docs/gen";
    final CONSOLE_GEN = "console/gen";
    final OUT = "gen/site";

    if (!fs\exists(DOCS_GEN + "/index.html")) {
        throw missing_input(DOCS_GEN + "/index.html", "docs");
    }
    if (!fs\exists(CONSOLE_GEN + "/index.html")) {
        throw missing_input(CONSOLE_GEN + "/index.html", "console");
    }

    // Rebuilt from empty so a stale page cannot publish.
    if (fs\exists(OUT)) { fs\removeAll(OUT); }
    fs\copyDir(DOCS_GEN, OUT);
    // The console owns /console/, replacing the docs render's redirect stub.
    if (fs\exists(OUT + "/console")) { fs\removeAll(OUT + "/console"); }
    fs\copyDir(CONSOLE_GEN, OUT + "/console");

    magus\log.info("assembled " + OUT + " - docs at /, console at /console/");
}

// Reports installed toolchains; excluded from CI because it probes remote tags.
export fun toolchain_report(ctx: magus\Context, args: [str]) > void !> any {
    toolchains\report();
}

// Serves prebuilt docs and console under one local origin, laid out like the Pages deploy.
export fun serve(ctx: magus\Context, args: [str]) > void !> any {
    final DOCS_GEN = "docs/gen";
    final CONSOLE_GEN = "console/gen";
    if (!fs\isDir(DOCS_GEN)) { throw "serve: " + DOCS_GEN + " not found - run `magus run build docs` first"; }
    if (!fs\isDir(CONSOLE_GEN)) { throw "serve: " + CONSOLE_GEN + " not found - run `magus run build console` first"; }

    // No port: http.server takes the first free one from 8080.
    // /console/ wins by longest prefix.
    final port = http\server(http\ServerOptions{mounts = {"/": DOCS_GEN, "/console/": CONSOLE_GEN}});
    magus\log.info("serving the deploy at http://localhost:{port}/");
    magus\log.info("  /          -> " + DOCS_GEN + "  (docs)");
    magus\log.info("  /console/  -> " + CONSOLE_GEN + "  (console SPA, shadows the docs /console/ redirect)");
    magus\log.info("static server only; rebuild docs or console in its owning project, then refresh");
    // Keeps the target alive while http.server's listener runs.
    fs\watch(["."], fun(changed: [str]) > bool { return false; });
}
