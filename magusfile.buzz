    bounds: modeltiers\bounds, skills: modeltiers\skills);

// Outputs are declared per target with ctx.writesFiles: a project-wide set would let
// a go-build hit restore a stale MAGUS.md.
magus\project({
    "tools": policy\all,
    // Without it the label is the checkout's basename, so each worktree renames the project.
    "name": "magus",
    // Only this edge puts a .proto edit in the affected set and orders proto's generate first.
    // libs/figure: go-build embeds figure.buzz.
    // libs/embed: go.mod replaces it with the local module, so its Go builds into magus.
    // libs/result is not a project: result.buzz lives under this tree (go-build embeds it).
    // The rest are the libs whose targets these targets ctx.needs (MGS1062).
    "depends_on": ["proto", "libs/figure", "libs/embed", "libs/cmdline", "libs/conventions",
                   "libs/diagnostics", "libs/gopherbuzz", "libs/proofread", "libs/scipbuzz",
                   "libs/termkit", "libs/testpairing", "libs/textsearch", "libs/xdg", "libs/text"],
    "layers": {
        "internal/httpx": "transport",
        "internal/handler/*": "handler",
        "internal/service": "service",
        "internal/service/*": "service",
        "internal/cache": "repository",
        "internal/graph/knowledge": "repository",
        "internal/server": "composition",
    },
    // buzz claims **/*.buzz, which go_build keys on, and builds the Buzz symbol index
    // (scip-buzz) beside the Go one.
    "spells": [go, markdown, bash, buzz],
    // Tool configs no spell glob matches. Each changes what a target does, so an
    // undeclared one replays a stale verdict. Files doctor lists as undeclared stay
    // out when nothing reads them. Never add .gitattributes: magus writes it.
    "sources": [
        ".golangci.yml",
        ".mockery.yaml",
        ".markdownlintignore",
        "dprint-base.json",     // dprint.json extends it; the markdown spell declares only dprint.json
        "mise.toml",
        "magus.yaml",
        "hack/docs/screenshot.mjs",
        ".agents/loops/*.md",
        // The repository's Claude Code plugin marketplace; it lists the mod in
        // docs/guides/integrations/agents/claude-code/mod.
        ".claude-plugin/marketplace.json",
        "spells/harness/**/*.buzz", "spells/harness/**/*.js", "spells/harness/**/probe.ts",
        // No spell claims these, so a refresh would not invalidate the tests that read them.
        "testdata/hosts/**/*.json",
        // Per directory, not **/testdata/**: some testdata files are generate outputs.
        "internal/hint/testdata/*",
        "internal/job/testdata/*",
        "benchmarks/agent/internal/bench/testdata/*",
        // Embedded in the textrank package, and no other glob matches it.
        "internal/textrank/weights.json",
        // The retrieval eval's judgments and its holdout ledger.
        "testdata/retrieval/*",
        // Embedded in the binary, and no other glob matches it.
        "internal/selfupdate/release-keys.json",
    ],
    "targets": {
        "watch": {"skip_cache": "blocks on a filesystem watch loop and never returns"},
        "serve": {"skip_cache": "blocks as a long-running dev server and never returns"},
        // No ctx.writesFiles: output globs feed .gitattributes, where gen/site cannot conflict.
        "deploy-generate": {
            "skip_cache": "assembles a gitignored deploy tree that is never snapshotted",
            "integrates": "assembles the deploy tree",
        },
        // No isolation flag; see docs/decisions/0001.
        "generate": {
            "skip_cache": "is the drift gate itself; a replay would skip the check it exists to make",
            "integrates": "regenerates every generated file",
        },
        "harness-drift": {"skip_cache": "plans with the running binary's harness planner, which no input glob can key"},
        "conformance-base": {"skip_cache": "measures the base commit, which no input glob can key; the user cache keeps the measure per commit"},
        "index-generate": {
            "skip_cache": "output derives from the entire knowledge graph, which no input glob can key",
            "integrates": "regenerates the knowledge index",
        },
        "graph-generate": {
            "skip_cache": "output derives from the entire knowledge graph, which no input glob can key",
            "integrates": "regenerates the knowledge graph",
        },
        "symbol-digest-generate": {
            "skip_cache": "digests the symbol index in the cache, which no input glob can key; it runs before any replay of a target reading gen/symbol-index.json, so those stay cacheable",
            "integrates": "regenerates the symbol digest",
        },
        // An integrator runs these to integrate work; the guard reads `integrates`, never a name.
        "buzz-generate": {"integrates": "regenerates the Buzz bindings"},
        "config-generate": {"integrates": "regenerates the config bindings"},
        "go-api-generate": {"integrates": "regenerates the Go API lock"},
        "job-generate": {"integrates": "regenerates the job schemas"},
        "langservice-generate": {"integrates": "regenerates the language service manifest"},
        "magusfile-api-generate": {"integrates": "regenerates the magusfile API lock"},
        "man-generate": {"integrates": "regenerates the man pages"},
        "mcp-tools-generate": {"integrates": "regenerates the MCP tool registry"},
        "mocks-generate": {"integrates": "regenerates the mocks"},
        "proofread-decisions-generate": {"integrates": "regenerates the proofread decisions"},
        "skills-generate": {"integrates": "regenerates the installed skills"},
        "spells-generate": {"integrates": "regenerates the spell declarations"},
        "termcast-generate": {"integrates": "regenerates the terminal casts"},
        "termshots-generate": {"integrates": "regenerates the terminal shots"},
        "types-generate": {"integrates": "regenerates the Buzz type mirrors"},
        "agent-bench-report": {"skip_cache": "reads benchmark run artifacts under benchmarks/agent/results, which change independently of this tree"},
        "agent-bench-run": {
            "skip_cache": "launches paid agent sessions and writes benchmarks/agent/results; a replay would be a run that never happened",
            "human_only": "launches paid Claude sessions, $0.05-$4 each by task budget_usd (pilot.manifest: 8 sessions), and a result is an average a person decides to pay for",
        },
        "agent-eval": {"skip_cache": "launches paid agent sessions; a replay would be a run that never happened"},
        "retrieval-eval-test": {"skip_cache": "reads the knowledge graph in the cache, which no input glob can key"},
        "agent-harness-test": {
            "skip_cache": "drives the installed agent hosts, whose versions and logins no input glob can key",
            "human_only": "drives Claude Code, Codex, Cursor and OpenCode on the person's own logins and spends model tokens on each",
        },
        "go-build": {
            "skip_cache": "declares no outputs, so a replay would skip the link and restore no binary",
            "relinks": "./magus",
            "integrates": "links ./magus",
        },
        "image-build": {
            "skip_cache": "pushes and cosign-signs a registry digest per invocation",
            "needs_ready": ["docker"],
        },
        "image-registries": {"skip_cache": "reports the registry table resolved from the current environment"},
        "spell-publish": {"skip_cache": "pushes to a registry per invocation; a replay would publish nothing"},
        "spell-lock": {"skip_cache": "asks a registry under update, and writes no magus.lock while no remote spell is declared"},
        // image-scan has no skip_cache: the docker spell's trivy probe keys it on the database.
        "release-build": {"skip_cache": "a release must never replay a cached artifact; each invocation produces the bytes that ship"},
        "release-sign": {"skip_cache": "signs the manifest per invocation; a replayed signature would cover different bytes"},
        "release-index": {"skip_cache": "signs the index per invocation and, with cd, pushes a branch; a replay would publish nothing"},
        "release-publish": {"skip_cache": "reads whether the GitHub Release exists, which no file input carries"},
        "release-manifest": {"skip_cache": "reads the published release and main's manifest, which no file input carries"},
        "release": {"skip_cache": "mutates go.mod and creates VCS tags, an order-sensitive side effect"},
        // memory_mb: -race shadow memory in every test binary exhausts a 16GB runner.
        // test's own body runs the raced go-test op; no member races.
        // Linux pipepeer tests read their children's /proc entries.
        // The raced suite measured 13m21s of its own work on a loaded 8-core machine, with
        // vcs, cmd/magus and internal/guard each over five minutes: the hg and sl parity
        // tests alone spend about seven minutes spawning those tools.
        // slots as go-test: its go-test ops run inline under this step's seat, so the seat
        // is what sizes their -p and GOMAXPROCS.
        "test": {
            "timeout": "25m",
            "memory_mb": 10240,
            "slots": 4,
            "sandbox": {"allow": if (os\platform()[0] == "linux") [{"path": "/proc", "mode": "ro"}] else []},
        },
        "coverage-render": {"skip_cache": "reads the console's figure and the assembled site, which it cannot declare as inputs"},
        "security": {
            "skip_cache": "depends on trivy's license classifier version, which no cache key can see",
            "timeout": "15m",
        },
        // The timeout rides the context, so it bounds every target ci composes.
        // Members reached through ctx.needs run inline and never cache; see MGS1009.
        "ci": {
            "skip_cache": "composes the gates and reads nothing itself; its key is the whole tree, so it can never replay",
            "timeout": "60m",
        },
        "pr-title": {"skip_cache": "judges the pull request event, which no file input carries"},
        "pr-changelog": {"skip_cache": "judges the pull request event and the base ref, which no file input carries"},
        "pr-description": {"skip_cache": "judges the title and description its flags carry, which no file input holds"},
        "pr-commits": {"skip_cache": "judges the commit messages against the base ref, which no file input carries"},
        "git-hooks-remove": {"skip_cache": "reconciles the git hooks directory, which is outside the tree and no input carries"},
        "termcast-record": {"skip_cache": "records a real session, so its bytes differ every run and a replay would show different code"},
        "termcast-showcase": {"skip_cache": "drives a live interactive session, so its bytes differ every run"},
        // Four of a 10-core machine's 10 slots: the seat runs go test -p 4 with GOMAXPROCS=4,
        // so two suites and the other workers' builds share the machine the broker counts.
        "go-test": {"slots": 4},
        // Measured over 159 scip-go runs longer than 10 s: p75 width 3.6 cores, p75 peak 1.7 GiB,
        // max 2.9 GiB. Undeclared, each claimed 1 slot and 0 MiB, so the broker admitted
        // every worker's graph build at once and scip-go took every core.
        "scip": {"slots": 4, "memory_mb": 2048},
    },
});

// releases\rootReleaseTag rejects verified-refinements and per-module tags such as
// libs/gopherbuzz/v0.1.0.
fun exact_release_tag() > str !> any {
    return releases\rootReleaseTag(tag_names_on_head());
}

// Unpatterned: a glob stops at "/", and the release checks need the namespaced tags.
fun tag_names_on_head() > [str] !> any {
    final head = vcs\commit().id;
    var names = mut [<str>];
    foreach (t in vcs\tags()) {
        if (t.id == head) { names.append(t.name); }
    }
    return names;
}

// A root tag on HEAD beats describe, which picks arbitrarily among a release commit's
// per-module tags. `v[0-9]*` keeps describe off verified-refinements and libs/<name>/v*.
fun version() > str !> any {
    try {
        final tag = exact_release_tag();
        if (tag != "") {
            if (vcs\isDirty()) { return tag + "-dirty"; }
            return tag;
        }
        final v = vcs\cmd(["describe", "--tags", "--always", "--dirty", "--match", "v[0-9]*"],
            vcs\CommandOptions{quiet = true}).stdout.trim();
        if (v == "") { return "unknown"; }
        return v;
    } catch (e) {
        return "unknown";
    }
}

fun commit() > str !> any {
    try {
        return vcs\commit().id;
    } catch (e) {
        return "unknown";
    }
}

fun build_date() > str !> any {
    try {
        final c: Commit = vcs\commit();
        return c.date;
    } catch (e) {
        return "unknown";
    }
}

// Set by release.yaml, never read from the runner, so it can match the keyless
// signature's job_workflow_ref.
fun built_by() > str !> any { return os\env("BUILT_BY") ?? ""; }

fun ld_flags() > str !> any {
    return "-w -s"
        + " -X main.version=" + version()
        + " -X github.com/egladman/magus/internal/buildinfo.commit=" + commit()
        + " -X github.com/egladman/magus/internal/buildinfo.commitDate=" + build_date()
        + " -X main.builtBy=" + built_by();
}

// Builds the OpenCode wasm runtime and its wasm_exec.js via go generate.
export fun opencode_runtime_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["internal/interp/bindings/opencode/**/*.go", "internal/interp/bindings/opencode/plugin.buzz",
        "internal/json/**/*.go",
        "libs/gopherbuzz/**/*.go", "libs/gopherbuzz/go.mod", "libs/diagnostics/**/*.go",
        "libs/diagnostics/go.mod", "go.mod", "go.sum", "go.work", "go.work.sum", "mise.toml"]);
    ctx.writesFiles(["spells/harness/opencode/gen/magus-opencode.wasm", "spells/harness/opencode/gen/wasm_exec.js"]);
    _ = proc\exec("go", ["generate", "./internal/interp/bindings/opencode"]);
}

// Compiles the version-stamped magus binary.
export fun go_build(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(gopherbuzz\build, opencode_runtime_generate);
    // The embedded spell type mirrors are an output, so the link must follow their
    // regeneration; ctx.readsFiles would replace the **/*.go footprint, not add to it.
    ctx.needs(spells_generate);
    // Read after spells_generate so it records the declarations this link embeds. Its Go
    // input digest is what bootstrap-worktree compares before placing this binary elsewhere.
    final stamp = agentpolicy\buildStamp(".");
    go["go-build"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {
        "args": ["-trimpath",
            "-ldflags", ld_flags() + " -X github.com/egladman/magus/internal/interp/bindings.buildStamp=" + stamp,
            "-o", "magus",
            "./cmd/magus"],
    });
    // macOS assesses a new executable on its first exec, which can outlast a hook's
    // budget; run it here so no hook pays for that.
    final said = proc\exec("./magus", ["version"], ".").stdout;
    if (!said.startsWith("magus ")) {
        throw "go-build: the built ./magus did not answer `version` with a `magus ` line: {said}";
    }
}

// go's go-test over the root module. The guard's pull-request-text test runs the proofread
// binary, so a fresh worktree builds it first, as `test` does.
export fun go_test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(proofreadlib\proofread_build);
    go["go-test"](ctx);
}

// host is what login authenticates against and repository is where a push goes;
// they differ per provider. user_ref and token_ref are secret references.
object Registry {
    host: str = "",
    repository: str = "",
    user_ref: str = "",
    token_ref: str = "",
}

final GHCR = Registry{
    host = "ghcr.io",
    repository = "ghcr.io/egladman/magus",
    user_ref = "GHCR_USERNAME",
    token_ref = "GHCR_TOKEN",
};

// Declared rather than derived from the git remote, so a fork cannot publish to its
// own namespace.
final GHCR_GRAPH = Registry{
    host = "ghcr.io",
    repository = "ghcr.io/egladman/magus/knowledge-graph",
    user_ref = "GHCR_USERNAME",
    token_ref = "GHCR_TOKEN",
};

final GHCR_SPELLS = Registry{
    host = "ghcr.io",
    repository = "ghcr.io/egladman/magus/spells",
    user_ref = "GHCR_USERNAME",
    token_ref = "GHCR_TOKEN",
};

// TODO: Docker Hub publishing is disabled until DOCKERHUB_USERNAME / DOCKERHUB_TOKEN
// exist as repository secrets; uncomment and restore DOCKERHUB to REGISTRIES then.
// final DOCKERHUB = Registry{
//     host = "docker.io",
//     repository = "docker.io/egladman/magus",
//     user_ref = "DOCKERHUB_USERNAME",
//     token_ref = "DOCKERHUB_TOKEN",
// };

// Every tag goes into one buildx invocation, so each registry gets the identical digest.
final REGISTRIES = [GHCR];

fun image_tag() > str !> any { return "magus:" + commit(); }

// unpublished narrows registries to the ones a release image is pushed to: all of them
// under the mutable charm, otherwise those not yet carrying tag. A release's version tag is
// write-once, and the floating tags beside it (latest) move only when it is pushed.
fun unpublished(ctx: magus\Context, registries: [Registry], tag: str) > [Registry] !> any {
    final targets = mut [<Registry>];
    foreach (reg in registries) {
        final tags = registry_tags(reg.repository, user: magus\secret.read(reg.user_ref),
            token: magus\secret.read(reg.token_ref));
        if (publish_action(ctx, unit: reg.repository + ":" + tag, published: tags.indexOf(tag) != null) != releases\KEEP) {
            targets.append(reg);
        }
    }
    return targets;
}

// The index is assembled once and pushed to each registry, so each
// serves one digest. cosign signs it beside the image in each.
fun publish_variant(ctx: magus\Context, variant: images\ImageVariant, build: images\Build, registries: [Registry], tags: [str]) > images\Published {
    if (registries.len() == 0) { return images\Published{}; }
    final built = images\assemble(images\plan(variant, ldflags: build.ldflags),
        compile: fun (env: {str: str}, args: [str]) > void !> any => go["go-build"](ctx.withEnv(env), {"args": args}));
    if (built.error != "") { return images\Published{ error = built.error }; }
    final attested = images\attest(built, build: build);
    if (attested.error != "") { return images\Published{ error = attested.error }; }
    final refs = mut [<str>];
    try {
        foreach (reg in registries) {
            final pushed = image\push(attested.index, repository: reg.repository, tags: tags,
                auth: image\RegistryAuth{
                    username = magus\secret.read(reg.user_ref),
                    password = image\Secret{ value = magus\secret.read(reg.token_ref) },
                });
            cosign["cosign-sign"](ctx, {"args": [reg.repository + "@" + pushed.digest.string()]});
            foreach (t in tags) { refs.append(reg.repository + ":" + t); }
        }
    } catch (e) {
        return images\Published{ refs = refs, error = "image-build: publish {variant.name}: {e}" };
    }
    return images\Published{ refs = refs };
}

fun write_image_summary(ctx: magus\Context, refs: [str]) > void !> any {
    if (!ctx.hasCharm("gha")) { return; }
    final summaryPath = os\env("GITHUB_STEP_SUMMARY");
    if (summaryPath == null or ("{summaryPath}") == "") {
        throw "image-build: the gha charm is set but $GITHUB_STEP_SUMMARY is unset; run this inside a GitHub Actions step";
    }
    if (refs.len() == 0) { return; }

    final rows = mut ["## Container images\n\n| Reference | Pull |\n| --- | --- |\n"];
    foreach (r in refs) {
        rows.append("| `" + r + "` | `docker pull " + r + "` |\n");
    }
    final md = rows.join("") + "\nRun one against this workspace:\n\n```sh\ndocker run --rm -v \"$PWD\":/workspace "
        + refs[0] + " ls\n```\n";

    final sp = "{summaryPath}";
    var existing = "";
    if (fs\exists(sp)) { existing = fs\readFile(sp); }
    fs\writeFile(sp, existing + md);
}

// `--load` cannot load a multi-platform result, so a local build is one architecture.
// Always linux/: the artifact is a container image whatever the host OS.
fun load_platform(ctx: magus\Context) > str !> any {
    exclusive_charms(ctx, "amd64", "arm64", "WS1001", "which platform to build for");
    if (ctx.hasCharm("amd64")) { return "linux/amd64"; }
    if (ctx.hasCharm("arm64")) { return "linux/arm64"; }
    return "linux/" + os\platform()[1];
}

// Charms are an unordered set, so reading two in sequence would invent a precedence.
// WS is the code prefix magus.yaml declares; magus\diagnosticCode refuses MGS.
fun exclusive_charms(ctx: magus\Context, a: str, b: str, code: str, question: str) > void !> any {
    if (ctx.hasCharm(a) and ctx.hasCharm(b)) {
        magus\raise(magus\diagnosticCode(code), message: "the `" + a + "` and `" + b
            + "` charms both answer " + question + " - name one",
            opts: magus\RaiseOptions{url = "https://eli.gladman.cc/magus/recommendations/#one-charm-answers-one-question"});
    }
}

// docker load needs a docker-save manifest.json beside the OCI layout (classic
// daemons reject a bare OCI tar with blobs/json missing). The manifest names
// the tag, so load tags the image itself.
fun load_variant(ctx: magus\Context, variant: images\ImageVariant, platform: str, ldflags: str, tag: str) > images\Loaded {
    final one = images\only(variant, platform: platform);
    if (one.error != "") { return images\Loaded{ error = one.error }; }
    final built = images\assemble(images\plan(one.variant, ldflags: ldflags),
        compile: fun (env: {str: str}, args: [str]) > void !> any => go["go-build"](ctx.withEnv(env), {"args": args}));
    if (built.error != "") { return images\Loaded{ error = built.error }; }
    final layout = built.layouts[0].path;
    try {
        final id = images\prepareLoad(layout, tag: tag);
        if (id.error != "") { return images\Loaded{ error = id.error }; }
        final tarball = layout + ".tar";
        _ = archive\compress(layout, dest: tarball);
        docker["docker-load"](ctx, {"args": ["--input", tarball]});
        // A binary that cannot exec on its base fails here, not later.
        docker["docker-run"](ctx, {"args": [tag, "version"]});
        return images\Loaded{ tag = tag, id = id.id, layout = layout };
    } catch (e) {
        return images\Loaded{ error = "image-build: load {variant.name}: {e}" };
    }
}

// Builds the image locally, or with `cd` pushes and signs it; `stable` and `unstable`
// pick the channel. A commit-channel signature carries cd.yaml's identity, so the
// release verify command rejects it.
export fun image_build(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["dist/image/**"]);
    final ldflags = ld_flags();
    if (!ctx.hasCharm("cd")) {
        var variant = images\STATIC;
        if (ctx.hasCharm("dynamic")) { variant = images\DYNAMIC; }
        final loaded = load_variant(ctx, variant: variant, platform: load_platform(ctx), ldflags: ldflags, tag: image_tag());
        if (loaded.error != "") { throw loaded.error; }
        magus\log.info("image-build: loaded {loaded.tag} ({loaded.id}) from {loaded.layout}");
        return;
    }
    // The SLSA builder is the workflow that ran, so the workflow names itself.
    var builder = "";
    if (args.len() == 2 and args[0] == "--builder") { builder = args[1].trim(); }
    if (builder == "") {
        throw "image-build: the cd charm records the provenance builder and needs "
            + "`-- --builder <server url>/<workflow ref>`; got {args}";
    }
    final build = images\Build{ ldflags = ldflags, revision = commit(), builder = builder };
    final registries = publish_registries(ctx);
    final pushed = mut [<str>];
    final ch = channel(ctx);
    if (ch == "commit") {
        final run = publish_variant(ctx, variant: images\STATIC, build: build, registries: registries, tags: [commit()]);
        if (run.error != "") { throw run.error; }
        foreach (r in run.refs) { pushed.append(r); }
    } else {
        foreach (variant in [images\STATIC, images\DYNAMIC]) {
            final tags = images\releaseTags(variant, version: version(), stable: ch == "stable");
            final run = publish_variant(ctx, variant: variant, build: build,
                registries: unpublished(ctx, registries: registries, tag: tags[0]), tags: tags);
            if (run.error != "") { throw run.error; }
            foreach (r in run.refs) { pushed.append(r); }
        }
    }
    write_image_summary(ctx, refs: pushed);
}

fun publish_registries(ctx: magus\Context) > [Registry] !> any {
    if (!ctx.hasCharm("cd")) { return []; }
    if (channel(ctx) == "commit") { return [GHCR]; }
    return REGISTRIES;
}

// `tagged` derives the channel from the release tag, so cutting a candidate needs only a tag.
fun channel(ctx: magus\Context) > str !> any {
    exclusive_charms(ctx, "stable", "unstable", "WS1002", "which channel to publish to");
    final wantTagged = ctx.hasCharm("tagged");
    final wantStable = ctx.hasCharm("stable");
    final wantUnstable = ctx.hasCharm("unstable");
    if (wantTagged and (wantStable or wantUnstable)) {
        magus\raise(magus\diagnosticCode("WS1002"), message: "the `tagged` charm reads which channel to publish "
            + "to off the release tag, so naming `stable` or `unstable` beside it answers "
            + "that question twice - name one",
            opts: magus\RaiseOptions{url = "https://eli.gladman.cc/magus/recommendations/#one-charm-answers-one-question"});
    }
    if (!wantStable and !wantUnstable and !wantTagged) { return "commit"; }

    final v = version();
    if (v == "unknown") {
        throw "image: a channel charm needs a version and this tree reports none - magus "
            + "reads it from `git describe`, so a shallow clone with no tags cannot supply "
            + "one. Fetch tags, or drop the charm to publish to the commit channel.";
    }
    if (wantTagged) {
        final tag = exact_release_tag();
        if (tag == "") {
            throw "image: `tagged` reads the channel off the release tag HEAD sits on, and "
                + "HEAD is not tagged - `" + v + "` describes distance past the nearest tag "
                + "rather than a release. Tag the release first, or name `stable`/`unstable`.";
        }
        if (semver\parse(tag).prerelease == "") { return "stable"; }
        return "unstable";
    }

    // describe() gives an untagged commit a prerelease (v0.4.0-3-gabc123), so stable rejects
    // untagged builds too.
    final pre = semver\parse(v).prerelease;
    if (wantStable and pre != "") {
        throw "image: `" + v + "` carries the prerelease `" + pre + "`, so it cannot go to "
            + "the stable channel - that is the channel `latest` follows. Use `unstable` "
            + "for it, or run this from a stable release tag.";
    }
    if (wantUnstable and pre == "") {
        throw "image: `" + v + "` is a stable version, so `unstable` would file it under a "
            + "channel it does not belong to. Use `stable` for it.";
    }
    if (wantStable) { return "stable"; }
    return "unstable";
}

// By host, never index: how many registries there are depends on the charms.
fun select_registries(registries: [Registry], host: str) > [Registry] !> any {
    if (host == "") { return registries; }
    final hosts = mut [<str>];
    foreach (reg in registries) {
        if (reg.host == host) { return [reg]; }
        hosts.append(reg.host);
    }
    throw "no registry \"{host}\" for these charms; this mode publishes to: {hosts.join(", ")}";
}

// Reports where image-build under the same charms pushes and, with `verify`, fails when a
// credential does not resolve.
export fun image_registries(ctx: magus\Context, args: [str]) > void !> any {
    var host = "";
    if (args.len() > 0) { host = args[0]; }
    final registries = select_registries(publish_registries(ctx), host);
    if (registries.len() == 0) {
        magus\log.info("image-registries: this build pushes nowhere; add the cd charm to see where a delivery goes (`:cd` per-commit, `:cd,stable` a release)");
        return;
    }
    // Resolving can open a provider's unlock prompt, so only `verify` resolves.
    final checking = ctx.hasCharm("verify");
    final table = mut [pad("REGISTRY", 12) + pad("REPOSITORY", 28) + pad("USERNAME REF", 20) + pad("TOKEN REF", 20) + "CREDENTIALS"];
    foreach (reg in registries) {
        var state = "not checked (add the verify charm)";
        if (checking) { state = credential_state(reg); }
        table.append(pad(reg.host, 12) + pad(reg.repository, 28)
            + pad(reg.user_ref, 20) + pad(reg.token_ref, 20)
            + state);
    }
    // magus\log.info prefixes only its first line, so the table follows a lead line.
    magus\log.info("image-build under these charms publishes to:\n" + table.join("\n"));

    if (!checking) { return; }
    var unready = mut [<str>];
    foreach (reg in registries) {
        if (credential_state(reg) != "ready") { unready.append(reg.host); }
    }
    if (unready.len() > 0) {
        throw "image-registries: no usable credentials for " + unready.join(", ")
            + "; set the variables named above (in CI they come from repository secrets)";
    }
}

// A provider signals a missing secret by throwing, so presence is only testable by resolving.
fun credential_state(reg: Registry) > str {
    var missing = mut [<str>];
    if (!resolvable(reg.user_ref)) { missing.append(reg.user_ref); }
    if (!resolvable(reg.token_ref)) { missing.append(reg.token_ref); }
    if (missing.len() == 0) { return "ready"; }
    return "missing " + missing.join(", ");
}

fun resolvable(ref: str) > bool {
    try {
        _ = magus\secret.read(ref);
        return true;
    } catch (e) {
        return false;
    }
}

fun pad(s: str, width: int) > str !> any {
    if (s.len() >= width) { return s + " "; }
    return s + " ".repeat(width - s.len() + 1);
}

// Scans the image with trivy; the rw charm writes SARIF and gates on HIGH/CRITICAL.
// Through the spell op, not proc\exec, so trivy's database keys the cache.
export fun image_scan(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(image_build);
    if (ctx.hasCharm("rw")) {
        fs\mkdirAll("dist");
        docker["trivy-image"](ctx, {"args": [
            "--format", "sarif",
            "--output", fs\join("dist", "trivy.sarif"),
            "--severity", "HIGH,CRITICAL",
            "--exit-code", "1",
            image_tag()]});
    } else {
        docker["trivy-image"](ctx, {"args": [image_tag()]});
    }
}

// Runs govulncheck and gates on dependency license terms.
// magus is GPL-3.0-or-later, so compatible copyleft is ignored explicitly and anything
// unrecognized fails. GPL-2.0-only, CDDL, EPL, MPL-1.1 and BSD-4-Clause are incompatible.
export fun security(ctx: magus\Context, args: [str]) > void !> any {
    // Parsed first so a bad argument fails before generate runs.
    final inheritedFatal = advisories\inheritedFatal(args);
    // govulncheck parses generated .go files, so it must follow generate or race mockery.
    ctx.needs(generate);
    advisories\govulncheck(ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), go: go, inheritedFatal: inheritedFatal);
    // Cantrip: the filesystem license scan. Image scans call docker["trivy-image"].
    // docs/glossary/cantrip.md
    _ = proc\exec("trivy", ["fs", "--scanners", "license",
        "--severity", "HIGH,CRITICAL",
        "--ignored-licenses", "AGPL-3.0,AGPL-3.0-only,AGPL-3.0-or-later,"
            + "GPL-3.0,GPL-3.0-only,GPL-3.0-or-later,GPL-2.0-or-later,"
            + "LGPL-2.1,LGPL-2.1-only,LGPL-2.1-or-later,"
            + "LGPL-3.0,LGPL-3.0-only,LGPL-3.0-or-later",
        "--exit-code", "1",
        // .magus is magus's own cache, which lint's graph build rewrites while this walks
        // the tree: a shard renamed mid-walk failed the scan. .claude/worktrees holds whole
        // other checkouts in a local clone. Neither carries a dependency's license.
        "--skip-dirs", ".magus,.claude/worktrees",
        "."], ".");
}

// Renders the roff man pages into manpage/ and refreshes internal/commands/testdata/api.lock,
// both serialized from the internal/commands tree. The Markdown manpages belong to docs/.
export fun man_generate(ctx: magus\Context, args: [str]) > void !> any {
    // Both lines compile internal/spell, which go:embeds generated files, so every generator
    // writing Go under internal/ or types/gen must finish first or MGS4008 refuses the run.
    ctx.needs(spells_generate, job_generate, buzz_generate, langservice_generate,
              mcp_tools_generate, config_generate, mocks_generate);
    ctx.readsFiles(["cmd/magus-manpage/**/*.go", "internal/**/*.go", "types/**/*.go",
        "libs/cmdline/**/*.go",
        "go.mod", "go.sum", "go.work", "go.work.sum",
        "internal/spell/gen/types/*.buzz",
        "internal/spell/gen/decls/*.buzz", "internal/job/gen/*.json"]);
    ctx.writesFiles(["manpage/*.1", "internal/commands/testdata/api.lock"]);
    fs\mkdirAll("manpage");
    _ = proc\exec("go", ["run", "./cmd/magus-manpage", "-format", "roff", "-out", "manpage"]);
    _ = proc\exec("go", ["generate", "./internal/commands/..."]);
}

// Renders every exported declaration of the public Go packages (the list lives in
// cmd/magus-utils/public_api.go) into internal/commands/testdata/api-go.lock, beside the CLI's api.lock.
export fun go_api_generate(ctx: magus\Context, args: [str]) > void !> any {
    // The packages are type-checked from source and the root embeds generated files, so
    // every generator writing Go under internal/ or types/gen must finish first.
    ctx.needs(spells_generate, job_generate, buzz_generate, langservice_generate,
              mcp_tools_generate, config_generate, mocks_generate);
    ctx.readsFiles(["cmd/magus-utils/**/*.go", "*.go", "types/**/*.go", "libs/testkit/**/*.go", "libs/cmdline/**/*.go",
        "internal/**/*.go", "go.mod", "go.sum", "go.work", "go.work.sum",
        "internal/spell/gen/types/*.buzz",
        "internal/spell/gen/decls/*.buzz", "internal/job/gen/*.json"]);
    ctx.writesFiles(["internal/commands/testdata/api-go.lock"]);
    _ = proc\exec("go", ["run", "./cmd/magus-utils", "goapi", "-out", "internal/commands/testdata/api-go.lock"]);
}

fun pull_request_event(ctx: magus\Context, target: str) > serialize\Boxed? !> any {
    if (!ctx.hasCharm("gha")) { return null; }
    final path = os\env("GITHUB_EVENT_PATH") ?? "";
    if (path == "" or !fs\exists(path)) {
        throw "{target}: the gha charm is set but $GITHUB_EVENT_PATH names no file; run it in a pull_request workflow";
    }
    return serialize\jsonDecode(fs\readFile(path)).q("pull_request");
}

fun pull_request_title(ctx: magus\Context, args: [str], target: str) > str !> any {
    final title = args.join(" ");
    if (title != "") { return title; }
    final event = pull_request_event(ctx, target: target);
    if (event == null) {
        throw "{target}: no title: pass one after `--`, or add the gha charm in a pull_request workflow";
    }
    return event?.q("title").stringValue() ?? "";
}

// workspaceProjects are every project's path, as `magus ls` lists them.
fun workspaceProjects() > [str] !> any {
    final listed = magus\cmd("ls", args: ["-o", "name"], opts: magus\CommandOptions{ quiet = true });
    final paths = mut [<str>];
    foreach (line in listed.stdout.trim().split("\n")) {
        if (line != "") {
            paths.append(line);
        }
    }
    return paths;
}

// affectedProjects are the projects the change against the base reaches.
fun affectedProjects() > [str] !> any {
    final paths = mut [<str>];
    foreach (p in magus\change("").affected().affected) {
        paths.append(p);
    }
    return paths;
}

// Fails a pull request title that is not a conventional commit subject, or whose subject
// is not imperative or carries a selling word.
export fun pr_title(ctx: magus\Context, args: [str]) > void !> any {
    final title = pull_request_title(ctx, args: args, target: "pr-title");
    final problems = mut [<str>];
    var problem = commits\problem(title);
    if (problem == "" and commits\scopes(title).len() > 0) {
        problem = commits\scopeProblem(title, projects: workspaceProjects(), affected: affectedProjects());
    }
    if (problem != "") {
        problems.append(problem);
    } else {
        foreach (wordy in wording\wordingProblems(title, conventional: true)) {
            problems.append(wordy);
        }
    }
    if (problems.len() > 0) {
        throw "pr-title: \"{title}\": {problems.join("; ")}";
    }
    magus\log.info("pr-title: \"{title}\" is a conventional commit subject");
}

// Fails a pull request whose title or description the guard's pull-request-text rule
// would deny. It runs the same judgeText: proofread under this repository's
// decisions table, a grade under the change-description minimum included, the word budget
// the branch's diff earns and the title checks. The guard's advice, such as an area the
// branch touches that the description never names, is told to the author when the text is
// written, not here. The output refs a description cites are not checked: this checkout
// holds none of the author's runs. --title and --body carry the text; the workflow, not
// this target, reads the event.
export fun pr_description(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(proofreadlib\proofread_build);
    final parsed = flags\parse(args, switches: [<str>], valued: ["--title", "--body"], required: ["--title", "--body"]);
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "pr-description: unexpected arguments {args.join(" ")}; pass --title=<title> --body=<description>";
    }
    final text = descriptions\Text{ kind = "change-description", title = parsed.values["--title"] ?? "",
        body = parsed.values["--body"] ?? "" };
    final found = descriptions\judgeText(text, facts: fun () > descriptions\Facts => descriptions\branchDiff(".")(""),
        judge: descriptions\judgeRunner("."), cited: descriptions\skipCited);
    if (found.denies.len() > 0) {
        throw "pr-description: the description breaks the proofread rules (docs/conventions.md):\n  " + found.denies.join("\n  ");
    }
    magus\log.info("pr-description: the title and description pass the proofread rules");
}

// Fails a feat, fix, perf or breaking pull request that ships code without a changelog
// fragment under changes/unreleased/, and any malformed fragment.
export fun pr_changelog(ctx: magus\Context, args: [str]) > void !> any {
    final title = pull_request_title(ctx, args: args, target: "pr-changelog");
    final base = vcs\base();
    var changed = mut [<str>];
    foreach (f in vcs\changedFiles(base)) { changed.append(f.value); }
    var added = mut [<str>];
    foreach (path in changelog\fragments(changed)) {
        if (fs\exists(path)) { added.append(path); }
    }
    final malformed = changelog\lint(added);
    if (malformed.len() > 0) {
        throw "pr-changelog: malformed changelog fragment(s); changes/README.md has the format:\n  "
            + malformed.join("\n  ");
    }
    final problem = changelog\problem(title, changed: changed, added: added);
    if (problem != "") {
        throw "pr-changelog: against {base}: {problem}";
    }
    final owed = changelog\owed(title, changed: changed);
    if (owed.len() == 0) {
        magus\log.info("pr-changelog: \"{title}\" owes no entry against {base}");
        return;
    }
    magus\log.info("pr-changelog: {added.len()} changelog fragment(s) cover {owed.len()} shipped path(s)");
}

// Fails a pull request any of whose commits carries an attribution.
// A person's own commit, or one an agent handed a person, reaches no
// guard, so the pull request judges it by the commit rule's pattern.
export fun pr_commits(ctx: magus\Context, args: [str]) > void !> any {
    if (args.len() > 0) {
        throw "pr-commits: unexpected arguments {args.join(" ")}; it takes none";
    }
    final base = vcs\base();
    final commits = vcs\commits(base);
    final attributed = mut [<str>];
    foreach (c in commits) {
        if (wording\attributes("{c.subject}\n{c.body}")) {
            attributed.append("{c.short} {c.subject}");
        }
    }
    if (attributed.len() > 0) {
        throw "pr-commits: against {base}, {attributed.len()} commit(s) carry an attribution "
            + "(Co-Authored-By, Generated with); reword them to credit nobody:\n  " + attributed.join("\n  ");
    }
    magus\log.info("pr-commits: none of {commits.len()} commit(s) against {base} carries an attribution");
}

// Lists the deviation lines a pull request adds and the gate files it edits.
// --files is the JSON the workflow fetched from the pull request files API.
// It never fails: a person reads the list, and the gate stays the check.
export fun pr_deliberate_break(ctx: magus\Context, args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: [<str>], valued: ["--files"], required: ["--files"]);
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "pr-deliberate-break: unexpected arguments {args.join(" ")}; pass --files=<json>";
    }
    final listing = deviations\parseChanged(fs\readFile(parsed.values["--files"] ?? ""));
    if (listing.error != "") {
        std\print("::error::pr-deliberate-break: {listing.error}");
        return;
    }
    final summary = mut ["### Deliberate breaks", ""];
    if (listing.notices.len() == 0) {
        summary.append("This pull request adds no deviation line and edits no gate.");
    }
    foreach (n in listing.notices) {
        final level = if (n.error) "error" else "notice";
        std\print("::{level} file={n.path}::{n.text}");
        summary.append("- {n.text}");
    }
    final target = os\env("GITHUB_STEP_SUMMARY") ?? "";
    if (target != "") {
        fs\appendFile(target, content: summary.join("\n") + "\n");
    }
}

// Deletes the shims once installed from hack/git-hooks, and no other hook.
export fun git_hooks_remove(ctx: magus\Context, args: [str]) > void !> any {
    githooks\remove(ctx, dir: "hack/git-hooks");
}

// Regenerates everything derived from the boundary registry: the runtime boundary list,
// the Go-to-Buzz encoders, the Buzz-to-Go decoders, the provider ops, the spell
// contract's signatures and the merge queue script's record mirrors. The TypeScript
// forms are console's and docs' own types-generate.
export fun types_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(["internal/interp/bindings/gen/boundary_list.go",
        "internal/interp/bindings/gen/boundary_objects.go",
        "internal/interp/bindings/gen/boundary_ops.go",
        "internal/interp/bindings/gen/providerops/providerops.go",
        "internal/interp/bindings/gen/decode/decode.go",
        "internal/interp/bindings/gen/inbound_list_test.go",
        "internal/interp/bindings/gen/decode/contract.go",
        "internal/queue/provider/gen/types/*.buzz"]);
    _ = proc\exec("go", ["generate", "./cmd/magus-utils"]);
    // One process renders every mirror the file's go:generate lines name; a
    // go generate pass ran one process per line, serially.
    _ = proc\exec("go", ["run", "./cmd/magus-utils", "types", "-from", "internal/queue/provider/host.go"]);
}

// Regenerates the Go host bindings (std -> internal/interp/bindings/gen) from
// std.Module declarations. The exclusions keep gen/'s hand-written tests and
// types_generate's files out of its outputs.
export fun buzz_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(types_generate, spells_generate, job_generate, langservice_generate);
    ctx.readsFiles(["**/*.go", "go.mod", "go.sum", "go.work", "go.work.sum",
        "internal/spell/gen/types/*.buzz",
        "internal/spell/gen/decls/*.buzz", "internal/job/gen/*.json"]);
    ctx.writesFiles(["internal/interp/bindings/gen/*.go",
        "!internal/interp/bindings/gen/*_test.go",
        "!internal/interp/bindings/gen/boundary_*.go",
        "std/termkit/gen/**/*.go"]);
    // The termkit leaf packages compile into magus-utils, so they are written
    // before the run that reads every module.
    _ = proc\exec("go", ["run", "./cmd/magus-utils", "libmodules", "-dir", "libs/termkit",
        "-outdir", "std/termkit/gen", "-import", "github.com/egladman/magus/std/termkit/gen"]);
    _ = proc\exec("go", ["run", "./cmd/magus-utils", "bindings", "-all",
        "-outdir", "internal/interp/bindings/gen", "-pkg", "bindgen"]);
    _ = proc\exec("go", ["run", "./cmd/magus-utils", "moduleset",
        "-outdir", "internal/interp/bindings/gen", "-pkg", "bindgen"]);
}

// Regenerates the magusfile API lock through TestMagusAPILocked and the std method-name
// lock through TestStdAPILocked.
// -count=1 is load-bearing: a cached pass writes no file.
export fun magusfile_api_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(buzz_generate);
    ctx.writesFiles(["internal/interp/bindings/testdata/magus-api.lock", "std/gen/std-api.lock"]);
    go["go-test"](ctx.withEnv({"UPDATE_MAGUS_API_LOCK": "1", "UPDATE_STD_API_LOCK": "1", "GOEXPERIMENT": "jsonv2"}),
        {"args": ["-count=1", "-run", "TestMagusAPILocked|TestStdAPILocked",
            "./internal/interp/bindings/", "./std/"]});
}

// Regenerates the host-module snapshot the playground's completion and hover read
