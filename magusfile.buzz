import "magus";
// The shared toolchain windows; see tools/toolchain-policy.buzz for why they are a
// module rather than an export on this file.
import "./tools/toolchain-policy" as policy;
import "./tools/drift" as drift;
// The optional half of toolchain observation: the `tools` window above is the gate
// that can fail a build and makes no network calls; this reports when a declared
// window has gone stale. Aliased `toolchains` because a module and a target function
// cannot share a name - the alias would shadow and the call fails with "null is not
// callable" at run time.
import "./tools/toolchain" as toolchains;

// Host modules: magus layers its methods onto Buzz's stdlib (camelCase).
import "os";
import "proc";
import "fs";
import "http";
import "vcs";
import "archive";
import "crypto";
import "serialize";
import "io";
import "std";
import "semver";

import "magus/spell/go";
import "magus/spell/docker";
import "magus/spell/cosign";
import "magus/spell/buzz";
import "magus/spell/markdown";
import "magus/spell/bash";

import "badge" as badge;
import "coverage" as cov;

// Version-selection rules for the `release` target below. ALIASED deliberately:
// an unaliased import flat-merges the module's exports into this file's scope,
// where magus reads every exported fun as a target and rejects the ones without a
// magus\Context first parameter (MGS1008). Aliasing keeps them namespaced, which
// is the same reason docs/magusfile.buzz aliases its renderer.
import "releaser" as releaser;
import "spells/golang/gomod" as gomod;

// gopherbuzz is embedded (require + replace); binds its targets as cross-project handles.
import "project/libs/gopherbuzz" as gopherbuzz;

// Cross-shard remote cache via GitHub Actions Cache; self-gates on GITHUB_ACTIONS.
//
// The trust set is the switch: declaring the keys that verify the cache is what turns
// the cache on. The insecure arm is an escape hatch for validating a backend BEFORE
// minting keys, and it is deliberately second here - reaching for it as the way to
// enable the cache is a trap that costs you the verification you thought you had.
// remoteCacheSigningOpts returns WithInsecureRemote before it ever reads a trust set,
// so an insecure wiring silently ignores every key in magus.yaml. ci.yaml set it that
// way for a while and replayed unsigned artifacts the whole time.
//
// Two resolutions of one knob, and they can disagree: this reads raw os\env, while the
// engine reads the parsed config (magus.yaml, then env, then flags). `insecure: false`
// in magus.yaml with the env var set wires a backend here that the engine then refuses.
import "spells/github/actions" as github;
final cache_trusted = os\env("MAGUS_CACHE_REMOTE_TRUSTED_KEYS");
final cache_insecure = os\env("MAGUS_CACHE_REMOTE_INSECURE");
if ((cache_trusted != null and cache_trusted != "") or cache_insecure == "true" or cache_insecure == "1") {
    magus\cache.remote(github);
}

// Outputs are declared per-target with ctx.writesFiles (in each *-generate body
// below) rather than project-wide: each generated tree belongs to exactly one
// generator, so snapshotting a generated tree under go-build (which never writes one)
// is both wasteful and a hazard - a go-build cache hit would restore a stale MAGUS.md.
// `magus clean --outputs` still sees them all (Project.AllOutputs unions the
// per-target sets). See docs/cache.md#per-target-inputs-and-outputs.
magus\project({
    "tools": policy\all,
    // Declared so the root project's label is stable. Without it the label falls
    // back to the checkout's directory basename, so a worktree, a differently
    // named clone, or a CI checkout each renamed the root project and rewrote
    // every generated index naming it - which is why regenerating MAGUS.md from
    // a worktree produced spurious diffs.
    "name": "magus",
    "spells": [go, buzz, markdown, bash],
    // The tool configs the bound spells actually read, on top of the source globs those
    // spells contribute. Every one of these changes what a target DOES while matching no
    // spell glob, so leaving one undeclared buys a cache HIT on an edit to it: golangci-lint
    // re-run under a new rule set, replaying the verdict from the old one. That is the
    // silent half of under-declaration. The loud half is louder - an undeclared file here
    // still seeds the root project through directory containment, so touching it reruns
    // everything without keying anything (MGS1028).
    //
    // Deliberately NOT here: LICENSE (only release-build reads it, and that target is
    // skip_cache, so declaring it would invalidate build/test/lint to key nothing) and
    // .gitignore (no target reads it at all). Both keep seeding by containment, and
    // doctor keeps saying so - an undeclared file is only wrong when it is an input.
    "sources": [
        ".golangci.yml",        // golangci-lint, via the go spell's lint op
        ".mockery.yaml",        // drives `go tool mockery` in generate
        ".markdownlintignore",  // markdownlint, via the markdown spell's lint op
        "dprint-base.json",     // dprint.json extends it; the markdown spell declares only dprint.json
        "mise.toml",            // pins the toolchain every op in this project runs under
        "magus.yaml",           // charms, cache and sandbox policy every run resolves
        "Dockerfile",           // image-build's amd64 variant
        "Dockerfile.static",    // image-build's static multi-arch variant
    ],
    "targets": {
        "watch": {"skip_cache": "blocks on a filesystem watch loop and never returns"},
        // serve blocks (a long-running dev-loop server), so it must never cache.
        "serve": {"skip_cache": "blocks as a long-running dev server and never returns"},
        // deploy-generate writes a gitignored tree and nothing else.
        // No ctx.writesFiles for gen/site: declared output globs are what EnsureMergeDriver
        // writes into .gitattributes, and an ignored path can never conflict.
        "deploy-generate": {"skip_cache": "assembles a gitignored deploy tree that is never snapshotted"},
        "generate": {"skip_cache": "is the drift gate itself; a replay would skip the check it exists to make", "exclusive": true},
        // Both render the WHOLE graph, but only the magusfiles are keyable inputs, so any
        // other change leaves the key unmoved and a hit reverts the committed file.
        "index-generate": {"skip_cache": "output derives from the entire knowledge graph, which no input glob can key"},
        "graph-generate": {"skip_cache": "output derives from the entire knowledge graph, which no input glob can key"},
        "ci-shard": {"skip_cache": "emits a shard plan for the current invocation, not a reusable artifact"},
        "image-build": {"skip_cache": "pushes and cosign-signs a registry digest per invocation"},
        // Both read the environment and report or act on it per invocation; a replay
        // would report the charms and credentials of whatever ran last.
        "image-registries": {"skip_cache": "reports the registry table resolved from the current environment"},
        "image-login": {"skip_cache": "authenticates to a registry per invocation; a replay would reuse stale credentials"},
        // Keyed on the image and this tree, but the ANSWER also depends on trivy's
        // vulnerability database, which changes daily and is not an input magus can see.
        // A hit would report yesterday's CVEs against today's image.
        // ctx.observes is the successor, and it is not usable here YET: it keys on a value
        // the magusfile STATES, and nothing states trivy's DB id without probing for it,
        // which cannot run before the key is minted.
        "image-scan": {"skip_cache": "reads trivy's vulnerability database, which changes independently of this tree"},
        // A release must never replay a cached artifact (see cd.yaml's remote-cache
        // comment); each has a real side effect (dist/ output, or a signature over it)
        // per invocation.
        "release-build": {"skip_cache": "a release must never replay a cached artifact; each invocation produces the bytes that ship"},
        "release-sign": {"skip_cache": "signs the manifest per invocation; a replayed signature would cover different bytes"},
        // exclusive: under cd it switches branches and commits, so nothing else should
        // be touching the tree while it runs.
        "release-index": {"skip_cache": "signs the index per invocation and, with cd, pushes a branch; a replay would publish nothing", "exclusive": true},
        // Mutates go.mod and creates VCS tags (with the cd charm) - a real,
        // order-sensitive side effect, never a cache replay. exclusive: nothing
        // else should be touching go.mod or the tag namespace while it runs.
        "release": {"skip_cache": "mutates go.mod and creates VCS tags, an order-sensitive side effect", "exclusive": true},
        // No skip_cache: the badge moved to coverage-badge, so a hit restores only
        // the coverage profiles, which is what a hit should do.
        // memory_mb measured, not guessed: on a 16GB CI runner this target took
        // available memory from 1137MB to 265MB in two seconds and the runner was
        // killed, leaving no failing target to blame because the MACHINE died rather
        // than the test. `-race` is why - every concurrent test binary carries the
        // race detector's shadow memory. Declared in memory rather than slots because
        // that is the number an author can actually know; magus converts it to slots
        // per host, so it throttles peers on a 16GB runner and barely registers on a
        // 64GB workstation without this file naming either machine.
        "test": {"memory_mb": 10240},
        // The verdict depends on trivy's license classifier, which is not a declared tool
        // version and so is invisible to the cache key: a trivy upgrade that reclassifies a
        // dependency would replay the OLD verdict against unchanged sources.
        "security": {"skip_cache": "depends on trivy's license classifier version, which no cache key can see"},
		// Preserves the hand-authored Unreleased section in place; caching a prior
		// file would overwrite a later edit that is intentionally outside releases/.
		"changelog-generate": {"skip_cache": "preserves a hand-authored Unreleased section; a replay would overwrite a later edit"},
        // Runs a real session, so real durations and output refs land in the
        // capture and no two runs agree. Only the RENDER downstream of it
        // (termcast-generate) is reproducible enough to cache and to gate.
        "termcast-record": {"skip_cache": "records a real session, so its bytes differ every run and a replay would show different code"},
        "termcast-showcase": {"skip_cache": "drives a live interactive session, so its bytes differ every run"},
    },
});

// The ROOT release tag HEAD sits EXACTLY on, or "" when HEAD carries none. Compares revision
// ids, so it cannot read distance past a tag as the prerelease a version string would show.
//
// The shape check is releaser\rootReleaseTag, which the release preflight also asks, so a
// rehearsal and a build cannot disagree about which tag names the version. It rejects both
// lookalikes a `v*` refspec admits: this repository's `verified-refinements` tag, and the
// per-module tag a release commit also carries, which would let the root adopt
// libs/gopherbuzz/v0.1.0 as its own version.
fun exact_release_tag() > str !> any {
    return releaser\rootReleaseTag(tag_names_on_head());
}

// Every tag name HEAD carries. Separated from the selection above so the release preflight
// can ask the same question of a tag set that does not exist yet.
//
// Unpatterned: the preflight needs the namespaced tags too, since those are what `git
// describe` picks from when no root tag outranks them, and a glob wildcard stops at "/" so
// no pattern could select them.
fun tag_names_on_head() > [str] !> any {
    final head = vcs\commit().id;
    var names = mut [<str>];
    foreach (t in vcs\tags()) {
        if (t.id == head) { names.append(t.name); }
    }
    return names;
}

// The version stamped into the binary, into BUILDINFO, and into every release asset name.
//
// A root release tag on HEAD beats describe(), because `git describe --tags` has no rule for
// choosing among the tags on one commit and a release commit carries one per
// independently-versioned module. Cutting v0.4.0 it chose libs/diagnostics/v0.1.0, so every
// asset was named magus_libs/diagnostics/v0.1.0_<os>_<arch>.tar.gz, a path rather than a
// filename, and the release uploaded nothing.
//
// A dirty tree appends describe's `-dirty` instead of falling back to describe, which would
// re-enter that choice. The suffix is the only signal that a build is not the tagged commit.
//
// An untagged HEAD falls to describe, constrained to root release tags. `v[0-9]*` is
// isReleaseTag as an fnmatch pattern: the digit excludes `verified-refinements` and the
// leading `v` excludes every `libs/<name>/v0.1.0`, so the base is a root release or nothing.
// Unconstrained it picked a namespaced tag here too, and the "/" in that version made
// `release-build` refuse on every untagged commit on main.
//
// vcs\cmd rather than vcs\describe because the descriptor takes no match argument; the args
// are git's own, as release()'s `vcs\cmd(["tag", ...])` already is. build_release_variant's
// glob guard still catches what this does not.
fun version() > str !> any {
    try {
        final tag = exact_release_tag();
        if (tag != "") {
            if (vcs\isDirty()) { return tag + "-dirty"; }
            return tag;
        }
        final v = vcs\cmd(["describe", "--tags", "--always", "--dirty", "--match", "v[0-9]*"],
            {"quiet": true}).stdout.trim();
        if (v == "") { return "unknown"; }
        return v;
    } catch (e) {
        return "unknown";
    }
}

// try/catch, not a sentinel check. These accessors RAISE when there is no VCS or its
// metadata cannot be read, which is what an unavailable value should do - "" is a value a
// branch could legitimately hold, so testing for it could never distinguish "no answer"
// from "the answer is empty". A build outside a checkout is a real case (a release tarball,
// a container build context), so it is caught here and named, once, instead of every caller
// remembering a check the type system never asked for.
fun commit() > str !> any {
    try {
        return vcs\commit().short;
    } catch (e) {
        return "unknown";
    }
}

// Commit record date (RFC3339) for reproducible builds.
fun build_date() > str !> any {
    try {
        final c: Commit = vcs\commit();
        return c.date;
    } catch (e) {
        return "unknown";
    }
}

// built_by is the CI workflow that produced the binary, empty for a local build so
// nothing claims a pedigree it does not have. It should match the job_workflow_ref a
// keyless signature carries, which is what lets the claim be checked against proof.
fun built_by() > str !> any { return os\env("GITHUB_WORKFLOW_REF") ?? ""; }

fun ld_flags() > str !> any {
    return "-w -s"
        + " -X main.version=" + version()
        + " -X main.commit=" + commit()
        + " -X main.buildDate=" + build_date()
        + " -X main.builtBy=" + built_by();
}

// Compiles the version-stamped magus binary.
export fun go_build(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(gopherbuzz\build);
    // The compiled built-in spells are go:embed'd into this binary, so the link has to
    // happen AFTER they are regenerated. The cache key cannot express that on its own:
    // spells/**/*.buzz is a project source, so editing a spell does invalidate this
    // target, but the .bo it produces is an OUTPUT and never enters the key. Build before
    // regenerating and the unchanged key then replays that binary - which is how a magus
    // came out missing two tools its typescript spell had just been given. Ordering the
    // dependency is the fix; declaring the .bo as an input is not, because ctx.readsFiles
    // REPLACES a target's footprint rather than adding to it, and would drop **/*.go.
    ctx.needs(spells_generate);
    go["go-build"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {
        "args": ["-trimpath",
            "-ldflags", ld_flags(),
            "-o", "magus",
            "./cmd/magus"],
    });
}

// Compiles magus-dev, the binary THIS worktree points its own git tooling at. Paired with
// hack/install-dogfood.sh, which registers it as the worktree's merge driver.
//
// A second binary rather than reusing ./magus, for one reason: ./magus is rebuilt constantly
// while iterating, and the merge driver resolves conflicts with whatever binary it was
// registered against. Rebuilding the driver's binary in the middle of a rebase swaps the
// tool under a running git operation. magus-dev moves only when install-dogfood is re-run,
// so a rebase resolves with one known build from start to finish.
//
// Why this exists at all: the driver registration prefers `magus` on PATH (see
// gitMergeDriverCommand in vcs/git.go), which is right for a normal workspace - it survives
// an upgrade-in-place - and wrong for magus's own worktrees, where PATH holds a RELEASE and
// the change under test is in the working tree. That gap is not cosmetic: the released
// driver regenerated the whole site once per conflicted file, so a rebase touching a handful
// of generated files looked like a hang, while the fix had been in the tree the whole time.
// No ctx.writesFiles here, matching go_build: the declared-output globs are what
// EnsureMergeDriver writes into .gitattributes, and declaring a gitignored binary there
// marks a path that can never be tracked and so can never conflict.
export fun dogfood(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(gopherbuzz\build);
    go["go-build"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {
        "args": ["-trimpath",
            "-ldflags", ld_flags(),
            "-o", "magus-dev",
            "./cmd/magus"],
    });
}

// One registry this project publishes to. The field names follow OCI distribution
// vocabulary deliberately, because the loose usage is what makes this area painful:
//
//   registry    the server, host[:port]. `docker login` authenticates against THIS.
//               ghcr.io, docker.io, 123456789012.dkr.ecr.us-east-1.amazonaws.com
//   repository  the namespaced path within a registry holding one set of related
//               manifests: egladman/magus, team-a/app, library/nginx
//   tag         a MUTABLE pointer to one manifest inside a repository: latest, v1.2.3
//   digest      the immutable content address: sha256:...
//   reference   the whole addressable string, [registry/]repository[:tag][@digest]
//   image       strictly the ARTIFACT (manifest + config + layers), not its name.
//               "image" is used for the reference constantly, including by Docker's
//               own docs; this file does not, which is why no field is called one.
//
// `host` is the registry and `repository` is a repository reference (registry plus
// repository path, never a tag - tags are appended per build). They are SEPARATE
// fields rather than one string with the tag glued on because the thing you
// authenticate against and the thing you push to are not the same, and how they
// differ is per-provider:
//
//   GHCR / Docker Hub   login ghcr.io            push ghcr.io/egladman/magus
//   Harbor              login harbor.example.com push harbor.example.com/team-a/app
//                       (the first path segment is a Harbor project, and a robot
//                       account is often scoped to exactly one of them)
//   ECR                 login <acct>.dkr.ecr.<region>.amazonaws.com
//                       push  <acct>.dkr.ecr.<region>.amazonaws.com/myapp
//   Artifact Registry   login us-central1-docker.pkg.dev
//                       push  us-central1-docker.pkg.dev/proj/repo/app
//
// Deriving one from the other is a per-provider transformation, which is precisely
// why it belongs in Buzz rather than in a magus feature: see the "auth realm" section
// in docs/guides/tips.md for how to compute `host` from `repository` when a provider
// makes you.
//
// `user_ref` and `token_ref` are SECRET REFERENCES resolved through this workspace's
// secret provider - environment variable names under the built-in provider, which is
// what CI needs because a workflow env block is the only thing that can read a
// repository secret. They live here rather than in a workflow so that adding a
// registry stays a one-line change in one file.
object Registry {
    host: str = "",
    repository: str = "",
    user_ref: str = "",
    token_ref: str = "",
}

final GHCR = Registry{
    host = "ghcr.io",
    repository = "ghcr.io/egladman/magus",
    user_ref = "GHCR_USERNAME",
    token_ref = "GHCR_TOKEN",
};

// TODO: Docker Hub publishing is disabled until DOCKERHUB_USERNAME / DOCKERHUB_TOKEN
// exist as repository secrets; uncomment and restore DOCKERHUB to REGISTRIES then.
// final DOCKERHUB = Registry{
//     host = "docker.io",
//     repository = "docker.io/egladman/magus",
//     user_ref = "DOCKERHUB_USERNAME",
//     token_ref = "DOCKERHUB_TOKEN",
// };

// A release publishes to every registry listed. Every tag across the set goes into a
// SINGLE buildx invocation, so a variant is built exactly once and every registry
// receives the identical digest. A second `docker buildx build` aimed at a second
// registry would rebuild every layer rather than reuse them: a fresh CD runner starts
// with an empty BuildKit cache, so what makes another registry free is that there is
// no second build, not a cache that survives between two.
final REGISTRIES = [GHCR];

fun image_tag() > str !> any { return "magus:" + commit(); }

// The build-args every variant stamps into the binary through the Dockerfiles' ldflags.
fun image_stamps() > [str] !> any {
    return ["--build-arg", "VERSION=" + version(),
        "--build-arg", "COMMIT=" + commit(),
        "--build-arg", "DATE=" + build_date()];
}

// Builds one variant, pushes it to every registry, and signs it in each.
//
// `tags` are bare tag names, expanded across `registries` into -t flags on one
// buildx invocation: the variant is built once no matter how many registries or
// tags it lands under.
//
// --sbom attaches a per-platform SPDX document and --provenance a max-detail SLSA
// statement, both as in-toto attestation manifests inside the pushed index, and
// both produced by the build that was already running - BuildKit scans the
// filesystem it just assembled rather than pulling the image back to inspect it.
// They also force the result to be an index even for a single platform, which is
// why containerimage.digest below is always an index digest.
//
// cosign then runs once per REGISTRY, not once per digest. The push is
// content-addressed and shared, but a signature is a separate object stored in the
// repository beside the image it covers, so GHCR's copy does not vouch for Docker
// Hub's - the digest being signed is the same one both times.
fun publish_variant(ctx: magus\Context, dockerfile: str, platforms: str, registries: [Registry], tags: [str], meta: str) > [str] !> any {
    var args = mut ["-f", dockerfile];
    foreach (a in image_stamps()) { args.append(a); }
    foreach (reg in registries) {
        foreach (t in tags) { args.append("-t"); args.append(reg.repository + ":" + t); }
    }
    args.append("--platform"); args.append(platforms);
    args.append("--sbom=true");
    args.append("--provenance=mode=max");
    args.append("--metadata-file"); args.append(meta);
    args.append("--push");
    args.append(".");
    docker["docker-buildx"](ctx.withCwd("."), {"args": args});

    final digest = serialize\jsonDecode(fs\readFile(meta)).q("containerimage.digest").stringValue();
    var pushed = mut [<str>];
    foreach (reg in registries) {
        cosign["cosign-sign"](ctx, {"args": [reg.repository + "@" + digest]});
        foreach (t in tags) { pushed.append(reg.repository + ":" + t); }
    }
    return pushed;
}

// Appends a runnable summary of what was pushed to the GitHub Actions job summary.
//
// This lives HERE, not in a workflow `run:` block, for the same reason image-login
// does: the target already knows the references it pushed, so a workflow step that
// re-derives them (`jq -r '."image.name"' commit-meta.json`) is parsing magus's own
// output back out of a file magus wrote. That is the shell-parsing shape this
// magusfile avoids everywhere else, and it drifts the moment the tag scheme changes.
//
// Self-gating on $GITHUB_STEP_SUMMARY rather than a charm, matching the second half
// of ci_shard below: outside Actions the variable is unset and this is a no-op, so a
// local `magus run image-build:cd` needs no extra flag to stay quiet.
fun write_image_summary(refs: [str]) > void !> any {
    final summaryPath = os\env("GITHUB_STEP_SUMMARY");
    if (summaryPath == null or ("{summaryPath}") == "") { return; }
    if (refs.len() == 0) { return; }

    var md = "## Container images\n\n| Reference | Pull |\n| --- | --- |\n";
    foreach (r in refs) {
        md = md + "| `" + r + "` | `docker pull " + r + "` |\n";
    }
    md = md + "\nRun one against this workspace:\n\n```sh\ndocker run --rm -v \"$PWD\":/workspace "
        + refs[0] + " ls\n```\n";

    final sp = "{summaryPath}";
    var existing = "";
    if (fs\exists(sp)) { existing = fs\readFile(sp); }
    fs\writeFile(sp, existing + md);
}

// The platform a local --load build targets, named EXPLICITLY rather than left to
// buildx's default.
//
// Single-arch is not a preference here, it is a constraint: `docker buildx build
// --load` cannot load a multi-platform result into the docker image store, so a local
// build has exactly one architecture whatever anyone wants. Passing it explicitly
// means the build log says which one, instead of the reader having to know what the
// builder's default happens to be on this machine.
//
// The default is the HOST's architecture, so an M-series Mac builds arm64 and runs it
// natively. `linux/` is hard-coded against the host OS on purpose - the artifact is a
// container image, so darwin/windows are never the target even when they are the host.
//
// The `amd64` / `arm64` charms override it, for reproducing a failure that only
// happens on the other architecture. That path goes through QEMU emulation, so expect
// it to be slow; it is a debugging tool, not a second default.
fun load_platform(ctx: magus\Context) > str !> any {
    exclusive_charms(ctx, "amd64", "arm64", "WS1001", "which platform to build for");
    if (ctx.hasCharm("amd64")) { return "linux/amd64"; }
    if (ctx.hasCharm("arm64")) { return "linux/arm64"; }
    return "linux/" + os\platform()[1];
}

// Rejects two charms that answer one question. magus gives no charm precedence over
// another (they are an unordered set), so a magusfile that reads them in sequence invents
// one silently - `:amd64,arm64` returned amd64 and dropped the arm64 the caller asked for.
//
// WS is this WORKSPACE's code prefix, documented in docs/recommendations.md. magus.raise
// refuses the MGS prefix outright, which is what stops a workspace diagnostic from
// rendering as though magus documented it.
fun exclusive_charms(ctx: magus\Context, a: str, b: str, code: str, question: str) > void !> any {
    if (ctx.hasCharm(a) and ctx.hasCharm(b)) {
        magus\raise(code, message: "the `" + a + "` and `" + b
            + "` charms both answer " + question + " - name one",
            opts: {"url": "https://eli.gladman.cc/magus/recommendations/#one-charm-answers-one-question"});
    }
}

// Builds one variant single-arch into the local daemon under image_tag(): no
// registry, no signature. What `magus run image-build` does outside CI, and what
// image_scan hands to trivy.
fun load_variant(ctx: magus\Context, dockerfile: str) > void !> any {
    var args = mut ["-f", dockerfile];
    foreach (a in image_stamps()) { args.append(a); }
    args.append("-t"); args.append(image_tag());
    args.append("--platform"); args.append(load_platform(ctx));
    args.append("--load");
    args.append(".");
    docker["docker-buildx"](ctx.withCwd("."), {"args": args});
}

// Two axes, one charm each. `cd` is magus's built-in deliver switch: without it this
// loads an image locally and pushes nothing. `stable` and `unstable` pick the channel and
// assert the version belongs to it (see channel()).
//
//     magus run image-build                # local cgo load, pushes nothing
//     magus run image-build:static         # local static load
//     magus run image-build:cd             # GHCR, tagged with the short commit, static only
//     magus run image-build:cd,unstable    # both registries, version only, no floating tag
//     magus run image-build:cd,stable      # both registries, version + latest, both variants
//
// The commit channel is the default among delivering modes for the same reason a bare run
// pushes nothing: it adds an immutable tag to one registry and moves nothing, while a
// release moves `latest` on two public ones.
//
// A commit-channel signature carries cd.yaml's certificate identity rather than
// release.yaml's, which is what makes the documented release verify command reject one.
//
// A local build is single-architecture - see load_platform(). Stack `:amd64` or `:arm64`
// to cross-build through emulation (`magus run image-build:arm64`).
export fun image_build(ctx: magus\Context, args: [str]) > void !> any {
    final registries = publish_registries(ctx);
    var pushed = mut [<str>];
    if (ctx.hasCharm("cd")) {
        final ch = channel(ctx);
        if (ch == "commit") {
            foreach (r in publish_variant(ctx, "Dockerfile.static", "linux/amd64,linux/arm64",
                registries, [commit()], "commit-meta.json")) { pushed.append(r); }
        } else {
            // Only stable moves a floating tag: `latest` would hand an opted-into
            // prerelease to every consumer who never asked for it.
            var staticTags = [version()];
            var dynamicTags = [version() + "-dynamic"];
            if (ch == "stable") {
                staticTags = [version(), "latest"];
                dynamicTags = [version() + "-dynamic", "latest-dynamic"];
            }
            foreach (r in publish_variant(ctx, "Dockerfile.static", "linux/amd64,linux/arm64",
                registries, staticTags, "static-meta.json")) { pushed.append(r); }
            foreach (r in publish_variant(ctx, "Dockerfile", "linux/amd64",
                registries, dynamicTags, "dynamic-meta.json")) { pushed.append(r); }
        }
        write_image_summary(pushed);
    } else if (ctx.hasCharm("dynamic")) {
        load_variant(ctx, "Dockerfile");
    } else {
        // Static is the DEFAULT, so it gets no charm - a charm names a departure from
        // the usual, and the usual here is the image that runs anywhere. `dynamic` is
        // the departure, and it is named for what it is rather than for cgo, the
        // mechanism that produces it. Same word, same meaning, as the `_dynamic`
        // release asset and the `-dynamic` image tag.
        load_variant(ctx, "Dockerfile.static");
    }
}

// Which registries the active mode pushes to. image_build and image_registries both
// read it, so the build and the login step it depends on cannot disagree about
// which credentials a run needs.
//
// Going through channel() also means the workflow's `image-registries:cd,stable,verify`
// preflight rejects a bad version before QEMU, buildx and a multi-arch compile run.
fun publish_registries(ctx: magus\Context) > [Registry] !> any {
    if (!ctx.hasCharm("cd")) { return []; }
    if (channel(ctx) == "commit") { return [GHCR]; }
    return REGISTRIES;
}

// The active channel: "commit", "unstable", or "stable".
//
// Naming both channels is rejected up front by exclusive_charms rather than left to the
// assertions below, which would fail too but report the version rather than the mistake.
//
// `tagged` is the third answer: derive the channel from the release tag instead of naming
// it. It exists so cutting a release candidate is a tag and nothing else - the alternative
// was hand-editing `:cd,stable` to `:cd,unstable` in the workflow before every RC and back
// afterwards, an edit whose omission publishes a prerelease as `latest`. Deriving is safe
// in the direction that matters: it can only ever withhold a floating tag, never grant one
// a prerelease has not earned.
fun channel(ctx: magus\Context) > str !> any {
    exclusive_charms(ctx, "stable", "unstable", "WS1002", "which channel to publish to");
    final wantTagged = ctx.hasCharm("tagged");
    final wantStable = ctx.hasCharm("stable");
    final wantUnstable = ctx.hasCharm("unstable");
    if (wantTagged and (wantStable or wantUnstable)) {
        magus\raise("WS1002", message: "the `tagged` charm reads which channel to publish "
            + "to off the release tag, so naming `stable` or `unstable` beside it answers "
            + "that question twice - name one",
            opts: {"url": "https://eli.gladman.cc/magus/recommendations/#one-charm-answers-one-question"});
    }
    if (!wantStable and !wantUnstable and !wantTagged) { return "commit"; }

    final v = version();
    if (v == "unknown") {
        throw "image: a channel charm needs a version and this tree reports none - magus "
            + "reads it from `git describe`, so a shallow clone with no tags cannot supply "
            + "one. Fetch tags, or drop the charm to publish to the commit channel.";
    }
    if (wantTagged) {
        final tag = exact_release_tag();
        if (tag == "") {
            throw "image: `tagged` reads the channel off the release tag HEAD sits on, and "
                + "HEAD is not tagged - `" + v + "` describes distance past the nearest tag "
                + "rather than a release. Tag the release first, or name `stable`/`unstable`.";
        }
        if (semver\parse(tag).prerelease == "") { return "stable"; }
        return "unstable";
    }

    // describe() renders an untagged commit as v0.4.0-3-gabc123, whose prerelease
    // component is 3-gabc123. One field therefore answers both "is this a prerelease" and
    // "is this even a tagged build", and stable has to reject both.
    final pre = semver\parse(v).prerelease;
    if (wantStable and pre != "") {
        throw "image: `" + v + "` carries the prerelease `" + pre + "`, so it cannot go to "
            + "the stable channel - that is the channel `latest` follows. Use `unstable` "
            + "for it, or run this from a stable release tag.";
    }
    if (wantUnstable and pre == "") {
        throw "image: `" + v + "` is a stable version, so `unstable` would file it under a "
            + "channel it does not belong to. Use `stable` for it.";
    }
    if (wantStable) { return "stable"; }
    return "unstable";
}

// Narrows a registry list to one host, for the `magus run image-login:cd,stable docker.io`
// form. Selection is BY HOST, deliberately not by position: an index silently
// selects a different registry the moment REGISTRIES is reordered or the charm
// changes how many there are (`:cd` has one, `:cd,stable` has two, so "index 1" is a valid
// registry under one and out of range under the other), and it is unreadable in a
// workflow besides. A host that is not in the list is an error naming the ones that
// are, rather than a silent no-op.
fun select_registries(registries: [Registry], host: str) > [Registry] !> any {
    if (host == "") { return registries; }
    var hosts = "";
    foreach (reg in registries) {
        if (reg.host == host) { return [reg]; }
        if (hosts != "") { hosts = hosts + ", "; }
        hosts = hosts + reg.host;
    }
    throw "no registry \"{host}\" for these charms; this mode publishes to: {hosts}";
}

// Reports the registries `magus run image-build` under the SAME charms will push to,
// and whether the credentials each one needs are actually present in the environment.
// The diagnostic half of the pair image_login() completes: this one answers "where
// does this go and am I set up for it", touches nothing, and needs no credentials to
// be useful.
//
//     magus run image-registries:cd,stable       # both, for a release
//     magus run image-registries:cd              # GHCR only, for a per-commit image
//     magus run image-registries:cd,stable docker.io  # just that one
//     magus run image-registries:cd,stable,verify     # ...and FAIL if any are missing
//
// The `verify` charm turns the report into a gate. CI runs it that way as a preflight,
// so a missing secret fails on a named variable before checkout, QEMU, buildx and a
// multi-arch compile have burned runner time - and so the step's own log states the
// contract the workflow's env block is there to satisfy. Without the charm it only
// reports, which is what you want locally where a missing token is not an error yet.
//
// A bare `magus run image-registries` reports nothing to do: the local --load build
// pushes nowhere and needs no credentials.
export fun image_registries(ctx: magus\Context, args: [str]) > void !> any {
    var host = "";
    if (args.len() > 0) { host = args[0]; }
    final registries = select_registries(publish_registries(ctx), host);
    if (registries.len() == 0) {
        magus\log.info("image-registries: this build pushes nowhere; add the cd charm to see where a delivery goes (`:cd` per-commit, `:cd,stable` a release)");
        return;
    }
    // The CREDENTIALS column costs a provider round trip - and a prompt, on a provider
    // that has one - so it is only filled when `verify` asked for it. Without the charm
    // this target reads nothing and can never surprise anyone with an unlock dialog.
    final checking = ctx.hasCharm("verify");
    var table = pad("REGISTRY", 12) + pad("REPOSITORY", 28) + pad("USERNAME REF", 20) + pad("TOKEN REF", 20) + "CREDENTIALS";
    foreach (reg in registries) {
        var state = "not checked (add the verify charm)";
        if (checking) { state = credential_state(reg); }
        table = table + "\n" + pad(reg.host, 12) + pad(reg.repository, 28)
            + pad(reg.user_ref, 20) + pad(reg.token_ref, 20)
            + state;
    }
    // Lead line, then the table: magus\info prefixes only its FIRST line with a level
    // marker, which would otherwise shift the header out of line with its columns.
    magus\log.info("image-build under these charms publishes to:\n" + table);

    if (!checking) { return; }
    var unready = mut [<str>];
    foreach (reg in registries) {
        if (credential_state(reg) != "ready") { unready.append(reg.host); }
    }
    if (unready.len() > 0) {
        throw "image-registries: no usable credentials for " + unready.join(", ")
            + "; set the variables named above (in CI they come from repository secrets)";
    }
}

// Whether both of a registry's credentials can be resolved.
//
// ONLY called under the `verify` charm, and that gating is the point rather than a
// detail. Checking resolvability means actually RESOLVING, and resolving means asking
// the provider - which for 1Password or a vault is a biometric or password prompt. A
// status table that pops an unlock dialog just to print "ready" is the single most
// infuriating thing this feature could do, and it is exactly what an ungated probe
// would cause: `magus run image-registries` is a look-around command, not a request
// for credentials.
//
// So the plain report lists references without touching them, and `:verify` - a user
// explicitly asking "am I set up" - is the only path that resolves.
//
// try/catch rather than testing a return value, because a provider signals "not
// available" by THROWING: $VAR unset for the built-in, a locked vault or expired
// session for a spell. Presence is not testable without asking.
fun credential_state(reg: Registry) > str {
    var missing = mut [<str>];
    if (!resolvable(reg.user_ref)) { missing.append(reg.user_ref); }
    if (!resolvable(reg.token_ref)) { missing.append(reg.token_ref); }
    if (missing.len() == 0) { return "ready"; }
    return "missing " + missing.join(", ");
}

fun resolvable(ref: str) > bool {
    try {
        magus\secret.read(ref);
        return true;
    } catch (e) {
        return false;
    }
}

fun pad(s: str, width: int) > str !> any {
    var padded = s;
    while (padded.len() < width) { padded = padded + " "; }
    return padded + " ";
}

// Logs in to every registry the active mode publishes to, resolving each one's
// credentials through the workspace's secret provider.
//
//     magus run image-login:cd,stable           # both, before image-build:cd,stable
//     magus run image-login:cd                   # GHCR only
//     magus run image-login:cd,stable docker.io # just that one
//
// This is the whole reason the references are a field on Registry. A CI step is then
// one line with no shell parsing a list, the same line that works on a laptop, and it
// cannot disagree with `image-build` about which registries need credentials because
// both read publish_registries().
//
// TWO separate protections keep the token out of what magus persists, and neither one
// makes the other redundant:
//
//   - It reaches docker on STDIN, never argv. magus captures a command's arguments
//     into the run log and the output store, so `-p <token>` would write the secret to
//     both. opts.stdin is not captured.
//   - It was resolved through magus\secret.read, so magus recognizes the value and
//     redacts it from captured output. That covers what this file does not control:
//     docker itself, or any later tool, echoing the token back.
export fun image_login(ctx: magus\Context, args: [str]) > void !> any {
    var host = "";
    if (args.len() > 0) { host = args[0]; }
    final registries = select_registries(publish_registries(ctx), host);
    if (registries.len() == 0) {
        throw "image-login: these charms publish nowhere, so there is nothing to log in to - add the cd charm (`magus run image-login:cd`, or `:cd,stable` for a release)";
    }
    foreach (reg in registries) {
        final user = magus\secret.read(reg.user_ref);
        final token = magus\secret.read(reg.token_ref);
        proc\exec("docker", args: ["login", reg.host, "-u", user, "--password-stdin"],
            dir: ".", opts: {"stdin": token});
        magus\log.info("image-login: " + reg.host + " authenticated as " + user);
    }
}

// Scans the image with trivy; the rw charm writes SARIF and gates on HIGH/CRITICAL.
export fun image_scan(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(image_build);
    if (ctx.hasCharm("rw")) {
        fs\mkdirAll("dist");
        proc\exec("trivy", ["image",
            "--format", "sarif",
            "--output", fs\join("dist", "trivy.sarif"),
            "--severity", "HIGH,CRITICAL",
            "--exit-code", "1",
            image_tag()]);
    } else {
        proc\exec("trivy", ["image", image_tag()]);
    }
}

// Gates on dependency LICENSE terms, which is a separate question from image_scan's
// vulnerability pass even though both drive trivy. magus is GPL-3.0-or-later, so the
// failure worth catching is a dependency whose terms cannot be combined with that - and
// the moment to catch it is the pull request that adds it, not the release that ships it.
//
// Gates on trivy's CATEGORY, corrected for the fact that its categories assume a
// PROPRIETARY consumer. Out of the box trivy calls AGPL `forbidden` and GPL/LGPL
// `restricted`, which is right for someone shipping closed source and wrong here: magus is
// GPL-3.0-or-later, so copyleft is the ordinary case, not a finding. Left uncorrected this
// gate would fail on dependencies that are perfectly usable, and a gate that cries wolf
// gets switched off.
//
// So the compatible copyleft licenses are ignored explicitly and everything else at
// HIGH/CRITICAL still fails. That direction matters: an unrecognized copyleft license is
// NOT on the ignore list, so it fails loudly and someone looks at it. A denylist of
// known-bad licenses would do the opposite and stay silent on anything unanticipated.
//
// What is deliberately NOT ignored, because it is genuinely incompatible with GPL-3.0:
// GPL-2.0-ONLY (no "or later" - it cannot be upgraded to v3), CDDL, EPL, MPL-1.1, and
// BSD-4-Clause with its advertising clause. GPL-2.0-or-later IS fine, since it permits
// the upgrade. --severity HIGH,CRITICAL mirrors image_scan's threshold.
//
// The whole tree is scanned, npm subtrees included. That is not duplicated effort: the
// per-project `security` targets in console/ and docs/ run pnpm's ADVISORY audit,
// which says nothing about licensing.
//
// The baseline when this landed was 265 findings, all `notice` or `unencumbered` and none
// forbidden or restricted, so this gate starts green and only speaks up on a regression.
export fun security(ctx: magus\Context, args: [str]) > void !> any {
    // govulncheck loads PACKAGES, so it parses every .go file this target's sources
    // glob - generated ones included. Without this edge it is free to run beside the
    // target writing them: measured 2026-08-18, when it read types/gen/mocks while
    // mockery was still emitting it and failed with "expected 'package', found 'EOF'"
    // - a parse error that reads like a broken tree rather than a race.
    //
    // lint, build and test already reach generate (via format), so security was the
    // one member of ci's fan-out without the ordering its siblings have. MGS4004 does
    // not cover this: it reports CROSS-project undeclared reads, and both targets here
    // are in the same project.
    ctx.needs(generate);
    // Both halves of Software Composition Analysis over one dependency inventory:
    // govulncheck asks whether a dependency has a known flaw, trivy whether its terms may
    // legally be here at all. They share this target because they share that input and a
    // cache contract - each reads data that lives outside the tree, so neither is cacheable
    // against sources. govulncheck sat in `lint` for a while, which spread that uncacheable
    // answer across every op lint runs. GOEXPERIMENT is threaded through so the sandboxed
    // child builds with the same fingerprint as the rest of the workspace.
    go["govulncheck"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}));
    proc\exec("trivy", ["fs", "--scanners", "license",
        "--severity", "HIGH,CRITICAL",
        "--ignored-licenses", "AGPL-3.0,AGPL-3.0-only,AGPL-3.0-or-later,"
            + "GPL-3.0,GPL-3.0-only,GPL-3.0-or-later,GPL-2.0-or-later,"
            + "LGPL-2.1,LGPL-2.1-only,LGPL-2.1-or-later,"
            + "LGPL-3.0,LGPL-3.0-only,LGPL-3.0-or-later",
        "--exit-code", "1",
        "."], ".", {});
}

// Renders the roff man pages into manpage/ (repo root). These are a DISTRIBUTION
// artifact - the .1 source the `man` command reads, shipped with releases - so they
// stay owned here at the root, NOT in the docs project. The docs project owns the
// Markdown manpages (docs/manpage/*.md) instead; both flavors are serialized from the
// same internal/cli registry by cmd/magus-manpage (see its -format flag).
//
// It also refreshes api.lock, the drift-gated snapshot of the public CLI surface,
// because that is serialized from the SAME registry - the two can only disagree if
// one is regenerated without the other. It had no producing target at all before,
// so TestAPIUpToDate's remedy was a raw `go generate` that `magus run generate`
// never performed.
export fun man_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("manpage/*.1", "internal/cli/testdata/api.lock");
    fs\mkdirAll("manpage");
    proc\exec("go", ["run", "./cmd/magus-manpage", "-format", "roff", "-out", "manpage"]);
    proc\exec("go", ["generate", "./internal/cli/..."]);
}

// CHANGELOG.md is a root artifact. Keeping its generator beside the file avoids a
// reverse docs -> root output edge while letting docs publication depend on the same
// execution stage.
export fun changelog_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("releases/*.yaml", "cmd/magus-utils/**/*.go", "internal/**/*.go",
        "go.mod", "go.sum", "go.work", "go.work.sum");
    ctx.modifiesExistingFiles("CHANGELOG.md");
    proc\exec("go", ["run", "./cmd/magus-utils", "generate-changelog",
        "-releases", "./releases", "-changelog", "./CHANGELOG.md"]);
}

// Regenerates the runtime BuzzObject maps before anything imports a host binding.
// Its reflection lives only in magus-utils while writing this Go file; the emitted
// methods use direct field access, so Magus never reflects at a Buzz boundary.
// The enum helpers (Values/Valid/String for each boundaryEnum) come from a SECOND
// directive, and it lives in cmd/magus-utils rather than in types/, so
// `go generate ./types` never ran it. Adding a boundaryEnums entry therefore left
// types/enum_gen.go and spells/enum_gen.go stale with nothing to say so - found
// when PlatformStyle was added and its Valid() simply was not there.
export fun types_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("types/buzzobject_gen.go", "types/enum_gen.go", "spells/enum_gen.go");
    proc\exec("go", ["generate", "./types"]);
    proc\exec("go", ["generate", "./cmd/magus-utils"]);
}

// Regenerates the Go host bindings (std -> internal/interp/bindings/gen) from std.Module declarations.
export fun bindings_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(types_generate);
    ctx.writesFiles("internal/interp/bindings/gen/*.go");
    proc\exec("go", ["generate", "./std/..."]);
}

// Regenerates the magusfile API surface lock: every member a magusfile can call on the
// magus namespace, one dotted name per line. Named for the magusfile surface rather
// than "api" alone, because two other things in this repo are also an API surface -
// internal/cli/testdata/api.lock is the CLI's, and cmd/magus/surface.go drives
// completions.
//
// The regeneration route is a TEST, not a generator, which is why this target exists:
// the snapshot is written by TestMagusSurfaceLocked under UPDATE_MAGUS_API_LOCK, so
// without a target naming it the lock was a drift-gated artifact no project claimed -
// it keyed nothing, joined no affected set, and `magus describe file` called it
// unclaimed. Its CLI sibling is claimed only because man_generate happens to list it.
//
// -count=1 is load-bearing: go caches a passing test, and a replayed pass writes no file.
//
// GOEXPERIMENT matches the test target so both share one build fingerprint instead of
// splitting the cache. The explicit args replace go-test's `./...` default
// (spells/golang/spell.buzz), so this compiles one package's test binary, not the
// module's.
export fun magusfile_api_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(bindings_generate);
    ctx.writesFiles("internal/interp/bindings/testdata/magus-api.lock");
    go["go-test"](ctx.withEnv({"UPDATE_MAGUS_API_LOCK": "1", "GOEXPERIMENT": "jsonv2"}),
        {"args": ["-count=1", "-run", "TestMagusSurfaceLocked",
            "./internal/interp/bindings/"]});
}

// Regenerates the host-module snapshot the browser playground's completion and hover
// read (internal/langservice/manifest_data.go), from the same std declarations
// bindings_generate reads.
//
// It has a target at all because it did not: the file carried a "regenerate with `go
// run`" header and nothing else, so a std descriptor edit left it stale with only its
// own drift test to say so, one commit later. A generated file whose only regeneration
// route is a hand-typed command is a file that rots.
export fun langservice_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("internal/langservice/manifest_data.go");
    proc\exec("go", ["generate", "./internal/langservice"]);
}

// Regenerates the compiled built-in spell bytecode (internal/spellruntime/gen),
// the Buzz value-type mirrors (internal/spellruntime/gen/types) and the per-module
// host declarations (internal/spellruntime/gen/decls), all driven by the
// go:generate directives in internal/spellruntime.
//
// Both trees are declared: undeclared, magus classified them as ordinary source,
// so `magus describe file` told a reader a generated file was safe to hand-edit
// and the agent guard's generated-file advisory stayed silent on every one of them.
export fun spells_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(types_generate);
    ctx.writesFiles("internal/spellruntime/gen/*.bo", "internal/spellruntime/gen/types/*.buzz",
                    "internal/spellruntime/gen/decls/*.buzz");
    proc\exec("go", ["generate", "./internal/spellruntime/..."]);
}

// Regenerates the testify mocks (mockery, driven by .mockery.yaml) into each mocked
// interface's gen/ subdir. Mocks are committed and drift-gated like every other
// generated tree; mockery is pinned in the go.mod tool block.
export fun mocks_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(types_generate);
    ctx.writesFiles("**/gen/mocks/*.go");
    proc\exec("go", ["tool", "mockery"]);
    // mockery's testify template emits no `var _ Iface = (*Mock)(nil)`, so a mock that
    // went stale still compiles and fails only at a use site - which, for mocks published
    // to downstream consumers, is somebody else's build. This writes those assertions
    // into each mocks package from the same .mockery.yaml that listed the interfaces.
    proc\exec("go", ["run", "./cmd/magus-utils", "mockassert"]);
}

// Reinstalls the agent skills from their embedded sources in internal/agent/skills.
//
// The installed copies are GENERATED, and declaring them says so: without this
// they classified as ordinary source, so `magus describe file .claude/skills/...`
// reported a hand-editable file and the agent guard stayed silent on the one edit
// that is always wrong. CLAUDE.md has said "edit the sources, not the installed
// copies" all along; this is the declaration that makes the tooling say it too.
//
// AGENTS.md is absent here because magus does not write that file at all. It is
// hand-authored prose, the magus block inside it is pasted by a human from
// `magus agent sample --section`, and `magus doctor` grades that block's
// stamp without touching it. An install call here would rewrite the block on
// every generate, making AGENTS.md a hybrid file at odds with the Markdown
// formatter.
// The globs name the SHIPPED skills rather than the whole directory, and that
// distinction is the point. `.claude/skills/**` also claimed the two skills magus
// does NOT write - magus-skill-authoring and magus-local-development, both
// hand-authored and tracked by explicit .gitignore negations - so describe file
// called them generated and the path guard warned an author off the one file
// CLAUDE.md tells them to edit. install writes only the names it ships, and
// --prune leaves a hand-authored skill alone, so the declaration should say the
// same.
//
// Enumerated, not computed: the static read collects string LITERALS only, and a
// pattern built at run time - from a loop, or even from string interpolation - is
// invisible to it, flagged as a computed footprint argument rather than silently
// accepted. So the name list is written out per destination, and
// TestSkillsGenerateDeclaresEveryShippedSkill keeps it in step with
// internal/agent/skills: adding a skill without touching this fails there rather than
// shipping an installed file magus calls hand-editable.
//
// One pattern per skill per destination, rather than one brace alternation per
// destination, because these globs do not stay inside magus: EnsureMergeDriver
// writes them into .gitattributes, and git's pattern syntax has no brace
// expansion. A `{a,b}` list is a valid doublestar glob and a DEAD .gitattributes
// line - the merge driver would quietly stop covering every installed skill,
// which is the failure this declaration exists to prevent. (Buzz also reads a
// bare {...} in a string as interpolation, so the braces needed escaping just to
// survive the parser. Two reasons, same conclusion.)
//
// The trailing `*` before /** covers each skill's always-full <name>-full twin,
// which an install writes beside the primary.
export fun skills_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles(
        ".claude/skills/magus-architecture-review*/**",
        ".claude/skills/magus-buzz-review*/**",
        ".claude/skills/magus-buzz-write*/**",
        ".claude/skills/magus-commit-composition*/**",
        ".claude/skills/magus-change-summary*/**",
        ".claude/skills/magus-context-audit*/**",
        ".claude/skills/magus-docs-lookup*/**",
        ".claude/skills/magus-handoff-journal*/**",
        ".claude/skills/magus-multi-agent*/**",
        ".claude/skills/magus-query*/**",
        ".claude/skills/magus-run*/**",
        ".claude/skills/magus-sdk*/**",
        ".claude/skills/magus-vcs-hygiene*/**",
        ".claude/skills/magus-workspace-rules*/**",
        ".agents/skills/magus-architecture-review*/**",
        ".agents/skills/magus-buzz-review*/**",
        ".agents/skills/magus-buzz-write*/**",
        ".agents/skills/magus-commit-composition*/**",
        ".agents/skills/magus-change-summary*/**",
        ".agents/skills/magus-context-audit*/**",
        ".agents/skills/magus-docs-lookup*/**",
        ".agents/skills/magus-handoff-journal*/**",
        ".agents/skills/magus-multi-agent*/**",
        ".agents/skills/magus-query*/**",
        ".agents/skills/magus-run*/**",
        ".agents/skills/magus-sdk*/**",
        ".agents/skills/magus-vcs-hygiene*/**",
        ".agents/skills/magus-workspace-rules*/**",
        ".opencode/skills/magus-architecture-review*/**",
        ".opencode/skills/magus-buzz-review*/**",
        ".opencode/skills/magus-buzz-write*/**",
        ".opencode/skills/magus-commit-composition*/**",
        ".opencode/skills/magus-change-summary*/**",
        ".opencode/skills/magus-context-audit*/**",
        ".opencode/skills/magus-docs-lookup*/**",
        ".opencode/skills/magus-handoff-journal*/**",
        ".opencode/skills/magus-multi-agent*/**",
        ".opencode/skills/magus-query*/**",
        ".opencode/skills/magus-run*/**",
        ".opencode/skills/magus-sdk*/**",
        ".opencode/skills/magus-vcs-hygiene*/**",
        ".opencode/skills/magus-workspace-rules*/**");
    magus\cmd("agent", args: ["install", ".claude/skills", "--force"], opts: {"quiet": true});
    magus\cmd("agent", args: ["install", ".agents/skills", "--force"], opts: {"quiet": true});
    magus\cmd("agent", args: ["install", ".opencode/skills", "--force"], opts: {"quiet": true});
}

// Regenerates the CLI config-flag plumbing from internal/config/config.go. One
// generator invocation, four trees: the flag/bind plumbing beside the CLI, the
// schema field list, and the env applier next to config itself. All four are
// declared - undeclared they classified as ordinary source, so magus told a
// reader they were safe to hand-edit.
export fun config_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(types_generate);
    ctx.writesFiles("cmd/magus/gen/*.go", "schema/gen/*.go", "internal/config/gen/*.go",
                "cmd/magus/completions/*");
    proc\exec("go", ["generate", "./cmd/magus/..."]);
}

// The committed docs Markdown (Buzz module reference, spell docs, Markdown manpages)
// is generated by the DOCS project now, not here: it is docs-site content, so the docs
// project owns generating and drift-gating it (see docs/magusfile.buzz's
// content-generate target). This root magusfile only owns the roff manpages
// (man-generate above), which are a distribution artifact rather than site content.

// Renders MAGUS.md via `magus describe graph`.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("MAGUS.md");
    final doc = magus\describe(["graph", "-o", "markdown"], {"quiet": true}).stdout;
    fs\writeFile("MAGUS.md", doc + "\n");
}

// Exports both graphs the browser Graph Explorer can load, so its demo is this
// workspace's real graph rather than a fixture that would drift from the wire shape the
// adapter expects. Written into gen/ because they are generated, not authored: the
// knowledge graph previously sat at docs/graph.json as a hand-run export with no
// generating target at all, which made it stale by construction with nothing to say so.
// Whole-workspace scope is why this lives at the root rather than in docs/ - a describe
// from inside a project only sees that project.
export fun graph_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("gen/*.json");
    fs\mkdirAll("gen");
    // The knowledge graph (nodes/links). No dedicated binding for `graph export`, so
    // magus.cmd is the documented escape hatch.
    final knowledge = magus\cmd("graph", args: ["export", "--reproducible", "-o", "json"], opts: {"quiet": true}).stdout;
    fs\writeFile(fs\join("gen", "knowledge-graph.json"), knowledge);
    // The target graph ({definition, projects}), the same bytes as
    // `magus describe graph -o json`, which is what the explorer's target adapter reads.
    final targets = magus\describe(["graph", "-o", "json"], {"quiet": true}).stdout;
    fs\writeFile(fs\join("gen", "target-graph.json"), targets);
}

// Renders the insight report (hotspots, affinity, ownership, trend) to stdout. Local
// only: no workflow invokes this target, and ci-outcome.buzz's volatility-lens step
// summary is the CI-facing equivalent.
export fun postflight(ctx: magus\Context, args: [str]) > void !> any {
    // A summary built from the typed report rather than the whole Markdown document:
    // this target only ever logged that document locally, so the counts are what a
    // reader was actually skimming for. Both come from the workspace magus already
    // has open, rather than by shelling a subcommand back into itself; the full
    // rendering lives in the console and the MCP tool, which read the same values.
    final r = magus\insight({});
    magus\log.info("hotspots: {r.hotspots.files.len()} file(s) ranked by churn against complexity");
    magus\log.info("ownership: {r.ownership.projects.len()} project(s) attributed");
    magus\log.info("affinity: {r.affinity.pairs.len()} coupled project pair(s)");
    magus\log.info("volatility: {r.volatility.targets.len()} target(s) with recorded run history");
}

// Regenerates every *-generate sibling, then gates on drift (exclusive, scoped to cwd).
// Drift = a path whose bytes the generators changed, measured by hashing before and
// after rather than by asking whether the tree is clean, so the gate works on a dirty
// tree. An uncommitted-but-current generated file still passes: its bytes do not move.
//
// This is NOT the engine's drift gate repeated. The engine hashes each target's DECLARED
// outputs, which is the right scope for attributing staleness to a change. This one is
// whole-tree, and that is the point: it composes every *-generate sibling, so it is what
// catches a generator writing a path nobody declared - which no check keyed on declarations
// can see, because the declaration is the thing that is missing.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    // Hash every already-dirty path BEFORE the generators run. Requiring a clean tree
    // instead would disarm the gate at exactly the moment it is reached: the documented
    // pre-push check runs with uncommitted work in the tree, so it would print "skipped"
    // and exit 0 - a check that cannot fail, which is how drift reaches CI after a
    // local run says it will not. Comparing before against after asks the question that
    // actually matters (did the generators change anything?) and an unrelated edit no
    // longer hides the answer.
    var dirtyBefore: mut [str] = mut [<str>];
    foreach (f in vcs\status().files) { dirtyBefore.append(f.value); }
    final before = drift\hashes(dirtyBefore);
    gomod\replaceWorkspaceModules(ctx, go, ".");
    ctx.needs(ctx.glob("*-generate", "!deploy-generate"));
    if (ctx.hasCharm("rw")) { return; }

    // Drift is a path the generators moved: one that was clean and is now dirty, or one
    // that was already dirty and whose bytes changed during the run. status() is
    // whole-tree, which is deliberate - this target composes every *-generate sibling, so
    // it also covers a generator writing a path nobody declared. Not diagnoseDrift: that
    // classifies against ONE target's declared outputs and inputs, and with none to
    // compare it always lands on the dev-build verdict.
    var dirtyNow: mut [str] = mut [<str>];
    foreach (f in vcs\status().files) { dirtyNow.append(f.value); }
    final changed = drift\changedSince(before, dirtyNow);
    if (changed.len() > 0) {
        final detail = ": " + changed.join(", ");
        // Print the diff, not just the names. This gate fires where its reader has a
        // CI log instead of the tree, and the console keeps only "likely diagnostics"
        // from a tool's own stdout - so the diff is CAPTURED and printed by the
        // magusfile, which is what actually survives into the log. A name alone was
        // not enough twice running: the drift that sent us here turned out to be a
        // daemon auth token captured into a docs example, invisible from a filename.
        var body = vcs\dirtyDiff(changed);
        // gen/knowledge-graph.json is 2.2MB on one line; bound it so a generated
        // JSON cannot bury a small, readable drift somewhere else in the list.
        if (body.len() > 4000) {
            body = body.sub(0, len: 4000)
                + "\n... truncated; `magus query output <ref>` has it all";
        }
        if (body != "") {
            magus\log.info("generate: what changed on this runner:\n" + body);
        }
        // Two causes land here and they have different owners: output that was never
        // regenerated, and a generator that does not emit the same bytes twice. Only a
        // second regeneration separates them, which is what --race=replay does, so the
        // message routes there rather than reimplementing it (and a nested `generate`
        // would contend for this target's own exclusive lock).
        throw "generate: regeneration changed generated files; re-run "
            + "`magus run generate:rw .` and commit" + detail + drift\secondCause;
    }
}

// Re-records tapes/core-loop.capture: the raw bytes a real magus prints to a real
// pseudo-terminal, driven by tapes/core-loop.session.sh.
//
// Opt-in and NOT named *_generate: `generate` globs that suffix and drift-gates
// what it finds, and a session is not byte-reproducible, so the gate would be red
// by construction. The unreproducibility stops at the bytes, though - RENDERING
// them is arithmetic, which is what termcast_generate gates instead.
//
// Run it when magus's output changes, commit the capture, and let the render
// follow in the same commit.
export fun termcast_record(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("tapes/core-loop.session.sh", "tapes/demo-init.sh",
        "tapes/demo.txtar", "cmd/magus-termcast/*.go");
    // The one capture this writes, not the glob over both: termcast_showcase owns
    // the other, and two targets declaring one glob is MGS1020.
    ctx.writesFiles("tapes/core-loop.capture");
    proc\exec("go", ["run", "./cmd/magus-termcast", "-record"]);
}

// Re-records tapes/showcase.capture: a real INTERACTIVE session, driven by real
// keystrokes, showing the surfaces a transcript cannot - the pinned band, the
// failure tree beside its captured output, the picker searching the graph.
//
// Opt-in and not named *_generate, for the reason termcast_record is not: it
// runs a live session and no two runs agree byte for byte. Rendering the result
// is deterministic and is gated with the rest.
export fun termcast_showcase(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("tapes/demo.txtar", "cmd/magus-termcast/*.go");
    // Named, not globbed, for the reason termcast_record is.
    ctx.writesFiles("tapes/showcase.capture");
    proc\exec("go", ["run", "./cmd/magus-termcast", "-showcase"]);
}

// Renders tapes/core-loop.capture into the README's animated SVG.
//
// Deterministic - it replays committed bytes through the terminal emulator and
// emits text - so it can be drift-gated, and is. That gate is the point: a
// recording nothing checks goes stale in silence, until the README's alt text is
// describing a project count magus no longer reports.
export fun termcast_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("tapes/*.capture", "cmd/magus-termcast/*.go",
        "internal/interactive/screen/*.go");
    // Globbed, the way termshots_generate declares its shots: each picture ships
    // in both palettes, and naming only the dark half let a cache hit restore a
    // half-written assets/gen.
    ctx.writesFiles("assets/gen/core-loop*.svg", "assets/gen/showcase*.svg");
    proc\exec("go", ["run", "./cmd/magus-termcast"]);
}

// Renders the still SVGs of magus's interactive terminal surfaces for the docs.
//
// Recorded nothing: these are CONDITIONS - a run stalled on another process's
// lock, a failed target awaiting a choice - and staging those in a live shell
// reliably enough to record is painful. The frames come from driving the real
// Zone, Notifier and picker through the terminal emulator, so the layout is what
// a terminal would receive even though the scenario is staged.
export fun termshots_generate(ctx: magus\Context, args: [str]) > void !> any {
    // internal/cache too: the shots drive the REAL PrettyHandler, so its band
    // is an input to the picture. Left undeclared, an edit to the band replays
    // a cached SVG of the stale band.
    ctx.readsFiles("cmd/magus-termshots/*.go", "internal/interactive/**/*.go",
        "internal/cache/*.go");
    ctx.writesFiles("assets/gen/terminal-*.svg");
    proc\exec("go", ["run", "./cmd/magus-termshots"]);
}

// The two patterns release.yaml and this file both have to agree on, stated here and
// checked against the workflow by verify_release_workflow rather than parsed out of it.
//
// Parsing is worse in both directions: the globs live in five `path:` block scalars plus a
// `tags:` sequence, so reading them means a YAML walk that can itself be wrong, and it
// would make the workflow the source of truth for a rule the preflight applies on a laptop
// before any workflow exists. A constant plus a containment check names whichever side
// moves.
//
// RELEASE_ASSET_GLOB is what actions/upload-artifact collects out of dist/ and what the
// publish job re-expands into the `gh release` argument list. An asset written outside it
// does not exist as far as a release is concerned, which is what v0.4.0 shipped.
final RELEASE_ASSET_GLOB = "dist/magus_*.tar.gz";

// RELEASE_TAG_REFSPEC is the `on.push.tags` filter. GitHub's ref filter is the same
// single-star glob matchesGlob models, with "*" stopping at "/", which is why pushing
// libs/gopherbuzz/v0.2.0 publishes nothing and pushing v0.4.0 publishes everything.
final RELEASE_TAG_REFSPEC = "v*";

final RELEASE_WORKFLOW = ".github/workflows/release.yaml";

// The one place a release asset name is spelled. build_release_variant writes it and the
// preflight predicts it, so a change to the scheme cannot reach a tag while only one of
// them knows.
fun release_asset_name(v: str, goos: str, goarch: str, suffix: str) > str {
    return "magus_" + v + "_" + goos + "_" + goarch + suffix + ".tar.gz";
}

// The `immutable` charm makes release writes write-once: an existing archive, sidecar, or
// signature refuses instead of being replaced. The rule is releaser\overwriteRefusal;
// this binds it to the filesystem and the charm.
fun refuse_overwrite(ctx: magus\Context, path: str) > void !> any {
    final msg = releaser\overwriteRefusal(path,
        immutable: ctx.hasCharm("immutable"), exists: fs\exists(path));
    if (msg != "") { throw msg; }
}

// Builds one (goos, goarch) release binary and archives it into dist/, writing a
// standard one-line <asset>.sha256 sidecar alongside it (sha256sum-compatible format).
// No cross-job aggregation needed: CD's publish job later does
// `cat dist/*.sha256 > dist/SHA256SUMS`, a plain shell one-liner, not a magus target.
// release-build's cgo and static (charm) modes both call this, differing only in
// CGO_ENABLED and the asset suffix.
// Maps an ASSET architecture token to the GOARM level it implies, or "" for the arches
// that carry no variant. The two 32-bit ARM builds ship as separate assets because
// neither serves the other's hardware: an ARMv7 binary traps on ARMv6, and the ARMv6
// build is limited to VFPv1 where v7 silicon offers VFPv3 (both are hardware float -
// softfloat would be GOARM=5, which is not built). GOARCH stays "arm" for both; only
// GOARM and the asset name differ. Go records GOARM in the binary's build info, which is
// how `magus self update` picks the matching asset back out (see cmd/magus/selfupdate.go).
// 32-bit ARM is a LINUX-ONLY asset here, and refused elsewhere rather than left merely
// uninvoked. Go can target windows/arm, so without this the fold below would cheerfully
// build `windows armv7` and name an archive after a platform nothing tests and no
// download page lists; darwin has no 32-bit ARM port at all and would fail further in,
// with a message about the toolchain instead of about the request. The workflow only ever
// passes `linux`, so this guards the hand-run form - which is exactly where a typo goes
// unnoticed.
fun goarm_level(goos: str, goarch: str) > str {
    if (goarch != "armv6" and goarch != "armv7") { return ""; }
    if (goos != "linux") {
        throw "release-build: " + goarch + " is a linux-only asset, so `" + goos + " "
            + goarch + "` is not a platform this project ships - use `linux " + goarch + "`.";
    }
    if (goarch == "armv6") { return "6"; }
    return "7";
}

// Writes THIRD-PARTY-NOTICES beside the staged binary, reading the module list OUT OF THAT
// BINARY rather than out of go.mod.
//
// That distinction is the whole point. The two variants link different modules - the dynamic
// build carries ebitengine/purego for FFI, the static build carries ulikunitz/xz for pure-Go
// compression, and no shipped artifact contains both. A notices file resolved from go.mod
// would name modules that are not in the archive it sits in, which is the precise inaccuracy
// this file exists to prevent.
//
// `go version -m` is the reader: Go embeds the module table in every binary and prints it
// without executing anything, so this works on a cross-compiled artifact too. The license
// TEXTS come from the module cache, where the module zips already put them - no classifier,
// no network, no extra tool to pin.
fun write_notices(stage: str, binary: str) > void !> any {
    final modcache = proc\exec("go", ["env", "GOMODCACHE"], ".", {}).stdout.split(separator: "\n")[0];
    final listing = proc\exec("go", ["version", "-m", fs\join(stage, binary)], ".", {}).stdout;

    var body = "THIRD-PARTY NOTICES\n\n"
        + "magus is licensed under the terms in the accompanying LICENSE file. It links the\n"
        + "modules below, each under its own terms, reproduced here in full. This list is read\n"
        + "from the shipped binary, so it describes THIS artifact rather than the module graph\n"
        + "in general.\n\n";
    var missing = mut [<str>];
    var count = 0;

    foreach (line in listing.split(separator: "\n")) {
        final f = line.split(separator: "\t");
        // Every dep row is "\tdep\t<path>\t<version>\t<hash>", so index 1 is the marker.
        if (f.len() < 4) { continue; }
        if (f[1] != "dep") { continue; }
        // First-party modules are covered by the LICENSE next to this file. They are local
        // replaces, so they also carry no cache entry to read a license from.
        if (f[2].startsWith("github.com/egladman/magus")) { continue; }

        final text = read_module_license(modcache, f[2], f[3]);
        if (text == "") { missing.append(f[2] + "@" + f[3]); continue; }
        body = body + "==============================================================================\n"
            + f[2] + " " + f[3] + "\n"
            + "==============================================================================\n\n"
            + text + "\n\n";
        count = count + 1;
    }

    // A dependency whose license cannot be found is a REPORTED failure, never a silent
    // omission. A notices document that quietly drops an entry is worse than none, because it
    // reads as complete to anyone auditing it.
    if (missing.len() > 0) {
        throw "release-build: no license found for " + "{missing.len()}"
            + " module(s), refusing to write an incomplete THIRD-PARTY-NOTICES: "
            + missing.join(separator: ", ");
    }
    fs\writeFile(fs\join(stage, "THIRD-PARTY-NOTICES"), body);
    magus\log.info("notices: documented {count} third-party modules");
}

// Reads one module's license text from the module cache, or "" when none is present.
fun read_module_license(modcache: str, path: str, version: str) > str !> any {
    final dir = fs\join(modcache, escape_module_path(path) + "@" + version);
    foreach (name in ["LICENSE", "LICENSE.md", "LICENSE.txt", "LICENSE", "LICENSE.txt",
                      "COPYING", "COPYING.md", "COPYING.txt"]) {
        final p = fs\join(dir, name);
        if (fs\exists(p)) { return fs\readFile(p); }
    }
    return "";
}

// Applies the module cache's case encoding: an uppercase letter becomes "!" plus its
// lowercase form, so github.com/Masterminds/sprig is stored at github.com/!masterminds/sprig.
// Without this every capitalized module path looks unlicensed - a false "missing license"
// that would abort a release for no reason.
fun escape_module_path(path: str) > str {
    var escaped = "";
    var i = 0;
    while (i < path.len()) {
        final ch = path.sub(i, len: 1);
        final lower = ch.lower();
        if (lower != ch) { escaped = escaped + "!" + lower; } else { escaped = escaped + ch; }
        i = i + 1;
    }
    return escaped;
}

fun build_release_variant(ctx: magus\Context, goos: str, goarch: str, cgo: bool, suffix: str) > void !> any {
    // Resolved BEFORE anything is written: goarm_level rejects a platform this project
    // does not ship, and a rejected request should leave no trace. Creating the staging
    // directory first left an empty dist/windows-armv7 behind on every refusal, which
    // reads like a half-finished build rather than a request that never started.
    // armv6/armv7 are asset names, not GOARCHes: fold them back to GOARCH=arm + GOARM.
    final goarm = goarm_level(goos, goarch);

    final v = version();
    final name = release_asset_name(v, goos, goarch, suffix);
    final asset = fs\join("dist", name);
    // Before the first write, beside goarm_level: a request that cannot produce a usable
    // asset should leave no trace and pay for no cross-compile.
    //
    // Against the UPLOAD GLOB rather than fs\basename. A version carrying a "/" turns the
    // asset NAME into a PATH, so fs\join writes
    // dist/magus_libs/diagnostics/v0.1.0_linux_amd64_static.tar.gz and the build is green
    // while dist/magus_*.tar.gz matches nothing, a glob star not crossing a separator. That
    // shipped as v0.4.0. The glob also catches what a basename check cannot, a rename of the
    // `magus_` prefix or `.tar.gz` suffix on one side alone.
    //
    // Compared through toSlash: the glob is the uploader's vocabulary and fs\join is the
    // runner's, and upload-artifact normalizes separators before matching.
    //
    // Nothing re-checks the written files after the upload step, because there is nothing
    // left to find: every name in a job shares one version, so the glob selects all of them
    // or none, and release_preflight pins RELEASE_ASSET_GLOB to the workflow's own text
    // before the tag exists.
    if (!releaser\matchesGlob(RELEASE_ASSET_GLOB, releaser\toSlash(asset))) {
        throw "release-build: the asset would be `" + asset + "`, which `"
            + RELEASE_ASSET_GLOB + "` does not match, so the release upload would not find "
            + "it. Version `" + v + "` is what names it; check that HEAD's root release tag "
            + "resolves.";
    }

    // Before the compile, so an immutable re-run refuses in milliseconds, not after a build.
    refuse_overwrite(ctx, asset);
    refuse_overwrite(ctx, asset + ".sha256");

    fs\mkdirAll("dist");
    var binary = "magus";
    if (goos == "windows") { binary = "magus.exe"; }

    final stage = fs\join("dist", goos + "-" + goarch + suffix);
    fs\mkdirAll(stage);

    var env = mut {"GOOS": goos, "GOARCH": goarch, "GOEXPERIMENT": "jsonv2"};
    if (goarm != "") { env["GOARCH"] = "arm"; env["GOARM"] = goarm; }
    if (cgo) {
        env["CGO_ENABLED"] = "1";
        // CC/PKG_CONFIG_PATH are set by the CD workflow only where the native toolchain
        // isn't already on the default search path (currently just windows/MSYS2);
        // empty on Linux/macOS, where apt/brew already put libzstd.pc/liblzma.pc where
        // pkg-config looks by default.
        final cc = os\env("MAGUS_CGO_CC");
        if (cc != null and cc != "") { env["CC"] = cc; }
        // PKG_CONFIG pins the exact pkg-config binary cgo runs, so it can never fall
        // back to a broken one earlier on PATH (Strawberry Perl's on the Windows runner).
        final pkgbin = os\env("MAGUS_CGO_PKG_CONFIG");
        if (pkgbin != null and pkgbin != "") { env["PKG_CONFIG"] = pkgbin; }
        final pkgcfg = os\env("MAGUS_CGO_PKG_CONFIG_PATH");
        if (pkgcfg != null and pkgcfg != "") { env["PKG_CONFIG_PATH"] = pkgcfg; }
    } else {
        env["CGO_ENABLED"] = "0";
    }

    // The -static archives have to drop Buzz FFI, or the name is a lie. Its provider reaches
    // dlopen through purego's //go:cgo_import_dynamic, which gives the binary a PT_INTERP and
    // a libc dependency even under CGO_ENABLED=0 - so the archive we ship as "static" needed a
    // dynamic loader, and would not run on a musl or scratch host. zdef() reports FFI
    // unsupported in that build; the default (cgo) archives keep it. Same reasoning and the
    // same tag as Dockerfile.static.
    // The native codec tags are OPT-IN, one per system library, and only the dynamic
    // release asset opts in. They are named for the exact pkg-config module each file
    // requires - `liblzma` for xz_cgo.go, `libzstd` for zstd_cgo.go - and deliberately NOT
    // for the charm that happens to set them. A build tag describes what a FILE links, so
    // it stays meaningful to anyone running `go build` directly, and keeping them separate
    // means a host with only one of the two libraries can still take that one fast path.
    // internal/compress's
    // cgo path declares `#cgo pkg-config: liblzma` and `libzstd`, and CGO_ENABLED defaults
    // to 1 wherever a C compiler exists - so gating that path on `cgo` alone made
    // `go install github.com/egladman/magus/cmd/magus@latest` fail on any machine without
    // those DEV HEADERS, which is most of them. It never showed up here because this
    // workspace has both installed. The pure-Go fallback (klauspost/compress, ulikunitz/xz)
    // is a real implementation, so the default build loses speed, not capability, and the
    // CD runners that build this variant apt-get the headers explicitly.
    //
    // Note the two tags have OPPOSITE polarity, which is forced rather than arbitrary: a
    // build with NO tags is what `go install` produces, so it has to be the configuration
    // that works anywhere. FFI is pure Go and safe on by default, so static OPTS OUT with
    // `noffi` (purego's cgo_import_dynamic would otherwise give a "static" binary a
    // PT_INTERP). The native codec needs system libraries, so it can only ever be OPTED
    // INTO.
    var build_args = mut ["-trimpath"];
    if (cgo) { build_args.append("-tags"); build_args.append("liblzma,libzstd"); }
    else { build_args.append("-tags"); build_args.append("noffi"); }
    build_args.append("-ldflags"); build_args.append(ld_flags());
    build_args.append("-o"); build_args.append(fs\join(stage, binary));
    build_args.append("./cmd/magus");
    go["go-build"](ctx.withEnv(env), {"args": build_args});

    // What ships BESIDE the binary. GPL-3.0 section 4 asks that a copy of the License travel
    // with the Program, and the ~70 MIT/BSD/Apache dependencies each require their notice
    // reproduced in a binary redistribution - neither obligation is met by an archive
    // holding one executable. The notices are generated FROM THIS BINARY rather than from
    // go.mod, because the two variants link different modules and a document naming both
    // would describe neither (see cmd/magus-utils/notices.go).
    fs\copyFile("LICENSE", fs\join(stage, "LICENSE"));
    fs\copyFile("README.md", fs\join(stage, "README.md"));
    write_notices(stage, binary);

    // Readable WITHOUT running the binary, which is the point: a dynamically linked build on
    // a host missing libzstd or liblzma fails in the loader before main() ever runs, so
    // `magus version` is unavailable exactly when someone most needs to know what they have.
    var variant = "static";
    if (cgo) { variant = "dynamic"; }
    var platform = goos + "/" + goarch;
    if (goarm != "") { platform = platform + " (GOARM=" + goarm + ")"; }
    fs\writeFile(fs\join(stage, "BUILDINFO"),
        "magus " + v + "\n"
        + "commit:   " + commit() + "\n"
        + "built:    " + build_date() + "\n"
        + "platform: " + platform + "\n"
        + "variant:  " + variant + "\n"
        + "\nRun `go version -m magus` for the full module list and build settings.\n");

    archive\compress(stage, asset, {});
    fs\removeAll(stage);

    // sha256File returns hex; the stdlib crypto.hash returns the raw digest bytes, and
    // v0.4.2 shipped a SHA256SUMS of those - unreadable by `sha256sum -c`.
    final digest = crypto\sha256File(asset);
    fs\writeFile(asset + ".sha256", digest + "  " + fs\basename(asset) + "\n");
}

// Resolves which platform to build: the explicit (goos, goarch) args when given, else
// the current runner's own native platform. So a bare `magus run release-build` (with
// or without the static charm) builds exactly one binary — the one you're standing
// on — never a silent "all 5" surprise.
fun release_target_platform(goos: str, goarch: str) > [str] !> any {
    if (goos != null and goos != "") { return [goos, goarch]; }
    // GOOS/GOARCH in the environment cross-target this build (the standard Go convention), so CD can
    // ask one runner for another platform's binary - e.g. the arm64 macOS job cross-builds darwin/amd64
    // static via `GOOS=darwin GOARCH=amd64 magus run release-build`. Empty env falls to native.
    final envos = os\env("GOOS");
    final envarch = os\env("GOARCH");
    if (envos != null and envos != "" and envarch != null and envarch != "") { return [envos, envarch]; }
    final p = os\platform();
    return [p[0], p[1]];
}

// Builds one release binary for one platform. Default is STATIC (CGO_ENABLED=0), and
// the `dynamic` charm (`magus run release-build:dynamic`) opts into the cgo build.
//
// The default is static so that every layer says the same thing: the bare command
// produces the bare asset, and that asset is the one that runs anywhere - no loader,
// no glibc, no system libzstd. Inverted - the bare command producing the cgo build
// while the bare ARCHIVE is the static one - `release-build` and
// `magus_<v>_<os>_<arch>.tar.gz` would mean opposite things in the same release.
//
// The charm is named for the property it selects, matching the `_dynamic` asset suffix -
// not for cgo, which is the mechanism that happens to produce it. Static also
// cross-compiles trivially (pure Go), where the dynamic build needs a real C toolchain
// plus libzstd/liblzma for the exact (goos, goarch) asked for, which is why CD only
// builds it on each platform's native runner.
//
// Reads has_charm directly (see docs/charms.md's function-target pattern, e.g.
// build:container): this is a magusfile function target with no spell, so :dynamic
// trips the soft undeclared-charm typo-guard warning — expected here, same as that
// example.
// Takes the platform as positional ARGS, not as declared parameters: a target's second
// parameter is bound to the whole argument list, whatever it is named, so the earlier
// `(ctx, goos: str, goarch: str)` signature put that list in goos and null in goarch -
// which made `goos + "-"` a list+str concatenation and failed EVERY release-build, on
// every platform, before it reached the compiler.
export fun release_build(ctx: magus\Context, args: [str]) > void !> any {
    // Never snapshotted (skip_cache), but declaring it keeps `magus clean --outputs` aware of
    // the release artifacts via AllOutputs.
    //
    // `**`, not `*`: this target stages into dist/<goos>-<goarch>/ (fs\mkdirAll below), and a
    // single `*` does not cross a separator, so it matched the flat archives while missing
    // every staged binary - leaving the declaration failing at the job above.
    ctx.writesFiles("dist/**");
    var goos = "";
    var goarch = "";
    if (args.len() == 1) {
        // Half a platform is always a typo. Falling through would silently build the
        // runner's OWN platform and name the archive after it, handing back a
        // plausible asset for the wrong target.
        throw "release-build: got one argument; pass both goos and goarch, e.g. -- linux armv7";
    }
    if (args.len() >= 2) { goos = args[0]; goarch = args[1]; }
    // The STATIC archive carries "_static" and the dynamic one takes the bare name, which
    // is Linux packaging practice: `busybox` is the ordinary dynamically-linked build and
    // `busybox-static` is the marked exception. Go has no convention to conflict with here
    // - projects shipping both variants are rare enough that none formed, and goreleaser
    // documents no variant naming for multi-build projects either.
    //
    // Note this makes the archive name and the CHARM default disagree on purpose: the bare
    // command produces the marked archive. That is tolerable only because both archives are
    // now labeled at the point it matters - `_static` says what it is, and nothing has to
    // be inferred from a name's absence. Everything that fetches an archive by name asks
    // for `_static` EXPLICITLY (cmd/magus/selfupdate.go, every download guide), so no
    // consumer depends on which variant happens to hold the bare name.
    //
    // The suffix names the PROPERTY, not the mechanism, and is a "_" field rather than "-"
    // so the scheme stays splittable: the old `magus_v0.4.0_darwin_arm64-cgo.tar.gz` parsed
    // its arch as `arm64-cgo`. platformFromName in cmd/magus-utils strips it before
    // splitting, for the same reason.
    final p = release_target_platform(goos, goarch);
    if (ctx.hasCharm("dynamic")) {
        build_release_variant(ctx, p[0], p[1], true, "");
    } else {
        build_release_variant(ctx, p[0], p[1], false, "_static");
    }
}

// Signs dist/SHA256SUMS with the Ed25519 key in the MAGUS_SIGNING_KEY secret (see
// cmd/magus-utils/sign.go), then self-verifies the signature against the embedded
// release pubkey (internal/releasekey) before the release goes out — a cheap
// regression guard, safe to run here (unlike setup-magus, which can't depend on the
// magus source tree since it's reused by arbitrary external repos).
export fun release_sign(ctx: magus\Context, args: [str]) > void !> any {
    refuse_overwrite(ctx, fs\join("dist", "SHA256SUMS.sig"));
    // The version header selfupdate's ParseManifest requires; no release had ever
    // emitted it. Added here, the last touch before the bytes are signed.
    final manifest = fs\join("dist", "SHA256SUMS");
    fs\writeFile(manifest, releaser\manifestWithVersion(fs\readFile(manifest), version: version()));
    proc\exec("go", ["run", "./cmd/magus-utils", "sign", fs\join("dist", "SHA256SUMS")]);
    proc\exec("go", ["run", "./cmd/magus-utils", "verify",
        fs\join("dist", "SHA256SUMS"), fs\join("dist", "SHA256SUMS.sig")]);
}

// Builds docs/gen/public/release/index.json from releases/*.yaml, signs it into
// index.json.sig, regenerates the files derived from the changelog the cut rewrote,
// and, under the cd charm, publishes whatever changed as a pull request. args[0] is
// what produced the index, as a sentence fragment ("the v0.4.0 release", "a manual
// refresh"); it names the commit and the pull request.
//
// The pull request is the whole point. index.json only changes when a release is cut,
// and only a job holding MAGUS_SIGNING_KEY can sign it, which is why the file is
// tracked rather than rendered on every push to main. main's ruleset requires a pull
// request and bypasses only for the admin role, so a workflow cannot push the pair
// straight to the default branch. A pull request opened with GITHUB_TOKEN triggers no
// workflow runs, so no CI runs against the branch; nothing on it needs review anyway,
// since the bytes are derived from committed manifests by a tool whose tests DID run.
//
// cd is the deliver switch, meaning what it means on release above: without it this
// signs, regenerates, and reports whether a publish would carry anything, touching no
// branch, so the whole computation rehearses safely on a developer machine. A clean
// tree is a success in either mode: an index that already matches releases/ has
// nothing to publish, and the tail of release.yaml reaches this state on every re-run.
export fun release_index(ctx: magus\Context, args: [str]) > void !> any {
    if (args.len() == 0 or args[0].trim() == "") {
        throw "release-index: pass what produced this index as a sentence fragment,"
            + " e.g. -- \"the v0.4.0 release\"; it names the commit and the pull request";
    }
    // rw is refused, not required. The index pair lives in the docs project, so this
    // target legitimately writes across the project boundary - and the boundary audit
    // (MGS3001) arms exactly when the dispatch carries rw. The regeneration below
    // needs no charm either: the *-generate targets always write; rw on `generate`
    // only skips its drift gate, and this target judges dirtiness itself.
    if (ctx.hasCharm("rw")) {
        throw "release-index: drop the rw charm (locally: magus run release-index"
            + " --no-default-charms . -- <reason>) - rw arms the cross-project write"
            + " audit against the docs files this target must touch";
    }
    final reason = args[0];
    // An unsigned index must never be published, and a signed one cannot be built
    // without the key - so cd demands it, and a keyless run downgrades to an unsigned
    // local rehearsal instead of dying before the part worth rehearsing.
    var buildArgs = mut ["run", "./cmd/magus-utils", "release-index",
        "-releases", "./releases", "-out", "./docs/gen/public/release"];
    final key = os\env("MAGUS_SIGNING_KEY");
    if (key == null or key == "") {
        if (ctx.hasCharm("cd")) {
            throw "release-index: cd publishes the signed pair and MAGUS_SIGNING_KEY is not set";
        }
        magus\log.info("release-index: MAGUS_SIGNING_KEY is not set; building unsigned (-no-sign) for this rehearsal");
        buildArgs.append("-no-sign");
    }
    proc\exec("go", buildArgs);
    // The cut rewrote CHANGELOG.md, and the knowledge graph and the docs changelog are
    // derived from it, so publish them regenerated or the pull request is born failing
    // its own drift gate (the v0.4.2 index PR was). Two compositions, deliberately
    // different. The root's regeneration is `generate`'s *-generate fan-out rather
    // than ctx.needs(generate), because the gate half of generate would throw at
    // exactly the drift this target exists to publish; and rather than a nested
    // `magus run generate:rw .`, because a nested run against the project this run
    // holds deadlocks and is refused (MGS3007). generate's go.mod replacement pass is
    // not repeated here: go.mod is not among the published paths, and its spell ops
    // take no explicit args, so this run's reason argument would flow through to
    // `go mod edit`. The docs project gets the nested run its unlocked project
    // permits: a cross-project handle on docs would close a root->docs->root
    // dependency cycle, since docs already imports the workspace.
    ctx.needs(ctx.glob("*-generate", "!deploy-generate"));
    magus\run(["generate:rw", "docs"]);

    final paths = releaser\releaseIndexPaths();
    if (!vcs\isDirty(paths)) {
        magus\log.info("release-index: the signed index already matches releases/; nothing to publish");
        return;
    }
    if (!ctx.hasCharm("cd")) {
        magus\log.info("release-index: DRY RUN - the regenerated index differs; add the cd charm to branch, push, and open the pull request");
        return;
    }

    final branch = releaser\releaseIndexBranch(vcs\commit().short);
    final subject = releaser\releaseIndexSubject(reason);
    vcs\cmd(["switch", "-c", branch]);
    vcs\cmd(["add", "--"] + paths);
    // The bot identity rides -c on this one commit rather than git config, so a local
    // run that gets this far leaves the developer's configuration untouched.
    vcs\cmd(["-c", "user.name=github-actions[bot]",
        "-c", "user.email=41898282+github-actions[bot]@users.noreply.github.com",
        "commit", "-m", subject]);
    // Force, so a re-run of a failed publish job survives its own earlier push: the
    // branch name is derived from HEAD and owned by this target alone, and a re-run
    // regenerates the same content under a fresh commit.
    vcs\cmd(["push", "--force", "origin", branch]);

    final open = proc\exec("gh", args: ["pr", "list", "--head", branch, "--state", "open",
        "--json", "number", "--jq", ".[].number"], dir: ".", opts: {"quiet": true}).stdout.trim();
    if (open != "") {
        magus\log.info("release-index: a pull request for " + branch + " is already open");
        return;
    }
    // A refused creation (repository Actions settings can forbid workflows from opening
    // pull requests) must not fail the run: the pushed branch is the deliverable, later
    // jobs gate on this one, and the warning carries the one manual step left.
    final created = proc\exec("gh", args: ["pr", "create", "--base", "main", "--head", branch,
        "--title", subject, "--body", releaser\releaseIndexPrBody()],
        dir: ".", opts: {"allow_failure": true});
    if (!created.ok) {
        magus\log.warn(releaser\releaseIndexPrFallback(os\env("GITHUB_REPOSITORY") ?? "",
            branch: branch));
    }
}

// One preflight verdict. `ok` is the gate; `detail` is the line the rehearsal prints on a
// pass as much as on a failure, because which checks ran is half of what a rehearsal shows.
//
// `note` is a third rendering rather than a third gate state: a noted verdict passes. It
// exists for a finding worth putting in the transcript that is not grounds to stop, where
// reporting it as OK would hide it and as FAIL would refuse a repository state git supports.
object Verdict {
    ok: bool = false,
    note: bool = false,
    name: str = "",
    detail: str = "",
}

fun passed(name: str, detail: str) > Verdict { return Verdict{ok = true, name = name, detail = detail}; }
fun failed(name: str, detail: str) > Verdict { return Verdict{ok = false, name = name, detail = detail}; }
fun noted(name: str, detail: str) > Verdict {
    return Verdict{ok = true, note = true, name = name, detail = detail};
}

// Local branch names, the ones that can shadow a tag.
//
// refs/heads only, which is a claim about git's disambiguation. A short ref resolves
// through refs/, refs/tags/, refs/heads/, then refs/remotes/, and a name renders long only
// when two of those match it: refs/remotes/origin/v0.4.0 shortens to `origin/v0.4.0` and
// collides with nothing, while refs/heads/v0.4.0 collides. Measured in this repository,
// which carries both a v0.4.0 tag and a v0.4.0 branch, `for-each-ref` renders that tag as
// `tags/v0.4.0` and `git rev-parse v0.4.0` warns that the name is ambiguous.
fun local_branches() > [str] !> any {
    var names = mut [<str>];
    final listing = vcs\cmd(["for-each-ref", "--format=%(refname:lstrip=2)", "refs/heads"],
        {"quiet": true}).stdout;
    foreach (line in listing.split("\n")) {
        final name = line.trim();
        if (name != "") { names.append(name); }
    }
    return names;
}

// Does release.yaml still upload what this file thinks it uploads, and trigger on what this
// file thinks triggers it?
//
// Neither constant is derived from the workflow, so nothing but this notices when one side
// is edited alone. An asset glob the uploader no longer uses is worse than no constant at
// all, because the preflight would go on approving names against a pattern nobody reads.
fun verify_release_workflow() > [Verdict] !> any {
    if (!fs\exists(RELEASE_WORKFLOW)) {
        return [failed("workflow", RELEASE_WORKFLOW + " is missing, so neither the upload glob nor the tag trigger can be confirmed")];
    }
    final body = fs\readFile(RELEASE_WORKFLOW);
    var checks = mut [<Verdict>];
    if (body.indexOf(RELEASE_ASSET_GLOB) == null) {
        checks.append(failed("workflow upload glob",
            RELEASE_WORKFLOW + " no longer contains `" + RELEASE_ASSET_GLOB
            + "`; the asset names below were checked against a pattern the upload does not use"));
    } else {
        checks.append(passed("workflow upload glob", "`" + RELEASE_ASSET_GLOB + "` is what "
            + RELEASE_WORKFLOW + " uploads"));
    }
    if (body.indexOf("- '" + RELEASE_TAG_REFSPEC + "'") == null) {
        checks.append(failed("workflow tag trigger",
            RELEASE_WORKFLOW + " no longer triggers on `" + RELEASE_TAG_REFSPEC + "`"));
    } else {
        checks.append(passed("workflow tag trigger", "`" + RELEASE_TAG_REFSPEC + "` is what "
            + RELEASE_WORKFLOW + " triggers on"));
    }
    return checks;
}

// Every check that has to hold BEFORE a tag exists, given the tag names this release
// would add to the ones HEAD already carries.
//
// Timing is what this adds. Each gating check already had an owner: the asset name in
// release-build, the changelog and manifest path in `magus-utils cut`. Both fired hours
// after the tag was pushed, and the Go module proxy caches a tag within the hour, so a
// failed release burns the version number.
//
// Returns a LIST rather than throwing on the first failure. A rehearsal that stops at the
// first problem hides the second one, and a noted verdict is not a problem at all.
fun release_preflight(wouldBeTags: [str], rootVersion: str) > [Verdict] !> any {
    var checks = mut [<Verdict>];
    final onHead = tag_names_on_head();
    final branches = local_branches();

    // (a) A branch already using a tag's name. NOTED, never refused.
    //
    // refs/heads and refs/tags are separate namespaces so that these names can coexist, and
    // git supports the state rather than tolerating it. The v0.4.0 incident was magus asking
    // for %(refname:short), which renders an ambiguous tag as `tags/v0.4.0`; that was a bug
    // in the query and it is fixed. Refusing a release over it would contradict the reason
    // this preflight exists, which is to survive a messy repository rather than demand it be
    // tidied first.
    //
    // What survives is a handling detail worth knowing before you push: a bare name is
    // ambiguous while both refs exist. Measured here, `git push <remote> v0.4.0` fails with
    // "src refspec v0.4.0 matches more than one" and `git rev-parse v0.4.0` warns before
    // answering, while `git push <remote> refs/tags/v0.4.0` is unambiguous and works.
    foreach (tag in wouldBeTags) {
        var collides = false;
        foreach (b in branches) {
            if (b == tag) { collides = true; }
        }
        if (collides) {
            checks.append(noted("branch collision", "a branch named `" + tag + "` exists beside this "
                + "tag. The two namespaces are separate, so both are legal and magus reads tags by "
                + "written name either way. Bare-name git spellings are ambiguous while both exist: "
                + "push it as `git push <remote> refs/tags/" + tag + "`, since `git push <remote> "
                + tag + "` is refused as matching more than one ref"));
        } else {
            checks.append(passed("branch collision", "no branch is named `" + tag + "`"));
        }
    }

    // (b) The post-tag state, simulated: what version() would answer with these tags on
    // HEAD, and whether every asset release-build would then name lands where the upload
    // looks.
    //
    // Scoped to a release that will RUN the workflow, meaning a root tag on HEAD. Without
    // one there are no published assets to misname, and gating here would refuse every
    // library-only release: describe() then picks among the namespaced tags, which is
    // already true of any commit sitting past those tags. The release does not introduce
    // that state, so it is reported instead.
    final root = releaser\rootReleaseTag(wouldBeTags + onHead);
    if (root == "") {
        var stamped = "the nearest tag by distance";
        final near = wouldBeTags + onHead;
        if (near.len() > 0) { stamped = "one of " + near.join(", ") + ", chosen arbitrarily"; }
        checks.append(passed("asset names", "no root release tag would sit on HEAD, so "
            + RELEASE_WORKFLOW + " does not run and nothing is published. A local "
            + "`magus run release-build` on this commit stamps " + stamped
            + ", and refuses when that carries a separator"));
    } else {
        // The platform list mirrors release.yaml's build jobs so the transcript names assets
        // a release would produce. The check does not depend on the list being current:
        // goos, goarch and the suffix are fixed tokens carrying no separator, so the version
        // is the only part that can push a name out of the glob, and the glob is the other
        // half, catching a rename on one side of the handoff alone.
        var offenders = mut [<str>];
        foreach (p in [["linux", "amd64"], ["linux", "arm64"], ["darwin", "amd64"],
                       ["darwin", "arm64"], ["windows", "amd64"], ["windows", "arm64"]]) {
            foreach (suffix in ["_static", ""]) {
                // toSlash for the same reason build_release_variant needs it: fs\join gives
                // the separator of the machine REHEARSING, so without it every asset reads
                // as an offender on a Windows developer's tree.
                final asset = fs\join("dist", release_asset_name(root, p[0], p[1], suffix));
                if (!releaser\matchesGlob(RELEASE_ASSET_GLOB, releaser\toSlash(asset))) {
                    offenders.append(asset);
                }
            }
        }
        if (offenders.len() > 0) {
            checks.append(failed("asset names", "HEAD would stamp version `" + root + "`, naming assets "
                + "like `" + offenders[0] + "` that `" + RELEASE_ASSET_GLOB + "` cannot match. The "
                + "build would be green and the release would publish nothing. " + "{offenders.len()}"
                + " of the assets release.yaml builds are affected."));
        } else {
            checks.append(passed("asset names", "version `" + root + "` names assets `"
                + RELEASE_ASSET_GLOB + "` matches on every platform release.yaml builds"));
        }
    }

    // (c) and (d) are about the ROOT release only: publishing, the changelog, and the
    // workflow trigger all key off a root tag, and a release cutting libraries alone starts
    // no workflow run and cuts no manifest.
    if (rootVersion == "") {
        checks.append(passed("publish prerequisites", "no root version named, so nothing publishes"));
        return checks;
    }
    final rootTag = "v" + rootVersion;

    // (c) What `magus-utils cut` needs, asked now instead of after the binaries are built.
    // Both already fail the release, in the publish job, on a tag that is pushed and cached
    // and cannot be reused.
    final manifest = fs\join("releases", rootTag + ".yaml");
    if (fs\exists(manifest)) {
        checks.append(failed("release manifest", manifest + " already exists, and release manifests "
            + "are immutable once committed; `magus-utils cut` would refuse after the binaries "
            + "were built"));
    } else {
        checks.append(passed("release manifest", manifest + " is absent, as cut requires"));
    }

    if (!fs\exists("CHANGELOG.md")) {
        checks.append(failed("changelog", "CHANGELOG.md is missing; cut reads the release notes out of it"));
    } else if (releaser\unreleasedBody(fs\readFile("CHANGELOG.md")) == "") {
        checks.append(failed("changelog", "CHANGELOG.md's [Unreleased] section is empty, so "
            + "`magus-utils cut` would refuse and this release would publish binaries with no notes. "
            + "Write the entry before tagging"));
    } else {
        checks.append(passed("changelog", "CHANGELOG.md's [Unreleased] section has content for cut to move"));
    }

    // (d) The trigger, from both sides. A nested tag that matched would run the whole
    // release pipeline off a library bump; a root tag that did not match would publish
    // nothing while every local check passed.
    if (!releaser\matchesGlob(RELEASE_TAG_REFSPEC, rootTag)) {
        checks.append(failed("workflow trigger", "`" + rootTag + "` does not match "
            + RELEASE_WORKFLOW + "'s `" + RELEASE_TAG_REFSPEC + "` trigger, so pushing it would "
            + "publish nothing"));
    } else {
        checks.append(passed("workflow trigger", "`" + rootTag + "` matches `" + RELEASE_TAG_REFSPEC
            + "` and starts the release"));
    }
    foreach (tag in wouldBeTags) {
        if (tag == rootTag) { continue; }
        if (releaser\matchesGlob(RELEASE_TAG_REFSPEC, tag)) {
            checks.append(failed("workflow trigger", "the module tag `" + tag + "` also matches `"
                + RELEASE_TAG_REFSPEC + "`, so pushing it would start a second release run"));
        } else {
            checks.append(passed("workflow trigger", "the module tag `" + tag + "` starts no release run"));
        }
    }

    return checks;
}

// release cuts a version across the workspace in the order Go's multi-module
// convention requires - the part that is easy to get wrong by hand:
//
//   1. tag each nested module (libs/<name>/vX.Y.Z) - each has to be
//      independently `go get`-able before anything downstream can require it
//      at a real version instead of v0.0.0.
//   2. rewrite root go.mod's `require .../libs/<name> v0.0.0` lines to the
//      real vX.Y.Z, now that those tags exist to resolve to.
//   3. tag root vX.Y.Z last - only now does the root tag's own go.mod
//      resolve its nested requires to something `go get` can fetch, instead
//      of the unreleased v0.0.0 that makes `go get github.com/egladman/magus`
//      fail for everyone outside this repo (see docs/reference/go-sdk.md).
//
// go.mod's `replace` directives are left exactly as they are: they are
// ignored by any downstream consumer (replace is never transitive) and are
// the standard pattern for local development inside the same repo - go.mod
// carries a comment saying so, precisely so nobody "cleans them up" later.
//
// Dry run by default, and PER MODULE. `magus run release` with no arguments
// surveys every module - its current version and the three legal next ones - and
// releases nothing. Name a module to release it:
//
//      magus run release -- magus@0.4.0
//      magus run release -- libs/gopherbuzz@0.2.0
//      magus run release:cd -- magus@0.4.0 libs/gopherbuzz@0.2.0
//
// A module you do NOT name is not released. That is the point: these modules
// version INDEPENDENTLY, each on its own cadence, because Go already gives each
// its own tag namespace. Deriving every tag from one number would chain
// gopherbuzz's public API to magus's release schedule for no reason.
//
// The three candidates are COMPUTED, never chosen. Deciding which one a change
// deserves is a judgment about what breaks for a consumer; that belongs to the
// developer. magus supplies the mechanism and stops there.
//
// Neither path ever pushes - a human reviews the tags and pushes deliberately.

export fun release(ctx: magus\Context, args: [str]) > void !> any {
    // `cd` alone, and no `versioned`: cd is the deliver switch, meaning the same
    // thing here as in image_build above - do the side-effectful thing (push and
    // sign, there; tag and rewrite go.mod, here). The channel charm answers a
    // question this target does not have: cutting a version tag has only one
    // channel, so naming it would be a word with no alternative to distinguish.
    final deliver = ctx.hasCharm("cd");
    final dirty = vcs\isDirty();
    final modules = releaser\releasableModules(magus\projects().projects);

    // Parse `key=version`. Anything unnamed is surveyed, never released.
    var wanted = mut {};
    foreach (a in args) {
        if (a == "") { continue; }
        // `@`, matching `go get <module>@<version>` - this target cuts Go module
        // tags, so the delimiter a Go developer already types beats the config-file
        // `=`. It is also the safer of the two in a shell: `foo=bar` as the FIRST
        // word of a command is a variable assignment, and only the `--` in front of
        // these arguments keeps that from mattering.
        //
        // Searched from index 1, not 0: an npm-scoped key like `@scope/pkg` opens
        // with the delimiter, and splitting on that one yields an empty module name.
        // No such project exists here yet; the day one does, it parses rather than
        // failing with a message about a module called "".
        var at = a.sub(1).indexOf("@");
        if (at != null) { at = at + 1; }
        if (at == null) {
            throw "release: expected <module>@<version>, got `" + a
                + "` - run `magus run release` with no arguments to list the modules";
        }
        final key = a.sub(0, at);
        var v = a.sub(at + 1);
        if (v.startsWith("v")) { v = v.sub(1); }
        semver\parse(v); // raises with a clear message on anything not valid semver
        wanted[key] = v;
    }

    // Survey ALWAYS, before anything else: it is the whole interface for choosing
    // a version, and printing it up front means the numbers you act on are the
    // numbers you just read.
    final branches = local_branches();
    foreach (m in modules) {
        final cur = releaser\currentVersion(m["prefix"]);
        final n = releaser\nextFor(cur);
        var at = "at " + cur;
        if (cur == "") { at = "unreleased"; }
        magus\log.info("release: {m["key"]} - {at}"
            + ", next: patch {n.patch} | minor {n.minor} | major {n.major}");
        // A candidate whose name a branch already holds, said here because the survey is
        // where the number gets chosen. The preflight notes it again for the tag actually
        // named; neither stops the release, and both exist so the choice is informed.
        foreach (c in [n.patch, n.minor, n.major]) {
            final tag = m["prefix"] + c;
            foreach (b in branches) {
                if (b == tag) {
                    magus\log.warn("release:   a BRANCH named `" + tag + "` exists; that candidate "
                        + "would make the tag ambiguous to every tool resolving a short ref");
                }
            }
        }
    }

    if (wanted.keys().len() == 0) {
        magus\log.info("release: nothing named, nothing released - e.g. `magus run release -- magus@0.4.0`");
        return;
    }

    // Reject an unknown key BEFORE doing anything: a typo must not quietly release
    // nothing while reporting success.
    foreach (key in wanted.keys()) {
        var known = false;
        foreach (m in modules) {
            if (m["key"] == key) { known = true; }
        }
        if (!known) {
            throw "release: unknown module `" + key
                + "` - run `magus run release` with no arguments to list them";
        }
    }

    // Refuse a version that is not one of the three offered. Cutting a release is
    // tedious precisely because a wrong number is silent - nothing catches a typo
    // that lands v0.40.0 instead of v0.4.0 until someone tries to depend on it, and
    // a tag is the one artifact you cannot quietly take back. The candidates are
    // computed from the current stable release, so the only way to reach a distant
    // version is to release your way there deliberately.
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null) { continue; }
        final cur = releaser\currentVersion(m["prefix"]);
        if (!releaser\isCandidate(v, cur)) {
            final n = releaser\nextFor(cur);
            throw "release: {m["key"]} v{v} is not a legal next version from {cur}"
                + " - choose {n.patch}, {n.minor} or {n.major}"
                + " (a prerelease or +metadata build of one of those is fine)";
        }
    }

    // Go's major-version suffix rule applies to the module PATH, not the tag: from
    // v2 on, the path must end in /vN. `go get` resolves the path, so a v2.0.0 tag
    // beside a go.mod declaring the v1 path is uninstallable. Semver has no opinion
    // here, so the survey offers that candidate happily.
    //
    // Refused rather than fixed. Renaming a module means rewriting every import,
    // which belongs in its own commit.
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null) { continue; }
        final major = semver\parse(v).major;
        if (major < 2) { continue; }
        var path = "{m["gomodule"]}";
        // The root's gomodule is "" by design (it is never repointed to itself), so
        // its path comes from the declaration instead.
        if (m["root"] != "") { path = releaser\modulePath(fs\readFile("go.mod")); }
        if (releaser\needsMajorSuffix(path, major: major)) {
            throw "release: " + m["key"] + " v" + v + " needs a module path ending in /v"
                + major + ", but go.mod declares `" + path + "`. Go resolves the path, not "
                + "the tag, so this would publish a version nobody can `go get`. Rename the "
                + "module and its imports first, in their own commit, then release.";
        }
    }

    // Refuse an existing tag before creating ANY of them, so a partial release
    // cannot leave half the modules tagged.
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null) { continue; }
        final tag = m["prefix"] + "v" + v;
        if (vcs\tags(pattern: tag).len() > 0) {
            throw "release: tag " + tag + " already exists";
        }
    }

    // PREFLIGHT. The refusals above answer whether the version is legal; these answer
    // whether the release that follows the tag works, which is what v0.4.0 got wrong in CI
    // an hour after the tag was immovable.
    //
    // Everything above throws on the first problem, which suits a version number: there is
    // one and it is either legal or not. These are a rehearsal, so they all run and all
    // print. Under `cd` a single failure refuses the release; without it the transcript is
    // the deliverable, the same shape the dirty-tree check has.
    var wouldBeTags = mut [<str>];
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null) { continue; }
        wouldBeTags.append(m["prefix"] + "v" + v);
    }
    var rootVersion = "";
    if (wanted["magus"] != null) { rootVersion = "{wanted["magus"]}"; }

    var failures = 0;
    foreach (c in verify_release_workflow() + release_preflight(wouldBeTags, rootVersion: rootVersion)) {
        if (c.note) {
            magus\log.warn("release: NOTE " + c.name + " - " + c.detail);
        } else if (c.ok) {
            magus\log.info("release: OK   " + c.name + " - " + c.detail);
        } else {
            failures = failures + 1;
            magus\log.warn("release: FAIL " + c.name + " - " + c.detail);
        }
    }
    // Both refusals come AFTER the whole transcript. A run that stops at the first problem
    // sends you back for the second, and a dirty tree is the one fact `git status` already
    // reports, so it should not be what hides a branch collision.
    if (failures > 0 and deliver) {
        throw "release: " + failures + " preflight check(s) failed; nothing was tagged. "
            + "Drop the cd charm to rehearse until they pass.";
    }
    if (deliver and dirty) { throw "release: tree is dirty; commit before releasing"; }

    if (!deliver) {
        magus\log.info("release: DRY RUN - add the cd charm to execute");
        if (dirty) { magus\log.info("release: NOTE - tree is dirty; cd will refuse until it is clean"); }
        if (failures > 0) {
            magus\log.info("release: NOTE - " + failures + " preflight check(s) failed; cd will refuse until they pass");
        }
    }

    // 1. Nested modules first: the root's go.mod must require a version that
    // already exists as a tag by the time the root itself is tagged.
    // See gomod.replaceWorkspaceModules: release amends require versions in a committed
    // go.mod, it does not produce the file, and two targets declaring one output is MGS1020.
    ctx.modifiesExistingFiles("go.mod");
    var gomod = fs\readFile("go.mod");
    var rewrote = false;
    foreach (m in modules) {
        final v = wanted[m["key"]];
        if (v == null or m["root"] != "") { continue; }
        magus\log.info("release: tag " + m["prefix"] + "v" + v);
        if (deliver) { vcs\cmd(["tag", m["prefix"] + "v" + v]); }
        // Only a Go module is required by the root's go.mod; a library in another
        // language is tag-only, so there is nothing to repoint.
        // Inferring "the root's go.mod requires it" from the manifest breaks on
        // libs/testlayout: `golangci-lint custom` compiles it into a binary and
        // magus never imports it, so there is no require line to repoint. Ask
        // go.mod directly. rewriteRequire still
        // throws on a missing line, which is right for a module the root does
        // require and whose line moved.
        if (m["gomodule"] != "" and gomod.indexOf(m["gomodule"] + " v") == null) {
            magus\log.info("release: go.mod  " + m["gomodule"] + "  - not required by the root; tag only");
        } else if (m["gomodule"] != "") {
            magus\log.info("release: go.mod  " + m["gomodule"] + "  ->  v" + v);
            gomod = releaser\rewriteRequire(gomod, m["gomodule"], "v" + v);
            rewrote = true;
        }
    }
    if (deliver and rewrote) { fs\writeFile("go.mod", gomod); }

    // 2. Root tag LAST, so it captures the go.mod rewrite above.
    final rootV = wanted["magus"];
    if (rootV != null) {
        magus\log.info("release: tag v" + rootV);
        if (deliver) { vcs\cmd(["tag", "v" + rootV]); }
    }

    if (deliver) {
        magus\log.info("release: done - nothing was pushed. Push the tags deliberately when ready.");
    } else {
        magus\log.info("release: dry run only - nothing was tagged or written");
    }
}

// Rebuilds on every debounced change until interrupted; fs.watch BLOCKS, try/catch keeps it alive.
export fun watch(ctx: magus\Context, args: [str]) > void !> any {
    magus\log.info("watching cmd/ and internal/ - rebuilding on change (Ctrl-C to stop)");
    fs\watch(["cmd", "internal"], fun(changed: [str]) > bool {
        magus\log.info("change detected - rebuilding");
        try {
            go_build(ctx, []);
        } catch (e) {
            magus\log.warn("build failed, still watching: " + e);
        }
        return false;
    });
}

// Renders a Go coverage badge locally (no third-party service, no network).
fun total_coverage(func_out: str) > str {
    final lines = func_out.split("\n");
    final fields = lines[lines.len() - 1].split("");
    final cell = fields[fields.len() - 1];
    if (cell.endsWith("%")) { return cell.sub(0, cell.len() - 1); }
    return cell;
}

// Runs the PR advisors' `test "..." {}` blocks.
//
// They are the only .buzz sources in this tree that parse standalone: everything else
// imports magus/magus\spell and uses embedding-only constructs, which is why the old
// standalone-Buzz test targets were deleted rather than repointed. The advisors run
// under a plain `magus buzz` in CI, so upstream-strict is exactly the parse they need
// checked, and `-t` is the runner.
//
// Run from each script's own directory, not the project root, because they do
// `import "advice"` for the shared comment plumbing and Buzz resolves a bare import
// against the CWD. In CI the action supplies the same thing as BUZZ_INCLUDE_PATH.
//
export fun advice_test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(".github/actions/advice/*.buzz", ".github/actions/ci-outcome/*.buzz", ".github/actions/magus/*.buzz");
    foreach (dir in [".github/actions/advice", ".github/actions/ci-outcome", ".github/actions/magus"]) {
        foreach (script in fs\glob(dir + "/*.buzz")) {
            magus\cmd("buzz", args: ["-t", fs\basename(script.value)], opts: {"dir": dir});
        }
    }
}

// Tests with race detection and a coverage floor. The badge is coverage_badge's.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(advice_test);
    // Declared so coverage_badge can read them after a cache HIT: without this the
    // profiles are undeclared residue, restored by nothing, and the badge target
    // finds no file to measure whenever the suite replays.
    ctx.writesFiles("coverage.out", "coverage.hand.out");
    // The tree this suite compiles and runs, restated. It is NOT redundant with the
    // project's sources: a ctx.readsFiles call REPLACES a target's footprint rather than
    // adding to it (buildStep in run.go keeps only the magusfiles, then folds these refs
    // in), so the console declaration below - added to key four files the project does not
    // claim - deleted **/*.go, go.mod and every other project and spell glob from this
    // target's key. Measured: ~8,400 new lines of *_test.go landed and `magus run test .`
    // replayed the cached verdict, coverage profile untouched, until --no-cache. The same
    // note is on go_build, which never grew a readsFiles and so still keys on the tree.
    //
    // The go spell's globs (spells/golang/spell.buzz mgs_listRequiredGlobs), because
    // .s/.S/.c/.h compile into packages and .txtar carries the behavior fixtures; **/*.buzz
    // because the suite parses this repo's spell sources; **/*.md because
    // internal/selfupdate's trust-anchor test reads docs/setup/verify.md; mise.toml and
    // magus.yaml because they pin the toolchain the suite runs under and the policy it
    // resolves. Spell-declared ignore dirs still prune the walk - baseStep sets
    // step.IgnoreDirs before the replacement and the replacement does not touch it - so
    // these globs do not descend into node_modules or a leftover worktree.
    ctx.readsFiles("**/*.go", "**/*.txtar", "**/*.s", "**/*.S", "**/*.c", "**/*.h",
                   "go.mod", "go.sum", "go.work", "go.work.sum",
                   "**/*.buzz", "**/*.md", "mise.toml", "magus.yaml");
    // types/kindpalette_drift_test.go reads CONSOLE sources to lock the node-kind palette to
    // the Kind* constants. None of those paths is a declared source of this project, so
    // without this the suite replays from cache on every console-only edit and the gate stays
    // green while the thing it measures drifts underneath it. Measured: deleting a palette
    // entry from tokens.css left `magus run test .` passing.
    ctx.readsFiles("console/src/styles/tokens.css", "console/src/console/graph/graph.css",
                   "console/src/console/graph/main.ts", "console/src/console/graph/shapes.ts");
    ctx.needs(format, buzz_test);
    // Explicit args replace go-test's `./...` default, so the whole-tree scope this
    // suite exists for has to be stated alongside the flags.
    go["go-test"](ctx.withEnv({"GOEXPERIMENT": "jsonv2"}), {"args": ["-race", "-covermode=atomic", "-coverprofile=coverage.out", "./..."]});
    // Measure hand-written code only. Generated files (protobuf accessors, mocks,
    // the Buzz mirrors) are hundreds of functions no test will ever call, so
    // leaving them in makes the figure a statement about the code generators and
    // rewards writing tests for getters to hold the floor up. coverage.buzz
    // detects them by Go's canonical marker, never by path - this repo keeps
    // hand-maintained files inside a gen/ directory. coverage.out stays on disk
    // unfiltered so `go tool cover -html=coverage.out` still shows everything.
    fs\writeFile("coverage.hand.out",
        cov\stripGenerated(fs\readFile("coverage.out"),
            prefix: cov\modulePath(fs\readFile("go.mod")) + "/"));
    if (std\parseInt(coverage_percent().split(".")[0]) < 70) {
        throw "test: coverage " + coverage_percent() + "% is below the 70% floor; investigate the regression or lower the floor deliberately";
    }
}

fun coverage_percent() > str !> any {
    return total_coverage(proc\exec("go", ["tool", "cover", "-func=coverage.hand.out"]).stdout);
}

// Writes assets/coverage.svg, and is the only target that may.
//
// Split from test so the suite can be CACHED: the badge is a declared output, so a
// hit would restore a cached one over the committed file, which is what forced
// skip_cache onto every test run - five minutes and 10GB to re-answer a question
// whose inputs had not moved.
//
// NOT named *-generate, deliberately: `generate` composes ctx.glob("*-generate"),
// so that suffix would pull a target that needs the race-enabled suite into the
// drift gate.
export fun coverage_badge(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(test);
    ctx.writesFiles("assets/coverage.svg");
    // The three things the verdict is a function of, so this target caches honestly
    // instead of opting out. coverage.hand.out carries the percentage and is a
    // declared output of `test`, so a replayed suite still leaves it on disk;
    // assets/coverage.svg is the committed file the check below compares against, so
    // hand-editing it has to invalidate the pass; badge.buzz renders the bytes both
    // branches produce. The charms are already in the key, which covers the two
    // branches this body takes.
    //
    // A footprint REPLACES the project baseline rather than adding to it (see the note
    // on `test`), and that is the point here: the Go tree reaches this target only
    // through the profile that ctx.needs(test) refreshes.
    ctx.readsFiles("coverage.hand.out", "assets/coverage.svg", "badge.buzz");
    // Only the CI runner writes or judges it. 105 non-test files carry a //go:build
    // constraint, so the ratio is a property of the machine: 67.6% on macOS against
    // 66.9% on Linux for one commit. A laptop that wrote it replaced CI's number.
    if (!ctx.hasCharm("gha")) { return; }
    final badgePct = coverage_percent().split(".")[0];
    final wanted = badge\coverage("go coverage", percent: badgePct, radius: 3);
    if (ctx.hasCharm("rw")) {
        fs\writeFile(fs\join("assets", "coverage.svg"), content: wanted);
        return;
    }
    // Compared, never written: a check that mutates the tree it judges leaves its
    // own output for the next drift gate to read as an edit.
    if (fs\readFile(fs\join("assets", "coverage.svg")) != wanted) {
        throw "coverage-badge: assets/coverage.svg does not match this runner's measurement of " + badgePct
            + "%. This runner's platform set is the authoritative one, so commit a badge for "
            + badgePct + "% - `badge\\coverage(\"go coverage\", percent: \"" + badgePct + "\", radius: 3)`.";
    }
}

// buzz-check and buzz-run lived here and are gone: they ran the upstream `buzz`
// toolchain and magus's embedded engine over cmd/magus/starter/spells, whose only two
// files (a .bzz and a .tl) were deleted with the lua/teal interpreter in b60e99be. They
// have been checking an absent directory and passing ever since, which this repo treats
// as worse than no gate.
//
// They are deleted rather than repointed because there is no standalone Buzz left to
// aim them at. Every .buzz here imports "magus"/"magus/spell" and uses embedding-only
// constructs, so a non-embedded parse rejects all 62 of them; that is by design, not
// drift. What they were meant to protect is already covered: spells/examples/**
// by TestSpellExamplesParseAndRecord in internal/dry (ParseEmbedded), every spell source by buzz-test's glob
// below, and every magusfile by doctor's magusfile-syntax check. Reviving them means first
// having standalone Buzz and pinning `buzz` in mise.toml, which is not the case today.
//
// The stronger middle claim - "every spells/<dir>/spell.buzz by the registry compile
// that doctor's spell-contract check exercises" - is false in both halves. The
// built-in compile in cmd/magus-utils only sees one directory level and skips anything in
// its workspaceLocalSpells list; doctor only ever observes spells that REGISTERED, which a
// spell no magusfile imports never does. Two sources fall through both - see buzz-test.

// Runs the in-file `test "..." {}` blocks in this repo's own root Buzz modules, through
// magus's embedded engine.
//
// NOT the buzz spell's buzz-test op: that one forks the UPSTREAM `buzz` toolchain, which is
// not reliably on PATH, and it globs `find . -name '*.buzz'` from the project root - which
// here would sweep in magusfile.buzz, releaser.buzz, every spell and every worktree copy,
// none of which run standalone (they import magus host modules the bare toolchain cannot
// resolve). `magus buzz -t` is always present and is what CONTRIBUTING tells contributors to
// run, so the gate and the instruction agree.
//
// The list is explicit rather than globbed for the same reason: these two are the root
// modules that are pure library code with tests. badge.buzz's six tests and coverage.buzz's
// ten had never run in CI - nothing invoked them, and the buzz-check gate above only ever
// covered cmd/magus/starter/spells - so both files were free to rot while looking covered.
export fun buzz_test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("badge.buzz", "coverage.buzz", "releaser.buzz", "spells/**/*.buzz",
        "docs/lib/*.buzz", "std/lib/*.buzz", "tools/*.buzz");
    foreach (mod in ["badge.buzz", "coverage.buzz"]) {
        magus\cmd("buzz", args: ["-t", mod]);
    }
    // releaser.buzz carries the version and release-name rules `release` decides on, and no
    // target ran its test blocks: the two hand-named modules above were the whole root list,
    // so those tests passed for as long as they existed without being run. --embedded
    // because it is a magusfile import, the same reason tools/audit.buzz is.
    magus\cmd("buzz", args: ["-t", "--embedded", "releaser.buzz"]);
    // GLOBBED, for the reason the spell paragraph below gives, applied to the two trees
    // that were still hand-omitted. Both were carrying real breakage precisely because
    // nothing ran them:
    //
    //   std/lib/*.buzz  four of lcov.buzz's nine tests called assert\equal with no
    //                   `import "assert";`, so they failed the moment anything ran them.
    //                   An embedded stdlib module, so --embedded like the spells.
    //
    //   tools/*.buzz    registry.buzz did not PARSE. Three steps of
    //                   .github/workflows/registry.yaml invoke it as
    //                   `magus buzz tools/registry.buzz`, so the registry workflow was
    //                   dead - on a file that signs with MAGUS_REGISTRY_KEY.
    //
    // The MODE is per file, not per directory, because tools/ is not uniform.
    // registry.buzz is the only one invoked bare, so it is the only one that has to
    // survive strict; audit, drift and toolchain-policy are magusfile imports and
    // therefore always embedded, and running THEM strict would fail a top-level `if`
    // or an unlabeled second argument that is legal everywhere they actually load - a
    // red for a defect that does not exist. (toolchain.buzz has no importer and no
    // invoker at all; it is gated embedded on the assumption it is meant to be one.)
    foreach (mod in fs\glob("std/lib/*.buzz")) {
        magus\cmd("buzz", args: ["-t", "--embedded", mod.value]);
    }
    foreach (mod in fs\glob("tools/*.buzz")) {
        if (mod.value == "tools/registry.buzz") {
            magus\cmd("buzz", args: ["-t", mod.value]);
        } else {
            magus\cmd("buzz", args: ["-t", "--embedded", mod.value]);
        }
    }
    // Spell sources and the docs libraries carry ~90 more `test "..." {}` blocks that
    // nothing ran until 2026-08-09. That gap is why a broken escaper shipped: every one
    // of those files HAD tests, they passed, and no target invoked them.
    //
    // Two mechanical details, both learned the hard way. `--embedded` is required: these
    // files import magus/spell and the host modules, and without it `magus buzz` runs
    // upstream-strict and rejects the positional-argument style every one of them uses.
    // The docs libraries need `dir`, because they import each other by relative path
    // (`lib/text`) and resolve it from the docs project root.
    //
    // GLOBBED, unlike the root modules above, and that is the whole point. The list used
    // to name three spell sources by hand, which silently left `spells/aws/s3-cache` and
    // `spells/onepassword` under NO gate at all: neither is imported by any magusfile, so
    // neither ever registers for doctor's spell-contract check, and neither reaches the
    // built-in compile in cmd/magus-utils either - that scanner reads `spells/<dir>/spell.buzz`
    // one level deep, so a nested `aws/s3-cache` is invisible to it, and `onepassword` is
    // named in its workspaceLocalSpells skip list. A hand-maintained list reproduces exactly
    // that failure on the next spell someone adds, so match every source instead and let a
    // new spell be covered by existing.
    //
    // spells/examples/** is excluded because internal/dry's TestSpellExamplesParseAndRecord parses all
    // 48 of them, and they are illustrative sources that do not have to resolve host modules.
    foreach (spell in fs\glob("spells/**/*.buzz")) {
        if (spell.value.startsWith("spells/examples/")) { continue; }
        magus\cmd("buzz", args: ["-t", "--embedded", spell.value]);
    }
    foreach (lib in ["lib/text.buzz", "lib/dom.buzz", "lib/feed.buzz", "lib/html.buzz",
                     "lib/csp.buzz", "lib/url.buzz", "lib/date.buzz", "lib/glossary.buzz",
                     "lib/conventions.buzz"]) {
        magus\cmd("buzz", args: ["-t", "--embedded", lib], opts: {"dir": "docs"});
    }
}

// This project deliberately declares NO preflight: doctor running in one fails the build
// on a finding, making workspace conventions a blocker for everyone downstream. The
// advice action reports the same findings on the pull request, non-blocking - and unlike
// a preflight gate, that works for a consumer who never wired doctor into their own
// pipeline.
//
// What was left behind was an EMPTY preflight with no callers, which reported `[pass]` for
// doing nothing. The TypeScript projects keep theirs because it does real work there (an
// unconditional pnpm install), but a target that cannot fail and that nothing depends on
// is not a phase - it is a name. `preflight` is a convention, not a requirement; only `ci`
// is required (see docs/concepts/targets.md).

// Compiles one artifact: the host binary, or the container image under the `container` charm.
export fun build(ctx: magus\Context, args: [str])  > void {
    ctx.needs(format);
    if (ctx.hasCharm("container")) {
        ctx.needs(image_build);
    } else {
        ctx.needs(go_build);
    }
}
// Builds ./custom-gcl, the golangci-lint carrying this repo's own linters.
// golangci-lint compiles plugins in rather than loading them at runtime, so an
// in-repo rule only runs through a binary built here.
//
// The build runs in libs/testlayout because `golangci-lint custom` reads
// .custom-gcl.yml from its working directory and takes no config flag. That file
// lives with the linter it declares; `destination: ../..` puts the binary back at
// the root, where .golangci.yml and lint expect it.
//
// No declared outputs, for go-build's reason: those globs are what
// EnsureMergeDriver writes into .gitattributes, and /custom-gcl is gitignored, so
// declaring it would name an untrackable path. Same consequence too - a read-only
// run leaves no binary, so a fresh worktree needs this again.
export fun lint_build(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles("libs/testlayout/.custom-gcl.yml", "libs/testlayout/go.mod",
                   "libs/testlayout/go.sum", "libs/testlayout/**/*.go");
    proc\exec("golangci-lint", ["custom"], "libs/testlayout");
}

// Formats and builds the linter first, then golangci-lint, go vet, markdownlint,
// shellcheck, and actionlint. STATIC ANALYSIS only - govulncheck lives in `security`
// with the other scanners, because a scanner's answer changes when its advisory
// database does, with no edit to this tree.
// golangci-lint USED to go through the go spell's op so the spell's version probe
// (mgs_getVersionProbes) reached the cache key - without it a linter upgrade changes which
// code passes while every cache entry replays the old verdict. It no longer can: the binary
// is ./custom-gcl, built by lint_build, and the op runs whatever `golangci-lint` is on PATH.
// The readsFiles below carries that key by content instead - see the note at the call.
// Not through `go tool` either: that COMPILES the tool with whichever go leads PATH, which
// is how CI once built the linter with a different toolchain than it analyzed with, and
// panicked. lint_build now compiles golangci-lint itself and so inherits that hazard - it
// stays safe only because mise pins one go for both the build and the analysis. A job that
// runs lint_build without that pin can reproduce the panic.
// shellcheck covers the shell magus SHIPS - the completion script users source into their
// shell and the install script served at /magus/install - which was unlinted until it broke
// in a way only a user would have noticed.
// actionlint covers the workflows themselves - nothing else checked a `.github/workflows/*.yaml`
// edit before it ran on GitHub. It auto-detects the shellcheck binary already on PATH and
// lints every `run:` step's shell with it, so this needs no separate wiring for that half.
// The proto contract self-gates: the `proto` project owns its buf-lint/ci, run by
// `magus affected ci` when it's affected - the root does not reach into it.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(format, lint_build);
    // NOT go["golangci-lint"], which runs the stock binary off PATH and cannot see
    // an in-repo linter. That op existed to get the linter version into the cache
    // key; readsFiles does it by content instead. Its .custom-gcl.yml pins the
    // golangci-lint release and the testlayout globs cover the rule, while
    // `--version` on a custom binary carries a build timestamp that moves every
    // rebuild.
    ctx.readsFiles("libs/testlayout/.custom-gcl.yml", "libs/testlayout/**/*.go");
    // The tree this target analyzes, restated for the reason the same block on `test`
    // gives: a readsFiles call REPLACES the footprint, so the linter-version declaration
    // above dropped **/*.go, .golangci.yml and every markdown and shell glob out of this
    // key. golangci-lint and go vet compile the module (hence the assembly and cgo globs),
    // markdownlint reads the markdown and .markdownlintignore, shellcheck the shell,
    // actionlint the workflows, and .golangci.yml is the rule set whose edit must never
    // replay the verdict from the old one. No **/*.txtar: nothing here parses the fixtures.
    ctx.readsFiles("**/*.go", "**/*.s", "**/*.S", "**/*.c", "**/*.h",
                   "go.mod", "go.sum", "go.work", "go.work.sum", ".golangci.yml",
                   "**/*.md", ".markdownlintignore",
                   "**/*.sh", "**/*.bash", ".shellcheckrc",
                   ".github/workflows/*.yaml",
                   "mise.toml", "magus.yaml");
    // The linter cache lives inside this checkout, not at the user-global default.
    // golangci-lint (v2.12) keys package results by module-relative path + content,
    // relocatable across checkouts - but each stored issue carries the ABSOLUTE file
    // paths of whichever checkout analyzed the package first. Byte-identical sibling
    // worktrees replay each other's entries, so a neighbor's suppressed findings
    // resurface here as ../<sibling>/... paths that no ^-anchored exclusion in
    // .golangci.yml matches - measured: 25 stdversion findings from a sibling failing
    // a tree with zero of its own. A cold analysis per fresh worktree is the price.
    final lintCache = magus\projects().workspace + "/.magus/golangci-lint";
    os\withEnv({"GOLANGCI_LINT_CACHE": lintCache}, fun () > void !> any {
        proc\exec("./custom-gcl", ["run"]);
    });
    go["go-vet"](ctx);
    // Compile the browser playground for wasm. COMPILE only, to /dev/null: TinyGo
    // builds the shipped artifact, but that runs by hand and never in ci, so nothing
    // here ever type-checked the wasm configuration. Two breaks reached main that way -
    // std/crypto.go calling a checkRead that is //go:build !wasm, and a generated
    // trampoline missing its !wasm tag - each invisible until someone rebuilt the
    // playground.
    //
    // The stock go toolchain, not TinyGo: it is already pinned, it is fast, and the
    // failures worth catching are unresolved symbols under the wasm build tags, which
    // both compilers see identically. Not ./... either - the daemon and internal/proc
    // legitimately do not build for wasm (syscall.SIGHUP), so only the playground's
    // own dependency tree is graded.
    os\withEnv({"GOOS": "js", "GOARCH": "wasm"}, fun () > void !> any {
        proc\exec("go", ["build", "-o", "/dev/null", "./cmd/buzz-playground"]);
    });
    markdown.markdownlint(ctx);
    // The repo-root prose, named rather than walked. NOT markdown.typos: that op takes no
    // paths and walks the project directory, and THIS project's directory is the whole
    // workspace - so it would grade console's CSS and every other project's markdown as
    // part of the Go tree's lint. _typos.toml already narrows typos to prose by turning
    // the code types off; naming the files is the other half, and it is what this gate was
    // missing when `unlabeled` reached main through CHANGELOG.md. It surfaced one shard
    // over, in the docs project, because docs/changelog.md is a GENERATED MIRROR of the
    // root file - so the error pointed at generated output while the fix belonged here.
    final prose = ["README.md", "CHANGELOG.md", "CONTRIBUTING.md", "AGENTS.md"];
    ctx.readsFiles("_typos.toml", "README.md", "CHANGELOG.md", "CONTRIBUTING.md", "AGENTS.md");
    proc\exec("typos", ["--format", "brief"] + prose);
    bash["shellcheck"](ctx);
    proc\exec("actionlint", []);
}
// Regenerates, then formats Go, tidies `go.mod`, and formats Markdown. dprint rather than
// prettier because it needs no Node in the format path, and rather than biome because
// biome does not read Markdown at all. Every project with Markdown carries its own
// dprint.json and runs the op itself; see this project's for what a root-started run
// covers.
export fun format(ctx: magus\Context, args: [str]) > void {
    ctx.needs(generate);
    // Not writesFiles: gofmt amends authored code rather than producing it, so these
    // bytes must stay off the snapshot/replay path. Undeclared, this is MGS4007.
    ctx.modifiesExistingFiles("**/*.go", "go.mod", "go.sum");
    go["go-fmt"](ctx);
    go["go-mod-tidy"](ctx);
    // Scope dprint by ARGV, not by its config. dprint discovers a nested dprint.json and
    // formats that subtree under its own config, and neither this project's `includes`
    // nor an explicit --config prunes it - measured: a bare run here reaches 164 files,
    // 143 of them under docs/. That is the root target writing into descendant projects,
    // which magus rejects as MGS3001, and it stayed invisible only while every child's
    // markdown happened to be formatted already.
    //
    // Passing paths scopes it (10 files, none in a child project). The excludes in
    // dprint.json still apply, so MAGUS.md and CHANGELOG.md stay out. Keep this list in
    // step with that file's `includes`.
    ctx.modifiesExistingFiles("*.md", "benchmarks/**/*.md", "tapes/**/*.md",
        "internal/agent/agents-section.md");
    markdown["dprint"](ctx, {"args": ["./*.md", "./benchmarks/**/*.md", "./tapes/**/*.md",
        "./internal/agent/agents-section.md"]});
}

// Runs the CI gates through their declared dependencies.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint, build, test, coverage_badge, compress_cgo_test, completion_test, security);
}

// Exercises the completion scripts magus SHIPS, each inside the official image for its
// shell. Part of ci, and it REQUIRES a docker daemon rather than skipping without one:
// a gate that silently skips when a tool is missing is how the zsh recipe stayed broken
// - it told users to append a script to ~/.zshrc that registers nothing, and nothing
// ever ran it to find out. Its declared footprint keeps the cost off every run: affected
// only reaches it when the completion scripts or their checks change.
//
// One image per shell, pinned to a major-version tag, and nothing is installed into any
// of them: each image already carries its shell. There is no magus binary inside, so the
// checks assert the STATIC candidates; the project completions shell out to `magus ls`
// and are legitimately empty there.
//
// TODO: zsh is uncovered - it has no official image (zshusers/zsh is community-run), so
// the one shell with a confirmed bug is the one still untested. Revisit if an official
// image appears, or if a pinned community digest becomes acceptable.
// TODO: fish is uncovered for the same reason; upstream declined to publish an official
// image in fish-shell/fish-shell#3440.
export fun completion_test(ctx: magus\Context, args: [str]) > void !> any {
    // Declared so `magus affected` knows when this matters. Without it CI had to
    // re-derive the same answer with a git-diff grep in the workflow.
    ctx.readsFiles("hack/completion-checks/*", "cmd/magus/completions/*");
    try {
        proc\which("docker");
    } catch (e) {
        throw "completion-test needs a docker daemon: it runs each shell's official image";
    }
    // dotnet/sdk, not mcr.microsoft.com/powershell: the PowerShell team's own images are
    // deprecated in MCR, and the SDK image is what Microsoft points at for LTS pwsh.
    final checks = {
        "bash:5": "bash hack/completion-checks/bash.sh",
        "mcr.microsoft.com/dotnet/sdk:8.0": "pwsh -NoProfile -File hack/completion-checks/pwsh.ps1",
    };
    final root = vcs\root();
    foreach (image, cmd in checks) {
        var argv = mut ["-v", root + ":/w", "-w", "/w", image];
        foreach (part in cmd.split(" ")) { argv.append(part); }
        docker["docker-run"](ctx, {"args": argv});
    }
}

// Runs internal/compress's tests under the CGO tags, which the ordinary test target
// cannot reach.
//
// `go-test` passes no tags, so it compiles the pure-Go fallbacks and never the ~470
// lines of zstd_cgo.go and xz_cgo.go - exactly the files a release binary ships. The
// coverage figure hid it: 78.9% while the shipped half sat at zero.
//
// It cost correctness. The cgo zstd reader dropped ZSTD_decompressStream's hint, so a
// stream cut mid-frame returned io.EOF with a NIL error and a truncated cache artifact
// extracted as a complete-looking archive with files missing.
//
// REQUIRED, not skipped when pkg-config comes up empty - the call completion_test makes
// about docker, for the same reason: quietly skipping on a missing tool is how the
// untested half got here. CI already installs both -dev packages, and a host that cannot
// build this cannot build a release.
// The name diverges from the workspace's `test` convention on purpose, and magus's own
// conformance advice flags it. It is not the same work: this compiles with cgo and the
// liblzma/libzstd build tags, covers one package, and has a hard pkg-config precondition.
// A charm variant (`test:cgo`) cannot express it either - charms patch argv, and the
// distinguishing input here is CGO_ENABLED in the environment.
export fun compress_cgo_test(ctx: magus\Context, args: [str]) > void !> any {
    // Narrow: affected reaches this only when the codecs or their tests move.
    ctx.readsFiles("internal/compress/*.go");
    foreach (lib in ["libzstd", "liblzma"]) {
        proc\exec("pkg-config", ["--exists", lib], ".", {});
    }
    // The explicit args replace go-test's `./...` default (spells/golang/spell.buzz),
    // so this compiles one package, not every test binary in the module under
    // CGO_ENABLED=1 (a 4096MB, ~2m step when it did). -race and GOEXPERIMENT match
    // the test target so the dependency compiles share its build fingerprint.
    go["go-test"](ctx.withEnv({"CGO_ENABLED": "1", "GOEXPERIMENT": "jsonv2"}),
        {"args": ["-race", "-tags", "liblzma,libzstd", "./internal/compress/"]});
}

// Translates a `magus affected --plan` (read on stdin) into GitHub Actions shard-matrix
// outputs; the gha charm writes $GITHUB_OUTPUT, otherwise the matrix is only previewed.
export fun ci_shard(ctx: magus\Context, args: [str]) > void !> any {
    var input = "";
    if (!proc\stdinIsTerminal()) {
        input = io\stdin.readAll();
    }
    if (input == "") {
        throw "ci-shard: no shard plan on stdin - pipe one in: magus affected ci --plan | magus run ci-shard:gha";
    }
    final plan = serialize\jsonDecode(input);
    var include = mut [];
    foreach (row in plan.q("matrix").listValue()) {
        include.append({"shard": row.q("shard").stringValue(), "projects": row.q("projects").stringValue()});
    }
    final block = "matrix=" + serialize\jsonEncode({"include": include}) + "\n"
        + "count=" + plan.q("count").integerValue() + "\n"
        + "max_parallel=" + plan.q("max_parallel").integerValue() + "\n";

    if (!ctx.hasCharm("gha")) {
        magus\log.info("ci-shard preview (add the gha charm - `magus run ci-shard:gha` - to write $GITHUB_OUTPUT):\n" + block);
        return;
    }
    final path = os\env("GITHUB_OUTPUT");
    var p = "";
    if (path != null) { p = "{path}"; }
    if (p == "") {
        throw "ci-shard: the gha charm is set but $GITHUB_OUTPUT is unset - run this inside a GitHub Actions step";
    }
    var existing = "";
    if (fs\exists(p)) { existing = fs\readFile(p); }
    fs\writeFile(p, existing + block);

    // Render an actionable, portable summary to the job step summary.
    final summaryPath = os\env("GITHUB_STEP_SUMMARY");
    if (summaryPath != null and ("{summaryPath}") != "") {
        final sp = "{summaryPath}";
        var md = "## Affected CI plan\n\n"
            + plan.q("count").integerValue() + " shard(s), max parallel "
            + plan.q("max_parallel").integerValue() + "\n\n"
            + "| Shard | Projects |\n| --- | --- |\n";
        foreach (row in plan.q("matrix").listValue()) {
            var projects = row.q("projects").stringValue();
            if (projects == ".") { projects = "magus"; }
            if (projects.startsWith(". ")) { projects = "magus" + projects.sub(1, projects.len()); }
            md = md + "| " + row.q("shard").stringValue() + " | " + projects + " |\n";
        }
        md = md + "\n**What this means:** each shard runs the listed projects concurrently within the declared limit. "
            + "To inspect why a project was selected, run `magus affected ci --explain` locally. "
            + "[Affected CI guide](https://eli.gladman.cc/magus/guides/affected/) - "
            + "[CI target guide](https://eli.gladman.cc/magus/concepts/targets/ci/)\n";
        var existingSummary = "";
        if (fs\exists(sp)) { existingSummary = fs\readFile(sp); }
        fs\writeFile(sp, existingSummary + md);
    }
}

// rebuild_console rebuilds console/gen with the console project's own esbuild build
// (pnpm run build), installing its deps first on a cold tree. Run from the console/
// dir so pnpm resolves that project's package.json.
// Always let pnpm validate the install, matching console/magusfile.buzz. An interrupted
// install leaves a node_modules that EXISTS but is incomplete, and the isDir guard this
// replaced read that as ready and handed the missing packages to esbuild. On a warm tree
// --frozen-lockfile is about a second and changes nothing.
fun rebuild_console() > void !> any {
    proc\exec("pnpm", ["install", "--frozen-lockfile"], "console", {});
    proc\exec("pnpm", ["run", "build"], "console", {});
}

// rerender_docs re-renders docs/gen via the docs project's fast `render` target.
// It shells out to magus rather than calling render.site_render in-process because
// docs/render.buzz flat-imports its helpers (render_text, render_html, ...) with
// plain names that resolve relative to the CWD - only inside the docs project dir,
// never the workspace root - so a sub-invocation (which sets CWD=docs) is the only
// way those imports resolve. Prefer $MAGUS (the running binary's resolved path, set
// for magus child processes) and fall back to `magus` on PATH.
fun rerender_docs() > void !> any {
    var bin = os\env("MAGUS");
    if (bin == null or ("{bin}") == "") { bin = "magus"; }
    proc\exec("{bin}", ["run", "render", "docs"], ".", {});
}

// missing_input phrases a deploy-generate precondition that ANOTHER project owns.
//
// Naming one single-project command teaches the wrong habit: the reader runs it, gets the
// next precondition, runs another, and learns the set by failing once per producer. So name
// every producer in one command. `magus run <target> [project...]` takes a LIST - `magus run
// build docs console` is one dispatch over both - which is the idiom this message teaches.
//
// Deliberately NOT "magus affected build" or "magus run build /". Both would include this
// project, and neither can order it after the producers: the root declares no dependency on
// docs or console, so there is no edge to schedule on. It cannot declare one either - docs
// already depends on the root, so the reverse edge closes a cycle. That missing edge is
// exactly why this runtime check exists instead of ctx.needs, and why the remedy has to name
// the producers rather than a whole-workspace verb that would just fail here first.
//
// The command leads the sentence: a long cause line is elided with an ellipsis in run
// output, so anything after the first clause may never reach the reader.
//
// Defined ABOVE deploy-generate's doc comment, not between it and the target: the extractor
// binds the immediately preceding comment run to the next declaration, so sitting in that
// gap silently stole the target's doc string out of the graph.
fun missing_input(path: str, project: str) > str {
    return "deploy-generate: " + path
        + " is missing - run `magus run build docs console` first (one dispatch, both "
        + "producers). The " + project + " project owns it, and this target reads across "
        + "that boundary without depending on it, so no run order builds it for you.";
}

// deploy-generate assembles gen/site: the exact tree the Pages deploy publishes, docs at
// the root of it and the console app under /console/.
//
// It lives here rather than in the Pages workflow because that workflow is meant to be thin -
// set up a toolchain, name targets, upload the artifact - and the layout below is portable
// logic that would otherwise be GitHub-specific shell. It is also what makes the deploy
// reproducible locally: run the same three commands, then serve gen/site, and what you see
// is what publishes.
//
// It ASSEMBLES ONLY. Driving the two builds itself (magus\run of docs generate and
// console build) would let one command reproduce the deploy, and trips MGS3001: a root
// target that writes into a descendant project's tree breaks the boundary the cache and the
// affected set are computed over. The ward is right, and the fix is not to widen the parent's
// footprint - it is for each project to write its own tree. So the caller runs the two
// builds, then this. That is still three target names and no logic in the workflow, which is
// what the thin-workflow rule actually asks for.
//
// Named -generate, and excluded from the umbrella by name. The root `generate` target above
// is `ctx.needs(ctx.glob("*-generate", "!deploy-generate"))`: the suffix would otherwise
// enroll a full tree copy in every `magus run generate`, to satisfy a drift gate over output
// that is deliberately gitignored. Before negation existed the only remedy was to avoid the
// name - which is what termcast-record and termcast-showcase above still do, and what this
// target was first called (build-site). Renaming around a matcher hides the reason at both
// ends: the glob does not say what it is missing, and the target does not say why it is
// called something else. "!deploy-generate" says it once, where it applies.
//
// NOT site-generate: the docs project already exports a target by that name, and two targets
// called the same thing in one workspace - one rendering docs/gen, one assembling the whole
// deploy - is a coin flip every time someone types it. NOT website-generate either: this repo
// renamed website/ to docs/ deliberately, so "website" is retired vocabulary. "site" itself is
// the house term (the Site type, site_render, site_publish, docs/site/), which is exactly why
// it needed a qualifier here rather than a replacement.
export fun deploy_generate(ctx: magus\Context, args: [str]) > void !> any {
    final DOCS_GEN = "docs/gen";
    final CONSOLE_GEN = "console/gen";
    // gen/site, not a new top-level name: gen/ is what every project in this workspace
    // calls its generated output (docs/gen, console/gen, proto/gen, and this project's own
    // gen/*.json). The root's gen/*.json output glob is file-level, so the two do not
    // overlap. Inventing a second convention for "generated output" would only ever be a
    // thing to explain.
    final OUT = "gen/site";

    // Both trees are generated now, not committed, so "missing" no longer means someone
    // deleted a file - it means a build did not run, or silently produced nothing. Publishing
    // that would replace a working site with an empty one, so say which command is missing.
    if (!fs\exists(DOCS_GEN + "/index.html")) {
        throw missing_input(DOCS_GEN + "/index.html", "docs");
    }
    if (!fs\exists(CONSOLE_GEN + "/index.html")) {
        throw missing_input(CONSOLE_GEN + "/index.html", "console");
    }

    // Rebuilt from empty every time: a stale page left behind by a previous assembly would
    // publish as a live URL that no source produces any more.
    if (fs\exists(OUT)) { fs\removeAll(OUT); }
    fs\copyDir(DOCS_GEN, OUT);
    // The console project OWNS /console/, so its subtree is replaced wholesale. This discards
    // the docs render's /console/ redirect stub, which exists only to satisfy the docs
    // asset-integrity gate, so the real app wins - the same precedence `serve` gets from
    // longest-prefix mount routing.
    if (fs\exists(OUT + "/console")) { fs\removeAll(OUT + "/console"); }
    fs\copyDir(CONSOLE_GEN, OUT + "/console");

    magus\log.info("assembled " + OUT + " - docs at /, console at /console/");
}

// serve is the workspace-root dev loop for BOTH deployables. ONE web server hosts the
// two rendered gen/ trees (generated, not committed) with the GitHub Pages pathing - "/" serves docs/gen and
// "/console/" serves console/gen, where the console SPA SHADOWS the docs render's
// /console/ redirect stub (longest-prefix routing in http.server's mounts mode),
// exactly like the deploy that assembles docs/gen at the root and console/gen under
// /console/. It spans both projects, so it lives at the workspace root rather than in
// Serves prebuilt docs and console under one local origin.
//
// Reports installed toolchains; excluded from CI because it probes remote tags.
export fun toolchain_report(ctx: magus\Context, args: [str]) > void !> any {
    toolchains\report();
}

export fun serve(ctx: magus\Context, args: [str]) > void !> any {
    final DOCS_GEN = "docs/gen";
    final CONSOLE_GEN = "console/gen";
    if (!fs\isDir(DOCS_GEN)) { throw "serve: " + DOCS_GEN + " not found - run `magus run build docs` first"; }
    if (!fs\isDir(CONSOLE_GEN)) { throw "serve: " + CONSOLE_GEN + " not found - run `magus run build console` first"; }

    // No port -> http.server scans from 8080 for the first free one and returns it, so
    // the printed URL is correct even when 8080 is busy. "/console/" is longer than
    // "/", so a /console/ request routes (longest-prefix) to the console tree.
    final port = http\server({"mounts": {"/": DOCS_GEN, "/console/": CONSOLE_GEN}});
    magus\log.info("serving the deploy at http://localhost:{port}/");
    magus\log.info("  /          -> " + DOCS_GEN + "  (docs)");
    magus\log.info("  /console/  -> " + CONSOLE_GEN + "  (console SPA, shadows the docs /console/ redirect)");
    magus\log.info("static server only; rebuild docs or console in its owning project, then refresh");
    // Keep the target alive while http.server owns its background listener. This is a passive
    // watch: no child project outputs are mutated here, and their owning build target can run
    // independently while the next request observes the files it produced.
    fs\watch(["."], fun(changed: [str]) > bool { return false; });
}
