/// reclaimdisk plans and takes back the disk a repository's git worktrees and merged agent
/// branches hold. It never removes a worktree holding uncommitted files, a commit no remote
/// or base has, a live job, a working process or a lock.
///
/// It knows no toolchain: it trims only what a spell gives a budget. tick is
/// the one decider every trigger calls, and chunk is its worktree half.
namespace reclaimdisk;

import "std";
import "strings";
import "fs";
import "os";
import "proc";
import "vcs";
import "magus";
import "diskwatch";
import "result";
import "time";

import "assert";

final AGENT_BRANCHES = ["refs/heads/worktree-agent-*", "refs/heads/agent-*"];

/// CHUNK_WORKTREES is how many worktrees one chunk removes: small enough that a chunk ends
/// well inside its deadline, so space comes back in steps rather than all at once.
export final CHUNK_WORKTREES = 2;

/// CHUNK_MS is a tick's deadline from its start, inside CHUNK_WINDOW_MS.
export final CHUNK_MS = 540000.0;

/// TRIM_MS bounds the cache half of a tick, so the worktree half gets its turn.
final TRIM_MS = 240000.0;

export object Worktree {
    path: str,
    branch: str,
}

/// Status is one worktree's dirt: dirty counts uncommitted files, -1 when the directory is
/// gone, and unpushed counts commits on no remote-tracking ref.
export object Status {
    dirty: int,
    unpushed: int,
}

/// Observed is what git and the filesystem say about one worktree; unique counts the
/// commits on no remote and not in the base, and touched is Unix millis.
export object Observed {
    path: str,
    branch: str = "",
    dirty: int = 0,
    unique: int = 0,
    locked: str? = null,
    touched: double = 0.0,
}

export object Cwd {
    pid: str,
    dir: str,
}

export object Lease {
    id: str,
    state: str,
    checkoutRoot: str,
}

export object Cache {
    path: str,
    kind: str,
    kib: int,
}

/// Item is one row of the plan: a worktree or an agent branch. class is
/// removable, keep or report; kib is -1 when not measured; a held branch's path is the
/// worktree holding it.
export object Item {
    kind: str,
    name: str,
    class: str,
    reasons: [str],
    keys: [str] = [<str>],
    kib: int = -1,
    caches: [Cache] = [<Cache>],
    path: str = "",
    branch: str = "",
    tip: str = "",
    touched: double = 0.0,
    result: str = "",
}

export object Totals {
    worktrees: int,
    removableWorktrees: int,
    removableKiB: int,
    branches: int,
    kept: int,
    keptBy: {str: int},
}

export object Survey {
    root: str,
    base: str,
    items: [Item],
}

/// parseWorktrees reads `git worktree list --porcelain`: one stanza per worktree, the main
/// one first.
export fun parseWorktrees(porcelain: str) > [Worktree] {
    final found = mut [<Worktree>];
    var path = "";
    var branch = "";
    foreach (line in porcelain.split("\n") + [""]) {
        if (line.startsWith("worktree ")) {
            path = line.sub(9);
        } else if (line.startsWith("branch refs/heads/")) {
            branch = line.sub(18);
        } else if (line == "detached") {
            branch = "(detached)";
        } else if (line == "" and path != "") {
            found.append(Worktree{ path = path, branch = branch });
            path = "";
            branch = "";
        }
    }
    return found;
}

/// displayPath is path relative to the main worktree when it sits under it.
export fun displayPath(path: str, main: str) > str {
    if (path == main) { return "."; }
    if (path.startsWith(main + "/")) { return path.sub(main.len() + 1); }
    return path;
}


export fun age(ms: double) > str {
    final minutes = std\toInt(ms / 60000.0);
    if (minutes < 120) { return "{minutes}m"; }
    if (minutes < 2880) { return "{minutes / 60}h"; }
    return "{minutes / 1440}d";
}

export fun size(kib: int) > str {
    if (kib < 0) { return "-"; }
    if (kib < 1024) { return "{kib} KiB"; }
    if (kib < 1048576) { return "{kib / 1024} MiB"; }
    final tenths = kib * 10 / 1048576;
    return "{tenths / 10}.{tenths % 10} GiB";
}

export fun parseCwds(lsof: str) > [Cwd] {
    final found = mut [<Cwd>];
    var pid = "";
    foreach (line in lsof.split("\n")) {
        if (line.startsWith("p")) {
            pid = line.sub(1);
        } else if (line.startsWith("n") and pid != "") {
            found.append(Cwd{ pid = pid, dir = line.sub(1) });
        }
    }
    return found;
}

/// pidsByWorktree gives each process to the deepest worktree holding its working directory:
/// linked worktrees nest inside the main one, and a process in a linked worktree is not
/// working in the main one.
export fun pidsByWorktree(cwds: [Cwd], paths: [str]) > {str: [str]} {
    final byPath = mut {<str: [str]>};
    foreach (c in cwds) {
        var best = "";
        foreach (p in paths) {
            if ((c.dir == p or c.dir.startsWith(p + "/")) and p.len() > best.len()) { best = p; }
        }
        if (best == "") { continue; }
        final acc = (byPath[best] ?? [<str>]).cloneMutable();
        if (acc.indexOf(c.pid) == null) { acc.append(c.pid); }
        byPath[best] = acc;
    }
    return byPath;
}

/// liveLeases is each checkout's live jobs as "<id> (<state>)". Exited counts as live: the
/// holder owns the checkout until its result is graded.
export fun liveLeases(leases: [Lease]) > {str: [str]} {
    final byRoot = mut {<str: [str]>};
    foreach (l in leases) {
        if (l.checkoutRoot == "" or ["declared", "running", "exited"].indexOf(l.state) == null) { continue; }
        final acc = (byRoot[l.checkoutRoot] ?? [<str>]).cloneMutable();
        acc.append("{l.id} ({l.state})");
        byRoot[l.checkoutRoot] = acc;
    }
    return byRoot;
}

/// classify decides one worktree, listing every reason to keep it rather than the first.
export fun classify(o: Observed, main: str, own: str, leases: {str: [str]}, pids: {str: [str]}, now: double, keepRecent: double, shown: str) > Item {
    final reasons = mut [<str>];
    final keys = mut [<str>];
    fun keep(key: str, why: str) > void {
        keys.append(key);
        reasons.append(why);
    }
    if (o.path == main) { keep("main", why: "the main worktree, which holds the repository"); }
    if (o.path == own) { keep("own", why: "the caller's own checkout"); }
    if (o.dirty < 0) {
        keep("gone", why: "its directory is gone, so nothing to reclaim; `git worktree prune` clears the record");
    }
    if (o.locked -> lock) {
        if (lock == "") { keep("locked", why: "locked"); } else { keep("locked", why: "locked: {lock}"); }
    }
    if (o.dirty > 0) { keep("dirty", why: strings\pluralCount(o.dirty, one: "uncommitted file", many: "uncommitted files")); }
    if (o.unique > 0) { keep("unique", why: "{strings\pluralCount(o.unique, one: "commit", many: "commits")} on no remote and not in the base"); }
    foreach (l in leases[o.path] ?? [<str>]) { keep("lease", why: "live job {l}"); }
    final working = pids[o.path] ?? [<str>];
    if (working.len() > 0) { keep("process", why: "working directory of pid {working.join(", ")}"); }
    final idle = now - o.touched;
    if (o.dirty >= 0 and idle < keepRecent) { keep("recent", why: "touched {age(idle)} ago, within --keep-recent"); }
    if (reasons.len() > 0) {
        return Item{ kind = "worktree", name = shown, class = "keep", reasons = reasons, keys = keys, path = o.path, branch = o.branch, touched = o.touched };
    }
    return Item{ kind = "worktree", name = shown, class = "removable", path = o.path, branch = o.branch, touched = o.touched,
        reasons = ["clean, every commit on a remote or the base, no live job, process or lock, untouched for {age(idle)}"] };
}

/// branchItems lists the agent branches whose loss loses nothing: no kept worktree holds
/// them and no commit on them is missing from every remote and the base. A branch held by
/// a removable worktree is listed with that worktree as its path.
export fun branchItems(tips: {str: str}, held: {str: str}, removable: [str], unique: [str]) > [Item] {
    final found = mut [<Item>];
    final names = tips.keys().cloneMutable();
    names.sort(fun (a: str, b: str) > bool => a < b);
    foreach (name in names) {
        if (unique.indexOf(name) != null) { continue; }
        final holder = held[name];
        var why = "no worktree holds it";
        if (holder -> h) {
            if (removable.indexOf(h) == null) { continue; }
            why = "its worktree is removed by this plan";
        }
        found.append(Item{ kind = "branch", name = name, class = "removable", kib = 0, branch = name, tip = tips[name]!, path = holder ?? "",
            reasons = ["{why}; every commit is on a remote or the base"] });
    }
    return found;
}

/// parseUniqueBranches reads `git log --format=%D --decorate-refs=refs/heads/`: the names
/// decorating a commit no remote and no base reaches.
export fun parseUniqueBranches(log: str) > [str] {
    final found = mut [<str>];
    foreach (line in log.split("\n")) {
        foreach (word in line.split(",")) {
            var name = word.trim();
            if (name.startsWith("HEAD -> ")) { name = name.sub(8); }
            if (name != "" and name != "HEAD" and found.indexOf(name) == null) { found.append(name); }
        }
    }
    return found;
}

fun classRank(c: str) > int {
    if (c == "removable") { return 0; }
    if (c == "report") { return 1; }
    return 2;
}

/// rank orders the plan largest reclaim first; unmeasured rows follow, removable before kept.
export fun rank(items: [Item]) > [Item] {
    final ranked = items.cloneMutable();
    _ = ranked.sort(fun (a: Item, b: Item) > bool {
        if (a.kib != b.kib) { return a.kib > b.kib; }
        if (a.class != b.class) { return classRank(a.class) < classRank(b.class); }
        return a.name < b.name;
    });
    return ranked;
}

/// pickChunk is one chunk of the plan: the n removable worktrees untouched longest, the
/// branches they hold, and every branch no worktree holds. A kept row is never in it.
export fun pickChunk(items: [Item], n: int) > [Item] {
    final worktrees = items.filter(fun (i: int, it: Item) > bool => it.kind == "worktree" and it.class == "removable").cloneMutable();
    _ = worktrees.sort(fun (a: Item, b: Item) > bool => a.touched < b.touched);
    final picked = mut [<Item>];
    final paths = mut [<str>];
    foreach (it in worktrees) {
        if (picked.len() >= n) { break; }
        picked.append(it);
        paths.append(it.path);
    }
    foreach (it in items) {
        if (it.kind == "branch" and it.class == "removable" and (it.path == "" or paths.indexOf(it.path) != null)) { picked.append(it); }
    }
    return picked;
}

export fun totals(items: [Item]) > Totals {
    var worktrees = 0;
    var removable = 0;
    var kib = 0;
    var branches = 0;
    var kept = 0;
    final by = mut {<str: int>};
    foreach (it in items) {
        if (it.kind == "worktree") { worktrees = worktrees + 1; }
        if (it.kind == "worktree" and it.class == "removable") {
            removable = removable + 1;
            if (it.kib > 0) { kib = kib + it.kib; }
        }
        if (it.kind == "branch") { branches = branches + 1; }
        if (it.kind == "worktree" and it.class == "keep") {
            kept = kept + 1;
            foreach (k in it.keys) { by[k] = (by[k] ?? 0) + 1; }
        }
    }
    return Totals{ worktrees = worktrees, removableWorktrees = removable, removableKiB = kib, branches = branches, kept = kept, keptBy = by };
}

fun pad(s: str, width: int) > str {
    if (s.len() >= width) { return s; }
    return s + " ".repeat(width - s.len());
}

final KEY_ORDER = ["dirty", "unique", "lease", "process", "locked", "recent", "own", "main", "gone"];

export fun render(items: [Item]) > [str] {
    var width = 4;
    foreach (it in items) {
        if (it.name.len() > width and it.name.len() <= 60) { width = it.name.len(); }
    }
    final lines = mut ["{pad("CLASS", width: 9)}  {pad("SIZE", width: 9)}  {pad("ITEM", width: width)}  REASON"];
    foreach (it in items) {
        final result = if (it.result == "") "" else "  [{it.result}]";
        lines.append("{pad(it.class, width: 9)}  {pad(size(it.kib), width: 9)}  {pad(it.name, width: width)}  {it.reasons.join("; ")}{result}");
        foreach (c in it.caches) {
            lines.append("{pad("", width: 9)}  {pad(size(c.kib), width: 9)}    {c.path} ({c.kind})");
        }
    }
    final t = totals(items);
    final by = mut [<str>];
    foreach (k in KEY_ORDER) {
        if (t.keptBy[k] -> n) { by.append("{k} {n}"); }
    }
    lines.append("");
    lines.append("removable: {strings\pluralCount(t.removableWorktrees, one: "worktree", many: "worktrees")} ({size(t.removableKiB)}), {strings\pluralCount(t.branches, one: "agent branch", many: "agent branches")}");
    lines.append("kept: {t.kept} of {t.worktrees} worktrees, by reason (one worktree can have several): {by.join(", ")}");
    return lines;
}

/// guardLine is the shell line the guard judges for one removal: the same argv vcs\cmd runs,
/// from the same directory. A path needing quotes gets no line, since the guard would judge
/// different words than git receives.
export fun guardLine(root: str, path: str) > str? {
    for (var i = 0; i < path.len(); i = i + 1) {
        final b = path.sub(i, len: 1);
        if (!((b >= "a" and b <= "z") or (b >= "A" and b <= "Z") or (b >= "0" and b <= "9") or b == "/" or b == "." or b == "_" or b == "-")) {
            return null;
        }
    }
    return "git -C {root} worktree remove {path}";
}

fun count(items: [Item], kind: str, result: str) > int {
    return items.filter(fun (i: int, it: Item) > bool => it.kind == kind and it.result == result).len();
}

/// headline is the plan's one-line summary; trimmed, when not empty, is what a cache trim
/// the caller ran reported, and follows it.
export fun headline(items: [Item], applied: bool, trimmed: str) > str {
    final t = totals(items);
    final tail = if (trimmed == "") "" else "; {trimmed}";
    if (!applied) {
        return "dry run: nothing removed; --apply removes {strings\pluralCount(t.removableWorktrees, one: "worktree", many: "worktrees")} ({size(t.removableKiB)}) and {strings\pluralCount(t.branches, one: "agent branch", many: "agent branches")}{tail}";
    }
    var kib = 0;
    foreach (it in items) {
        if (it.kind == "worktree" and it.result == "removed" and it.kib > 0) { kib = kib + it.kib; }
    }
    return "removed {count(items, kind: "worktree", result: "removed")} of {strings\pluralCount(t.removableWorktrees, one: "removable worktree", many: "removable worktrees")} ({size(kib)}) and deleted {count(items, kind: "branch", result: "deleted")} of {strings\pluralCount(t.branches, one: "agent branch", many: "agent branches")}{tail}";
}

/// budget is the timeoutMs a call at now may take, 0 for no bound.
/// It errors once the deadline has passed, so a chunk stops between steps.
fun budget(deadline: double, now: double) > result\Result::<double> {
    if (deadline <= 0.0) { return result\ok::<double>(0.0); }
    if (now >= deadline) { return result\fail::<double>("reclaimdisk: past its deadline"); }
    return result\ok::<double>(deadline - now);
}

fun bound(deadline: double) > result\Result::<double> {
    return budget(deadline, now: os\time());
}

fun git(dir: str, args: [str], deadline: double) > result\Result::<str> {
    final left = bound(deadline);
    if (left.error -> e) { return result\Result::<str>{ error = e }; }
    try {
        return result\ok::<str>(vcs\cmd(args, opts: vcs\CommandOptions{ dir = dir, quiet = true, timeoutMs = left.value! }).stdout);
    } catch (err: any) {
        return result\caught::<str>(err);
    }
}

fun gitOk(dir: str, args: [str], deadline: double) > result\Result::<bool> {
    final left = bound(deadline);
    if (left.error -> e) { return result\Result::<bool>{ error = e }; }
    try {
        return result\ok::<bool>(vcs\cmd(args, opts: vcs\CommandOptions{ dir = dir, quiet = true, allowFailure = true, timeoutMs = left.value! }).code == 0);
    } catch (err: any) {
        return result\caught::<bool>(err);
    }
}

fun countLines(text: str) > int {
    return text.split("\n").filter(fun (i: int, line: str) > bool => line.trim() != "").len();
}

/// status reads one worktree's dirt; a directory that is gone reads dirty -1.
export fun status(path: str, deadline: double) > result\Result::<Status> {
    try {
        if (!fs\isDir(path)) { return result\ok::<Status>(Status{ dirty = -1, unpushed = 0 }); }
        final porcelain = git(path, args: ["--no-optional-locks", "status", "--porcelain"], deadline: deadline);
        if (porcelain.error -> e) { return result\Result::<Status>{ error = e }; }
        final ahead = git(path, args: ["rev-list", "--count", "HEAD", "--not", "--remotes"], deadline: deadline);
        if (ahead.error -> e) { return result\Result::<Status>{ error = e }; }
        return result\ok::<Status>(Status{ dirty = countLines(porcelain.value!), unpushed = std\parseInt(ahead.value!.trim()) ?? 0 });
    } catch (err: any) {
        return result\caught::<Status>(err, doing: "reclaimdisk: read a worktree's dirt");
    }
}

/// readGitDir is a linked worktree's administrative directory, from the gitdir line of its
/// .git file.
fun readGitDir(path: str) > result\Result::<str> {
    final dotgit = path + "/.git";
    try {
        if (!fs\isFile(dotgit)) { return result\ok::<str>(dotgit); }
        final line = fs\readFile(dotgit).trim();
        if (!line.startsWith("gitdir: ")) { return result\ok::<str>(""); }
        final dir = line.sub(8);
        if (dir.startsWith("/")) { return result\ok::<str>(dir); }
        return result\ok::<str>(path + "/" + dir);
    } catch (err: any) {
        return result\caught::<str>(err);
    }
}

fun touchedAt(path: str, gitdir: str) > result\Result::<double> {
    var newest = 0.0;
    try {
        foreach (p in [path, gitdir + "/index", gitdir + "/HEAD", gitdir + "/logs/HEAD"]) {
            if (fs\exists(p)) {
                final m = fs\stat(p).mtime;
                if (m > newest) { newest = m; }
            }
        }
    } catch (err: any) {
        return result\caught::<double>(err);
    }
    return result\ok::<double>(newest);
}

fun readLock(gitdir: str) > result\Result::<str?> {
    final f = gitdir + "/locked";
    try {
        if (gitdir == "" or !fs\isFile(f)) { return result\ok::<str?>(null); }
        return result\ok::<str?>(fs\readFile(f).trim());
    } catch (err: any) {
        return result\caught::<str?>(err);
    }
}

fun duKiB(path: str, deadline: double) > result\Result::<int> {
    final left = bound(deadline);
    if (left.error -> e) { return result\Result::<int>{ error = e }; }
    try {
        // du exits 1 when one entry is unreadable and still prints the total of the rest.
        final res = proc\exec("du", args: ["-sk", path], opts: proc\ExecOptions{ quiet = true, allowFailure = true, timeoutMs = left.value! });
        return result\ok::<int>(std\parseInt(res.stdout.trim().split("\t")[0]) ?? -1);
    } catch (err: any) {
        return result\caught::<int>(err);
    }
}

/// caches lists the ignored build state git status reports at the top of a worktree's
/// ignored directories: the per-checkout magus cache, node_modules, and the magus binary.
fun caches(path: str, deadline: double) > result\Result::<[Cache]> {
    final found = mut [<Cache>];
    final ignored = git(path, args: ["--no-optional-locks", "status", "--porcelain", "--ignored"], deadline: deadline);
    if (ignored.error -> e) { return result\Result::<[Cache]>{ error = e }; }
    foreach (line in ignored.value!.split("\n")) {
        if (!line.startsWith("!! ")) { continue; }
        final entry = line.sub(3);
        var kind = "";
        if (entry == ".magus/") {
            kind = "magus cache";
        } else if (entry == "node_modules/" or entry.endsWith("/node_modules/")) {
            kind = "node_modules";
        } else if (entry == "magus") {
            kind = "magus binary";
        }
        if (kind != "") {
            final size = duKiB(path + "/" + entry, deadline: deadline);
            if (size.error -> e) { return result\Result::<[Cache]>{ error = e }; }
            found.append(Cache{ path = entry, kind = kind, kib = size.value! });
        }
    }
    _ = found.sort(fun (a: Cache, b: Cache) > bool => a.kib > b.kib);
    return result\ok::<[Cache]>(found);
}

fun processCwds(deadline: double) > result\Result::<[Cwd]> {
    try {
        _ = proc\which("lsof");
    } catch (e) {
        return result\fail::<[Cwd]>("reclaimdisk: lsof is not on PATH, so which processes work inside a worktree cannot be read; install it rather than plan blind");
    }
    final left = bound(deadline);
    if (left.error -> e) { return result\Result::<[Cwd]>{ error = e }; }
    try {
        // lsof exits 1 when it cannot read some process, and still lists every one it can.
        return result\ok::<[Cwd]>(parseCwds(proc\exec("lsof", args: ["-d", "cwd", "-Fpn", "-w"], opts: proc\ExecOptions{ quiet = true, allowFailure = true, timeoutMs = left.value! }).stdout));
    } catch (err: any) {
        return result\caught::<[Cwd]>(err);
    }
}

fun jobLeases() > result\Result::<[Lease]> {
    try {
        final list: magus\JobList = magus\workspace().jobs();
        return result\ok::<[Lease]>(list.jobs.map(fun (i: int, j: magus\Job) > Lease => Lease{ id = j.id, state = j.state.value, checkoutRoot = j.checkoutRoot }));
    } catch (err: any) {
        return result\caught::<[Lease]>(err);
    }
}

fun agentBranches(root: str, base: str, baseOk: bool, deadline: double) > result\Result::<{str: {str: str}}> {
    final tips = mut {<str: str>};
    final refs = git(root, args: ["for-each-ref", "--format=%(refname:short) %(objectname)"] + AGENT_BRANCHES, deadline: deadline);
    if (refs.error -> e) { return result\Result::<{str: {str: str}}>{ error = e }; }
    foreach (line in refs.value!.split("\n")) {
        final parts = line.trim().split(" ");
        if (parts.len() == 2) { tips[parts[0]] = parts[1]; }
    }
    final logArgs = mut ["log", "--format=%D", "--decorate-refs=refs/heads/"];
    foreach (p in AGENT_BRANCHES) { logArgs.append("--branches={p.sub(11)}"); }
    logArgs.append("--not");
    logArgs.append("--remotes");
    if (baseOk) { logArgs.append(base); }
    final unique = mut {<str: str>};
    final decorated = git(root, args: logArgs, deadline: deadline);
    if (decorated.error -> e) { return result\Result::<{str: {str: str}}>{ error = e }; }
    foreach (name in parseUniqueBranches(decorated.value!)) { unique[name] = name; }
    return result\ok::<{str: {str: str}}>({"tips": tips, "unique": unique});
}

fun observe(t: Worktree, main: str, base: str, baseOk: bool, deadline: double) > result\Result::<Observed> {
    final read = status(t.path, deadline: deadline);
    if (read.error -> e) { return result\Result::<Observed>{ error = e }; }
    final st = read.value!;
    var unique = 0;
    if (st.dirty >= 0 and st.unpushed > 0) {
        unique = st.unpushed;
        if (baseOk) {
            final count = git(t.path, args: ["rev-list", "--count", "HEAD", "--not", "--remotes", base], deadline: deadline);
            if (count.error -> e) { return result\Result::<Observed>{ error = e }; }
            unique = std\parseInt(count.value!.trim()) ?? unique;
        }
    }
    var gitdir = "";
    var locked: str? = null;
    if (t.path != main) {
        final dir = readGitDir(t.path);
        if (dir.error -> e) { return result\Result::<Observed>{ error = e }; }
        gitdir = dir.value!;
        final lock = readLock(gitdir);
        if (lock.error -> e) { return result\Result::<Observed>{ error = e }; }
        locked = lock.value!;
    }
    var touched = 0.0;
    if (st.dirty >= 0) {
        final at = touchedAt(t.path, gitdir: if (gitdir == "") t.path + "/.git" else gitdir);
        if (at.error -> e) { return result\Result::<Observed>{ error = e }; }
        touched = at.value!;
    }
    return result\ok::<Observed>(Observed{ path = t.path, branch = t.branch, dirty = st.dirty, unique = unique, locked = locked, touched = touched });
}

/// survey reads every worktree and agent branch of the repository at the working directory
/// and returns the plan, unranked; measure runs du on each removable worktree.
export fun survey(base: str, now: double, keepRecent: double, measure: bool, deadline: double) > result\Result::<Survey> {
    try {
        final root = vcs\root();
        final listed = git(root, args: ["worktree", "list", "--porcelain"], deadline: deadline);
        if (listed.error -> e) { return result\Result::<Survey>{ error = e }; }
        final trees = parseWorktrees(listed.value!);
        final main = if (trees.len() > 0) trees[0].path else "";
        final verified = gitOk(root, args: ["rev-parse", "--verify", "--quiet", base + "^0"], deadline: deadline);
        if (verified.error -> e) { return result\Result::<Survey>{ error = e }; }
        final baseOk = verified.value!;
        final jobs = jobLeases();
        if (jobs.error -> e) { return result\Result::<Survey>{ error = e }; }
        final leases = liveLeases(jobs.value!);
        final cwds = processCwds(deadline);
        if (cwds.error -> e) { return result\Result::<Survey>{ error = e }; }
        final pids = pidsByWorktree(cwds.value!, paths: trees.map(fun (i: int, t: Worktree) > str => t.path));

        final items = mut [<Item>];
        final held = mut {<str: str>};
        final removable = mut [<str>];
        foreach (t in trees) {
            final seen = observe(t, main: main, base: base, baseOk: baseOk, deadline: deadline);
            if (seen.error -> e) { return result\Result::<Survey>{ error = e }; }
            final it = classify(seen.value!, main: main, own: root, leases: leases, pids: pids, now: now, keepRecent: keepRecent, shown: displayPath(t.path, main: main));
            if (t.branch != "" and t.branch != "(detached)") { held[t.branch] = t.path; }
            if (it.class == "removable") {
                removable.append(t.path);
                if (measure) {
                    final size = duKiB(t.path, deadline: deadline);
                    if (size.error -> e) { return result\Result::<Survey>{ error = e }; }
                    final found = caches(t.path, deadline: deadline);
                    if (found.error -> e) { return result\Result::<Survey>{ error = e }; }
                    items.append(copyItem(it, kib: size.value!, caches: found.value!, result: ""));
                    continue;
                }
            }
            items.append(it);
        }
        final branches = agentBranches(root, base: base, baseOk: baseOk, deadline: deadline);
        if (branches.error -> e) { return result\Result::<Survey>{ error = e }; }
        foreach (b in branchItems(branches.value!["tips"]!, held: held, removable: removable, unique: branches.value!["unique"]!.keys())) { items.append(b); }
        return result\ok::<Survey>(Survey{ root = root, base = base, items = items });
    } catch (err: any) {
        return result\caught::<Survey>(err, doing: "reclaimdisk: survey the worktrees");
    }
}

fun copyItem(it: Item, kib: int, caches: [Cache], result: str) > Item {
    return Item{ kind = it.kind, name = it.name, class = it.class, reasons = it.reasons, keys = it.keys, kib = kib,
        caches = caches, path = it.path, branch = it.branch, tip = it.tip, touched = it.touched, result = result };
}

fun magusBin() > result\Result::<str> {
    final named = os\env("__MAGUS_BIN");
    if (named -> bin) {
        if (bin != "") { return result\ok::<str>(bin); }
    }
    try {
        return result\ok::<str>(os\executable());
    } catch (err: any) {
        return result\caught::<str>(err);
    }
}

fun removeWorktree(it: Item, root: str, deadline: double) > str {
    final line = guardLine(root, path: it.path);
    if (line == null) { return "skipped: its path needs shell quoting, which the guard check does not cover"; }
    final bin = magusBin();
    if (bin.error -> e) { return "refused by the guard: {e.message}"; }
    final shellLeft = bound(deadline);
    if (shellLeft.error -> e) { return "refused by the guard: {e.message}"; }
    try {
        _ = proc\exec(bin.value!, args: ["shell", line!], dir: root, opts: proc\ExecOptions{ quiet = true, timeoutMs = shellLeft.value! });
    } catch (e) {
        return "refused by the guard: {e}";
    }
    final removeLeft = bound(deadline);
    if (removeLeft.error -> e) { return "failed: {e.message}"; }
    try {
        _ = vcs\cmd(["worktree", "remove", it.path], opts: vcs\CommandOptions{ dir = root, quiet = true, timeoutMs = removeLeft.value! });
    } catch (e) {
        return "failed: {e}";
    }
    return "removed";
}

/// apply removes the removable rows and returns the plan with each row's result. A worktree
/// the guard refuses or git fails on stays, and so does its branch. Never --force.
export fun apply(items: [Item], root: str, deadline: double) > [Item] {
    final done = mut [<Item>];
    final kept = mut [<str>];
    foreach (it in items) {
        if (it.kind == "worktree" and it.class == "removable") {
            final result = removeWorktree(it, root: root, deadline: deadline);
            if (result != "removed") { kept.append(it.branch); }
            done.append(copyItem(it, kib: it.kib, caches: it.caches, result: result));
        } else {
            done.append(it);
        }
    }
    foreach (i, it in done) {
        if (it.kind != "branch" or it.class != "removable") { continue; }
        var result = "deleted";
        if (kept.indexOf(it.branch) != null) {
            result = "skipped: its worktree was not removed";
        } else {
            final left = bound(deadline);
            if (left.error -> e) {
                result = "failed: {e.message}";
            } else {
                try {
                    _ = vcs\cmd(["update-ref", "-d", "refs/heads/{it.branch}", it.tip], opts: vcs\CommandOptions{ dir = root, quiet = true, timeoutMs = left.value! });
                } catch (e) {
                    result = "failed: {e}";
                }
            }
        }
        done[i] = copyItem(it, kib: it.kib, caches: it.caches, result: result);
    }
    return done;
}

/// MIN_FENCE_MS is the shortest fence fs.trimOldest takes: Go re-dates a used
/// cache entry only hourly, so a younger file may still be in use.
export final MIN_FENCE_MS = 3600000.0;

/// CacheTrim is what one cache trim really did. error is why it did not finish.
/// tightened is true when the fence it was given held the cache past its budget
/// and it trimmed again at MIN_FENCE_MS.
export object CacheTrim {
    name: str,
    trimMb: int,
    removedFiles: int = 0,
    removedBytes: int = 0,
    afterBytes: int = 0,
    stopped: str = "",
    error: str = "",
    tightened: bool = false,
}

fun trimAt(name: str, dir: str, trimMb: int, fence: double, deadline: double) > CacheTrim {
    final left = bound(deadline);
    if (left.error -> e) { return CacheTrim{ name = name, trimMb = trimMb, error = e.message }; }
    try {
        final r = fs\trimOldest(dir, maxBytes: trimMb * 1048576, keepWithinMs: std\toInt(fence), timeoutMs: std\toInt(left.value!));
        return CacheTrim{ name = name, trimMb = trimMb, removedFiles = r.removedFiles, removedBytes = r.removedBytes, afterBytes = r.afterBytes, stopped = r.stopped };
    } catch (e) {
        return CacheTrim{ name = name, trimMb = trimMb, error = "{e}" };
    }
}

/// fenceHeld says whether fence alone held t past its budget.
/// It is false for a failure, a stop at the timeout, or a fence of MIN_FENCE_MS.
export fun fenceHeld(t: CacheTrim, fence: double) > bool {
    if (t.error != "" or fence <= MIN_FENCE_MS) { return false; }
    if (t.afterBytes <= t.trimMb * 1048576) { return false; }
    return t.stopped != "" and t.stopped.indexOf("timeout") == null;
}

/// trimCache trims one cache to its budget, tightening fence to MIN_FENCE_MS if needed.
/// It keeps files inside fence, and when they alone pass the budget it trims once
/// more at MIN_FENCE_MS; fs.trimOldest takes the oldest hours first, so that pass
/// takes only what the budget needs. The result adds both passes and is tightened.
export fun trimCache(name: str, dir: str, trimMb: int, fence: double, deadline: double) > CacheTrim {
    final first = trimAt(name, dir: dir, trimMb: trimMb, fence: fence, deadline: deadline);
    if (!fenceHeld(first, fence: fence)) { return first; }
    final second = trimAt(name, dir: dir, trimMb: trimMb, fence: MIN_FENCE_MS, deadline: deadline);
    return CacheTrim{
        name = name,
        trimMb = trimMb,
        removedFiles = first.removedFiles + second.removedFiles,
        removedBytes = first.removedBytes + second.removedBytes,
        afterBytes = if (second.error == "") second.afterBytes else first.afterBytes,
        stopped = second.stopped,
        error = second.error,
        tightened = true,
    };
}

fun fenceLabel(fence: double) > str {
    return "{std\toInt(fence / 3600000.0)}h";
}

/// trimLine says what one trim really did, null when it did nothing to say.
/// fence is the fence the trim was given; a tightened trim names it and MIN_FENCE_MS.
export fun trimLine(t: CacheTrim, fence: double) > str? {
    final removed = size(std\toInt(t.removedBytes / 1024));
    final left = size(std\toInt(t.afterBytes / 1024));
    final given = fenceLabel(fence);
    final least = fenceLabel(MIN_FENCE_MS);
    if (t.error != "" and t.tightened) { return "trimmed {removed} of {t.name} outside the {given} fence, then could not trim it at {least}: {t.error}"; }
    if (t.error != "") { return "could not trim {t.name}: {t.error}"; }
    if (t.removedFiles == 0 and t.stopped == "") { return null; }
    var tail = "{left} left";
    if (t.stopped.indexOf("timeout") != null) {
        tail = "{left} left, {t.stopped}";
        if (t.tightened) { tail = "{tail} after the fence tightened from {given} to {least}"; }
    } else if (t.afterBytes > t.trimMb * 1048576 and t.tightened) {
        tail = "{left} left, past its {t.trimMb} MiB budget and all newer than the {least} fence, tightened from {given}";
    } else if (t.afterBytes > t.trimMb * 1048576) {
        tail = "{left} left, past its {t.trimMb} MiB budget and all newer than the {given} fence";
    } else if (t.tightened) {
        tail = "{left} left, within its {t.trimMb} MiB budget once the fence tightened from {given} to {least}";
    }
    return "trimmed {removed} of {t.name}; {tail}";
}

/// trimDeclared trims every cache a spell gives a budget and returns each
/// result. A cache that fails names itself, and the others still run.
export fun trimDeclared(fence: double, deadline: double) > [CacheTrim] !> any {
    final plan: magus\DiskReclaim = magus\workspace().diskReclaim();
    final done = mut [<CacheTrim>];
    foreach (c in plan.caches) {
        done.append(trimCache("the {c.spell} spell's {c.env}", dir: c.dir, trimMb: c.trimMb, fence: fence, deadline: deadline));
    }
    return done;
}

/// chunk is the worktree half of a reclaim: the CHUNK_WORKTREES removable
/// worktrees untouched longest and the agent branches they and none hold.
/// It returns the whole plan with each row's result, and raises past deadline.
export fun chunk(deadline: double) > [Item] !> any {
    final surveyed = survey(vcs\base(), now: os\time(), keepRecent: 7200000.0, measure: false, deadline: deadline);
    if (surveyed.error != null) { throw surveyed.error!.message; }
    final s = surveyed.value!;
    final done = apply(pickChunk(s.items, n: CHUNK_WORKTREES), root: vcs\root(), deadline: deadline);
    final byName = mut {<str: Item>};
    foreach (it in done) { byName[it.name] = it; }
    return s.items.map(fun (i: int, it: Item) > Item => byName[it.name] ?? it);
}

/// keptLine counts what a reclaim leaves for a person, "" when it leaves none.
export fun keptLine(items: [Item]) > str {
    final t = totals(items);
    if (t.kept == 0) { return ""; }
    final parts = mut [<str>];
    if (t.keptBy["dirty"] -> n) { parts.append("{n} uncommitted"); }
    if (t.keptBy["unique"] -> n) { parts.append("{n} unpushed"); }
    if (t.keptBy["locked"] -> n) { parts.append("{n} locked"); }
    if (parts.len() == 0) { return strings\pluralCount(t.kept, one: "worktree", many: "worktrees"); }
    return "{strings\pluralCount(t.kept, one: "worktree", many: "worktrees")} ({parts.join(", ")})";
}

/// TickReport is what one tick did. ran is false when it was not due or nothing
/// asked for a reclaim. line is what a person reads, "" when nothing is new.
export object TickReport {
    ran: bool,
    line: str = "",
}

/// TickResult is a tick's value or the error that stopped it.
export object TickResult {
    value: TickReport? = null,
    error: str = "",
}

fun readConfig(cwd: str) > result\Result::<diskwatch\Thresholds> {
    final bin = magusBin();
    if (bin.error -> e) { return result\Result::<diskwatch\Thresholds>{ error = e }; }
    try {
        final config = proc\exec(bin.value!, args: ["config", "view", "-o", "json"], dir: cwd, opts: proc\ExecOptions{ quiet = true, timeoutMs = 5000.0 });
        return diskwatch\thresholds(config.stdout);
    } catch (err: any) {
        return result\caught::<diskwatch\Thresholds>(err);
    }
}

fun lastWrite(store: str) > double? {
    final info = fs\stat(store) catch null;
    if (info == null) { return null; }
    return info!.mtime;
}

fun waitingLine(listCommand: str) > str {
    if (listCommand != "") { return "{listCommand} lists them"; }
    return "`git worktree list` names them";
}

// trimInto trims each declared cache and adds a line per trim to did.
// It reports whether any trim freed bytes.
fun trimInto(did: mut [str], fence: double, now: double, deadline: double) > result\Result::<bool> {
    var freed = false;
    final cacheDeadline = if (deadline - now > TRIM_MS * 1.25) now + TRIM_MS else now + (deadline - now) * 0.8;
    try {
        foreach (trim in trimDeclared(fence, deadline: cacheDeadline)) {
            if (trim.removedBytes > 0) { freed = true; }
            if (trimLine(trim, fence: fence) -> text) { did.append(text); }
        }
    } catch (err: any) {
        return result\caught::<bool>(err);
    }
    return result\ok::<bool>(freed);
}

fun runTick(cwd: str, deadline: double, force: bool) > result\Result::<TickReport> {
    try {
        final located = diskwatch\storePath();
        if (located.error -> e) { return result\Result::<TickReport>{ error = e }; }
        final store = located.value!;
        final now = os\time();
        final config = readConfig(cwd);
        if (config.error -> e) { return result\Result::<TickReport>{ error = e }; }
        final t = config.value!;
        if (!force and !diskwatch\due(lastWrite(store), now: now, everyMs: t.everyMs)) { return result\ok::<TickReport>(TickReport{ ran = false }); }
        final stored = diskwatch\read(store);
        if (stored.error -> e) { return result\Result::<TickReport>{ error = e }; }
        final samples = stored.value!;
        final du = fs\diskUsage(cwd);
        final cur = diskwatch\DiskSample{ at = now, path = du.path, totalBytes = du.totalBytes, freeBytes = du.freeBytes };
        final d = diskwatch\decide(diskwatch\lastOf(samples, path: du.path), cur: cur, t: t);
        final wrote1 = diskwatch\append(store, s: cur);
        if (wrote1.error -> e) { return result\Result::<TickReport>{ error = e }; }
        if (!d.reclaim and !d.critical and !force) { return result\ok::<TickReport>(TickReport{ ran = false }); }
        if (diskwatch\chunkRunning(samples, now: now)) { return result\ok::<TickReport>(TickReport{ ran = false }); }
        if (!d.reclaim and !force) {
            final critical = diskwatch\criticalLine(cur);
            final wrote2 = diskwatch\append(store, s: diskwatch\DiskSample{ at = now, path = du.path, totalBytes = du.totalBytes, freeBytes = du.freeBytes, action = "reclaimed", detail = critical });
            if (wrote2.error -> e) { return result\Result::<TickReport>{ error = e }; }
            return result\ok::<TickReport>(TickReport{ ran = false, line = critical });
        }
        final wrote3 = diskwatch\append(store, s: diskwatch\DiskSample{ at = now, path = du.path, action = "started", detail = if (d.why == "") "asked directly" else d.why });
        if (wrote3.error -> e) { return result\Result::<TickReport>{ error = e }; }

        final did = mut [<str>];
        var freed = false;
        final asked = diskwatch\fenceMs(cur, t: t);
        final fence = if (force and asked == 0.0) diskwatch\LOW_FENCE_MS else asked;
        if (fence > 0.0) {
            final trimmed = trimInto(did, fence: fence, now: now, deadline: deadline);
            if (trimmed.error -> e) { return result\Result::<TickReport>{ error = e }; }
            if (trimmed.value!) { freed = true; }
        }
        var kept = "";
        try {
            final items = chunk(deadline);
            kept = keptLine(items);
            final removed = items.filter(fun (i: int, it: Item) > bool => it.kind == "worktree" and it.result == "removed").len();
            if (removed > 0) {
                freed = true;
                did.append("removed {strings\pluralCount(removed, one: "worktree", many: "worktrees")}");
            }
        } catch (e) {
            did.append("stopped before the worktrees: {e}");
        }
        final after = fs\diskUsage(cwd);
        final plan: magus\DiskReclaim = magus\workspace().diskReclaim();
        final waiting = if (kept == "") "" else waitingLine(plan.listCommand);
        final said = diskwatch\personLine(diskwatch\Report{ freeBytes = after.freeBytes, totalBytes = after.totalBytes, path = after.path, did = did, kept = kept, waiting = waiting });
        final wrote4 = diskwatch\append(store, s: diskwatch\DiskSample{ at = os\time(), path = after.path, totalBytes = after.totalBytes, freeBytes = after.freeBytes, action = "reclaimed", detail = said });
        if (wrote4.error -> e) { return result\Result::<TickReport>{ error = e }; }
        if (!freed and !d.critical and !force) {
            final wrote5 = diskwatch\append(store, s: diskwatch\DiskSample{ at = os\time(), path = after.path, action = "said", detail = "nothing freed" });
            if (wrote5.error -> e) { return result\Result::<TickReport>{ error = e }; }
            return result\ok::<TickReport>(TickReport{ ran = true });
        }
        magus\workspace().fileDiskAttention(said);
        return result\ok::<TickReport>(TickReport{ ran = true, line = said });
    } catch (err: any) {
        return result\caught::<TickReport>(err);
    }
}

/// tick is the one decider every trigger calls. It samples, decides, trims and
/// removes, then writes the person's line from what really happened. force
/// skips the rate limit, for a caller about to refuse work. It never raises.
export fun tick(cwd: str, deadline: double, force: bool = false) > TickResult {
    final ticked = runTick(cwd, deadline: deadline, force: force);
    if (ticked.error -> e) {
        final failure = e.message;
        final located = diskwatch\storePath();
        if (located.error == null) {
            _ = diskwatch\append(located.value!, s: diskwatch\DiskSample{ at = os\time(), path = cwd, action = "reclaimed", detail = "magus: a disk reclaim stopped: {failure}" });
        }
        return TickResult{ error = failure };
    }
    return TickResult{ value = ticked.value! };
}

/// reclaimNow runs a tick in the foreground and prints what really happened. It
/// is the sanctioned way to clear a cache by hand.
export fun reclaimNow() > void {
    final result = tick(".", deadline: os\time() + CHUNK_MS, force: true);
    if (result.error != "") {
        std\print("magus: the reclaim stopped: {result.error}");
    } else if (result.value -> report) {
        std\print(if (report.line == "") "magus: disk reclaim had nothing to do." else report.line);
    }
}

fun keepOnly(it: Item) > bool {
    return it.class == "keep";
}

test "classify keeps a dirty, unpushed, leased, busy or locked worktree and says why" {
    final now = 100000000.0;
    final old = now - 86400000.0;
    final none = {<str: [str]>};
    final dirty = classify(Observed{ path = "/r/w/d", dirty = 2, touched = old }, main: "/r", own: "/r", leases: none, pids: none, now: now, keepRecent: 7200000.0, shown: "d");
    assert\equal(dirty.reasons, want: ["2 uncommitted files"], message: "dirty");
    final unpushed = classify(Observed{ path = "/r/w/u", unique = 1, touched = old }, main: "/r", own: "/r", leases: none, pids: none, now: now, keepRecent: 7200000.0, shown: "u");
    assert\equal(unpushed.keys, want: ["unique"], message: "unpushed");
    final leased = classify(Observed{ path = "/r/w/l", touched = old }, main: "/r", own: "/r", leases: {"/r/w/l": ["j (running)"]}, pids: {"/r/w/l": ["9"]}, now: now, keepRecent: 7200000.0, shown: "l");
    assert\equal(leased.keys, want: ["lease", "process"], message: "leased and busy");
    final locked = classify(Observed{ path = "/r/w/k", locked = "", touched = old }, main: "/r", own: "/r", leases: none, pids: none, now: now, keepRecent: 7200000.0, shown: "k");
    assert\equal(locked.keys, want: ["locked"], message: "a lock with no reason");
    final clean = classify(Observed{ path = "/r/w/c", touched = old }, main: "/r", own: "/r", leases: none, pids: none, now: now, keepRecent: 7200000.0, shown: "c");
    assert\equal(clean.class, want: "removable", message: "clean and idle");
}

test "a chunk takes the oldest removable worktrees, their branches and unheld ones, never a kept row" {
    final items = [
        Item{ kind = "worktree", name = "new", class = "removable", reasons = [<str>], path = "/w/new", touched = 300.0 },
        Item{ kind = "worktree", name = "oldest", class = "removable", reasons = [<str>], path = "/w/oldest", touched = 100.0 },
        Item{ kind = "worktree", name = "older", class = "removable", reasons = [<str>], path = "/w/older", touched = 200.0 },
        Item{ kind = "worktree", name = "dirty", class = "keep", reasons = ["1 uncommitted file"], keys = ["dirty"], path = "/w/dirty", touched = 1.0 },
        Item{ kind = "branch", name = "b-oldest", class = "removable", reasons = [<str>], path = "/w/oldest" },
        Item{ kind = "branch", name = "b-new", class = "removable", reasons = [<str>], path = "/w/new" },
        Item{ kind = "branch", name = "b-free", class = "removable", reasons = [<str>] },
    ];
    final got = pickChunk(items, n: 2).map(fun (i: int, it: Item) > str => it.name);
    assert\equal(got, want: ["oldest", "older", "b-oldest", "b-free"], message: "chunk");
    assert\equal(pickChunk(items, n: 2).filter(fun (i: int, it: Item) > bool => keepOnly(it)).len(), want: 0, message: "no kept row");
    assert\equal(pickChunk(items, n: 0).map(fun (i: int, it: Item) > str => it.name), want: ["b-free"], message: "a zero chunk removes no worktree");
}

test "an agent branch is listed only when nothing on it would be lost" {
    final items = branchItems({"worktree-agent-a": "aaa", "worktree-agent-b": "bbb", "worktree-agent-c": "ccc", "worktree-agent-d": "ddd", "agent-e": "eee"},
        held: {"worktree-agent-b": "/w/kept", "worktree-agent-c": "/w/removable"}, removable: ["/w/removable"], unique: ["worktree-agent-d"]);
    assert\equal(items.map(fun (i: int, it: Item) > str => "{it.name} {it.tip} {it.path}"),
        want: ["agent-e eee ", "worktree-agent-a aaa ", "worktree-agent-c ccc /w/removable"], message: "branches");
    assert\equal(parseUniqueBranches("worktree-agent-d\n\nHEAD -> worktree-agent-x, agent-y\n"), want: ["worktree-agent-d", "worktree-agent-x", "agent-y"], message: "decorations");
}

test "a deadline bounds each call by what is left, and stops the chunk once it passes" {
    assert\equal(budget(0.0, now: 5.0).value!, want: 0.0, message: "no deadline, no bound");
    assert\equal(budget(100.0, now: 40.0).value!, want: 60.0, message: "what is left");
    assert\isTrue(budget(100.0, now: 100.0).error != null, message: "past it");
}

test "a slow subprocess is cut off by the timeout its deadline leaves" {
    final start = os\time();
    final res = proc\exec("sleep", args: ["30"], opts: proc\ExecOptions{ quiet = true, timeoutMs = budget(start + 300.0, now: start).value! }) catch null;
    assert\equal(res, want: null, message: "the call raised");
    assert\isTrue(os\time() - start < 10000.0, message: "it did not wait the 30s out");
}

test "porcelain parses to one worktree per stanza, the main one first" {
    final porcelain = "worktree /work/repo\nHEAD 1\nbranch refs/heads/main\n\nworktree /work/repo/.claude/worktrees/topic\nHEAD 2\ndetached\n\n"
        + "worktree /elsewhere/copy\nHEAD 3\nbranch refs/heads/fix\nprunable gitdir file points to non-existent location\n";
    final trees = parseWorktrees(porcelain);
    assert\equal(trees.map(fun (i: int, t: Worktree) > str => "{displayPath(t.path, main: trees[0].path)} {t.branch}"),
        want: [". main", ".claude/worktrees/topic (detached)", "/elsewhere/copy fix"], message: "worktrees");
}

test "the guard judges the same words git receives, or nothing" {
    assert\equal(guardLine("/work/repo", path: "/work/repo/.claude/worktrees/agent-a1"), want: "git -C /work/repo worktree remove /work/repo/.claude/worktrees/agent-a1", message: "plain");
    assert\equal(guardLine("/work/repo", path: "/work/my repo/wt"), want: null, message: "a space");
}

// agedFile writes kib KiB to dir/name, last modified hours ago.
fun agedFile(dir: str, name: str, kib: int, hours: double) > result\Result::<str> {
    final path = fs\join(dir, name: name);
    try {
        fs\writeFile(path, content: "x".repeat(kib * 1024));
        final at = time\format("2006-01-02T15:04:05Z", unixMillis: os\time() - hours * 3600000.0);
        _ = proc\exec("touch", args: ["-d", at, path], opts: proc\ExecOptions{ quiet = true });
    } catch (err: any) {
        return result\caught::<str>(err, doing: "reclaimdisk: age {path}");
    }
    return result\ok::<str>(path);
}

test "a cache within its budget stays, and a trim says nothing it did not do" {
    final dir = fs\tempDir("trimcache");
    fs\writeFile(fs\join(dir, name: "entry"), content: "x");
    final within = trimCache("a cache", dir: dir, trimMb: 1, fence: 21600000.0, deadline: 0.0);
    assert\equal(within, want: CacheTrim{ name = "a cache", trimMb = 1, afterBytes = 1 }, message: "nothing removed, the fence kept");
    assert\equal(trimLine(within, fence: 21600000.0), want: null, message: "nothing said");
    assert\isTrue(fs\exists(fs\join(dir, name: "entry")), message: "kept");
    fs\removeAll(dir);
}

test "a cache the fence holds past its budget trims again at 1h, only down to the budget, and says so" {
    final dir = fs\tempDir("trimcache");
    final old = agedFile(dir, name: "old", kib: 1024, hours: 10.5).value!;
    final mid = agedFile(dir, name: "mid", kib: 1024, hours: 3.5).value!;
    final recent = agedFile(dir, name: "recent", kib: 1, hours: 2.5).value!;
    final fresh = agedFile(dir, name: "fresh", kib: 1, hours: 0.0).value!;
    final fence = 21600000.0;
    final got = trimCache("a cache", dir: dir, trimMb: 1, fence: fence, deadline: 0.0);
    assert\equal(got, want: CacheTrim{ name = "a cache", trimMb = 1, removedFiles = 2, removedBytes = 2097152, afterBytes = 2048, tightened = true }, message: "both passes");
    assert\equal(trimLine(got, fence: fence), want: "trimmed 2 MiB of a cache; 2 KiB left, within its 1 MiB budget once the fence tightened from 6h to 1h", message: "says so");
    assert\isFalse(fs\exists(old), message: "outside the 6h fence");
    assert\isFalse(fs\exists(mid), message: "outside 1h, and the budget needed it");
    assert\isTrue(fs\exists(recent), message: "outside 1h, and the budget did not need it");
    assert\isTrue(fs\exists(fresh), message: "inside 1h");
    fs\removeAll(dir);
}

test "a cache past its budget even at 1h keeps the past-budget line and names both fences" {
    final dir = fs\tempDir("trimcache");
    final fresh = agedFile(dir, name: "fresh", kib: 2048, hours: 0.0).value!;
    final fence = 21600000.0;
    final got = trimCache("a cache", dir: dir, trimMb: 1, fence: fence, deadline: 0.0);
    assert\equal(got.removedFiles, want: 0, message: "nothing outside 1h");
    assert\isTrue(got.tightened, message: "it tried 1h");
    assert\equal(trimLine(got, fence: fence), want: "trimmed 0 KiB of a cache; 2 MiB left, past its 1 MiB budget and all newer than the 1h fence, tightened from 6h", message: "past budget");
    assert\isTrue(fs\exists(fresh), message: "kept");
    fs\removeAll(dir);
}

test "only a fence longer than 1h that alone held the budget is tightened" {
    final g = 1073741824;
    final held = CacheTrim{ name = "c", trimMb = 1, afterBytes = 2 * 1048576, stopped = "files modified within 6h hold them" };
    assert\isTrue(fenceHeld(held, fence: 21600000.0), message: "a 6h fence");
    assert\isFalse(fenceHeld(held, fence: MIN_FENCE_MS), message: "already 1h");
    final timedOut = CacheTrim{ name = "c", trimMb = 1, afterBytes = 2 * 1048576, stopped = "stopped at its timeout" };
    assert\isFalse(fenceHeld(timedOut, fence: 21600000.0), message: "a timeout");
    final failed = CacheTrim{ name = "c", trimMb = 1, error = "denied" };
    assert\isFalse(fenceHeld(failed, fence: 21600000.0), message: "a failure");
    final fits = CacheTrim{ name = "c", trimMb = 20480, removedFiles = 1, removedBytes = g, afterBytes = g };
    assert\isFalse(fenceHeld(fits, fence: 21600000.0), message: "within budget");
}

test "a trim line reports the real numbers, the fence and a failure" {
    final g = 1073741824;
    final fence = 21600000.0;
    final past = CacheTrim{ name = "c", trimMb = 20480, removedFiles = 9, removedBytes = 162 * g, afterBytes = 167 * g, stopped = "files modified within 6h hold them" };
    assert\equal(trimLine(past, fence: fence), want: "trimmed 162.0 GiB of c; 167.0 GiB left, past its 20480 MiB budget and all newer than the 6h fence", message: "past budget");
    final fits = CacheTrim{ name = "c", trimMb = 20480, removedFiles = 9, removedBytes = g, afterBytes = 2 * g };
    assert\equal(trimLine(fits, fence: fence), want: "trimmed 1.0 GiB of c; 2.0 GiB left", message: "within budget");
    final failed = CacheTrim{ name = "c", trimMb = 1, error = "denied" };
    assert\equal(trimLine(failed, fence: fence), want: "could not trim c: denied", message: "a failure");
    final late = CacheTrim{ name = "c", trimMb = 20480, removedFiles = 9, removedBytes = g, afterBytes = 30 * g, stopped = "stopped at its timeout", tightened = true };
    assert\equal(trimLine(late, fence: fence), want: "trimmed 1.0 GiB of c; 30.0 GiB left, stopped at its timeout after the fence tightened from 6h to 1h", message: "a tightened trim that timed out");
    final retryFailed = CacheTrim{ name = "c", trimMb = 20480, removedFiles = 9, removedBytes = g, afterBytes = 30 * g, error = "denied", tightened = true };
    assert\equal(trimLine(retryFailed, fence: fence), want: "trimmed 1.0 GiB of c outside the 6h fence, then could not trim it at 1h: denied", message: "the 1h pass failed");
}

test "what a person reads counts kept worktrees by reason" {
    final items = [
        Item{ kind = "worktree", name = "a", class = "keep", reasons = ["x"], keys = ["dirty", "locked"] },
        Item{ kind = "worktree", name = "b", class = "keep", reasons = ["x"], keys = ["unique"] },
        Item{ kind = "worktree", name = "c", class = "removable", reasons = ["x"] },
    ];
    final line = keptLine(items);
    assert\isTrue(line.startsWith("2 worktrees ("), message: line);
    foreach (word in ["1 uncommitted", "1 unpushed", "1 locked"]) {
        assert\isTrue(line.indexOf(word) != null, message: word);
    }
    assert\equal(keptLine([<Item>]), want: "", message: "none kept");
    assert\equal(keptLine([Item{ kind = "worktree", name = "r", class = "keep", reasons = ["x"], keys = ["recent"] }]), want: "1 worktree", message: "no reason a person acts on");
}

test "the headline says what ran" {
    final items = [
        Item{ kind = "worktree", name = "a", class = "removable", reasons = [<str>], kib = 2048, result = "removed" },
        Item{ kind = "worktree", name = "b", class = "removable", reasons = [<str>], kib = 1024, result = "refused by the guard: dirty" },
        Item{ kind = "branch", name = "c", class = "removable", reasons = [<str>], kib = 0, result = "deleted" },
        Item{ kind = "worktree", name = "d", class = "keep", reasons = ["dirty"], keys = ["dirty"] },
    ];
    assert\equal(headline(items, applied: false, trimmed: ""), want: "dry run: nothing removed; --apply removes 2 worktrees (3 MiB) and 1 agent branch", message: "dry");
    assert\equal(headline(items, applied: true, trimmed: "trimmed 1 GiB"),
        want: "removed 1 of 2 removable worktrees (2 MiB) and deleted 1 of 1 agent branch; trimmed 1 GiB", message: "applied");
}
