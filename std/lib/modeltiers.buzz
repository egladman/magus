/// modeltiers is the model-tier declaration a workspace gets when its
/// magusfile declares none. Its four tiers run cheapest first, each named
/// for the work it takes, with the bounds and skill variant its jobs run
/// under. Copy it into a magusfile to change any of it.
///
/// Every mapping is an exhaustive match, so a tier added to the enum fails the check
/// until each function covers it. No model is named here: each harness spell maps the
/// tiers to its own models.
namespace modeltiers;

import "magus";

export enum ModelTier { routine, bounded, design, frontier }

export final defaultTier = ModelTier.bounded;

/// bounds caps the context a routine worker may reach. It caps no tier's
/// live jobs: a default that refused a workspace's next fork would surprise
/// everyone who never asked for a cap, so maxLive is set only by a magusfile
/// that declares one.
export fun bounds(tier: ModelTier) > magus\ModelTierBounds {
    return match (tier) {
        .routine -> magus\ModelTierBounds{ maxContext = 100000 },
        .bounded -> magus\ModelTierBounds{},
        .design -> magus\ModelTierBounds{},
        .frontier -> magus\ModelTierBounds{},
    };
}

/// skills is the skill variant a tier's workers load. Routine gets the
/// full bodies: a smaller model is the reader least able to re-derive the
/// steps the short form drops.
export fun skills(tier: ModelTier) > magus\SkillVariant {
    return match (tier) {
        .routine -> magus\SkillVariant.full,
        .bounded -> magus\SkillVariant.short,
        .design -> magus\SkillVariant.short,
        .frontier -> magus\SkillVariant.short,
    };
}
