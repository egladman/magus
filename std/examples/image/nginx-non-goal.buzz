// nginxinc/docker-nginx stable/debian Dockerfile: apt keyrings, apt-get install nginx
// packages (or build .debs from pkg-oss on obscure arches), ln logs to stdout/stderr,
// COPY entrypoint scripts, EXPOSE, CMD ["nginx", "-g", "daemon off;"].
//
// Upstream: https://github.com/nginxinc/docker-nginx/blob/master/stable/debian/Dockerfile
//
// magus will not recreate apt inside assembleLayout. Options at the seam:
//
//   A. Keep docker/buildx for that image (ADR 0018 cannot-express / alternative A)
//   B. Pull a digest-pinned nginx base Layout, then assembleLayout only your config
//      and entrypoint — see config-overlay.buzz
//   C. Ship a static binary server as scratch+file instead (static-go.buzz shape)
//
// This file is documentation-as-code: it does not call image.* for package installs.
//
export fun whyNot() > str {
    return "nginx official image needs package install at build time; that is not an OCI placement";
}
