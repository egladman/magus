// Shape taken from official nginx / httpd Dockerfiles *after* the package install:
// they COPY entrypoint scripts and config onto an already-built runtime. magus will not
// re-run apt/apk (see nginx-non-goal.buzz, redis-non-goal.buzz). The assemble path is:
// pull a digest-pinned base Layout, then add only your files as one Layer.
//
// nginx (excerpt of what stays on the engine vs what we place):
//   RUN apt-get install nginx …     ← not assembleLayout
//   COPY docker-entrypoint.sh /     ← ImageFile
//   COPY conf.d/ /etc/nginx/conf.d/ ← DirPlacement
//   CMD ["nginx", "-g", "daemon off;"]
//
// Upstream references:
//   https://github.com/nginxinc/docker-nginx (stable/debian/Dockerfile)
//   https://github.com/docker-library/httpd (2.4/alpine/Dockerfile) — same seam
//
import "image";

// assembleConfigOverlay places app config onto a digest-pinned base Layout. baseLayout
// must already be an OCI Layout directory (pullLayout or a prior assemble). confDir is
// a host directory of nginx/httpd-style conf fragments.
export fun assembleConfigOverlay(
    baseLayout: str,
    confDir: str,
    entrypointScript: str,
    dest: str,
) > image\ImageLayout !> any {
    return image\assembleLayout(image\ImageSpec{
        base = baseLayout,
        platform = image\ImagePlatform{ os = "linux", architecture = "amd64" },
        files = [image\ImageFile{
            source = entrypointScript,
            destination = "/docker-entrypoint.sh",
            mode = 493, // 0o755
        }],
        dirs = [image\ImageDirPlacement{
            source = confDir,
            destination = "/etc/nginx/conf.d",
            strip = 1, // drop confDir's basename; fragments land directly under conf.d
        }],
        entrypoint = ["/docker-entrypoint.sh"],
        command = ["nginx", "-g", "daemon off;"],
    }, dest);
}
