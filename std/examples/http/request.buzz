import "std";
import "http";

// request lets you pick any method; useful for PUT/PATCH/DELETE.
try {
    final r = http\request(
        "PUT",
        "https://httpbin.org/put",
        "hello",
        { "Content-Type": "text/plain" },
        { "timeout": 10 },
    );
    std\print(r.status);
} catch (e) {
    std\print("request never reached the server");
}
