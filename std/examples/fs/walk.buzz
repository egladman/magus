import "std";
import "fs";

try {
    fs\walk(".", fun (path: str, isDir: bool) > bool {
        if (isDir and fs\basename(path) == "node_modules") {
            return false;   // skip descent
        }
        if (fs\ext(path) == ".go") { std\print(path); }
        return true;
    });
} catch (e) {
    std\print("walk stopped early");
}
