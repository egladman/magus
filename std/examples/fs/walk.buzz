import "std";
import "fs";

fun main(args: [str]) > void {
    fs\walk(".", callback: fun (path: str, isDir: bool) > fs\WalkStep {
        if (isDir and fs\basename(path) == "node_modules") {
            return fs\WalkStep.skipDir;
        }
        if (fs\ext(path) == ".go") { std\print(path); }
        return fs\WalkStep.next;
    }) catch void;
}
