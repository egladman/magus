import "magus";
import "proc";
import "../hack/advisories" as advisories;
import "../hack/toolchain-policy" as policy;
import "../hack/index" as index;
import "fs";
import "os";
import "proc";
import "std";
import "vcs";
import "project/../libs/textsearch";
import "project/.." as root;

import "lcov";

import "magus/spell/typescript";

magus\project({
    "tools": {"node": policy\node},
    "spells": [typescript],
    // proto writes src/gen/; without this edge a .proto change leaves the console unaffected.
    "depends_on": ["../proto"],
    // Affected tracks this glob, not the import graph, so it names every input.
    "sources": ["*.buzz",
                "src/**/*.ts", "src/**/*.css", "src/**/*.html",
                "index.html", "manifest.webmanifest", "sw.js", "scripts/**/*.mjs",
                "package.json", "pnpm-lock.yaml", "tsconfig.json", "tsconfig.test.json",
                "stylelint.config.mjs", "stylelint-control-sizing.mjs", "stylelint-label-token.mjs",
                "src/assets/**",
                "src/console/diff/demo.patch"],
    // Not src/gen/**: proto declares it, and a second claim is MGS4002.
    "outputs": ["gen/**"],
    "targets": {
        "install": {"skip_cache": "composes the spell's install, whose own entry checks the tree; a replay here would skip that check"},
        "build": {"skip_cache": "rebuilds gen/ and gates on drift; a replay would skip the check"},
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
        "security": {"skip_cache": "reads the npm advisory database, which changes independently of this tree"},
        "ci": {"skip_cache": "composes the gates and reads nothing itself; its key is the whole project, so it can never replay"},
    },
});

// install installs node_modules through the typescript spell's pnpm-install op.
export fun install(ctx: magus\Context, args: [str]) > void !> any { typescript["pnpm-install"](ctx); }

// Regenerates MAGUS.md and fails on drift. Use the rw charm to keep the result.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(index_generate);
}

// Renders MAGUS.md, this project's target catalog.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("MAGUS.md");
    ctx.readsFiles("magusfile.buzz", "../magus.yaml", "../internal/render/target_graph.go",
                   "../internal/render/md/md.go", "../internal/hint/cli_command.go");
    index\render("console");
}

// test runs the node:test suite and holds the merged TypeScript line coverage above a floor.
// The test script launches Node three times (happy-dom's getter-only localStorage breaks the
// tests that stub it), so the reports merge by DA: record; summing LF/LH double-counts.
// Its --splitting and --experimental-test-isolation=none keep the figure deterministic.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install, textsearch\test);
    // Declared so a cache hit restores coverage.txt for the root's coverage-render.
    ctx.writesFiles("coverage.plain.lcov", "coverage.dom.lcov", "coverage.txt");
    proc\exec("pnpm", ["run", "test"], ".", {});

    // Both projects name their files src/..., so textsearch's paths get a prefix before the merge.
    final textsearch_report = fs\readFile(fs\join("..", "libs", "textsearch", "coverage.lcov"))
        .replace("SF:src/", "SF:libs/textsearch/src/");
    final pct = lcov\mergePercent(
        [fs\readFile("coverage.plain.lcov"), fs\readFile("coverage.dom.lcov"), textsearch_report],
        keep: "src/");
    fs\writeFile("coverage.txt", content: pct + "\n");
    // Two points of headroom: the figure moves a little with the Node patch version.
    final floor = 67;
    if (std\parseInt(pct.split(".")[0])! < floor) {
        throw "test: typescript coverage " + pct + "% is below the {floor}% floor; investigate the regression or lower the floor deliberately";
    }
}

// Renders the Diff showcase's changeset from its .patch with the Go reader; the showcase
// has no server to parse it. It lives here because the root writing into a descendant is MGS3001.
export fun diffdemo_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("src/console/diff/gen/*.ts");
    proc\exec("go", ["run", "../cmd/magus-utils", "diffdemo",
                     "-patch", "src/console/diff/demo.patch",
                     "-out", "src/console/diff/gen/demo.ts"], ".", {});
}

// build bundles the app into gen/ with esbuild.
export fun build(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.needs(diffdemo_generate);
    ctx.needs(root\graph_generate);
    // FIXME: gen/ is gitignored and isDirty reports ignored paths clean, so this gate never fires.
    final clean_before = vcs\isDirty(["gen"]) == false;
    // Copied before the build: stamp-build.mjs hashes every precached file.
    fs\mkdirAll(fs\join("gen", "graph"));
    foreach (name in ["knowledge-graph.json", "target-graph.json"]) {
        fs\copyFile(fs\join("..", "gen", name), fs\join("gen", "graph", name));
    }
    proc\exec("pnpm", ["run", "build"], ".", {});
    if (ctx.hasCharm("rw")) {
        return;
    }
    if (clean_before and vcs\isDirty(["gen"])) {
        throw "build: gen/ drifted; re-run `magus run build:rw console` and commit";
    }
}

// lint keeps TypeScript, CSS, and source formatting errors out of the console CI gate.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.needs(textsearch\lint);
    proc\exec("pnpm", ["run", "typecheck"], ".", {});
    proc\exec("pnpm", ["exec", "biome", "check", "src"], ".", {});
    proc\exec("pnpm", ["run", "stylelint"], ".", {});
    proc\exec("node", ["scripts/lint-catch.mjs", "src"], ".", {});
}

// `format:rw` maintains declared source inputs.
export fun format(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.modifiesExistingFiles(
        "src/**/*.ts", "src/**/*.css", "src/**/*.html", "scripts/**/*.mjs",
        "index.html", "manifest.webmanifest", "sw.js", "package.json",
        "tsconfig.json", "tsconfig.test.json", "stylelint.config.mjs",
        "stylelint-control-sizing.mjs", "stylelint-label-token.mjs");
    typescript["biome-format"](ctx);
}

// security audits the dependency tree against the npm advisory database.
export fun security(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    advisories\audit(inheritedFatal: advisories\inheritedFatal(args));
}

// The anchor `magus affected ci` keys off. ctx.needs passes no args, so
// `--inherited=fatal` calls security directly.
export fun ci(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    if (!advisories\inheritedFatal(args)) {
        ctx.needs(generate, lint, test, build, security);
        return;
    }
    ctx.needs(generate, lint, test, build);
    security(ctx, args: args);
}
