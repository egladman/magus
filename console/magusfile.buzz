import "magus";
import "proc";
import "../hack/magusfile/advisories" as advisories;
import "../hack/magusfile/toolchain-policy" as policy;
import "../hack/magusfile/index" as index;
import "fs";
import "os";
import "proc";
import "std";
import "project/../libs/textsearch";
import "project/../docs";
import "project/.." as root;

import "lcov";

import "magus/spell/typescript";

magus\project({
    "tools": {"node": policy\node},
    "spells": [typescript],
    // proto writes src/gen/; without this edge a .proto change leaves the console unaffected.
    "depends_on": ["../proto"],
    // Affected tracks this glob, not the import graph, so it names every input.
    "sources": ["*.buzz",
                "src/**/*.ts", "src/**/*.css", "src/**/*.html",
                "index.html", "manifest.webmanifest", "sw.js", "scripts/**/*.mjs",
                "package.json", "pnpm-lock.yaml", "tsconfig.json", "tsconfig.test.json",
                "stylelint.config.mjs", "stylelint-control-sizing.mjs", "stylelint-label-token.mjs",
                "src/assets/**",
                "src/apps/diff/demo.patch"],
    // Not src/gen/**: proto declares it, and a second claim is MGS4002.
    "outputs": ["gen/**"],
    "targets": {
        "install": {"skip_cache": "composes the spell's install, whose own entry checks the tree; a replay here would skip that check"},
        "generate": {"skip_cache": "the engine drift-gates the MAGUS.md it writes; a replay would skip the check"},
        "security": {"skip_cache": "reads the npm advisory database, which changes independently of this tree"},
        "ci": {"skip_cache": "composes the gates and reads nothing itself; its key is the whole project, so it can never replay"},
    },
});

// install installs node_modules through the typescript spell's pnpm-install op.
export fun install(ctx: magus\Context, args: [str]) > void !> any { typescript["pnpm-install"](ctx); }

// Regenerates MAGUS.md and fails on drift. Use the rw charm to keep the result.
export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(index_generate);
}

// Renders MAGUS.md, this project's target catalog.
export fun index_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("MAGUS.md");
    ctx.readsFiles("magusfile.buzz", "../magus.yaml", "../internal/render/target_graph.go",
                   "../internal/render/md/md.go", "../internal/hint/cli_command.go");
    index\render("console");
}

// test runs the node:test suite and holds the merged TypeScript line coverage above a floor.
// Node runs three times (happy-dom's getter-only localStorage breaks the tests that stub
// it), so the reports merge by DA: record; summing LF/LH double-counts. esbuild's
// --splitting and --experimental-test-isolation=none keep the figure deterministic.
export fun test(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install, textsearch\test);
    // Declared so a cache hit restores coverage.txt for the root's coverage-render.
    ctx.writesFiles("coverage.plain.lcov", "coverage.dom.lcov", "coverage.txt");
    fs\removeAll(".testcache");
    fs\remove("coverage.plain.lcov");
    fs\remove("coverage.dom.lcov");

    final bundle = mut [<str>];
    foreach (t in fs\glob("src/**/*.test.ts")) { bundle.append(t.value); }
    foreach (flag in ["--bundle", "--splitting", "--platform=node", "--format=esm",
                      "--sourcemap", "--outdir=.testcache"]) {
        bundle.append(flag);
    }
    typescript["esbuild"](ctx, {"args": bundle});

    final plain = mut ["--test-reporter-destination=coverage.plain.lcov", "--experimental-test-isolation=none"];
    final dom = mut ["--test-reporter-destination=coverage.dom.lcov", "--experimental-test-isolation=none",
                     "--import", "./test-setup.mjs"];
    foreach (b in fs\glob(".testcache/**/*.test.js")) {
        if (b.value.endsWith("-dom.test.js")) {
            dom.append(b.value);
        } else {
            plain.append(b.value);
        }
    }
    typescript["node-test"](ctx, {"args": plain});
    typescript["node-test"](ctx, {"args": dom});

    final scripts = mut ["--test"];
    foreach (s in fs\glob("scripts/*.test.mjs")) { scripts.append(s.value); }
    proc\exec("node", scripts, ".", {});

    // Both projects name their files src/..., so textsearch's paths get a prefix before the merge.
    final textsearch_report = fs\readFile(fs\join("..", "libs", "textsearch", "coverage.lcov"))
        .replace("SF:src/", "SF:libs/textsearch/src/");
    final pct = lcov\mergePercent(
        [fs\readFile("coverage.plain.lcov"), fs\readFile("coverage.dom.lcov"), textsearch_report],
        keep: "src/");
    fs\writeFile("coverage.txt", content: pct + "\n");
    // Two points of headroom: the figure moves a little with the Node patch version.
    final floor = 67;
    if (std\parseInt(pct.split(".")[0])! < floor) {
        throw "test: typescript coverage " + pct + "% is below the {floor}% floor; investigate the regression or lower the floor deliberately";
    }
}

// Renders the Diff showcase's changeset from its .patch with the Go reader; the showcase
// has no server to parse it. It lives here because the root writing into a descendant is MGS3001.
export fun diffdemo_generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.writesFiles("src/apps/diff/gen/*.ts");
    proc\exec("go", ["run", "../cmd/magus-utils", "diffdemo",
                     "-patch", "src/apps/diff/demo.patch",
                     "-out", "src/apps/diff/gen/demo.ts"], ".", {});
}

// The shared stylesheets, each bundled with what it @imports (console.css takes table.css).
final SHELL_CSS = ["tokens.css", "overrides.css", "console.css"];

// appBundles derives each app's lazy bundle from the tree: src/apps/<id>/main.ts builds
// gen/<id>/<id>.js, the path the shell loads it from. An app whose manifest (app.ts) says
// kind: "shell" ships inside console.js, so it gets none. apps.test.ts pins the pairing.
fun appBundles() > [[str]] !> any {
    final bundles = mut [<[str]>];
    foreach (entry in fs\glob("src/apps/*/main.ts")) {
        final dir = fs\dirname(entry.value);
        if (fs\readFile(fs\join(dir, "app.ts")).indexOf("kind: \"shell\"") != null) { continue; }
        final id = fs\basename(dir);
        bundles.append([entry.value, "gen/" + id + "/" + id + ".js"]);
    }
    return bundles;
}

fun copyInto(files: [str], dir: str) > void !> any {
    fs\mkdirAll(dir);
    foreach (f in files) {
        fs\copyFile(f, fs\join(dir, fs\basename(f)));
    }
}

// build bundles the app into gen/ with esbuild, copies the static shell beside it, and
// stamps the service worker.
export fun build(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.needs(diffdemo_generate);
    ctx.needs(root\graph_generate);
    // The Graph's Figures runtime control loads gen/wasm/.
    ctx.needs(docs\build_playground);
    ctx.writesFiles(
        "gen/console.js", "gen/theme.js",
        "gen/patternfly.css", "gen/tokens.css", "gen/overrides.css", "gen/console.css",
        "gen/*/*.js", "gen/*/*.css", "gen/*/scaffold.html",
        "gen/index.html", "gen/manifest.webmanifest", "gen/sw.js", "gen/assets/*",
        "gen/graph/knowledge-graph.json", "gen/graph/target-graph.json",
        "gen/wasm/buzz.wasm", "gen/wasm/wasm_exec.js",
        "gen/*/index.html");
    // Copied before the bundles: stamp-build.mjs hashes every precached file.
    copyInto([fs\join("..", "gen", "knowledge-graph.json"), fs\join("..", "gen", "target-graph.json")],
             dir: fs\join("gen", "graph"));

    foreach (b in [["src/desktop/main.ts", "gen/console.js"]] + appBundles()) {
        typescript["esbuild"](ctx, {"args": [b[0], "--bundle", "--minify", "--format=esm", "--outfile=" + b[1]]});
    }
    typescript["esbuild"](ctx, {"args": ["src/theme.ts", "--minify", "--outfile=gen/theme.js"]});
    typescript["esbuild"](ctx, {"args": [
        "src/styles/patternfly.css", "--bundle", "--minify",
        "--external:*.woff2", "--external:*.woff", "--external:*.ttf", "--external:*.svg",
        "--external:*.png", "--external:*.jpg", "--external:*.gif",
        "--outfile=gen/patternfly.css"]});
    foreach (c in SHELL_CSS) {
        typescript["esbuild"](ctx, {"args": [fs\join("src", "styles", c), "--bundle", "--minify", "--outfile=" + fs\join("gen", c)]});
    }
    // An app's own sheets sit at the top of its directory; a view's sheet below it is @imported by
    // one of those, so every app sheet bundles.
    foreach (c in fs\glob("src/apps/*/*.css")) {
        final outfile = fs\join("gen", fs\basename(fs\dirname(c.value)), fs\basename(c.value));
        typescript["esbuild"](ctx, {"args": [c.value, "--bundle", "--minify", "--outfile=" + outfile]});
    }

    copyInto(["index.html", "manifest.webmanifest", "sw.js"], dir: "gen");
    final assets = mut [<str>];
    foreach (a in fs\glob("src/assets/*")) { assets.append(a.value); }
    copyInto(assets, dir: fs\join("gen", "assets"));
    foreach (scaffold in fs\glob("src/apps/*/scaffold.html")) {
        copyInto([scaffold.value], dir: fs\join("gen", fs\basename(fs\dirname(scaffold.value))));
    }
    copyInto([fs\join("..", "docs", "gen", "playground", "buzz.wasm"),
              fs\join("..", "docs", "gen", "playground", "wasm_exec.js")],
             dir: fs\join("gen", "wasm"));

    proc\exec("node", ["scripts/app-stubs.mjs"], ".", {});
    // Last: it hashes every file above into sw.js's precache stamp.
    proc\exec("node", ["scripts/stamp-build.mjs"], ".", {});
}

// lint keeps TypeScript, CSS, and source formatting errors out of the console CI gate.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.needs(textsearch\lint);
    typescript["tsc"](ctx, {"args": ["--noEmit", "-p", "tsconfig.json"]});
    typescript["tsc"](ctx, {"args": ["--noEmit", "-p", "tsconfig.test.json"]});
    proc\exec("pnpm", ["exec", "biome", "check", "src"], ".", {});
    proc\exec("pnpm", ["exec", "stylelint", "src/**/*.css"], ".", {});
    proc\exec("node", ["scripts/lint-catch.mjs", "src"], ".", {});
}

// `format:rw` maintains declared source inputs.
export fun format(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    ctx.modifiesExistingFiles(
        "src/**/*.ts", "src/**/*.css", "src/**/*.html", "scripts/**/*.mjs",
        "index.html", "manifest.webmanifest", "sw.js", "package.json",
        "tsconfig.json", "tsconfig.test.json", "stylelint.config.mjs",
        "stylelint-control-sizing.mjs", "stylelint-label-token.mjs");
    typescript["biome-format"](ctx);
}

// security audits the dependency tree against the npm advisory database.
export fun security(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    advisories\audit(inheritedFatal: advisories\inheritedFatal(args));
}

// The anchor `magus affected ci` keys off. ctx.needs passes no args, so
// `--inherited=fatal` calls security directly.
export fun ci(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(install);
    if (!advisories\inheritedFatal(args)) {
        ctx.needs(generate, lint, test, build, security);
        return;
    }
    ctx.needs(generate, lint, test, build);
    security(ctx, args: args);
}
