import "magus";
// The shared advisory gate. See tools/audit.buzz for why an exit code is the wrong
// question and what this asks instead.
import "../tools/audit" as audit;
import "../tools/drift" as drift;
import "../tools/toolchain-policy" as policy;
// Modules the targets use: fs (lcov reads, badge write), os (pnpm/esbuild); the drift
// gates hash through tools/drift.buzz.
import "fs";
import "os";
// The shared DOM-free browser client lib (libs/textsearch) holds the search grammar the
// Reference drawer imports from source. Affected tracking is glob-based (not
// import-graph), so this handle lets lint pull in textsearch.lint (type-check + biome) - a
// lib edit then marks the console affected and re-checks it through the target graph.
import "project/../libs/textsearch" as textsearch;
import "project/.." as root;

// badge renders the coverage SVG; cov merges the per-process lcov reports into one figure.
import "../badge" as badge;
import "../coverage" as cov;

// magusfile binds this file's own exported targets (build, typecheck, test, ci); ts adds the
// TypeScript spell so the app's src/ is symbol-capable - its `scip` op indexes it (via tsconfig.json)
// for the knowledge graph. ts is opaque (pnpm owns the dependency graph; informational) and does not
// run in ci, which uses the custom targets below; it just makes the TypeScript browsable as symbols.
import "magus/spell/typescript";

// The console is the standalone native PWA (dashboard, logs, graph, activity as tabs + tiling). It owns
// its whole stack - a hand-authored index.html/manifest/sw, its own esbuild build (via pnpm scripts),
// and vendored copies of the shared lib/ui/proto/styles - with NO dependency on the docs site. This
// magusfile registers it as a first-class magus project so `magus affected ci` covers it.
magus\project({
    // Adopts the shared node window by explicit import, not by position in the tree.
    // Just node: this project drives no Go, and declaring a window for a toolchain it
    // does not use would fail it on a version nobody here runs.
    "tools": {"node": policy.node},
    "spells": [typescript],
    // Affected/drift tracks this sources glob, not the import graph, so every input must be named to be
    // watched. The client is TypeScript (esbuild strips the types) plus per-surface CSS and the
    // scaffold fragments the surfaces fetch; the hand-authored shell (index.html/manifest/sw) and the
    // build manifests (package.json + pnpm-lock.yaml, where the esbuild deps are pinned) round it out.
    // pnpm is the package manager - NOT npm; .npmrc's minimum-release-age gate is the reason.
    "sources": ["magusfile.buzz", "*.buzz",
                "../badge.buzz", "../coverage.buzz",
                "src/**/*.ts", "src/**/*.css", "src/**/*.html",
                "index.html", "manifest.webmanifest", "sw.js", "scripts/**/*.mjs",
                "package.json", "pnpm-lock.yaml", "tsconfig.json", "tsconfig.test.json",
                "stylelint.config.mjs", "stylelint-control-sizing.mjs",
                "../gen/knowledge-graph.json", "../gen/target-graph.json"],
    // src/gen/** is written by proto's buf-generate (see proto/buf.gen.yaml), but is
    // declared HERE because outputs are confined to the declaring project's subtree.
    // docs declares its own copy the same way. Without this the tree reads as ordinary
    // source, so magus cannot tell it has gone stale.
    "outputs": ["gen/**", "src/gen/**"],
    "targets": {
        // build rebuilds the committed gen/ and gates on drift, so it must run every time (skip_cache)
        // and alone (exclusive) so a peer mutating gen/ cannot trip its git-status check.
        "build": {"skip_cache": "rebuilds gen/ and gates on drift; a replay would skip the git-status check", "exclusive": true},
        // The advisory database is the input that matters here and it lives on the
        // registry, not in this tree. A hit would replay a clean bill of health from
        // before the advisory that now applies to a lockfile nobody touched.
        "security": {"skip_cache": "reads the npm advisory database, which changes independently of this tree"},
    },
});

export fun preflight(ctx: magus\Context, args: [str]) > void { install(); }

// pnpm, NOT npm: .npmrc's minimum-release-age supply-chain gate is the reason.
// Always let pnpm validate the install. An interrupted install leaves a node_modules
// that EXISTS but is incomplete, and the isDir guard this replaced read that as ready,
// handing the missing packages straight to tsc/esbuild. Reached once per invocation
// through preflight, which every target below already needs, so the unconditional
// --frozen-lockfile costs about a second on a warm tree and never races itself.
fun install() > void {
    os\exec("pnpm", ["install", "--frozen-lockfile"], ".", {});
}

// test runs the node:test suite over the bundled *.test.ts (the shell/view/tiling/keymap unit tests)
// and renders a line-coverage badge from the run.
//
// The suite runs Node THREE times on purpose and that split is load-bearing: happy-dom installs
// localStorage/sessionStorage as getter-only, and several tests stub them by assignment, so applying
// the DOM setup globally (one --import for everything) breaks them. Unifying the runs was tried and
// reverted.
//
// Which is why the figure needs cov.lcovMergePercent rather than lcovPercent: three processes means
// three reports, and each one lists the whole line table of every shared module it imported. Summing
// their LF/LH would count those files once per process and report a number that is not about
// anything. The merge unions DA: records instead, so a line is found once and hit if any run hit it.
//
// Both --sourcemap (esbuild, in the test script) and --enable-source-maps (node) are required. With
// only the first, Node reads the sourcemap for stack traces alone and every record stays
// SF:.testcache/<bundle>.js - a coverage figure about the bundle rather than the source.
//
// The badge sits in this project's own tree, NOT in <root>/assets/ beside the Go and textsearch ones,
// and so is not copied into the docs site (docs/render.buzz copies exactly one directory). It cannot
// be: `magus describe project console` reports depends_on=[. libs/textsearch], and writing another
// project's tree makes THAT project depend on this one, which magus rejects as a 2-cycle
// (MGS8003/CrossOutputCycle) - correctly, since the root would then have to run both before and after
// the console. Putting it on the site would mean widening render.buzz's asset copy, which is a
// separate call about the site rather than about this gate.
export fun test(ctx: magus\Context, args: [str]) > void {
    ctx.needs(preflight);
    ctx.writesFiles("coverage.svg");
    final before = drift.hashes(["coverage.svg"]);
    install();
    os\exec("pnpm", ["run", "test"], ".", {});

    final pct = cov\lcovMergePercent(
        [fs\readFile("coverage.plain.lcov"), fs\readFile("coverage.dom.lcov")],
        keep: "src/");
    fs\writeFile("coverage.svg", badge\coverage("console coverage", percent: pct, radius: 3));
    if (ctx.has_charm("rw")) { return; }
    if (drift.changedSince(before, ["coverage.svg"]).len() > 0) {
        // Names the figure this run measured. Node's line coverage differs by a fraction
        // of a point between platforms, so a badge committed from a developer machine can
        // be stale on CI by a rounding step nobody can see from the message alone.
        throw "test: console/coverage.svg is stale; this run measured {pct}%; re-run `magus run test:rw console` and commit the badge";
    }
}

// build bundles the whole app into gen/ (esbuild via pnpm: the surface bundles + CSS, then copy-static
// assembles index/manifest/sw + scaffolds + assets) and gates on drift: a clean checkout only goes
// dirty when a source edit was not rebuilt and committed. The `rw` charm (`build:rw`) keeps the result
// instead of gating. esbuild is pinned (mise), so the output is byte-stable and the gate holds.
export fun build(ctx: magus\Context, args: [str]) > void {
    ctx.needs(preflight);
    ctx.needs(root\graph_generate);
    final before = drift.hashes(["gen"]);
    os\exec("pnpm", ["run", "build"], ".", {});
    if (ctx.has_charm("rw")) {
        return;
    }
    if (drift.changedSince(before, ["gen"]).len() > 0) {
        throw "build: gen/ drifted; re-run `magus run build:rw console` and commit";
    }
}

// lint keeps TypeScript, CSS, and source formatting errors out of the console CI gate.
export fun lint(ctx: magus\Context, args: [str]) > void {
    ctx.needs(preflight);
    // The Reference drawer imports the search grammar from the shared libs/textsearch
    // source, so gate its type-check + biome here: a lib edit fails console lint too.
    ctx.needs(textsearch\lint);
    os\exec("pnpm", ["run", "typecheck"], ".", {});
    os\exec("pnpm", ["exec", "biome", "check", "src"], ".", {});
    os\exec("pnpm", ["run", "stylelint"], ".", {});
}

// security audits the dependency tree against the npm advisory database.
//
// --prod, not the whole tree, and that is the whole design. An unscoped audit reports the
// dev toolchain too - today a stylelint -> table -> ajv -> fast-uri advisory - which never
// reaches a browser and cannot be fixed from here. A gate that fails on something you
// cannot act on is a gate that gets muted, which is how six stale skip_cache workarounds
// happened. This fails only on what actually ships.
//
// It is NOT folded into lint: lint is cached on the tree, and this answer changes when the
// advisory database does. Its own target keeps that honest (see skip_cache above).
//
// The cooling period in .npmrc is the other half and the stronger one: this catches a
// KNOWN advisory, minimum-release-age keeps an unknown compromise out of the build for ten
// days in the first place.
export fun security(ctx: magus\Context, args: [str]) > void {
    ctx.needs(preflight);
    audit.audit();
}

// 'ci' is the anchor `magus affected ci` keys off: the lint gate (tsc), the unit tests, the
// build-plus-drift-gate, and the advisory audit, all first-class ci steps.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(preflight);
    ctx.needs(lint, test, build, security);
}
