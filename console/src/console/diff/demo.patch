--- a/services/identity/internal/token/verify.go
+++ b/services/identity/internal/token/verify.go
@@ -28,11 +28,13 @@ func (v *Verifier) Verify(ctx context.Context, raw string) (*authkit.Claims, error) {
 	if err := claims.Valid(v.clock.Now()); err != nil {
 		return nil, fmt.Errorf("token: %w", err)
 	}
-	if claims.Audience != v.service {
-		return nil, fmt.Errorf("token: minted for %q, not %q", claims.Audience, v.service)
+	// Membership, not equality: the gateway mints one token this service and the ledger
+	// both accept, and an equality check rejects it at whichever one is not listed first.
+	if !claims.Audience.Contains(v.service) {
+		return nil, fmt.Errorf("token: minted for %v, not %q", claims.Audience, v.service)
 	}
 	if v.revoked.Has(claims.ID) {
 		return nil, ErrRevoked
 	}
 	return &claims, nil
 }
