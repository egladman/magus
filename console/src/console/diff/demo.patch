+	require.NoError(t, err)
+	assert.True(t, claims.Audience.Contains("identity"))
 }
diff --git a/services/gateway/internal/mint/token_test.go b/services/gateway/internal/mint/token_test.go
new file mode 100644
index 0000000..4b8e1c9
--- /dev/null
+++ b/services/gateway/internal/mint/token_test.go
@@ -0,0 +1,12 @@
+package mint
+
+// Pins the behavior the dropped warning used to paper over: every service the caller named
+// reaches the token, in the order it was given.
+func TestForKeepsEveryAudience(t *testing.T) {
+	m := newMinter(t)
+	raw, err := m.For(t.Context(), "u-1029", []string{"identity", "ledger"})
+	require.NoError(t, err)
+
+	claims := parse(t, raw)
+	assert.Equal(t, authkit.Audience{"identity", "ledger"}, claims.Audience)
+}
