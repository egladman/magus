{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "GUARD_MAGUS_BIN=\"$(command -v magus 2>/dev/null || echo /tmp/magus)\" sh docs/guides/integrations/agents/magus-guard-command.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "GUARD_MAGUS_BIN=\"$(command -v magus 2>/dev/null || echo /tmp/magus)\" sh docs/guides/integrations/agents/magus-guard-path.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
