{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "magus agent hook --host claude-code",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "magus agent hook --host claude-code",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh docs/guides/integrations/agents/magus-guard-observe.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__magus__",
        "hooks": [
          {
            "type": "command",
            "command": "magus agent hook --host claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh docs/guides/integrations/agents/magus-rehydrate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh docs/guides/integrations/agents/magus-checkpoint.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
