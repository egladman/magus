{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh docs/guides/integrations/agents/magus-hook-command.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "sh docs/guides/integrations/agents/magus-hook-path.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "sh docs/guides/integrations/agents/magus-hook-observe.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "HOST_EVENT_RAW=1 sh docs/guides/integrations/agents/magus-hook-command.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^mcp__magus__"
      },
      {
        "hooks": [
          {
            "command": "HOST_EVENT_RAW=1 sh docs/guides/integrations/agents/magus-hook-command.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Agent|Task"
      },
      {
        "hooks": [
          {
            "command": "HOST_EVENT_RAW=1 sh docs/guides/integrations/agents/magus-hook-command.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "command": "HOST_EVENT_RAW=1 __MAGUS_SHELL_FLAGS=--observes-skill-loads sh docs/guides/integrations/agents/magus-hook-command.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Agent|Task"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sh docs/guides/integrations/agents/magus-rehydrate.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "sh docs/guides/integrations/agents/magus-checkpoint.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
