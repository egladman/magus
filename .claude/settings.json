{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh docs/guides/integrations/agents/magus-guard-command.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh docs/guides/integrations/agents/magus-guard-path.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
