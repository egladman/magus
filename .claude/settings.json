{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "./magus buzz -s docs/guides/integrations/agents/magus-hook-command.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "./magus buzz -s docs/guides/integrations/agents/magus-hook-path.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "HOST_EVENT_RAW=1 ./magus buzz -s docs/guides/integrations/agents/magus-hook-command.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^mcp__magus__"
      },
      {
        "hooks": [
          {
            "command": "./magus buzz -s docs/guides/integrations/agents/magus-hook-observe.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "HOST_EVENT_RAW=1 __MAGUS_SHELL_FLAGS=--observes-skill-loads ./magus buzz -s docs/guides/integrations/agents/magus-hook-command.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Agent|Task"
      },
      {
        "hooks": [
          {
            "command": "HOST_EVENT_RAW=1 ./magus buzz -s docs/guides/integrations/agents/magus-hook-command.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Skill"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "./magus buzz -s docs/guides/integrations/agents/magus-rehydrate.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "./magus buzz -s docs/guides/integrations/agents/magus-checkpoint.buzz",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
