{
  "env": {
    "MAGUS_NO_WAIT": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "magus buzz -s docs/guides/integrations/agents/magus-command.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "magus buzz -s docs/guides/integrations/agents/magus-path.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "magus buzz -s docs/guides/integrations/agents/magus-command.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^mcp__magus__"
      },
      {
        "hooks": [
          {
            "command": "magus buzz -s docs/guides/integrations/agents/magus-observe.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "magus buzz -s docs/guides/integrations/agents/magus-command.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "command": "magus buzz -s docs/guides/integrations/agents/magus-command.buzz -- --observes-skill-loads",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Agent|Task"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "magus buzz -s docs/guides/integrations/agents/magus-rehydrate.buzz",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "magus buzz -s docs/guides/integrations/agents/magus-checkpoint.buzz",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
