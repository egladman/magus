--arm skills-c1 --task changes-since-baseline --reps 3 --model claude-sonnet-5 --effort high --magus-binary ../../magus
--arm skills-full --task config-change-rebuild-set --reps 3 --model claude-sonnet-5 --effort high --magus-binary ../../magus
--arm skills-short --task config-change-rebuild-set --reps 3 --model claude-sonnet-5 --effort high --magus-binary ../../magus
--arm skills-c1 --task config-change-rebuild-set --reps 3 --model claude-sonnet-5 --effort high --magus-binary ../../magus
