# How far the short skill bodies compress: the full form, the short form, and a
# compressed short set (c1), over the eight fixture tasks, three reps each under
# Sonnet 5 high. Controls lead and cost nothing: a checker does not depend on the
# arm, so each task's pair runs once, and every scored run still probes its own
# arm. The 72 scored runs follow.
#
# Run from benchmarks/agent with a logged-in claude CLI, BENCH_C1_DIR naming the
# compressed skills dir (one <skill>/SKILL.md per skill), Bash pre-approved (a
# headless session is otherwise denied every command the guard rewrites), and its
# own results tree:
#   BENCH_C1_DIR=/abs/path/to/c1-skills BENCH_ALLOWED_TOOLS=Bash \
#       BENCH_RESULTS_DIR=results-compress ./run.sh --manifest compress.manifest
--arm skills-short --task add-metrics-percentile --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control golden
--arm skills-short --task add-metrics-percentile --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control null
--arm skills-short --task changes-since-baseline --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control golden
--arm skills-short --task changes-since-baseline --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control null
--arm skills-short --task config-change-rebuild-set --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control golden
--arm skills-short --task config-change-rebuild-set --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control null
--arm skills-short --task merge-config-falsy --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control golden
--arm skills-short --task merge-config-falsy --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control null
--arm skills-short --task platform-http-consumers --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control golden
--arm skills-short --task platform-http-consumers --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control null
--arm skills-short --task regenerate-api-summaries --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control golden
--arm skills-short --task regenerate-api-summaries --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control null
--arm skills-short --task rename-logger-factory --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control golden
--arm skills-short --task rename-logger-factory --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control null
--arm skills-short --task url-query-encoding --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control golden
--arm skills-short --task url-query-encoding --reps 1 --model claude-sonnet-5 --effort high --magus-binary ../../magus --control null
--arm skills-full --task add-metrics-percentile --reps 3 --model claude-sonnet-5 --effort high --magus-binary ../../magus
--arm skills-short --task add-metrics-percentile --reps 3 --model claude-sonnet-5 --effort high --magus-binary ../../magus
--arm skills-c1 --task add-metrics-percentile --reps 3 --model claude-sonnet-5 --effort high --magus-binary ../../magus
--arm skills-full --task changes-since-baseline --reps 3 --model claude-sonnet-5 --effort high --magus-binary ../../magus
