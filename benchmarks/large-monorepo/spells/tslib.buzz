// Feature-library spell for the large-monorepo benchmark.
// Non-opaque so the lib's TS sources are hashed; a no-op build (true) gives the
// lib a target handle an app can ctx.needs, propagating the lib's cache key
// into the app. The 5 real next builds dominate the wall-clock.
import "magus/spell";

export fun mgs_getName() > str { return "tslib"; }

export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.ts"}, Path{value = "**/*.tsx"}, Path{value = "**/*.js"}, Path{value = "**/*.jsx"}, Path{value = "**/*.json"}, Path{value = "package.json"}];
}

fun noop(target: Target) > Command { return Command{bin = "true", args = []}; }

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {"noop": noop};
}
