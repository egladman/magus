// Report whether a release tag names a PRERELEASE, for the GitHub Release's prerelease flag.
//
// Parsed as semver rather than sniffed for a hyphen. `contains(github.ref_name, '-')` in a
// workflow expression calls v1.2.3+build-1 a prerelease, because it cannot tell a prerelease
// component from build metadata - and semver says build metadata is not one. Getting that
// wrong marks an ordinary release as a prerelease, which hides it from everyone following
// the repo's latest.
//
// semver\isPrerelease is the predicate the release index and the docs site's latest stable
// release use too, so the release flag, `magus self update` and the install docs cannot
// disagree about one tag.
//
// Reads TAG. Prints "true" or "false" for $GITHUB_OUTPUT.
import "os";
import "semver";
import "std";

fun env(name: str) > str { return os\env(name) ?? ""; }

// releaseFlag is the value the step writes for tag. A tag that is not semver throws: the
// predicate alone would call it no prerelease, publishing it as the repo's latest.
export fun releaseFlag(tag: str) > bool !> any {
    if (!semver\isValid(tag)) {
        throw "prerelease: TAG \"{tag}\" is not a semantic version";
    }
    return semver\isPrerelease(tag);
}

fun main() > void !> any {
    final tag = env("TAG");
    if (tag == "") {
        // On a TAG run an empty TAG is a wiring bug, and staying quiet would emit an empty
        // output that GitHub reads as false - marking a release candidate as a full release.
        //
        // Keyed on GITHUB_REF_TYPE rather than GITHUB_OUTPUT, which is set for EVERY Actions
        // step: `magus buzz -t` on this file runs main() before the tests, so the broader
        // check threw in ci's advice-test job on every pull request - a release guard failing
        // runs that will never cut a release. Only a tag run can be missing a tag.
        if (env("GITHUB_REF_TYPE") == "tag") {
            throw "prerelease: TAG is empty on a tag run; the step must pass the tag";
        }
        std\print("prerelease: no TAG; nothing to classify");
        return;
    }
    std\print("{releaseFlag(tag)}");
}


test "a plain version is not a prerelease" {
    std\assert(releaseFlag("v0.4.0") == false, message: "v0.4.0 is a release");
}

test "an rc tag is a prerelease" {
    std\assert(releaseFlag("v0.5.0-rc.1"), message: "v0.5.0-rc.1 is a prerelease");
    std\assert(releaseFlag("v1.0.0-beta"), message: "v1.0.0-beta is a prerelease");
}

// The case a hyphen check gets wrong, and the reason this parses instead.
test "build metadata containing a hyphen is not a prerelease" {
    std\assert(releaseFlag("v1.2.3+build-1") == false, message: "+build-1 is metadata, not a prerelease");
}

test "a prerelease alongside build metadata is still a prerelease" {
    std\assert(releaseFlag("v1.2.3-rc.1+build-9"), message: "the rc.1 component still counts");
}

test "a tag that is not a version is refused rather than called a release" {
    var refused = false;
    try {
        _ = releaseFlag("vendor-bump");
    } catch (e) {
        refused = true;
    }
    std\assert(refused, message: "vendor-bump must throw");
}
