// Comment once on a PR whose merge conflicts land in GENERATED files.
//
// GitHub never runs a merge driver, so those conflicts cannot resolve themselves and the
// web editor is the worst place to try: the correct merge of build output is whatever
// regenerating produces, which is what `magus vcs resolve` does. Silent unless generated
// files actually conflict - an ordinary source conflict is the author's business.
//
// Reads PR_NUMBER, PR_BASE, and PR_HEAD_SHA from the environment; shells out to `gh` to
// comment.
import "os";
import "fs";
import "magus";
import "serialize";
import "std";

final bodyFile = "/tmp/merge-conflict-advice.md";
final marker = "<!-- magus:merge-conflict-advice -->";

fun env(name: str) > str {
    final v = os\env(name);
    if (v == null) { return ""; }
    return "" + v;
}

// conflicted reports which paths collide when head is merged into base, WITHOUT
// performing a merge: `git merge-tree --write-tree` does the three-way merge in memory
// and prints the conflicted paths, exiting 1 when there are any and 0 when it merges
// clean. Nothing touches the working tree, so a cancelled job cannot strand a half-merge
// the way a merge/abort pair can, and no committer identity is needed.
//
// Not `gh pr view --json mergeable`: that reports only THAT a PR conflicts, never which
// files, and the files decide both whether to comment and what to name.
//
// head is passed explicitly rather than read as HEAD because actions/checkout resolves a
// pull_request event to the ephemeral merge commit, which is base already merged with
// head - comparing that against base would find nothing.
fun conflicted(base: str, head: str) > [str] {
    os\exec("git", args: ["fetch", "--no-tags", "origin", base], dir: ".", opts: {});
    final res = os\exec("git", args: ["merge-tree", "--write-tree", "--name-only",
        "--no-messages", "origin/" + base, head], dir: ".", opts: {"allow_failure": true});
    if (res.code == 0) { return mut []; }
    // 1 is "merged with conflicts"; anything else is git failing to answer at all, which
    // must not read as "no conflicts".
    if (res.code != 1) { throw "merge-conflict-advice: git merge-tree: " + res.stderr; }
    return conflictPaths(res.stdout);
}

// conflictPaths reads `git merge-tree --write-tree --name-only` output: the first line
// is the OID of the merged tree, every other non-empty line is a conflicted path. Split
// out from conflicted so the parse is testable without a repository. `text`, not `out`,
// because `out` is a reserved word in Buzz.
fun conflictPaths(text: str) > [str] {
    var paths = mut [];
    var first = true;
    foreach (line in text.split("\n")) {
        if (first) { first = false; }
        else { if (line != "") { paths.append(line); } }
    }
    return paths;
}

// generated keeps the paths the workspace declares as build output (role: output).
// magus\describe runs the subcommand in-process rather than through os\exec: it is the
// magus already running, so there is no PATH lookup, no skew between the magus that
// advises and the magus that resolves, and no argv quoting to get wrong.
fun generated(paths: [str]) > [str] {
    var found = mut [];
    if (paths.len() == 0) { return found; }
    var argv = mut ["file"];
    foreach (p in paths) { argv.append(p); }
    argv.append("-o");
    argv.append("json");
    final report = magus\describe(argv, opts: {"quiet": true}).stdout;
    foreach (f in serialize\jsonDecode(report).q("files").listValue()) {
        if (f.q("role").stringValue() == "output") { found.append(f.q("path").stringValue()); }
    }
    return found;
}

fun advice(base: str, files: [str]) > str {
    var body = marker + "\nThis branch conflicts with `" + base + "` in files magus generates:\n\n";
    foreach (f in files) { body = body + "- `" + f + "`\n"; }
    return body
        + "\nThese are build output, so the correct merge is whatever regenerating produces:\n\n"
        + "```sh\ngit merge origin/" + base + "\nmagus vcs resolve\n```\n\n"
        + "`magus vcs resolve` settles every conflicted generated file at once and regenerates "
        + "once. Conflicts in hand-written files are still yours.\n";
}

fun main() > void {
    final pr = env("PR_NUMBER");
    final base = env("PR_BASE");
    final head = env("PR_HEAD_SHA");
    if (pr == "" and base == "" and head == "") {
        // No PR context at all: not a pull request, or the file was loaded to run its
        // test blocks. Either way there is nothing to advise on, and refusing to start
        // is not the same as failing.
        std\print("merge-conflict-advice: no PR context; nothing to advise");
        return;
    }
    if (pr == "" or base == "" or head == "") {
        throw "merge-conflict-advice: PR_NUMBER, PR_BASE, and PR_HEAD_SHA must be set together";
    }

    final files = generated(conflicted(base, head: head));
    if (files.len() == 0) {
        std\print("no generated files conflict with " + base);
        return;
    }

    fs\writeFile(bodyFile, content: advice(base, files: files));
    // --edit-last --create-if-none is the upsert: post once, rewrite in place after that.
    os\exec("gh", args: ["pr", "comment", pr, "--body-file", bodyFile, "--edit-last", "--create-if-none"],
        dir: ".", opts: {});
    std\print("advised on PR " + pr + ": " + files.join(", "));
}

main();

test "conflictPaths drops the merged tree's oid and keeps the rest" {
    final paths = conflictPaths("38d2ff24\nMAGUS.md\ngen/target-graph.json\n");
    std\assert(paths.len() == 2, message: "two paths");
    std\assert(paths[0] == "MAGUS.md", message: "first path");
    std\assert(paths[1] == "gen/target-graph.json", message: "second path");
}

test "conflictPaths on a clean merge yields nothing" {
    std\assert(conflictPaths("38d2ff24\n").len() == 0, message: "no paths");
}

test "advice names the marker, every file, and the command that settles them" {
    final body = advice("main", files: ["MAGUS.md", "gen/target-graph.json"]);
    std\assert(body.startsWith(marker), message: "starts with the upsert marker");
    std\assert(body.indexOf("- `MAGUS.md`") != null, message: "names the first file");
    std\assert(body.indexOf("- `gen/target-graph.json`") != null, message: "names the second");
    std\assert(body.indexOf("magus vcs resolve") != null, message: "names the command");
    std\assert(body.indexOf("still yours") != null, message: "scopes what it does not cover");
}
