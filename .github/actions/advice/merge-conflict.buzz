// Comment once on a PR whose merge conflicts land in GENERATED files.
//
// GitHub never runs a merge driver, so those conflicts cannot resolve themselves and the
// web editor is the worst place to try: the correct merge of build output is whatever
// regenerating produces, which is what `magus vcs resolve` does. Silent unless generated
// files actually conflict - an ordinary source conflict is the author's business.
//
// Reads REPO, PR_NUMBER, PR_BASE, PR_HEAD_SHA, and FIX_LABEL_OFFER from the environment,
// and writes its section of the pull request's one magus comment through advice\publish.
import "proc";
import "advice";
import "magus";
import "std";

final section = "merge-conflicts";

// conflicted reports which paths collide when head is merged into base, WITHOUT performing a
// merge: `git merge-tree --write-tree` does the three-way merge in memory and prints the
// conflicted paths. Nothing touches the working tree, so a cancelled job cannot strand a
// half-merge the way a merge/abort pair can, and no committer identity is needed.
//
// Its exit code is 0 for a clean merge and 1 for BOTH "merged with conflicts" and "could not
// resolve a ref", which is why the empty-answer check below exists.
//
// Not `gh pr view --json mergeable`: that reports only THAT a PR conflicts, never which
// files, and the files decide both whether to comment and what to name.
//
// head is passed explicitly rather than read as HEAD because actions/checkout resolves a
// pull_request event to the ephemeral merge commit, which is base already merged with
// head - comparing that against base would find nothing.
fun conflicted(base: str, head: str) > [str] !> str {
    // An explicit refspec, because a bare `git fetch origin <base>` writes FETCH_HEAD and
    // only updates refs/remotes/origin/<base> when remote.origin.fetch already covers it -
    // which actions/checkout does NOT configure on a pull_request. It exits 0 either way, so
    // without this the merge-tree below runs against a ref that does not exist.
    final fetched = proc\exec("git", args: ["fetch", "--no-tags", "origin",
        "+refs/heads/" + base + ":refs/remotes/origin/" + base], dir: ".",
        opts: {"allow_failure": true});
    if (!fetched.ok) { throw "merge-conflict-advice: git fetch " + base + ": " + fetched.stderr; }

    // core.quotePath would C-quote a non-ASCII path ("gen/caf\303\251.json", quotes and all),
    // and that string reaches describeFile, matches no output glob, and gets reported to the
    // author as their file.
    final res = proc\exec("git", args: ["-c", "core.quotePath=false", "merge-tree",
        "--write-tree", "--name-only", "--no-messages", "origin/" + base, head], dir: ".",
        opts: {"allow_failure": true});
    if (res.code == 0) { return mut [<str>]; }
    if (res.code != 1) { throw "merge-conflict-advice: git merge-tree: " + res.stderr; }

    // Exit 1 means "merged with conflicts" AND "could not resolve a ref" - measured on git
    // 2.55.0, where an unresolvable ref exits 1 with empty stdout. Reading that as a clean
    // merge is how this advisor RETRACTED its own warning and went green while the conflicts
    // were still there, so an empty answer on exit 1 is a failure to answer.
    final paths = conflictPaths(res.stdout);
    if (paths.len() == 0) {
        throw "merge-conflict-advice: git merge-tree reported conflicts but named none, so it "
            + "could not compare origin/" + base + " with " + head + ": " + res.stderr;
    }
    return paths;
}

// conflictPaths reads `git merge-tree --write-tree --name-only` output: the first line
// is the OID of the merged tree, every other non-empty line is a conflicted path. Split
// out from conflicted so the parse is testable without a repository. `text`, not `out`,
// because `out` is a reserved word in Buzz.
fun conflictPaths(text: str) > [str] {
    final paths = mut [<str>];
    var first = true;
    foreach (line in text.split("\n")) {
        if (first) { first = false; }
        else { if (line != "") { paths.append(line); } }
    }
    return paths;
}

// generated keeps the paths the workspace declares as build output (role: output).
//
// magus\describeFile returns the report as a TYPED value, so `f.role` and `f.path` are
// checked when this file compiles. The earlier form asked for `-o json` and walked the
// result with q("files").listValue() / q("role").stringValue(), where a mistyped key is
// a null at run time on a CI job nobody is watching.
fun generated(paths: [str]) > [str] !> any {
    final found = mut [<str>];
    if (paths.len() == 0) { return found; }
    foreach (f in magus\describeFile(paths).files) {
        if (f.role == "output") { found.append(f.path); }
    }
    return found;
}

// authored keeps the conflicted paths magus does not generate, in the order git reported
// them. Pure over plain lists so the set difference is testable without a repository.
//
// `mut [<str>]`, not `mut []`: an untyped empty list infers `mut [any]`, which gopherbuzz
// accepts where `[str]` is expected and upstream rejects. Unexported for the same reason
// conflictPaths is - nothing imports this file, and an export in a file with no `namespace`
// is a compile error upstream.
fun authored(all: [str], generated: [str]) > [str] {
    final found = mut [<str>];
    foreach (p in all) {
        var claimed = false;
        foreach (g in generated) { if (g == p) { claimed = true; } }
        if (!claimed) { found.append(p); }
    }
    return found;
}

// conflictTitle is the collapsed comment's summary line. Pure because the count in it is
// the whole signal a reader has for deciding whether to open the section, and inline in
// main it was the one interpolation no test could reach.
fun conflictTitle(n: int) > str {
    return "Merge conflicts in generated files ({n})";
}

// conflictBody is the section text. Pure, so the wording is testable.
//
// Commands first, reasoning after: the commands are all most readers need, and the reasoning
// is what stops the rest from opening the web conflict editor instead.
//
// Both lists are named, because "conflicts in hand-written files are still yours" was true
// and useless - the merge that produced this comment already knows which files those are.
fun conflictBody(base: str, files: [str], mine: [str], label: str) > str {
    var body = "These conflicts are in build output. Nothing here has to be reconciled by "
        + "hand, because the correct merge of a generated file is not a blend of two byte "
        + "streams - it is whatever regenerating produces.\n\n"
        + "```sh\ngit merge origin/" + base + "\nmagus vcs resolve\ngit push\n```\n\n"
        + "**Merge, do not rebase.** Merging the base in needs no force-push, so anything "
        + "stacked on this branch stays valid, and a squash merge keeps the merge commit off "
        + "`" + base + "` anyway.\n\n"
        + "`magus vcs resolve` classifies every conflicted path at once and regenerates once "
        + "rather than once per file. It settles the outputs git treats as binary, which no "
        + "three-way merge can settle at all, and the deletions no merge driver is ever "
        + "called for. It also stages what regeneration touched, so a following `git commit` "
        + "or `git rebase --continue` does not refuse on a dirty tree.\n\n"
        + "**magus settles these {files.len()}:**\n\n";
    foreach (f in files) { body = body + "- `" + f + "`\n"; }
    if (mine.len() > 0) {
        body = body + "\n**These {mine.len()} are yours** - nothing in this "
            + "workspace generates them, so `magus vcs resolve` reports them and leaves "
            + "them alone:\n\n";
        foreach (f in mine) { body = body + "- `" + f + "`\n"; }
    }
    if (label != "") {
        body = body + "\nOr label this pull request **`" + label + "`** and magus does exactly "
            + "the above on a runner and pushes the result. The label is the consent, so "
            + "removing it stops magus touching the branch again.\n";
    }
    return body + "\nWhy a conflict is reported at all when your own clone would settle it: "
        + "a merge driver has to be registered per clone and cannot be committed, so "
        + "github.com computes mergeability with a plain three-way merge. "
        + "[Git integration](https://eli.gladman.cc/magus/guides/integrations/git/) has the "
        + "detail.\n";
}

fun main() > void !> str {
    final repo = advice\env("REPO");
    final pr = advice\env("PR_NUMBER");
    final base = advice\env("PR_BASE");
    final head = advice\env("PR_HEAD_SHA");
    // Empty unless a workflow honours the label: an offer nobody can accept is noise.
    final label = advice\env("FIX_LABEL_OFFER");
    if (pr == "" and base == "" and head == "") {
        // No PR context at all: not a pull request, or the file was loaded to run its
        // test blocks. Either way there is nothing to advise on, and refusing to start
        // is not the same as failing.
        std\print("merge-conflict-advice: no PR context; nothing to advise");
        return;
    }
    if (pr == "" or base == "" or head == "") {
        throw "merge-conflict-advice: PR_NUMBER, PR_BASE, and PR_HEAD_SHA must be set together";
    }

    if (advice\silenced(repo, pr: pr, name: section)) {
        // Retract rather than leave the last finding frozen on the page.
        advice\publish(repo, pr: pr, name: section, title: "", body: "");
        std\print("merge-conflicts: silenced by label");
        return;
    }

    final all = conflicted(base, head: head);
    final files = generated(all);
    if (files.len() == 0) {
        // Retract: conflicts that have been resolved must not leave a section behind
        // claiming they are still there.
        advice\publish(repo, pr: pr, name: section, title: "Merge conflicts in generated files", body: "");
        std\print("no generated files conflict with " + base);
        return;
    }

    advice\publish(repo, pr: pr, name: section, title: conflictTitle(files.len()),
        body: conflictBody(base, files: files, mine: authored(all, generated: files),
            label: label));
    std\print("advised on PR " + pr + ": " + files.join(", "));
}


test "conflictPaths drops the merged tree's oid and keeps the rest" {
    final paths = conflictPaths("38d2ff24\nMAGUS.md\ngen/target-graph.json\n");
    std\assert(paths.len() == 2, message: "two paths");
    std\assert(paths[0] == "MAGUS.md", message: "first path");
    std\assert(paths[1] == "gen/target-graph.json", message: "second path");
}

test "conflictPaths on a clean merge yields nothing" {
    std\assert(conflictPaths("38d2ff24\n").len() == 0, message: "no paths");
}

test "conflictBody names every file and the command that settles them" {
    final body = conflictBody("main", files: ["MAGUS.md", "gen/target-graph.json"], mine: mut [], label: "");
    std\assert(body.indexOf("- `MAGUS.md`") != null, message: "names the first file");
    std\assert(body.indexOf("- `gen/target-graph.json`") != null, message: "names the second");
    std\assert(body.indexOf("magus vcs resolve") != null, message: "names the command");
    std\assert(body.indexOf("git push") != null, message: "names the push, so no force-push is implied");
    std\assert(body.indexOf("Merge, do not rebase") != null, message: "teaches the no-force-push path");
    std\assert(body.indexOf("guides/integrations/git/") != null, message: "links the explanation");
}

test "conflictBody names the conflicts magus will not touch, and says nothing when there are none" {
    final mixed = conflictBody("main", files: ["MAGUS.md"], mine: ["internal/run.go"], label: "");
    std\assert(mixed.indexOf("- `internal/run.go`") != null, message: "names the authored conflict");
    std\assert(mixed.indexOf("are yours") != null, message: "scopes what it does not cover");

    final only = conflictBody("main", files: ["MAGUS.md"], mine: mut [], label: "");
    std\assert(only.indexOf("are yours") == null, message: "no empty section when magus settles everything");
}

// Every other assertion here reads a substring that CONCATENATION produced, so an
// interpolation that stopped firing and rendered literal braces would leave this file green.
test "conflictBody offers the label only where the fixer is enabled" {
    final offered = conflictBody("main", files: ["MAGUS.md"], mine: mut [], label: "magus:auto-fix:requested");
    std\assert(offered.indexOf("`magus:auto-fix:requested`") != null, message: "names the label");
    std\assert(offered.indexOf("removing it stops magus") != null, message: "says how to revoke");

    final silent = conflictBody("main", files: ["MAGUS.md"], mine: mut [], label: "");
    std\assert(silent.indexOf("label this pull request") == null, message: "no offer when disabled");
}

test "conflictBody and conflictTitle render their counts, not the placeholder" {
    final body = conflictBody("main", files: ["MAGUS.md", "gen/target-graph.json"],
        mine: ["internal/run.go"], label: "");
    std\assert(body.indexOf("settles these 2") != null, message: "the generated count renders");
    std\assert(body.indexOf("These 1 are yours") != null, message: "the authored count renders");
    std\assert(conflictTitle(3) == "Merge conflicts in generated files (3)", message: "the summary line renders");
}

test "authored keeps the conflicts nothing generates, in git's order" {
    final mine = authored(["a.go", "MAGUS.md", "b.go"], generated: ["MAGUS.md"]);
    std\assert(mine.len() == 2, message: "two authored paths");
    std\assert(mine[0] == "a.go", message: "order preserved");
    std\assert(mine[1] == "b.go", message: "order preserved");
    std\assert(authored(["MAGUS.md"], generated: ["MAGUS.md"]).len() == 0, message: "all generated");
}
