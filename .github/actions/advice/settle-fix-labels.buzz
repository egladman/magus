// settle-fix-labels.buzz - swaps the request label for the done label once both fixers ran.
//
// Its own step, not a tail on each fixer: each reads the request label as consent, so a
// fixer retiring it would silently withdraw consent from the next one.
//
// Reads REPO, PR_NUMBER, FIX_LABEL, DONE_LABEL. Best-effort: a label is bookkeeping, not
// worth failing a successful fix over.
import "proc";
import "advice";
import "std";

fun gh(args: [str]) > bool !> any {
    return proc\exec("gh", args: args, dir: ".",
        opts: {"quiet": true, "allow_failure": true}).ok;
}

fun labelled(repo: str, pr: str, want: str) > bool !> any {
    final listed = proc\exec("gh", args: ["api", "repos/" + repo + "/issues/" + pr + "/labels"],
        dir: ".", opts: {"quiet": true, "allow_failure": true});
    if (!listed.ok) { return false; }
    return listed.stdout.indexOf("\"name\": \"" + want + "\"") != null;
}

fun main() > void !> any {
    final repo = advice\env("REPO");
    final pr = advice\env("PR_NUMBER");
    final request = advice\env("FIX_LABEL");
    final done = advice\env("DONE_LABEL");
    if (repo == "" or pr == "" or request == "" or done == "") { return; }

    // Nothing asked for, nothing finished: any other label event lands here too.
    if (!labelled(repo, pr: pr, want: request)) {
        std\print("settle-fix-labels: " + request + " absent; leaving labels alone");
        return;
    }

    // Add before removing: dropping the request first leaves a crash window where the PR
    // carries neither and reads as though nobody asked.
    if (!gh(["api", "-X", "POST", "repos/" + repo + "/issues/" + pr + "/labels",
             "-f", "labels[]=" + done])) {
        std\print("settle-fix-labels: could not add " + done + "; leaving " + request + " in place");
        return;
    }
    // The label rides in the path, so it must not contain a slash; a colon is legal there.
    if (!gh(["api", "-X", "DELETE",
             "repos/" + repo + "/issues/" + pr + "/labels/" + request])) {
        std\print("settle-fix-labels: added " + done + " but could not remove " + request);
        return;
    }
    std\print("settle-fix-labels: " + request + " -> " + done);
}
