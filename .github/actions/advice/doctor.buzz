// Comment what `magus doctor` found about the workspace this pull request builds.
//
// NON-BLOCKING on purpose. Doctor validates conventions a workspace may not share, so it
// reports rather than gates - the same reason this repo stopped running it in preflight.
// A consumer who never wired doctor into their own CI still gets the finding here, which
// is the point: the advice arrives without them having to build the pipeline for it.
//
// ONLY FAILURES REACH THE PULL REQUEST.
//
// A doctor advisory describes the workspace, and it holds whether or not this pull
// request exists. Measured 2026-09-02: a clean checkout of main with no edits reproduces
// the advisory list this section posted on pull requests 120 through 125, and all six of
// those runs reported 0 failing. Nothing in any of those bodies came from the change
// under review. An author who did not cause a finding and cannot land its fix here is
// reading backlog, and reprinting backlog on every pull request teaches that author to
// skip the section on the day it says `fail`.
//
// A FAILING check earns the interruption: it passed for somebody, so a change broke it.
// Run `magus doctor` at the keyboard to see the advisory tier, with the detail this
// comment has no room for.
//
// Reads REPO and PR_NUMBER.
import "advice";
import "magus";
import "std";

final section = "doctor";

// reportable names the threshold so a test can pin it. The header says why `advice`
// fails this check.
export fun reportable(status: str) > bool { return status == "fail"; }

// summarize renders the failing checks. Pure over a plain list so the wording is
// testable: the magus namespace's types annotate but do not construct.
export fun summarize(fails: [str]) > str {
    if (fails.len() == 0) { return ""; }
    final parts = mut ["**`magus doctor` reports " + "{fails.len()}" + " failing check(s):**\n\n"];
    foreach (f in fails) { parts.append("- " + f + "\n"); }
    return parts.join("")
        + "\nRun `magus doctor` locally for the detail behind each one, and for the "
        + "advice-level checks this comment leaves out.\n";
}

fun main() > void !> any {
    final repo = advice\env("REPO");
    final pr = advice\env("PR_NUMBER");
    if (repo == "" or pr == "") {
        std\print("doctor: no PR context; nothing to advise");
        return;
    }

    if (advice\silenced(repo, pr: pr, name: section)) {
        // Retract rather than leave the last finding frozen on the page.
        advice\publish(repo, pr: pr, name: section, title: "", body: "");
        std\print("doctor: silenced by label");
        return;
    }

    var fails = mut [];
    foreach (c in magus\doctor([]).checks) {
        if (!reportable(c.status)) { continue; }
        fails.append("`" + c.name + "`: " + c.message);
    }
    final body = summarize(fails);
    advice\publish(repo, pr: pr, name: section,
        title: "Workspace health ({fails.len()} failing)", body: body);
    if (body == "") { std\print("doctor: no failing check"); return; }
    std\print("doctor: advised on {fails.len()} failure(s)");
}


test "summarize lists the failing checks" {
    final body = summarize(["`sockets`: no daemon"]);
    std\assert(body.indexOf("failing check") != null, message: "names the failures");
    std\assert(body.indexOf("`sockets`: no daemon") != null, message: "carries name and message");
    std\assert(body.indexOf("magus doctor` locally") != null, message: "says where the rest is");
}

test "summarize is empty with no failing check, so the section retracts" {
    std\assert(summarize([]) == "", message: "nothing to say");
}

test "only a failing check reaches a pull request" {
    std\assert(reportable("fail"), message: "a check that broke is worth the interruption");
    std\assert(!reportable("advice"), message: "a clean main produces these too");
    std\assert(!reportable("ok"), message: "nothing to say about a check that passed");
    std\assert(!reportable("skip"), message: "a check that did not run found nothing");
}
