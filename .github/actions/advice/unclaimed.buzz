// Comment when a pull request changes files no project declares.
//
// Seeding and keying disagree here, which is why this section leads the comment: the file
// pulls its containing project into the affected set by directory containment, and enters
// no cache key. So the reruns are paid and cannot change the answer, and a file that IS an
// input replays a verdict computed under the rules it just changed. See MGS1028.
//
// Usually it means a project's `sources` glob is too narrow, or the file belongs to a
// directory nobody declared as a project yet.
//
// Reads REPO, PR_NUMBER, PR_BASE, PR_HEAD_SHA.
import "proc";
import "advice";
import "magus";
import "std";

final section = "unclaimed";

fun changed(base: str, head: str) > [str] !> any {
    advice\fetchBase(base, refspec: false);
    final res = proc\exec("git", args: ["diff", "--name-only", advice\diffRange(base, head: head)],
        dir: ".", opts: {"quiet": true, "allow_failure": true});
    var paths = mut [];
    foreach (line in res.stdout.split("\n")) {
        if (line != "") { paths.append(line); }
    }
    return paths;
}

fun body(files: [str], total: int) > str {
    final parts = mut ["A file no project declares still reruns its containing project on "
        + "every touch, and the cache key never moves: work paid for an answer that cannot "
        + "change. When the file really is an input (a lint rule set, a toolchain pin, a "
        + "formatter config), that same gap lets a verdict computed under the old rules "
        + "replay.\n\n"
        + "**" + "{files.len()}" + " of the " + "{total}" + " files in this pull "
        + "request are claimed by no project:**\n\n"];
    foreach (f in files) { parts.append("- `" + f + "`\n"); }
    return parts.join("")
        + "\nDeclare the ones that are inputs in the owning project's `magus\\project`:\n\n"
        + "```buzz\nmagus\\project(\{\n    \"sources\": [\"" + files[0] + "\"],\n\});\n```\n\n"
        + "If a file belongs outside the build (a LICENSE, an editor config, a note to "
        + "yourself), leaving it undeclared is correct: declaring it would only make an "
        + "unrelated edit invalidate a cache.\n\n"
        + "`magus describe file <path>` explains any one of them, and MGS1028 carries the "
        + "seeding-versus-keying argument in full.\n";
}

fun main() > void !> any {
    final repo = advice\env("REPO");
    final pr = advice\env("PR_NUMBER");
    final base = advice\env("PR_BASE");
    final head = advice\env("PR_HEAD_SHA");
    if (pr == "" and base == "" and head == "") {
        std\print("unclaimed: no PR context; nothing to advise");
        return;
    }
    if (pr == "" or base == "" or head == "") {
        throw "unclaimed: PR_NUMBER, PR_BASE, and PR_HEAD_SHA must be set together";
    }

    if (advice\silenced(repo, pr: pr, name: section)) {
        // Retract rather than leave the last finding frozen on the page.
        advice\publish(repo, pr: pr, name: section, title: "", body: "");
        std\print("unclaimed: silenced by label");
        return;
    }

    final paths = changed(base, head: head);
    if (paths.len() == 0) {
        advice\publish(repo, pr: pr, name: section, title: "Files no project claims", body: "");
        return;
    }
    var found = mut [];
    foreach (f in magus\describeFile(paths).files) {
        if (f.role == "unclaimed") { found.append(f.path); }
    }
    if (found.len() == 0) {
        advice\publish(repo, pr: pr, name: section, title: "Files no project claims", body: "");
        std\print("unclaimed: every changed file is claimed");
        return;
    }
    advice\publish(repo, pr: pr, name: section, title: "Files no project claims ({found.len()})",
        body: body(found, total: paths.len()));
    std\print("unclaimed: advised on " + found.join(", "));
}


test "body leads with the rerun cost and the stale verdict" {
    final text = body([".editorconfig"], total: 4);
    std\assert(text.indexOf("cache key never moves") < text.indexOf("1 of the 4 files"),
        message: "the cost comes before the list");
    std\assert(text.indexOf("old rules") != null, message: "and the stale verdict beside it");
    std\assert(text.indexOf("```buzz\nmagus\\project(\{\n    \"sources\": [\".editorconfig\"],")
        != null, message: "the fix is a snippet naming the file");
    std\assert(text.indexOf("MGS1028") != null, message: "cites the argument in full");
}

test "the fix snippet reaches the comment unrewritten" {
    // compose deep-links glossary terms, and `project` and `sources` are both in it.
    final rendered = advice\compose("", name: section, title: "Files no project claims (1)",
        body: body([".editorconfig"], total: 4));
    std\assert(rendered.indexOf("```buzz\nmagus\\project(\{") != null,
        message: "the snippet still runs when pasted");
    std\assert(rendered.indexOf("[MGS1028](") != null, message: "and the code is clickable");
}
