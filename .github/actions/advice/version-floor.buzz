// Comment when a pull request RAISES the workspace's magus version floor.
//
// `required_version` in magus.yaml is checked before the magusfile is evaluated, so a
// contributor whose local magus predates it cannot load the workspace at all - and the
// failure names the floor, not the fix. Raising it is therefore a change every
// contributor has to act on, and the pull request that raises it is the only place they
// will all see it.
//
// Silent unless this PR changes that line, which is almost never.
import "vcs";
import "advice";
import "std";

final section = "version-floor";

// raised returns the new floor when the diff sets required_version, or "" when it does
// not. Pure over the diff text so the parse is testable.
export fun raised(diff: str) > str {
    foreach (line in diff.split("\n")) {
        if (!line.startsWith("+required_version:")) { continue; }
        final value = line.sub("+required_version:".len()).trim();
        // One call per quote style. This used to be written twice per style, with a note
        // saying "Buzz's replace swaps only the FIRST match" - which was true of
        // gopherbuzz until 2026-08-09 and was never true of upstream Buzz, whose replace
        // substitutes throughout. The doubled call was a workaround for that bug; it is
        // the fingerprint to look for if you meet another one.
        return value.replace("\"", with: "").replace("'", with: "");
    }
    return "";
}

fun body(floor: str) > str {
    return "**This pull request raises the magus version floor to `" + floor + "`.**\n\n"
        + "magus checks `required_version` before it evaluates the magusfile, so once "
        + "this merges an older magus cannot load this workspace at all - not just the "
        + "changed targets, every command. Upgrade first:\n\n"
        + "```sh\nmagus self update\n```\n";
}

fun main() > void !> any {
    final pulled = advice\pullRequest();
    if (pulled.error -> err) { throw err.message; }
    final pull = pulled.value!;
    final repo = pull.repo;
    final pr = pull.number;
    final base = pull.base;
    final head = pull.headSha;
    if (pr == "" and base == "" and head == "") {
        std\print("version-floor: no PR context; nothing to advise");
        return;
    }
    if (pr == "" or base == "" or head == "") {
        throw "version-floor: the pull request's number, base and head sha must be set together";
    }

    final silenced = advice\silenced(repo, pr: pr, name: section);
    if (silenced.error -> err) { throw err.message; }
    if (silenced.value!) {
        // Retract rather than leave the last finding frozen on the page.
        final retracted = advice\publish(repo, pr: pr, name: section, title: "", body: "");
        if (retracted.error -> err) { throw err.message; }
        std\print("version-floor: silenced by label");
        return;
    }

    final fetched = advice\fetchBase(base, refspec: false);
    if (fetched.error -> err) { throw err.message; }
    final range = advice\diffRange(base, head: head);
    if (range.error -> err) { throw err.message; }
    final diff = vcs\cmd(["diff", range.value!, "--", "magus.yaml"],
        opts: vcs\CommandOptions{ dir = ".", quiet = true, allowFailure = true }).stdout;
    final floor = raised(diff);
    if (floor == "") {
        // Retract: a floor raise that was reverted must not leave the note behind.
        final none = advice\publish(repo, pr: pr, name: section, title: "The magus version floor moved", body: "");
        if (none.error -> err) { throw err.message; }
        std\print("version-floor: unchanged");
        return;
    }
    final posted = advice\publish(repo, pr: pr, name: section, title: "The magus version floor moved", body: body(floor));
    if (posted.error -> err) { throw err.message; }
    std\print("version-floor: advised on " + floor);
}


test "raised reads a newly set floor" {
    std\assert(raised("+required_version: \">= 0.4.0\"\n") == ">= 0.4.0", message: "unquoted value");
}

test "raised ignores an unrelated magus.yaml change" {
    std\assert(raised("+concurrency: 4\n-required_version: \">= 0.3.0\"\n") == "", message: "only additions of the key");
}

// Both quotes stripped, not just the opening one. Written as a repetition fixture on
// purpose: the single-occurrence version of this test passed for as long as replace
// substituted only the first match, because the doubled call above hid it.
test "raised strips quotes from BOTH ends of the value" {
    std\assert(raised("+required_version: \">= 0.4.0\"\n") == ">= 0.4.0", message: "double quotes both ends");
    std\assert(raised("+required_version: '>= 0.4.0'\n") == ">= 0.4.0", message: "single quotes both ends");
}
