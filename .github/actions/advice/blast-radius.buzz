// Show how far a pull request reaches: every project that rebuilds, and WHY each one is
// in the set.
//
// The tone is the hard part, and it is deliberate. A large reach is a property of how the
// workspace is wired, not a fact about the person's change - one edited file can pull in
// a dozen projects because they sit downstream of it, which is a decision someone else
// made long ago. A comment that reads "your change is too big" blames the author for the
// graph's shape, and people stop reading a bot that scolds them.
//
// So: state what rebuilds, name the chain that pulled each one in, and stop. The reviewer
// gets the same information as the author. Splitting is mentioned only where it would
// actually help, and NOT where the coupling is upstream of the diff - telling someone to
// split a change whose fan-out is structural is advice that cannot be followed.
//
// The chain per project is the ANSWER - a reader here is asking "why is docs in my
// build", and `magus affected --explain` answers exactly that. The diagram follows it,
// folded away, for the reader who wants to see the shape rather than read the rows.
// GitHub renders mermaid in a comment, so it costs nothing to include and nothing to
// look at until someone opens it.
//
// Reads REPO, PR_NUMBER, PR_BASE, PR_HEAD_SHA, FANOUT_SHARE.
import "os";
import "advice";
import "magus";
import "std";

final section = "blast-radius";

fun changed(base: str, head: str) > [str] {
    os\exec("git", args: ["fetch", "--no-tags", "origin", base], dir: ".", opts: {});
    final res = os\exec("git", args: ["diff", "--name-only", "origin/" + base + "..." + head],
        dir: ".", opts: {"allow_failure": true});
    var paths = mut [];
    foreach (line in res.stdout.split("\n")) {
        if (line != "") { paths.append(line); }
    }
    return paths;
}

// trips reports whether `reached` of `total` projects is enough to be worth saying. Pure,
// so the rule is testable and reviewable in one place.
export fun trips(reached: int, total: int, share: float) > bool {
    if (reached < 2) { return false; }
    if (total <= 0) { return false; }
    // Multiplied, not divided: reached / total is INTEGER division here, so 5 of 10
    // came out 0 and the threshold never tripped.
    return reached >= total * share;
}

// chain pulls the dependency path out of `magus affected --explain <project>` output,
// whose shape is "  via a -> b:" followed by the files. Empty when the project was
// edited directly, which is its own answer.
export fun chain(explain: str) > str {
    foreach (line in explain.split("\n")) {
        final trimmed = line.trim();
        if (!trimmed.startsWith("via ")) { continue; }
        final rest = trimmed.sub("via ".len());
        final colon = rest.indexOf(":");
        if (colon == null) { return rest.trim(); }
        return rest.sub(0, colon).trim();
    }
    return "";
}

// hub returns the project that most of the reach passes through, or "" when no single one
// dominates. It is the most useful sentence in the comment: naming one edge explains a
// dozen rows at once.
export fun hub(chains: [str]) > str {
    var best = "";
    var bestCount = 0;
    foreach (c in chains) {
        if (c == "") { continue; }
        final head = c.split(" ")[0];
        var count = 0;
        foreach (other in chains) {
            if (other.startsWith(head)) { count = count + 1; }
        }
        if (count > bestCount) { best = head; bestCount = count; }
    }
    if (bestCount < 2) { return ""; }
    return best;
}

fun body(projects: [str], chains: [str], total: int, share: float, diagram: str) > str {
    var text = "**This change reaches " + "{projects.len()}" + " of " + "{total}"
        + " projects.**\n\n"
        + "The reach comes from how this workspace is wired: a project is here because "
        + "it sits downstream of one you edited. All " + "{projects.len()}" + " of them "
        + "rebuild and retest.\n\n"
        + "| project | why it is in the set |\n| --- | --- |\n";
    for (var i = 0; i < projects.len(); i = i + 1) {
        var why = "edited directly";
        if (chains[i] != "") { why = "via `" + chains[i] + "`"; }
        text = text + "| `" + projects[i] + "` | " + why + " |\n";
    }
    final through = hub(chains);
    if (through != "") {
        text = text + "\nMost of that reach passes through `" + through + "`.\n";
    }
    // Only where splitting could actually help. Past a very high share the coupling is
    // upstream of the diff, and splitting just makes two changes that each rebuild
    // everything.
    if (projects.len() < total) {
        text = text + "\nIf this is more than the change needs to touch, splitting it "
            + "makes each piece cheaper to review and to revert.\n";
    } else {
        text = text + "\nEverything is downstream of what you edited, so splitting the "
            + "change would not shrink any piece - the coupling is upstream of this diff.\n";
    }
    // No nested <details>: the whole section is already folded away, so a second fold
    // just makes the diagram two clicks deep.
    if (diagram != "") {
        text = text + "\n```mermaid\n" + diagram.trim() + "\n```\n";
    }
    return text
        + "\nIf that matches what you expected, there is nothing to do here. If it "
        + "surprises you, look at the dependency graph before this pull request: "
        + "`magus affected --explain <project>` lists the files that pulled one in, and "
        + "`magus path <a> <b>` shows how any two connect.\n";
}

fun main() > void {
    final repo = advice\env("REPO");
    final pr = advice\env("PR_NUMBER");
    final base = advice\env("PR_BASE");
    final head = advice\env("PR_HEAD_SHA");
    if (pr == "" and base == "" and head == "") {
        std\print("blast-radius: no PR context; nothing to advise");
        return;
    }
    if (pr == "" or base == "" or head == "") {
        throw "blast-radius: PR_NUMBER, PR_BASE, and PR_HEAD_SHA must be set together";
    }
    var share = 0.5;
    final configured = advice\env("FANOUT_SHARE");
    if (configured != "") { share = std\parseFloat(configured) ?? 0.5; }

    // The projects this PR reaches, from the workspace's own affected calculation rather
    // than from the paths: affected walks dependents, which is the whole point.
    final res = magus\cmd("affected", args: ["--base", "origin/" + base, "-o", "name"],
        opts: {"quiet": true, "allow_failure": true});
    var reached = mut [];
    foreach (line in res.stdout.split("\n")) {
        if (line != "") { reached.append(line); }
    }

    var total = 0;
    foreach (p in magus\targetGraph().projects) { total = total + 1; }
    if (!trips(reached.len(), total: total, share: share)) {
        advice\publish(repo, pr: pr, name: section, title: "How far this change reaches", body: "");
        std\print("blast-radius: {reached.len()} of {total} projects; below the threshold");
        return;
    }

    var chains = mut [];
    foreach (p in reached) {
        final explained = magus\cmd("affected", args: ["--explain", p, "--base", "origin/" + base],
            opts: {"quiet": true, "allow_failure": true});
        chains.append(chain(explained.stdout));
    }

    // Only the reached projects, so the picture is this change's reach and not the whole
    // workspace - the workspace-wide graph is already rendered in MAGUS.md.
    var argv = mut ["deps"];
    foreach (p in reached) { argv.append(p); }
    argv.append("-o");
    argv.append("mermaid");
    final drawn = magus\cmd("graph", args: argv, opts: {"quiet": true, "allow_failure": true});
    var diagram = "";
    if (drawn.ok) { diagram = drawn.stdout; }

    advice\publish(repo, pr: pr, name: section,
        title: "How far this change reaches ({reached.len()} of {total} projects)",
        body: body(reached, chains: chains, total: total, share: share, diagram: diagram));
    std\print("blast-radius: advised on {reached.len()} of {total}");
}

main();

test "trips fires when the reach is at or over the share" {
    std\assert(trips(5, total: 10, share: 0.5), message: "half the workspace");
    std\assert(trips(9, total: 10, share: 0.5), message: "most of it");
}

test "trips stays quiet for a small reach" {
    std\assert(!trips(1, total: 10, share: 0.5), message: "one project is never worth saying");
    std\assert(!trips(3, total: 10, share: 0.5), message: "under the share");
}

test "trips needs at least two projects however small the workspace" {
    std\assert(!trips(1, total: 1, share: 0.5), message: "a single-project workspace always reaches everything");
}

test "chain reads the dependency path out of an explain block" {
    std\assert(chain("docs\n  via . -> docs:\n    magusfile.buzz\n") == ". -> docs", message: "the chain");
}

test "chain is empty for a project that was edited directly" {
    std\assert(chain("docs\n    docs/index.md\n") == "", message: "no via line");
}

test "hub names the project most of the reach passes through" {
    std\assert(hub([". -> docs", ". -> console", "libs/x -> y"]) == ".", message: "the dominant edge");
}

test "hub stays quiet when nothing dominates" {
    std\assert(hub(["a -> b"]) == "", message: "one chain is not a pattern");
    std\assert(hub([]) == "", message: "nothing at all");
}
