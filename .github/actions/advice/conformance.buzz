// Comment when a pull request adds a target whose NAME diverges from what the rest of
// the workspace already calls that same work.
//
// The norm is derived from the tree, never declared. Nobody writes down "a target
// running jest shall be called test"; the graph observes that 47 of 48 already are, and
// the 48th is the finding. That is what makes the advice persuasive - it is not one
// team's opinion, it is what everyone else already agreed on by doing it - and it is why
// this cannot be a linter, which needs a human to write the rule first. In a monorepo
// where nobody owns DevX, that human is exactly who does not exist.
//
// SILENCE IS THE DEFAULT AND THE HARD PART. A workspace with no convention must produce
// nothing. Two gates enforce that, and both must pass:
//
//   - the cohort must be big enough to establish a convention at all (MIN_COHORT). Two
//     targets agreeing is a coincidence.
//   - the majority must be overwhelming (MIN_SHARE). A 30/28 split is not a violation,
//     it is a workspace that has not decided, and reporting it as one burns the tool's
//     credibility on the first run.
//
// Measured against this repo (2026-08) both gates hold it silent, correctly: the largest
// cohort here is 7 targets sharing `go:go-build` under 6 different names, because
// `watch`, `release-build` and `buzz-build` genuinely ARE different jobs that
// happen to invoke the same op. An exact-op-set rule with a naive threshold would have
// made that its first finding, and been wrong 7 times.
//
// It fires only on targets the pull request ADDS. Reporting every pre-existing
// inconsistency would produce a backlog nobody burns down, and shipping one as the first
// output guarantees the feature is ignored. The valuable moment is the pull request that
// adds project 49 with a target named `unit-test`, before it becomes the 49th thing to
// migrate later. keepAdded records the measurement behind that gate.
//
// It never renames anything. Renaming a target breaks every caller, CI config, and
// script outside the workspace, so this advises and stops.
//
// The symbol half says the same thing about code: a name the change adds that differs from
// what the rest of the workspace calls the same shape of declaration. magus\diff computes it
// from the symbol index (one pass over every declaration, too large for a script) and hands
// each changed symbol its findings; this renders the headlines, one table per check.
//
// Reads REPO, PR_NUMBER, PR_BASE, PR_HEAD_SHA, MIN_COHORT, MIN_SHARE, BASELINE.
import "proc";
import "advice";
import "magus";
import "std";

final section = "conformance";

// signature is a target's tooling fingerprint: its spell ops, sorted and joined. Two
// targets with the same signature do the same work as far as magus can see.
//
// Exact set equality, deliberately. Loosening the key to the SPELL was measured on this
// workspace and is strictly worse: it collapses every Go target into one bucket of 17
// with an 18% majority, which is no signal at all. The op set is the loosest key that
// still means anything.
//
// A target invoking no op has no signature and never participates - it is not comparable
// to anything. That covers most of a workspace (74% here), which bounds how much this
// can ever see; the graph learns what a target runs from the spell ops it composes, and
// a target that shells out contributes nothing to compare.
export fun signature(ops: [str]) > str {
    if (ops.len() == 0) { return ""; }
    // Copied before sorting: sort mutates in place, so sorting the argument directly
    // would reorder the caller's list and reject an immutable one outright.
    final copy = mut [<str>];
    foreach (op in ops) { copy.append(op); }
    final ordered = copy.sort(fun (a: str, b: str) > bool { return a < b; });
    return ordered.join(",");
}

// majority returns the most common name in names, and how many carry it. Ties break on
// the lexically smaller name so the answer never depends on graph iteration order.
export fun majority(names: [str]) > {str: any} {
    var best = "";
    var bestCount = 0;
    foreach (candidate in names) {
        var n = 0;
        foreach (other in names) {
            if (other == candidate) { n = n + 1; }
        }
        if (n > bestCount or (n == bestCount and best != "" and candidate < best)) {
            best = candidate;
            bestCount = n;
        }
    }
    return {"name": best, "count": bestCount};
}

// findings returns one entry per target whose name diverges from a confident majority.
// members is [{"project", "name", "sig"}]; each finding carries the evidence that
// justifies it, because a claim about what "everyone else" does has to show its work.
//
// minCohort and minShare are the two silence gates. A cohort below either produces
// NOTHING - not a weaker finding.
export fun findings(members: [{str: str}], minCohort: int, minShare: double) > [{str: str}] {
    var seen = mut [];
    var found = mut [];
    foreach (m in members) {
        final sig = m["sig"] ?? "";
        if (sig == "") { continue; }
        var already = false;
        foreach (s in seen) {
            if (s == sig) { already = true; }
        }
        if (already) { continue; }
        seen.append(sig);

        var names = mut [];
        var cohort = mut [];
        foreach (other in members) {
            if ((other["sig"] ?? "") == sig) {
                names.append(other["name"] ?? "");
                cohort.append(other);
            }
        }
        // Too small to establish a convention: two targets agreeing is a coincidence.
        if (cohort.len() < minCohort) { continue; }

        final maj = majority(names);
        final majName = maj["name"] ?? "";
        final majCount = maj["count"] ?? 0;
        // Multiplied, not divided: majCount / cohort.len() is INTEGER division and would
        // floor every ratio to 0, so the gate would never hold anything back.
        if (majCount < cohort.len() * minShare) { continue; }

        foreach (member in cohort) {
            final name = member["name"] ?? "";
            if (name == majName) { continue; }
            found.append({
                "project": member["project"] ?? "",
                "name": name,
                "majority": majName,
                "evidence": "{majCount} of {cohort.len()}",
                "ops": sig,
            });
        }
    }
    return found;
}

// keepAdded keeps the findings this pull request introduced and drops the rest.
//
// Gating on the PROJECT a pull request touched is too coarse to carry a finding. This
// workspace's root project owns cmd/, internal/, types/ and the module root, so nearly
// every pull request seeds it, and one pre-existing divergent target then reports on all
// of them. This section carried `compress-cgo-test` through pull requests 120 to 125,
// none of which touched its sources, under a heading reading "This adds a target". The
// target had sat on main for weeks under a comment explaining that its name diverges on
// purpose, so the magusfile answered the advice before anyone read it.
//
// The heading is the contract, so the gate is the name being NEW. `added` runs the pair
// of checks target-outputs runs for that same word: the diff proposes a name and the base
// tree settles it. Sharing those checks is why they live in advice.
//
// The project still has to be one the diff seeded, because a diff yields NAMES and a name
// is not unique across a workspace. Eight projects here declare `preflight`, so adding a
// ninth would otherwise report the eight already standing, which is the mistake
// target-outputs made once with that exact name.
export fun keepAdded(all: [{str: str}], added: [str], seeded: [str]) > [{str: str}] {
    var kept = mut [];
    foreach (f in all) {
        var inSeed = false;
        foreach (p in seeded) {
            if ((f["project"] ?? "") == p) { inSeed = true; }
        }
        if (!inSeed) { continue; }
        foreach (name in added) {
            if ((f["name"] ?? "") == name) { kept.append(f); }
        }
    }
    return kept;
}

fun targetTable(items: [{str: str}]) > str {
    final parts = mut ["**This adds a target whose name differs from what the rest of the "
        + "workspace calls the same work.**\n\n"
        + "| target | runs | the rest of the workspace calls this |\n| --- | --- | --- |\n"];
    foreach (f in items) {
        parts.append("| `" + (f["name"] ?? "") + "` in `" + (f["project"] ?? "") + "` | `"
            + (f["ops"] ?? "") + "` | `" + (f["majority"] ?? "") + "` ("
            + (f["evidence"] ?? "") + ") |\n");
    }
    return parts.join("") + "\n";
}

// namingChecks is one table per naming check, in the order the body renders them. A check
// magus\diff adds later reaches the comment through a row here.
final namingChecks = [
    {"check": "affix", "heading": "This adds a name that misses the word pattern most declarations of its shape share"},
    {"check": "binding", "heading": "This adds a name the workspace already uses for something else"},
    {"check": "size", "heading": "This adds an interface far larger than those declared beside it"},
];

// namingRow flattens one finding to primitives, so the rendering is testable: a host object
// cannot be built inside a test block.
export fun namingRow(path: str, check: str, summary: str, members: int, cohort: int,
    examples: [str], outliers: [str]) > {str: str} {
    var evidence = "{members} of {cohort}";
    if (examples.len() > 0) { evidence = evidence + ": " + examples.join(", "); }
    if (outliers.len() > 0) { evidence = evidence + "; not: " + outliers.join(", "); }
    return {"path": path, "check": check, "summary": summary, "evidence": evidence};
}

// namingTables renders a table for each check with rows, and "" when none has any. A row whose
// check has no entry in namingChecks goes under a plain heading rather than disappearing.
export fun namingTables(rows: [{str: str}]) > str {
    final parts = mut [<str>];
    var known = mut [<str>];
    var checks = mut [<{str: str}>];
    foreach (c in namingChecks) {
        checks.append(c);
        known.append(c["check"] ?? "");
    }
    foreach (r in rows) {
        final check = r["check"] ?? "";
        var listed = false;
        foreach (k in known) {
            if (k == check) { listed = true; }
        }
        if (!listed) {
            known.append(check);
            checks.append({"check": check, "heading": "This adds a name magus reports under `" + check + "`"});
        }
    }
    foreach (c in checks) {
        var lines = mut [<str>];
        foreach (r in rows) {
            if ((r["check"] ?? "") != (c["check"] ?? "")) { continue; }
            lines.append("| `" + (r["path"] ?? "") + "` | " + cell(r["summary"] ?? "") + " | "
                + cell(r["evidence"] ?? "") + " |\n");
        }
        if (lines.len() == 0) { continue; }
        parts.append("**" + (c["heading"] ?? "") + ".**\n\n| file | finding | evidence |\n| --- | --- | --- |\n"
            + lines.join("") + "\n");
    }
    return parts.join("");
}

fun cell(text: str) > str { return text.replace("|", with: "\\|"); }

fun body(items: [{str: str}], rows: [{str: str}]) > str {
    var text = "";
    if (items.len() > 0) { text = targetTable(items); }
    return text + namingTables(rows)
        + "Nobody wrote these conventions down. magus derived them from the workspace: targets "
        + "grouped by the ops they invoke, declarations by their shape. Each count above is "
        + "what the rest of the code already does, not a rule imposed on you.\n\n"
        + "Renaming now is cheap. Later it means changing every caller, and for a target every "
        + "CI config and script that names it, across teams that each have to be persuaded "
        + "separately.\n\n"
        + "If you diverged on purpose, because this really is a different thing that happens to "
        + "look the same, then this finding is wrong and worth ignoring. "
        + "Add the `magus:silence:" + section + "` label to keep it quiet.\n";
}

fun main() > void !> any {
    final repo = advice\env("REPO");
    final pr = advice\env("PR_NUMBER");
    final base = advice\env("PR_BASE");
    final head = advice\env("PR_HEAD_SHA");
    if (pr == "" and base == "" and head == "") {
        std\print("conformance: no PR context; nothing to advise");
        return;
    }
    if (pr == "" or base == "" or head == "") {
        throw "conformance: PR_NUMBER, PR_BASE, and PR_HEAD_SHA must be set together";
    }
    if (advice\silenced(repo, pr: pr, name: section)) {
        // Retract rather than leave the last finding frozen on the page.
        advice\publish(repo, pr: pr, name: section, title: "", body: "");
        std\print("conformance: silenced by label");
        return;
    }

    var minCohort = 5;
    final configuredCohort = advice\env("MIN_COHORT");
    if (configuredCohort != "") { minCohort = std\parseInt(configuredCohort) ?? 5; }
    var minShare = 0.8;
    final configuredShare = advice\env("MIN_SHARE");
    if (configuredShare != "") { minShare = std\parseDouble(configuredShare) ?? 0.8; }

    var members = mut [];
    foreach (p in magus\targets().projects) {
        foreach (n in p.nodes) {
            var ops = mut [];
            foreach (use in n.spells) {
                foreach (op in use.ops) { ops.append(use.spell + ":" + op); }
            }
            members.append({"project": p.path, "name": n.name, "sig": signature(ops)});
        }
    }

    // Only the targets this pull request adds. The magusfile is the declaration, so the
    // diff proposes the names and the base tree rejects the ones already there.
    advice\fetchBase(base, refspec: false);
    final diff = proc\exec("git", args: ["diff", "-U0", advice\diffRange(base, head: head), "--", "*.buzz"],
        dir: ".", opts: {"quiet": true, "allow_failure": true}).stdout;
    var added = mut [<str>];
    foreach (n in advice\addedTargets(diff)) {
        if (advice\declaredAtBase(n, base: base)) { continue; }
        added.append(magus\canonicalName(n));
    }

    var seeded = mut [<str>];
    foreach (p in magus\affectedImpact("origin/" + base).affectedProjects) {
        if (p.seed) { seeded.append(p.path); }
    }

    final items = keepAdded(findings(members, minCohort: minCohort, minShare: minShare),
        added: added, seeded: seeded);

    // The same changeset api-surface reads: the range on the forge, the working tree locally.
    var opts = mut {<str: any>};
    final baseline = advice\env("BASELINE");
    if (baseline != "") { opts["baseline"] = baseline; }
    if (!advice\collecting()) { opts["rev"] = "origin/" + base + "..." + head; }
    final review = magus\diff(opts);
    var rows = mut [<{str: str}>];
    foreach (f in review.files) {
        foreach (sym in f.symbols) {
            foreach (n in sym.naming) {
                if (!n.headline) { continue; }
                rows.append(namingRow(f.path, check: n.check, summary: n.summary,
                    members: n.members, cohort: n.cohort, examples: n.examples, outliers: n.outliers));
            }
        }
    }

    final count = items.len() + rows.len();
    if (count == 0) {
        // An empty body retracts the section, so a name fixed on the next push stops being reported.
        advice\publish(repo, pr: pr, name: section, title: "A name diverges from the workspace", body: "");
        std\print("conformance: nothing to say ({members.len()} targets, {added.len()} added by this change)");
        return;
    }
    advice\publish(repo, pr: pr, name: section,
        title: "A name diverges from the workspace ({count})",
        body: body(items, rows: rows));
    std\print("conformance: advised on {items.len()} target(s) and {rows.len()} symbol name(s)");
}


test "signature is order-independent so two targets match however they were written" {
    std\assert(signature(["go:go-test", "go:go-vet"]) == signature(["go:go-vet", "go:go-test"]),
        message: "the op SET is the key, not the call order");
}

test "a target invoking no op has no signature and never participates" {
    std\assert(signature([]) == "", message: "nothing to compare");
}

test "findings names the outlier in an overwhelming cohort" {
    var members = mut [];
    foreach (p in ["a", "b", "c", "d", "e", "f"]) {
        members.append({"project": p, "name": "test", "sig": "node:jest"});
    }
    members.append({"project": "checkout", "name": "unit-test", "sig": "node:jest"});
    final got = findings(members, minCohort: 5, minShare: 0.8);
    std\assert(got.len() == 1, message: "one outlier, not seven findings");
    std\assert(got[0]["name"] == "unit-test", message: "the divergent one");
    std\assert(got[0]["majority"] == "test", message: "what everyone else calls it");
    std\assert(got[0]["evidence"] == "6 of 7", message: "shows its work");
}

test "findings says NOTHING when the workspace has not decided" {
    // 4/7 is a plurality, not a convention. This is the case that would destroy the
    // tool's credibility, so it is the one most worth pinning.
    var members = mut [];
    foreach (p in ["a", "b", "c", "d"]) {
        members.append({"project": p, "name": "test", "sig": "node:jest"});
    }
    foreach (p in ["e", "f", "g"]) {
        members.append({"project": p, "name": "unit-test", "sig": "node:jest"});
    }
    std\assert(findings(members, minCohort: 5, minShare: 0.8).len() == 0,
        message: "a split workspace has no convention to enforce");
}

test "findings says nothing when the cohort is too small to mean anything" {
    final members = [
        {"project": "a", "name": "test", "sig": "node:jest"},
        {"project": "b", "name": "test", "sig": "node:jest"},
        {"project": "c", "name": "unit-test", "sig": "node:jest"},
    ];
    std\assert(findings(members, minCohort: 5, minShare: 0.8).len() == 0,
        message: "two targets agreeing is a coincidence, not a norm");
}

test "findings ignores targets that invoke no op" {
    var members = mut [];
    foreach (p in ["a", "b", "c", "d", "e", "f"]) {
        members.append({"project": p, "name": "build", "sig": ""});
    }
    members.append({"project": "odd", "name": "compile", "sig": ""});
    std\assert(findings(members, minCohort: 5, minShare: 0.8).len() == 0,
        message: "no signature, nothing to compare");
}

test "keepAdded drops an outlier the pull request did not add" {
    final all = [
        {"project": "checkout", "name": "unit-test", "majority": "test", "evidence": "6 of 7", "ops": "node:jest"},
        {"project": "legacy", "name": "run-tests", "majority": "test", "evidence": "6 of 7", "ops": "node:jest"},
    ];
    final kept = keepAdded(all, added: ["unit-test"], seeded: ["checkout", "legacy"]);
    std\assert(kept.len() == 1, message: "only what this change added");
    std\assert(kept[0]["name"] == "unit-test", message: "the new one");
}

test "keepAdded says nothing when the pull request adds no target" {
    // The regression: editing one Go file seeds the root project, which was enough to
    // report every outlier that project already owned.
    final all = [
        {"project": ".", "name": "compress-cgo-test", "majority": "test", "evidence": "4 of 5", "ops": "go:go-test"},
    ];
    std\assert(keepAdded(all, added: [], seeded: ["."]).len() == 0,
        message: "a change that adds nothing says nothing");
}

test "keepAdded does not blame another project for a name it already had" {
    final all = [
        {"project": "apps/new", "name": "preflight", "majority": "check", "evidence": "7 of 8", "ops": "node:jest"},
        {"project": "apps/old", "name": "preflight", "majority": "check", "evidence": "7 of 8", "ops": "node:jest"},
    ];
    final kept = keepAdded(all, added: ["preflight"], seeded: ["apps/new"]);
    std\assert(kept.len() == 1, message: "a diff yields names, so the seed decides whose it is");
    std\assert(kept[0]["project"] == "apps/new", message: "the project that gained it");
}

test "body shows the evidence and names the escape hatch" {
    final text = body([{"project": "apps/checkout", "name": "unit-test",
        "majority": "test", "evidence": "47 of 48", "ops": "node:jest"}], rows: []);
    std\assert(text.indexOf("47 of 48") != null, message: "the count is the argument");
    std\assert(text.indexOf("`unit-test` in `apps/checkout`") != null, message: "names the target");
    std\assert(text.indexOf("`magus:silence:conformance` label") != null,
        message: "declining must be easy and permanent, and the label is how");
    std\assert(text.indexOf("| file | finding |") == null, message: "no symbol finding, no symbol table");
}

test "a naming finding carries its counts, its members, and the ones that differ" {
    final row = namingRow("internal/trail/trail.go", check: "affix",
        summary: "`EntryPointFrom`: 41 of 43 functions of its shape that say From or Context are named `<X>FromContext`",
        members: 41, cohort: 43, examples: ["BaseFromContext", "CwdFromContext"], outliers: ["RecorderFrom", "StepReplFrom"]);
    std\assert(row["evidence"] == "41 of 43: BaseFromContext, CwdFromContext; not: RecorderFrom, StepReplFrom",
        message: "the family, its members and its outliers");

    final text = body([], rows: [row]);
    std\assert(text.indexOf("misses the word pattern") != null, message: "the affix table's heading");
    std\assert(text.indexOf("| `internal/trail/trail.go` | `EntryPointFrom`: 41 of 43") != null, message: "one row");
    std\assert(text.indexOf("This adds a target") == null, message: "no target finding, no target table");
}

test "each check gets its own table, and an unknown check still renders" {
    final text = namingTables([
        namingRow("types/vcs.go", check: "size", summary: "`Stager` has 13 methods",
            members: 23, cohort: 28, examples: [], outliers: []),
        namingRow("sink.go", check: "binding", summary: "`Format` is already the name of target `.:format`",
            members: 1, cohort: 1, examples: [], outliers: []),
        namingRow("a.go", check: "future", summary: "a | b", members: 5, cohort: 6, examples: [], outliers: []),
    ]);
    std\assert(text.indexOf("already uses for something else") != null, message: "binding table");
    std\assert(text.indexOf("far larger than those declared beside it") != null, message: "size table");
    std\assert(text.indexOf("magus reports under `future`") != null, message: "a newer check is never dropped");
    std\assert(text.indexOf("a \\| b") != null, message: "a pipe cannot split the table");
    std\assert(text.indexOf("already uses") < text.indexOf("far larger"), message: "namingChecks order");
}

test "no findings render nothing, which is what retracts a fixed name" {
    std\assert(namingTables([]) == "", message: "an empty body retracts the section");
}
