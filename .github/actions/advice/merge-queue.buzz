// Name the command that queues an approved pull request, while it could join the merge
// queue and has not: open, approved, targeting the queue's base, from this repository,
// with neither auto-merge nor a queue label on it. Retracted in every other state.
//
// A pull request queues by enabling auto-merge; the label is how a stack queues from its
// top. The label's prefix and the merge methods come from `magus queue describe`, so the
// advice names what the provider accepts rather than what this file assumes.
//
// Reads the `merge-queue-provider` and `merge-queue-base` inputs.
import "proc";
import "advice";
import "magus";
import "serialize";
import "std";

final section = "merge-queue";

// queueable reports whether a pull request in this state could join the queue and has
// not. An empty prefix means the provider queues nothing by label.
export fun queueable(state: str, review: str, base: str, queueBase: str, labels: [str], fork: bool,
    autoMerge: bool, prefix: str) > bool {
    if (state != "OPEN" or review != "APPROVED" or base != queueBase or fork or autoMerge) {
        return false;
    }
    foreach (label in labels) {
        if (prefix != "" and label.startsWith(prefix)) { return false; }
    }
    return true;
}

// suggestion is the advice: one `gh pr merge --auto` per method the repository allows,
// and the label only as how a stack queues from its top.
export fun suggestion(base: str, pr: str, prefix: str, methods: [str]) > str {
    final commands = mut [<str>];
    foreach (m in methods) { commands.append("`gh pr merge " + pr + " --auto --" + m + "`"); }
    var choice = commands.join(", ");
    if (commands.len() > 1) {
        choice = commands.sub(0, len: commands.len() - 1).join(", ") + " or " + commands[commands.len() - 1];
    }
    var body = "This pull request is approved and targets `" + base + "`, so it can join the merge queue: "
        + choice + " queues it with that merge method.";
    if (prefix != "") {
        body = body + " A stack queues from its top pull request instead, with the label `" + prefix + "<method>`.";
    }
    return body + "\n";
}

fun main() > void !> any {
    if (advice\collecting()) { return; }
    final pull = advice\pullRequest();
    final repo = pull.repo;
    final pr = pull.number;
    final provider = advice\input("merge-queue-provider");
    final queueBase = advice\input("merge-queue-base");
    if (repo == "" or pr == "" or provider == "" or queueBase == "") {
        std\print("merge-queue: no pull request or queue to advise on");
        return;
    }
    if (advice\silenced(repo, pr: pr, name: section)) {
        advice\publish(repo, pr: pr, name: section, title: "", body: "");
        std\print("merge-queue: silenced by label");
        return;
    }
    final viewed = proc\exec("gh", args: ["pr", "view", pr, "--repo", repo, "--json",
        "state,reviewDecision,baseRefName,labels,isCrossRepository,autoMergeRequest"],
        dir: ".", opts: {"quiet": true, "allow_failure": true});
    final described = magus\cmd("queue", args: ["describe", "-o", "json", "--status-context", "", "--provider", provider, "--base", queueBase],
        opts: {"quiet": true, "allow_failure": true});
    if (!viewed.ok or !described.ok) {
        // Unknown is not queueable: retract rather than leave an answer nobody checked.
        advice\publish(repo, pr: pr, name: section, title: "", body: "");
        std\print("merge-queue: could not read the pull request or the provider");
        return;
    }
    final p = serialize\jsonDecode(viewed.stdout);
    final caps = serialize\jsonDecode(described.stdout);
    final labels = mut [<str>];
    foreach (l in p.q("labels").listValue()) { labels.append(l.q("name").stringValue()); }
    final prefix = caps.q("queue_label").stringValue();
    var body = "";
    if (queueable(p.q("state").stringValue(), review: p.q("reviewDecision").stringValue(),
        base: p.q("baseRefName").stringValue(), queueBase: queueBase, labels: labels,
        fork: p.q("isCrossRepository").booleanValue(), autoMerge: p.q("autoMergeRequest").map() != null,
        prefix: prefix)) {
        final methods = mut [<str>];
        foreach (m in caps.q("methods").listValue()) { methods.append(m.stringValue()); }
        body = suggestion(queueBase, pr: pr, prefix: prefix, methods: methods);
    }
    advice\publish(repo, pr: pr, name: section, title: "Ready for the merge queue", body: body);
    std\print("merge-queue: advised {body != ""}");
}

test "an approved pull request on the queue's base with no intent is queueable" {
    std\assert(queueable("OPEN", review: "APPROVED", base: "main", queueBase: "main", labels: ["bug"], fork: false,
        autoMerge: false, prefix: "queue: "), message: "shown");
}

test "every other state retracts" {
    std\assert(!queueable("OPEN", review: "APPROVED", base: "main", queueBase: "main", labels: ["queue: squash"],
        fork: false, autoMerge: false, prefix: "queue: "), message: "already labeled");
    std\assert(!queueable("MERGED", review: "APPROVED", base: "main", queueBase: "main", labels: [<str>],
        fork: false, autoMerge: false, prefix: "queue: "), message: "merged");
    std\assert(!queueable("CLOSED", review: "APPROVED", base: "main", queueBase: "main", labels: [<str>],
        fork: false, autoMerge: false, prefix: "queue: "), message: "closed");
    std\assert(!queueable("OPEN", review: "REVIEW_REQUIRED", base: "main", queueBase: "main", labels: [<str>],
        fork: false, autoMerge: false, prefix: "queue: "), message: "not approved");
    std\assert(!queueable("OPEN", review: "APPROVED", base: "feature", queueBase: "main", labels: [<str>],
        fork: false, autoMerge: false, prefix: "queue: "), message: "another base");
    std\assert(!queueable("OPEN", review: "APPROVED", base: "main", queueBase: "main", labels: [<str>],
        fork: true, autoMerge: false, prefix: "queue: "), message: "a fork");
    std\assert(!queueable("OPEN", review: "APPROVED", base: "main", queueBase: "main", labels: [<str>],
        fork: false, autoMerge: true, prefix: "queue: "), message: "auto-merge is already intent");
}

test "a provider that queues nothing by label still queues by auto-merge" {
    std\assert(queueable("OPEN", review: "APPROVED", base: "main", queueBase: "main", labels: ["queue: squash"],
        fork: false, autoMerge: false, prefix: ""), message: "no label is intent");
}

test "the advice names gh pr merge --auto for each allowed method, and the label only for a stack" {
    std\assert(suggestion("main", pr: "42", prefix: "merge: ", methods: ["merge", "squash", "rebase"]) ==
        "This pull request is approved and targets `main`, so it can join the merge queue: "
        + "`gh pr merge 42 --auto --merge`, `gh pr merge 42 --auto --squash` or `gh pr merge 42 --auto --rebase` queues it with that merge method. "
        + "A stack queues from its top pull request instead, with the label `merge: <method>`.\n", message: "all three, and the stack's label");
    std\assert(suggestion("main", pr: "7", prefix: "", methods: ["squash"]) ==
        "This pull request is approved and targets `main`, so it can join the merge queue: `gh pr merge 7 --auto --squash` queues it with that merge method.\n",
        message: "one method, and no label to name");
}
