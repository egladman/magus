// Comment when a pull request adds a target that declares no outputs.
//
// A target with no declared outputs can never replay: magus has nothing to snapshot, so
// every run re-runs it, and `magus clean` cannot remove what it produced. That is right
// for a gate (lint, a check that only passes or fails) and wrong for anything that
// writes a file, which is the mistake worth catching at review time rather than after
// the cache never hits.
//
// Only NEW targets, read from the diff: an existing target without outputs is a decision
// already made, and re-litigating it on every unrelated push is how a bot gets muted.
//
// Reads REPO, PR_NUMBER, PR_BASE, PR_HEAD_SHA.
import "proc";
import "advice";
import "magus";
import "std";

final section = "target-outputs";

fun body(targets: [str]) > str {
    final parts = mut ["**New targets that declare no outputs:**\n\n"];
    foreach (t in targets) { parts.append("- `" + t + "`\n"); }
    return parts.join("")
        + "\nA target with no declared outputs never replays from cache - magus has "
        + "nothing to snapshot, so it re-runs every time, and `magus clean` cannot "
        + "remove what it wrote. If it produces a file, declare it:\n\n"
        + "```buzz\nctx.writesFiles(\"gen/**\");\n```\n\n"
        + "If it only checks something and writes nothing, this is correct as written - "
        + "gates have no outputs. See [Cache model](https://eli.gladman.cc/magus/concepts/cache/).\n";
}

fun main() > void !> any {
    final repo = advice\env("REPO");
    final pr = advice\env("PR_NUMBER");
    final base = advice\env("PR_BASE");
    final head = advice\env("PR_HEAD_SHA");
    if (pr == "" and base == "" and head == "") {
        std\print("target-outputs: no PR context; nothing to advise");
        return;
    }
    if (pr == "" or base == "" or head == "") {
        throw "target-outputs: PR_NUMBER, PR_BASE, and PR_HEAD_SHA must be set together";
    }

    if (advice\silenced(repo, pr: pr, name: section)) {
        // Retract rather than leave the last finding frozen on the page.
        advice\publish(repo, pr: pr, name: section, title: "", body: "");
        std\print("target-outputs: silenced by label");
        return;
    }

    advice\fetchBase(base, refspec: false);
    final diff = proc\exec("git", args: ["diff", "-U0", advice\diffRange(base, head: head), "--", "*.buzz"],
        dir: ".", opts: {"quiet": true, "allow_failure": true}).stdout;
    final names = advice\addedTargets(diff);
    if (names.len() == 0) {
        advice\publish(repo, pr: pr, name: section, title: "New targets without declared outputs", body: "");
        return;
    }

    // The loaded graph decides, not the diff: a target's footprint can be declared
    // anywhere in its body, and only magus knows what it resolved to.
    //
    // QUALIFIED by project, because a target name is not unique across a workspace. Eight
    // projects here declare `preflight`, and matching on the bare name reported the same
    // name eight times for one edited magusfile - a list that told a reader nothing.
    var bare = mut [];
    foreach (project in magus\targets().projects) {
        foreach (t in project.nodes) {
            if (t.writesFiles.len() != 0) { continue; }
            foreach (n in names) {
                if (magus\canonicalName(n) != t.name) { continue; }
                if (!advice\declaredAtBase(n, base: base)) { bare.append(project.path + ":" + t.name); }
            }
        }
    }
    if (bare.len() == 0) {
        advice\publish(repo, pr: pr, name: section, title: "New targets without declared outputs", body: "");
        std\print("target-outputs: nothing to advise");
        return;
    }
    advice\publish(repo, pr: pr, name: section, title: "New targets without declared outputs ({bare.len()})", body: body(bare));
    std\print("target-outputs: advised on " + bare.join(", "));
}


