// Shared plumbing for the PR advisors: environment reads, and the one comment they all
// write into.
//
// ONE comment per pull request, not one per advisor. Each advisor owns a SECTION of it,
// delimited by its own begin/end markers, and replaces only that section - so a reader
// gets a single place to look and a single notification, while the advisors stay
// separate scripts with separate steps.
//
// A section is RETRACTED when its advisor has nothing to say. That is what makes the
// comment trustworthy across pushes: fix the conflicts and the conflict section
// disappears on the next run, rather than lingering as a stale scold.
import "os";
import "proc";
import "fs";
import "time";
import "serialize";
import "std";
// Used by the test blocks; advice_test runs this file.
import "assert";

// The comment marker identifies OUR comment among everyone else's. Never rendered.
final comment_marker = "<!-- magus:advice -->";

// The MODE: where a composed section goes. Unset means the pull request, which is what
// every CI step gets and what the rest of this file is about. "local" means the caller
// reads the sections off stdout instead - `magus diff` runs these same advisors against
// the local working diff, where there is no pull request to write into and no business
// reaching the forge at all.
//
// One environment variable rather than a flag per advisor, because an advisor is a script
// with no argv of its own: the composite action hands it everything through the
// environment, so a local driver has to speak the same way or the advisors would need two
// input paths.
//
// MAGUS_INTERNAL_ is what the prefix says: this pair is the handshake between `magus diff`
// and these scripts, not a knob to set by hand. Nothing supports it and nothing keeps it
// stable - the driver in cmd/magus/diff_advice.go holds the only other copy of both names,
// and the two move together in one commit.
final mode_env = "MAGUS_INTERNAL_ADVICE_MODE";
final mode_local = "local";

// The base to compare against in local mode, set by the driver. A BRANCH NAME rather than
// a rev, which is what the name insists on: the advisors compare against `origin/<base>`,
// the same thing PR_BASE means in CI, so local mode changes where the value comes from and
// not what it is.
final base_env = "MAGUS_INTERNAL_ADVICE_BASE_BRANCH";

// Stand-ins for the two pull-request facts a local run does not have. Both must be
// NON-EMPTY: every advisor guards on "PR_NUMBER, PR_BASE and PR_HEAD_SHA set together"
// and reads all three empty as "not a pull request, say nothing", which locally would
// silence the entire set rather than run it.
final local_pr = "local";
// HEAD, not the working tree, and the difference is real rather than pedantic: the
// advisors compare with `git diff <base>...<head>` and `git merge-tree <base> <head>`, and
// a rev is the only thing either form accepts. Uncommitted work is therefore outside what
// a local advisor sees. Closing that gap means changing the git forms in each advisor,
// which changes what they MEASURE - a separate decision from where their output goes.
final local_head = "HEAD";

// collecting reports whether this run writes to the caller instead of to the forge.
export fun collecting() > bool { return (os\env(mode_env) ?? "") == mode_local; }

// localFallback maps a pull-request variable to what a local run uses in its place. Pure
// over the base, so the local contract is pinned by a test rather than by an environment
// this file would have to mutate to observe.
export fun localFallback(name: str, base: str) > str {
    if (name == "PR_BASE") { return base; }
    if (name == "PR_NUMBER") { return local_pr; }
    if (name == "PR_HEAD_SHA") { return local_head; }
    return "";
}

// env reads a variable, returning "" rather than null so callers can compare directly.
//
// In local mode it also SUPPLIES the pull-request facts nobody set, so an advisor goes
// on reading its inputs through this one helper and grows no local branch of its own. A
// name that IS set always wins: a developer who exported PR_BASE meant it.
export fun env(name: str) > str {
    final set = os\env(name) ?? "";
    if (set != "" or !collecting()) { return set; }
    return localFallback(name, base: os\env(base_env) ?? "");
}

// fetchBase brings refs/remotes/origin/<base> up to date before an advisor compares
// against it, and is the single place that decides whether to reach the network at all.
//
// In local mode it fetches NOTHING. `magus diff` is a read-only report on a working tree:
// it runs on a laptop that may be offline, and under --watch it re-fires on every save, so
// a network round trip and a write to refs/remotes/ are both wrong there - a report is not
// allowed to change the repository it is reporting on. It reads whatever origin/<base> the
// clone already has, which may be days old. Saying so is the DRIVER's job, not an advisor's:
// the caveat is identical under every section, so `magus diff --impact` states the base and its
// age once for the whole set (preflightAdvisorBaseLine) rather than ten times.
//
// refspec selects the explicit "+refs/heads/<base>:refs/remotes/origin/<base>" form and
// throws when it fails. A bare `git fetch origin <base>` writes FETCH_HEAD and updates
// refs/remotes/origin/<base> only when remote.origin.fetch already covers it - which
// actions/checkout does NOT configure on a pull_request - and it exits 0 either way. A
// caller that cannot proceed without the ref passes true; the rest keep the bare form,
// which is the command they have always run and the one CI still runs unchanged.
export fun fetchBase(base: str, refspec: bool) > void !> str {
    if (collecting()) { return; }
    if (!refspec) {
        proc\exec("git", args: ["fetch", "--no-tags", "origin", base], dir: ".", opts: {});
        return;
    }
    final fetched = proc\exec("git", args: ["fetch", "--no-tags", "origin",
        "+refs/heads/" + base + ":refs/remotes/origin/" + base], dir: ".",
        opts: {"allow_failure": true});
    if (!fetched.ok) { throw "advice: git fetch " + base + ": " + fetched.stderr; }
}

// diffRange is the revision argument an advisor's `git diff` takes, and it is the one place
// local mode and CI deliberately MEASURE different things rather than route the same answer
// somewhere else.
//
// CI gets the three-dot form. A pull request is a set of commits, and `base...head` is the
// diff from where the branch left the base - what a reviewer of that pull request reads, and
// unaffected by whatever else landed on the base meanwhile.
//
// Local gets the merge base on its own, which `git diff` reads as "compare the WORKING TREE
// against this commit". At the keyboard the change under review is the one you are about to
// commit; advice that waits for the commit has missed the moment acting on it was cheap.
// Nothing is lost by it - the merge base is the same point the three-dot form starts from,
// so local strictly ADDS the uncommitted delta to what CI would have said.
//
// Untracked files stay outside both. `git diff` reports tracked paths, and unioning in
// `ls-files --others` would change what the three name-only advisors count while doing
// nothing for the three that parse a patch - a separate decision, per advisor.
export fun diffRange(base: str, head: str) > str !> any {
    if (!collecting()) { return "origin/" + base + "..." + head; }
    final merged = proc\exec("git", args: ["merge-base", "origin/" + base, head],
        dir: ".", opts: {"quiet": true, "allow_failure": true});
    // A base this clone cannot resolve is ordinary locally - nothing ever fetched it - and
    // the three-dot form is what to hand back, not an error. It then fails inside the
    // advisor's own git call exactly as it always has, every caller already tolerates that
    // failure, and `magus diff --impact` prints a BASE line saying the ref is missing. One
    // failure, one place, one explanation.
    if (!merged.ok) { return "origin/" + base + "..." + head; }
    return merged.stdout.trim();
}

// addedTargets returns the target names a diff introduces, read from its added
// `export fun` lines. The magusfile is the declaration, so the diff answers "new" without
// checking out the base to load a second graph.
//
// Both conformance and target-outputs open their finding on the word "adds", so both need
// this answer. Only one of them checked, and the other named a target that had sat on the
// base for weeks.
export fun addedTargets(diff: str) > [str] {
    var names = mut [];
    foreach (line in diff.split("\n")) {
        if (!line.startsWith("+export fun ")) { continue; }
        final rest = line.sub("+export fun ".len());
        final open = rest.indexOf("(");
        if (open == null) { continue; }
        final name = rest.sub(0, open).trim();
        if (name != "") { names.append(name); }
    }
    return names;
}

// declaredAtBase reports whether a target of this name existed before the change.
//
// Editing a target's body rewrites its `export fun` line, so the diff alone calls that
// target added. On those grounds a comment about NEW targets once listed `preflight`,
// which predated the pull request. Only the base tree settles it.
export fun declaredAtBase(name: str, base: str) > bool !> any {
    final res = proc\exec("git", args: ["grep", "-q", "export fun " + name + "(",
        "origin/" + base, "--", "*.buzz"], dir: ".", opts: {"allow_failure": true});
    return res.ok;
}

export fun beginMarker(name: str) > str {
 return "<!-- magus:advice:" + name + ":begin -->"; }
export fun endMarker(name: str) > str { return "<!-- magus:advice:" + name + ":end -->"; }

// The preface. A reader landing on this comment in someone else's repository has no idea
// what left it, and an unsigned bot comment is the kind people report as spam. It says
// who is talking, that none of it blocks the merge, and where to complain.
//
// It also links THIS run's summary, which carries the insight report and the graphs the
// comment deliberately leaves out: a comment should stay short enough to read, and the
// run page is already the right home for everything a reader might want next.
fun preface() > str {
    var text = "### magus\n\n"
        + "> Checked this pull request against the build graph. Each finding below starts "
        + "collapsed; open the ones that concern you. **Nothing here blocks the merge**; "
        + "disagree with a note and label it away.\n";
    final repo = env("REPO");
    final run = env("GITHUB_RUN_ID");
    if (repo != "" and run != "") {
        text = text + ">\n> [Full run summary](https://github.com/" + repo + "/actions/runs/" + run
            + ") - hotspots, ownership, volatility, dependency graph.\n";
    }
    return text;
}

// The glossary. Terminology a reader may not share gets a deep link on FIRST mention,
// the same courtesy the documentation site extends. Longest first, so "targets" wins over
// "target" and the link covers the whole word.
final glossary_terms = ["targets", "target", "spells", "spell", "charms", "charm",
    "workspace", "projects", "project", "cache", "affected set"];
final glossary_urls = {
    "targets": "https://eli.gladman.cc/magus/concepts/targets/",
    "target": "https://eli.gladman.cc/magus/concepts/targets/",
    "spells": "https://eli.gladman.cc/magus/concepts/spells/",
    "spell": "https://eli.gladman.cc/magus/concepts/spells/",
    "charms": "https://eli.gladman.cc/magus/concepts/charms/",
    "charm": "https://eli.gladman.cc/magus/concepts/charms/",
    "workspace": "https://eli.gladman.cc/magus/concepts/workspace/",
    "projects": "https://eli.gladman.cc/magus/concepts/workspace/",
    "project": "https://eli.gladman.cc/magus/concepts/workspace/",
    "cache": "https://eli.gladman.cc/magus/concepts/cache/",
    "affected set": "https://eli.gladman.cc/magus/guides/affected/",
};

// linkTerms deep-links the first mention of each glossary term.
//
// Inline links, NOT footnotes. GitHub does not resolve a `[^label]` reference that sits
// inside an HTML block, and every section here lives inside <details> - the references
// rendered as literal text. Hoisting the definitions out to the top level did not help,
// because it is the REFERENCE that goes unparsed, not the definition.
//
// Code spans are left alone: `magus\targets()` is an identifier, not the concept, and
// rewriting inside backticks would produce something that no longer runs. Splitting on the
// backtick makes every ODD segment code, which is the whole guard.
export fun linkTerms(text: str) > str {
    final parts = text.split("`");
    var done = mut [];
    var i = 0;
    // The backticks come back via join rather than by re-prepending one per segment: the
    // separator is what split() removed, so putting it back is the join's job.
    final pieces = mut [<str>];
    foreach (part in parts) {
        var piece = part;
        // Odd segments sit between backticks. Leave them exactly as written. A table row
        // is skipped too: linking a header cell turns `| project |` into a link nobody
        // asked for, and the cell is a label rather than a mention.
        if (i % 2 == 0 and !part.trim().startsWith("|")) {
            foreach (term in glossary_terms) {
                var seen = false;
                foreach (d in done) { if (d == term) { seen = true; } }
                if (seen) { continue; }
                final at = piece.indexOf(term);
                if (at == null) { continue; }
                // Never inside an existing link's TEXT, where it would nest. An unclosed
                // "[" before the term is what says we are inside one.
                final before = piece.sub(0, len: at);
                if (before.split("[").len() > before.split("]").len()) { continue; }
                done.append(term);
                piece = piece.sub(0, len: at) + "[" + term + "](" + glossary_urls[term] + ")"
                    + piece.sub(at + term.len());
            }
        }
        pieces.append(piece);
        i = i + 1;
    }
    return pieces.join("`");
}

// linkCodes turns a bare diagnostic code into a link to its page. Inline, for the same
// reason linkTerms is: a footnote reference inside <details> never resolves. A code is magus's
// stable, greppable identifier for one failure, and a reader who meets MGS1003 in a
// comment should be one click from what it means - not left to search for it.
//
// The area subdirectory comes from the code's number band, the same mapping types/
// diagnostic.go uses to build the URL it prints on a raised error.
export fun codeURL(code: str) > str {
    var area = "sandbox";
    if (code.startsWith("MGS1")) { area = "magusfile"; }
    if (code.startsWith("MGS4")) { area = "race"; }
    if (code.startsWith("MGS5")) { area = "services"; }
    if (code.startsWith("MGS6")) { area = "charms"; }
    if (code.startsWith("MGS7")) { area = "knowledge"; }
    if (code.startsWith("MGS8")) { area = "outputref"; }
    if (code.startsWith("MGS9")) { area = "auth"; }
    return "https://eli.gladman.cc/magus/reference/codes/" + area + "/" + code + "/";
}

export fun linkCodes(text: str) > str {
    final parts = mut [<str>];
    var rest = text;
    while (true) {
        final at = rest.indexOf("MGS");
        if (at == null) {
            parts.append(rest);
            return parts.join("");
        }
        final code = rest.sub(at, len: 7);
        // Only a full MGS#### token, and only when it is not already inside a link or a
        // URL - doctor already prints "see: <url>" for some findings.
        final before = rest.sub(0, len: at);
        final linked = before.split("[").len() > before.split("]").len();
        if (code.len() == 7 and !linked and before.indexOf("codes/") == null) {
            parts.append(before + "[" + code + "](" + codeURL(code) + ")");
        } else {
            parts.append(rest.sub(0, len: at + 3));
            rest = rest.sub(at + 3);
            continue;
        }
        rest = rest.sub(at + 7);
    }
    // No trailing return: the loop is `while (true)` with no break, so every exit
    // is one of the returns above and anything here is unreachable.
}

// The way out, kept where an unsubscribe link belongs: last, small, and never in the way
// of the content. Someone who does not want these should not have to read the source of a
// composite action to find the switch.
// Comments written before footnotes were abandoned still carry a definitions block.
// Stripping it on the next push cleans them up rather than leaving literal
// "[^target]:" lines at the bottom of an old comment forever.
final footnotes_marker = "<!-- magus:advice:footnotes -->";

// The footer: when this was last written, and the way out.
//
// The timestamp because the comment is REWRITTEN in place on every push - GitHub shows an
// "edited" badge but not when, so a reader cannot tell whether they are looking at
// findings for the commit they are reviewing or for one from yesterday. Every other
// comment on the page is immutable and dated; this one is not, so it dates itself.
// Marked so compose can strip the PREVIOUS one. Without a marker each advisor appended
// another copy and a comment ended a run wearing eight footers, one per advisor.
final footer_marker = "<!-- magus:advice:footer -->";

fun footer() > str {
    return footer_marker + "\n<sub><i>Last updated " + time\nowIso() + ". "
        + "Every one of these is an input you can set to <code>false</code>, and this "
        + "whole comment is one step you can drop. "
        + "<a href=\"https://eli.gladman.cc/magus/guides/integrations/pr-advice/\">"
        + "How to turn these off</a>.</i></sub>\n";
}

// compose returns the comment body with section `name` set to `body` under `title`,
// replacing an existing section of that name, appending when there is none, and REMOVING
// it when body is empty. Pure, so the composition rules are testable without a pull
// request.
//
// Every section carries a heading and a rule above it. Run together, the sections read as
// one wall of bold sentences and a reader cannot tell where one finding ends and the next
// begins - which is what the first live comment looked like.
// withoutFooter returns text up to its footer marker, so two renderings of the same
// comment compare on CONTENT alone.
//
// The footer carries time\nowIso(), and compose appends it on every path, so comparing
// whole bodies made the "nothing changed" guard below unreachable: the composed body
// differed from the stored one on every call, and all eleven advisors PATCHed the
// comment on every push whether or not a finding had moved. That is exactly the edit
// churn and notification noise the single-comment design exists to avoid.
fun withoutFooter(text: str) > str {
    // The LAST occurrence, not the first. compose always appends the footer last, so
    // the trailing one is the real footer; an earlier one is content. An advisor that
    // quotes a conflicted hunk or a doc containing the marker - merge-conflict and
    // hand-edited-generated both paste repository text - would otherwise truncate
    // both sides at its own quoted copy, and every finding after it would compare as
    // absent, suppressing a PATCH that was genuinely needed.
    //
    // Buzz has no lastIndexOf, so this walks forward taking the last hit.
    var at: int? = null;
    var scan = 0;
    while (true) {
        final hit = text.indexOf(footer_marker, from: scan);
        if (hit == null) { break; }
        at = hit;
        scan = hit + footer_marker.len();
    }
    if (at == null) { return text.trim(); }
    return text.sub(0, len: at!).trim();
}

test "withoutFooter ignores a changed timestamp" {
    final a = "body text\n" + footer_marker + "\n<sub>Last updated 2026-08-12T10:00:00Z.</sub>";
    final b = "body text\n" + footer_marker + "\n<sub>Last updated 2026-08-12T11:30:00Z.</sub>";
    assert\equal(withoutFooter(a), want: withoutFooter(b),
        message: "only the footer differs, so these are the same comment");
}

test "withoutFooter still sees a real change" {
    final a = "one finding\n" + footer_marker + "\n<sub>x</sub>";
    final b = "two findings\n" + footer_marker + "\n<sub>x</sub>";
    assert\notEqual(withoutFooter(a), want: withoutFooter(b),
        message: "the body moved, so the comment must be rewritten");
}

test "recomposing the same findings is a no-op under the guard" {
    final first = compose("", name: "demo", title: "Demo", body: "one finding");
    final again = compose(first, name: "demo", title: "Demo", body: "one finding");
    assert\equal(withoutFooter(again), want: withoutFooter(first),
        message: "the guard must see an unchanged comment as unchanged");
    std\assert(first.indexOf(footer_marker) != null, message: "compose always writes a footer");
}

test "withoutFooter is not fooled by an advisor quoting the marker" {
    // merge-conflict and hand-edited-generated both paste repository text into their
    // findings, so the marker is reachable content. Truncating at the FIRST hit threw
    // away every finding after it and suppressed a PATCH that was needed.
    final quoted = "finding one\nsomeone pasted " + footer_marker + " into a diff\nfinding two";
    final a = quoted + "\n" + footer_marker + "\n<sub>Last updated 10:00.</sub>";
    final b = quoted + "\n" + footer_marker + "\n<sub>Last updated 11:30.</sub>";
    assert\equal(withoutFooter(a), want: withoutFooter(b),
        message: "only the real trailing footer differs");
    std\assert(withoutFooter(a).indexOf("finding two") != null,
        message: "the content after the quoted marker survives");
}

test "withoutFooter tolerates a comment with no footer yet" {
    assert\equal(withoutFooter("  bare  "), want: "bare", message: "trimmed, not dropped");
}

// hasSection reports whether a composed comment still carries a finding.
//
// A begin marker is the only proof one survived: compose writes the preface and the
// footer on every path, so neither tells you anything. Matching the marker SHAPE rather
// than a list of names keeps this correct as we add advisors.
//
// The merge-conflict and hand-edited-generated advisors paste tracked files, so quoted
// repository text can carry a marker of its own. hasSection keeps that comment rather
// than risk discarding a real finding.
fun hasSection(text: str) > bool {
    return text.indexOf(":begin -->") != null;
}

// resolved is the body a comment takes once its last finding goes away.
//
// publish PATCHes to this instead of deleting, holding the decision that function already
// records: a delete takes the thread's replies with it. A later reader of the merged pull
// request still learns that magus raised something and that someone settled it. Editing a
// comment notifies nobody, so this records a disposal without asking for attention.
fun resolved() > str {
    return comment_marker + "\n### magus\n\n"
        + "> Everything magus raised on this pull request is resolved.\n"
        + footer();
}

export fun compose(current: str, name: str, title: str, body: str) > str {
    final begin = beginMarker(name);
    final end = endMarker(name);
    var head = current;
    var tail = "";
    final at = current.indexOf(begin);
    if (at != null) {
        head = current.sub(0, len: at);
        final closes = current.indexOf(end);
        if (closes != null) { tail = current.sub(closes + end.len()); }
    }
    if (head.indexOf(comment_marker) == null) { head = comment_marker + "\n" + preface(); }
    // The definitions block is rebuilt from the finished comment, so strip whatever is
    // there before composing.
    // Both trailers are rebuilt every time, so cut whatever a previous run left. The
    // footnotes marker is legacy - comments written before footnotes were abandoned still
    // carry one - and the footer marker is how this stays a single footer.
    foreach (marker in [footnotes_marker, footer_marker]) {
        final inHead = head.indexOf(marker);
        if (inHead != null) { head = head.sub(0, len: inHead); }
        final inTail = tail.indexOf(marker);
        if (inTail != null) { tail = tail.sub(0, len: inTail); }
    }
    if (body == "") {
        final remainder = (head + tail).trim();
        // Nothing found here, and no other advisor left a section behind: there is no
        // comment to make. "" tells publish to write nothing.
        //
        // THE THRESHOLD, for every advisor at once: a section is what earns a reviewer's
        // attention. compose writes the preface and the footer on every path, so a comment
        // carrying only those reports that a run happened, which the checks list already
        // reports. Across pull requests 120 to 125 that shell ran 510 bytes. Open it five
        // times for nothing and you stop opening it, including the time it has a finding.
        if (!hasSection(remainder)) { return ""; }
        return remainder + "\n" + footer();
    }
    // Two shells reach this point: the preface just built, and the resolved note a
    // previous run left. Rebuild either, or a finding raised after magus settled an
    // earlier one lands under a line saying everything is resolved.
    if (!hasSection(head + tail)) {
        head = comment_marker + "\n" + preface();
        tail = "";
    }
    // Collapsed by default. Six findings expanded is a wall nobody reads to the end of;
    // six one-line summaries is a table of contents you scan in two seconds and open the
    // one that concerns you. GitHub renders markdown inside <details> as long as a blank
    // line follows the summary, which is why the body is padded.
    //
    // This is why a title carries its own count: with the body hidden, the summary line is
    // the whole signal a reader has for deciding whether to open it.
    final section = begin + "\n<details>\n<summary><b>" + title + "</b></summary>\n\n"
        + linkCodes(linkTerms(body.trim())) + "\n\n</details>\n" + end;
    return (head + section + tail).trim() + "\n\n" + footer();
}

// silences reports whether these labels mute an advisor. `magus:silence` mutes every
// one; `magus:silence:<name>` mutes exactly one. Pure over the label list so the matching
// rule is testable.
//
// A LABEL rather than a config file, because silencing is usually about this change
// rather than about the repository: you looked, you decided the finding does not apply
// here, and you want it to stop without committing that opinion to everyone forever. The
// label is visible on the pull request, so the next reader can see what was muted, and
// removing it brings the finding back.
export fun silences(labels: [str], name: str) > bool {
    foreach (label in labels) {
        if (label == "magus:silence") { return true; }
        if (label == "magus:silence:" + name) { return true; }
    }
    return false;
}

// silenced asks GitHub for this pull request's labels and applies the rule above.
export fun silenced(repo: str, pr: str, name: str) > bool !> any {
    // Labels live on a pull request. Local mode has none, and must not reach the forge
    // to find out, so nothing is silenced there. Muting a local advisor is a job for
    // whoever asked for the run, not for a label on a change that may not exist yet.
    if (collecting()) { return false; }
    final res = proc\exec("gh", args: ["api", "repos/" + repo + "/issues/" + pr + "/labels"],
        dir: ".", opts: {"quiet": true, "allow_failure": true});
    if (!res.ok) { return false; }
    var labels = mut [];
    foreach (l in serialize\jsonDecode(res.stdout).listValue()) {
        labels.append(l.q("name").stringValue());
    }
    return silences(labels, name: name);
}

// find returns the id of our comment on this PR, or "" when we have not commented yet.
// Read through `gh api` and decoded here rather than filtered with a jq expression: the
// marker is an HTML comment, and quoting it through a jq -r filter inside YAML inside
// bash is three layers of escaping to get wrong.
fun find(repo: str, pr: str) > str !> any {
    final listed = proc\exec("gh", args: ["api", "--paginate",
        "repos/" + repo + "/issues/" + pr + "/comments"], dir: ".", opts: {"quiet": true});
    foreach (c in serialize\jsonDecode(listed.stdout).listValue()) {
        if (c.q("body").stringValue().indexOf(comment_marker) != null) {
            return "{c.q("id").integerValue()}";
        }
    }
    return "";
}

// sectionLine renders one section as the single JSON line the collect sink emits. Pure,
// so the shape the Go driver parses is pinned by a test here rather than by its one call
// site - the two sit in different languages and cannot share a type.
export fun sectionLine(name: str, title: str, body: str) > str {
    return serialize\jsonEncode({"name": name, "title": title, "body": body});
}

// publish upserts one advisor's section into the PR's magus comment. An empty body
// retracts the section. A comment left with no sections says so; deleting it would lose
// the thread's history.
//
// A pull request with nothing to report gets NO comment: the first advisor with a finding
// opens it, so a shell of preface and footer never reaches the page.
//
// In local mode it writes the section to stdout instead and touches nothing else. The
// section is emitted even when the body is EMPTY: a retraction says "this advisor looked
// and found nothing", which is exactly what a reader of a local run wants to know, and it
// is what lets the caller show a per-advisor verdict rather than a list of complaints.
export fun publish(repo: str, pr: str, name: str, title: str, body: str) > void !> any {
    if (collecting()) {
        std\print(sectionLine(name, title: title, body: body));
        return;
    }
    // Neither a pull request to write to nor a sink to write to. Reaching gh from here
    // would build `repos//issues//comments` and fail on the far side, blaming GitHub for
    // a missing local variable, so say which of the two modes is missing its input.
    if (repo == "" or pr == "") {
        throw "advice: nowhere to publish \"" + name + "\". For a pull request, set REPO "
            + "and PR_NUMBER (the advice composite action passes both). A local run is "
            + "driven by magus diff, which sets " + mode_env + "=" + mode_local + " and "
            + "reads each section back as one JSON line instead of posting it.";
    }
    final id = find(repo, pr: pr);
    var current = "";
    if (id != "") {
        final got = proc\exec("gh", args: ["api", "repos/" + repo + "/issues/comments/" + id],
            dir: ".", opts: {"quiet": true});
        current = serialize\jsonDecode(got.stdout).q("body").stringValue();
    }
    var composed = compose(current, name: name, title: title, body: body);
    if (composed == "") {
        // No comment yet, and nothing to open one about. A pull request magus found
        // nothing on carries no trace of magus.
        if (id == "") { return; }
        // This one carried findings before, so the thread stays and records their end.
        composed = resolved();
    }
    if (withoutFooter(composed) == withoutFooter(current)) { return; }

    // The body goes through a JSON file, never an -f flag: it is markdown with newlines,
    // backticks, and quotes, and every one of those is a shell-quoting hazard.
    // A fresh file per call, not a fixed /tmp path. The old one was shared by all
    // eleven advisors and never cleaned up: two running concurrently clobbered each
    // other's payload and one posted the other's body, and on a reused or self-hosted
    // runner a predictable name is a pre-creation target for content that is then
    // POSTed to the repo under the workflow's token.
    final payload = fs\tempFile("magus-advice-payload");
    fs\writeFile(payload, content: serialize\jsonEncode({"body": composed}));
    if (id == "") {
        proc\exec("gh", args: ["api", "--method", "POST",
            "repos/" + repo + "/issues/" + pr + "/comments", "--input", payload], dir: ".", opts: {});
        return;
    }
    proc\exec("gh", args: ["api", "--method", "PATCH",
        "repos/" + repo + "/issues/comments/" + id, "--input", payload], dir: ".", opts: {});
}

test "compose opens with what this is before any finding" {
    final body = compose("", name: "conflicts", title: "Merge conflicts", body: "hello");
    std\assert(body.indexOf("### magus") != null, message: "announces itself");
    std\assert(body.indexOf("Checked this pull request") != null, message: "says what it did");
    std\assert(body.indexOf("Nothing here blocks the merge") != null, message: "says it is not a gate");
    std\assert(body.indexOf("label it away") != null, message: "says how to dismiss one");
    std\assert(body.indexOf("> Checked") != null, message: "the prologue is a blockquote, set off from the findings");
    // The prologue comes before the first collapsed finding, not after it.
    std\assert(body.indexOf("### magus") < body.indexOf("<details>"), message: "opens the comment");
}

test "compose folds each section away behind its title" {
    final body = compose("", name: "conflicts", title: "Merge conflicts (2)", body: "hello");
    std\assert(body.indexOf("<summary><b>Merge conflicts (2)</b></summary>") != null, message: "the title is the summary line");
    std\assert(body.indexOf("<details>") != null, message: "collapsed by default");
    std\assert(body.indexOf("hello") != null, message: "carries the body");
}

test "compose replaces only its own section" {
    var body = compose("", name: "conflicts", title: "Merge conflicts", body: "old conflicts");
    body = compose(body, name: "drift", title: "Generated drift", body: "drift text");
    body = compose(body, name: "conflicts", title: "Merge conflicts", body: "new conflicts");
    std\assert(body.indexOf("old conflicts") == null, message: "the old text is gone");
    std\assert(body.indexOf("new conflicts") != null, message: "the new text is there");
    std\assert(body.indexOf("drift text") != null, message: "the other section survives");
}

test "an empty body retracts the section and its heading" {
    var body = compose("", name: "conflicts", title: "Merge conflicts", body: "there is a conflict");
    body = compose(body, name: "drift", title: "Generated drift", body: "drift text");
    body = compose(body, name: "conflicts", title: "Merge conflicts", body: "");
    std\assert(body.indexOf("there is a conflict") == null, message: "the text is withdrawn");
    std\assert(body.indexOf("Merge conflicts") == null, message: "the summary line goes too");
    std\assert(body.indexOf("drift text") != null, message: "the other section survives");
}

test "a pull request with nothing to report composes no comment at all" {
    std\assert(compose("", name: "doctor", title: "Workspace health", body: "") == "",
        message: "no finding and no comment yet means nothing to post");
}

test "the last finding going away empties the comment" {
    final one = compose("", name: "conformance", title: "C", body: "a divergent target");
    std\assert(one != "", message: "a finding does compose a comment");
    std\assert(compose(one, name: "conformance", title: "C", body: "") == "",
        message: "withdrawing the only finding leaves nothing to say");
}

test "a silent advisor leaves the comment for the next one to open" {
    var body = compose("", name: "doctor", title: "Workspace health", body: "");
    std\assert(body == "", message: "the first advisor found nothing");
    body = compose(body, name: "unclaimed", title: "Unclaimed", body: "a stray file");
    std\assert(body.indexOf("a stray file") != null, message: "the second one still opens it");
    std\assert(body.indexOf("### magus") != null, message: "and carries the preface");
}

test "a finding raised after a resolution does not land under the resolved line" {
    // publish rewrites an emptied comment to say everything is settled. A later push can
    // still raise a finding, and the two must not stack.
    final settled = comment_marker + "\n### magus\n\n"
        + "> Everything magus raised on this pull request is resolved.\n"
        + footer_marker + "\n<sub><i>Last updated 2026-09-02T00:00:00Z.</i></sub>\n";
    final body = compose(settled, name: "doctor", title: "Workspace health (1 failing)",
        body: "a check broke");
    std\assert(body.indexOf("a check broke") != null, message: "the new finding is there");
    std\assert(body.indexOf("is resolved") == null, message: "and the settled line is gone");
    std\assert(body.indexOf("Checked this pull request") != null, message: "the preface is back");
}

test "recomposing an empty body against a resolved comment stays put" {
    // Otherwise every push PATCHes the comment again, which is the notification churn
    // withoutFooter exists to prevent.
    final settled = comment_marker + "\n### magus\n\n"
        + "> Everything magus raised on this pull request is resolved.\n"
        + footer_marker + "\n<sub><i>Last updated 2026-09-02T00:00:00Z.</i></sub>\n";
    std\assert(compose(settled, name: "doctor", title: "Workspace health", body: "") == "",
        message: "nothing to say about a comment already saying nothing");
}

test "addedTargets reads new target names out of a diff" {
    final diff = "+export fun release(ctx: magus\\Context, args: [str]) > void\n"
        + "-export fun gone(ctx: magus\\Context) > void\n"
        + " export fun untouched(ctx: magus\\Context) > void\n"
        + "+export fun  spaced (ctx: magus\\Context) > void\n";
    final got = addedTargets(diff);
    std\assert(got.len() == 2, message: "only the added lines");
    std\assert(got[0] == "release", message: "the first new target");
    std\assert(got[1] == "spaced", message: "trimmed");
}

test "addedTargets ignores a diff with no new targets" {
    std\assert(addedTargets("+    ctx.needs(build);\n-export fun old() > void\n").len() == 0,
        message: "nothing added");
}

test "the preface survives a section being replaced" {
    var body = compose("", name: "a", title: "A", body: "one");
    body = compose(body, name: "a", title: "A", body: "two");
    std\assert(body.indexOf("### magus") != null, message: "still announces itself");
    std\assert(body.split("### magus").len() == 2, message: "and only once");
}

test "linkTerms deep-links the first mention of a term" {
    final got = linkTerms("A target with no outputs re-runs. Another target too.");
    std\assert(got.indexOf("[target](https://eli.gladman.cc/magus/concepts/targets/)") != null, message: "links the concept");
    std\assert(got.split("concepts/targets/").len() == 2, message: "only the first mention");
    std\assert(got.indexOf("[^") == null, message: "no footnote reference: GitHub will not resolve one in here");
}

test "linkTerms leaves code spans alone" {
    final got = linkTerms("Run `magus run target` to build the target.");
    std\assert(got.indexOf("`magus run target`") != null, message: "the command still runs");
    std\assert(got.indexOf("[target](") != null, message: "the prose mention is linked");
}

test "linkTerms does not nest a link inside a link" {
    final got = linkTerms("See [the cache guide](https://example.com) for more.");
    std\assert(got.indexOf("[the cache guide](https://example.com)") != null, message: "left intact");
}

test "linkCodes makes a bare diagnostic code clickable" {
    final got = linkCodes("names MGS1003 in passing");
    std\assert(got.indexOf("[MGS1003](https://eli.gladman.cc/magus/reference/codes/magusfile/MGS1003/)") != null,
        message: "links the code to its page");
}

test "linkCodes routes a code to its own area" {
    std\assert(codeURL("MGS4002").indexOf("/race/") != null, message: "race codes");
    std\assert(codeURL("MGS2007").indexOf("/sandbox/") != null, message: "sandbox is the default band");
}

test "linkTerms leaves table rows alone" {
    final got = linkTerms("| project | why |");
    std\assert(got == "| project | why |", message: "a header cell is a label, not a mention");
}

test "a rendered comment carries no footnote syntax" {
    final body = compose("", name: "doctor", title: "Workspace health", body: "a target failed (MGS1003)");
    std\assert(body.indexOf("[^") == null, message: "GitHub leaves a reference inside <details> as literal text");
    std\assert(body.indexOf("concepts/targets/") != null, message: "the term is linked inline instead");
    std\assert(body.indexOf("codes/magusfile/MGS1003/") != null, message: "and so is the code");
}

test "every comment says how to turn it off, last" {
    final body = compose("", name: "doctor", title: "Workspace health", body: "a target failed");
    std\assert(body.indexOf("How to turn these off") != null, message: "the way out is present");
    std\assert(body.indexOf("guides/integrations/pr-advice") != null, message: "and documented");
    std\assert(body.indexOf("How to turn these off") > body.indexOf("</details>"), message: "after the findings");
    std\assert(body.indexOf("Last updated ") != null, message: "and says when it was written");
}

test "the footer survives a comment with nothing cited" {
    final body = compose("", name: "x", title: "X", body: "nothing worth citing here");
    std\assert(body.indexOf("How to turn these off") != null, message: "still says how to stop it");
}

test "silences mutes one advisor by name" {
    std\assert(silences(["magus:silence:unclaimed"], name: "unclaimed"), message: "the named one");
    std\assert(!silences(["magus:silence:unclaimed"], name: "doctor"), message: "and only that one");
}

test "silences mutes everything with the bare label" {
    std\assert(silences(["magus:silence"], name: "doctor"), message: "blanket silence");
}

test "the collect sink emits one JSON line per section" {
    final line = sectionLine("unclaimed", title: "Files no project claims (2)", body: "a\nb");
    std\assert(line.indexOf("\n") == null, message: "one line: the driver reads these line by line");
    std\assert(line.indexOf("\"name\":\"unclaimed\"") != null, message: "names the section");
    std\assert(line.indexOf("\"title\":\"Files no project claims (2)\"") != null, message: "carries the summary line");
    std\assert(line.indexOf("\"body\":\"a\\nb\"") != null, message: "a newline in the body is escaped, not emitted");
}

test "a retraction is still a section" {
    // An empty body removes the PR section, and a local reader needs the same fact:
    // "this advisor ran and found nothing" is not the same as "this advisor did not run".
    final line = sectionLine("doctor", title: "Workspace health", body: "");
    std\assert(line.indexOf("\"name\":\"doctor\"") != null, message: "the advisor is still named");
    std\assert(line.indexOf("\"body\":\"\"") != null, message: "and the empty body is carried, not dropped");
}

test "local mode supplies the pull-request facts a working tree has not got" {
    assert\equal(localFallback("PR_BASE", base: "main"), want: "main",
        message: "the base is the driver's, passed through");
    std\assert(localFallback("PR_NUMBER", base: "main") != "",
        message: "non-empty, or every advisor reads the run as 'not a pull request' and says nothing");
    std\assert(localFallback("PR_HEAD_SHA", base: "main") != "",
        message: "same guard: all three must be set together");
}

test "local mode invents nothing beyond those three" {
    assert\equal(localFallback("GH_TOKEN", base: "main"), want: "",
        message: "a credential is never conjured for a local run");
    assert\equal(localFallback("FIX_LABEL", base: "main"), want: "",
        message: "consent for a writer is not something a local default can give");
}

test "CI diffs the pull request's commits" {
    // The runner leaves the mode variable unset, which IS CI mode. The local branch is not
    // reachable from here - collecting() reads os\env and os\with_env does not touch this
    // process's own environment - so the merge-base half is pinned in Go instead, by
    // TestLocalModeDiffsTheWorkingTree.
    assert\equal(diffRange("main", head: "abc123"), want: "origin/main...abc123",
        message: "three-dot: what a reviewer of those commits reads");
}

test "the local-mode variables are spelled as the driver spells them" {
    // cmd/magus/diff_advice.go holds the only other copy of these three strings, and
    // nothing at runtime couples the two: rename one side alone and collecting() stays
    // false, so env() supplies no pull-request facts and every advisor reaches publish()
    // with an empty repo and pr - ten "nowhere to publish" notes and not one finding.
    assert\equal(mode_env, want: "MAGUS_INTERNAL_ADVICE_MODE", message: "the mode variable");
    assert\equal(mode_local, want: "local", message: "and the value that turns local mode on");
    assert\equal(base_env, want: "MAGUS_INTERNAL_ADVICE_BASE_BRANCH",
        message: "the base BRANCH, which is why the name says branch and not ref");
}

test "silences ignores unrelated labels" {
    std\assert(!silences(["bug", "magus:autofix"], name: "doctor"), message: "not a silence label");
    std\assert(!silences([], name: "doctor"), message: "no labels at all");
}

test "a comment carries exactly one footer however many advisors write to it" {
    var body = compose("", name: "a", title: "A", body: "one");
    body = compose(body, name: "b", title: "B", body: "two");
    body = compose(body, name: "c", title: "C", body: "three");
    std\assert(body.split("How to turn these off").len() == 2, message: "one footer, not three");
    std\assert(body.split("Last updated").len() == 2, message: "and one timestamp");
}
