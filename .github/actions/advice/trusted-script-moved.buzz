// Comment when a pull request renames or deletes a script that a trusted workflow job runs.
//
// A trusted job checks out the default branch instead of the pull request, so it runs the
// base's copy of every script whatever the pull request's workflow says. Move a script it
// runs and the pull request's workflow names a path the base does not have yet: the job
// fails or skips on this pull request and passes again once the change merges. Delete one,
// or move it while the workflow still names the old path, and the workflow that lands names
// a file the tree no longer has: the job fails on every run after the merge.
//
// Silent unless the diff renames or deletes a file such a job runs.
import "fs";
import "proc";
import "serialize";
import "strings";
import "encoding/yaml";
import "advice";
import "std";
// Used by the test blocks.
import "assert";

final section = "trusted-script-moved";

final workflows_dir = ".github/workflows";
final default_branch_ref = "$\{\{github.event.repository.default_branch}}";

// Job is one workflow job, as far as this advisor reads it.
export object Job {
    // The workflow file, from the repository root.
    workflow: str = "",
    // The job's key under `jobs:`.
    id: str = "",
    // The job's `name:`, or its key when it has none.
    name: str = "",
    // Whether it checks out the default branch rather than the pull request.
    trusted: bool = false,
    // Whether a pull_request* event runs it, so it runs on the pull request at all.
    onPullRequest: bool = false,
    // Every word of its steps' `run:`, with a leading "./" dropped: the candidates for a
    // repository path. Matching against the diff's paths is what filters them.
    runs: [str] = [<str>],
}

// Moved is one rename or delete from `git diff --name-status`: path as the base has it,
// and to, "" for a delete.
export object Moved {
    path: str = "",
    to: str = "",
}

// Finding is a trusted job that runs a moved script. broken means the job fails after the
// merge, not only on this pull request.
export object Finding {
    job: Job = Job{},
    moved: Moved = Moved{},
    broken: bool = false,
}

fun has(list: [str], want: str) > bool {
    foreach (item in list) {
        if (item == want) { return true; }
    }
    return false;
}

// checksOutDefault reports whether a checkout ref names the default branch: the event's
// default_branch expression in any spacing, or base spelled out.
export fun checksOutDefault(ref: str, base: str) > bool {
    if (ref == "") { return false; }
    return ref.replace(" ", with: "") == default_branch_ref or ref == base;
}

// runWords splits a `run:` script into the words that could name a file. Shell operators
// and quotes separate words; nothing is resolved.
export fun runWords(script: str) > [str] {
    var text = script;
    foreach (sep in ["\n", "\t", ";", "|", "&", "(", ")", "\"", "'", "`"]) {
        text = text.replace(sep, with: " ");
    }
    final words = mut [<str>];
    foreach (word in text.split(" ")) {
        final path = if (word.startsWith("./")) word.sub(2) else word;
        if (path != "") { words.append(path); }
    }
    return words;
}

fun onPullRequest(on: serialize\Boxed) > bool {
    final events = mut [<str>];
    final one = on.string();
    if (one != null) { events.append(one!); }
    foreach (event in on.listValue()) { events.append(event.stringValue()); }
    foreach (event, _ in on.mapValue()) { events.append(event); }
    foreach (event in events) {
        if (event.startsWith("pull_request")) { return true; }
    }
    return false;
}

// jobs reads every job of a workflow. base is the default branch's name, which a checkout
// may spell out instead of using the expression. Throws on text that is not YAML.
export fun jobs(workflow: str, text: str, base: str) > [Job] !> any {
    final doc = serialize\Boxed.init(yaml\parse(text));
    final pr = onPullRequest(doc.q(["on"]));
    final found = mut [<Job>];
    foreach (id, job in doc.q(["jobs"]).mapValue()) {
        var trusted = false;
        final runs = mut [<str>];
        foreach (step in job.q(["steps"]).listValue()) {
            if (step.q(["uses"]).stringValue().startsWith("actions/checkout@")
                and checksOutDefault(step.q(["with", "ref"]).stringValue(), base: base)) {
                trusted = true;
            }
            foreach (word in runWords(step.q(["run"]).stringValue())) { runs.append(word); }
        }
        final name = job.q(["name"]).stringValue();
        found.append(Job{
            workflow = workflow,
            id = id,
            name = if (name != "") name else id,
            trusted = trusted,
            onPullRequest = pr,
            runs = runs,
        });
    }
    return found;
}

// moves reads the renames and deletes out of `git diff --name-status` output.
export fun moves(status: str) > [Moved] {
    final found = mut [<Moved>];
    foreach (line in status.split("\n")) {
        final fields = line.split("\t");
        if (line.startsWith("R") and fields.len() == 3) {
            found.append(Moved{path = fields[1], to = fields[2]});
        } else if (line.startsWith("D") and fields.len() == 2) {
            found.append(Moved{path = fields[1]});
        }
    }
    return found;
}

fun same(candidates: [Job], like: Job) > Job? {
    foreach (j in candidates) {
        if (j.workflow == like.workflow and j.id == like.id) { return j; }
    }
    return null;
}

// findings matches the moves against the trusted jobs at the base, and reads the head's
// workflows to say what each job does once the change lands. A job whose head workflow
// still runs the old path breaks after the merge. One that runs the new path breaks only
// while it checks out the base, on a pull request. One that runs neither dropped the step,
// which is nothing to say.
export fun findings(base: [Job], head: [Job], moved: [Moved]) > [Finding] {
    final found = mut [<Finding>];
    foreach (m in moved) {
        foreach (j in base) {
            if (!j.trusted or !has(j.runs, want: m.path)) { continue; }
            final after = same(head, like: j);
            if (after == null) { continue; }
            if (has(after!.runs, want: m.path)) {
                found.append(Finding{job = after!, moved = m, broken = true});
            } else if (m.to != "" and has(after!.runs, want: m.to) and after!.trusted and after!.onPullRequest) {
                found.append(Finding{job = after!, moved = m});
            }
        }
    }
    return found.sort(fun (a: Finding, b: Finding) > bool {
        if (a.broken != b.broken) { return a.broken; }
        return strings\compare(a.moved.path + a.job.workflow + a.job.id,
            b: b.moved.path + b.job.workflow + b.job.id) < 0;
    });
}

// body renders the findings, one paragraph each, or "" for none. base is the branch the
// trusted jobs check out.
export fun body(found: [Finding], base: str) > str {
    final paragraphs = mut [<str>];
    foreach (f in found) {
        final job = "The `" + f.job.name + "` job (`" + f.job.workflow + "`)";
        final old = "`" + f.moved.path + "`";
        final to = "`" + f.moved.to + "`";
        if (!f.broken) {
            paragraphs.append("This pull request moves " + old + " to " + to + ". " + job
                + " checks out `" + base + "` and runs its copy, which has no " + to
                + " yet, so it skips or fails on this pull request and passes again once this merges.");
        } else if (f.moved.to == "") {
            paragraphs.append("**This pull request deletes " + old + ", which " + job
                + " runs.** The job checks out `" + base + "`, so once this merges it fails on "
                + "every run unless this pull request also updates the workflow.");
        } else {
            paragraphs.append("**This pull request moves " + old + " to " + to + ", but " + job
                + " still runs " + old + ".** The job checks out `" + base + "`, so once this "
                + "merges it fails on every run unless this pull request also updates the workflow.");
        }
    }
    return paragraphs.join("\n\n");
}

fun title(found: [Finding]) > str {
    foreach (f in found) {
        if (f.broken) { return "A trusted job fails after this merges"; }
    }
    return "A trusted job runs a script this moves";
}

fun workflowPaths(base: str) > [str] !> any {
    final res = proc\exec("git", args: ["-c", "core.quotePath=false", "ls-tree", "--name-only",
        "origin/" + base, workflows_dir + "/"], dir: ".", opts: {"quiet": true, "allow_failure": true});
    final paths = mut [<str>];
    foreach (line in res.stdout.split("\n")) {
        if (line.endsWith(".yaml") or line.endsWith(".yml")) { paths.append(line); }
    }
    return paths;
}

// A workflow that does not parse is its own problem, reported by the forge; it runs no
// script this advisor could speak for.
fun readJobs(path: str, text: str, base: str) > [Job] {
    if (text == "") { return [<Job>]; }
    return jobs(path, text: text, base: base) catch [<Job>];
}

fun main() > void !> any {
    final pull = advice\pullRequest();
    final repo = pull.repo;
    final pr = pull.number;
    final base = pull.base;
    final head = pull.headSha;
    if (pr == "" and base == "" and head == "") {
        std\print("trusted-script-moved: no PR context; nothing to advise");
        return;
    }
    if (pr == "" or base == "" or head == "") {
        throw "trusted-script-moved: the pull request's number, base and head sha must be set together";
    }

    if (advice\silenced(repo, pr: pr, name: section)) {
        advice\publish(repo, pr: pr, name: section, title: "", body: "");
        std\print("trusted-script-moved: silenced by label");
        return;
    }

    advice\fetchBase(base, refspec: true);
    final status = proc\exec("git", args: ["-c", "core.quotePath=false", "diff", "--name-status", "-M",
        advice\diffRange(base, head: head)], dir: ".", opts: {"quiet": true, "allow_failure": true}).stdout;
    final moved = moves(status);
    var found = [<Finding>];
    if (moved.len() > 0) {
        final atBase = mut [<Job>];
        final atHead = mut [<Job>];
        foreach (path in workflowPaths(base)) {
            final shown = proc\exec("git", args: ["show", "origin/" + base + ":" + path],
                dir: ".", opts: {"quiet": true, "allow_failure": true});
            foreach (j in readJobs(path, text: shown.stdout, base: base)) { atBase.append(j); }
            final current = fs\readFile(path) catch "";
            foreach (j in readJobs(path, text: current, base: base)) { atHead.append(j); }
        }
        found = findings(atBase, head: atHead, moved: moved);
    }
    advice\publish(repo, pr: pr, name: section, title: title(found), body: body(found, base: base));
    std\print("trusted-script-moved: {found.len()} finding(s) over {moved.len()} rename(s) and delete(s)");
}

// queue is this repository's queue-advice.yaml, cut to what the advisor reads.
fun queue(script: str) > str {
    return "on:\n  pull_request:\n    types: [opened]\njobs:\n  dashboard:\n    name: queue dashboard\n"
        + "    steps:\n      - uses: actions/checkout@v4\n        with:\n"
        + "          ref: $\{\{ github.event.repository.default_branch }}\n"
        + "      - run: magus buzz " + script + " -- dashboard --all --base \"$MAIN\"\n";
}

final queue_path = ".github/workflows/queue-advice.yaml";

fun run(base: str, head: str, moved: [Moved]) > [Finding] !> any {
    return findings(jobs(queue_path, text: base, base: "main"),
        head: jobs(queue_path, text: head, base: "main"), moved: moved);
}

test "moving a script a trusted job runs names the job and when it recovers" {
    final moved = moves("R097\thack/pull-requests.buzz\thack/ci/pull-requests.buzz\n");
    final found = run(queue("hack/pull-requests.buzz"), head: queue("hack/ci/pull-requests.buzz"), moved: moved);
    assert\equal(found.len(), want: 1, message: "one finding");
    std\assert(!found[0].broken, message: "recovers once merged");
    assert\equal(body(found, base: "main"),
        want: "This pull request moves `hack/pull-requests.buzz` to `hack/ci/pull-requests.buzz`. "
            + "The `queue dashboard` job (`.github/workflows/queue-advice.yaml`) checks out `main` "
            + "and runs its copy, which has no `hack/ci/pull-requests.buzz` yet, so it skips or fails "
            + "on this pull request and passes again once this merges.",
        message: "the comment");
}

test "an unrelated rename is silent" {
    final moved = moves("R100\thack/labels.buzz\thack/ci/labels.buzz\n");
    final found = run(queue("hack/pull-requests.buzz"), head: queue("hack/pull-requests.buzz"), moved: moved);
    assert\equal(found.len(), want: 0, message: "the job runs nothing that moved");
}

test "a script only an untrusted job runs is silent" {
    final untrusted = "on: pull_request\njobs:\n  test:\n    steps:\n      - uses: actions/checkout@v4\n"
        + "      - run: ./hack/test.sh\n";
    final moved = moves("R100\thack/test.sh\thack/ci/test.sh\n");
    final found = run(untrusted, head: untrusted.replace("hack/test.sh", with: "hack/ci/test.sh"), moved: moved);
    assert\equal(found.len(), want: 0, message: "a job checking out the pull request runs its own copy");
}

test "deleting a script a trusted job still runs says it fails after the merge" {
    final moved = moves("D\thack/pull-requests.buzz\n");
    final found = run(queue("hack/pull-requests.buzz"), head: queue("hack/pull-requests.buzz"), moved: moved);
    assert\equal(found.len(), want: 1, message: "one finding");
    std\assert(found[0].broken, message: "broken after the merge");
    final text = body(found, base: "main");
    std\assert(text.indexOf("deletes `hack/pull-requests.buzz`") != null, message: "names the file");
    std\assert(text.indexOf("once this merges it fails on every run") != null, message: "says when it fails");
    assert\equal(title(found), want: "A trusted job fails after this merges", message: "the title");
}

test "a move the workflow does not follow fails after the merge" {
    final moved = moves("R100\thack/pull-requests.buzz\thack/ci/pull-requests.buzz\n");
    final found = run(queue("hack/pull-requests.buzz"), head: queue("hack/pull-requests.buzz"), moved: moved);
    assert\equal(found.len(), want: 1, message: "one finding");
    std\assert(found[0].broken, message: "the workflow still names the old path");
}

test "a workflow with no default-branch checkout is silent" {
    final pinned = "on: pull_request\njobs:\n  x:\n    steps:\n      - uses: actions/checkout@v4\n"
        + "        with:\n          ref: $\{\{ github.event.pull_request.head.sha }}\n"
        + "      - run: magus buzz hack/pull-requests.buzz\n";
    final moved = moves("D\thack/pull-requests.buzz\n");
    assert\equal(run(pinned, head: pinned, moved: moved).len(), want: 0, message: "checks out the pull request");
}

test "checksOutDefault reads the expression in any spacing and the branch spelled out" {
    std\assert(checksOutDefault("$\{\{github.event.repository.default_branch}}", base: "main"), message: "tight");
    std\assert(checksOutDefault("main", base: "main"), message: "spelled out");
    std\assert(!checksOutDefault("", base: "main"), message: "no ref is the pull request");
}

test "runWords drops quotes, operators and a leading ./" {
    assert\equal(runWords("./hack/a.sh && bash 'hack/b.sh'; x|y").join(","),
        want: "hack/a.sh,bash,hack/b.sh,x,y", message: "words");
}
