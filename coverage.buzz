// coverage filters a Go coverage profile down to hand-written code before the
// percentage is computed, so the number the badge shows and the floor gates on
// means "how much of the code we wrote is tested".
//
// Without this the total is dominated by generated code. This repo compiles ~700
// generated functions (protobuf message accessors, Connect clients, mockery
// mocks, the Buzz object mirrors) that no hand-written test will ever call, and
// every one counts against the total. That pushes the real figure down and, worse,
// creates an incentive to write tests for protobuf getters to defend the floor -
// coverage theatre that verifies nothing.
//
// Detection uses Go's canonical marker (https://golang.org/s/generatedcode):
//
//     // Code generated by <tool>. DO NOT EDIT.
//
// NOT the file's path. A path rule is wrong in this very repo:
// internal/interp/bindings/gen/modules.go and runtime.go live in a gen/ directory
// and are hand-maintained on purpose, each saying so in its header. Excluding
// them by directory would hide real untested code, which is the opposite of what
// this is for. The marker is a per-file fact; the directory is a convention with
// exceptions.

import "fs";
import "std";
import "assert";

// GENERATED_PREFIX and GENERATED_SUFFIX bracket the canonical marker. Matched as
// a prefix/suffix pair rather than a fixed string because the tool name in the
// middle varies (protoc-gen-go, mockery, magus-utils, ...).
final GENERATED_PREFIX = "// Code generated ";
final GENERATED_SUFFIX = "DO NOT EDIT.";

// modulePath reads the module path from a go.mod body. A coverage profile names
// files by import path, so this is what maps them back onto disk - derived rather
// than hardcoded so a module rename cannot silently disable the filter.
export fun modulePath(gomod: str) > str !> str {
    foreach (line in gomod.split("\n")) {
        if (line.startsWith("module ")) {
            return line.split(" ")[1].trim();
        }
    }
    throw "coverage: go.mod has no module line";
}

// isGeneratedSource reports whether a Go source body carries the marker.
//
// The scan stops at the package clause: the convention places the marker in the
// header, and stopping there keeps a passing mention of the phrase in ordinary
// code (a comment ABOUT generated files, of which this repo has several) from
// silently excluding a hand-written file from coverage.
export fun isGeneratedSource(body: str) > bool {
    foreach (line in body.split("\n")) {
        final t = line.trim();
        if (t.startsWith(GENERATED_PREFIX) and t.endsWith(GENERATED_SUFFIX)) {
            return true;
        }
        if (t.startsWith("package ")) {
            return false;
        }
    }
    return false;
}

// stripGenerated removes every coverage block belonging to a generated file.
//
// It rewrites the PROFILE rather than filtering `go tool cover -func` output,
// because the percentage is a ratio of statements: dropping lines from the
// rendered report and re-averaging the per-function percentages would weight a
// one-statement function the same as a hundred-statement one. Keeping the profile
// as the unit means `go tool cover` still computes the total, and it stays exact.
//
// prefix is the module path plus a trailing slash; each profile line begins with
// an import path, so removing it yields a workspace-relative file.
export fun stripGenerated(profile: str, prefix: str) > str {
    // Collect into a LIST and join once. `kept = kept + line` looks harmless and is
    // catastrophic here: every concatenation allocates a whole new string, and this
    // VM's heap is append-only - "objects are never removed (pinned for the process
    // lifetime)", see vm/value_nanbox.go - so each intermediate survives to the end
    // of the run. Over this repo's own 30,803-line profile that pattern measured a
    // 13.1GB peak to produce 2.1MB of output, which is precisely what was killing a
    // 16GB CI runner with no failing target to blame.
    //
    // A list appends a reference per line and joins once, so the intermediates never
    // exist. Same output, bounded memory.
    var kept = mut [<str>];
    var verdict = mut {};
    foreach (line in profile.split("\n")) {
        if (line == "") { continue; }
        // The mode: header is required by the format and belongs to no file.
        if (line.startsWith("mode:")) { kept.append(line); continue; }

        final file = line.split(":")[0];
        if (verdict[file] == null) {
            final rel = if (file.startsWith(prefix)) file.sub(prefix.len()) else file;
            // A file the profile names but the tree does not have is kept: an
            // unreadable path is not evidence that it was generated, and silently
            // dropping it would understate the denominator.
            verdict[file] = if (fs\exists(rel)) isGeneratedSource(fs\readFile(rel)) else false;
        }
        if (verdict[file] == false) { kept.append(line); }
    }
    // Trailing newline preserved: the profile format expects every record line
    // terminated, and join alone would drop the last one.
    if (kept.len() == 0) { return ""; }
    return kept.join("\n") + "\n";
}

// lcovPercent totals LINE coverage across every lcov record whose source file
// path contains keep, as a one-decimal percentage string ("85.7") - the shape
// badge.coverage renders.
//
// lcov rather than Node's printed table: the table is a display format that has
// changed shape across Node releases, while LF/LH are counts. Summing counts and
// dividing once is also the only correct way to combine files - averaging their
// per-file percentages would weight a three-line module the same as a
// three-hundred-line one.
//
// keep exists because the tests run against esbuild bundles in .testcache. With
// sourcemaps the records point back at src/*.ts, but the bundles and anything
// under node_modules still appear; filtering on the source path keeps the figure
// about code someone wrote. keepsSource below is that filter.

// keepsSource decides whether one lcov SF: path counts toward the figure.
//
// Anchored at a path boundary, both forms: node:test writes paths relative to the cwd
// ("src/foo.ts") while other producers write absolute ones ("/w/src/foo.ts"). A bare substring
// test would also match "vendor/notsrc/...".
//
// node_modules is excluded FIRST and separately, because the boundary anchor alone does not
// exclude it: a dependency that ships its own src/ directory gives "/node_modules/x/src/y.js",
// which contains "/src/" and so passed the anchor test. The comment here claimed that case was
// covered for a while before a test went looking for it - the existing one only ever tried
// "node_modules/x/index.js", which has no src/ in it and would pass either way.
fun keepsSource(sf: str, keep: str) > bool {
    if (sf.indexOf("/node_modules/") != null or sf.startsWith("node_modules/")) { return false; }
    return sf.startsWith(keep) or sf.indexOf("/" + keep) != null;
}

export fun lcovPercent(lcov: str, keep: str) > str !> str {
    var found = 0;
    var hit = 0;
    var counting = false;
    foreach (line in lcov.split("\n")) {
        if (line.startsWith("SF:")) {
            counting = keepsSource(line.sub(3).trim(), keep: keep);
            continue;
        }
        if (!counting) { continue; }
        if (line.startsWith("LF:")) { found = found + std\parseInt(line.sub(3).trim()) ?? 0; }
        if (line.startsWith("LH:")) { hit = hit + std\parseInt(line.sub(3).trim()) ?? 0; }
    }
    if (found == 0) {
        throw "coverage: lcov report has no lines under \"" + keep + "\"; did the sourcemaps resolve?";
    }
    // Integer math throughout: a rounded tenth rendered by hand avoids depending
    // on float formatting for a string that ends up in a committed SVG.
    final tenths = (hit * 1000 + found / 2) / found;
    return "{tenths / 10}.{tenths % 10}";
}

// lcovMergePercent is lcovPercent over SEVERAL lcov reports of the same sources.
//
// It exists because a project whose tests run in more than one process gets one report per
// process, and those reports OVERLAP: every process that imports a shared module reports that
// module's whole line table, so summing their LF/LH counts that file once per process. The
// figure comes out looking like a weighted average of how many processes happened to touch
// each file, which is not a fact about anything.
//
// So the merge is at LINE level, over DA: records (DA:<line>,<hits>), not at the LF/LH
// summary. A line is FOUND if any report mentions it and HIT if any report ran it - a union,
// because the processes are covering one body of code between them, not sampling it. LF/LH
// are then recomputed from the union rather than trusted from the inputs.
//
// keep filters by source path exactly as lcovPercent does, and for the same reason.
export fun lcovMergePercent(reports: [str], keep: str) > str !> str {
    // "<file>\u{0}<line>" -> was it ever hit. One flat map rather than a map of maps: the key
    // only has to be unique per (file, line), and \0 cannot appear in either half.
    var lines = mut {<str: bool>};
    foreach (lcov in reports) {
        var sf = "";
        var counting = false;
        foreach (line in lcov.split("\n")) {
            if (line.startsWith("SF:")) {
                sf = line.sub(3).trim();
                counting = keepsSource(sf, keep: keep);
                continue;
            }
            if (!counting) { continue; }
            if (!line.startsWith("DA:")) { continue; }
            final parts = line.sub(3).trim().split(",");
            if (parts.len() < 2) { continue; }
            final key = sf + "\0" + parts[0];
            final hit = (std\parseInt(parts[1]) ?? 0) > 0;
            // Union: once hit, always hit. A later report that did not exercise the line must
            // not un-hit what an earlier one covered.
            lines[key] = hit or (lines[key] ?? false);
        }
    }
    var found = 0;
    var hit = 0;
    foreach (_, wasHit in lines) {
        found = found + 1;
        if (wasHit) { hit = hit + 1; }
    }
    if (found == 0) {
        throw "coverage: merged lcov reports have no DA records under \"" + keep + "\"; did the sourcemaps resolve?";
    }
    final tenths = (hit * 1000 + found / 2) / found;
    return "{tenths / 10}.{tenths % 10}";
}

test "lcovMergePercent unions overlapping reports instead of double counting" {
    // The same file reported by two processes. Summing LF/LH would call this 4 lines found
    // and 3 hit (75%); the file actually has 2 lines and both are covered between the runs.
    final a = "SF:/w/src/shared.ts\nDA:1,1\nDA:2,0\nLF:2\nLH:1\nend_of_record\n";
    final b = "SF:/w/src/shared.ts\nDA:1,0\nDA:2,5\nLF:2\nLH:1\nend_of_record\n";
    std\assert(lcovMergePercent([a, b], keep: "src/") == "100.0",
        message: "a line hit in either report is hit");
}

test "lcovMergePercent counts a line found in every report exactly once" {
    final a = "SF:/w/src/a.ts\nDA:1,1\nDA:2,0\nend_of_record\n";
    final b = "SF:/w/src/a.ts\nDA:1,1\nDA:2,0\nend_of_record\n";
    // 2 distinct lines, 1 hit -> 50.0, NOT 4 lines / 2 hit dressed up as the same ratio by luck.
    std\assert(lcovMergePercent([a, b], keep: "src/") == "50.0", message: "50.0");
}

test "lcovMergePercent keeps distinct files apart" {
    final a = "SF:/w/src/a.ts\nDA:1,1\nend_of_record\nSF:/w/src/b.ts\nDA:1,0\nend_of_record\n";
    std\assert(lcovMergePercent([a], keep: "src/") == "50.0", message: "one of two lines hit");
}

test "lcovMergePercent ignores records outside the kept path" {
    final a = "SF:/w/node_modules/x/src/y.js\nDA:1,0\nend_of_record\n"
        + "SF:/w/src/a.ts\nDA:1,1\nend_of_record\n";
    std\assert(lcovMergePercent([a], keep: "src/") == "100.0", message: "node_modules excluded");
}

test "lcovMergePercent refuses reports with no kept records rather than reporting zero" {
    var threw = false;
    try {
        _ = lcovMergePercent(["SF:/w/vendor/a.js\nDA:1,1\nend_of_record\n"], keep: "src/");
    } catch (_: str) {
        threw = true;
    }
    std\assert(threw, message: "an empty merge is a setup failure, not 0%");
}

test "lcovPercent totals counts rather than averaging per-file percentages" {
    // 1/1 in a tiny file and 1/9 in a big one is 20%, not the 55.6% an average gives.
    final lcov = "SF:/w/src/small.ts\nLF:1\nLH:1\nend_of_record\n"
        + "SF:/w/src/big.ts\nLF:9\nLH:1\nend_of_record\n";
    assert\equal(lcovPercent(lcov, keep: "src/"), want: "20.0", message: "summed, not averaged");
}

test "lcovPercent ignores records outside the kept path" {
    final lcov = "SF:/w/src/a.ts\nLF:4\nLH:3\nend_of_record\n"
        + "SF:/w/node_modules/x/index.js\nLF:100\nLH:0\nend_of_record\n"
        + "SF:/w/.testcache/a.test.js\nLF:50\nLH:50\nend_of_record\n";
    assert\equal(lcovPercent(lcov, keep: "src/"), want: "75.0", message: "only src counted");
}

test "lcovPercent rounds to one decimal" {
    assert\equal(lcovPercent("SF:/w/src/a.ts\nLF:3\nLH:2\nend_of_record\n", keep: "src/"),
        want: "66.7", message: "2 of 3 rounds up");
}

test "lcovPercent refuses an empty report rather than reporting zero" {
    // Reporting 0.0% here would look like a real regression; the actual cause is a
    // report with nothing under src, which almost always means sourcemaps did not
    // resolve and every record still points at the bundle.
    assert\throws(fun () > void !> str { final _ = lcovPercent("SF:other/a.js\nLF:2\nLH:1\nend_of_record\n", keep: "src/"); },
        message: "empty selection errors");
}

test "modulePath reads the module line" {
    assert\equal(modulePath("module github.com/egladman/magus\n\ngo 1.25\n"), want: "github.com/egladman/magus", message: "module path");
}

test "isGeneratedSource accepts the canonical marker whatever the tool" {
    assert\equal(isGeneratedSource("// Code generated by protoc-gen-go. DO NOT EDIT.\n\npackage v1\n"), want: true, message: "protoc");
    assert\equal(isGeneratedSource("// Code generated by magus-utils types. DO NOT EDIT.\npackage types\n"), want: true, message: "magus-utils");
}

test "isGeneratedSource ignores the phrase once the package clause is passed" {
    // A hand-written file that merely TALKS about generated code stays counted.
    final body = "// Handles output trees.\npackage cache\n\n"
        + "// Never hand-edit a file whose header says: Code generated by x. DO NOT EDIT.\n";
    assert\equal(isGeneratedSource(body), want: false, message: "mention below the package clause");
}

test "isGeneratedSource does not exclude a hand-maintained file in a gen dir" {
    // internal/interp/bindings/gen/modules.go, verbatim in shape: a gen/ path that
    // is deliberately hand-written. Path-based filtering would drop it.
    final body = "//go:build !wasm\n\npackage gen\n\n"
        + "// This file is hand-maintained (not generated).\n";
    assert\equal(isGeneratedSource(body), want: false, message: "hand-maintained gen/ file");
}

test "stripGenerated keeps the mode header and drops nothing when nothing is generated" {
    final profile = "mode: atomic\nexample.com/m/nope.go:1.1,2.2 1 1\n";
    // nope.go does not exist on disk, so it is kept rather than assumed generated.
    assert\equal(stripGenerated(profile, prefix: "example.com/m/"), want: profile, message: "unknown file kept");
}

test "stripGenerated removes a real generated file and keeps a real hand-written one" {
    final gen = "github.com/egladman/magus/types/buzzobject_gen.go:1.1,2.2 1 1";
    final hand = "github.com/egladman/magus/coverage.buzz.go:1.1,2.2 1 1";
    final src = "github.com/egladman/magus/magus.go:1.1,2.2 1 1";
    final profile = "mode: atomic\n" + gen + "\n" + src + "\n" + hand + "\n";

    final got = stripGenerated(profile, prefix: "github.com/egladman/magus/");

    assert\equal(got.indexOf("buzzobject_gen.go") == null, want: true, message: "generated block dropped");
    assert\equal(got.indexOf("magus.go") != null, want: true, message: "hand-written block kept");
    assert\equal(got.startsWith("mode: atomic\n"), want: true, message: "mode header preserved");
}
