// releaser is the version-selection machinery behind the root magusfile's
// `release` target: which modules version independently, what each is at now,
// what it may legally move to next, and the one manifest edit a Go release needs.
//
// A sibling module rather than part of magusfile.buzz because none of this is
// magus's build - it is a body of rules about semantic versioning that the build
// merely calls. Named `releaser`, not `release`, because a target of the same name
// SHADOWS an import and nulls its members. The importer must also ALIAS it: an
// unaliased import flat-merges these exports into the magusfile's scope, where
// magus reads every exported fun as a target and rejects one whose first parameter
// is not a magus\Context (MGS1008). Both hazards are why docs/magusfile.buzz
// imports its sibling SSG as `renderer`.
//
// Everything here COMPUTES; nothing decides. Choosing which of the three candidate
// versions a change deserves is a judgement about what breaks for a consumer, and
// that belongs to a human. See the `release` target for the policy that uses these.
import "vcs";
import "semver";
import "std"; // assert, for the in-file test blocks below

// releasableModules enumerates every independently-versioned project: one whose
// resolved spells declare a manifest (spells.Spell.Manifests, the language's
// go.mod/package.json/Cargo.toml/pyproject.toml equivalent) that is actually
// present in its directory - types.ProjectEntry.Manifests, read by the caller via
// magus\ls() and passed in as projects, already did the "does the candidate file
// exist" filesystem check. Taking the inventory as a parameter rather than calling
// magus\ls() itself keeps this module doing what its header promises - COMPUTING,
// not reading the workspace - and releaser.buzz has no reason to import "magus"
// only to hand every entry straight to a foreach.
//
// Declaration beats inference here because inference already guessed wrong
// twice. A `libs/` location rule missed every independently-versioned project
// OUTSIDE libs/ (console, docs each ship their own package.json) - being visible
// and unreleased is a fact a human can act on, being invisible is not. npm's
// "private" flag was tried next and is wrong for a different reason: private is a
// PUBLISH flag (don't push to a registry), not a version flag - a private
// package.json still carries a real version that can drift out of sync with the
// rest of the workspace, so filtering on it silently dropped projects that DO
// version, they just don't publish. This target reports what CARRIES A VERSION;
// the human still decides what to actually release.
//
// key/prefix mirror what Go requires of a nested module's tags, and work just as
// well for the others: the root releases as `vX.Y.Z`, a project at libs/foo as
// `libs/foo/vX.Y.Z`. key is the same string a human types, so what you name is
// exactly what gets tagged.
//
// gomodule is the Go module path when the RESOLVED manifest (manifests[0], the
// first candidate present - see spells.Spell.Manifests's ordering contract) is
// go.mod, "" otherwise. It decides whether releasing a project also has to
// repoint the root's go.mod - a non-Go project is tag-only, because nothing in
// go.mod requires it.
export fun releasableModules(projects: [any]) > [{str: str}] {
    // projects is [any], not [ProjectEntry]: releaser.buzz imports no "magus" (see
    // header), so it has no way to name that type, and reads each entry by bracket
    // key instead of dot field the way this file's own {str: str} records already do.
    var mods = mut [];
    foreach (p in projects) {
        final manifests = p["manifests"];
        if (manifests.len() == 0) { continue; } // no manifest present: not independently versioned
        final path = "" + p["path"];
        final isRoot = path == ".";
        final manifest = manifests[0]; // first-existing-file-wins
        var gomodule = "";
        // The root's own go.mod is never repointed to itself; gomodule only
        // matters for a NESTED module the root's go.mod can require.
        if (manifest == "go.mod" and !isRoot) {
            gomodule = "github.com/egladman/magus/" + path;
        }
        var key = path;
        var prefix = path + "/";
        var root = "";
        if (isRoot) {
            key = "magus";
            prefix = "";
            root = "yes";
        }
        mods.append({"key": key, "prefix": prefix, "gomodule": gomodule,
                     "dir": path, "root": root});
    }
    return mods;
}

// currentVersion returns a module's highest STABLE released version, or "" when
// it has never had one. Compared on the PARSED major/minor/patch, not the tag
// text, because string order puts v0.10.0 before v0.9.0.
//
// Prereleases are skipped: per semver.org item 9 a prerelease has LOWER
// precedence than the version it anticipates, so v0.4.0-rc1 is emphatically not
// v0.4.0 released and must not become the base the next version is computed from
// - otherwise cutting rc1 would silently advance everyone's floor.
//
// Build metadata does NOT disqualify a tag. Item 10 says metadata is ignored when
// determining precedence, so v1.0.0+ci42 IS v1.0.0; excluding it would re-offer a
// version already released.
export fun currentVersion(prefix: str) > str !> any {
    var best = "";
    var bestMajor = 0 - 1;
    var bestMinor = 0 - 1;
    var bestPatch = 0 - 1;
    foreach (t in vcs\tags(pattern: prefix + "v*")) {
        // A bare "v*" also matches libs/foo/v1.2.3, so the prefix is checked
        // exactly - otherwise the root would adopt a nested module's tag.
        if (t.prefix != prefix) { continue; }
        if (t.version.original == "") { continue; } // an annotated non-version tag
        if (t.version.prerelease != "") { continue; } // anticipates a release, is not one
        final newer = t.version.major > bestMajor
            or (t.version.major == bestMajor and t.version.minor > bestMinor)
            or (t.version.major == bestMajor and t.version.minor == bestMinor
                and t.version.patch > bestPatch);
        if (newer) {
            bestMajor = t.version.major;
            bestMinor = t.version.minor;
            bestPatch = t.version.patch;
            best = t.version.original;
        }
    }
    return best;
}

// nextFor returns the three legal next versions for a module currently at cur.
// An unreleased module is treated as sitting at 0.0.0, so its candidates fall out
// of the same rule as everyone else's (0.0.1 | 0.1.0 | 1.0.0) rather than being a
// special case someone has to remember.
export fun nextFor(cur: str) > SemverNext !> any {
    if (cur == "") { return semver\next("0.0.0"); }
    return semver\next(cur);
}

// isCandidate reports whether v is one of the three versions nextFor offers,
// comparing the RELEASE part only - so v0.4.0-rc1 and v0.4.0+ci both count as the
// minor candidate. A prerelease of a legal next version is itself legal; that is
// how you cut an rc without first inventing a version nobody agreed to.
export fun isCandidate(v: str, cur: str) > bool !> any {
    final want = semver\parse(v);
    final n = nextFor(cur);
    foreach (c in [n.patch, n.minor, n.major]) {
        final cv = semver\parse(c);
        if (cv.major == want.major and cv.minor == want.minor and cv.patch == want.patch) {
            return true;
        }
    }
    return false;
}

// rewriteRequire points go.mod's require for module at version, preserving the
// line's indentation. The `replace` directive names the same module and must NOT
// be touched: it is the local-development path, ignored by every downstream
// consumer, and rewriting it would break building inside this repo.
// modulePath returns the path go.mod declares, or "" when it declares none.
//
// Needed for Go's major-version suffix rule, which applies to the path: from v2 on
// it must end in /vN, so a v2.0.0 tag beside a go.mod still naming the v1 path is
// uninstallable. The tag alone cannot tell you that.
export fun modulePath(gomod: str) > str {
    foreach (line in gomod.split("\n")) {
        // .trim(), because go.mod permits any run of whitespace after the keyword and
        // a bare sub() keeps it: `module  path` yielded a leading space here. Same
        // parse as coverage.buzz's modulePath, which must agree with this one.
        if (line.startsWith("module ")) { return line.sub("module ".len()).trim(); }
    }
    return "";
}

// needsMajorSuffix reports whether releasing major from the module at path would
// publish a tag Go cannot resolve.
//
// From v2 on, Go wants the path to end in /vN, and `go get` resolves the path. A
// v2.0.0 tag beside a go.mod naming the v1 path is uninstallable, and semver has
// no opinion, so the survey offers that candidate like any other. A non-Go module
// passes "" and never hits the rule.
export fun needsMajorSuffix(path: str, major: int) > bool {
    if (path == "" or major < 2) { return false; }
    return !path.endsWith("/v" + major);
}

test "the major suffix rule starts at v2 and only for Go modules" {
    std\assert(needsMajorSuffix("example.com/m", major: 2), message: "v2 without a suffix is refused");
    std\assert(!needsMajorSuffix("example.com/m/v2", major: 2), message: "v2 with the suffix is fine");
    std\assert(needsMajorSuffix("example.com/m/v2", major: 3), message: "a stale suffix is refused");
    std\assert(!needsMajorSuffix("example.com/m", major: 1), message: "v1 has no suffix rule");
    std\assert(!needsMajorSuffix("example.com/m", major: 0), message: "v0 has no suffix rule");
    std\assert(!needsMajorSuffix("", major: 4), message: "a non-Go module is never subject to it");
}

test "reads the module path and ignores a require of a similar name" {
    final gomod = "module example.com/root\n\ngo 1.26\n\nrequire (\n\tmodule-ish/x v1.0.0\n)\n";
    std\assert(modulePath(gomod) == "example.com/root", message: "declared path");
    std\assert(modulePath("go 1.26\n") == "", message: "no module line");
    // Same case coverage.buzz pins: a bare sub() kept the extra space here, so the two
    // parsers disagreed on a legal go.mod.
    std\assert(modulePath("module  example.com/root\n") == "example.com/root", message: "two spaces after the keyword");
}

export fun rewriteRequire(gomod: str, module: str, version: str) > str {
    var kept = mut [];
    var found = false;
    foreach (line in gomod.split("\n")) {
        final at = line.indexOf(module + " v");
        if (at != null and line.indexOf("=>") == null) {
            kept.append(line.sub(0, at) + module + " " + version);
            found = true;
        } else {
            kept.append(line);
        }
    }
    if (!found) { throw "release: go.mod has no require line for " + module; }
    return kept.join("\n");
}
