// releaser is the version-selection machinery behind the root magusfile's
// `release` target: which modules version independently, what each is at now,
// what it may legally move to next, and the one manifest edit a Go release needs.
//
// A sibling module rather than part of magusfile.buzz because none of this is
// magus's build - it is a body of rules about semantic versioning that the build
// merely calls. Named `releaser`, not `release`, because a target of the same name
// SHADOWS an import and nulls its members. The importer must also ALIAS it: an
// unaliased import flat-merges these exports into the magusfile's scope, where
// magus reads every exported fun as a target and rejects one whose first parameter
// is not a magus\Context (MGS1008). Both hazards are why docs/magusfile.buzz
// imports its sibling SSG as `renderer`.
//
// Everything here COMPUTES; nothing decides. Choosing which of the three candidate
// versions a change deserves is a judgement about what breaks for a consumer, and
// that belongs to a human. See the `release` target for the policy that uses these.
import "fs";
import "vcs";
import "semver";

// releasableModules enumerates every independently-versioned module: the root,
// plus each libs/<name> carrying its own go.mod. Discovered rather than listed,
// so a new nested module is picked up the moment it gets one.
//
// prefix is what Go requires of a nested module's tags: the root releases as
// `vX.Y.Z`, a module at libs/foo as `libs/foo/vX.Y.Z`. key is the same string a
// human types, so what you name is exactly what gets tagged.
export fun releasableModules() > [{str: str}] {
    var mods = mut [{"key": "magus", "prefix": "", "module": "", "dir": "."}];
    foreach (gomod in fs\glob("libs/*/go.mod")) {
        final dir = fs\dirname(gomod);
        mods.append({"key": dir, "prefix": dir + "/",
                    "module": "github.com/egladman/magus/" + dir, "dir": dir});
    }
    return mods;
}

// currentVersion returns a module's highest STABLE released version, or "" when
// it has never had one. Compared on the PARSED major/minor/patch, not the tag
// text, because string order puts v0.10.0 before v0.9.0.
//
// Prereleases are skipped: per semver.org item 9 a prerelease has LOWER
// precedence than the version it anticipates, so v0.4.0-rc1 is emphatically not
// v0.4.0 released and must not become the base the next version is computed from
// - otherwise cutting rc1 would silently advance everyone's floor.
//
// Build metadata does NOT disqualify a tag. Item 10 says metadata is ignored when
// determining precedence, so v1.0.0+ci42 IS v1.0.0; excluding it would re-offer a
// version already released.
export fun currentVersion(prefix: str) > str {
    var best = "";
    var bestMajor = 0 - 1;
    var bestMinor = 0 - 1;
    var bestPatch = 0 - 1;
    foreach (t in vcs\tags(pattern: prefix + "v*")) {
        // A bare "v*" also matches libs/foo/v1.2.3, so the prefix is checked
        // exactly - otherwise the root would adopt a nested module's tag.
        if (t.prefix != prefix) { continue; }
        if (t.version.original == "") { continue; } // an annotated non-version tag
        if (t.version.prerelease != "") { continue; } // anticipates a release, is not one
        final newer = t.version.major > bestMajor
            or (t.version.major == bestMajor and t.version.minor > bestMinor)
            or (t.version.major == bestMajor and t.version.minor == bestMinor
                and t.version.patch > bestPatch);
        if (newer) {
            bestMajor = t.version.major;
            bestMinor = t.version.minor;
            bestPatch = t.version.patch;
            best = t.version.original;
        }
    }
    return best;
}

// nextFor returns the three legal next versions for a module currently at cur.
// An unreleased module is treated as sitting at 0.0.0, so its candidates fall out
// of the same rule as everyone else's (0.0.1 | 0.1.0 | 1.0.0) rather than being a
// special case someone has to remember.
export fun nextFor(cur: str) > SemverNext {
    if (cur == "") { return semver\next("0.0.0"); }
    return semver\next(cur);
}

// isCandidate reports whether v is one of the three versions nextFor offers,
// comparing the RELEASE part only - so v0.4.0-rc1 and v0.4.0+ci both count as the
// minor candidate. A prerelease of a legal next version is itself legal; that is
// how you cut an rc without first inventing a version nobody agreed to.
export fun isCandidate(v: str, cur: str) > bool {
    final want = semver\parse(v);
    final n = nextFor(cur);
    foreach (c in [n.patch, n.minor, n.major]) {
        final cv = semver\parse(c);
        if (cv.major == want.major and cv.minor == want.minor and cv.patch == want.patch) {
            return true;
        }
    }
    return false;
}

// rewriteRequire points go.mod's require for module at version, preserving the
// line's indentation. The `replace` directive names the same module and must NOT
// be touched: it is the local-development path, ignored by every downstream
// consumer, and rewriting it would break building inside this repo.
export fun rewriteRequire(gomod: str, module: str, version: str) > str {
    var kept = mut [];
    var found = false;
    foreach (line in gomod.split("\n")) {
        final at = line.indexOf(module + " v");
        if (at != null and line.indexOf("=>") == null) {
            kept.append(line.sub(0, at) + module + " " + version);
            found = true;
        } else {
            kept.append(line);
        }
    }
    if (!found) { throw "release: go.mod has no require line for " + module; }
    return kept.join("\n");
}
