// releaser is the version-selection machinery behind the root magusfile's
// `release` target: which modules version independently, what each is at now,
// what it may legally move to next, and the one manifest edit a Go release needs.
//
// A sibling module rather than part of magusfile.buzz because none of this is
// magus's build - it is a body of rules about semantic versioning that the build
// merely calls. Named `releaser`, not `release`, because a target of the same name
// SHADOWS an import and nulls its members. The importer must also ALIAS it: an
// unaliased import flat-merges these exports into the magusfile's scope, where
// magus reads every exported fun as a target and rejects one whose first parameter
// is not a magus\Context (MGS1008). Both hazards are why docs/magusfile.buzz
// imports its sibling SSG as `renderer`.
//
// Everything here COMPUTES; nothing decides. Choosing which of the three candidate
// versions a change deserves is a judgment about what breaks for a consumer, and
// that belongs to a human. See the `release` target for the policy that uses these.
import "vcs";
import "semver";
import "std"; // assert, for the in-file test blocks below

// releasableModules enumerates every independently-versioned project: one whose
// resolved spells declare a manifest (spells.Spell.Manifests, the language's
// go.mod/package.json/Cargo.toml/pyproject.toml equivalent) that is actually
// present in its directory - types.ProjectEntry.Manifests, read by the caller via
// magus\projects() and passed in as projects, already did the "does the candidate file
// exist" filesystem check. Taking the inventory as a parameter rather than calling
// magus\projects() itself keeps this module doing what its header promises - COMPUTING,
// not reading the workspace - and releaser.buzz has no reason to import "magus"
// only to hand every entry straight to a foreach.
//
// Declaration beats inference here because inference already guessed wrong
// twice. A `libs/` location rule missed every independently-versioned project
// OUTSIDE libs/ (console, docs each ship their own package.json) - being visible
// and unreleased is a fact a human can act on, being invisible is not. npm's
// "private" flag was tried next and is wrong for a different reason: private is a
// PUBLISH flag (don't push to a registry), not a version flag - a private
// package.json still carries a real version that can drift out of sync with the
// rest of the workspace, so filtering on it silently dropped projects that DO
// version, they just don't publish. This target reports what CARRIES A VERSION;
// the human still decides what to actually release.
//
// key/prefix mirror what Go requires of a nested module's tags, and work just as
// well for the others: the root releases as `vX.Y.Z`, a project at libs/foo as
// `libs/foo/vX.Y.Z`. key is the same string a human types, so what you name is
// exactly what gets tagged.
//
// gomodule is the Go module path when the RESOLVED manifest (manifests[0], the
// first candidate present - see spells.Spell.Manifests's ordering contract) is
// go.mod, "" otherwise. It decides whether releasing a project also has to
// repoint the root's go.mod - a non-Go project is tag-only, because nothing in
// go.mod requires it.
export fun releasableModules(projects: [any]) > [{str: str}] {
    // projects is [any], not [ProjectEntry]: releaser.buzz imports no "magus" (see
    // header), so it has no way to name that type, and reads each entry by bracket
    // key instead of dot field the way this file's own {str: str} records already do.
    var mods = mut [];
    foreach (p in projects) {
        final manifests = p["manifests"];
        if (manifests.len() == 0) { continue; } // no manifest present: not independently versioned
        final path = "{p["path"]}";
        final isRoot = path == ".";
        final manifest = manifests[0]; // first-existing-file-wins
        var gomodule = "";
        // The root's own go.mod is never repointed to itself; gomodule only
        // matters for a NESTED module the root's go.mod can require.
        if (manifest == "go.mod" and !isRoot) {
            gomodule = "github.com/egladman/magus/" + path;
        }
        var key = path;
        var prefix = path + "/";
        var root = "";
        if (isRoot) {
            key = "magus";
            prefix = "";
            root = "yes";
        }
        mods.append({"key": key, "prefix": prefix, "gomodule": gomodule,
                     "dir": path, "root": root});
    }
    return mods;
}

// isReleaseTag reports whether name is a ROOT release tag: "v" followed by a
// digit, with no module prefix.
//
// A `v*` refspec is not a version filter: this repository's `verified-refinements`
// tag matches the glob and has been read once as the current release. The "/" check
// makes the answer root-specific, so a caller handed the unfiltered tag list cannot
// take libs/gopherbuzz/v0.1.0 for the magus release beside it.
//
// A name shape rather than a semver parse, because parsing says what a tag means
// and this says which tags are eligible to be asked. docs/site/release.buzz keeps
// its own isVersionTag: self-contained on lib/text, it unit-tests inside the docs
// project.
export fun isReleaseTag(name: str) > bool {
    if (!name.startsWith("v")) { return false; }
    if (name.indexOf("/") != null) { return false; }
    if (name.len() < 2) { return false; }
    final b = name.byte(1);
    return b >= 48 and b <= 57;
}

test "isReleaseTag accepts root release tags and rejects the lookalikes" {
    std\assert(isReleaseTag("v0.4.0"), message: "a plain release tag");
    std\assert(isReleaseTag("v1.0.0-rc.1"), message: "a prerelease suffix");
    std\assert(!isReleaseTag("verified-refinements"), message: "the tag that caused this");
    std\assert(!isReleaseTag("vendor"), message: "a word starting with v");
    std\assert(!isReleaseTag("libs/gopherbuzz/v0.1.0"), message: "a nested module's tag is not the root's");
    std\assert(!isReleaseTag("0.4.0"), message: "no leading v");
    std\assert(!isReleaseTag("v"), message: "nothing after the v");
    std\assert(!isReleaseTag(""), message: "the empty name");
}

// rootReleaseTag returns the first ROOT release tag in names, or "" when none is there.
// isReleaseTag rejects a "/", so no separate prefix filter is needed.
//
// Shared by the magusfile's exact_release_tag and by the release preflight, which asks
// what version a commit would stamp once tags exist that do not yet. A second
// implementation of the rule could drift from this one.
export fun rootReleaseTag(names: [str]) > str {
    foreach (n in names) {
        if (isReleaseTag(n)) { return n; }
    }
    return "";
}

test "the root release tag is picked out of a mixed tag set" {
    std\assert(rootReleaseTag(["libs/diagnostics/v0.1.0", "v0.4.0"]) == "v0.4.0",
        message: "the root tag wins over a namespaced one at any position");
    std\assert(rootReleaseTag(["libs/diagnostics/v0.1.0"]) == "",
        message: "a library-only release stamps no root version");
    std\assert(rootReleaseTag(["verified-refinements", "v1.0.0"]) == "v1.0.0",
        message: "a `v*` lookalike is not a release tag");
    std\assert(rootReleaseTag([<str>]) == "", message: "an untagged commit");
}

// matchesGlob reports whether name matches pattern, where a single "*" stands for any run
// of characters that does not cross "/".
//
// The "/" restriction is the semantics of both the shell glob release.yaml's upload step
// expands and the ref filter its `v*` tag trigger applies, and it is what a version
// carrying a "/" violates: the v0.4.0 assets were named
// magus_libs/diagnostics/v0.1.0_<os>_<arch>.tar.gz, real files under
// dist/magus_libs/diagnostics/ that dist/magus_*.tar.gz could not see. A prefix/suffix
// test calls that a match.
//
// One star, because both patterns this checks have one. A starless pattern is an equality
// test; a second star raises rather than being read as a literal.
export fun matchesGlob(pattern: str, name: str) > bool !> any {
    final star = pattern.indexOf("*");
    if (star == null) { return pattern == name; }
    final head = pattern.sub(0, star);
    final tail = pattern.sub(star + 1);
    if (tail.indexOf("*") != null) {
        throw "matchesGlob: `" + pattern + "` has more than one `*`, which this matcher does not model";
    }
    if (name.len() < head.len() + tail.len()) { return false; }
    if (!name.startsWith(head)) { return false; }
    if (!name.endsWith(tail)) { return false; }
    return name.sub(head.len(), len: name.len() - head.len() - tail.len()).indexOf("/") == null;
}

test "a glob star stays inside one path segment" {
    std\assert(matchesGlob("dist/magus_*.tar.gz", "dist/magus_v0.4.0_linux_amd64_static.tar.gz"),
        message: "the name a healthy release writes");
    std\assert(!matchesGlob("dist/magus_*.tar.gz",
        "dist/magus_libs/diagnostics/v0.1.0_linux_amd64_static.tar.gz"),
        message: "the name the v0.4.0 release wrote, which the upload never found");
    std\assert(!matchesGlob("dist/magus_*.tar.gz", "dist/SHA256SUMS"), message: "a different asset");
    std\assert(!matchesGlob("dist/magus_*.tar.gz", "dist/magus_.tar.gz.other"), message: "trailing text");
    std\assert(matchesGlob("dist/magus_*.tar.gz", "dist/magus_.tar.gz"), message: "an empty star");
    std\assert(matchesGlob("v*", "v0.4.0"), message: "the workflow's tag trigger");
    std\assert(!matchesGlob("v*", "libs/gopherbuzz/v0.1.0"), message: "a nested tag starts no release run");
    std\assert(matchesGlob("exact", "exact"), message: "a starless pattern is equality");
    std\assert(!matchesGlob("exact", "exactly"), message: "a starless pattern is not a prefix test");
}

// toSlash rewrites a path's separators to "/", as Go's filepath.ToSlash does.
//
// An asset glob is workflow vocabulary: actions/upload-artifact and the publish shell
// speak "/" on every runner, and the uploader normalizes separators before matching.
// fs\join speaks the OS. Anything checked against one of those globs goes through here
// first. A backslash then reads as a separator on every platform, stricter than Linux
// alone requires and intended: an asset name carrying one is unbuildable on the Windows
// runner. A version carrying "/" still fails, so this cannot mask what the glob catches.
export fun toSlash(path: str) > str {
    return path.replace("\\", with: "/");
}

test "a windows-joined asset path matches the upload glob" {
    // The v0.4.1 windows job, which refused this exact name.
    std\assert(matchesGlob("dist/magus_*.tar.gz",
        toSlash("dist\\magus_v0.4.1_windows_amd64_static.tar.gz")),
        message: "a backslash-joined asset is what the uploader collects");
    std\assert(matchesGlob("dist/magus_*.tar.gz",
        toSlash("dist/magus_v0.4.1_linux_amd64_static.tar.gz")),
        message: "a slash-joined asset is unchanged");
    std\assert(!matchesGlob("dist/magus_*.tar.gz",
        toSlash("dist\\magus_libs/diagnostics/v0.1.0_windows_amd64_static.tar.gz")),
        message: "normalizing the join still refuses a version carrying a separator");
    std\assert(toSlash("a\\b\\c") == "a/b/c", message: "every separator, not the first");
    std\assert(toSlash("") == "", message: "the empty path");
}

// overwriteRefusal is the write-once rule for release artifacts: with immutable set, a
// path that already exists is refused rather than replaced. Returns the refusal message,
// or "" when the write may proceed.
//
// Pure like everything here: the caller supplies exists (fs\exists at the call site), so
// the rule tests without a filesystem. The default stays overwrite - the publish job
// re-uploads on a re-run by design - and immutable is the opt-in for runs where an
// existing artifact means a published file is about to be replaced.
export fun overwriteRefusal(path: str, immutable: bool, exists: bool) > str {
    if (!immutable or !exists) { return ""; }
    return "release: `" + path + "` already exists and this run is immutable; refusing to "
        + "overwrite a release artifact. Delete it deliberately, or run without the "
        + "`immutable` charm to allow replacement.";
}

test "immutable refuses only an existing path" {
    std\assert(overwriteRefusal("dist/a.tar.gz", immutable: false, exists: true) == "",
        message: "the default overwrites");
    std\assert(overwriteRefusal("dist/a.tar.gz", immutable: true, exists: false) == "",
        message: "a fresh path writes");
    final msg = overwriteRefusal("dist/a.tar.gz", immutable: true, exists: true);
    std\assert(msg != "", message: "an existing path under immutable is refused");
    std\assert(msg.indexOf("dist/a.tar.gz") != null, message: "the refusal names the path");
    std\assert(msg.indexOf("immutable") != null, message: "the refusal names the charm");
}

// unreleasedBody returns the trimmed body of CHANGELOG.md's [Unreleased] section, or ""
// when the section is absent or holds nothing.
//
// A mirror of parseUnreleased in cmd/magus-utils/release.go rather than a call to it:
// `cut` exposes no read-only mode, and adding one would be a subcommand with this as its
// only caller. The two need agree on one question, whether the section is empty, so this
// reproduces the heading match (case-insensitive label), the section boundary (the next
// `## `), and the trim.
export fun unreleasedBody(changelog: str) > str {
    var body = mut [<str>];
    var inside = false;
    foreach (line in changelog.split("\n")) {
        if (line.startsWith("## ")) {
            if (inside) { break; }
            final rest = line.sub(3);
            if (rest.startsWith("[")) {
                final close = rest.indexOf("]");
                if (close != null and rest.sub(1, len: close - 1).lower() == "unreleased") {
                    inside = true;
                }
            }
        } else if (inside) {
            body.append(line);
        }
    }
    return body.join("\n").trim();
}

test "the unreleased section is read the way cut reads it" {
    final full = "# Changelog\n\n## [Unreleased]\n\n### Added\n\n- a thing\n\n## [v0.3.0]\n\n- old\n";
    std\assert(unreleasedBody(full) == "### Added\n\n- a thing", message: "content, trimmed, section-bounded");
    std\assert(unreleasedBody("# Changelog\n\n## [Unreleased]\n\n## [v0.3.0]\n\n- old\n") == "",
        message: "an emptied section is what cut refuses on");
    std\assert(unreleasedBody("# Changelog\n\n## [v0.3.0]\n\n- old\n") == "",
        message: "no section at all");
    std\assert(unreleasedBody("## [unreleased]\n\n- a thing\n") == "- a thing",
        message: "the label match is case-insensitive, as cut's is");
}

// currentVersion returns a module's highest STABLE released version, or "" when
// it has never had one. Compared on the PARSED major/minor/patch, not the tag
// text, because string order puts v0.10.0 before v0.9.0.
//
// Prereleases are skipped: per semver.org item 9 a prerelease has LOWER
// precedence than the version it anticipates, so v0.4.0-rc1 is emphatically not
// v0.4.0 released and must not become the base the next version is computed from
// - otherwise cutting rc1 would silently advance everyone's floor.
//
// Build metadata does NOT disqualify a tag. Item 10 says metadata is ignored when
// determining precedence, so v1.0.0+ci42 IS v1.0.0; excluding it would re-offer a
// version already released.
export fun currentVersion(prefix: str) > str !> any {
    var best = "";
    var bestMajor = 0 - 1;
    var bestMinor = 0 - 1;
    var bestPatch = 0 - 1;
    foreach (t in vcs\tags(pattern: prefix + "v*")) {
        // A bare "v*" also matches libs/foo/v1.2.3, so the prefix is checked
        // exactly - otherwise the root would adopt a nested module's tag.
        if (t.prefix != prefix) { continue; }
        if (t.version.original == "") { continue; } // an annotated non-version tag
        if (t.version.prerelease != "") { continue; } // anticipates a release, is not one
        final newer = t.version.major > bestMajor
            or (t.version.major == bestMajor and t.version.minor > bestMinor)
            or (t.version.major == bestMajor and t.version.minor == bestMinor
                and t.version.patch > bestPatch);
        if (newer) {
            bestMajor = t.version.major;
            bestMinor = t.version.minor;
            bestPatch = t.version.patch;
            best = t.version.original;
        }
    }
    return best;
}

// nextFor returns the three legal next versions for a module currently at cur.
// An unreleased module is treated as sitting at 0.0.0, so its candidates fall out
// of the same rule as everyone else's (0.0.1 | 0.1.0 | 1.0.0) rather than being a
// special case someone has to remember.
export fun nextFor(cur: str) > SemverNext !> any {
    if (cur == "") { return semver\next("0.0.0"); }
    return semver\next(cur);
}

// isCandidate reports whether v is one of the three versions nextFor offers,
// comparing the RELEASE part only - so v0.4.0-rc1 and v0.4.0+ci both count as the
// minor candidate. A prerelease of a legal next version is itself legal; that is
// how you cut an rc without first inventing a version nobody agreed to.
export fun isCandidate(v: str, cur: str) > bool !> any {
    final want = semver\parse(v);
    final n = nextFor(cur);
    foreach (c in [n.patch, n.minor, n.major]) {
        final cv = semver\parse(c);
        if (cv.major == want.major and cv.minor == want.minor and cv.patch == want.patch) {
            return true;
        }
    }
    return false;
}

// rewriteRequire points go.mod's require for module at version, preserving the
// line's indentation. The `replace` directive names the same module and must NOT
// be touched: it is the local-development path, ignored by every downstream
// consumer, and rewriting it would break building inside this repo.
// modulePath returns the path go.mod declares, or "" when it declares none.
//
// Needed for Go's major-version suffix rule, which applies to the path: from v2 on
// it must end in /vN, so a v2.0.0 tag beside a go.mod still naming the v1 path is
// uninstallable. The tag alone cannot tell you that.
export fun modulePath(gomod: str) > str {
    foreach (line in gomod.split("\n")) {
        // .trim(), because go.mod permits any run of whitespace after the keyword and
        // a bare sub() keeps it: `module  path` yielded a leading space here. Same
        // parse as coverage.buzz's modulePath, which must agree with this one.
        if (line.startsWith("module ")) { return line.sub("module ".len()).trim(); }
    }
    return "";
}

// needsMajorSuffix reports whether releasing major from the module at path would
// publish a tag Go cannot resolve.
//
// From v2 on, Go wants the path to end in /vN, and `go get` resolves the path. A
// v2.0.0 tag beside a go.mod naming the v1 path is uninstallable, and semver has
// no opinion, so the survey offers that candidate like any other. A non-Go module
// passes "" and never hits the rule.
export fun needsMajorSuffix(path: str, major: int) > bool {
    if (path == "" or major < 2) { return false; }
    return !path.endsWith("/v" + major);
}

test "the major suffix rule starts at v2 and only for Go modules" {
    std\assert(needsMajorSuffix("example.com/m", major: 2), message: "v2 without a suffix is refused");
    std\assert(!needsMajorSuffix("example.com/m/v2", major: 2), message: "v2 with the suffix is fine");
    std\assert(needsMajorSuffix("example.com/m/v2", major: 3), message: "a stale suffix is refused");
    std\assert(!needsMajorSuffix("example.com/m", major: 1), message: "v1 has no suffix rule");
    std\assert(!needsMajorSuffix("example.com/m", major: 0), message: "v0 has no suffix rule");
    std\assert(!needsMajorSuffix("", major: 4), message: "a non-Go module is never subject to it");
}

test "reads the module path and ignores a require of a similar name" {
    final gomod = "module example.com/root\n\ngo 1.26\n\nrequire (\n\tmodule-ish/x v1.0.0\n)\n";
    std\assert(modulePath(gomod) == "example.com/root", message: "declared path");
    std\assert(modulePath("go 1.26\n") == "", message: "no module line");
    // Same case coverage.buzz pins: a bare sub() kept the extra space here, so the two
    // parsers disagreed on a legal go.mod.
    std\assert(modulePath("module  example.com/root\n") == "example.com/root", message: "two spaces after the keyword");
}

export fun rewriteRequire(gomod: str, module: str, version: str) > str {
    var kept = mut [];
    var found = false;
    foreach (line in gomod.split("\n")) {
        final at = line.indexOf(module + " v");
        if (at != null and line.indexOf("=>") == null) {
            kept.append(line.sub(0, at) + module + " " + version);
            found = true;
        } else {
            kept.append(line);
        }
    }
    if (!found) { throw "release: go.mod has no require line for " + module; }
    return kept.join("\n");
}
