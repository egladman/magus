// Every op is a fork of `buf` on PATH — no shell. buf drives protoc-style code
// generation from a buf.gen.yaml, so `generate` is the headline op.
//
// This spell is the reference example for a *codegen producer*: the interesting
// part is the cache/affected metadata, not the commands. mgs_listRequiredGlobs
// declares the .proto sources and buf config as inputs, and mgs_listProvidedGlobs
// declares the generated code as outputs — so editing a .proto reruns codegen and,
// because the generated files are a *dependent* project's inputs, invalidates
// everything downstream of them. Keep `provides` in sync with the `out:` paths in
// your buf.gen.yaml: under-declare and the cache won't replay codegen; over-declare
// and every replay snapshots more than necessary.

import "magus/spell";
// charm constructors derive argv patches from an anchor arg, not a counted index.
import "magus/charm";

export fun mgs_getName() > str { return "protobuf"; }

export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.proto"}, Path{value = "buf.yaml"}, Path{value = "buf.gen.yaml"}, Path{value = "buf.work.yaml"}, Path{value = "buf.lock"}];
}

// Generated code buf writes. Adjust to match the `out:` directories in your
// buf.gen.yaml; "gen/**" is the buf convention.
export fun mgs_listProvidedGlobs() > [Path] { return [Path{value = "gen/**"}]; }

export fun mgs_getVersionCommand() > [str] { return ["buf", "--version"]; }

// No protoc-gen-* probes here, deliberately. buf generate delegates codegen to
// plugins, so THEY produce the committed output - but WHICH plugins is declared in
// each workspace's buf.gen.yaml, not by this spell: one repo pins `local: [go,
// tool, protoc-gen-go]`, another uses a remote plugin needing no local binary at
// all. A built-in shipped to every user cannot name them without probing tools
// most workspaces do not have, and a probe that always fails records a constant
// UNPROBED, which tracks nothing while adding noise to every key.
//
// Where a plugin is pinned by a manifest (go.mod's tool directive), the honest fix
// is for the project to declare that manifest an input, so the pin's own change
// invalidates the codegen.

fun bufBuild(target: Target) > Command { return Command{bin = "buf", args = ["build"]}; }
fun bufGenerate(target: Target) > Command { return Command{bin = "buf", args = ["generate"]}; }
// dep-update maintains the buf.lock this spell already declares as an input -
// without it the lockfile was a file the spell could invalidate on but never
// update. Unlike go-mod-tidy there is no read-only diff mode to default to
// (buf dep update always writes), so compose it into an rw-gated target and
// let the generate drift gate catch a stale lockfile.
fun bufDepUpdate(target: Target) > Command { return Command{bin = "buf", args = ["dep", "update"]}; }
// push publishes the module to its configured BSR; what and where come from
// buf.yaml, credentials from `buf registry login`.
fun bufPush(target: Target) > Command { return Command{bin = "buf", args = ["push"]}; }
fun bufLint(target: Target) > Command {
    return Command{bin = "buf", args = ["lint"], charms = {
        "gha": append(["--error-format=github-actions"]),
    }};
}

// format checks by default: -d prints a diff of what would change (without it,
// buf dumps every formatted file in full to stdout - an unreadable CI log on
// failure) and --exit-code fails the run when that diff is non-empty. The write
// charm applies the formatting in place. The patch replaces --exit-code (the
// higher index) before dropping -d, so the concatenated ops apply sequentially
// without an index shifting out from under them.
fun bufFormat(target: Target) > Command {
    final args = ["format", "-d", "--exit-code"];
    return Command{bin = "buf", args = args, charms = {
        "rw": Charm{ ops = set(args, "--exit-code", "-w").ops + drop(args, "-d").ops },
    }};
}

// breaking checks the current schema against a baseline for backward-incompatible
// changes (wire and JSON compatibility). The baseline is REQUIRED and the caller
// names it - buf errors clearly without --against, and there is no default here on
// purpose: a hardcoded `.git#branch=main` failed every master/trunk repo out of the
// box, and shallow CI clones (fetch-depth: 1) cannot resolve a branch ref at all,
// so the right baseline (a branch, a tag, a BSR image) is the magusfile's fact:
//
//   protobuf["buf-breaking"](ctx, {"args": ["--against", ".git#branch=main"]});
//
// This is the protobuf analogue of an API-contract gate: compose it into `lint` so
// a breaking .proto change fails the same read-only stage as go-vet and
// golangci-lint. The gha charm swaps buf's reporter to GitHub Actions annotations.
fun bufBreaking(target: Target) > Command {
    return Command{bin = "buf", args = ["breaking"], charms = {
        "gha": append(["--error-format=github-actions"]),
    }};
}

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {
        "buf-build": bufBuild,
        "buf-generate": bufGenerate,
        "buf-dep-update": bufDepUpdate,
        "buf-push": bufPush,
        "buf-lint": bufLint,
        "buf-format": bufFormat,
        "buf-breaking": bufBreaking,
    };
}
