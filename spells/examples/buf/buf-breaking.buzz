// buf-breaking gates backward-incompatible schema changes, so it composes into the
// read-only `lint` target alongside buf-lint. The op takes no baseline of its own: the
// caller names the one to compare against, here the main branch of this repository.
import "magus";
import "magus/spell/buf";

magus\project({ "spells": [buf] });

export fun lint(ctx: magus\Context, args: [str]) > void {
    buf["buf-lint"](ctx);
    buf["buf-breaking"](ctx, {"args": ["--against", ".git#branch=main"]});
}
