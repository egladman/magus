import "magus/spell";
// charm constructors derive argv patches from an anchor arg, not a counted index.
import "magus/charm";

export fun mgs_getName() > str { return "bash"; }

// Extension globs only, which is a known limit: an extensionless `#!/bin/bash`
// script (a bin/ helper, a git hook) is neither hashed nor found by the op's
// walk below. Extension-based discovery cannot see a shebang; a project with
// such scripts lists them explicitly (op args) and adds its own source glob.
export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.sh"}, Path{value = "**/*.bash"}, Path{value = ".shellcheckrc"}];
}

// shellcheck, shfmt, and bats are PATH binaries pinned by no manifest, each a
// verdict decider: upgrading one changes which scripts pass while every cache
// entry replays the old verdict (the docker spell's hadolint note is the long
// version). Named probes record UNPROBED when absent, so a workspace binding
// only shellcheck pays nothing for the others.
export fun mgs_getVersionCommands() > {str: [str]} {
    return {
        "shellcheck": ["shellcheck", "--version"],
        "shfmt": ["shfmt", "--version"],
        "bats": ["bats", "--version"],
    };
}

// One-line install commands for the PATH tools this spell drives, appended to
// the error when an op's bin is absent.
export fun mgs_listInstallHints() > {str: str} {
    return {
        "shellcheck": "mise use -g shellcheck # or: brew install shellcheck",
        "shfmt": "mise use -g shfmt # or: brew install shfmt",
        "bats": "mise use -g bats # or: brew install bats-core",
    };
}

// mgs_listIgnoreDirs names non-source dirs that carry third-party shell, pruned from
// source discovery the same way the typescript and python spells prune theirs.
export fun mgs_listIgnoreDirs() > [Path] {
    return [Path{value = "node_modules", isDir = true}, Path{value = ".claude/worktrees", isDir = true}];
}

// One shellcheck invocation over every shell source: find feeds xargs with NUL
// separators, and -r skips running shellcheck on an empty set.
//
// node_modules and .claude/worktrees are pruned inside the find too, not just
// declared above: a declared ignore dir shapes what magus treats as sources, but this
// op's find is its own walk. Without the prunes, third-party shell files or stale
// agent worktrees make the current project fail lint for code it does not own.
//
// TODO: this prune is a stopgap and duplicates knowledge the engine already has. An op
// handler is called ONCE with a null Target and reduced to static {cmd, args} (see
// recordOp in internal/spellruntime/resolve.go), so it cannot expand a file list itself - the
// `sh -c find` is what defers the walk to execution time in the project dir. The fix is
// engine-side: let an op declare a sources placeholder that the runner expands per
// project from expandSources(..., IgnoreDirs), the same walk that builds cache keys.
// Then every spell inherits the declared ignore dirs instead of hardcoding names here.
fun shellcheck(target: Target) > Command {
    return Command{bin = "sh", args = ["-c",
        "find . \\( -name node_modules -o -path './.claude/worktrees' \\) -prune -o \\( -name '*.sh' -o -name '*.bash' \\) -print0 | xargs -0 -r shellcheck"]};
}

// shfmt is the shell FORMATTER, giving `format` a meaning for shell projects
// (shellcheck alone left the lint/format divide one-sided: rw had nothing to
// write). Base -d prints a diff and exits non-zero on drift; the rw charm swaps
// it for -w to rewrite in place. shfmt walks directories itself and skips
// non-shell files, so it takes `.` rather than a find pipeline - which also
// keeps its argv reachable by charms (a sh -c string is not).
fun shfmt(target: Target) > Command {
    final args = ["-d", "."];
    return Command{bin = "shfmt", args = args, charms = {
        "rw": set(args, "-d", "-w"),
    }};
}

// bats runs Bash Automated Testing System suites - the mainstream shell test
// framework. The test directory is the caller's fact ({"args": ["test/"]});
// bats errors clearly without one.
fun bats(target: Target) > Command {
    return Command{bin = "bats", args = [<str>]};
}


// The spell's own account of itself, read by the docs generator. It lives here
// rather than in a table keyed by spell name inside that generator, so a rename
// carries the prose with it instead of stranding it under a name that is gone.
// The source language this spell adapts. It tags the spell node, so a `language:`
// query groups the adapter with that language's files and symbols.
export fun mgs_getLanguage() > str { return "bash"; }

export fun mgs_getDocDescription() > str { return "Bash spell: shellcheck linting, shfmt formatting, and bats tests for shell scripts."; }
export fun mgs_getDocIntro() > str { return "The `bash` spell covers the shell lifecycle: `shellcheck` lints every `.sh`/`.bash` file, `shfmt` formats them (diff by default, rewrite under `rw`), and `bats` runs a test suite. Extensionless shebang scripts are a known limit - list them explicitly via op args."; }
export fun mgs_listDocTags() > [str] { return ["bash", "shell", "shellcheck", "lint"]; }

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {"shellcheck": shellcheck, "shfmt": shfmt, "bats": bats};
}
