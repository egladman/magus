import "magus/spell";

export fun mgs_getName() > str { return "bash"; }

export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.sh"}, Path{value = "**/*.bash"}, Path{value = ".shellcheckrc"}];
}

// mgs_listIgnoreDirs names non-source dirs pruned from source discovery the same
// way the typescript and python spells prune theirs: node_modules (third-party
// shell that ships inside a JS dependency tree) and worktrees (a leftover
// `.claude/worktrees/*` checkout, which duplicates this very tree's shell
// sources). shellcheck's `sources` glob below inherits this set at run time
// (see Command.sources in spells/op.go) instead of the op re-declaring it.
export fun mgs_listIgnoreDirs() > [Path] {
    return [Path{value = "node_modules", isDir = true}, Path{value = "worktrees", isDir = true}];
}

// One shellcheck invocation over every shell source. `sources` is the
// engine-side replacement for the `sh -c "find ... | xargs ..."` this op used
// to run: the runner expands the globs into a file list per project - the same
// walk that builds the cache key - honoring mgs_listIgnoreDirs above and the
// workspace's own ignore dirs, and appends the matches to argv. Batched (the
// default, sourcesEach unset) puts every match across as few `shellcheck`
// invocations as fit under the runner's ARG_MAX-safe limit; a glob set that
// matches nothing runs shellcheck zero times rather than failing (mirrors
// `xargs -r`).
fun shellcheck(target: Target) > Command {
    return Command{bin = "shellcheck", sources = ["**/*.sh", "**/*.bash"]};
}

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {"shellcheck": shellcheck};
}
