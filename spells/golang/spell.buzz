import "magus/spell";
import "magus/charm";

export fun mgs_getName() > str { return "go"; }

// **/*.txtar is here because a testscript archive IS a Go test input: it is the
// standard behavior-test format in this ecosystem (cmd/go's own tests, and anything
// using rogpeppe/go-internal/testscript), and `go test` reads it at run time.
// Without it a .txtar was unclaimed - editing one invalidated no cache key and pulled
// no project into the affected set, so a CI run keyed on `magus affected` could not
// see a behavior test change at all, and a stale pass would replay from cache.
export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.go"}, Path{value = "**/*.txtar"}, Path{value = "go.mod"}, Path{value = "go.sum"}, Path{value = "go.work"}, Path{value = "go.work.sum"}];
}


// `go version` prints the host platform (`go1.26.0 linux/amd64`) and golangci-lint pads
// its line with the commit it was built from, the timestamp, and the Go version it was
// compiled with. Asking for `patch` extracts the version and sheds all of that, so two
// machines running the same tool agree on a key. It narrows nothing anyone reasons about.
// Shedding `go version`'s GOOS/GOARCH suffix is only safe because the cache manifest
// carries its own platform field (see internal/cache/manifest.go) and refuses to replay
// across platforms; that suffix was otherwise the ONLY thing putting platform into the key.
//
// govulncheck declares NO key on purpose. Its verdict comes from the Go vulnerability
// DATABASE, and `-version` reports that database's last-modified date alongside the Go
// and scanner versions. Extracting a semver would take the Go version (printed first)
// and throw the database date away, leaving a newly published CVE unable to invalidate
// a cached pass. Keying on the whole output is correct, and declaring nothing asks for it.
export fun mgs_getTools() > {str: Tool} {
    return {
        "go": Tool{probe = Command{bin = "go", args = ["version"]}, key = VersionKey{upTo = VersionComponent.patch}},
        "golangci-lint": Tool{probe = Command{bin = "golangci-lint", args = ["--version"]}, key = VersionKey{upTo = VersionComponent.patch}},
        "govulncheck": Tool{probe = Command{bin = "govulncheck", args = ["-version"]}},
    };
}

export fun mgs_getLanguage() > str { return "go"; }

export fun mgs_listIgnoreDirs() > [Path] { return [Path{value = "vendor", isDir = true}]; }

// mgs_listManifests names the file that carries this project's OWN version - not
// the toolchain's (that's mgs_getVersionProbe) and not a cache input (go.mod is
// separately listed in mgs_listRequiredGlobs above, because it also feeds the
// cache key). A Go module has exactly one candidate.
export fun mgs_listManifests() > [Path] { return [Path{value = "go.mod"}]; }

fun goBuild(target: Target) > Command { return Command{bin = "go", args = ["build"]}; }
fun goClean(target: Target) > Command { return Command{bin = "go", args = ["clean", "./..."]}; }
fun goGenerate(target: Target) > Command { return Command{bin = "go", args = ["generate", "./..."]}; }
fun goRun(target: Target) > Command { return Command{bin = "go", args = ["run"]}; }

fun goFmt(target: Target) > Command {
    final args = ["-l", "."];
    return Command{bin = "gofmt", args = args, charms = {
        "rw": set(args, "-l", "-w"),
    }};
}
// Invoked directly rather than through `go tool`: golangci-lint generates no code,
// so it has none of the generator/runtime lockstep that keeps protoc-gen-go pinned
// in go.mod. `go tool golangci-lint` also required the binary in the module's tool
// block, and a workspace that had not put it there got "no such tool" - the op
// could not run at all. On PATH it is pinned by whatever the workspace uses
// (mise, asdf, a system package), and the spell's version probe records which.
fun golangCILint(target: Target) > Command {
    final args = ["run", "./..."];
    return Command{bin = "golangci-lint", args = args, charms = {
        "debug": append(["-v"]),
        "rw": after(args, "run", ["--fix"]),
    }};
}
fun goTest(target: Target) > Command {
    return Command{bin = "go", args = ["test", "./..."], charms = {
        "debug": append(["-v"]),
        "cd": append(["-covermode=atomic", "-coverprofile=coverage.out"]),
    }};
}
// Tidy resolves against the module proxy, and an import go.mod does not require yet
// arrives at latest, so its result turns on what upstream serves today rather than on
// this tree alone. The write charm is therefore relock, not rw.
fun goModTidy(target: Target) > Command {
    final args = ["mod", "tidy", "--diff"];
    return Command{bin = "go", args = args, charms = {
        "relock": drop(args, "--diff"),
    }};
}
// Edit is offline: it "reads only go.mod; it does not look up information about the
// modules involved" (go help mod edit), so the same tree always yields the same bytes.
// The write charm is therefore rw, not relock.
fun goModEdit(target: Target) > Command {
    final args = ["mod", "edit", "-print"];
    return Command{bin = "go", args = args, capture = true, charms = {
        "rw": drop(args, "-print"),
    }};
}
// Captures Go's structured module view for the spell's higher-level Buzz helper.
// This is deliberately a separate read-only op: `-json` and `-print` are distinct
// Go modes, while go-mod-edit remains the one command that applies derived edits.
fun goModJSON(target: Target) > Command {
    return Command{bin = "go", args = ["mod", "edit", "-json"], capture = true};
}
fun goVet(target: Target) > Command { return Command{bin = "go", args = ["vet", "./..."]}; }
// Invoked directly rather than through `go tool`, for the same reason as golangCILint above:
// `go tool govulncheck` requires the binary in the module's tool block, and a workspace that
// had not put it there got "no such tool" - so the op could not run at all. On PATH it is
// pinned by whatever the workspace uses, and mgs_getVersionProbes records which.
fun goVulncheck(target: Target) > Command { return Command{bin = "govulncheck", args = ["./..."]}; }
fun scipGo(target: Target) > Command {
    return Command{bin = "sh", args = ["-c", "scip-go --output \"$MAGUS_SYMBOL_INDEX\""]};
}

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {
        "go-build": goBuild,
        "go-clean": goClean,
        "go-generate": goGenerate,
        "go-run": goRun,
        "go-fmt": goFmt,
        "golangci-lint": golangCILint,
        "go-test": goTest,
        "go-mod-tidy": goModTidy,
        "go-mod-edit": goModEdit,
        "go-mod-json": goModJSON,
        "go-vet": goVet,
        "govulncheck": goVulncheck,
        "scip": scipGo,
    };
}
