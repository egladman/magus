// The magus Claude Code mod, as an opt-in harness beside spells/harness/claude-code. It
// wires no guard and no skills: it keeps two settings in .claude/settings.json so a session
// knows this repository's plugin marketplace and turns the mod on.
//
//   import "spells/harness/claude-code-mod" as claudeMod
//   magus\harness.provider(claudeMod)
//
// Claude Code reads extraKnownMarketplaces only after the person trusts the folder, and
// enabling a plugin installs it for nobody: each person runs
// `claude plugin marketplace add egladman/magus` once, or trusts the folder and starts a
// session. `magus agent harness verify` fails until the plugin is listed in
// installed_plugins.json or cached under the plugins root, and `magus doctor` advises on the
// same gap. See
// docs/guides/integrations/agents/claude-code.md.

import "magus/spell";
import "assert";

export fun mgs_getName() > str { return "claude-code-mod"; }

final SETTINGS_PATH = ".claude/settings.json";

export fun mgs_getHarness() > Harness {
    return Harness{config = HarnessConfig{path = ""}, guard = "none"};
}

export fun mgs_getSkills() > HarnessSkills {
    return HarnessSkills{paths = [<str>], form = SkillForm.both};
}

// This spell wires no guard, so it writes no approval file. The function is the same
// one every harness exports; an empty list is the answer, not an omission.
export fun mgs_renderPrompts(humanOnly: {str: str}) > [Prompt] {
    return [<Prompt>];
}

// The mod rides beside the claude-code harness, which binds Claude Code's
// hooks, so it binds none of its own.
export fun mgs_listUnsupportedHooks() > [HookBinding] {
    final rows = mut [<HookBinding>];
    foreach (point in [HookPoint.shell, HookPoint.edit, HookPoint.stop, HookPoint.subagentStop, HookPoint.spawn,
                       HookPoint.sessionStart, HookPoint.compact, HookPoint.mcp, HookPoint.attach]) {
        rows.append(HookBinding{point = point, status = BindingStatus.unsupported,
            reason = "the mod wires the extraKnownMarketplaces and enabledPlugins settings only "
                + "(https://code.claude.com/docs/en/settings); spells/harness/claude-code binds Claude Code's hooks"});
    }
    return rows;
}

export fun mgs_listSettings() > [Setting] {
    return [
        Setting{path = SETTINGS_PATH, key = ["extraKnownMarketplaces", "magus"], value = {"source": {"source": "github", "repo": "egladman/magus"}}},
        Setting{path = SETTINGS_PATH, key = ["enabledPlugins", "magus@magus"], value = true},
    ];
}

test "mgs_renderPrompts writes no approval file" {
    assert\equal(mgs_renderPrompts({"bench": "spends tokens"}).len(), 0, "no guard, no prompt file");
}

test "mgs_getName is the harness id describe and verify look up" {
    assert\equal(mgs_getName(), "claude-code-mod", "id must match magus\\harness.provider wiring and --id");
}

test "the settings register the marketplace and enable the mod in Claude Code settings" {
    final settings = mgs_listSettings();
    assert\equal(settings.len(), 2, "a marketplace and a plugin");
    foreach (s in settings) {
        assert\equal(s.path, SETTINGS_PATH, "the project settings Claude Code reads");
    }
    assert\equal(settings[1].key.join(","), "enabledPlugins,magus@magus", "the install id is <plugin>@<marketplace>");
}
