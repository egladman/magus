// Cursor agent-host harness: selected from a magusfile with magus\harness.provider, not a
// JSON file under harnesses/.
//
//   import "spells/harness/cursor" as cursor
//   magus\harness.provider(cursor)
//
// To adapt without modifying Magus source: copy this spell into the workspace,
// change only the import path (keep provider), edit Buzz, then
// merge what `magus describe harness cursor` prints. See magus-workspace-rules "Adapting a
// Buzz harness".
//
// Magus calls the harness contract's mgs_ functions on describe/verify. The entries are
// opaque host JSON; Magus prints them for a person to merge and does not rewrite command
// fields.

import "magus/spell";
import "magus/harness";
import "assert";

export fun mgs_getName() > str { return "cursor"; }

// Cursor starts every hook command in the workspace root, so a command names no directory.
final HOOK_DIR = "";

// How long Cursor may wait on one magus buzz hook before it kills the process. Without it a
// stuck or memory-heavy magus can pile up under parallel tool calls.
final HOOK_TIMEOUT_S = 10;

// Where `magus agent harness install` writes this host's tool rows, beside its hooks.
final TOOLS_DIR = ".cursor/magus/tools";

// Every tool, gated before it runs so a deny lands first. The glue restates Grep, Glob and
// Read as the shell lines they stand for, judges Shell and Task as a command and a spawn,
// and hands magus every other call whole. Cursor's validator reads * as every tool, not as
// a regex.
final PRETOOL_MATCHER = "*";

// MCP:.* is how Cursor names an MCP tool on postToolUse (MCP:<tool>), probed live.
final POSTTOOL_MATCHER = "Shell|Write|StrReplace|Delete|Edit|NotebookEdit|Grep|Glob|Read|WebSearch|WebFetch|MCP:.*";

// The tools that write a file, after which the Buzz check runs on a .buzz path.
final WRITE_MATCHER = "Write|StrReplace|Edit";

// The Buzz port reads the host from `--agent-name` and nowhere else, and refuses a call
// without it (MGS3024). Cursor splits the command and runs magus itself, so there is no
// shell. --observes-skill-loads: Cursor loads a skill by reading its SKILL.md, and the
// preToolUse matcher covers Read, so every load reaches the guard.
fun cursor_guard_flags() > [str] {
    return ["--agent-name", mgs_getName(), "--observes-skill-loads", "--tool-rows", TOOLS_DIR];
}

fun cursor_guard_command() > str {
    return buzzCommand(HOOK_DIR, script: "cursor-hook", flags: cursor_guard_flags());
}

// Every event the guard port answers, in the order the entries render. The port reads
// which event it is off the payload, so every one runs the same command.
fun cursor_event_names() > [str] {
    return [
        "sessionStart",
        "beforeShellExecution",
        "beforeMCPExecution",
        "preToolUse",
        "postToolUse",
        "postToolUseFailure",
        // Marks the conversation, so the next postToolUse hands the brief back.
        "preCompact",
        "subagentStart",
        "sessionEnd",
        // The person's message, recorded for the topics it raises and always let through.
        "beforeSubmitPrompt",
    ];
}

fun cursor_matcher(event: str) > str {
    if (event == "preToolUse") { return PRETOOL_MATCHER; }
    if (event == "postToolUse" or event == "postToolUseFailure") { return POSTTOOL_MATCHER; }
    return "";
}

fun cursor_buzz_check_hook() > HookCommand {
    final check = buzzCheckHook(mgs_getName());
    return HookCommand{event = "postToolUse", matcher = WRITE_MATCHER, script = check.script, flags = check.flags, timeoutS = check.timeoutS};
}

fun cursor_hooks() > [HookCommand] {
    final hooks = mut [<HookCommand>];
    foreach (event in cursor_event_names()) {
        hooks.append(HookCommand{event = event, matcher = cursor_matcher(event), script = "cursor-hook", flags = cursor_guard_flags(), timeoutS = HOOK_TIMEOUT_S});
    }
    hooks.append(cursor_buzz_check_hook());
    return hooks;
}

export fun mgs_listHooks() > [HookCommand] {
    return cursor_hooks();
}

// cursor_entry is one hooks.json command entry. The MCP gate fails closed: a call the guard
// could not judge does not run.
fun cursor_entry(hook: HookCommand) > {str: any} {
    final entry = mut {<str: any>};
    if (hook.matcher != "") { entry["matcher"] = hook.matcher; }
    entry["command"] = buzzCommand(HOOK_DIR, script: hook.script, flags: hook.flags);
    entry["timeout"] = hook.timeoutS;
    if (hook.event == "beforeMCPExecution") { entry["failClosed"] = true; }
    return entry;
}

// cursor_entries groups the hooks by event, in the order each event first appears.
fun cursor_entries() > [ManagedEntries] {
    final hooks = cursor_hooks();
    final events = mut [<str>];
    foreach (hook in hooks) {
        if (events.indexOf(hook.event) == null) { events.append(hook.event); }
    }
    final blocks = mut [<ManagedEntries>];
    foreach (event in events) {
        final entries = mut [<{str: any}>];
        foreach (hook in hooks) {
            if (hook.event == event) { entries.append(cursor_entry(hook)); }
        }
        blocks.append(ManagedEntries{path = ["hooks", event], entries = entries});
    }
    return blocks;
}

export fun mgs_listEntries() > [ManagedEntries] {
    return cursor_entries();
}

// The hooks file and its version, set only where the file lacks it.
export fun mgs_getHarnessConfig() > HarnessConfig {
    return HarnessConfig{path = ".cursor/hooks.json", defaults = {"version": 1}};
}

// Cursor reads skills from .agents/skills, .cursor/skills and .claude/skills (probed on
// cursor-agent 2026.10.01). .agents/skills is the one Codex reads too, so one install
// serves both.
export fun mgs_getSkills() > HarnessSkills {
    return HarnessSkills{paths = [".agents/skills"], form = SkillForm.both};
}

// Every Cursor tool the guard should know whose input's shape does not say what it does; a
// tool missing here is one the guard cannot judge (unjudged-tool).
export fun mgs_listTools() > HarnessTools {
    return HarnessTools{dir = TOOLS_DIR, rows = [
        HarnessTool{name = "Shell", capability = ToolCapability.runs},
        HarnessTool{name = "StrReplace", capability = ToolCapability.writes},
        HarnessTool{name = "Delete", capability = ToolCapability.writes},
    ]};
}

// cursor_env_hint is what the printed config says about MAGUS_LOG_SILENT. Cursor has no
// setting for the environment of the commands its agent runs, so hooks.json carries no env
// key, and the guard passes each command on exactly as Cursor sent it.
fun cursor_env_hint() > str {
    return "Cursor has no setting for the environment of the commands its agent runs, so hooks.json sets none and the guard hands each command back as Cursor sent it. To quiet magus there, set MAGUS_LOG_SILENT=true in the environment that starts Cursor.";
}

// User owns Cursor MCP client config. Magus only prints setup guidance.
export fun mgs_getMcp() > McpServer {
    return McpServer{
        transport = McpTransport.stdio,
        command = ["./magus", "mcp"],
        hint = "Wire Magus MCP yourself in the project's .cursor/mcp.json as a stdio server: command ./magus, args [\"mcp\"], so each workspace folder starts its own. Magus does not write mcp.json.\n"
            + cursor_env_hint(),
        docs = "docs/guides/integrations/mcp.md",
    };
}

// cursor_agent renders one shipped agent as a Cursor subagent file. Cursor takes no model
// per class, so every agent inherits the person's model; a read-only agent is marked so.
fun cursor_agent(agent: ShippedAgent) > AgentFile {
    final lines = mut ["---", "name: " + yamlQuote(agent.name), "description: " + yamlQuote(agent.description), "model: inherit"];
    if (agent.readOnly) { lines.append("readonly: true"); }
    lines.append("---");
    lines.append("");
    lines.append(agent.instructions.trim());
    return AgentFile{path = ".cursor/agents/{agent.name}.md", content = lines.join("\n") + "\n"};
}

export fun mgs_renderAgents(agents: [ShippedAgent]) > [AgentFile] {
    return agents.map(fun (index: int, agent: ShippedAgent) > AgentFile => cursor_agent(agent));
}

fun cursor_scout_fixture(readOnly: bool) > ShippedAgent {
    return ShippedAgent{
        name = "magus-scout",
        description = "Answers lookups: read-only, \"quoted\" and \\ escaped.",
        instructions = "First line.\n\nSecond line.\n",
        readOnly = readOnly,
    };
}

test "mgs_renderAgents renders a read-only agent that inherits the model" {
    final file = cursor_agent(cursor_scout_fixture(true));
    assert\equal(file.path, ".cursor/agents/magus-scout.md", "Cursor reads .cursor/agents");
    assert\equal(
        file.content,
        "---\nname: \"magus-scout\"\ndescription: \"Answers lookups: read-only, \\\"quoted\\\" and \\\\ escaped.\"\nmodel: inherit\nreadonly: true\n---\n\nFirst line.\n\nSecond line.\n",
        "frontmatter then the instructions",
    );
}

test "mgs_renderAgents omits readonly for a writable agent, and renders none for none" {
    final content = cursor_agent(cursor_scout_fixture(false)).content;
    assert\isTrue(content.indexOf("readonly") == null, "no read-only mark");
    assert\isTrue(content.indexOf("model: inherit") != null, "still inherits the model");
    assert\equal(mgs_renderAgents([<ShippedAgent>]).len(), 0, "no agents, no files");
}

test "mgs_getName is the harness id describe and verify look up" {
    assert\equal(mgs_getName(), "cursor", "id must match magus\\harness.provider wiring and --id");
}

test "mgs_getHarnessConfig names the Cursor hooks file and seeds version 1, and no env" {
    final cfg = mgs_getHarnessConfig();
    assert\equal(cfg.path, ".cursor/hooks.json", "workspace-relative host config path");
    assert\equal("{cfg.defaults["version"]}", "1", "defaults merge on first create");
    assert\isTrue(cfg.defaults["env"] == null, "hooks.json gains no env key");
}

test "mgs_getSkills installs both forms into .agents/skills" {
    assert\equal(mgs_getSkills().form.value, "both", "the short skills and their full twins, as for the other hosts");
    assert\equal(mgs_getSkills().paths.join(","), ".agents/skills", "a directory cursor-agent reads skills from");
}

test "guard command is the shipped Cursor Buzz port, not a shell script" {
    final cmd = cursor_guard_command();
    assert\isTrue(cmd.startsWith("magus buzz -s docs/guides/integrations/agents/cursor-hook.buzz"), "host runs the Buzz port, with no shell");
    assert\isTrue(cmd.indexOf(" -- --agent-name {mgs_getName()}") != null, "names this host on the script argv");
    assert\isTrue(cmd.indexOf(" --observes-skill-loads") != null, "a SKILL.md Read reaches preToolUse, so skill loads are reported");
}

test "the entries cover every Cursor event magus uses, one guard entry each" {
    final names = cursor_event_names();
    assert\equal(names.len(), 10, "sessionStart, beforeShell, beforeMCP, preToolUse, postToolUse, postToolUseFailure, preCompact, subagentStart, sessionEnd, beforeSubmitPrompt");
    assert\isTrue(names.indexOf("stop") == null, "the reply check is opt-in, never shipped");
    final entries = cursor_entries();
    assert\equal(entries.len(), names.len(), "one managed block per event");
    foreach (i, block in entries) {
        assert\equal(block.path.join("."), "hooks.{names[i]}", "Cursor nests events under hooks, in order");
        final guard = block.entries[0];
        assert\equal("{guard["command"]}", cursor_guard_command(), "every event names the guard script");
        assert\equal(guard["timeout"] as? int, HOOK_TIMEOUT_S, "every entry bounds how long magus may run");
        assert\equal((guard["failClosed"] as? bool) ?? false, names[i] == "beforeMCPExecution", "only the MCP gate fails closed");
        assert\equal((guard["matcher"] as? str) ?? "", cursor_matcher(names[i]), "the matcher the event takes");
    }
    final post = entries[names.indexOf("postToolUse")!];
    assert\equal(post.entries.len(), 2, "the advice and the Buzz check");
    assert\equal("{post.entries[1]["matcher"]}", WRITE_MATCHER, "every tool that writes a file");
}

test "mgs_getMcp prints Cursor stdio setup guidance only" {
    final mcp = mgs_getMcp();
    assert\equal(mcp.transport.value, "stdio", "the host starts ./magus mcp per folder");
    assert\isTrue(mcp.hint.indexOf(".cursor/mcp.json") != null, "points at the project config");
    assert\isTrue(mcp.hint.indexOf("does not write") != null, "no Magus mcp.json write");
    assert\isTrue(mcp.hint.indexOf(cursor_env_hint()) != null, "describe prints the MAGUS_LOG_SILENT note");
    assert\isTrue(cursor_env_hint().indexOf("export") == null, "rewrites no command");
}
