// OpenCode agent-host harness. Skills-only: OpenCode has no shell-command hook config file
// Magus can merge. The guard rides a TypeScript plugin
// (docs/guides/integrations/agents/opencode-plugin.ts), not a merged hook config.
//
//   import "spells/harness/opencode" as opencode
//   magus\harness.provider(opencode)
//
// To adapt without modifying Magus source: copy this spell into the workspace, change only
// the import path (keep provider), edit Buzz. `magus describe harness opencode` prints no
// hook config, since the config path is empty, only the push and human-only run
// permissions in opencode.json (mgs_renderPrompts); verify does not claim guard coverage
// from a missing config, and reports the hook drift check skipped. See
// magus-workspace-rules "Adapting a Buzz harness".

import "magus/spell";
import "magus/harness";
import "assert";

export fun mgs_getName() > str { return "opencode"; }

export fun mgs_getHarnessConfig() > HarnessConfig {
    return HarnessConfig{path = ""};
}

export fun mgs_getSkills() > HarnessSkills {
    return HarnessSkills{paths = [".opencode/skills"], form = SkillForm.both};
}

// The hooks the guard plugin would run were they wired through a config. With no config
// path magus has no entries to hold them to, and says the check was skipped.
export fun mgs_listHooks() > [HookCommand] {
    // The plugin runs the disk hook on a root session's idle and holds its line for the
    // next tool result, since no OpenCode event hands text to the model once a turn.
    return [buzzCheckHook(mgs_getName()), reclaimDiskHook(mgs_getName(), event: "session.idle", say: "stdout")];
}

// Every OpenCode tool the guard should know, written by `magus agent harness install` to
// a directory beside a host file naming opencode, where `magus shell --agent-name opencode`
// finds them. A tool missing here is one
// the guard cannot judge (unjudged-tool).
export fun mgs_listTools() > HarnessTools {
    final rows = mut [HarnessTool{name = "bash", capability = ToolCapability.runs}];
    foreach (name in ["read", "glob", "grep", "list"]) { rows.append(HarnessTool{name = name, capability = ToolCapability.reads}); }
    foreach (name in ["write", "edit", "patch"]) { rows.append(HarnessTool{name = name, capability = ToolCapability.writes}); }
    rows.append(HarnessTool{name = "task", capability = ToolCapability.spawns});
    foreach (name in ["todowrite", "todoread", "webfetch", "skill"]) { rows.append(HarnessTool{name = name, capability = ToolCapability.inert}); }
    return HarnessTools{dir = ".opencode/magus/tools", rows = rows};
}

// opencode_env_hint is what the printed config says about MAGUS_LOG_SILENT. opencode.json
// documents no key for the environment of the commands the agent runs. The shipped plugin's
// shell.env hook sets it, which is the plugin's code and not config this harness prints.
fun opencode_env_hint() > str {
    return "OpenCode's config documents no setting for the environment of the commands its agent runs, so this config sets none: the guard plugin's shell.env hook exports MAGUS_LOG_SILENT=true into them unless you already set it in the environment you start OpenCode from.";
}

// User owns OpenCode MCP client settings. Magus points at docs only; the guard remains the
// TypeScript plugin.
export fun mgs_getMcp() > McpServer {
    return McpServer{
        transport = McpTransport.stdio,
        command = ["./magus", "mcp"],
        hint = "Configure Magus MCP in the project's opencode.json under mcp.magus as a local server: type local, command [\"./magus\", \"mcp\"]. Magus does not write OpenCode MCP config.\n"
            + opencode_env_hint(),
        docs = "docs/guides/integrations/mcp.md",
    };
}

// opencode_prompts makes OpenCode ask before every git push. A plugin cannot ask (throwing
// is all tool.execute.before can do), so the prompt is OpenCode's own permission, and the
// guard plugin's permission.ask hook answers it: allow for a push a gate covers, ask for an
// ungated one, deny for a leased worker. Both keys, because "git push *" does not match a
// bare "git push". Then the same pair for each spelling of a run of a target the workspace
// declares human_only, whose names humanOnly holds.
fun opencode_prompts(humanOnly: [str]) > [Prompt] {
    final verbs = mut ["git push", "hg push", "sl push", "jj git push"];
    final names = humanOnly.cloneMutable();
    names.sort(fun (left: str, right: str) > bool => left < right);
    foreach (name in names) {
        foreach (bin in ["magus", "./magus"]) {
            verbs.append("{bin} run {name}");
            verbs.append("{bin} affected {name}");
        }
    }
    final prompts = mut [<Prompt>];
    foreach (verb in verbs) {
        prompts.append(Prompt{path = "opencode.json", key = ["permission", "bash", verb], value = "ask"});
        prompts.append(Prompt{path = "opencode.json", key = ["permission", "bash", verb + " *"], value = "ask"});
    }
    return prompts;
}

// OpenCode's permission has no place for a human_only target's reason, so only the names
// are read.
export fun mgs_renderPrompts(humanOnly: {str: str}) > [Prompt] {
    return opencode_prompts(humanOnly.keys());
}

// opencode_agent renders one shipped agent as an OpenCode subagent file. It sets no model,
// so the agent inherits the one the invoking session uses, and OpenCode names its agents
// by file name rather than a frontmatter field. A read-only agent denies the edit
// permission, which covers every file-changing tool; bash stays at the session's setting
// because the agent's job is running read-only magus commands.
fun opencode_agent(agent: ShippedAgent) > AgentFile {
    final lines = mut ["---", "description: " + yamlQuote(agent.description), "mode: subagent"];
    if (agent.readOnly) {
        lines.append("permission:");
        lines.append("  edit: deny");
    }
    lines.append("---");
    lines.append("");
    lines.append(agent.instructions.trim());
    return AgentFile{path = ".opencode/agents/{agent.name}.md", content = lines.join("\n") + "\n"};
}

export fun mgs_renderAgents(agents: [ShippedAgent]) > [AgentFile] {
    return agents.map(fun (index: int, agent: ShippedAgent) > AgentFile => opencode_agent(agent));
}

test "mgs_renderAgents renders a read-only subagent that denies edits and sets no model" {
    final file = opencode_agent(ShippedAgent{
        name = "magus-scout",
        description = "Answers lookups: read-only, \"quoted\" and \\ escaped.",
        instructions = "First line.\n\nSecond line.\n",
        readOnly = true,
    });
    assert\equal(file.path, ".opencode/agents/magus-scout.md", "OpenCode reads .opencode/agents");
    assert\equal(
        file.content,
        "---\ndescription: \"Answers lookups: read-only, \\\"quoted\\\" and \\\\ escaped.\"\nmode: subagent\npermission:\n  edit: deny\n---\n\nFirst line.\n\nSecond line.\n",
        "frontmatter then the instructions",
    );
    assert\isTrue(file.content.indexOf("model") == null, "the invoking session's model applies");
}

test "mgs_renderAgents leaves permissions alone for a writable subagent, and renders none for none" {
    final file = opencode_agent(ShippedAgent{name = "magus-worker", description = "Edits files.", instructions = "First line.\n"});
    assert\isTrue(file.content.indexOf("permission") == null, "the session's permissions apply");
    assert\equal(mgs_renderAgents([<ShippedAgent>]).len(), 0, "no agents, no files");
}

test "mgs_renderPrompts asks before every spelling of a human-only target's run" {
    final prompts = mgs_renderPrompts({"agent-bench-run": "launches paid sessions"});
    assert\equal(prompts.len(), 16, "the 8 push keys, then a bare and an argument key per spelling");
    final want = ["magus run agent-bench-run", "magus run agent-bench-run *", "magus affected agent-bench-run", "magus affected agent-bench-run *",
        "./magus run agent-bench-run", "./magus run agent-bench-run *", "./magus affected agent-bench-run", "./magus affected agent-bench-run *"];
    foreach (i, verb in want) {
        assert\equal(prompts[8 + i].key[2], verb, "permission key {8 + i}");
        assert\equal("{prompts[8 + i].value}", "ask", "OpenCode prompts rather than refuses");
    }
}

test "mgs_renderPrompts asks before every backend's bare push and push with arguments" {
    final prompts = mgs_renderPrompts({<str: str>});
    assert\equal(prompts.len(), 8, "a bare and an argument key per backend");
    final want = ["git push", "git push *", "hg push", "hg push *", "sl push", "sl push *", "jj git push", "jj git push *"];
    foreach (i, verb in want) {
        assert\equal(prompts[i].path, "opencode.json", "the project config OpenCode loads");
        assert\equal(prompts[i].key[2], verb, "permission key {i}");
        assert\isTrue(prompts[i].key[0] != "env", "opencode.json gains no env key");
    }
}

test "mgs_getName is the harness id describe and verify look up" {
    assert\equal(mgs_getName(), "opencode", "id must match magus\\harness.provider wiring and --id");
}

test "the harness is skills-only, under .opencode/skills" {
    assert\equal(mgs_getHarnessConfig().path, "", "no host JSON for Magus to merge");
    assert\equal(mgs_getSkills().paths.join(","), ".opencode/skills", "OpenCode reads .opencode/skills");
    assert\equal(mgs_getSkills().form.value, "both", "the short skills and their full twins");
}

test "mgs_getMcp points OpenCode at a stdio server it configures itself" {
    final mcp = mgs_getMcp();
    assert\equal(mcp.transport.value, "stdio", "the host starts ./magus mcp per session");
    assert\isTrue(mcp.hint.indexOf("does not write") != null, "no Magus write");
    assert\isTrue(mcp.hint.indexOf(opencode_env_hint()) != null, "describe prints the MAGUS_LOG_SILENT note");
}
