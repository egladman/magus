// OpenCode agent-host harness. Skills-only: OpenCode has no shell-command hook
// config file Magus can merge. The guard rides a TypeScript plugin
// (docs/guides/integrations/agents/opencode-plugin.ts), not a merged hook config.
//
//   import "spells/harness/opencode" as opencode
//   magus\harness.provider(opencode)
//
// To adapt without modifying Magus source: copy this spell into the workspace,
// change only the import path (keep provider), edit Buzz. `magus describe harness
// opencode` prints no hook config when config path is empty, only the push and human-only run permissions in opencode.json
// (harness_prompts); verify does not claim guard coverage from a missing config. See magus-workspace-rules "Adapting a Buzz harness".

import "magus/spell";
import "assert";

export fun mgs_getName() > str { return "opencode"; }

fun opencode_skills_form() > str { return "both"; }

fun opencode_skills_paths() > [str] {
    return [".opencode/skills"];
}

fun opencode_config() > {str: any} {
    return {
        "path": "",
    };
}

fun opencode_skills() > {str: any} {
    return {
        "paths": opencode_skills_paths(),
        "form": opencode_skills_form(),
    };
}

fun opencode_entries() > [any] {
    return [];
}

export fun harness_config(target: Target, cb: fun(any)) > {str: any} {
    return opencode_config();
}

export fun harness_skills(target: Target, cb: fun(any)) > {str: any} {
    return opencode_skills();
}

export fun harness_entries(target: Target, cb: fun(any)) > [any] {
    return opencode_entries();
}

// opencode_env_hint is what the printed config says about MAGUS_LOG_SILENT. opencode.json
// documents no key for the environment of the commands the agent runs. The shipped plugin's
// shell.env hook sets it, which is the plugin's code and not config this harness prints.
fun opencode_env_hint() > str {
    return "OpenCode's config documents no setting for the environment of the commands its agent runs, so this config sets none: the guard plugin's shell.env hook exports MAGUS_LOG_SILENT=true into them unless you already set it in the environment you start OpenCode from.";
}

fun opencode_mcp() > {str: any} {
    // User owns OpenCode MCP client settings. Magus points at docs only.
    // Guard remains the TypeScript plugin.
    return {
        "hint": "Configure Magus MCP in the project's opencode.json under mcp.magus as a local server: type local, command [\"./magus\", \"mcp\"]. Magus does not write OpenCode MCP config.\n"
            + opencode_env_hint(),
        "docs": "docs/guides/integrations/mcp.md",
    };
}

export fun harness_mcp(target: Target, cb: fun(any)) > {str: any} {
    return opencode_mcp();
}

// opencode_prompts makes OpenCode ask before every git push. A plugin cannot ask (throwing
// is all tool.execute.before can do), so the prompt is OpenCode's own permission, and the
// guard plugin's permission.ask hook answers it: allow for a push a gate covers, ask for an
// ungated one, deny for a leased worker. Both keys, because "git push *" does not match a
// bare "git push". Then the same pair for each spelling of a run of a target the workspace
// declares human_only, whose names humanOnly holds.
fun opencode_prompts(humanOnly: [str]) > [any] {
    final verbs = mut ["git push", "hg push", "sl push", "jj git push"];
    final names = humanOnly.cloneMutable();
    names.sort(fun (left: str, right: str) > bool => left < right);
    foreach (name in names) {
        foreach (bin in ["magus", "./magus"]) {
            verbs.append("{bin} run {name}");
            verbs.append("{bin} affected {name}");
        }
    }
    final prompts: mut [any] = mut [];
    foreach (verb in verbs) {
        prompts.append({
            "path": "opencode.json",
            "key": ["permission", "bash", verb],
            "value": "ask",
        });
        prompts.append({
            "path": "opencode.json",
            "key": ["permission", "bash", verb + " *"],
            "value": "ask",
        });
    }
    return prompts;
}

// The request's human_only maps each target the workspace declares human_only to its
// reason; OpenCode's permission has no place for the reason, so only the names are read.
export fun harness_prompts(target: Target, cb: fun(any)) > [any] {
    final req = {<str: any>};
    cb(req);
    final humanOnly = req["human_only"];
    if (humanOnly == null) { return opencode_prompts([<str>]); }
    return opencode_prompts((humanOnly as {str: any}).keys());
}

// opencode_yaml_quote renders text as a YAML double-quoted scalar, so a colon, a quote or a
// newline in a description cannot change what the frontmatter means.
fun opencode_yaml_quote(text: str) > str {
    final escaped = text.replace("\\", with: "\\\\").replace("\"", with: "\\\"").replace("\n", with: "\\n").replace("\r", with: "\\r").replace("\t", with: "\\t");
    return "\"" + escaped + "\"";
}

// opencode_agent renders one shipped agent as an OpenCode subagent file. It sets no model,
// so the agent inherits the one the invoking session uses, and OpenCode names its agents
// by file name rather than a frontmatter field. A read-only agent denies the edit
// permission, which covers every file-changing tool; bash stays at the session's setting
// because the agent's job is running read-only magus commands.
fun opencode_agent(agent: {str: any}) > {str: any} {
    var content = "---\ndescription: " + opencode_yaml_quote("{agent["description"]}") + "\nmode: subagent\n";
    if (agent["read_only"] == true) {
        content = content + "permission:\n  edit: deny\n";
    }
    content = content + "---\n\n" + "{agent["instructions"]}".trim() + "\n";
    return {
        "path": ".opencode/agents/{agent["name"]}.md",
        "content": content,
    };
}

fun opencode_agents(agents: [any]) > [any] {
    final files: mut [any] = mut [];
    foreach (agent in agents) {
        files.append(opencode_agent(agent as {str: any}));
    }
    return files;
}

// harness_agents receives the shipped agents as req["agents"]. A call with none renders none.
export fun harness_agents(target: Target, cb: fun(any)) > [any] {
    final req = {<str: any>};
    cb(req);
    final agents = req["agents"];
    if (agents == null) { return []; }
    return opencode_agents(agents as [any]);
}

test "harness_agents renders a read-only subagent that denies edits and sets no model" {
    final file = opencode_agent({
        "name": "magus-scout",
        "description": "Answers lookups: read-only, \"quoted\" and \\ escaped.",
        "instructions": "First line.\n\nSecond line.\n",
        "read_only": true,
    });
    assert\equal("{file["path"]}", ".opencode/agents/magus-scout.md", "OpenCode reads .opencode/agents");
    assert\equal(
        "{file["content"]}",
        "---\ndescription: \"Answers lookups: read-only, \\\"quoted\\\" and \\\\ escaped.\"\nmode: subagent\npermission:\n  edit: deny\n---\n\nFirst line.\n\nSecond line.\n",
        "frontmatter then the instructions",
    );
    assert\isTrue("{file["content"]}".indexOf("model") == null, "the invoking session's model applies");
}

test "harness_agents leaves permissions alone for a writable subagent" {
    final file = opencode_agent({
        "name": "magus-worker",
        "description": "Edits files.",
        "instructions": "First line.\n",
        "read_only": false,
    });
    assert\isTrue("{file["content"]}".indexOf("permission") == null, "the session's permissions apply");
}

test "harness_agents renders nothing when the call carries no agents" {
    final noTarget = null;
    final cb = fun(_: any) > void {};
    assert\equal(harness_agents(noTarget, cb).len(), 0, "no agents, no files");
}

test "harness_prompts asks before every spelling of a human-only target's run" {
    final prompts = opencode_prompts(["agent-bench-run"]);
    assert\equal(prompts.len(), 16, "the 8 push keys, then a bare and an argument key per spelling");
    final want = ["magus run agent-bench-run", "magus run agent-bench-run *", "magus affected agent-bench-run", "magus affected agent-bench-run *",
        "./magus run agent-bench-run", "./magus run agent-bench-run *", "./magus affected agent-bench-run", "./magus affected agent-bench-run *"];
    foreach (i, verb in want) {
        final key = prompts[8 + i]["key"] as [str];
        assert\equal(key[2], verb, "permission key {8 + i}");
        assert\equal("{prompts[8 + i]["value"]}", "ask", "OpenCode prompts rather than refuses");
    }
}

test "harness_prompts asks before every backend's bare push and push with arguments" {
    final prompts = opencode_prompts([<str>]);
    assert\equal(prompts.len(), 8, "a bare and an argument key per backend");
    foreach (p in prompts) {
        assert\equal("{p["path"]}", "opencode.json", "the project config OpenCode loads");
        assert\equal("{p["value"]}", "ask", "OpenCode prompts rather than refuses");
    }
    final want = ["git push", "git push *", "hg push", "hg push *", "sl push", "sl push *", "jj git push", "jj git push *"];
    foreach (i, verb in want) {
        final key = prompts[i]["key"] as [str];
        assert\equal(key[2], verb, "permission key {i}");
    }
}

test "mgs_getName is the harness id describe and verify look up" {
    assert\equal(mgs_getName(), "opencode", "id must match magus\\harness.provider wiring and --id");
}

test "harness_config is skills-only empty path" {
    final cfg = opencode_config();
    assert\equal("{cfg["path"]}", "", "no host JSON for Magus to merge");
}

test "harness_skills installs both forms under .opencode/skills" {
    assert\equal(opencode_skills_form(), "both", "matches the JSON descriptor");
    final skills = opencode_skills();
    assert\equal("{skills["form"]}", "both", "skills map carries the form");
    final paths = skills["paths"] as [str];
    assert\equal(paths.len(), 1, "one skills install path");
    assert\equal(paths[0], ".opencode/skills", "OpenCode reads .opencode/skills");
}

test "harness_entries is empty because no hook config is merged" {
    assert\equal(opencode_entries().len(), 0, "guard is the TypeScript plugin not managed_entries");
}

test "harness_mcp points OpenCode at docs only" {
    final mcp = opencode_mcp();
    assert\isTrue(mcp["url"] == null, "no url: the Go side reads that as stdio");
    assert\isTrue("{mcp["docs"]}".indexOf("mcp.md") != null, "docs pointer");
    assert\isTrue("{mcp["hint"]}".indexOf("does not write") != null, "no Magus write");
}

test "the printed config says opencode.json has no place for MAGUS_LOG_SILENT" {
    assert\isTrue("{opencode_mcp()["hint"]}".indexOf(opencode_env_hint()) != null, "describe prints it");
    assert\isTrue(opencode_env_hint().indexOf("MAGUS_LOG_SILENT=true") != null, "names the variable and its value");
    foreach (prompt in opencode_prompts(["agent-bench-run"])) {
        final key = (prompt["key"] as? [str]) ?? [<str>];
        assert\isTrue(key.len() == 0 or key[0] != "env", "opencode.json gains no env key");
    }
}

test "harness_* contract wrappers return the same pure helpers" {
    final t = null;
    final cb = fun(_: any) > void {};
    assert\equal("{harness_config(t, cb)["path"]}", "", "config path");
    assert\equal("{harness_skills(t, cb)["form"]}", opencode_skills_form(), "skills form");
    assert\equal(harness_entries(t, cb).len(), 0, "entries length");
    assert\equal("{harness_mcp(t, cb)["docs"]}", "docs/guides/integrations/mcp.md", "mcp docs");
}
