// Codex agent-host harness. Same harness contract as spells/harness/cursor: selected from a
// magusfile with magus\harness.provider, not a JSON file under harnesses/.
//
//   import "spells/harness/codex" as codex
//   magus\harness.provider(codex)
//
// To adapt without modifying Magus source: copy this spell into the workspace,
// change only the import path (keep provider), edit Buzz, then
// merge what `magus describe harness codex` prints. See magus-workspace-rules "Adapting a
// Buzz harness".
//
// Magus calls the harness contract's mgs_ functions on describe/verify. The entries are
// opaque host JSON; Magus prints them for a person to merge and does not rewrite command
// fields.

import "magus/spell";
import "magus/harness";
import "assert";

export fun mgs_getName() > str { return "codex"; }

// Codex documents no project-directory variable for a hook. -C . names the hook's working
// directory explicitly so PATH's magus can hand off to that workspace's own build.
final HOOK_DIR = ".";

// A matcher made only of letters, digits and underscores is an exact list of tool names,
// so each spelling of the spawn tool needs its own member: v1 models call it spawn_agent,
// v2 models collaborationspawn_agent, and Agent is the documented alias.
final SPAWN_MATCHER = "spawn_agent|collaborationspawn_agent|Agent";

// Every tool Codex raises PreToolUse for, so magus judges each by its tool and the shape
// of its input, and names one no rule can read (the unjudged-tool rule).
final EVERY_TOOL = "*";

// Where `magus agent harness install` writes this host's tool rows, beside its hooks.
final TOOLS_DIR = ".codex/magus/tools";

// One glue serves every entry that judges: each event reaches `magus shell` whole, and magus
// reads off it what the call is, a command, a patch, an MCP call or a spawn. The host name is
// the one argument: Codex has no skill tool to match, so its limits say no skill load is seen.
fun codex_guard_flags() > [str] {
    return ["--agent-name", mgs_getName()];
}

// Codex parses a SessionStart or SubagentStart hook's stdout as a reply, so the brief has
// to arrive as JSON, and its instruction file is AGENTS.md.
fun codex_rehydrate_flags() > [str] {
    return ["--format", "json", "--rules", "AGENTS.md"];
}

// codex_hook is a hook with the status line Codex shows while it runs. Codex takes no
// timeout per entry.
object CodexHook {
    hook: HookCommand,
    status: str,
}

fun codex_hook(event: str, matcher: str, script: str, flags: [str], status: str) > CodexHook {
    return CodexHook{hook = HookCommand{event = event, matcher = matcher, script = script, flags = flags}, status = status};
}

fun codex_hooks() > [CodexHook] {
    final check = buzzCheckHook(mgs_getName());
    return [
        codex_hook("PreToolUse", matcher: EVERY_TOOL, script: "magus-command", flags: codex_guard_flags(), status: "magus guard: checking the call"),
        // Judges nothing. The finished spawn is how magus learns the child's name: a v2
        // spawn answers with its task_name path, a v1 spawn with the agent id.
        codex_hook("PostToolUse", matcher: SPAWN_MATCHER, script: "magus-command", flags: codex_guard_flags(), status: "magus: recording the subagent"),
        codex_hook("PostToolUse", matcher: "apply_patch", script: check.script, flags: check.flags, status: "magus: checking the Buzz it wrote"),
        // The v2 spawn message is encrypted, so nothing the parent wrote can carry a brief
        // to the child. This hook's context is the child's first instruction. The second
        // entry names the child by the id its own calls carry, which magus joins to the
        // spawn just before it.
        codex_hook("SubagentStart", matcher: "", script: "magus-rehydrate", flags: codex_rehydrate_flags(), status: "magus: briefing the subagent"),
        codex_hook("SubagentStart", matcher: "", script: "magus-command", flags: codex_guard_flags(), status: "magus: joining the subagent to its spawn"),
        // Judges nothing. The payload names the child's transcript, whose last token_count
        // record is the context size a later continuation reads.
        codex_hook("SubagentStop", matcher: "", script: "magus-command", flags: codex_guard_flags(), status: "magus: recording the subagent's context"),
        // Raised just before Codex's own approval prompt. The shared template answers it
        // from the verdict: allow for a push a gate covers, no decision for an ungated one
        // (the person decides), deny for a leased worker.
        codex_hook("PermissionRequest", matcher: "Bash", script: "magus-command", flags: codex_guard_flags(), status: "magus guard: checking approval"),
        codex_hook("SessionStart", matcher: "compact", script: "magus-rehydrate", flags: codex_rehydrate_flags(), status: "magus: restating this checkout's rules"),
        codex_hook("Stop", matcher: "", script: "magus-checkpoint", flags: ["--agent-name", mgs_getName()], status: "magus: recording where the work stands"),
        // The person's message, which the glue hands to `magus shell --message` and answers
        // with nothing. Codex ignores a matcher on this event.
        codex_hook("UserPromptSubmit", matcher: "", script: "magus-command", flags: codex_guard_flags(), status: "magus: noting the request"),
    ];
}

export fun mgs_listHooks() > [HookCommand] {
    return codex_hooks().map(fun (index: int, h: CodexHook) > HookCommand => h.hook);
}

fun codex_command(hook: HookCommand) > str {
    return buzzCommand(HOOK_DIR, script: hook.script, flags: hook.flags);
}

fun codex_guard_command() > str {
    return buzzCommand(HOOK_DIR, script: "magus-command", flags: codex_guard_flags());
}

fun codex_rehydrate_command() > str {
    return buzzCommand(HOOK_DIR, script: "magus-rehydrate", flags: codex_rehydrate_flags());
}

fun codex_checkpoint_command() > str {
    return namedCommand(HOOK_DIR, agentName: mgs_getName(), script: "magus-checkpoint", flags: [<str>]);
}

fun codex_entry(h: CodexHook) > {str: any} {
    final entry = mut {<str: any>};
    if (h.hook.matcher != "") { entry["matcher"] = h.hook.matcher; }
    entry["hooks"] = [{"type": "command", "command": codex_command(h.hook), "statusMessage": h.status}];
    return entry;
}

// codex_entries groups the hooks by event, in the order each event first appears: the
// managed entries merged into .codex/hooks.json.
fun codex_entries() > [ManagedEntries] {
    final hooks = codex_hooks();
    final events = mut [<str>];
    foreach (h in hooks) {
        if (events.indexOf(h.hook.event) == null) { events.append(h.hook.event); }
    }
    final blocks = mut [<ManagedEntries>];
    foreach (event in events) {
        final entries = mut [<{str: any}>];
        foreach (h in hooks) {
            if (h.hook.event == event) { entries.append(codex_entry(h)); }
        }
        blocks.append(ManagedEntries{path = ["hooks", event], entries = entries});
    }
    return blocks;
}

export fun mgs_listEntries() > [ManagedEntries] {
    return codex_entries();
}

export fun mgs_getHarnessConfig() > HarnessConfig {
    return HarnessConfig{path = ".codex/hooks.json"};
}

export fun mgs_getSkills() > HarnessSkills {
    return HarnessSkills{paths = [".agents/skills"], form = SkillForm.both};
}

// Every Codex tool the guard should know whose input's shape does not say what it does. A
// shell call carries its command and is judged by it; a tool missing here is one the guard
// cannot judge (unjudged-tool).
export fun mgs_listTools() > HarnessTools {
    final rows = mut [HarnessTool{name = "apply_patch", capability = ToolCapability.writes}];
    foreach (name in ["spawn_agent", "collaborationspawn_agent"]) {
        rows.append(HarnessTool{name = name, capability = ToolCapability.spawns});
    }
    foreach (name in ["close_agent", "update_plan", "view_image", "web_search"]) {
        rows.append(HarnessTool{name = name, capability = ToolCapability.inert});
    }
    return HarnessTools{dir = TOOLS_DIR, rows = rows};
}

// Codex MCP lives in ~/.codex/config.toml (user-global). Magus does not write it; describe
// prints a short paste hint. The relative command resolves in each session's own checkout.
//
// The same file carries shell_environment_policy.set, the values Codex injects into every
// subprocess it spawns (learn.chatgpt.com/docs/config-file/config-reference). This harness
// merges only .codex/hooks.json, which has no such key, and config.toml is TOML the JSON
// merge cannot touch, so the variable rides in the paste. A table header rather than a
// dotted key: pasted after [mcp_servers.magus], a dotted key would land inside that table.
export fun mgs_getMcp() > McpServer {
    return McpServer{
        transport = McpTransport.stdio,
        command = ["./magus", "mcp"],
        hint = "Paste into ~/.codex/config.toml. The first table registers the MCP server; "
            + "the second sets MAGUS_LOG_SILENT=true on every shell command Codex runs, "
            + "so magus prints its quiet output there:\n\n"
            + "[mcp_servers.magus]\n"
            + "command = \"./magus\"\n"
            + "args = [\"mcp\"]\n"
            + "enabled = true\n"
            + "\n"
            + "[shell_environment_policy.set]\n"
            + "MAGUS_LOG_SILENT = \"true\"\n",
        docs = "docs/guides/integrations/mcp.md",
    };
}

fun codex_rules_path() > str { return ".codex/rules/magus.rules"; }

// codex_rules makes Codex ask before every git push. Codex hooks cannot ask (a hook ask is
// parsed, reported as a failure, and the call continues), so the prompt is the rule's, and
// the PermissionRequest hook above decides whether it reaches the person.
fun codex_push_rule(pattern: str) > str {
    return "prefix_rule(\n"
        + "    pattern = [{pattern}],\n"
        + "    decision = \"prompt\",\n"
        + "    justification = \"magus: publishing a commit no passing gate covers needs your approval\",\n"
        + ")\n";
}

// codex_human_only_rule makes Codex ask before a run whose argv starts with pattern, quoting
// what the target costs.
fun codex_human_only_rule(pattern: str, reason: str) > str {
    return "prefix_rule(\n"
        + "    pattern = [{pattern}],\n"
        + "    decision = \"prompt\",\n"
        + "    justification = " + tomlBasic("magus: a person runs this target: " + reason) + ",\n"
        + ")\n";
}

// One rule per backend magus drives, since each publishes through its own verb. `sl push
// --to` is the Sapling push by prefix. Then one rule per spelling of a run of each
// human_only target; a spelling no prefix catches, such as a flag before the target, is
// refused rather than asked.
fun codex_rules(humanOnly: {str: str}) > str {
    final rules: mut [str] = mut [
        "# Printed by magus describe harness codex. Delete this file to drop these prompts.\n"
        + "#\n"
        + "# Every push raises an approval request, through git, Mercurial, Sapling or Jujutsu. The\n"
        + "# magus PermissionRequest hook answers it: a push a passing gate covers is approved\n"
        + "# without asking, an ungated push is left to the person, and a push from a leased worker\n"
        + "# is refused. A run of each target the workspace declares human_only raises one too.\n"
        + codex_push_rule("\"git\", \"push\"")
        + codex_push_rule("\"hg\", \"push\"")
        + codex_push_rule("\"sl\", \"push\"")
        + codex_push_rule("\"jj\", \"git\", \"push\""),
    ];
    final names = humanOnly.keys().cloneMutable();
    names.sort(fun (left: str, right: str) > bool => left < right);
    foreach (name in names) {
        foreach (bin in ["magus", "./magus"]) {
            foreach (verb in ["run", "affected"]) {
                rules.append(codex_human_only_rule("\"{bin}\", \"{verb}\", \"{name}\"", reason: humanOnly[name] ?? ""));
            }
        }
    }
    return rules.join("");
}

// humanOnly maps each target the workspace declares human_only to its reason; none prompts
// for pushes alone.
export fun mgs_renderPrompts(humanOnly: {str: str}) > [Prompt] {
    return [Prompt{path = codex_rules_path(), content = codex_rules(humanOnly)}];
}

// codex_agent renders one shipped agent as a Codex custom agent file. It sets no model, so
// the agent runs on the person's agents.default_subagent_model. A read-only agent runs in
// Codex's read-only sandbox, which the instructions alone could not enforce.
fun codex_agent(agent: ShippedAgent) > AgentFile {
    final lines = mut ["name = " + tomlBasic(agent.name), "description = " + tomlBasic(agent.description)];
    if (agent.readOnly) { lines.append("sandbox_mode = \"read-only\""); }
    lines.append("developer_instructions = " + tomlMultiline(agent.instructions.trim() + "\n"));
    return AgentFile{
        path = ".codex/agents/{agent.name}.toml",
        content = lines.join("\n") + "\n",
        hint = "{agent.name} runs on agents.default_subagent_model; set it under [agents] in ~/.codex/config.toml to a cheaper model to run lookups for less",
    };
}

export fun mgs_renderAgents(agents: [ShippedAgent]) > [AgentFile] {
    return agents.map(fun (index: int, agent: ShippedAgent) > AgentFile => codex_agent(agent));
}

fun codex_scout_fixture(instructions: str) > ShippedAgent {
    return ShippedAgent{
        name = "magus-scout",
        description = "Answers lookups: read-only, \"quoted\" and \\ escaped.",
        instructions = instructions,
        readOnly = true,
    };
}

// codex_block is the managed block for one event, null when none is wired.
fun codex_block(event: str) > ManagedEntries? {
    foreach (block in codex_entries()) {
        if (block.path[1] == event) { return block; }
    }
    return null;
}

// codex_commands is the command of each entry in the block for one event.
fun codex_commands(event: str) > [str] {
    final commands = mut [<str>];
    final block = codex_block(event);
    if (block == null) { return commands; }
    foreach (entry in block!.entries) {
        foreach (hook in entry["hooks"] as [any]) { commands.append("{hook["command"]}"); }
    }
    return commands;
}

test "mgs_renderAgents renders name, description, sandbox and instructions with no model" {
    final file = codex_agent(codex_scout_fixture("First line.\n\nUse `a\\b` and \"c\".\n"));
    assert\equal(file.path, ".codex/agents/magus-scout.toml", "Codex reads .codex/agents");
    assert\equal(
        file.content,
        "name = \"magus-scout\"\ndescription = \"Answers lookups: read-only, \\\"quoted\\\" and \\\\ escaped.\"\nsandbox_mode = \"read-only\"\ndeveloper_instructions = '''\nFirst line.\n\nUse `a\\b` and \"c\".\n'''\n",
        "all three required fields, instructions as a literal",
    );
    assert\isTrue(file.content.indexOf("model") == null, "default_subagent_model applies");
}

test "mgs_renderAgents leaves the sandbox alone for a writable agent" {
    final writable = ShippedAgent{name = "magus-worker", description = "Edits files.", instructions = "First line.\n"};
    assert\isTrue(codex_agent(writable).content.indexOf("sandbox_mode") == null, "the person's default sandbox applies");
}

test "mgs_renderAgents escapes instructions that carry the literal delimiter" {
    final content = codex_agent(codex_scout_fixture("say '''\n")).content;
    assert\isTrue(content.endsWith("developer_instructions = \"say '''\\n\"\n"), "falls back to an escaped basic string");
}

test "mgs_renderAgents renders nothing when the call carries no agents" {
    assert\equal(mgs_renderAgents([<ShippedAgent>]).len(), 0, "no agents, no files");
}

test "mgs_getName is the harness id describe and verify look up" {
    assert\equal(mgs_getName(), "codex", "id must match magus\\harness.provider wiring and --id");
}

test "mgs_getHarnessConfig names the Codex hooks file and mgs_getSkills .agents/skills" {
    assert\equal(mgs_getHarnessConfig().path, ".codex/hooks.json", "workspace-relative host config path");
    assert\equal(mgs_getSkills().form.value, "both", "the short skills and their full twins");
    assert\equal(mgs_getSkills().paths.join(","), ".agents/skills", "Codex reads .agents/skills");
}

test "every hook appears in the entries, so the drift check magus runs passes" {
    final commands = mut [<str>];
    foreach (block in codex_entries()) {
        foreach (entry in block.entries) {
            foreach (hook in entry["hooks"] as [any]) { commands.append("{hook["command"]}"); }
        }
    }
    foreach (hook in mgs_listHooks()) {
        assert\isTrue(commands.indexOf(codex_command(hook)) != null, "{hook.event} {hook.script} is rendered");
    }
}

test "every glue command is a plain argv that names this host, and rehydrate takes none" {
    final named = " --agent-name {mgs_getName()}";
    assert\isTrue(codex_guard_command().endsWith(named), "command hook, with the host name its one argument");
    assert\isTrue(codex_checkpoint_command().endsWith(named), "Stop checkpoint");
    assert\isTrue(codex_rehydrate_command().indexOf("--agent-name") == null, "rehydrate reads no host");
    assert\isTrue(codex_rehydrate_command().endsWith(" -- --format json --rules AGENTS.md"), "SessionStart and SubagentStart need JSON stdout and AGENTS.md");
    foreach (hook in mgs_listHooks()) {
        final cmd = codex_command(hook);
        assert\isTrue(cmd.startsWith("magus buzz -C . -s "), "name the working directory without an environment prefix or POSIX shell: {cmd}");
        assert\isTrue(cmd.indexOf(".sh") == null, "no entry wires a shell script: {cmd}");
        assert\isTrue(cmd.indexOf("--tool-rows") == null, "magus finds the tool rows by host: {cmd}");
    }
}

test "mgs_renderPrompts keeps the git push prompt rule the shared template looks for" {
    final none = {<str: str>};
    final prompts = mgs_renderPrompts(none);
    assert\equal(prompts.len(), 1, "one rules file");
    assert\equal(prompts[0].path, ".codex/rules/magus.rules", "project-local Codex rules");
    assert\isTrue(codex_rules(none).indexOf("[\"git\", \"push\"]") != null, "magus-command.buzz looks for this exact pattern");
    assert\isTrue(codex_rules(none).indexOf("decision = \"prompt\"") != null, "the rule prompts rather than forbids");
    assert\isTrue(codex_rules(none).indexOf("\"run\"") == null, "no human-only target, no run prompt");
}

test "mgs_renderPrompts prompts for every spelling of a human-only target's run" {
    final rules = codex_rules({"agent-bench-run": "launches \"paid\" sessions"});
    foreach (pattern in [
        "[\"magus\", \"run\", \"agent-bench-run\"]",
        "[\"./magus\", \"run\", \"agent-bench-run\"]",
        "[\"magus\", \"affected\", \"agent-bench-run\"]",
        "[\"./magus\", \"affected\", \"agent-bench-run\"]",
    ]) {
        assert\isTrue(rules.indexOf(pattern) != null, "prefix {pattern}");
    }
    assert\isTrue(rules.indexOf("justification = \"magus: a person runs this target: launches \\\"paid\\\" sessions\"") != null,
        "the justification quotes the reason, escaped");
}

test "mgs_renderPrompts prompts for every backend's push" {
    final rules = codex_rules({<str: str>});
    assert\isTrue(rules.indexOf("[\"hg\", \"push\"]") != null, "Mercurial push");
    assert\isTrue(rules.indexOf("[\"sl\", \"push\"]") != null, "Sapling push, --to included by prefix");
    assert\isTrue(rules.indexOf("[\"jj\", \"git\", \"push\"]") != null, "Jujutsu push");
}

test "the entries cover the tool, subagent, session, Stop and message events" {
    final events = mut [<str>];
    foreach (block in codex_entries()) { events.append(block.path[1]); }
    assert\equal(events.join(","), "PreToolUse,PostToolUse,SubagentStart,SubagentStop,PermissionRequest,SessionStart,Stop,UserPromptSubmit", "eight managed path blocks");
    final pre = codex_block("PreToolUse")!;
    assert\equal(pre.entries.len(), 1, "one catch-all, so no call is judged twice");
    assert\equal("{pre.entries[0]["matcher"]}", EVERY_TOOL, "every tool Codex raises the event for");
    assert\equal(codex_commands("PreToolUse")[0], codex_guard_command(), "a command, a patch, an MCP call and a spawn reach one glue");
    final post = codex_block("PostToolUse")!;
    assert\equal(post.entries.len(), 2, "the finished spawn and the Buzz check");
    assert\equal("{post.entries[0]["matcher"]}", SPAWN_MATCHER, "the child's name rides the spawn's response");
    assert\equal("{post.entries[1]["matcher"]}", "apply_patch", "the tool that writes a file");
    assert\equal(codex_commands("SubagentStart")[0], codex_rehydrate_command(), "the child is briefed through additionalContext");
    assert\equal(codex_commands("SubagentStart")[1], codex_guard_command(), "the child's id is joined to its spawn");
    assert\equal(codex_commands("PermissionRequest")[0], codex_guard_command(), "same template as PreToolUse");
    assert\equal("{codex_block("SessionStart")!.entries[0]["matcher"]}", "compact", "only the moment state was lost");
    assert\equal(codex_commands("Stop").len(), 1, "the checkpoint entry alone: the reply check is opt-in");
    assert\equal(codex_commands("Stop")[0], codex_checkpoint_command(), "records where the work stands");
    final message = codex_block("UserPromptSubmit")!;
    assert\isTrue(message.entries[0]["matcher"] == null, "Codex ignores a matcher on this event");
}

test "mgs_getMcp is a stdio paste hint for Codex user config.toml" {
    final mcp = mgs_getMcp();
    assert\equal(mcp.transport.value, "stdio", "the host starts ./magus mcp per session");
    assert\isTrue(mcp.hint.indexOf("command = \"./magus\"") != null, "the checkout's own binary");
    assert\isTrue(mcp.hint.indexOf("[shell_environment_policy.set]\nMAGUS_LOG_SILENT = \"true\"\n") != null,
        "Codex's own environment table, as a header so a paste after the MCP table stays out of it");
    assert\isTrue((mcp.hint.indexOf("[mcp_servers.magus]") ?? -1) < (mcp.hint.indexOf("[shell_environment_policy.set]") ?? -1),
        "the MCP table keeps its place at the top of the paste");
}
