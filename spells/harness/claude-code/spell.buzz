// Claude Code agent-host harness. Same provider-style spell contract as
// spells/harness/cursor and spells/harness/codex: selected from a magusfile
// with magus\harness.provider, not a JSON file under harnesses/.
//
//   import "spells/harness/claude-code" as claude
//   magus\harness.provider(claude)
//
// To adapt without modifying Magus source: copy this spell into the workspace,
// change only the import path (keep provider), edit Buzz, then
// `magus agent harness apply`. See magus-workspace-rules "Adapting a Buzz harness".
//
// Magus invokes the reserved harness_* names on apply/verify. The fragments are
// opaque host JSON; Magus merges them and does not rewrite command fields.

import "magus/spell";
import "assert";

export fun mgs_getName() > str { return "claude-code"; }

fun claude_config_path() > str { return ".claude/settings.json"; }

fun claude_skills_form() > str { return "both"; }

fun claude_skills_paths() > [str] {
    return [".claude/skills"];
}

// claude_interpreter picks which magus RUNS the glue.
//
// Moving the glue from sh to Buzz moves the interpreter from a program that is
// always present and has no version to one that does. The sh copies resolved the
// binary that renders the VERDICT by walking up to the magusfile, precisely so a
// stale PATH copy could not answer with rules the tree no longer has; the same
// argument applies to the interpreter, and more sharply, because a magus too old
// to run the script renders no verdict at all.
//
// So a workspace that carries its own binary wires that one, and this answer is a
// CONSTANT rather than a probe of the machine it runs on.
//
// It used to test for ./magus and fall back to `magus`, which made the committed config
// valid only on the machine that last applied it: a checkout carrying the binary wrote
// `./magus`, and every other one then computed `magus`, compared it against what was
// committed, and reported the harness uncovered. CI said so on every run.
//
// A config is one string with no shell to test a file in, so it cannot hold both. It
// names the workspace binary because that is the one whose rules match the tree; a
// checkout that has not built one yet has hooks that cannot launch, which is a real
// state and the one `magus doctor`'s guard-binary check reports. Workspace-relative,
// never absolute: an absolute path would ship one machine's layout to every clone.
fun claude_interpreter() > str {
    return "./magus";
}

// The Buzz ports, not the sh copies beside them. Buzz needs neither jq nor a POSIX
// shell, so the wiring works unchanged on Windows and a reader installs no runtime
// dependency to be guarded. The sh copies stay for the hosts still wired to them
// (codex, cursor, the any-host guide) and render byte-identical replies.
//
// `-s` keeps the interpreter quiet: `magus buzz` reports an unused import and other
// BZZ advisories on stderr, and Claude Code shows a hook's first stderr line as an
// error notice, so an advisory about the glue would read as a guard failure. Real
// errors still print, which is what makes a broken hook visible rather than silent.
//
// Every command this spell builds is a plain argv. Claude Code splits a hook command
// itself rather than handing it to a shell, so a leading `VAR=value` is a word the host
// would look for a program named after; the sh copies beside the Buzz glue are run BY sh
// and keep their variables for that reason. Flags a single entry declares ride after
// `--`, which `magus buzz` forwards to the script as its own argv.
fun claude_buzz_command(script: str, flags: [str]) > str {
    final base = "{claude_interpreter()} buzz -s docs/guides/integrations/agents/{script}.buzz";
    if (flags.len() == 0) { return base; }
    return base + " -- " + flags.join(" ");
}

fun claude_glue_command(surface: str, flags: [str]) > str {
    return claude_buzz_command("magus-{surface}", flags: flags);
}

// The Bash, MCP and Skill matchers all take this one string. Their payloads differ, but a
// params object and a skill name both have to reach `magus shell` whole, and the glue reads
// that off the event rather than off the entry, so there is nothing to write on it. Three
// named wrappers returning identical bytes only invited a reader to look for a difference.
fun claude_guard_command() > str {
    return claude_glue_command("command", flags: [<str>]);
}

fun claude_path_command() > str {
    return claude_glue_command("path", flags: [<str>]);
}

fun claude_observe_command() > str {
    return claude_glue_command("observe", flags: [<str>]);
}

// The matcher that makes skill loads observable, named once so the entry that DECLARES
// they are observable can be checked against the entry that produces them. "Keep the two
// in step" used to be a comment; the invariant test below is what keeps them.
final SKILL_MATCHER = "Skill";

fun claude_agent_command() > str {
    // --observes-skill-loads because THIS config wires SKILL_MATCHER. A rule that requires
    // a skill before a spawn can only be satisfied where loads are reported, so the wiring
    // that reports them is what declares it; a harness without that matcher passes nothing
    // here and those rules stand down rather than denying every spawn forever.
    //
    // It is the one thing this entry knows that the event cannot say, which is why it is
    // the one thing written on the entry.
    return claude_glue_command("command", flags: ["--observes-skill-loads"]);
}

// The two lifecycle wrappers go through the same interpreter helper as the guard
// glue, so this host's whole wiring names one runtime. They judge nothing, which is
// why they are built from claude_buzz_command directly: their names are their own
// rather than a surface of the hook template.
fun claude_rehydrate_command() > str {
    return claude_buzz_command("magus-rehydrate", flags: [<str>]);
}

fun claude_checkpoint_command() > str {
    return claude_buzz_command("magus-checkpoint", flags: [<str>]);
}

fun claude_command_hook(cmd: str) > {str: any} {
    return {
        "type": "command",
        "command": cmd,
        "timeout": 10,
    };
}

fun claude_pretool_entry(matcher: str, cmd: str) > {str: any} {
    return {
        "matcher": matcher,
        "hooks": [claude_command_hook(cmd)],
    };
}

fun claude_entries() > [any] {
    return [
        {
            "path": ["hooks", "PreToolUse"],
            "entries": [
                claude_pretool_entry("Bash", claude_guard_command()),
                claude_pretool_entry("Edit|Write|NotebookEdit", claude_path_command()),
                claude_pretool_entry("^mcp__magus__", claude_guard_command()),
                claude_pretool_entry("Read", claude_observe_command()),
                claude_pretool_entry(SKILL_MATCHER, claude_guard_command()),
                claude_pretool_entry("Agent|Task", claude_agent_command()),
            ],
        },
        {
            "path": ["hooks", "SessionStart"],
            "entries": [
                {
                    "matcher": "compact",
                    "hooks": [claude_command_hook(claude_rehydrate_command())],
                },
            ],
        },
        {
            "path": ["hooks", "Stop"],
            "entries": [
                {
                    "hooks": [claude_command_hook(claude_checkpoint_command())],
                },
            ],
        },
    ];
}

fun claude_config() > {str: any} {
    return {
        "path": claude_config_path(),
    };
}

fun claude_skills() > {str: any} {
    return {
        "paths": claude_skills_paths(),
        "form": claude_skills_form(),
    };
}

export fun harness_config(target: Target, cb: fun(any)) > {str: any} {
    return claude_config();
}

export fun harness_skills(target: Target, cb: fun(any)) > {str: any} {
    return claude_skills();
}

export fun harness_entries(target: Target, cb: fun(any)) > [any] {
    return claude_entries();
}

fun claude_mcp() > {str: any} {
    // User owns Claude Code MCP registration. Magus prints the host CLI sketch.
    final hint = "Resolve secret ref __TOKEN_REF__, then register Magus MCP (user scope):\n"
        + "  claude mcp add --transport http --scope user magus __URL__ --header \"Authorization: Bearer <token>\"\n"
        + "Restart the Claude Code session afterward.";
    return {
        "token_ref": "MAGUS_MCP_TOKEN",
        "url": "http://127.0.0.1:7391/mcp",
        "hint": hint,
        "docs": "docs/guides/integrations/mcp.md",
        "register": [
            "claude", "mcp", "add",
            "--transport", "http",
            "--scope", "user",
            "magus", "__URL__",
            "--header", "Authorization: Bearer <resolve:__TOKEN_REF__>",
        ],
    };
}

export fun harness_mcp(target: Target, cb: fun(any)) > {str: any} {
    return claude_mcp();
}

test "mgs_getName is the harness id apply and verify look up" {
    assert\equal(mgs_getName(), "claude-code", "id must match magus\\harness.provider wiring and --id");
}

test "harness_config names Claude Code settings" {
    assert\equal(claude_config_path(), ".claude/settings.json", "workspace-relative host config path");
    final cfg = claude_config();
    assert\equal("{cfg["path"]}", ".claude/settings.json", "config map carries the same path");
}

test "harness_skills installs both forms under .claude/skills" {
    assert\equal(claude_skills_form(), "both", "matches the JSON descriptor");
    final skills = claude_skills();
    assert\equal("{skills["form"]}", "both", "skills map carries the form");
    final paths = skills["paths"] as [str];
    assert\equal(paths.len(), 1, "one skills install path");
    assert\equal(paths[0], ".claude/skills", "Claude Code reads .claude/skills");
}

test "guard commands name the Buzz glue, never the sh copies" {
    assert\isTrue(claude_guard_command().indexOf("magus-command.buzz") != null, "command surface");
    assert\isTrue(claude_path_command().indexOf("magus-path.buzz") != null, "path surface");
    assert\isTrue(claude_observe_command().indexOf("magus-observe.buzz") != null, "read observe");
    assert\isTrue(claude_guard_command().indexOf(".sh") == null, "no POSIX shell dependency");
    assert\isTrue(claude_guard_command().indexOf("buzz -s ") != null, "quiet interpreter");
}

test "no entry carries an environment assignment" {
    // The whole reason the glue reads the raw-event question off the event and its flags
    // off argv. Claude Code splits a hook command itself, so a leading VAR=value is a
    // word it would look for a program named after, not an assignment anything performs.
    foreach (block in claude_entries()) {
        foreach (entry in block["entries"] as [any]) {
            foreach (hook in entry["hooks"] as [any]) {
                final cmd = "{hook["command"]}";
                final head = cmd.split(" ")[0];
                assert\isTrue(head.indexOf("=") == null, "the command starts with a program, not an assignment: {cmd}");
                assert\isTrue(cmd.indexOf("HOST_EVENT_RAW") == null, "the event decides that, not the entry: {cmd}");
                assert\isTrue(cmd.indexOf("__MAGUS_SHELL_FLAGS") == null, "shell flags ride after --: {cmd}");
            }
        }
    }
}

test "the one per-entry flag rides after the argv separator" {
    // Only the spawn surface declares a capability, and it is the only entry that differs
    // from the bare guard command at all.
    assert\equal(claude_agent_command(), claude_guard_command() + " -- --observes-skill-loads",
        "the spawn entry is the guard command plus one forwarded flag");
}

// The spawn entry claims loads are REPORTED, and only the skill matcher reports them. Left
// to a comment, dropping the matcher leaves the claim standing, and guard.denySpawnWithoutBrief
// then denies every spawn over a load the host can no longer observe. Derived from the
// entries rather than pinned as a pair, so the coupling is what fails when it breaks.
test "the spawn entry declares observed skill loads only while a matcher reports them" {
    final pre = claude_entries()[0];
    var reports_loads = false;
    var claims_loads = false;
    foreach (entry in pre["entries"] as [any]) {
        final matcher = (entry["matcher"] as? str) ?? "";
        if (matcher == SKILL_MATCHER) { reports_loads = true; }
        foreach (hook in entry["hooks"] as [any]) {
            final command = (hook["command"] as? str) ?? "";
            if (command.indexOf("--observes-skill-loads") != null) { claims_loads = true; }
        }
    }
    assert\equal(claims_loads, reports_loads,
        "an entry declares --observes-skill-loads exactly when a matcher reports them");
}

test "the lifecycle wrappers name the Buzz ports too" {
    // The whole point of porting these two: with them on sh, this host's wiring still
    // demanded a POSIX shell for two of its eight entries, so a reader on Windows had
    // six working hooks and no way to know which two were doing nothing.
    assert\isTrue(claude_rehydrate_command().indexOf("magus-rehydrate.buzz") != null, "SessionStart rehydrate");
    assert\isTrue(claude_checkpoint_command().indexOf("magus-checkpoint.buzz") != null, "Stop checkpoint");
    foreach (block in claude_entries()) {
        foreach (entry in block["entries"] as [any]) {
            foreach (hook in entry["hooks"] as [any]) {
                final cmd = "{hook["command"]}";
                assert\isTrue(cmd.indexOf(".sh") == null, "no entry wires a shell script");
                assert\isTrue(cmd.indexOf("sh ") == null, "and none is run through sh");
            }
        }
    }
}

test "the interpreter is the same string on every machine" {
    // A CONSTANT, not a probe. Resolving it per machine wrote whichever answer the
    // applying checkout happened to have into a COMMITTED config, so every other
    // checkout computed the other one and reported the harness uncovered.
    //
    // A checkout with no ./magus has hooks that cannot launch. That is a real state and
    // doctor's guard-binary check reports it; it is not something to paper over by
    // writing a different config on that machine.
    final chosen = claude_interpreter();
    assert\equal(chosen, "./magus", "the workspace binary, whether or not this machine has one");
    assert\isTrue(claude_glue_command("command", flags: [<str>]).startsWith("{chosen} buzz -s "), "the command carries it");
    // Every surface, because one command built by hand rather than through the helper
    // is one entry apply keeps rewriting against a config that already holds it. Each
    // STARTS with the interpreter now: nothing precedes the program any more.
    assert\isTrue(claude_guard_command().startsWith("{chosen} buzz"), "command mcp and skill surfaces");
    assert\isTrue(claude_agent_command().startsWith("{chosen} buzz"), "spawn surface");
    assert\isTrue(claude_path_command().startsWith("{chosen} buzz"), "path surface");
    assert\isTrue(claude_observe_command().startsWith("{chosen} buzz"), "read surface");
    assert\isTrue(claude_rehydrate_command().startsWith("{chosen} buzz"), "SessionStart rehydrate");
    assert\isTrue(claude_checkpoint_command().startsWith("{chosen} buzz"), "Stop checkpoint");
}

test "harness_entries covers PreToolUse SessionStart and Stop" {
    final entries = claude_entries();
    assert\equal(entries.len(), 3, "three managed path blocks");
    final pre = entries[0];
    final pre_path = pre["path"] as [str];
    assert\equal(pre_path[1], "PreToolUse", "command path mcp and read ride PreToolUse");
    final pre_entries = pre["entries"] as [any];
    assert\equal(pre_entries.len(), 6, "Bash path mcp Read skill and spawn matchers");
    foreach (entry in pre_entries) {
        final hooks = entry["hooks"] as [any];
        assert\equal(hooks.len(), 1, "one command hook per matcher");
        assert\equal("{hooks[0]["type"]}", "command", "Claude Code hook type");
        // `as?` rather than `as`: a bare cast COERCES, so a timeout written 10.0 would
        // pass the assertion whose job is noticing that the emitted JSON changed.
        assert\equal(hooks[0]["timeout"] as? int, 10, "timeout seconds");
        // Interpolating an absent key renders "null", four characters, so a length test
        // over the rendered form passes for an entry carrying no matcher at all.
        final matcher = entry["matcher"] as? str;
        assert\isTrue(matcher != null and matcher!.len() > 0, "matcher present");
    }
    final start = entries[1];
    final start_path = start["path"] as [str];
    assert\equal(start_path[1], "SessionStart", "rehydrate on compact");
    final stop = entries[2];
    final stop_path = stop["path"] as [str];
    assert\equal(stop_path[1], "Stop", "checkpoint");
}

test "harness_mcp prints Claude Code host CLI guidance" {
    final mcp = claude_mcp();
    assert\equal("{mcp["token_ref"]}", "MAGUS_MCP_TOKEN", "secret provider ref");
    assert\isTrue("{mcp["hint"]}".indexOf("claude mcp add") != null, "names the host CLI");
    assert\isTrue("{mcp["docs"]}".indexOf("mcp.md") != null, "docs pointer");
}

test "harness_* contract wrappers return the same pure helpers" {
    // These wrappers ignore both arguments, which is what lets a test call them with no
    // target at all. gopherbuzz's checker accepts the null for a declared Target; a
    // stricter one would not, so this is the shape magus calls them with, not a legal one.
    final noTarget = null;
    final cb = fun(_: any) > void {};
    assert\equal("{harness_config(noTarget, cb)["path"]}", claude_config_path(), "config path");
    assert\equal("{harness_skills(noTarget, cb)["form"]}", claude_skills_form(), "skills form");
    assert\equal(harness_entries(noTarget, cb).len(), claude_entries().len(), "entries length");
    assert\equal("{harness_mcp(noTarget, cb)["docs"]}", "docs/guides/integrations/mcp.md", "mcp docs");
}
