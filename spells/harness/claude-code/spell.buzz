// Claude Code agent-host harness. Same provider-style spell contract as
// spells/harness/cursor and spells/harness/codex: selected from a magusfile
// with magus\harness.provider, not a JSON file under harnesses/.
//
//   import "spells/harness/claude-code" as claude
//   magus\harness.provider(claude)
//
// To adapt without modifying Magus source: copy this spell into the workspace,
// change only the import path (keep provider), edit Buzz, then
// merge what `magus describe harness claude-code` prints. See magus-workspace-rules
// "Adapting a Buzz harness".
//
// Magus invokes the reserved harness_* names on describe/verify. The fragments are
// opaque host JSON; Magus prints them for a person to merge and does not rewrite command
// fields.

import "magus/spell";
import "assert";

export fun mgs_getName() > str { return "claude-code"; }

fun claude_config_path() > str { return ".claude/settings.json"; }

fun claude_skills_form() > str { return "both"; }

fun claude_skills_paths() > [str] {
    return [".claude/skills"];
}

// The one command that builds a checkout of magus its first binary, verbatim from
// internal/ward/version.go. The guard exempts exactly this line in a root with no ./magus
// yet (internal/guard/catalog.go), and claude_launch exempts it too: a launcher that
// refused it would leave a fresh checkout no way to get the binary it is asking for.
final BOOTSTRAP = "go run -trimpath ./cmd/magus run go-build --no-cache .";

// Exit 2 is the only code Claude Code treats as a block. Any other is a non-blocking
// error and the tool call runs unjudged, which is how a session once ran every guard
// rule open on `magus: command not found` (exit 127).
final BLOCKS = 2;

// Stop and SubagentStop read exit 2 as "do not stop", so a missing magus there would
// keep the agent from ever stopping. They report and let it stop.
final REPORTS = 1;

// claude_launch wraps a `buzz` argv in the shell that picks which magus RUNS the glue.
//
// Claude Code runs a hook command through `sh -c` and exports CLAUDE_PROJECT_DIR, the
// root the session started in, so the checkout's own build is found from any session
// directory and the string is the same on every machine. PATH is the fallback, for a
// workspace that uses an installed magus and builds none. The SessionStart PATH entry
// cannot stand in for this: CLAUDE_ENV_FILE reaches later Bash tool commands only, never
// a hook command (code.claude.com/docs/en/hooks, "Persist environment variables").
//
// With neither, the hook exits `missing`: BLOCKS where the host can block, so a missing
// interpreter refuses the call instead of waving it through.
//
// Shell, because nothing here can be trusted to be a magus until it has been found; it
// is the price of failing closed, and it costs Windows its Git Bash. if/then rather than
// a brace group, which Buzz would read as interpolation.
fun claude_launch(argv: str, missing: int) > str {
    var exempt = "";
    if (missing == BLOCKS) {
        exempt = "grep -Fq '\"command\":\"{BOOTSTRAP}\"' && exit 0; ";
    }
    final reason = "magus: no ./magus in this checkout and no magus on PATH, so this hook cannot run; build one: {BOOTSTRAP}";
    return "m=\"$CLAUDE_PROJECT_DIR/magus\"; [ -x \"$m\" ] || m=$(command -v magus); "
        + "if [ -z \"$m\" ]; then {exempt}echo '{reason}' >&2; exit {missing}; fi; "
        + "exec \"$m\" {argv}";
}

// claude_buzz_command is the argv claude_launch execs.
//
// `-s` keeps the interpreter quiet: `magus buzz` reports an unused import and other
// BZZ advisories on stderr, and Claude Code shows a hook's first stderr line as an
// error notice, so an advisory about the glue would read as a guard failure. Real
// errors still print, which is what makes a broken hook visible rather than silent.
//
// Flags a single entry declares ride after `--`, which `magus buzz` forwards to the
// script as its own argv, never in a leading `VAR=value`: the glue reads everything it
// acts on off the event and its argv.
fun claude_buzz_command(script: str, flags: [str]) > str {
    final base = "buzz -s docs/guides/integrations/agents/{script}.buzz";
    if (flags.len() == 0) { return base; }
    return base + " -- " + flags.join(" ");
}

// claude_named_command is a glue command that names this host: `--agent-name` and the
// spell's own mgs_getName(), the one identity the glue acts on. Rendered here, from the
// declaration, so the name on the command cannot drift from the harness it belongs to;
// the glue refuses a call without it (MGS3024) rather than guessing a host.
fun claude_named_command(script: str, flags: [str]) > str {
    final named = mut ["--agent-name", mgs_getName()];
    foreach (flag in flags) { named.append(flag); }
    return claude_buzz_command(script, flags: named);
}

fun claude_glue_command(surface: str, flags: [str]) > str {
    return claude_named_command("magus-{surface}", flags: flags);
}

// The Bash, MCP and Skill matchers all take this one string. Their payloads differ, but a
// params object and a skill name both have to reach `magus shell` whole, and the glue reads
// that off the event rather than off the entry, so there is nothing to write on it. Three
// named wrappers returning identical bytes only invited a reader to look for a difference.
fun claude_guard_command() > str {
    return claude_glue_command("command", flags: [<str>]);
}

fun claude_path_command() > str {
    return claude_glue_command("path", flags: [<str>]);
}

fun claude_observe_command() > str {
    return claude_glue_command("observe", flags: [<str>]);
}

// The matcher that makes skill loads observable, named once so the entry that DECLARES
// they are observable can be checked against the entry that produces them. "Keep the two
// in step" used to be a comment; the invariant test below is what keeps them.
final SKILL_MATCHER = "Skill";

// Both names the spawn tool has had across Claude Code releases. The same matcher runs
// after the call too: the finished call's response carries the id the child was given,
// which is what lets that child's own spawns name their parent.
final SPAWN_MATCHER = "Agent|Task";

// A message to a subagent that already exists, so a workspace spawn rule sees every
// continuation as well as every spawn.
final CONTINUE_MATCHER = "SendMessage";

fun claude_agent_command() > str {
    // --observes-skill-loads because THIS config wires SKILL_MATCHER. A rule that requires
    // a skill before a spawn can only be satisfied where loads are reported, so the wiring
    // that reports them is what declares it; a harness without that matcher passes nothing
    // here and those rules stand down rather than denying every spawn forever.
    //
    // It is the one thing this entry knows that the event cannot say, which is why it is
    // the one thing written on the entry.
    return claude_glue_command("command", flags: ["--observes-skill-loads"]);
}

// The two lifecycle wrappers go through the same interpreter helper as the guard
// glue, so this host's whole wiring names one runtime. They judge nothing, which is
// why they are built from claude_buzz_command directly: their names are their own
// rather than a surface of the hook template.
fun claude_rehydrate_command() > str {
    return claude_buzz_command("magus-rehydrate", flags: [<str>]);
}

fun claude_checkpoint_command() > str {
    return claude_named_command("magus-checkpoint", flags: [<str>]);
}

fun claude_command_hook(cmd: str) > {str: any} {
    return {
        "type": "command",
        "command": cmd,
        "timeout": 10,
    };
}

fun claude_matched_entry(matcher: str, cmd: str) > {str: any} {
    return {
        "matcher": matcher,
        "hooks": [claude_command_hook(cmd)],
    };
}

fun claude_pretool_entry(matcher: str, argv: str) > {str: any} {
    return claude_matched_entry(matcher, cmd: claude_launch(argv, missing: BLOCKS));
}

// claude_session_path_command puts the session root first on PATH for the agent's own Bash
// tool commands, and through them everything those commands start, so `magus` typed there
// is the checkout's build rather than whatever the shell that launched Claude Code had.
// The root is expanded now and $PATH left for the Bash tool's shell to expand.
//
// The one entry that runs no magus: it fixes the PATH a magus would be found on. It also
// says, at session start, when no magus resolves at all, since every guarded call is then
// refused and the agent should learn why before its first one.
fun claude_session_path_command() > str {
    return "[ -z \"$CLAUDE_ENV_FILE\" ] || printf 'export PATH=\"%s:$PATH\"\\n' \"$CLAUDE_PROJECT_DIR\" >> \"$CLAUDE_ENV_FILE\"; "
        + "[ -x \"$CLAUDE_PROJECT_DIR/magus\" ] || command -v magus >/dev/null || "
        + "echo 'no ./magus in this checkout and no magus on PATH, so every guarded tool call is refused until one exists; build one: {BOOTSTRAP}'";
}

// The session starts that get a fresh CLAUDE_ENV_FILE. compact keeps the session's
// environment and only rehydrates.
final SESSION_PATH_MATCHER = "startup|resume|clear";

fun claude_entries() > [any] {
    return [
        {
            "path": ["hooks", "PreToolUse"],
            "entries": [
                claude_pretool_entry("Bash", argv: claude_guard_command()),
                claude_pretool_entry("Edit|Write|NotebookEdit", argv: claude_path_command()),
                claude_pretool_entry("^mcp__magus__", argv: claude_guard_command()),
                claude_pretool_entry("Read", argv: claude_observe_command()),
                // The glue restates a Read as the `cat` or `sed -n` line it stands for, so
                // the read rules judge it like the shell read it replaces.
                claude_pretool_entry("Read", argv: claude_guard_command()),
                claude_pretool_entry(SKILL_MATCHER, argv: claude_guard_command()),
                claude_pretool_entry(SPAWN_MATCHER + "|" + CONTINUE_MATCHER, argv: claude_agent_command()),
            ],
        },
        // After the call nothing is left to block, so these report a missing magus.
        {
            "path": ["hooks", "PostToolUse"],
            "entries": [
                claude_matched_entry(SPAWN_MATCHER, cmd: claude_launch(claude_guard_command(), missing: REPORTS)),
            ],
        },
        {
            "path": ["hooks", "SessionStart"],
            "entries": [
                claude_matched_entry(SESSION_PATH_MATCHER, cmd: claude_session_path_command()),
                claude_matched_entry("compact", cmd: claude_launch(claude_rehydrate_command(), missing: REPORTS)),
            ],
        },
        {
            "path": ["hooks", "Stop"],
            "entries": [
                {
                    "hooks": [claude_command_hook(claude_launch(claude_checkpoint_command(), missing: REPORTS))],
                },
            ],
        },
        // A subagent's stop carries the path of its own transcript, whose last usage
        // record is the context a later continue to it would resume. It judges nothing.
        {
            "path": ["hooks", "SubagentStop"],
            "entries": [
                {
                    "hooks": [claude_command_hook(claude_launch(claude_guard_command(), missing: REPORTS))],
                },
            ],
        },
    ];
}

fun claude_config() > {str: any} {
    return {
        "path": claude_config_path(),
    };
}

fun claude_skills() > {str: any} {
    return {
        "paths": claude_skills_paths(),
        "form": claude_skills_form(),
    };
}

export fun harness_config(target: Target, cb: fun(any)) > {str: any} {
    return claude_config();
}

export fun harness_skills(target: Target, cb: fun(any)) > {str: any} {
    return claude_skills();
}

export fun harness_entries(target: Target, cb: fun(any)) > [any] {
    return claude_entries();
}

fun claude_mcp() > {str: any} {
    // User owns Claude Code MCP registration. Magus prints the host CLI sketch. Project
    // scope lands in .mcp.json, which every worktree carries, so each checkout's session
    // starts its own __COMMAND__.
    final hint = "Register Magus MCP for this project (writes .mcp.json):\n"
        + "  claude mcp add --scope project magus -- __COMMAND__\n"
        + "A project entry named magus takes precedence over a user-scope one. Restart the Claude Code session afterward.";
    return {
        "hint": hint,
        "docs": "docs/guides/integrations/mcp.md",
        "register": [
            "claude", "mcp", "add",
            "--scope", "project",
            "magus", "--", "./magus", "mcp",
        ],
    };
}

export fun harness_mcp(target: Target, cb: fun(any)) > {str: any} {
    return claude_mcp();
}

test "mgs_getName is the harness id describe and verify look up" {
    assert\equal(mgs_getName(), "claude-code", "id must match magus\\harness.provider wiring and --id");
}

test "harness_config names Claude Code settings" {
    assert\equal(claude_config_path(), ".claude/settings.json", "workspace-relative host config path");
    final cfg = claude_config();
    assert\equal("{cfg["path"]}", ".claude/settings.json", "config map carries the same path");
}

test "harness_skills installs both forms under .claude/skills" {
    assert\equal(claude_skills_form(), "both", "matches the JSON descriptor");
    final skills = claude_skills();
    assert\equal("{skills["form"]}", "both", "skills map carries the form");
    final paths = skills["paths"] as [str];
    assert\equal(paths.len(), 1, "one skills install path");
    assert\equal(paths[0], ".claude/skills", "Claude Code reads .claude/skills");
}

test "a Read is both recorded and judged" {
    var observed = false;
    var judged = false;
    foreach (entry in claude_entries()[0]["entries"] as [any]) {
        if ((entry["matcher"] as? str) != "Read") { continue; }
        foreach (hook in entry["hooks"] as [any]) {
            final command = (hook["command"] as? str) ?? "";
            if (command == claude_launch(claude_observe_command(), missing: BLOCKS)) { observed = true; }
            if (command == claude_launch(claude_guard_command(), missing: BLOCKS)) { judged = true; }
        }
    }
    assert\isTrue(observed, "the observer records the path");
    assert\isTrue(judged, "the command guard judges the read it stands for");
}

test "guard commands name the Buzz glue, never the sh copies" {
    assert\isTrue(claude_guard_command().indexOf("magus-command.buzz") != null, "command surface");
    assert\isTrue(claude_path_command().indexOf("magus-path.buzz") != null, "path surface");
    assert\isTrue(claude_observe_command().indexOf("magus-observe.buzz") != null, "read observe");
    assert\isTrue(claude_guard_command().indexOf(".sh") == null, "no POSIX shell dependency");
    assert\isTrue(claude_guard_command().indexOf("buzz -s ") != null, "quiet interpreter");
}

test "no entry carries an environment assignment" {
    // The glue reads the raw-event question off the event and its flags off argv, so the
    // only assignment an entry makes is the launcher's own choice of interpreter.
    foreach (block in claude_entries()) {
        foreach (entry in block["entries"] as [any]) {
            foreach (hook in entry["hooks"] as [any]) {
                final cmd = "{hook["command"]}";
                assert\isTrue(cmd.indexOf("HOST_EVENT_RAW") == null, "the event decides that, not the entry: {cmd}");
                assert\isTrue(cmd.indexOf("__MAGUS_SHELL_FLAGS") == null, "shell flags ride after --: {cmd}");
                final launched = cmd.indexOf("exec \"$m\" ");
                if (launched != null) {
                    final argv = cmd.sub(launched! + 9);
                    assert\isTrue(argv.split(" ")[0].indexOf("=") == null, "the exec'd argv starts with a subcommand: {cmd}");
                }
            }
        }
    }
}

test "the spawn entry also sees every continuation" {
    final pre = claude_entries()[0];
    var matched = "";
    foreach (entry in pre["entries"] as [any]) {
        foreach (hook in entry["hooks"] as [any]) {
            if (((hook["command"] as? str) ?? "") == claude_launch(claude_agent_command(), missing: BLOCKS)) { matched = (entry["matcher"] as? str) ?? ""; }
        }
    }
    assert\equal(matched, "Agent|Task|SendMessage", "spawn and continue share one entry, and so one verdict path");
}

test "the one per-entry flag rides after the argv separator" {
    // Only the spawn surface declares a capability, and it is the only entry that differs
    // from the bare guard command at all.
    assert\equal(claude_agent_command(), claude_guard_command() + " --observes-skill-loads",
        "the spawn entry is the guard command plus one forwarded flag");
}

test "every glue entry names this host, and the rehydrate wrapper takes no argument" {
    // The glue reads the host from this argument and nowhere else, and refuses a call
    // without it, so every entry that reaches the glue carries the declaration's own name.
    final named = " -- --agent-name {mgs_getName()}";
    assert\isTrue(claude_guard_command().endsWith(named), "command, mcp and skill surfaces");
    assert\isTrue(claude_path_command().endsWith(named), "path surface");
    assert\isTrue(claude_observe_command().endsWith(named), "read surface");
    assert\isTrue(claude_checkpoint_command().endsWith(named), "Stop checkpoint");
    assert\isTrue(claude_agent_command().indexOf(named) != null, "spawn surface");
    assert\isTrue(claude_rehydrate_command().indexOf("--agent-name") == null,
        "rehydrate reads no host, and would report the argument as unsupported");
}

// The spawn entry claims loads are REPORTED, and only the skill matcher reports them. Left
// to a comment, dropping the matcher leaves the claim standing, and guard.denySpawnWithoutBrief
// then denies every spawn over a load the host can no longer observe. Derived from the
// entries rather than pinned as a pair, so the coupling is what fails when it breaks.
test "the spawn entry declares observed skill loads only while a matcher reports them" {
    final pre = claude_entries()[0];
    var reports_loads = false;
    var claims_loads = false;
    foreach (entry in pre["entries"] as [any]) {
        final matcher = (entry["matcher"] as? str) ?? "";
        if (matcher == SKILL_MATCHER) { reports_loads = true; }
        foreach (hook in entry["hooks"] as [any]) {
            final command = (hook["command"] as? str) ?? "";
            if (command.indexOf("--observes-skill-loads") != null) { claims_loads = true; }
        }
    }
    assert\equal(claims_loads, reports_loads,
        "an entry declares --observes-skill-loads exactly when a matcher reports them");
}

test "the lifecycle wrappers name the Buzz ports too" {
    // The glue is Buzz everywhere; the only shell left is the launcher every entry shares,
    // so no entry depends on a script file the others do not.
    assert\isTrue(claude_rehydrate_command().indexOf("magus-rehydrate.buzz") != null, "SessionStart rehydrate");
    assert\isTrue(claude_checkpoint_command().indexOf("magus-checkpoint.buzz") != null, "Stop checkpoint");
    foreach (block in claude_entries()) {
        foreach (entry in block["entries"] as [any]) {
            foreach (hook in entry["hooks"] as [any]) {
                final cmd = "{hook["command"]}";
                assert\isTrue(cmd.indexOf(".sh") == null, "no entry wires a shell script");
            }
        }
    }
}

test "the interpreter is the same string on every machine" {
    // A CONSTANT, not a probe. Resolving it per machine wrote whichever answer the
    // merging checkout happened to have into a COMMITTED config, so every other
    // checkout computed the other one and reported the harness uncovered. The host
    // expands CLAUDE_PROJECT_DIR, so the string names no machine's layout.
    final launched = claude_launch(claude_guard_command(), missing: BLOCKS);
    assert\isTrue(launched.startsWith("m=\"$CLAUDE_PROJECT_DIR/magus\"; [ -x \"$m\" ] || m=$(command -v magus); "),
        "the session root's build first, then PATH");
    assert\isTrue(launched.endsWith("exec \"$m\" " + claude_guard_command()), "and the glue runs under whichever was found");
    assert\isTrue(launched.indexOf("/Users/") == null and launched.indexOf("/home/") == null, "no absolute path");
    // Every surface, because one command built by hand rather than through the helper
    // is one entry describe keeps replacing against a config that already holds it.
    assert\isTrue(claude_guard_command().startsWith("buzz -s "), "command mcp and skill surfaces");
    assert\isTrue(claude_agent_command().startsWith("buzz -s "), "spawn surface");
    assert\isTrue(claude_path_command().startsWith("buzz -s "), "path surface");
    assert\isTrue(claude_observe_command().startsWith("buzz -s "), "read surface");
    assert\isTrue(claude_rehydrate_command().startsWith("buzz -s "), "SessionStart rehydrate");
    assert\isTrue(claude_checkpoint_command().startsWith("buzz -s "), "Stop checkpoint");
}

// A missing interpreter exited 127 here, which Claude Code reads as a non-blocking error:
// a whole session ran with every guard rule open and nothing said so.
test "a PreToolUse entry blocks when no magus resolves, except the bootstrap" {
    foreach (entry in claude_entries()[0]["entries"] as [any]) {
        final cmd = "{(entry["hooks"] as [any])[0]["command"]}";
        assert\isTrue(cmd.indexOf(">&2; exit 2; fi; ") != null, "refuses with the one blocking code: {cmd}");
        assert\isTrue(cmd.indexOf("build one: {BOOTSTRAP}") != null, "and names the command that fixes it: {cmd}");
        // The closing quote is what keeps `<bootstrap> && anything` from riding through.
        assert\isTrue(cmd.indexOf("grep -Fq '\"command\":\"{BOOTSTRAP}\"' && exit 0; ") != null,
            "the bootstrap alone is let through, or a fresh checkout could never build: {cmd}");
    }
}

test "no entry outside PreToolUse blocks on a missing magus" {
    final entries = claude_entries();
    var i = 1;
    while (i < entries.len()) {
        foreach (entry in entries[i]["entries"] as [any]) {
            final cmd = "{(entry["hooks"] as [any])[0]["command"]}";
            assert\isTrue(cmd.indexOf("exit 2") == null, "exit 2 on Stop would keep the agent from stopping: {cmd}");
            assert\isTrue(cmd.indexOf("grep") == null, "only a blocking entry needs the bootstrap exemption: {cmd}");
        }
        i = i + 1;
    }
}

test "the session PATH entry is the only one that runs no magus" {
    final pathless = mut [<str>];
    foreach (block in claude_entries()) {
        foreach (entry in block["entries"] as [any]) {
            final cmd = "{(entry["hooks"] as [any])[0]["command"]}";
            if (cmd.indexOf("exec \"$m\" buzz -s ") == null) { pathless.append(cmd); }
        }
    }
    assert\equal(pathless.len(), 1, "every other entry launches the glue");
    assert\equal(pathless[0], claude_session_path_command(), "and that one fixes PATH");
    final cmd = claude_session_path_command();
    assert\isTrue(cmd.indexOf(">> \"$CLAUDE_ENV_FILE\"") != null, "appends, keeping what other hooks wrote");
    assert\isTrue(cmd.indexOf("printf 'export PATH=\"%s:$PATH\"\\n' \"$CLAUDE_PROJECT_DIR\"") != null,
        "the root goes first, and $PATH stays for the Bash tool's shell to expand");
    assert\isTrue(cmd.indexOf(BOOTSTRAP) != null, "a session with no magus learns the fix at start");
}

test "harness_entries covers PreToolUse PostToolUse SessionStart Stop and SubagentStop" {
    final entries = claude_entries();
    assert\equal(entries.len(), 5, "five managed path blocks");
    final pre = entries[0];
    final pre_path = pre["path"] as [str];
    assert\equal(pre_path[1], "PreToolUse", "command path mcp and read ride PreToolUse");
    final pre_entries = pre["entries"] as [any];
    assert\equal(pre_entries.len(), 7, "Bash path mcp Read-observe Read-guard skill and spawn matchers");
    foreach (entry in pre_entries) {
        final hooks = entry["hooks"] as [any];
        assert\equal(hooks.len(), 1, "one command hook per matcher");
        assert\equal("{hooks[0]["type"]}", "command", "Claude Code hook type");
        // `as?` rather than `as`: a bare cast COERCES, so a timeout written 10.0 would
        // pass the assertion whose job is noticing that the emitted JSON changed.
        assert\equal(hooks[0]["timeout"] as? int, 10, "timeout seconds");
        // Interpolating an absent key renders "null", four characters, so a length test
        // over the rendered form passes for an entry carrying no matcher at all.
        final matcher = entry["matcher"] as? str;
        assert\isTrue(matcher != null and matcher!.len() > 0, "matcher present");
    }
    final post = entries[1];
    final post_path = post["path"] as [str];
    assert\equal(post_path[1], "PostToolUse", "a finished spawn reports its child's id");
    final post_entries = post["entries"] as [any];
    assert\equal(post_entries.len(), 1, "only the spawn matcher runs after the call");
    assert\equal(post_entries[0]["matcher"] as? str, SPAWN_MATCHER, "the same tools the spawn surface matches");
    final start = entries[2];
    final start_path = start["path"] as [str];
    assert\equal(start_path[1], "SessionStart", "PATH on a fresh start, rehydrate on compact");
    final start_entries = start["entries"] as [any];
    assert\equal(start_entries.len(), 2, "the PATH entry and the rehydrate entry");
    assert\equal(start_entries[0]["matcher"] as? str, SESSION_PATH_MATCHER, "every start that gets a fresh env file");
    assert\equal(start_entries[1]["matcher"] as? str, "compact", "rehydrate");
    final stop = entries[3];
    final stop_path = stop["path"] as [str];
    assert\equal(stop_path[1], "Stop", "checkpoint");
    final subagent = entries[4];
    final subagent_path = subagent["path"] as [str];
    assert\equal(subagent_path[1], "SubagentStop", "a subagent's usage for a later continue");
    final subagent_entries = subagent["entries"] as [any];
    final subagent_hooks = subagent_entries[0]["hooks"] as [any];
    assert\equal("{subagent_hooks[0]["command"]}", claude_launch(claude_guard_command(), missing: REPORTS),
        "the guard glue reads the stop whole");
}

test "harness_mcp registers a per-checkout stdio server" {
    final mcp = claude_mcp();
    assert\isTrue(mcp["url"] == null, "no url: the Go side reads that as stdio");
    assert\isTrue("{mcp["hint"]}".indexOf("claude mcp add --scope project magus -- __COMMAND__") != null, "names the host CLI");
    assert\isTrue("{mcp["docs"]}".indexOf("mcp.md") != null, "docs pointer");
}

test "harness_* contract wrappers return the same pure helpers" {
    // These wrappers ignore both arguments, which is what lets a test call them with no
    // target at all. gopherbuzz's checker accepts the null for a declared Target; a
    // stricter one would not, so this is the shape magus calls them with, not a legal one.
    final noTarget = null;
    final cb = fun(_: any) > void {};
    assert\equal("{harness_config(noTarget, cb)["path"]}", claude_config_path(), "config path");
    assert\equal("{harness_skills(noTarget, cb)["form"]}", claude_skills_form(), "skills form");
    assert\equal(harness_entries(noTarget, cb).len(), claude_entries().len(), "entries length");
    assert\equal("{harness_mcp(noTarget, cb)["docs"]}", "docs/guides/integrations/mcp.md", "mcp docs");
}
