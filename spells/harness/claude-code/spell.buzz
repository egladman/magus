// Claude Code agent-host harness. Same provider-style spell contract as
// spells/harness/cursor and spells/harness/codex: selected from a magusfile
// with magus\harness.provider, not a JSON file under harnesses/.
//
//   import "spells/harness/claude-code" as claude
//   magus\harness.provider(claude)
//
// To adapt without modifying Magus source: copy this spell into the workspace,
// change only the import path (keep provider), edit Buzz, then
// merge what `magus describe harness claude-code` prints. See magus-workspace-rules
// "Adapting a Buzz harness".
//
// Magus invokes the reserved harness_* names on describe/verify. The fragments are
// opaque host JSON; Magus prints them for a person to merge and does not rewrite command
// fields.

import "magus/spell";
import "assert";

export fun mgs_getName() > str { return "claude-code"; }

fun claude_config_path() > str { return ".claude/settings.json"; }

fun claude_skills_form() > str { return "both"; }

fun claude_skills_paths() > [str] {
    return [".claude/skills"];
}

// claude_buzz_command is one glue script as a plain magus command line.
//
// PATH's magus, because this spell ships to workspaces that build no magus of their own.
// One that does is still judged by its own build: magus re-execs into the ./magus of the
// tree -C names before it does anything else. Claude Code exports CLAUDE_PROJECT_DIR, the
// root the session started in, to every hook command, so the string is the same on every
// machine. -C makes that root the working directory first, so the root-relative script
// path resolves wherever the session is; the glue reads the session's own directory off
// the event.
//
// With no magus on PATH the command exits 127, which Claude Code reports and does not
// treat as a block: the guard is open until one resolves.
//
// `-s` keeps the interpreter quiet: `magus buzz` reports an unused import and other
// BZZ advisories on stderr, and Claude Code shows a hook's first stderr line as an
// error notice, so an advisory about the glue would read as a guard failure. Real
// errors still print, which is what makes a broken hook visible rather than silent.
//
// Flags a single entry declares ride after `--`, which `magus buzz` forwards to the
// script as its own argv, never in a leading `VAR=value`: the glue reads everything it
// acts on off the event and its argv.
fun claude_buzz_command(script: str, flags: [str]) > str {
    final base = "magus buzz -C \"$CLAUDE_PROJECT_DIR\" -s docs/guides/integrations/agents/{script}.buzz";
    if (flags.len() == 0) { return base; }
    return base + " -- " + flags.join(" ");
}

// claude_named_command is a glue command that names this host: `--agent-name` and the
// spell's own mgs_getName(), the one identity the glue acts on. Rendered here, from the
// declaration, so the name on the command cannot drift from the harness it belongs to;
// the glue refuses a call without it (MGS3024) rather than guessing a host.
fun claude_named_command(script: str, flags: [str]) > str {
    final named = mut ["--agent-name", mgs_getName()];
    foreach (flag in flags) { named.append(flag); }
    return claude_buzz_command(script, flags: named);
}

fun claude_glue_command(input: str, flags: [str]) > str {
    return claude_named_command("magus-{input}", flags: flags);
}

// Declared on every entry that judges, because THIS config wires SKILL_MATCHER. A rule
// that requires a skill before an act can only be satisfied where loads are reported, so
// the wiring that reports them is what declares it; a harness without that matcher passes
// nothing and those rules stand down rather than denying forever. It is the one thing an
// entry knows that the event cannot say, which is why it is the one thing written on it.
final REPORTS_SKILLS = "--reports-skills";

// The Bash, MCP, Skill, spawn and message entries all take this one string. Their payloads
// differ, but each has to reach `magus shell` whole or as the one field the glue selects,
// and the glue reads which off the event rather than off the entry, so there is nothing
// else to write on it.
fun claude_guard_command() > str {
    return claude_glue_command("command", flags: [REPORTS_SKILLS]);
}

fun claude_path_command() > str {
    return claude_glue_command("path", flags: [REPORTS_SKILLS]);
}

fun claude_observe_command() > str {
    return claude_glue_command("observe", flags: [<str>]);
}

// The matcher that makes skill loads reportable, named once so the entry that DECLARES
// they are reported can be checked against the entry that produces them. "Keep the two
// in step" used to be a comment; the invariant test below is what keeps them.
final SKILL_MATCHER = "Skill";

// Both names the spawn tool has had across Claude Code releases. The same matcher runs
// after the call too: the finished call's response carries the id the child was given,
// which is what lets that child's own spawns name their parent.
final SPAWN_MATCHER = "Agent|Task";

// A message to a subagent that already exists, so a workspace spawn rule sees every
// continuation as well as every spawn.
final CONTINUE_MATCHER = "SendMessage";

// The lifecycle wrappers judge nothing, which is why they are built from
// claude_buzz_command directly: their names are their own rather than an entry of the
// hook template.
fun claude_rehydrate_command() > str {
    return claude_buzz_command("magus-rehydrate", flags: [<str>]);
}

fun claude_checkpoint_command() > str {
    return claude_named_command("magus-checkpoint", flags: [<str>]);
}

// claude_session_command puts the root first on PATH for the agent's own Bash tool
// commands, and through them everything those commands start, so `magus` typed there is
// the checkout's build rather than whatever the shell that launched Claude Code had.
// CLAUDE_ENV_FILE is the file Claude Code sources before each Bash tool command; it
// never reaches a hook command (code.claude.com/docs/en/hooks, "Persist environment
// variables").
fun claude_session_command() > str {
    return claude_buzz_command("magus-session", flags: ["--env-file", "\"$CLAUDE_ENV_FILE\""]);
}

fun claude_command_hook(cmd: str) > {str: any} {
    return {
        "type": "command",
        "command": cmd,
        "timeout": 10,
    };
}

fun claude_matched_entry(matcher: str, cmd: str) > {str: any} {
    return {
        "matcher": matcher,
        "hooks": [claude_command_hook(cmd)],
    };
}

// The session starts that get a fresh CLAUDE_ENV_FILE. compact keeps the session's
// environment and only rehydrates.
final SESSION_PATH_MATCHER = "startup|resume|clear";

fun claude_entries() > [any] {
    return [
        {
            "path": ["hooks", "PreToolUse"],
            "entries": [
                claude_matched_entry("Bash", cmd: claude_guard_command()),
                claude_matched_entry("Edit|Write|NotebookEdit", cmd: claude_path_command()),
                claude_matched_entry("^mcp__magus__", cmd: claude_guard_command()),
                claude_matched_entry("Read", cmd: claude_observe_command()),
                // The glue restates a Read as the `cat` or `sed -n` line it stands for, so
                // the read rules judge it like the shell read it replaces.
                claude_matched_entry("Read", cmd: claude_guard_command()),
                // Likewise a content or file search as the rg or find line it stands for,
                // so the symbol-search and listing rules hold whichever way it was asked.
                claude_matched_entry("Grep|Glob", cmd: claude_guard_command()),
                claude_matched_entry(SKILL_MATCHER, cmd: claude_guard_command()),
                claude_matched_entry(SPAWN_MATCHER + "|" + CONTINUE_MATCHER, cmd: claude_guard_command()),
            ],
        },
        {
            "path": ["hooks", "PostToolUse"],
            "entries": [
                claude_matched_entry(SPAWN_MATCHER, cmd: claude_guard_command()),
            ],
        },
        {
            "path": ["hooks", "SessionStart"],
            "entries": [
                claude_matched_entry(SESSION_PATH_MATCHER, cmd: claude_session_command()),
                claude_matched_entry("compact", cmd: claude_rehydrate_command()),
            ],
        },
        {
            "path": ["hooks", "Stop"],
            "entries": [
                {
                    "hooks": [claude_command_hook(claude_checkpoint_command())],
                },
            ],
        },
        // A subagent's stop carries the path of its own transcript, whose last usage
        // record is the context a later continue to it would resume. It judges nothing.
        {
            "path": ["hooks", "SubagentStop"],
            "entries": [
                {
                    "hooks": [claude_command_hook(claude_guard_command())],
                },
            ],
        },
        // The person's message, which the glue hands to `magus shell --message` and answers
        // with nothing: it records the topics a later rule reads, and changes no verdict
        // on the message itself.
        {
            "path": ["hooks", "UserPromptSubmit"],
            "entries": [
                {
                    "hooks": [claude_command_hook(claude_guard_command())],
                },
            ],
        },
    ];
}

// claude_config_env is the settings "env" object: Claude Code sets it on the session, so
// every Bash tool command the agent runs inherits it (testdata/hosts/claude-code/
// settings.schema.json, "env"). MAGUS_LOG_SILENT=true is -s for every one of them; a
// value the person already set stays.
fun claude_config_env() > {str: str} {
    return {"MAGUS_LOG_SILENT": "true"};
}

fun claude_config() > {str: any} {
    return {
        "path": claude_config_path(),
        "defaults": {"env": claude_config_env()},
    };
}

fun claude_skills() > {str: any} {
    return {
        "paths": claude_skills_paths(),
        "form": claude_skills_form(),
    };
}

export fun harness_config(target: Target, cb: fun(any)) > {str: any} {
    return claude_config();
}

export fun harness_skills(target: Target, cb: fun(any)) > {str: any} {
    return claude_skills();
}

export fun harness_entries(target: Target, cb: fun(any)) > [any] {
    return claude_entries();
}

fun claude_mcp() > {str: any} {
    // User owns Claude Code MCP registration. Magus prints the host CLI sketch. Project
    // scope lands in .mcp.json, which every worktree carries, so each checkout's session
    // starts its own __COMMAND__.
    final hint = "Register Magus MCP for this project (writes .mcp.json):\n"
        + "  claude mcp add --scope project magus -- __COMMAND__\n"
        + "A project entry named magus takes precedence over a user-scope one. Restart the Claude Code session afterward.";
    return {
        "hint": hint,
        "docs": "docs/guides/integrations/mcp.md",
        "register": [
            "claude", "mcp", "add",
            "--scope", "project",
            "magus", "--", "./magus", "mcp",
        ],
    };
}

export fun harness_mcp(target: Target, cb: fun(any)) > {str: any} {
    return claude_mcp();
}

// claude_yaml_quote renders text as a YAML double-quoted scalar, so a colon, a quote or a
// newline in a description cannot change what the frontmatter means.
fun claude_yaml_quote(text: str) > str {
    final escaped = text.replace("\\", with: "\\\\").replace("\"", with: "\\\"").replace("\n", with: "\\n").replace("\r", with: "\\r").replace("\t", with: "\\t");
    return "\"" + escaped + "\"";
}

// claude_agent renders one shipped agent as a Claude Code subagent file. A read-only agent
// is limited to the tools that cannot change the workspace, and the economy class runs on
// Claude Code's cheapest model alias.
fun claude_agent(agent: {str: any}) > {str: any} {
    final name = "{agent["name"]}";
    var content = "---\nname: " + claude_yaml_quote(name) + "\ndescription: " + claude_yaml_quote("{agent["description"]}") + "\n";
    if (agent["read_only"] == true) {
        content = content + "tools: Read, Grep, Glob, Bash\n";
    }
    if ("{agent["class"]}" == "economy") {
        content = content + "model: haiku\n";
    }
    content = content + "---\n\n" + "{agent["instructions"]}".trim() + "\n";
    return {
        "path": ".claude/agents/{name}.md",
        "content": content,
    };
}

fun claude_agents(agents: [any]) > [any] {
    final files: mut [any] = mut [];
    foreach (agent in agents) {
        files.append(claude_agent(agent as {str: any}));
    }
    return files;
}

// harness_agents receives the shipped agents as req["agents"]. A call with none renders none.
export fun harness_agents(target: Target, cb: fun(any)) > [any] {
    final req = {<str: any>};
    cb(req);
    final agents = req["agents"];
    if (agents == null) { return []; }
    return claude_agents(agents as [any]);
}

fun claude_scout_fixture(read_only: bool, class: str) > {str: any} {
    return {
        "name": "magus-scout",
        "description": "Answers lookups: read-only, \"quoted\" and \\ escaped.",
        "instructions": "First line.\n\nSecond line.\n",
        "read_only": read_only,
        "class": class,
    };
}

test "harness_agents renders a read-only economy agent with limited tools and the cheap model" {
    final file = claude_agent(claude_scout_fixture(true, class: "economy"));
    assert\equal("{file["path"]}", ".claude/agents/magus-scout.md", "Claude Code reads .claude/agents");
    assert\equal(
        "{file["content"]}",
        "---\nname: \"magus-scout\"\ndescription: \"Answers lookups: read-only, \\\"quoted\\\" and \\\\ escaped.\"\ntools: Read, Grep, Glob, Bash\nmodel: haiku\n---\n\nFirst line.\n\nSecond line.\n",
        "frontmatter then the instructions",
    );
}

test "harness_agents leaves tools and model unset for a writable agent of another class" {
    final content = "{claude_agent(claude_scout_fixture(false, class: "standard"))["content"]}";
    assert\isTrue(content.indexOf("tools:") == null, "no tool restriction");
    assert\isTrue(content.indexOf("model:") == null, "the host default model applies");
}

test "harness_agents renders nothing when the call carries no agents" {
    final noTarget = null;
    final cb = fun(_: any) > void {};
    assert\equal(harness_agents(noTarget, cb).len(), 0, "no agents, no files");
}

test "claude_agents renders one file per agent, in order" {
    final files = claude_agents([claude_scout_fixture(true, class: "economy"), claude_scout_fixture(false, class: "standard")]);
    assert\equal(files.len(), 2, "one file per agent");
    assert\equal("{files[1]["path"]}", ".claude/agents/magus-scout.md", "path");
}

test "mgs_getName is the harness id describe and verify look up" {
    assert\equal(mgs_getName(), "claude-code", "id must match magus\\harness.provider wiring and --id");
}

test "harness_config names Claude Code settings" {
    assert\equal(claude_config_path(), ".claude/settings.json", "workspace-relative host config path");
    final cfg = claude_config();
    assert\equal("{cfg["path"]}", ".claude/settings.json", "config map carries the same path");
}

test "harness_config makes every Bash tool command quiet" {
    final defaults = claude_config()["defaults"] as {str: any};
    final env = defaults["env"] as {str: str};
    assert\equal(env.len(), 1, "one variable, magus's own");
    assert\equal(env["MAGUS_LOG_SILENT"], "true", "the settings env object Claude Code sets on the session");
}

test "harness_skills installs both forms under .claude/skills" {
    assert\equal(claude_skills_form(), "both", "matches the JSON descriptor");
    final skills = claude_skills();
    assert\equal("{skills["form"]}", "both", "skills map carries the form");
    final paths = skills["paths"] as [str];
    assert\equal(paths.len(), 1, "one skills install path");
    assert\equal(paths[0], ".claude/skills", "Claude Code reads .claude/skills");
}

test "a Read is both recorded and judged" {
    var observed = false;
    var judged = false;
    foreach (entry in claude_entries()[0]["entries"] as [any]) {
        if ((entry["matcher"] as? str) != "Read") { continue; }
        foreach (hook in entry["hooks"] as [any]) {
            final command = (hook["command"] as? str) ?? "";
            if (command == claude_observe_command()) { observed = true; }
            if (command == claude_guard_command()) { judged = true; }
        }
    }
    assert\isTrue(observed, "the observer records the path");
    assert\isTrue(judged, "the command guard judges the read it stands for");
}

test "guard commands name the Buzz glue, never the sh copies" {
    assert\isTrue(claude_guard_command().indexOf("magus-command.buzz") != null, "command hook");
    assert\isTrue(claude_path_command().indexOf("magus-path.buzz") != null, "path hook");
    assert\isTrue(claude_observe_command().indexOf("magus-observe.buzz") != null, "read observe");
    assert\isTrue(claude_guard_command().indexOf(".sh") == null, "no POSIX shell dependency");
    assert\isTrue(claude_guard_command().indexOf(" -s docs/") != null, "quiet interpreter");
}

test "no entry carries an environment assignment" {
    // The glue reads the raw-event question off the event and its flags off argv, so an
    // entry is the binary and its arguments and nothing else.
    foreach (block in claude_entries()) {
        foreach (entry in block["entries"] as [any]) {
            foreach (hook in entry["hooks"] as [any]) {
                final cmd = "{hook["command"]}";
                assert\isTrue(cmd.indexOf("HOST_EVENT_RAW") == null, "the event decides that, not the entry: {cmd}");
                assert\isTrue(cmd.indexOf("__MAGUS_SHELL_FLAGS") == null, "shell flags ride after --: {cmd}");
                assert\isTrue(cmd.startsWith("magus buzz -C "), "the argv starts with the binary: {cmd}");
            }
        }
    }
}

test "the spawn entry also sees every continuation" {
    final pre = claude_entries()[0];
    var matched = "";
    var command = "";
    foreach (entry in pre["entries"] as [any]) {
        final matcher = (entry["matcher"] as? str) ?? "";
        if (matcher.startsWith(SPAWN_MATCHER)) {
            matched = matcher;
            command = "{(entry["hooks"] as [any])[0]["command"]}";
        }
    }
    assert\equal(matched, "Agent|Task|SendMessage", "spawn and continue share one entry, and so one verdict path");
    assert\equal(command, claude_guard_command(), "the spawn entry is the guard command");
}

test "the one per-entry flag rides after the argv separator" {
    assert\equal(claude_guard_command(), claude_glue_command("command", flags: [<str>]) + " " + REPORTS_SKILLS,
        "the guard entry is the named glue command plus one forwarded flag");
    assert\equal(claude_path_command(), claude_glue_command("path", flags: [<str>]) + " " + REPORTS_SKILLS,
        "the path entry is the named glue command plus one forwarded flag");
}

test "every glue entry names this host, and the rehydrate wrapper takes no argument" {
    // The glue reads the host from this argument and nowhere else, and refuses a call
    // without it, so every entry that reaches the glue carries the declaration's own name.
    final named = " -- --agent-name {mgs_getName()}";
    assert\isTrue(claude_guard_command().indexOf(named) != null, "command, mcp, skill, spawn and message hooks");
    assert\isTrue(claude_path_command().indexOf(named) != null, "path hook");
    assert\isTrue(claude_observe_command().endsWith(named), "read hook");
    assert\isTrue(claude_checkpoint_command().endsWith(named), "Stop checkpoint");
    assert\isTrue(claude_rehydrate_command().indexOf("--agent-name") == null,
        "rehydrate reads no host, and would report the argument as unsupported");
}

// The judging entries claim loads are REPORTED, and only the skill matcher reports them.
// Left to a comment, dropping the matcher leaves the claim standing, and every skill gate
// then denies over a load the host can no longer report. Derived from the entries rather
// than pinned as a pair, so the coupling is what fails when it breaks.
test "every judging entry declares reports-skills exactly while a matcher reports them" {
    var reports_loads = false;
    foreach (entry in claude_entries()[0]["entries"] as [any]) {
        if (((entry["matcher"] as? str) ?? "") == SKILL_MATCHER) { reports_loads = true; }
    }
    foreach (block in claude_entries()) {
        foreach (entry in block["entries"] as [any]) {
            foreach (hook in entry["hooks"] as [any]) {
                final command = (hook["command"] as? str) ?? "";
                final claims = command.indexOf(REPORTS_SKILLS) != null;
                if (command.indexOf("magus-command.buzz") != null or command.indexOf("magus-path.buzz") != null) {
                    assert\equal(claims, reports_loads,
                        "a judging entry declares the flag exactly when a matcher reports loads: {command}");
                } else {
                    assert\isTrue(!claims, "a glue that judges nothing takes no capability: {command}");
                }
            }
        }
    }
}

test "the message entry is the guard glue, unmatched" {
    var found = false;
    foreach (block in claude_entries()) {
        if ((block["path"] as [str])[1] != "UserPromptSubmit") { continue; }
        found = true;
        final entries = block["entries"] as [any];
        assert\equal(entries.len(), 1, "one message entry");
        assert\isTrue(entries[0]["matcher"] == null, "a message event takes no matcher");
        assert\equal("{(entries[0]["hooks"] as [any])[0]["command"]}", claude_guard_command(),
            "the glue tells a message from a call by the event's shape");
    }
    assert\isTrue(found, "the message is wired");
}

test "the lifecycle wrappers name the Buzz ports too" {
    // The glue is Buzz everywhere, so no entry depends on a script file the others do not.
    assert\isTrue(claude_rehydrate_command().indexOf("magus-rehydrate.buzz") != null, "SessionStart rehydrate");
    assert\isTrue(claude_checkpoint_command().indexOf("magus-checkpoint.buzz") != null, "Stop checkpoint");
    foreach (block in claude_entries()) {
        foreach (entry in block["entries"] as [any]) {
            foreach (hook in entry["hooks"] as [any]) {
                final cmd = "{hook["command"]}";
                assert\isTrue(cmd.indexOf(".sh") == null, "no entry wires a shell script");
            }
        }
    }
}

test "the interpreter is the same string on every machine" {
    // A CONSTANT, not a probe. Resolving it per machine wrote whichever answer the
    // merging checkout happened to have into a COMMITTED config, so every other
    // checkout computed the other one and reported the harness uncovered. The host
    // expands CLAUDE_PROJECT_DIR, so the string names no machine's layout.
    final head = "magus buzz -C \"$CLAUDE_PROJECT_DIR\" -s docs/guides/integrations/agents/";
    // Every hook, because one command built by hand rather than through the helper
    // is one entry describe keeps replacing against a config that already holds it.
    assert\isTrue(claude_guard_command().startsWith(head), "command mcp and skill hooks");
    assert\isTrue(claude_path_command().startsWith(head), "path hook");
    assert\isTrue(claude_observe_command().startsWith(head), "read hook");
    assert\isTrue(claude_rehydrate_command().startsWith(head), "SessionStart rehydrate");
    assert\isTrue(claude_checkpoint_command().startsWith(head), "Stop checkpoint");
    assert\isTrue(claude_session_command().startsWith(head), "SessionStart PATH");
    assert\isTrue(claude_guard_command().indexOf("/Users/") == null and claude_guard_command().indexOf("/home/") == null,
        "no absolute path");
}

// Every entry runs a template magus ships, which is the mark a merge retires it by, so
// none needs the `# magus:harness` marker an adapted entry carries.
test "every entry runs a shipped template and nothing else" {
    foreach (block in claude_entries()) {
        foreach (entry in block["entries"] as [any]) {
            final cmd = "{(entry["hooks"] as [any])[0]["command"]}";
            assert\isTrue(cmd.indexOf(" -s docs/guides/integrations/agents/magus-") != null, "a shipped template: {cmd}");
            assert\isTrue(cmd.indexOf("#") == null, "no marker: {cmd}");
            foreach (meta in [";", "&&", "||", "|", ">", "$("]) {
                assert\isTrue(cmd.indexOf(meta) == null, "one plain command, no shell around it: {cmd}");
            }
        }
    }
}

test "the session entry hands the glue the file the Bash tool sources" {
    final cmd = claude_session_command();
    assert\isTrue(cmd.endsWith("magus-session.buzz -- --env-file \"$CLAUDE_ENV_FILE\""), cmd);
}

test "harness_entries covers PreToolUse PostToolUse SessionStart Stop SubagentStop and UserPromptSubmit" {
    final entries = claude_entries();
    assert\equal(entries.len(), 6, "six managed path blocks");
    final pre = entries[0];
    final pre_path = pre["path"] as [str];
    assert\equal(pre_path[1], "PreToolUse", "command path mcp and read ride PreToolUse");
    final pre_entries = pre["entries"] as [any];
    assert\equal(pre_entries.len(), 8, "Bash path mcp Read-observe Read-guard search skill and spawn matchers");
    foreach (entry in pre_entries) {
        final hooks = entry["hooks"] as [any];
        assert\equal(hooks.len(), 1, "one command hook per matcher");
        assert\equal("{hooks[0]["type"]}", "command", "Claude Code hook type");
        // `as?` rather than `as`: a bare cast COERCES, so a timeout written 10.0 would
        // pass the assertion whose job is noticing that the emitted JSON changed.
        assert\equal(hooks[0]["timeout"] as? int, 10, "timeout seconds");
        // Interpolating an absent key renders "null", four characters, so a length test
        // over the rendered form passes for an entry carrying no matcher at all.
        final matcher = entry["matcher"] as? str;
        assert\isTrue(matcher != null and matcher!.len() > 0, "matcher present");
    }
    final post = entries[1];
    final post_path = post["path"] as [str];
    assert\equal(post_path[1], "PostToolUse", "a finished spawn reports its child's id");
    final post_entries = post["entries"] as [any];
    assert\equal(post_entries.len(), 1, "only the spawn matcher runs after the call");
    assert\equal(post_entries[0]["matcher"] as? str, SPAWN_MATCHER, "the same tools the spawn hook matches");
    final start = entries[2];
    final start_path = start["path"] as [str];
    assert\equal(start_path[1], "SessionStart", "PATH on a fresh start, rehydrate on compact");
    final start_entries = start["entries"] as [any];
    assert\equal(start_entries.len(), 2, "the PATH entry and the rehydrate entry");
    assert\equal(start_entries[0]["matcher"] as? str, SESSION_PATH_MATCHER, "every start that gets a fresh env file");
    assert\equal(start_entries[1]["matcher"] as? str, "compact", "rehydrate");
    final stop = entries[3];
    final stop_path = stop["path"] as [str];
    assert\equal(stop_path[1], "Stop", "checkpoint");
    final subagent = entries[4];
    final subagent_path = subagent["path"] as [str];
    assert\equal(subagent_path[1], "SubagentStop", "a subagent's usage for a later continue");
    final subagent_entries = subagent["entries"] as [any];
    final subagent_hooks = subagent_entries[0]["hooks"] as [any];
    assert\equal("{subagent_hooks[0]["command"]}", claude_guard_command(),
        "the guard glue reads the stop whole");
    final message_path = entries[5]["path"] as [str];
    assert\equal(message_path[1], "UserPromptSubmit", "the person's message, recorded and never answered");
}

test "harness_mcp registers a per-checkout stdio server" {
    final mcp = claude_mcp();
    assert\isTrue(mcp["url"] == null, "no url: the Go side reads that as stdio");
    assert\isTrue("{mcp["hint"]}".indexOf("claude mcp add --scope project magus -- __COMMAND__") != null, "names the host CLI");
    assert\isTrue("{mcp["docs"]}".indexOf("mcp.md") != null, "docs pointer");
}

test "harness_* contract wrappers return the same pure helpers" {
    // These wrappers ignore both arguments, which is what lets a test call them with no
    // target at all. gopherbuzz's checker accepts the null for a declared Target; a
    // stricter one would not, so this is the shape magus calls them with, not a legal one.
    final noTarget = null;
    final cb = fun(_: any) > void {};
    assert\equal("{harness_config(noTarget, cb)["path"]}", claude_config_path(), "config path");
    assert\equal("{harness_skills(noTarget, cb)["form"]}", claude_skills_form(), "skills form");
    assert\equal(harness_entries(noTarget, cb).len(), claude_entries().len(), "entries length");
    assert\equal("{harness_mcp(noTarget, cb)["docs"]}", "docs/guides/integrations/mcp.md", "mcp docs");
}
