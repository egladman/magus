// Claude Code agent-host harness. Same harness contract as spells/harness/cursor and
// spells/harness/codex: selected from a magusfile with magus\harness.provider, not a JSON
// file under harnesses/.
//
//   import "spells/harness/claude-code" as claude
//   magus\harness.provider(claude)
//
// To adapt without modifying Magus source: copy this spell into the workspace,
// change only the import path (keep provider), edit Buzz, then
// merge what `magus describe harness claude-code` prints. See magus-workspace-rules
// "Adapting a Buzz harness".
//
// Magus calls the harness contract's mgs_ functions on describe/verify. The entries are
// opaque host JSON; Magus prints them for a person to merge and does not rewrite command
// fields.

import "magus/spell";
import "magus/harness";
import "assert";

export fun mgs_getName() > str { return "claude-code"; }

// Claude Code exports CLAUDE_PROJECT_DIR, the root the session started in, to every hook
// command, so the string is the same on every machine. -C makes that root the working
// directory first, so the root-relative script path resolves wherever the session is; the
// glue reads the session's own directory off the event.
//
// The command runs the checkout's own ./magus when it is executable, so the binary that
// built the tree judges it; an older magus on PATH cannot load a policy that reads a newer
// field. Only a checkout without one falls back to PATH's magus. With neither the command
// exits 127, which Claude Code reports and does not treat as a block: the guard is open
// until one resolves.
final HOOK_DIR = "\"$CLAUDE_PROJECT_DIR\"";

// Declared on every entry that judges, because THIS config wires every tool, the Skill tool
// among them. A rule that requires a skill before an act can only be satisfied where loads
// are reported, so the wiring that reports them is what declares it; a harness that does
// not see skill loads passes nothing and those rules stand down rather than denying forever.
final OBSERVES_SKILL_LOADS = "--observes-skill-loads";

// Claude Code's Bash tool waits 120000 ms on a command that names no timeout and lets one
// name up to 600000 (code.claude.com/docs/en/settings, BASH_DEFAULT_TIMEOUT_MS and
// BASH_MAX_TIMEOUT_MS); past its timeout the command moves to the background. Declared once
// here, rendered onto the catch-all entry and returned by mgs_getLimits.
final FOREGROUND_DEFAULT_MS = 120000;
final FOREGROUND_MAX_MS = 600000;

// How long Claude Code waits on each hook this wiring writes before it stops waiting and
// runs the call. Rendered onto every judging entry and returned by mgs_getLimits.
final HOOK_TIMEOUT_S = 10;

// The first Claude Code release that resumes a stopped subagent when a background task it
// left running completes. Rendered onto the stop entries and returned by mgs_getLimits.
final RESUMES_ON_BACKGROUND_FROM = "2.1.299";

// Every tool, so magus judges every call by its tool and the shape of its input, and a tool
// no rule can read is named rather than run unseen (the unjudged-tool rule). Skill loads
// ride it too, which is what lets the judging entries declare --observes-skill-loads.
final EVERY_TOOL = "*";

// Both names the spawn tool has had across Claude Code releases, matched after the call:
// the finished call's response carries the id the child was given.
final SPAWN_MATCHER = "Agent|Task";

// The tools that write a file, after which the Buzz check runs on a .buzz path.
final WRITE_MATCHER = "Write|Edit|MultiEdit";

// The session starts that get a fresh CLAUDE_ENV_FILE. compact keeps the session's
// environment and only rehydrates.
final SESSION_PATH_MATCHER = "startup|resume|clear";

// The entries that judge no tool call before it runs (a finished spawn, a stop, the
// person's message) take these flags. Each event reaches `magus shell` whole, and magus
// reads what it is off the event.
fun claude_guard_flags() > [str] {
    return ["--agent-name", mgs_getName(), OBSERVES_SKILL_LOADS];
}

// The catch-all entry every tool call reaches. It carries the foreground limits, which the
// glue forwards only for a shell command line, and the tool rows.
fun claude_call_flags() > [str] {
    return [
        "--agent-name", mgs_getName(), OBSERVES_SKILL_LOADS,
        "--foreground-default-ms", "{FOREGROUND_DEFAULT_MS}",
        "--foreground-max-ms", "{FOREGROUND_MAX_MS}",
        "--tool-rows", claude_tools_dir(),
    ];
}

// The stop entries carry the release that resumes a subagent, so a stop that leaves a
// background task running stands where the task's completion wakes it.
fun claude_stop_flags() > [str] {
    return [
        "--agent-name", mgs_getName(), OBSERVES_SKILL_LOADS,
        "--resumes-on-background-from", RESUMES_ON_BACKGROUND_FROM,
    ];
}

fun claude_hook(event: str, matcher: str, script: str, flags: [str]) > HookCommand {
    return HookCommand{event = event, matcher = matcher, script = script, flags = flags, timeoutS = HOOK_TIMEOUT_S};
}

fun claude_buzz_check_hook() > HookCommand {
    final check = buzzCheckHook(mgs_getName());
    return HookCommand{event = check.event, matcher = WRITE_MATCHER, script = check.script, flags = check.flags, timeoutS = check.timeoutS};
}

// Every hook this host runs, in the order its entries render.
fun claude_hooks() > [HookCommand] {
    final named = ["--agent-name", mgs_getName()];
    return [
        // magus restates a read as the `cat` or `sed -n` line it stands for and a search as
        // its rg or find line, so the read and search rules hold whichever tool performs them.
        claude_hook("PreToolUse", matcher: EVERY_TOOL, script: "magus-command", flags: claude_call_flags()),
        // The observer records the path a read reached; it judges nothing.
        claude_hook("PreToolUse", matcher: "Read", script: "magus-observe", flags: named),
        claude_hook("PostToolUse", matcher: SPAWN_MATCHER, script: "magus-command", flags: claude_guard_flags()),
        claude_buzz_check_hook(),
        // PATH's first entry becomes the root for the agent's own Bash tool commands, through
        // CLAUDE_ENV_FILE, the file Claude Code sources before each one; it never reaches a
        // hook command (code.claude.com/docs/en/hooks, "Persist environment variables").
        claude_hook("SessionStart", matcher: SESSION_PATH_MATCHER, script: "magus-session", flags: ["--env-file", "\"$CLAUDE_ENV_FILE\""]),
        claude_hook("SessionStart", matcher: "compact", script: "magus-rehydrate", flags: [<str>]),
        // The guard reads the session's transcript for background tasks left running.
        claude_hook("Stop", matcher: "", script: "magus-command", flags: claude_stop_flags()),
        claude_hook("Stop", matcher: "", script: "magus-checkpoint", flags: named),
        // A subagent's stop carries the path of its own transcript, whose last usage record
        // is the context a later continue to it would resume.
        claude_hook("SubagentStop", matcher: "", script: "magus-command", flags: claude_stop_flags()),
        // The person's message, which the glue hands to `magus shell --message` and answers
        // with nothing: it records the topics a later rule reads.
        claude_hook("UserPromptSubmit", matcher: "", script: "magus-command", flags: claude_guard_flags()),
    ];
}

export fun mgs_listHooks() > [HookCommand] {
    return claude_hooks();
}

fun claude_command(hook: HookCommand) > str {
    return claude_checkout(buzzCommand(HOOK_DIR, script: hook.script, flags: hook.flags));
}

fun claude_guard_command() > str {
    return claude_checkout(namedCommand(HOOK_DIR, agentName: mgs_getName(), script: "magus-command", flags: [OBSERVES_SKILL_LOADS]));
}

fun claude_call_command() > str {
    return claude_checkout(buzzCommand(HOOK_DIR, script: "magus-command", flags: claude_call_flags()));
}

fun claude_observe_command() > str {
    return claude_checkout(namedCommand(HOOK_DIR, agentName: mgs_getName(), script: "magus-observe", flags: [<str>]));
}

fun claude_rehydrate_command() > str {
    return claude_checkout(buzzCommand(HOOK_DIR, script: "magus-rehydrate", flags: [<str>]));
}

fun claude_checkpoint_command() > str {
    return claude_checkout(namedCommand(HOOK_DIR, agentName: mgs_getName(), script: "magus-checkpoint", flags: [<str>]));
}

fun claude_session_command() > str {
    return claude_checkout(buzzCommand(HOOK_DIR, script: "magus-session", flags: ["--env-file", "\"$CLAUDE_ENV_FILE\""]));
}

fun claude_checkout(plain: str) > str {
    return "m={HOOK_DIR}/magus; [ -x \"$m\" ] || m=magus; \"$m\" " + plain.sub("magus ".len(), len: plain.len() - "magus ".len());
}

// claude_entry renders one hook as Claude Code's settings entry: its matcher, when the
// event takes one, and one command hook.
fun claude_entry(hook: HookCommand) > {str: any} {
    final entry = mut {<str: any>};
    if (hook.matcher != "") { entry["matcher"] = hook.matcher; }
    entry["hooks"] = [{"type": "command", "command": claude_command(hook), "timeout": hook.timeoutS}];
    return entry;
}

// claude_entries groups the hooks by event, in the order each event first appears.
fun claude_entries() > [ManagedEntries] {
    final hooks = claude_hooks();
    final events = mut [<str>];
    foreach (hook in hooks) {
        if (events.indexOf(hook.event) == null) { events.append(hook.event); }
    }
    final blocks = mut [<ManagedEntries>];
    foreach (event in events) {
        final entries = mut [<{str: any}>];
        foreach (hook in hooks) {
            if (hook.event == event) { entries.append(claude_entry(hook)); }
        }
        blocks.append(ManagedEntries{path = ["hooks", event], entries = entries});
    }
    return blocks;
}

export fun mgs_listEntries() > [ManagedEntries] {
    return claude_entries();
}

// Where `magus agent harness install` writes this host's tool rows, beside its settings.
fun claude_tools_dir() > str { return ".claude/magus/tools"; }

// Every tool this host offers that the guard should know, by Claude Code's own name and
// what it can do. A tool missing here is one the guard cannot judge (unjudged-tool), so a
// new tool stays refused where that rule denies until a row is added.
fun claude_tools() > [HarnessTool] {
    final rows = mut [<HarnessTool>];
    foreach (name in ["Bash", "Monitor"]) { rows.append(HarnessTool{name = name, capability = ToolCapability.runs}); }
    foreach (name in ["Read", "NotebookRead", "Glob", "Grep", "LS"]) { rows.append(HarnessTool{name = name, capability = ToolCapability.reads}); }
    foreach (name in ["Write", "Edit", "MultiEdit", "NotebookEdit"]) { rows.append(HarnessTool{name = name, capability = ToolCapability.writes}); }
    foreach (name in ["Agent", "Task", "SendMessage"]) { rows.append(HarnessTool{name = name, capability = ToolCapability.spawns}); }
    rows.append(HarnessTool{name = "ReadNotifications", capability = ToolCapability.reads});
    foreach (name in [
        "BashOutput", "KillShell", "TaskOutput", "TaskStop", "TodoWrite", "WebFetch", "WebSearch",
        "ExitPlanMode", "EnterPlanMode", "AskUserQuestion", "Skill", "ToolSearch", "ScheduleWakeup",
        "CronCreate", "ListMcpResourcesTool", "ReadMcpResourceTool", "SubagentHandback", "ListAgents",
        "ListSkills", "SearchSkills", "ListPlugins", "SearchPlugins", "Artifact", "SendUserFile",
    ]) { rows.append(HarnessTool{name = name, capability = ToolCapability.inert}); }
    // The desktop app's in-app browser.
    foreach (tool in [
        "browser_batch", "computer", "find", "form_input", "get_page_text", "javascript_tool", "navigate",
        "preview_list", "preview_logs", "preview_start", "preview_stop", "read_console_messages",
        "read_network_requests", "read_page", "resize_window", "tabs_close", "tabs_context", "tabs_create", "tabs_select",
    ]) { rows.append(HarnessTool{name = "mcp__Claude_Browser__{tool}", capability = ToolCapability.network}); }
    // The desktop app's terminal panel: run_in_terminal carries a command, judged as one.
    foreach (tool in ["run_in_terminal", "read_terminal", "list_terminal_tabs", "open_terminal_tab", "stop_terminal_tab"]) {
        rows.append(HarnessTool{name = "mcp__terminal__{tool}", capability = ToolCapability.runs});
    }
    foreach (row in claude_desktop_tools()) { rows.append(row); }
    return rows;
}

fun ccd_rows(family: str, tools: [str], capability: ToolCapability) > [HarnessTool] {
    return tools.map(fun (index: int, tool: str) > HarnessTool => HarnessTool{name = "mcp__ccd_{family}__{tool}", capability = capability});
}

// The desktop app's own controls, mcp__ccd_<family>__<tool>. mcp__ccd_pr__set_auto_merge
// has no row on purpose: a person enables auto-merge, so unjudged-tool refuses it.
fun claude_desktop_tools() > [HarnessTool] {
    final groups = [
        ccd_rows("session", tools: ["start_session", "hand_off_to_session", "move_to_cloud"], capability: ToolCapability.spawns),
        ccd_rows("session", tools: ["list_start_targets"], capability: ToolCapability.reads),
        ccd_rows("session", tools: ["mark_chapter", "spawn_task", "dismiss_task", "read_widget_context"], capability: ToolCapability.inert),
        ccd_rows("turn", tools: ["update_plan", "wrap_up"], capability: ToolCapability.inert),
        ccd_rows("session_mgmt", tools: ["list_events", "list_sessions"], capability: ToolCapability.reads),
        ccd_rows("session_mgmt", tools: [
            "archive_session", "clear_session", "delete_session", "detach_session", "export_transcript", "get_session",
            "get_usage", "search_session_transcripts", "send_message", "set_remote_control",
            "set_session_effort", "set_session_fast_mode", "set_session_model", "set_session_output_style",
            "set_session_permission_mode", "set_session_title", "stop_session", "unarchive_session",
        ], capability: ToolCapability.inert),
        // sync_with_base_branch moves the checkout's branch; the other two remove worktrees.
        ccd_rows("host", tools: ["sync_with_base_branch", "clean_up_worktrees", "discard_kept_worktree"], capability: ToolCapability.writes),
        ccd_rows("host", tools: ["get_storage_usage"], capability: ToolCapability.reads),
        ccd_rows("host", tools: ["open_in_editor", "request_keep_awake", "reveal_path"], capability: ToolCapability.inert),
        ccd_rows("pr", tools: ["get_status"], capability: ToolCapability.reads),
        ccd_rows("pr", tools: ["bind_pr", "unbind_pr", "set_monitor"], capability: ToolCapability.inert),
        ccd_rows("directory", tools: ["change_directory", "request_directory"], capability: ToolCapability.inert),
        ccd_rows("connectors", tools: ["session_connectors_status"], capability: ToolCapability.reads),
        ccd_rows("connectors", tools: ["reconnect_session_connector", "set_session_connector_enabled"], capability: ToolCapability.inert),
        ccd_rows("view", tools: ["close_pane", "get_layout", "set_transcript_view", "show_pane"], capability: ToolCapability.inert),
        ccd_rows("sidebar", tools: [
            "create_group", "create_section", "delete_group", "delete_section", "list_groups", "list_sections",
            "mark_completed", "move_sessions", "rename_group", "rename_section", "set_pinned", "set_unread", "set_view",
        ], capability: ToolCapability.inert),
        ccd_rows("settings", tools: ["get_settings", "set_setting"], capability: ToolCapability.inert),
        ccd_rows("window", tools: ["close_split", "get_window_layout", "open_session_in", "set_sidebar_collapsed"], capability: ToolCapability.inert),
    ];
    final rows = mut [<HarnessTool>];
    foreach (group in groups) {
        foreach (row in group) { rows.append(row); }
    }
    return rows;
}

export fun mgs_listTools() > HarnessTools {
    return HarnessTools{dir = claude_tools_dir(), rows = claude_tools()};
}

export fun mgs_getLimits() > Limits {
    return Limits{
        foregroundDefaultMs = FOREGROUND_DEFAULT_MS,
        foregroundMaxMs = FOREGROUND_MAX_MS,
        hookTimeoutMs = HOOK_TIMEOUT_S * 1000,
        resumesOnBackgroundFrom = RESUMES_ON_BACKGROUND_FROM,
    };
}

// Read from platform.claude.com/docs/en/about-claude/pricing and written by hand: the Models
// API needs an API key a subscription user does not have, and a hook has no time for a
// network call. A model released after this spell's version matches no row, and the guard's
// cost advice for it falls back to token counts; agents.models in magus.yaml fills the gap.
//
// tier is the case of the shipped model tiers (magus/modeltiers) this exact id runs, "" for
// none: a workspace that declares no tiers of its own maps each case to the row naming it,
// and the agents magus ships run on the economy row. alias is the short name the host takes
// for the model in a spawn, matched exactly, "" for none.
fun claude_model(id: str, tier: str, alias: str, window: int, price: Price) > ModelRow {
    return ModelRow{id = id, tier = tier, alias = alias, window = window, price = price};
}

fun claude_models() > [ModelRow] {
    return [
        claude_model("claude-fable-5-1", tier: "", alias: "", window: 1000000,
            price: Price{input = 10.0, cacheWrite5m = 12.5, cacheWrite1h = 20.0, cacheRead = 0.25, output = 50.0}),
        claude_model("claude-opus-5-5", tier: "principal", alias: "opus", window: 1000000,
            price: Price{input = 4.0, cacheWrite5m = 5.0, cacheWrite1h = 8.0, cacheRead = 0.2, output = 20.0}),
        claude_model("claude-sonnet-5-5", tier: "standard", alias: "sonnet", window: 1000000,
            price: Price{input = 2.0, cacheWrite5m = 2.5, cacheWrite1h = 4.0, cacheRead = 0.1, output = 10.0}),
        // The one current model priced by prompt length: every category is 5x above 100000
        // prompt tokens, cache reads and writes included.
        ModelRow{id = "claude-haiku-5-5", tier = "economy", alias = "haiku", window = 1000000,
            price = Price{input = 0.1, cacheWrite5m = 0.125, cacheWrite1h = 0.2, cacheRead = 0.01, output = 0.5},
            step = PriceStep{above = 100000, multiplier = 5.0}},
        claude_model("claude-haiku-4-5", tier: "", alias: "", window: 200000,
            price: Price{input = 1.0, cacheWrite5m = 1.25, cacheWrite1h = 2.0, cacheRead = 0.1, output = 5.0}),
    ];
}

export fun mgs_listModels() > [ModelRow] {
    return claude_models();
}

// The settings "env" object: Claude Code sets it on the session, so every Bash tool command
// the agent runs inherits it (testdata/hosts/claude-code/settings.schema.json, "env").
// MAGUS_LOG_SILENT=true is -s for every one of them; a value the person already set stays.
export fun mgs_getHarnessConfig() > HarnessConfig {
    return HarnessConfig{path = ".claude/settings.json", defaults = {"env": {"MAGUS_LOG_SILENT": "true"}}};
}

export fun mgs_getSkills() > HarnessSkills {
    return HarnessSkills{paths = [".claude/skills"], form = SkillForm.both};
}

// User owns Claude Code MCP registration. Magus prints the host CLI sketch. Project scope
// lands in .mcp.json, which every worktree carries, so each checkout's session starts its
// own __COMMAND__.
export fun mgs_getMcp() > McpServer {
    return McpServer{
        transport = McpTransport.stdio,
        command = ["./magus", "mcp"],
        hint = "Register Magus MCP for this project (writes .mcp.json):\n"
            + "  claude mcp add --scope project magus -- __COMMAND__\n"
            + "A project entry named magus takes precedence over a user-scope one. Restart the Claude Code session afterward.",
        docs = "docs/guides/integrations/mcp.md",
        register = ["claude", "mcp", "add", "--scope", "project", "magus", "--", "./magus", "mcp"],
    };
}

// claude_agent renders one shipped agent as a Claude Code subagent file. A read-only agent
// is limited to the tools that cannot change the workspace. An agent carrying a model runs
// on that alias; one without leaves the host default.
fun claude_agent(agent: ShippedAgent) > AgentFile {
    final lines = mut ["---", "name: " + yamlQuote(agent.name), "description: " + yamlQuote(agent.description)];
    if (agent.readOnly) { lines.append("tools: Read, Grep, Glob, Bash"); }
    if (agent.model != "") { lines.append("model: {agent.model}"); }
    lines.append("---");
    lines.append("");
    lines.append(agent.instructions.trim());
    return AgentFile{path = ".claude/agents/{agent.name}.md", content = lines.join("\n") + "\n"};
}

export fun mgs_renderAgents(agents: [ShippedAgent]) > [AgentFile] {
    return agents.map(fun (index: int, agent: ShippedAgent) > AgentFile => claude_agent(agent));
}

fun claude_scout_fixture(readOnly: bool, model: str) > ShippedAgent {
    return ShippedAgent{
        name = "magus-scout",
        description = "Answers lookups: read-only, \"quoted\" and \\ escaped.",
        instructions = "First line.\n\nSecond line.\n",
        readOnly = readOnly,
        model = model,
    };
}

// claude_block is the managed block for one event, null when none is wired.
fun claude_block(event: str) > ManagedEntries? {
    foreach (block in claude_entries()) {
        if (block.path[1] == event) { return block; }
    }
    return null;
}

// claude_commands is the command of every entry, in order.
fun claude_commands() > [str] {
    final commands = mut [<str>];
    foreach (block in claude_entries()) {
        foreach (entry in block.entries) {
            foreach (hook in entry["hooks"] as [any]) { commands.append("{hook["command"]}"); }
        }
    }
    return commands;
}

test "mgs_renderAgents renders a read-only agent with limited tools and the model it carries" {
    final file = claude_agent(claude_scout_fixture(true, model: "cheap-alias"));
    assert\equal(file.path, ".claude/agents/magus-scout.md", "Claude Code reads .claude/agents");
    assert\equal(
        file.content,
        "---\nname: \"magus-scout\"\ndescription: \"Answers lookups: read-only, \\\"quoted\\\" and \\\\ escaped.\"\ntools: Read, Grep, Glob, Bash\nmodel: cheap-alias\n---\n\nFirst line.\n\nSecond line.\n",
        "frontmatter then the instructions",
    );
}

test "mgs_renderAgents leaves tools and model unset for a writable agent with no model" {
    final content = claude_agent(claude_scout_fixture(false, model: "")).content;
    assert\isTrue(content.indexOf("tools:") == null, "no tool restriction");
    assert\isTrue(content.indexOf("model:") == null, "the host default model applies");
}

test "mgs_renderAgents renders one file per agent, in order, and none for none" {
    final files = mgs_renderAgents([claude_scout_fixture(true, model: "cheap-alias"), claude_scout_fixture(false, model: "")]);
    assert\equal(files.len(), 2, "one file per agent");
    assert\equal(files[1].path, ".claude/agents/magus-scout.md", "path");
    assert\equal(mgs_renderAgents([<ShippedAgent>]).len(), 0, "no agents, no files");
}

test "mgs_listModels ships the five Claude rows, and only haiku-5-5 steps its price" {
    final ids = mut [<str>];
    final steps = mut [<str>];
    foreach (row in mgs_listModels()) {
        ids.append(row.id);
        if (row.step.above != 0) { steps.append(row.id); }
    }
    assert\equal(ids.join(","), "claude-fable-5-1,claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5,claude-haiku-4-5", "ids in table order");
    assert\equal(steps.join(","), "claude-haiku-5-5", "the one model priced by prompt length");
}

test "each shipped tier runs on exactly one row, by its exact id, under the host's alias" {
    final tiers = mut {<str: str>};
    final aliases = mut {<str: str>};
    foreach (row in claude_models()) {
        if (row.tier == "") {
            assert\equal(row.alias, "", "{row.id} has an alias but no tier");
            continue;
        }
        assert\isTrue(tiers[row.tier] == null, "tier {row.tier} names one model");
        tiers[row.tier] = row.id;
        assert\isTrue(aliases[row.alias] == null, "alias {row.alias} names one row");
        aliases[row.alias] = row.id;
    }
    assert\equal(tiers["economy"] ?? "", "claude-haiku-5-5", "the shipped agents' tier");
    assert\equal(tiers["standard"] ?? "", "claude-sonnet-5-5", "the default tier");
    assert\equal(tiers["principal"] ?? "", "claude-opus-5-5", "the top tier");
    assert\equal(aliases["opus"] ?? "", "claude-opus-5-5", "the top tier's alias");
    assert\equal(aliases.len(), 3, "only the tiered rows carry an alias");
}

test "mgs_getName is the harness id describe and verify look up" {
    assert\equal(mgs_getName(), "claude-code", "id must match magus\\harness.provider wiring and --id");
}

test "mgs_getHarnessConfig names Claude Code settings and makes every Bash tool command quiet" {
    final cfg = mgs_getHarnessConfig();
    assert\equal(cfg.path, ".claude/settings.json", "workspace-relative host config path");
    final env = cfg.defaults["env"] as {str: any};
    assert\equal(env.len(), 1, "one variable, magus's own");
    assert\equal("{env["MAGUS_LOG_SILENT"]}", "true", "the settings env object Claude Code sets on the session");
}

test "mgs_getSkills installs both forms under .claude/skills" {
    final skills = mgs_getSkills();
    assert\equal(skills.form.value, "both", "the short skills and their full twins");
    assert\equal(skills.paths.join(","), ".claude/skills", "Claude Code reads .claude/skills");
}

test "every hook appears in the entries, so the drift check magus runs passes" {
    final commands = claude_commands();
    assert\equal(commands.len(), mgs_listHooks().len(), "one entry per hook");
    foreach (hook in mgs_listHooks()) {
        assert\isTrue(commands.indexOf(claude_command(hook)) != null, "{hook.event} {hook.script} is rendered");
    }
}

test "every tool call reaches the guard through one entry" {
    final pre = claude_block("PreToolUse")!;
    var everyTool = 0;
    foreach (entry in pre.entries) {
        final command = "{(entry["hooks"] as [any])[0]["command"]}";
        if ((entry["matcher"] as? str) == EVERY_TOOL) {
            everyTool = everyTool + 1;
            assert\equal(command, claude_call_command(), "the catch-all runs the command glue");
        } else {
            assert\isTrue(command.indexOf("magus-command.buzz") == null, "no second entry judges a call the catch-all judges: {command}");
        }
    }
    assert\equal(everyTool, 1, "one catch-all, so no call is judged twice");
    assert\equal("{(pre.entries[1]["hooks"] as [any])[0]["command"]}", claude_observe_command(), "the observer records the path a Read reached");
}

test "the glue commands are the plain argv every machine shares" {
    final head = "m=\"$CLAUDE_PROJECT_DIR\"/magus; [ -x \"$m\" ] || m=magus; \"$m\" buzz -C \"$CLAUDE_PROJECT_DIR\" -s docs/guides/integrations/agents/";
    foreach (cmd in claude_commands()) {
        assert\isTrue(cmd.startsWith(head), "the same string on every machine, checkout binary first: {cmd}");
        assert\isTrue(cmd.indexOf(".sh") == null and cmd.indexOf("#") == null, "a shipped Buzz template, no marker: {cmd}");
        foreach (meta in ["&&", "|", ">", "$(", "`", "bash"]) {
            if (meta == "|") {
                assert\equal(cmd.replace("||", with: "").indexOf("|"), null, "no pipe, only the binary fallback: {cmd}");
            } else {
                assert\isTrue(cmd.indexOf(meta) == null, "POSIX sh only, no bashism: {cmd}");
            }
        }
        assert\isTrue(cmd.indexOf("proofread") == null, "the reply check is opt-in, never shipped: {cmd}");
    }
    assert\equal(claude_guard_command(), head + "magus-command.buzz -- --agent-name claude-code --observes-skill-loads", "the guard entry");
    assert\isTrue(claude_session_command().endsWith("magus-session.buzz -- --env-file \"$CLAUDE_ENV_FILE\""), "the file the Bash tool sources");
    assert\isTrue(claude_rehydrate_command().indexOf("--agent-name") == null, "rehydrate reads no host");
    assert\isTrue(claude_checkpoint_command().endsWith(" -- --agent-name claude-code"), "Stop checkpoint");
}

test "only the catch-all entry declares the foreground limits, from the constants mgs_getLimits returns" {
    final limits = mgs_getLimits();
    assert\equal(limits.foregroundDefaultMs, 120000, "the Bash tool's default timeout");
    assert\equal(limits.foregroundMaxMs, 600000, "the longest timeout the Bash tool takes");
    assert\equal(limits.hookTimeoutMs, 10000, "the hook timeout every judging entry carries, in ms");
    assert\equal(claude_call_command(),
        claude_guard_command() + " --foreground-default-ms {FOREGROUND_DEFAULT_MS} --foreground-max-ms {FOREGROUND_MAX_MS} --tool-rows {claude_tools_dir()}",
        "the guard command plus the two limits and the tool rows");
    foreach (hook in mgs_listHooks()) {
        final declares = hook.flags.indexOf("--foreground-max-ms") != null;
        assert\equal(declares, hook.event == "PreToolUse" and hook.matcher == EVERY_TOOL,
            "only the entry a shell command reaches declares the host's limits: {hook.event} {hook.matcher}");
    }
}

test "only the stop entries declare the resume version, from the constant mgs_getLimits returns" {
    assert\equal(mgs_getLimits().resumesOnBackgroundFrom, "2.1.299", "the first release that resumes a subagent");
    foreach (hook in mgs_listHooks()) {
        final at = hook.flags.indexOf("--resumes-on-background-from");
        final stops = hook.script == "magus-command" and (hook.event == "Stop" or hook.event == "SubagentStop");
        assert\equal(at != null, stops, "only a stop entry declares the resume version: {hook.event} {hook.script}");
        if (at -> i) {
            assert\equal(hook.flags[i + 1], RESUMES_ON_BACKGROUND_FROM, "the flag carries the constant");
        }
    }
}

// The judging entries claim loads are REPORTED, and only a PreToolUse matcher the Skill tool
// meets reports them. Derived from the hooks rather than pinned as a pair, so the coupling is
// what fails when it breaks.
test "every judging entry declares observes-skill-loads exactly while a matcher reports them" {
    var reportsLoads = false;
    foreach (hook in mgs_listHooks()) {
        if (hook.event == "PreToolUse" and (hook.matcher == EVERY_TOOL or hook.matcher == "Skill")) { reportsLoads = true; }
    }
    foreach (hook in mgs_listHooks()) {
        final claims = hook.flags.indexOf(OBSERVES_SKILL_LOADS) != null;
        if (hook.script == "magus-command") {
            assert\equal(claims, reportsLoads, "a judging entry declares the flag exactly when a matcher reports loads");
        } else {
            assert\isTrue(!claims, "a glue that judges nothing takes no capability: {hook.script}");
        }
    }
}

test "the entries cover PreToolUse PostToolUse SessionStart Stop SubagentStop and UserPromptSubmit" {
    final events = mut [<str>];
    foreach (block in claude_entries()) { events.append(block.path[1]); }
    assert\equal(events.join(","), "PreToolUse,PostToolUse,SessionStart,Stop,SubagentStop,UserPromptSubmit", "six managed path blocks");
    final post = claude_block("PostToolUse")!;
    assert\equal(post.entries.len(), 2, "the finished spawn and the Buzz check");
    assert\equal(post.entries[0]["matcher"] as? str, SPAWN_MATCHER, "both names of the spawn tool");
    assert\equal(post.entries[1]["matcher"] as? str, WRITE_MATCHER, "every tool that writes a file");
    final start = claude_block("SessionStart")!;
    assert\equal(start.entries[0]["matcher"] as? str, SESSION_PATH_MATCHER, "every start that gets a fresh env file");
    assert\equal(start.entries[1]["matcher"] as? str, "compact", "rehydrate");
    final message = claude_block("UserPromptSubmit")!;
    assert\equal(message.entries.len(), 1, "one message entry");
    assert\isTrue(message.entries[0]["matcher"] == null, "a message event takes no matcher");
    foreach (block in claude_entries()) {
        foreach (entry in block.entries) {
            final hooks = entry["hooks"] as [any];
            assert\equal(hooks.len(), 1, "one command hook per entry");
            assert\equal("{hooks[0]["type"]}", "command", "Claude Code hook type");
        }
    }
}

test "the Buzz check runs after every write, with the shipped check script" {
    final check = claude_buzz_check_hook();
    assert\equal(check.event, "PostToolUse", "after the file is written");
    assert\isTrue(claude_command(check).indexOf("magus-buzz-check.buzz -- --agent-name claude-code") != null, "named like every glue entry");
}

test "mgs_listTools names each tool once" {
    final tools = mgs_listTools();
    assert\equal(tools.dir, ".claude/magus/tools", "beside the settings");
    final seen = mut {<str: bool>};
    foreach (row in tools.rows) {
        assert\isTrue(seen[row.name] == null, "{row.name} has one row");
        seen[row.name] = true;
    }
    assert\isTrue(seen["Read"] ?? false, "the read tool is known");
    assert\isTrue(seen["mcp__terminal__run_in_terminal"] ?? false, "the terminal panel is known");
    assert\isTrue(seen["ReadNotifications"] ?? false, "the notifications read is known");
    assert\isTrue(seen["SendUserFile"] ?? false, "the file hand-off is known");
    assert\isTrue(seen["mcp__ccd_turn__update_plan"] ?? false, "the desktop plan tool is known");
    assert\isTrue(seen["mcp__ccd_turn__wrap_up"] ?? false, "the desktop wrap-up tool is known");
}

test "the desktop app's tools carry what each can do, and auto-merge has no row" {
    final capability = mut {<str: str>};
    foreach (row in mgs_listTools().rows) { capability[row.name] = row.capability.value; }
    foreach (name, want in {
        "mcp__ccd_session__start_session": "spawns",
        "mcp__ccd_session__hand_off_to_session": "spawns",
        "mcp__ccd_turn__update_plan": "inert",
        "mcp__ccd_turn__wrap_up": "inert",
        "ReadNotifications": "reads",
        "SendUserFile": "inert",
        "mcp__ccd_host__sync_with_base_branch": "writes",
        "mcp__ccd_host__clean_up_worktrees": "writes",
        "mcp__ccd_host__discard_kept_worktree": "writes",
        "mcp__ccd_pr__get_status": "reads",
        "mcp__ccd_pr__bind_pr": "inert",
        "mcp__ccd_session_mgmt__list_sessions": "reads",
        "mcp__ccd_view__show_pane": "inert",
        "mcp__ccd_window__close_split": "inert",
        "mcp__ccd_sidebar__list_groups": "inert",
        "mcp__ccd_directory__request_directory": "inert",
        "mcp__ccd_connectors__session_connectors_status": "reads",
    }) {
        assert\equal(capability[name] ?? "(no row)", want, name);
    }
    assert\isTrue(capability["mcp__ccd_pr__set_auto_merge"] == null, "a person enables auto-merge, so unjudged-tool refuses the call");
}

test "mgs_getMcp registers a per-checkout stdio server" {
    final mcp = mgs_getMcp();
    assert\equal(mcp.transport.value, "stdio", "the host starts ./magus mcp per session");
    assert\equal(mcp.command.join(" "), "./magus mcp", "the checkout's own binary");
    assert\isTrue(mcp.hint.indexOf("claude mcp add --scope project magus -- __COMMAND__") != null, "names the host CLI");
    assert\isTrue(mcp.docs.indexOf("mcp.md") != null, "docs pointer");
}
