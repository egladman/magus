import "magus/spell";
// charm constructors derive argv patches from an anchor arg, not a counted index.
import "magus/charm";

export fun mgs_getName() > str { return "python"; }

export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.py"}, Path{value = "pyproject.toml"}, Path{value = "requirements.txt"}, Path{value = "requirements-*.txt"},
            Path{value = "Pipfile"}, Path{value = "Pipfile.lock"}, Path{value = "setup.py"}, Path{value = "setup.cfg"}, Path{value = "uv.lock"}, Path{value = "poetry.lock"}];
}


// mgs_getLanguage names the source language this spell adapts, canonical and lowercase
// so it matches the language attr on the Python files and symbols SCIP ingests. It lets
// `magus query language:python` reach this adapter alongside the code it builds.
export fun mgs_getTools() > {str: Tool} {
    return {"python3": Tool{probe = Command{bin = "python3", args = ["--version"]}}};
}

export fun mgs_getLanguage() > str { return "python"; }

// mgs_listIgnoreDirs names non-source dirs the python toolchain generates, pruned
// from the input-hashing walk. The cache dirs (.pytest_cache, .mypy_cache) are
// dot-dirs skipped structurally, so only __pycache__ belongs here.
export fun mgs_listIgnoreDirs() > [Path] { return [Path{value = "__pycache__", isDir = true}]; }

// mgs_listManifests names the file that carries this project's OWN version - not
// the toolchain's (that's mgs_getTools) and not a cache input (these three
// are separately listed in mgs_listRequiredGlobs above, because they also feed the
// cache key). Python genuinely has alternatives, unlike the other built-ins: a
// pyproject.toml-managed project may still ship a legacy setup.py or setup.cfg, so
// this is ORDERED and the first candidate present in a project directory wins.
export fun mgs_listManifests() > [Path] { return [Path{value = "pyproject.toml"}, Path{value = "setup.py"}, Path{value = "setup.cfg"}]; }

// build/clean are uv's own subcommands; pytest and ruff are tools uv merely runs,
// so they are named after the tool (pytest, ruff-check), not the `uv run` wrapper.
fun uvBuild(target: Target) > Command { return Command{bin = "uv", args = ["build"]}; }
fun uvClean(target: Target) > Command { return Command{bin = "uv", args = ["clean"]}; }
fun pytest(target: Target) > Command {
    return Command{bin = "uv", args = ["run", "pytest"], charms = {
        "debug": append(["-v"]),
    }};
}
fun ruffCheck(target: Target) > Command {
    final args = ["run", "ruff", "check", "."];
    return Command{bin = "uv", args = args, charms = {
        "debug": append(["-v"]),
        "rw": after(args, "check", ["--fix"]),
        "gha": after(args, "check", ["--output-format=github"]),
    }};
}
fun ruffFormat(target: Target) > Command {
    final args = ["run", "ruff", "format", "--check", "."];
    return Command{bin = "uv", args = args, charms = {
        "rw": drop(args, "--check"),
    }};
}
// scip is the reserved op that runs the Python SCIP indexer for the knowledge graph.
// The indexer is a PATH binary (install it with mise, not as a project dep), so the op
// forks it directly. magus injects MAGUS_SYMBOL_INDEX with the cache destination, so the
// index never lands in the tree; scip-python writes there via --output. The runner
// resolves the bare $MAGUS_SYMBOL_INDEX token against that destination, so no shell
// is needed to expand it.
fun scip(target: Target) > Command {
    return Command{bin = "scip-python", args = ["index", ".", "--output", "$MAGUS_SYMBOL_INDEX"]};
}

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {"uv-build": uvBuild, "uv-clean": uvClean, "pytest": pytest, "ruff-check": ruffCheck, "ruff-format": ruffFormat, "scip": scip};
}
