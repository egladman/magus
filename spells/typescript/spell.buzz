// Opaque (mgs_isOpaque) because pnpm manages its own dependency graph:
// magus treats the project as a black box rather than tracking per-file inputs.
//
// eslint+prettier or Biome: this one spell offers both toolchains as separate
// ops (eslint/prettier vs biome-check/biome-format) rather than shipping a
// second spell targeting the same files. The magusfile
// - not the spell - decides which pair composes into lint/format; a project
// picks one pair, not both.

import "magus/spell";
// charm constructors derive argv patches from an anchor arg, not a counted index.
import "magus/charm";
import "encoding/json";
import "encoding/yaml";
import "path";
import "result";

export fun mgs_getName() > str { return "typescript"; }

export fun mgs_listRequiredGlobs() > [Path] {
    // tsconfig*.json is listed explicitly even though the broader **/*.json below
    // already matches it - self-documenting rather than riding along by accident.
    //
    // pnpm-workspace.yaml sits beside .npmrc because pnpm 10.16 moved settings into it,
    // and those settings decide what an install DOES: the minimum-release-age gate this
    // workspace relies on lives there now. A .yaml matches none of the globs above, so
    // without this entry a project could move its supply-chain policy into that file and
    // every target would keep replaying the verdict it reached under the old one.
    return [Path{value = "**/*.ts"}, Path{value = "**/*.tsx"}, Path{value = "**/*.mts"}, Path{value = "**/*.cts"}, Path{value = "**/*.js"}, Path{value = "**/*.jsx"},
            Path{value = "**/*.mjs"}, Path{value = "**/*.cjs"}, Path{value = "**/*.json"}, Path{value = "tsconfig*.json"}, Path{value = "package.json"},
            Path{value = ".npmrc"}, Path{value = "pnpm-workspace.yaml"},
            Path{value = "pnpm-lock.yaml"}, Path{value = "package-lock.json"}, Path{value = "npm-shrinkwrap.json"},
            Path{value = "yarn.lock"}, Path{value = "bun.lockb"}];
}

export fun mgs_isOpaque() > bool { return true; }

// Empty on purpose. Where tsc writes is decided by the project's tsconfig outDir, which this
// spell cannot read - so any glob here is a guess, and "dist/**" was the TS convention rather
// than a fact about your project.
//
// A guess is not free. Provided globs are contributed to EVERY target on a project, so a target
// that declares no ctx.writesFiles of its own inherits them; on a cache miss its snapshot then
// has to satisfy a glob it never writes. That failure only appears on a cold cache, so it hid
// for a long time across four projects here, none of which emit to dist/ (see MGS1018).
//
// Declare the real output location on the project instead - `"outputs": ["gen/**"]` - or on the
// target with ctx.writesFiles. A spell should claim what it can verify; this it cannot.
export fun mgs_listProvidedGlobs() > [Path] { return [<Path>]; }


// The three binaries this spell's ops actually depend on, not just the runtime.
//
// tsc is the one that matters most and was missing longest: every op here runs it through
// `pnpm exec`, and a probe result is a CACHE-KEY INPUT, so while it went undeclared magus
// would replay a cached typecheck produced by a different compiler. A TypeScript major is
// exactly the kind of upgrade that changes what `tsc` accepts, which is the case the key
// exists to catch. Its probe forks pnpm rather than tsc directly because tsc is a local
// node_modules binary with no stable path; `pnpm exec` is how every op reaches it too. An
// uninstalled tree makes the probe fail, which magus treats as unprobeable rather than as
// a failure - the same degradation a missing binary gets.
//
// pnpm is declared for the same reason one step out: it resolves the dependency graph
// every op builds against, and this repo pins it (mise.toml) precisely because the
// resolution differs across versions.
//
// node keeps no `key` narrowing, so its whole probe line keys the cache, matching what it
// did before these two were added.
export fun mgs_getTools() > {str: Tool} {
    return {
        "node": Tool{probe = Command{bin = "node", args = ["--version"]}, lifecycle = "nodejs"},
        "pnpm": Tool{probe = Command{bin = "pnpm", args = ["--version"]},
                     key = VersionKey{upTo = VersionComponent.patch}},
        "tsc": Tool{probe = Command{bin = "pnpm", args = ["exec", "tsc", "--version"]},
                    key = VersionKey{upTo = VersionComponent.patch}},
        // Observed, not probed: only the scip op drives it, so its version keys the index
        // and no other target.
        "scip-typescript": Tool{observe = Command{bin = "scip-typescript", args = ["--version"]}},
    };
}

// The package managers' caches and stores, never ~/.npmrc beside them, which holds
// registry tokens. pnpm keeps its store under XDG data on Linux and in ~/Library/pnpm on
// macOS; each entry resolves on every OS and the one that does not exist grants nothing.
export fun mgs_getSandbox() > Sandbox {
    return Sandbox{
        allow = [
            SandboxAllow{env = "npm_config_cache", base = "home", path = ".npm", mode = SandboxAccess.rw},
            SandboxAllow{env = "PNPM_HOME", mode = SandboxAccess.rx},
            SandboxAllow{base = "xdgData", path = "pnpm", mode = SandboxAccess.rw},
            SandboxAllow{base = "home", path = "Library/pnpm", mode = SandboxAccess.rw},
            SandboxAllow{base = "userCache", path = "pnpm", mode = SandboxAccess.rw},
            SandboxAllow{env = "YARN_CACHE_FOLDER", base = "userCache", path = "yarn", mode = SandboxAccess.rw},
            SandboxAllow{env = "COREPACK_HOME", base = "xdgCache", path = "node/corepack", mode = SandboxAccess.rw},
        ],
        env = SandboxEnv{passthrough = ["npm_config_cache", "PNPM_HOME", "YARN_CACHE_FOLDER", "COREPACK_HOME"]},
    };
}

// The JavaScript flavors are claimed here too: one toolchain, one syntax.
export fun mgs_getLanguage() > Language {
    return Language{
        name = "typescript",
        extensions = [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
        syntax = Syntax{
            comments = CommentSyntax{
                lineComments = ["//"],
                blockComments = [CommentBlock{open = "/*", close = "*/"}],
                quotes = [
                    Quote{open = "`", close = "`"},
                    Quote{open = "\"", close = "\""},
                    Quote{open = "'", close = "'"},
                ],
                directives = ["@ts-", "eslint-", "<reference"],
            },
            stubs = StubSyntax{
                kinds = ["Function", "Method"],
                bodyStyle = "brace",
                body = "\{\n\tthrow new Error(\"unimplemented: \{\{&Name}} lands in \{\{&Branch}}\");\n\}",
            },
            operators = ["===", "!==", "==", "!=", "<=", ">=", "&&", "||", "??", "??=", "?.", "=>", "++", "--", "**", "...", "+=", "-="],
            decisions = DecisionSyntax{keywords = ["if", "for", "while", "case", "catch"], operators = ["&&", "||", "??", "??=", "?"]},
        },
    };
}

// mgs_listIgnoreDirs names non-source dirs the node/ts ecosystem generates, pruned from the
// input-hashing walk. dist is already excluded as a declared output.
//
// The dot-dirs are NOT optional, whatever their leading dot suggests. Two ignore predicates
// exist and they disagree: project.IsIgnoreDir skips every dot-dir, but that one governs
// DISCOVERY and watch, and it cannot be reused here - .claude/skills/** and .github/** are
// declared sources in this workspace. The hashing walk uses cache.isIgnoreDir, which skips
// only a fixed VCS/magus list plus what is named here. So an unnamed dot-dir of build output
// lands in the cache key, and a target that writes it restales its own key on every run:
// console:test compiles into .testcache and could never replay, which is how this was found
// (MGS4007 reported the write).
export fun mgs_listIgnoreDirs() > [Path] {
    return [Path{value = "node_modules", isDir = true},
            Path{value = ".testcache", isDir = true},
            Path{value = ".turbo", isDir = true},
            Path{value = ".pnpm-store", isDir = true}];
}

// PACKAGE_MANAGER_HINTS classify the failures that follow a stale install - the case where
// somebody else's merge changed the lockfile and node_modules did not move with it. The
// tool says what broke; none of these say "your install is out of date", which is the
// actual fact and the reason this spell declares them.
//
// Every manager gets its own phrasing because every manager invented one. The ops here
// currently fork pnpm, so the npm/yarn/bun entries cannot fire yet - they are declared
// anyway because a non-matching string costs nothing, and the engine-side package-manager
// substitution (a spell opts in, the runner forks the project's detected manager) makes
// them live without touching this list again. An entry that never matches is inert; an
// entry missing when the substitution lands is a silent gap.
//
// Only exact error CODES and verbatim messages are matched. A wrong hint is worse than
// none, so a phrasing that drifts between releases does not belong here.
final PACKAGE_MANAGER_HINTS = [
    // pnpm
    Hint{contains = "ERR_PNPM_OUTDATED_LOCKFILE",
         advise = "pnpm-lock.yaml disagrees with package.json - usually a merge that changed one of them; run `pnpm install` and commit the lockfile"},
    Hint{contains = "ERR_PNPM_NO_SCRIPT",
         advise = "package.json declares no such script; check the name, or the target may be pointed at the wrong project"},
    // npm. `npm ci` refuses rather than silently reconciling, which is the right call and
    // also the one that reads as a wall of text; the fix is one command.
    Hint{contains = "can only install packages when your package.json and package-lock.json",
         advise = "package-lock.json disagrees with package.json - usually a merge that changed one of them; run `npm install` and commit the lockfile"},
    Hint{contains = "Missing script:",
         advise = "package.json declares no such script; check the name, or the target may be pointed at the wrong project"},
    // yarn: classic, then berry.
    Hint{contains = "Your lockfile needs to be updated",
         advise = "yarn.lock disagrees with package.json; run `yarn install` and commit the lockfile"},
    Hint{contains = "The lockfile would have been modified by this install",
         advise = "yarn.lock disagrees with package.json; run `yarn install` and commit the lockfile"},
    // bun
    Hint{contains = "lockfile had changes, but lockfile is frozen",
         advise = "the bun lockfile disagrees with package.json; run `bun install` and commit the lockfile"},
    // Manager-agnostic: node and the shell, whatever installed (or failed to install).
    Hint{contains = "Cannot find module",
         advise = "a dependency is missing from node_modules, usually a stale install; run your package manager's install"},
    Hint{contains = "command not found",
         advise = "the tool is not in node_modules/.bin, usually a stale or missing install; run your package manager's install"},
];

// installs materializes node_modules from the lockfile without changing it, and under
// the update charm re-resolves and rewrites the lockfile instead.
//
// --prefer-offline serves metadata from the store before asking the registry, which
// is what makes a warm-store install a link step rather than a round trip; both pnpm and
// npm accept it with that meaning. yarn and bun get no entry: yarn classic and berry
// disagree on the flags, and neither completion stamp is verified here, and a wrong
// stamp replays a tree that is not there.
//
// Each stamp is written when an install FINISHES: pnpm keys its own up-to-date check on
// node_modules/.pnpm/lock.yaml, and npm writes its hidden lockfile at the end of reify.
// npm is not relocatable because `npm ci` deletes node_modules first, so a seed would
// be thrown away.
// Named pnpm-install (binary + capability): the plain "install" name collides with
// the canonical top-level target the same way go's bare op names once collided with
// build/test (the reason the go spell is not named after its ops either).
fun pnpmInstall() > Install {
    final args = ["install", "--frozen-lockfile", "--prefer-offline"];
    return Install{
        name = "pnpm-install",
        command = Command{bin = "pnpm", args = args, hints = PACKAGE_MANAGER_HINTS, charms = {
            "update": Charm{ops = set(args, anchor: "install", val: "update").ops
                                  + drop(args, anchor: "--prefer-offline").ops
                                  + drop(args, anchor: "--frozen-lockfile").ops},
        }},
        dir = "node_modules",
        relocatable = true,
        stamps = ["node_modules/.pnpm/lock.yaml", "node_modules/.modules.yaml"],
        inputs = [".npmrc", "pnpm-workspace.yaml"],
        tools = ["node", "pnpm"],
    };
}
// Named npm-ci after the subcommand it runs. Shared by package-lock.json and
// npm-shrinkwrap.json below: both run `npm ci`, so both declare this same name and
// magus registers them as the one op, live for whichever lockfile a project has.
fun npmInstall() > Install {
    final args = ["ci", "--prefer-offline"];
    return Install{
        name = "npm-ci",
        command = Command{bin = "npm", args = args, hints = PACKAGE_MANAGER_HINTS, charms = {
            "update": Charm{ops = set(args, anchor: "ci", val: "update").ops + drop(args, anchor: "--prefer-offline").ops},
        }},
        dir = "node_modules",
        stamps = ["node_modules/.package-lock.json"],
        inputs = [".npmrc"],
        tools = ["node"],
    };
}

// mgs_listManifests names the file this project's dependencies are declared in -
// not the toolchain's version (that's mgs_getTools) and not a cache input
// (package.json and every lockfile below are separately listed in
// mgs_listRequiredGlobs above, because they also feed the cache key). A node project
// has exactly one manifest candidate and five LOCK candidates.
//
// The five are alternatives, not a set: whichever package manager the project uses
// writes one of them and the others are absent. package.json alone cannot answer
// what is installed - its ranges (^4.2.0) name a window, and the lockfile is what
// pins a version inside it - which makes node the ecosystem this field exists for.
//
// Ordered as mgs_listRequiredGlobs orders them, so the two lists read the same way.
// bun.lockb is bun's binary lockfile; newer bun writes a text bun.lock, and adding
// it here needs the required-globs list to learn it at the same time or the cache
// key stops covering a file the build reads.
export fun mgs_listManifests() > [Manifest] {
    return [Manifest{value = "package.json",
                     lockCandidates = ["pnpm-lock.yaml", "package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "bun.lockb"],
                     installs = {
                         "pnpm-lock.yaml": pnpmInstall(),
                         "package-lock.json": npmInstall(),
                         "npm-shrinkwrap.json": npmInstall(),
                     }}];
}

// test and start are the package managers' shorthands for scripts.test and scripts.start.
// The bare `pnpm <script>` and `yarn <script>` forms go undetected: a bin-only prefix
// would also match `pnpm install` and `pnpm exec`.
export fun mgs_listScriptRunners() > [Command] {
    return [Command{bin = "npm", args = ["run"]}, Command{bin = "npm", args = ["run-script"]},
            Command{bin = "npm", args = ["test"]}, Command{bin = "npm", args = ["t"]},
            Command{bin = "npm", args = ["start"]},
            Command{bin = "pnpm", args = ["run"]}, Command{bin = "pnpm", args = ["test"]},
            Command{bin = "pnpm", args = ["start"]},
            Command{bin = "yarn", args = ["run"]}, Command{bin = "yarn", args = ["test"]},
            Command{bin = "yarn", args = ["start"]},
            Command{bin = "bun", args = ["run"]}];
}

// biome-check is biome's lint/analyze pass (eslint's role, if your project
// chose Biome over eslint+prettier - the magusfile decides which composes
// into lint, not this spell). --write and --reporter=github verified against
// the current Biome CLI docs (biomejs.dev/reference/cli).
fun biomeCheck(target: Target) > Command {
    final args = ["exec", "biome", "check", "."];
    return Command{bin = "pnpm", args = args, hints = PACKAGE_MANAGER_HINTS, charms = {
        "rw":  after(args, anchor: "check", vals: ["--write"]),
        "gha": after(args, anchor: "check", vals: ["--reporter=github"]),
    }};
}
// biome-format is biome's formatter (prettier's role). Unlike prettier/ruffFormat,
// `biome format` has no --check flag to drop: it is read-only by default (reports
// differences, writes nothing) and --write applies them, so rw ADDS a flag instead
// of removing one.
fun biomeFormat(target: Target) > Command {
    final args = ["exec", "biome", "format", "."];
    return Command{bin = "pnpm", args = args, hints = PACKAGE_MANAGER_HINTS, charms = {
        "rw": after(args, anchor: "format", vals: ["--write"]),
    }};
}
// eslint has no built-in "github" formatter (unlike ruff's --output-format=github);
// "unix" is the built-in, no-extra-devDependency formatter closest to a CI-friendly,
// one-line-per-problem shape for annotation/regex parsing.
fun eslint(target: Target) > Command {
    final args = ["exec", "eslint", "."];
    return Command{bin = "pnpm", args = args, hints = PACKAGE_MANAGER_HINTS, charms = {
        "rw": after(args, anchor: "eslint", vals: ["--fix"]),
        "gha": after(args, anchor: "eslint", vals: ["--format=unix"]),
    }};
}
fun prettier(target: Target) > Command {
    final args = ["exec", "prettier", "--check", "."];
    return Command{bin = "pnpm", args = args, hints = PACKAGE_MANAGER_HINTS, charms = {
        "rw": set(args, anchor: "--check", val: "--write"),
    }};
}
fun tsc(target: Target) > Command { return Command{bin = "pnpm", args = ["exec", "tsc"], hints = PACKAGE_MANAGER_HINTS}; }
// tsc-build uses TypeScript's project-references incremental build mode (works
// even without declared references, via its own .tsbuildinfo cache), emitting per
// tsconfig outDir - see mgs_listProvidedGlobs.
fun tscBuild(target: Target) > Command { return Command{bin = "pnpm", args = ["exec", "tsc", "--build"]}; }
// tsc-clean mirrors tsc-build's project-references mode: --clean removes the
// declared outputs and the incremental .tsbuildinfo cache.
fun tscClean(target: Target) > Command { return Command{bin = "pnpm", args = ["exec", "tsc", "--build", "--clean"]}; }
fun vitest(target: Target) > Command {
    return Command{bin = "pnpm", args = ["exec", "vitest", "run"], charms = {
        "gha": append(["--reporter=github-actions"]),
    }};
}
// esbuild takes its entry points and flags from the caller, and the composing target
// declares the files it writes. Through pnpm exec so a project's own esbuild wins over
// the one on PATH.
fun esbuild(target: Target) > Command {
    return Command{bin = "pnpm", args = ["exec", "esbuild"], hints = PACKAGE_MANAGER_HINTS};
}
// node-test runs node:test with source maps and coverage, spec to stdout and lcov to the
// file the caller names: node pairs reporters with destinations in order, so a caller
// passing args leads with --test-reporter-destination=<file>, then the test files.
fun nodeTest(target: Target) > Command {
    return Command{bin = "node",
                   args = ["--enable-source-maps", "--experimental-test-coverage",
                           "--test-reporter=spec", "--test-reporter-destination=stdout",
                           "--test-reporter=lcov", "--test"],
                   defaultArgs = ["--test-reporter-destination=coverage.lcov"],
                   hints = PACKAGE_MANAGER_HINTS};
}
// mgs_getModeArgs: node also runs scripts, evals and a REPL, so only a node carrying
// --test is node-test.
export fun mgs_getModeArgs() > {str: [str]} {
    return {"node-test": ["--test"]};
}
// dev-server runs the server command the caller names, through pnpm exec so the project's
// own binary wins: typescript["dev-server"](ctx, {"args": ["vite"]}). The manifest says what
// the package is and the magusfile how it runs, so the package.json dev script is not read.
// No readiness probe: the port and startup signal vary by server (see services.md); a
// magusfile that must block on readiness declares its own service op.
fun devServer(target: Target) > Service {
    return Service{command = Command{
        bin = "pnpm",
        args = ["exec"],
        needsArgs = "dev-server runs the command you name; pass it as args: typescript[\"dev-server\"](ctx, \{\"args\": [\"vite\"]})",
    }};
}
// node-test's lcov reporter writes it by default.
export fun mgs_getCoverage() > Coverage {
    return Coverage{format = CoverageFormat.lcov, profile = "coverage.lcov"};
}

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {"biome-check": biomeCheck, "biome-format": biomeFormat,
            "eslint": eslint, "prettier": prettier, "tsc": tsc,
            "tsc-build": tscBuild, "tsc-clean": tscClean, "vitest": vitest,
            "esbuild": esbuild, "node-test": nodeTest};
}

export fun mgs_listServices() > {str: fun(Target) Service} {
    return {"dev-server": devServer};
}

// External, so it runs only where magus.yaml lists typescript under
// spells.symbol_indexers. One index covers the .js beside the .ts; --infer-tsconfig
// indexes a plain JavaScript project too. scip-typescript is a PATH binary (install it
// with mise, not as a project dep) and writes to MAGUS_SYMBOL_INDEX, never the tree.
export fun mgs_getSymbolIndexer() > SymbolIndexer {
    return SymbolIndexer{
        format = SymbolFormat.scip,
        command = Command{bin = "scip-typescript", args = ["index", "--infer-tsconfig", "--output", "$MAGUS_SYMBOL_INDEX"]},
    };
}

// A package.json found by discover_projects, with its manifest parsed. manifest is empty
// when the file is not a JSON object; that is reported as a gap where it is parsed.
object NodePackage {
    dir: str,
    file: str,
    manifest: {str: any},
    name: str,
}

// A workspace root and the member globs it declares, from pnpm-workspace.yaml or the
// package.json workspaces field. pnpm links a plain version range to a member only under
// link-workspace-packages, which defaults to off; npm and yarn always link by name.
object NodeWorkspace {
    root: str,
    file: str,
    patterns: [str],
    pnpm: bool,
}

// The dependency fields an install links workspace packages through. peerDependencies is
// left out: a peer is the consumer's to provide, so it is no edge from this package.
final LINKED_DEPENDENCY_FIELDS = ["dependencies", "devDependencies", "optionalDependencies"];

// node --test's default file patterns, which node-test runs with no file arguments.
final NODE_TEST_PATTERNS = ["**/*.test.\{cjs,mjs,js}", "**/*-test.\{cjs,mjs,js}", "**/*_test.\{cjs,mjs,js}",
                            "**/test-*.\{cjs,mjs,js}", "**/test.\{cjs,mjs,js}", "**/test/**/*.\{cjs,mjs,js}"];
final TS_TEST_PATTERNS = ["**/*.test.\{ts,mts,cts,tsx}", "**/*.spec.\{ts,mts,cts,tsx}", "**/*.spec.\{cjs,mjs,js}"];

// Test runners a package can declare that no op in this spell runs.
final UNWIRED_TEST_RUNNERS = ["jest", "mocha", "ava", "jasmine", "@playwright/test", "cypress"];

final BUNDLER_CONFIG_PREFIXES = ["vite.config.", "webpack.config.", "rollup.config.", "rspack.config.",
                                 "tsup.config.", "esbuild.config."];

fun asMap(value: any) > {str: any} {
    if (value is {str: any}) {
        final m: {str: any} = value;
        return m;
    }
    return {<str: any>};
}

fun asStrings(value: any) > [str]? {
    if (!(value is [any])) {
        return null;
    }
    final items: [any] = value;
    final strings = mut [<str>];
    foreach (item in items) {
        if (!(item is str)) {
            return null;
        }
        final s: str = item;
        strings.append(s);
    }
    return strings;
}

fun sortedKeys(m: {str: any}) > [str] {
    final keys = m.keys().cloneMutable();
    keys.sort(fun (left: str, right: str) > bool => left < right);
    return keys;
}

fun gap(file: str, why: str) > DiscoveryGap {
    return DiscoveryGap{file = file, why = why};
}

fun parsePackage(file: DiscoveryFile, gaps: mut [DiscoveryGap]) > result\Result::<NodePackage> {
    if (file.content -> content) {
        final parsed: any = json\parse(content) catch null;
        if (!(parsed is {str: any})) {
            gaps.append(gap(file.path, why: "not a JSON object, so nothing in it was read"));
        }
        final manifest = asMap(parsed);
        final name = manifest["name"];
        return result\ok::<NodePackage>(NodePackage{
            dir = path\dir(file.path),
            file = file.path,
            manifest = manifest,
            name = if (name is str) "{name}" else "",
        });
    }
    return result\fail::<NodePackage>("discover_projects: {file.path} arrived without content; package.json is a literal-basename glob, so discovery owes its content");
}

fun normalizePattern(pattern: str) > str {
    var p = pattern;
    if (p.startsWith("./")) {
        p = p.sub(2);
    }
    while (p.endsWith("/")) {
        p = p.sub(0, len: p.len() - 1);
    }
    return p;
}

fun workspaceOf(pkg: NodePackage, gaps: mut [DiscoveryGap]) > NodeWorkspace? {
    final declared = pkg.manifest["workspaces"];
    if (declared == null) {
        return null;
    }
    final direct = asStrings(declared);
    if (direct -> patterns) {
        return NodeWorkspace{root = pkg.dir, file = pkg.file, patterns = patterns, pnpm = false};
    }
    final nested = asStrings(asMap(declared)["packages"]);
    if (nested -> patterns) {
        return NodeWorkspace{root = pkg.dir, file = pkg.file, patterns = patterns, pnpm = false};
    }
    gaps.append(gap(pkg.file, why: "workspaces: neither a list of globs nor an object with a packages list, so no member was read"));
    return null;
}

fun parsePnpmWorkspace(file: DiscoveryFile, gaps: mut [DiscoveryGap]) > result\Result::<NodeWorkspace?> {
    if (file.content -> content) {
        final parsed: any = yaml\parse(content) catch null;
        if (parsed == null) {
            // An empty file, or one holding only settings: a workspace of the root alone.
            return result\ok::<NodeWorkspace?>(NodeWorkspace{root = path\dir(file.path), file = file.path, patterns = [<str>], pnpm = true});
        }
        if (!(parsed is {str: any})) {
            gaps.append(gap(file.path, why: "not a YAML mapping, so no member was read"));
            return result\ok::<NodeWorkspace?>(null);
        }
        final declared = asMap(parsed)["packages"];
        if (declared == null) {
            return result\ok::<NodeWorkspace?>(NodeWorkspace{root = path\dir(file.path), file = file.path, patterns = [<str>], pnpm = true});
        }
        if (asStrings(declared) -> patterns) {
            return result\ok::<NodeWorkspace?>(NodeWorkspace{root = path\dir(file.path), file = file.path, patterns = patterns, pnpm = true});
        }
        gaps.append(gap(file.path, why: "packages: not a list of globs, so no member was read"));
        return result\ok::<NodeWorkspace?>(null);
    }
    return result\fail::<NodeWorkspace?>("discover_projects: {file.path} arrived without content; pnpm-workspace.yaml is a literal-basename glob, so discovery owes its content");
}

fun isMember(ws: NodeWorkspace, dir: str) > result\Result::<bool> {
    if (dir == ws.root or !path\within(ws.root, path: dir)) {
        return result\ok::<bool>(false);
    }
    var included = false;
    try {
        final rel = path\rel(ws.root, target: dir);
        foreach (raw in ws.patterns) {
            if (raw.startsWith("!")) {
                if (path\matches(normalizePattern(raw.sub(1)), path: rel)) {
                    return result\ok::<bool>(false);
                }
            } else if (path\matches(normalizePattern(raw), path: rel)) {
                included = true;
            }
        }
    } catch (err: any) {
        return result\caught::<bool>(err);
    }
    return result\ok::<bool>(included);
}

// The workspace a package installs under: the one it roots, else the nearest one whose
// globs name it.
fun owningWorkspace(pkg: NodePackage, workspaces: [NodeWorkspace]) > result\Result::<NodeWorkspace?> {
    var best: NodeWorkspace? = null;
    foreach (ws in workspaces) {
        if (ws.root == pkg.dir) {
            return result\ok::<NodeWorkspace?>(ws);
        }
        final member = isMember(ws, dir: pkg.dir);
        if (member.error -> err) {
            return result\Result::<NodeWorkspace?>{ error = err };
        }
        if (member.value! and (best == null or ws.root.len() > best!.root.len())) {
            best = ws;
        }
    }
    return result\ok::<NodeWorkspace?>(best);
}

fun packageNamed(name: str, ws: NodeWorkspace, packages: [NodePackage]) > result\Result::<NodePackage?> {
    foreach (other in packages) {
        if (other.name != name) {
            continue;
        }
        if (other.dir == ws.root) {
            return result\ok::<NodePackage?>(other);
        }
        final member = isMember(ws, dir: other.dir);
        if (member.error -> err) {
            return result\Result::<NodePackage?>{ error = err };
        }
        if (member.value!) {
            return result\ok::<NodePackage?>(other);
        }
    }
    return result\ok::<NodePackage?>(null);
}

fun packageAt(dir: str, packages: [NodePackage]) > NodePackage? {
    foreach (other in packages) {
        if (other.dir == dir) {
            return other;
        }
    }
    return null;
}

fun dependsOn(pkg: NodePackage, ws: NodeWorkspace?, packages: [NodePackage], gaps: mut [DiscoveryGap]) > result\Result::<[str]> {
    final deps = mut {<str: bool>};
    foreach (field in LINKED_DEPENDENCY_FIELDS) {
        final declared = asMap(pkg.manifest[field]);
        foreach (name in sortedKeys(declared)) {
            final spec = declared[name];
            if (!(spec is str)) {
                continue;
            }
            final range = "{spec}";
            var linked: NodePackage? = null;
            if (range.startsWith("workspace:")) {
                if (ws -> workspace) {
                    final named = packageNamed(name, ws: workspace, packages: packages);
                    if (named.error -> err) {
                        return result\Result::<[str]>{ error = err };
                    }
                    linked = named.value;
                }
                if (linked == null) {
                    gaps.append(gap(pkg.file, why: "{field}.{name}: {range} names no package in this workspace"));
                }
            } else if (range.startsWith("file:") or range.startsWith("link:")) {
                final target = range.sub(range.indexOf(":")! + 1);
                linked = packageAt(path\join([pkg.dir, target]), packages: packages);
                if (linked == null) {
                    gaps.append(gap(pkg.file, why: "{field}.{name}: {range} is no discovered package, so no dependency was drawn"));
                }
            } else if (ws -> workspace) {
                final member = packageNamed(name, ws: workspace, packages: packages);
                if (member.error -> err) {
                    return result\Result::<[str]>{ error = err };
                }
                if (member.value -> sibling) {
                    if (workspace.pnpm) {
                        gaps.append(gap(pkg.file, why: "{field}.{name}: names the workspace package in {sibling.dir}, but pnpm links a version range only under link-workspace-packages; write workspace:{range} to make it an edge"));
                    } else {
                        linked = sibling;
                    }
                }
            }
            if (linked -> other) {
                if (other.dir != pkg.dir) {
                    deps[other.dir] = true;
                }
            }
        }
    }
    return result\ok::<[str]>(sortedKeys(deps));
}

fun hasDependency(pkg: NodePackage, name: str) > bool {
    return asMap(pkg.manifest["dependencies"])[name] != null or asMap(pkg.manifest["devDependencies"])[name] != null;
}

fun ownerOf(file: str, packages: [NodePackage]) > str? {
    var best: str? = null;
    foreach (pkg in packages) {
        if (path\within(pkg.dir, path: file) and (best == null or pkg.dir.len() > best!.len())) {
            best = pkg.dir;
        }
    }
    return best;
}

// lintFormatTargets wires the linters and formatters pkg depends on.
fun lintFormatTargets(pkg: NodePackage, targets: mut {str: [str]}) > void {
    final lint = mut [<str>];
    final format = mut [<str>];
    if (hasDependency(pkg, name: "eslint")) {
        lint.append("eslint");
    }
    if (hasDependency(pkg, name: "@biomejs/biome")) {
        lint.append("biome-check");
        format.append("biome-format");
    }
    if (hasDependency(pkg, name: "prettier")) {
        format.append("prettier");
    }
    if (lint.len() > 0) {
        targets["lint"] = lint;
    }
    if (format.len() > 0) {
        targets["format"] = format;
    }
}

// buildTarget wires tsc-build when pkg holds tsconfig.json, with a gap for each tsconfig
// variant or bundler config no op runs.
fun buildTarget(pkg: NodePackage, owned: [str], targets: mut {str: [str]}, gaps: mut [DiscoveryGap]) > void {
    if (owned.indexOf(path\join([pkg.dir, "tsconfig.json"])) != null) {
        targets["build"] = ["tsc-build"];
    } else {
        foreach (file in owned) {
            if (path\dir(file) == pkg.dir and path\base(file).startsWith("tsconfig")) {
                gaps.append(gap(file, why: "tsc --build reads tsconfig.json, which this package lacks, so no build was wired"));
            }
        }
    }
    foreach (file in owned) {
        if (path\dir(file) != pkg.dir) {
            continue;
        }
        foreach (prefix in BUNDLER_CONFIG_PREFIXES) {
            if (path\base(file).startsWith(prefix)) {
                gaps.append(gap(file, why: "bundler config: no op runs it, so build does not cover what it emits"));
            }
        }
    }
}

// testTarget wires vitest or node --test, and gaps a test runner no op runs.
fun testTarget(pkg: NodePackage, owned: [str], targets: mut {str: [str]}, gaps: mut [DiscoveryGap]) > result\Result::<bool> {
    if (hasDependency(pkg, name: "vitest")) {
        targets["test"] = ["vitest"];
        return result\ok::<bool>(true);
    }
    var unwired = false;
    foreach (runner in UNWIRED_TEST_RUNNERS) {
        if (hasDependency(pkg, name: runner)) {
            unwired = true;
            gaps.append(gap(pkg.file, why: "{runner}: no op in this spell runs it, so no test was wired"));
        }
    }
    if (unwired) {
        return result\ok::<bool>(true);
    }
    var nodeTests = false;
    var tsTests: str? = null;
    try {
        foreach (file in owned) {
            final rel = path\rel(pkg.dir, target: file);
            if (path\matchesAny(NODE_TEST_PATTERNS, path: rel)) {
                nodeTests = true;
            } else if (tsTests == null and path\matchesAny(TS_TEST_PATTERNS, path: rel)) {
                tsTests = file;
            }
        }
    } catch (err: any) {
        return result\caught::<bool>(err);
    }
    if (nodeTests) {
        targets["test"] = ["node-test"];
    } else if (tsTests -> file) {
        gaps.append(gap(file, why: "a test file with no vitest dependency and no name node --test finds by default, so no test was wired"));
    }
    return result\ok::<bool>(true);
}

fun targetsOf(pkg: NodePackage, owned: [str], gaps: mut [DiscoveryGap]) > result\Result::<{str: [str]}> {
    final targets = mut {<str: [str]>};
    lintFormatTargets(pkg, targets: targets);
    buildTarget(pkg, owned: owned, targets: targets, gaps: gaps);
    final wired = testTarget(pkg, owned: owned, targets: targets, gaps: gaps);
    if (wired.error -> err) {
        return result\Result::<{str: [str]}>{ error = err };
    }
    return result\ok::<{str: [str]}>(targets);
}

// NodeScan is what discover_projects read of the query: every package, each one's parse
// gaps, the workspaces that link them, and the gaps a workspace file carries.
object NodeScan {
    packages: mut [NodePackage],
    gapsByFile: mut {str: [DiscoveryGap]},
    workspaces: mut [NodeWorkspace],
    workspaceGaps: mut [DiscoveryGap],
}

// nodeScan parses each pnpm-workspace.yaml, then each package.json and the workspaces field
// pnpm does not own.
fun nodeScan(req: DiscoveryQuery) > result\Result::<NodeScan> {
    final scan = NodeScan{packages = mut [], gapsByFile = mut {}, workspaces = mut [], workspaceGaps = mut []};
    final pnpmRoots = mut {<str: bool>};
    foreach (file in req.files) {
        if (path\base(file.path) == "pnpm-workspace.yaml") {
            final parsed = parsePnpmWorkspace(file, gaps: scan.workspaceGaps);
            if (parsed.error -> err) {
                return result\Result::<NodeScan>{ error = err };
            }
            if (parsed.value -> ws) {
                scan.workspaces.append(ws);
                pnpmRoots[ws.root] = true;
            }
        }
    }
    foreach (file in req.files) {
        if (path\base(file.path) != "package.json") {
            continue;
        }
        final gaps = mut [<DiscoveryGap>];
        final parsed = parsePackage(file, gaps: gaps);
        if (parsed.error -> err) {
            return result\Result::<NodeScan>{ error = err };
        }
        final pkg = parsed.value!;
        if (pnpmRoots[pkg.dir] ?? false) {
            if (pkg.manifest["workspaces"] != null) {
                gaps.append(gap(pkg.file, why: "workspaces: pnpm reads its members from pnpm-workspace.yaml, so this field was ignored"));
            }
        } else if (workspaceOf(pkg, gaps: gaps) -> ws) {
            scan.workspaces.append(ws);
        }
        scan.packages.append(pkg);
        scan.gapsByFile[pkg.file] = gaps;
    }
    return result\ok::<NodeScan>(scan);
}

// unmatchedGlobs gaps each workspace glob that matches no package.json.
fun unmatchedGlobs(scan: NodeScan) > result\Result::<bool> {
    try {
        foreach (ws in scan.workspaces) {
            foreach (raw in ws.patterns) {
                if (raw.startsWith("!")) {
                    continue;
                }
                var matched = false;
                foreach (pkg in scan.packages) {
                    if (pkg.dir != ws.root and path\within(ws.root, path: pkg.dir)
                        and path\matches(normalizePattern(raw), path: path\rel(ws.root, target: pkg.dir))) {
                        matched = true;
                    }
                }
                if (!matched) {
                    scan.workspaceGaps.append(gap(ws.file, why: "workspace glob {raw} matches no package.json"));
                }
            }
        }
    } catch (err: any) {
        return result\caught::<bool>(err);
    }
    return result\ok::<bool>(true);
}

// nodeClaim claims one package with the files it owns.
fun nodeClaim(pkg: NodePackage, scan: NodeScan, owned: [str]) > result\Result::<DiscoveredProject> {
    final gaps = scan.gapsByFile[pkg.file]!.cloneMutable();
    final ws = owningWorkspace(pkg, workspaces: scan.workspaces);
    if (ws.error -> err) {
        return result\Result::<DiscoveredProject>{ error = err };
    }
    final deps = dependsOn(pkg, ws: ws.value, packages: scan.packages, gaps: gaps);
    if (deps.error -> err) {
        return result\Result::<DiscoveredProject>{ error = err };
    }
    final wired = targetsOf(pkg, owned: owned, gaps: gaps);
    if (wired.error -> err) {
        return result\Result::<DiscoveredProject>{ error = err };
    }
    final targets = wired.value!;
    foreach (script in sortedKeys(asMap(pkg.manifest["scripts"]))) {
        gaps.append(gap(pkg.file, why: "scripts.{script}: meaning unknown, so it was not wired; a package.json script never runs as a target"));
    }
    if (targets.len() == 0) {
        gaps.append(gap(pkg.file, why: "no tsconfig.json, test runner, linter or formatter found, so no target was wired"));
    }
    foreach (wsGap in scan.workspaceGaps) {
        if (path\dir(wsGap.file) == pkg.dir) {
            gaps.append(wsGap);
        }
    }
    return result\ok::<DiscoveredProject>(DiscoveredProject{path = pkg.dir, role = DiscoveryRole.project, name = pkg.name, dependsOn = deps.value!,
        targets = targets, notInferred = gaps});
}

// nodeClaims is every package's claim, sorted by path.
fun nodeClaims(req: DiscoveryQuery) > result\Result::<[DiscoveredProject]> {
    final scanned = nodeScan(req);
    if (scanned.error -> err) {
        return result\Result::<[DiscoveredProject]>{ error = err };
    }
    final scan = scanned.value!;
    final globs = unmatchedGlobs(scan);
    if (globs.error -> err) {
        return result\Result::<[DiscoveredProject]>{ error = err };
    }
    final owned = mut {<str: mut [str]>};
    foreach (file in req.files) {
        if (ownerOf(file.path, packages: scan.packages) -> dir) {
            if (owned[dir] == null) {
                owned[dir] = mut [<str>];
            }
            owned[dir]!.append(file.path);
        }
    }
    final claims = mut [<DiscoveredProject>];
    foreach (pkg in scan.packages) {
        final claim = nodeClaim(pkg, scan: scan, owned: owned[pkg.dir] ?? [<str>]);
        if (claim.error -> err) {
            return result\Result::<[DiscoveredProject]>{ error = err };
        }
        claims.append(claim.value!);
    }
    _ = claims.sort(fun (left: DiscoveredProject, right: DiscoveredProject) > bool => left.path < right.path);
    return result\ok::<[DiscoveredProject]>(claims);
}

// discover_projects claims one project per package.json. Workspace globs from
// pnpm-workspace.yaml or package.json workspaces decide which packages link by
// name. Every package.json script is reported, never wired: its meaning is the
// project's.
export fun discover_projects(target: Target, req: DiscoveryQuery) > [DiscoveredProject] !> any { //nolint:no-throw // magus reads a raise as a failed discovery
    final claims = nodeClaims(req);
    if (claims.error -> err) {
        //nolint:no-throw // magus reads a raise as a failed discovery
        throw err.message;
    }
    return claims.value!;
}
