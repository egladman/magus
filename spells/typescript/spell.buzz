// Opaque (mgs_isOpaque) because pnpm manages its own dependency graph:
// magus treats the project as a black box rather than tracking per-file inputs.
//
// eslint+prettier or Biome: this one spell offers both toolchains as separate
// ops (eslint/prettier vs biome-check/biome-format) rather than shipping a
// second spell targeting the same files. The magusfile
// - not the spell - decides which pair composes into lint/format; a project
// picks one pair, not both.

import "magus/spell";
// charm constructors derive argv patches from an anchor arg, not a counted index.
import "magus/charm";

export fun mgs_getName() > str { return "typescript"; }

export fun mgs_listRequiredGlobs() > [Path] {
    // tsconfig*.json is listed explicitly even though the broader **/*.json below
    // already matches it - self-documenting rather than riding along by accident.
    return [Path{value = "**/*.ts"}, Path{value = "**/*.tsx"}, Path{value = "**/*.mts"}, Path{value = "**/*.cts"}, Path{value = "**/*.js"}, Path{value = "**/*.jsx"},
            Path{value = "**/*.mjs"}, Path{value = "**/*.cjs"}, Path{value = "**/*.json"}, Path{value = "tsconfig*.json"}, Path{value = "package.json"},
            Path{value = ".npmrc"}, Path{value = "pnpm-lock.yaml"}, Path{value = "package-lock.json"}, Path{value = "npm-shrinkwrap.json"},
            Path{value = "yarn.lock"}, Path{value = "bun.lockb"}];
}

export fun mgs_isOpaque() > bool { return true; }

// Empty on purpose. Where tsc writes is decided by the project's tsconfig outDir, which this
// spell cannot read - so any glob here is a guess, and "dist/**" was the TS convention rather
// than a fact about your project.
//
// A guess is not free. Provided globs are contributed to EVERY target on a project, so a target
// that declares no ctx.writesFiles of its own inherits them; on a cache miss its snapshot then
// has to satisfy a glob it never writes. That failure only appears on a cold cache, so it hid
// for a long time across four projects here, none of which emit to dist/ (see MGS1018).
//
// Declare the real output location on the project instead - `"outputs": ["gen/**"]` - or on the
// target with ctx.writesFiles. A spell should claim what it can verify; this it cannot.
export fun mgs_listProvidedGlobs() > [Path] { return [<Path>]; }


// mgs_getLanguage names the source language this spell adapts, canonical and lowercase
// so it matches the language attr on the TypeScript files and symbols SCIP ingests. It
// lets `magus query language:typescript` reach this adapter alongside the code it builds.
// The three binaries this spell's ops actually depend on, not just the runtime.
//
// tsc is the one that matters most and was missing longest: every op here runs it through
// `pnpm exec`, and a probe result is a CACHE-KEY INPUT, so while it went undeclared magus
// would replay a cached typecheck produced by a different compiler. A TypeScript major is
// exactly the kind of upgrade that changes what `tsc` accepts, which is the case the key
// exists to catch. Its probe forks pnpm rather than tsc directly because tsc is a local
// node_modules binary with no stable path; `pnpm exec` is how every op reaches it too. An
// uninstalled tree makes the probe fail, which magus treats as unprobeable rather than as
// a failure - the same degradation a missing binary gets.
//
// pnpm is declared for the same reason one step out: it resolves the dependency graph
// every op builds against, and this repo pins it (mise.toml) precisely because the
// resolution differs across versions.
//
// node keeps no `key` narrowing, so its whole probe line keys the cache, matching what it
// did before these two were added.
export fun mgs_getTools() > {str: Tool} {
    return {
        "node": Tool{probe = Command{bin = "node", args = ["--version"]}},
        "pnpm": Tool{probe = Command{bin = "pnpm", args = ["--version"]},
                     key = VersionKey{upTo = VersionComponent.patch}},
        "tsc": Tool{probe = Command{bin = "pnpm", args = ["exec", "tsc", "--version"]},
                    key = VersionKey{upTo = VersionComponent.patch}},
    };
}

export fun mgs_getLanguage() > str { return "typescript"; }

// mgs_listIgnoreDirs names non-source dirs the node/ts ecosystem generates, pruned
// from the input-hashing walk. dist is already excluded as a declared output, and
// .turbo/.pnpm-store are dot-dirs skipped structurally, so only node_modules belongs here.
export fun mgs_listIgnoreDirs() > [Path] { return [Path{value = "node_modules", isDir = true}]; }

// mgs_listManifests names the file that carries this project's OWN version - not
// the toolchain's (that's mgs_getTools) and not a cache input (package.json
// is separately listed in mgs_listRequiredGlobs above, because it also feeds the
// cache key). A node project has exactly one candidate.
export fun mgs_listManifests() > [Path] { return [Path{value = "package.json"}]; }

// PACKAGE_MANAGER_HINTS classify the failures that follow a stale install - the case where
// somebody else's merge changed the lockfile and node_modules did not move with it. The
// tool says what broke; none of these say "your install is out of date", which is the
// actual fact and the reason this spell declares them.
//
// Every manager gets its own phrasing because every manager invented one. The ops here
// currently fork pnpm, so the npm/yarn/bun entries cannot fire yet - they are declared
// anyway because a non-matching string costs nothing, and the engine-side package-manager
// substitution (a spell opts in, the runner forks the project's detected manager) makes
// them live without touching this list again. An entry that never matches is inert; an
// entry missing when the substitution lands is a silent gap.
//
// Only exact error CODES and verbatim messages are matched. A wrong hint is worse than
// none, so a phrasing that drifts between releases does not belong here.
final PACKAGE_MANAGER_HINTS = [
    // pnpm
    Hint{contains = "ERR_PNPM_OUTDATED_LOCKFILE",
         advise = "pnpm-lock.yaml disagrees with package.json - usually a merge that changed one of them; run `pnpm install` and commit the lockfile"},
    Hint{contains = "ERR_PNPM_NO_SCRIPT",
         advise = "package.json declares no such script; check the name, or the target may be pointed at the wrong project"},
    // npm. `npm ci` refuses rather than silently reconciling, which is the right call and
    // also the one that reads as a wall of text; the fix is one command.
    Hint{contains = "can only install packages when your package.json and package-lock.json",
         advise = "package-lock.json disagrees with package.json - usually a merge that changed one of them; run `npm install` and commit the lockfile"},
    Hint{contains = "Missing script:",
         advise = "package.json declares no such script; check the name, or the target may be pointed at the wrong project"},
    // yarn: classic, then berry.
    Hint{contains = "Your lockfile needs to be updated",
         advise = "yarn.lock disagrees with package.json; run `yarn install` and commit the lockfile"},
    Hint{contains = "The lockfile would have been modified by this install",
         advise = "yarn.lock disagrees with package.json; run `yarn install` and commit the lockfile"},
    // bun
    Hint{contains = "lockfile had changes, but lockfile is frozen",
         advise = "the bun lockfile disagrees with package.json; run `bun install` and commit the lockfile"},
    // Manager-agnostic: node and the shell, whatever installed (or failed to install).
    Hint{contains = "Cannot find module",
         advise = "a dependency is missing from node_modules, usually a stale install; run your package manager's install"},
    Hint{contains = "command not found",
         advise = "the tool is not in node_modules/.bin, usually a stale or missing install; run your package manager's install"},
];

// biome-check is biome's lint/analyze pass (eslint's role, if your project
// chose Biome over eslint+prettier - the magusfile decides which composes
// into lint, not this spell). --write and --reporter=github verified against
// the current Biome CLI docs (biomejs.dev/reference/cli).
fun biomeCheck(target: Target) > Command {
    final args = ["exec", "biome", "check", "."];
    return Command{bin = "pnpm", args = args, hints = PACKAGE_MANAGER_HINTS, charms = {
        "rw":  after(args, "check", ["--write"]),
        "gha": after(args, "check", ["--reporter=github"]),
    }};
}
// biome-format is biome's formatter (prettier's role). Unlike prettier/ruffFormat,
// `biome format` has no --check flag to drop: it is read-only by default (reports
// differences, writes nothing) and --write applies them, so rw ADDS a flag instead
// of removing one.
fun biomeFormat(target: Target) > Command {
    final args = ["exec", "biome", "format", "."];
    return Command{bin = "pnpm", args = args, hints = PACKAGE_MANAGER_HINTS, charms = {
        "rw": after(args, "format", ["--write"]),
    }};
}
// eslint has no built-in "github" formatter (unlike ruff's --output-format=github);
// "unix" is the built-in, no-extra-devDependency formatter closest to a CI-friendly,
// one-line-per-problem shape for annotation/regex parsing.
fun eslint(target: Target) > Command {
    final args = ["exec", "eslint", "."];
    return Command{bin = "pnpm", args = args, hints = PACKAGE_MANAGER_HINTS, charms = {
        "rw": after(args, "eslint", ["--fix"]),
        "gha": after(args, "eslint", ["--format=unix"]),
    }};
}
// preflight is a no-op marker op (no command).
fun preflight(target: Target) > Command { return Command{}; }
fun prettier(target: Target) > Command {
    final args = ["exec", "prettier", "--check", "."];
    return Command{bin = "pnpm", args = args, hints = PACKAGE_MANAGER_HINTS, charms = {
        "rw": set(args, "--check", "--write"),
    }};
}
fun tsc(target: Target) > Command { return Command{bin = "pnpm", args = ["exec", "tsc"], hints = PACKAGE_MANAGER_HINTS}; }
// tsc-build uses TypeScript's project-references incremental build mode (works
// even without declared references, via its own .tsbuildinfo cache), emitting per
// tsconfig outDir - see mgs_listProvidedGlobs.
fun tscBuild(target: Target) > Command { return Command{bin = "pnpm", args = ["exec", "tsc", "--build"]}; }
// tsc-clean mirrors tsc-build's project-references mode: --clean removes the
// declared outputs and the incremental .tsbuildinfo cache.
fun tscClean(target: Target) > Command { return Command{bin = "pnpm", args = ["exec", "tsc", "--build", "--clean"]}; }
fun vitest(target: Target) > Command {
    return Command{bin = "pnpm", args = ["exec", "vitest", "run"], charms = {
        "gha": append(["--reporter=github-actions"]),
    }};
}
// dev-server runs the project's package.json "dev" script via the package
// manager - framework-neutral (Vite, Next, webpack-dev-server, ...). No
// readiness probe is declared: the port and startup signal vary by framework,
// so guessing one would be wrong more often than right (readiness is
// optional - see services.md). A magusfile that needs to block on readiness
// for its specific dev server can declare its own service op instead.
fun devServer(target: Target) > Service {
    return Service{command = Command{bin = "pnpm", args = ["run", "dev"]}};
}
// scip is the reserved op that runs the TypeScript SCIP indexer for the knowledge
// graph. The indexer is a PATH binary (install it with mise, not as a project dep), so
// the op forks it directly. magus injects MAGUS_SYMBOL_INDEX with the cache destination,
// so the index never lands in the tree; scip-typescript writes there via --output. The
// runner resolves the bare $MAGUS_SYMBOL_INDEX token against that destination, so no
// shell is needed to expand it.
fun scip(target: Target) > Command {
    return Command{bin = "scip-typescript", args = ["index", "--output", "$MAGUS_SYMBOL_INDEX"]};
}

// mgs_listTargets is typed `any` (not {str: fun(Target) Command}) because
// dev-server mixes in a Service-returning op alongside the Command-returning ones.
export fun mgs_listTargets() > any {
    return {"biome-check": biomeCheck, "biome-format": biomeFormat,
            "eslint": eslint, "preflight": preflight, "prettier": prettier, "tsc": tsc,
            "tsc-build": tscBuild, "tsc-clean": tscClean, "vitest": vitest,
            "dev-server": devServer, "scip": scip};
}
