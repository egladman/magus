import "std";
import "magus/spell";
import "./spell" as typescript;

fun marker(path: str, content: str) > DiscoveryFile {
    return DiscoveryFile{path = path, content = content};
}

fun source(path: str) > DiscoveryFile {
    return DiscoveryFile{path = path};
}

fun discover(files: [DiscoveryFile]) > [DiscoveredProject] !> any {
    return typescript\discover_projects(Target{}, req: DiscoveryQuery{root = "/repo", files = files});
}

fun claimAt(claims: [DiscoveredProject], path: str) > DiscoveredProject {
    foreach (claim in claims) {
        if (claim.path == path) {
            return claim;
        }
    }
    throw "no claim at {path}";
}

fun hasGap(claim: DiscoveredProject, file: str, about: str) > bool {
    foreach (gap in claim.notInferred) {
        if (gap.file == file and gap.why.indexOf(about) != null) {
            return true;
        }
    }
    return false;
}

fun opsOf(claim: DiscoveredProject, target: str) > str {
    return (claim.targets[target] ?? [<str>]).join(",");
}

test "a package wires the tools it declares and reports every script" {
    final claims = discover([
        marker("package.json", content: `\{"name": "web", "devDependencies": \{"eslint": "9", "prettier": "3", "vitest": "2", "typescript": "5"}, "scripts": \{"dev": "vite", "test": "vitest"}}`),
        source("tsconfig.json"),
        source("src/main.ts"),
    ]) catch [<DiscoveredProject>];
    std\assert(claims.len() == 1, message: "one package.json is one claim");
    final root = claimAt(claims, path: ".") catch DiscoveredProject{};
    std\assert(root.role.value == "project", message: "a package forms a project");
    std\assert(root.name == "web", message: "the package name labels the project");
    std\assert(opsOf(root, target: "lint") == "eslint", message: "eslint lints");
    std\assert(opsOf(root, target: "format") == "prettier", message: "prettier formats");
    std\assert(opsOf(root, target: "build") == "tsc-build", message: "tsconfig.json builds with tsc --build");
    std\assert(opsOf(root, target: "test") == "vitest", message: "vitest tests");
    std\assert(hasGap(root, file: "package.json", about: "scripts.dev:"), message: "scripts.dev is reported");
    std\assert(hasGap(root, file: "package.json", about: "scripts.test:"), message: "scripts.test is reported, never run");
}

test "biome lints and formats" {
    final claims = discover([marker("package.json", content: `\{"devDependencies": \{"@biomejs/biome": "1"}}`)]) catch [<DiscoveredProject>];
    final root = claimAt(claims, path: ".") catch DiscoveredProject{};
    std\assert(opsOf(root, target: "lint") == "biome-check", message: "biome-check lints");
    std\assert(opsOf(root, target: "format") == "biome-format", message: "biome-format formats");
}

test "a pnpm workspace links members through workspace: ranges" {
    final claims = discover([
        marker("package.json", content: `\{"name": "root"}`),
        marker("pnpm-workspace.yaml", content: "packages:\n  - \"packages/*\"\n"),
        marker("packages/a/package.json", content: `\{"name": "@x/a", "dependencies": \{"@x/b": "workspace:*"}}`),
        marker("packages/b/package.json", content: `\{"name": "@x/b"}`),
    ]) catch [<DiscoveredProject>];
    std\assert(claims.len() == 3, message: "the root and both members are projects");
    final a = claimAt(claims, path: "packages/a") catch DiscoveredProject{};
    std\assert(a.dependsOn.join(",") == "packages/b", message: "workspace:* is an edge to the member's directory");
    final b = claimAt(claims, path: "packages/b") catch DiscoveredProject{};
    std\assert(b.dependsOn.len() == 0, message: "b depends on nothing");
}

test "pnpm does not link a plain range, and says so" {
    final claims = discover([
        marker("pnpm-workspace.yaml", content: "packages: [\"packages/*\"]\n"),
        marker("packages/a/package.json", content: `\{"name": "a", "dependencies": \{"b": "^1.0.0"}}`),
        marker("packages/b/package.json", content: `\{"name": "b"}`),
    ]) catch [<DiscoveredProject>];
    final a = claimAt(claims, path: "packages/a") catch DiscoveredProject{};
    std\assert(a.dependsOn.len() == 0, message: "no edge without workspace:");
    std\assert(hasGap(a, file: "packages/a/package.json", about: "link-workspace-packages"), message: "the missing edge is reported");
}

test "a workspace: range naming no member is reported" {
    final claims = discover([
        marker("pnpm-workspace.yaml", content: "packages: [\"packages/*\"]\n"),
        marker("packages/a/package.json", content: `\{"name": "a", "dependencies": \{"gone": "workspace:^"}}`),
    ]) catch [<DiscoveredProject>];
    final a = claimAt(claims, path: "packages/a") catch DiscoveredProject{};
    std\assert(hasGap(a, file: "packages/a/package.json", about: "dependencies.gone: workspace:^ names no package"), message: "an unresolved workspace: range is a gap");
}

test "npm workspaces link a plain range by name" {
    final claims = discover([
        marker("package.json", content: `\{"workspaces": \{"packages": ["apps/*", "!apps/legacy"]}}`),
        marker("apps/web/package.json", content: `\{"name": "web", "devDependencies": \{"ui": "1.0.0"}}`),
        marker("apps/ui/package.json", content: `\{"name": "ui"}`),
        marker("apps/legacy/package.json", content: `\{"name": "ui"}`),
    ]) catch [<DiscoveredProject>];
    final web = claimAt(claims, path: "apps/web") catch DiscoveredProject{};
    std\assert(web.dependsOn.join(",") == "apps/ui", message: "the member named ui, not the excluded one");
}

test "a file: range is an edge to the package at that path" {
    final claims = discover([
        marker("app/package.json", content: `\{"dependencies": \{"lib": "file:../lib", "tarball": "file:../vendor/x.tgz"}}`),
        marker("lib/package.json", content: `\{"name": "lib"}`),
    ]) catch [<DiscoveredProject>];
    final app = claimAt(claims, path: "app") catch DiscoveredProject{};
    std\assert(app.dependsOn.join(",") == "lib", message: "file:../lib resolves to lib");
    std\assert(hasGap(app, file: "app/package.json", about: "dependencies.tarball:"), message: "a file: range to no package is reported");
}

test "node test files without vitest run under node-test" {
    final claims = discover([
        marker("package.json", content: `\{}`),
        source("lib/parse.test.mjs"),
        source("lib/parse.mjs"),
    ]) catch [<DiscoveredProject>];
    final root = claimAt(claims, path: ".") catch DiscoveredProject{};
    std\assert(opsOf(root, target: "test") == "node-test", message: "node --test finds parse.test.mjs");
}

test "a nested package's test files are its own" {
    final claims = discover([
        marker("package.json", content: `\{}`),
        marker("sub/package.json", content: `\{}`),
        source("sub/a.test.js"),
    ]) catch [<DiscoveredProject>];
    final root = claimAt(claims, path: ".") catch DiscoveredProject{};
    final sub = claimAt(claims, path: "sub") catch DiscoveredProject{};
    std\assert(root.targets["test"] == null, message: "the root owns no test file");
    std\assert(opsOf(sub, target: "test") == "node-test", message: "sub owns a.test.js");
}

test "TypeScript test files without vitest are reported" {
    final claims = discover([marker("package.json", content: `\{}`), source("src/a.test.ts")]) catch [<DiscoveredProject>];
    final root = claimAt(claims, path: ".") catch DiscoveredProject{};
    std\assert(root.targets["test"] == null, message: "nothing runs a.test.ts");
    std\assert(hasGap(root, file: "src/a.test.ts", about: "no vitest dependency"), message: "the test file is reported");
}

test "a test runner with no op is reported and blocks node-test" {
    final claims = discover([marker("package.json", content: `\{"devDependencies": \{"jest": "29"}}`), source("a.test.js")]) catch [<DiscoveredProject>];
    final root = claimAt(claims, path: ".") catch DiscoveredProject{};
    std\assert(root.targets["test"] == null, message: "jest's tests are not node's");
    std\assert(hasGap(root, file: "package.json", about: "jest: no op"), message: "jest is reported");
}

test "build config the spell cannot run is reported" {
    final claims = discover([
        marker("package.json", content: `\{"devDependencies": \{"eslint": "9"}}`),
        source("tsconfig.build.json"),
        source("vite.config.ts"),
    ]) catch [<DiscoveredProject>];
    final root = claimAt(claims, path: ".") catch DiscoveredProject{};
    std\assert(root.targets["build"] == null, message: "no tsconfig.json, no tsc-build");
    std\assert(hasGap(root, file: "tsconfig.build.json", about: "reads tsconfig.json"), message: "the stray tsconfig is reported");
    std\assert(hasGap(root, file: "vite.config.ts", about: "bundler config"), message: "the bundler config is reported");
}

test "a package with nothing to wire says so" {
    final claims = discover([marker("package.json", content: `\{"scripts": \{"start": "node ."}}`)]) catch [<DiscoveredProject>];
    final root = claimAt(claims, path: ".") catch DiscoveredProject{};
    std\assert(root.targets.len() == 0, message: "no target");
    std\assert(hasGap(root, file: "package.json", about: "no target was wired"), message: "the empty project is reported");
}

test "a package.json that is not JSON is still a project, with a gap" {
    final claims = discover([marker("package.json", content: "\{not json")]) catch [<DiscoveredProject>];
    final root = claimAt(claims, path: ".") catch DiscoveredProject{};
    std\assert(hasGap(root, file: "package.json", about: "not a JSON object"), message: "the parse failure is reported");
}

test "a workspace glob that matches nothing is reported on the workspace root" {
    final claims = discover([
        marker("package.json", content: `\{}`),
        marker("pnpm-workspace.yaml", content: "packages: [\"tools/*\"]\n"),
    ]) catch [<DiscoveredProject>];
    final root = claimAt(claims, path: ".") catch DiscoveredProject{};
    std\assert(hasGap(root, file: "pnpm-workspace.yaml", about: "tools/* matches no package.json"), message: "the dead glob is reported");
}

test "a marker without content fails the answer" {
    var failed = false;
    try {
        _ = discover([source("package.json")]);
    } catch {
        failed = true;
    }
    std\assert(failed, message: "a package.json passed as a bare path is a contract break, never an empty project");
}

test "every wired op is one this spell declares" {
    final claims = discover([
        marker("package.json", content: `\{"devDependencies": \{"eslint": "9", "prettier": "3", "@biomejs/biome": "1", "vitest": "2"}}`),
        source("tsconfig.json"),
    ]) catch [<DiscoveredProject>];
    final ops = typescript\mgs_listTargets();
    foreach (claim in claims) {
        foreach (name, wired in claim.targets) {
            std\assert(name != "ci", message: "core composes ci");
            foreach (op in wired) {
                std\assert(ops[op] != null, message: "{op} is a declared op");
            }
        }
    }
}
