import "std";
import "magus/spell";
import "./spell" as buzz;

test "buzz declares ident and string encodings" {
    final encodings = buzz\mgs_getLanguage().syntax!.encodings;
    std\assert(encodings.map(fun (i: int, e: Encoding) > str => e.name).join(" ") == "ident string", message: "names");
    std\assert(encodings[0].pattern == "^[A-Za-z_][A-Za-z0-9_]*$", message: "ASCII name");
    std\assert(encodings[0].reserved.join(" ").indexOf(" foreach ") != null, message: "foreach refused");
    final string = encodings[1];
    std\assert(string.open == "\"" and string.close == "\"", message: "double quotes");
    final escapes = string.escapes.map(fun (i: int, e: Escape) > str => "{e.text}={e.to}").join(" ");
    std\assert(escapes == "\\=\\\\ \"=\\\" \{=\\\{ \n=\\n \r=\\r \t=\\t", message: "backslash, quote, open brace, newline, return, tab");
    std\assert(string.control == "", message: "other controls refused");
}

test "decisions count match arms and every branching word" {
    final decisions = buzz\mgs_getLanguage().syntax!.decisions!;
    std\assert(decisions.keywords.join(" ") == "if while for foreach and or catch", message: "keywords");
    std\assert(decisions.operators.join(" ") == "?? ->", message: "operators");
}

test "magus-buzz-test runs magus itself on the file and its sibling test" {
    final test = buzz\mgs_listTargets()["magus-buzz-test"]!(Target{});
    std\assert(test.bin == "$MAGUS", message: "bin");
    std\assert(test.args.join(" ") == "buzz -t --embedded", message: "argv");
    std\assert(test.testScope.join(" ") == "\{file\} \{dir\}/\{stem\}_test.buzz", message: "scope");
}

test "coverage is an lcov tracefile under coverage/buzz" {
    final coverage = buzz\mgs_getCoverage();
    std\assert(coverage.format == CoverageFormat.lcov, message: "format");
    std\assert(coverage.profile == "coverage/buzz/lcov.info", message: "profile");
}

test "no op shares its name with a magusfile target" {
    std\assert(!buzz\mgs_listTargets().hasKey("buzz-test"), message: "buzz-test is a target in . and docs");
}
