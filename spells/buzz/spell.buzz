// Buzz's language identity and its symbol indexer. magus writes its own magusfile and
// spells in Buzz, so a workspace full of .buzz sources needs magus to know what a
// Buzz file IS: which extension carries one, and how to tell code from a comment or
// a string while scanning it.
//
// That identity feeds the readers of source that do not run it - the
// comment-aware scanner behind the knowledge graph and the symbol index, and the
// extension map that binds a file to a project - so removing it does not remove
// work, it makes those readers treat Buzz as unstructured text.
//
// It declares NO ops of its own on purpose. The three it used to carry (buzz-check,
// buzz-test, magus-buzz) forked interpreters that know only the Buzz stdlib, so they
// could not load a magusfile or a spell, which is every Buzz file in this repository.
// They were checkable only against sources nobody had. `magus buzz -t <file>` runs the
// in-file test blocks directly and needs no spell. The one op it has is the in-process
// indexer magus synthesizes from mgs_getSymbolIndexer, under the name scip-buzz.

import "magus/spell";

export fun mgs_getName() > str { return "buzz"; }

export fun mgs_getLanguage() > Language {
    return Language{
        name = "buzz",
        extensions = [".buzz"],
        syntax = Syntax{
            comments = CommentSyntax{
                lineComments = ["//"],
                blockComments = [CommentBlock{open = "/*", close = "*/"}],
                quotes = [
                    Quote{open = "`", close = "`", ignoreEscape = true},
                    Quote{open = "\"", close = "\""},
                ],
            },
        },
    };
}

export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.buzz"}];
}

// magus indexes the project's Buzz in process, one module file per unit, so the index
// runs no tool. A project bound to another indexing spell too (go, typescript) keeps that
// index under `scip` and builds this one beside it as `scip-buzz`, the op name every
// cached index and doc already uses.
export fun mgs_getSymbolIndexer() > SymbolIndexer {
    return SymbolIndexer{format = SymbolFormat.buzzModule, op = "scip-buzz"};
}
