// Buzz's language identity and its symbol indexer. magus writes its own magusfile and
// spells in Buzz, so a workspace full of .buzz sources needs magus to know what a
// Buzz file IS: which extension carries one, and how to tell code from a comment or
// a string while scanning it.
//
// That identity feeds the readers of source that do not run it - the
// comment-aware scanner behind the knowledge graph and the symbol index, and the
// extension map that binds a file to a project - so removing it does not remove
// work, it makes those readers treat Buzz as unstructured text.
//
// Its test op runs magus itself ($MAGUS). The old ops forked interpreters that
// knew only the Buzz stdlib, so they could not load a magusfile or a spell.
// The other op is the in-process indexer magus synthesizes from
// mgs_getSymbolIndexer, under the name scip-buzz.

import "magus/spell";

export fun mgs_getName() > str { return "buzz"; }

export fun mgs_getLanguage() > Language {
    return Language{
        name = "buzz",
        extensions = [".buzz"],
        syntax = Syntax{
            comments = CommentSyntax{
                lineComments = ["//"],
                blockComments = [CommentBlock{open = "/*", close = "*/"}],
                quotes = [
                    Quote{open = "`", close = "`", ignoreEscape = true},
                    Quote{open = "\"", close = "\""},
                ],
            },
            stubs = StubSyntax{
                kinds = ["Function", "Method"],
                bodyStyle = "brace",
                body = "\{\n    std\\panic(\"unimplemented: \{\{&Name}} lands in \{\{&Branch}}\");\n\}",
            },
            operators = ["==", "!=", "<=", ">=", "??", "->", "!>", "=>", "...", "+=", "-="],
            decisions = DecisionSyntax{keywords = ["if", "while", "for", "foreach", "and", "or", "catch"], operators = ["??", "->"]},
        },
    };
}

export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.buzz"}];
}

// magus indexes the project's Buzz in process, one module file per unit, so the index
// runs no tool. A project bound to another indexing spell too (go, typescript) keeps that
// index under `scip` and builds this one beside it as `scip-buzz`, the op name every
// cached index and doc already uses.
export fun mgs_getSymbolIndexer() > SymbolIndexer {
    return SymbolIndexer{format = SymbolFormat.buzzModule, op = "scip-buzz"};
}

// `magus buzz -t` tests every path it is given, so a file's own test blocks and
// its _test.buzz sibling both run. The op is not named buzz-test, which this
// repo's magusfiles already declare as targets.
fun magusBuzzTest(target: Target) > Command {
    return Command{bin = "$MAGUS", args = ["buzz", "-t", "--embedded"], testScope = ["\{file\}", "\{dir\}/\{stem\}_test.buzz"]};
}

// `magus buzz -t --coverprofile` records only the module under test, so a
// tracefile joined from one run per module credits each line to its own tests.
export fun mgs_getCoverage() > Coverage {
    return Coverage{format = CoverageFormat.lcov, profile = "coverage/buzz/lcov.info"};
}

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {"magus-buzz-test": magusBuzzTest};
}
