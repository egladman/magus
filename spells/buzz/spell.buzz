// magus authors its own config and spells in Buzz, so this spell lets the project
// dogfood - `magus run buzz::buzz-check` type-checks Buzz the way `go::go-vet`
// checks Go.
//
// It supports two interpreters, and a magusfile picks per op (the names don't
// collide):
//
//   - `buzz-check`/`buzz-test` fork the *upstream* `buzz` toolchain (--check / --test).
//   - `magus-buzz` forks `magus buzz` - magus's own embedded Buzz engine, always
//     present wherever magus is - so running the fixtures here also exercises that
//     engine (a second layer of dogfooding).
//
// Both interpreters only know the Buzz stdlib: magus's host modules (magus/spell,
// and the host methods magus layers onto os/fs/http/…) are not resolvable by
// either, so these ops cover standalone Buzz sources. The spells and the magusfile
// - which import those host modules - are
// validated instead by magus-utils spells (compiled to bytecode at generate time)
// and by magus itself at load time.

import "magus/spell";

export fun mgs_getName() > str { return "buzz"; }

export fun mgs_getLanguage() > Language {
    return Language{
        name = "buzz",
        extensions = [".buzz"],
        comments = CommentSyntax{
            lineComments = ["//"],
            blockComments = [CommentBlock{open = "/*", close = "*/"}],
            quotes = [
                Quote{open = "`", close = "`", ignoreEscape = true},
                Quote{open = "\"", close = "\""},
            ],
        },
    };
}

export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.buzz"}];
}

// No mgs_getTools entry: there's no useful Buzz-toolchain version to probe here.
// `magus buzz` only reports magus's own version, and the upstream `buzz` toolchain
// isn't reliably on PATH - a missing `buzz` would make every run that touches a
// buzz-bound project warn on a failed probe. The toolchain version isn't mixed into
// the cache key yet anyway.

// check type-checks every Buzz source without running it (buzz --check). buzz
// takes one script per invocation, so `sources` runs it once PER matched file
// (sourcesEach = true - the engine-side replacement for the `find | xargs -n1`
// this op used to shell out to; see Command.sources/sourcesEach in
// spells/op.go). A glob set that matches nothing runs buzz zero times rather
// than failing.
fun buzzCheck(target: Target) > Command {
    return Command{bin = "buzz", args = ["--check"], sources = ["**/*.buzz"], sourcesEach = true};
}

// test runs each source's Buzz `test {}` blocks (buzz --test), one file per
// invocation - see buzzCheck above.
fun buzzTest(target: Target) > Command {
    return Command{bin = "buzz", args = ["--test"], sources = ["**/*.buzz"], sourcesEach = true};
}

// magus-buzz executes each source through `magus buzz`, magus's own embedded Buzz
// engine, one file per invocation (see buzzCheck above). It has no check-only
// mode - executing a file compiles, type-checks, and runs it - so this is the
// runtime sibling of `buzz-check`.
//
// bin is the literal string "$MAGUS", not a shell variable reference: the
// runner resolves a bare $NAME token in Bin/Args against the values it
// controls for this invocation (see resolveRunnerRefs in
// internal/interp/bindings) - the same resolution that exports MAGUS (à la GNU
// Make's $(MAKE)) into every spell subprocess's environment - so this always
// runs the current magus, even uninstalled or under `go run`, with no
// dependence on PATH and no shell needed to expand it. (A bare "$MAGUS", not
// "${MAGUS:-magus}": Buzz reads {...} in a string as interpolation, and this
// string is never interpolated - it is matched literally.)
fun magusBuzz(target: Target) > Command {
    return Command{bin = "$MAGUS", args = ["buzz"], sources = ["**/*.buzz"], sourcesEach = true};
}

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {
        "buzz-check": buzzCheck,
        "buzz-test": buzzTest,
        "magus-buzz": magusBuzz,
    };
}
