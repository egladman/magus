// magus authors its own config and spells in Buzz, so this spell lets the project
// dogfood - `magus run buzz::buzz-check` type-checks Buzz the way `golang::go-vet`
// checks Go.
//
// It supports two interpreters, and a magusfile picks per op (the names don't
// collide):
//
//   - `buzz-check`/`buzz-test` fork the *upstream* `buzz` toolchain (--check / --test).
//   - `magus-buzz` forks `magus buzz` - magus's own embedded Buzz engine, always
//     present wherever magus is - so running the fixtures here also exercises that
//     engine (a second layer of dogfooding).
//
// Both interpreters only know the Buzz stdlib: magus's host modules (magus/spell,
// and the host methods magus layers onto os/fs/http/…) are not resolvable by
// either, so these ops cover standalone Buzz sources. The spells and the magusfile
// - which import those host modules - are
// validated instead by magus-utils spells (compiled to bytecode at generate time)
// and by magus itself at load time.

import "magus/spell";

export fun mgs_getName() > str { return "buzz"; }

export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.buzz"}];
}

// mgs_listIgnoreDirs mirrors the bash spell: vendored trees and stale agent
// worktrees carry .buzz copies that are not this project's sources.
export fun mgs_listIgnoreDirs() > [Path] {
    return [Path{value = "node_modules", isDir = true}, Path{value = ".claude/worktrees", isDir = true}];
}

// No mgs_getVersionCommand: `magus buzz` only reports magus's own version, and the
// upstream `buzz` toolchain isn't reliably on PATH - a failing PRIMARY probe warns
// on every run. The upstream toolchain is a NAMED probe instead: a named probe
// records UNPROBED when the binary is absent (see the go spell's golangci-lint
// note), so workspaces without upstream buzz pay nothing, and where it is
// installed an upgrade moves the cache key for buzz-check/buzz-test verdicts.
export fun mgs_getVersionCommands() > {str: [str]} {
    return {"buzz": ["buzz", "--version"]};
}

// check type-checks every Buzz source without running it (buzz --check). buzz takes
// one script per invocation, so find feeds xargs one file at a time (-n1; -print0
// pairs with -0 for safe paths, and -r skips an empty set - the same -print0 | xargs
// pattern the bash spell uses for shellcheck).
//
// The prunes match mgs_listIgnoreDirs above, for the same reason the bash spell
// prunes its find: a declared ignore dir shapes what magus treats as sources, but
// this op's find is its own walk, and without the prunes a stale .claude/worktrees
// copy fails buzz-check for code the project does not own (the MGS1002 hazard).
fun buzzCheck(target: Target) > Command {
    return Command{bin = "sh", args = ["-c",
        "find . \\( -name node_modules -o -path './.claude/worktrees' \\) -prune -o -name '*.buzz' -print0 | xargs -0 -r -n1 buzz --check"]};
}

// test runs each source's Buzz `test {}` blocks (buzz --test).
fun buzzTest(target: Target) > Command {
    return Command{bin = "sh", args = ["-c",
        "find . \\( -name node_modules -o -path './.claude/worktrees' \\) -prune -o -name '*.buzz' -print0 | xargs -0 -r -n1 buzz --test"]};
}

// magus-buzz executes each source through `magus buzz`, magus's own embedded Buzz
// engine. It has no check-only mode - executing a file compiles, type-checks, and
// runs it - so this is the runtime sibling of `buzz-check`. It invokes "$MAGUS": magus exports
// MAGUS (the running binary's path, à la GNU Make's $(MAKE)) into every spell
// subprocess, so this resolves to the current magus even uninstalled / under
// `go run`, with no dependence on PATH. (A bare $MAGUS, not ${MAGUS:-magus}: Buzz
// reads {...} in a string as interpolation, and MAGUS is always set here anyway.)
fun magusBuzz(target: Target) > Command {
    return Command{bin = "sh", args = ["-c",
        "find . \\( -name node_modules -o -path './.claude/worktrees' \\) -prune -o -name '*.buzz' -print0 | xargs -0 -r -n1 \"$MAGUS\" buzz"]};
}

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {
        "buzz-check": buzzCheck,
        "buzz-test": buzzTest,
        "magus-buzz": magusBuzz,
    };
}
