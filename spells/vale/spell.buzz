// Vale (https://vale.sh) judges prose against the styles a .vale.ini names. The op forks
// `vale` on PATH and returns its JSON report, so a magusfile maps each alert back to the
// text it came from:
//
//   import "spells/vale" as vale
//   final report = vale["vale"](ctx, {"args": [doc]}).stdout
//
// It claims no source globs: Vale here judges documents a target extracts, not the
// working tree, so it is invoked explicitly. Its probed version keys the cache, so
// upgrading Vale reruns only the targets that call it.

import "magus/spell";

export fun mgs_getName() > str { return "vale"; }

// --no-exit: an alert is the report, not a failed run; the caller decides what blocks.
fun vale(target: Target) > Command {
    return Command{bin = "vale", args = ["--output=JSON", "--no-exit"], capture = true,
        needsArgs = "vale: pass the documents to judge after the op's args"};
}

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {"vale": vale};
}

export fun mgs_getTools() > {str: Tool} {
    return {"vale": Tool{probe = Command{bin = "vale", args = ["--version"]}}};
}
