import "magus/spell";
// charm constructors derive argv patches from an anchor arg, not a counted index.
import "magus/charm";
import "encoding/toml";
import "path";

export fun mgs_getName() > str { return "rust"; }

export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "**/*.rs"}, Path{value = "Cargo.toml"}, Path{value = "Cargo.lock"}];
}



// `rustc --version` carries the commit hash and its date (`1.94.1 (e408947bf
// 2026-03-25)`), neither of which distinguishes two installs of the same release.
export fun mgs_getTools() > {str: Tool} {
    return {
        "rustc": Tool{probe = Command{bin = "rustc", args = ["--version"]}, key = VersionKey{upTo = VersionComponent.patch},
                      lifecycle = "rust"},
        // Observed, not probed: only the scip op drives it, so its version keys the index
        // and no other target.
        "rust-analyzer": Tool{observe = Command{bin = "rust-analyzer", args = ["--version"]}},
    };
}

// cargo gets its registry and git checkouts and its installed binaries, never its home:
// $CARGO_HOME/credentials.toml holds the registry token.
export fun mgs_getSandbox() > Sandbox {
    return Sandbox{
        allow = [
            SandboxAllow{env = "RUSTUP_HOME", base = "home", path = ".rustup", mode = SandboxAccess.rx},
            // CARGO_HOME defaults to ~/.cargo; with it unset the $CARGO_HOME entries grant nothing.
            SandboxAllow{base = "$CARGO_HOME", path = "bin", mode = SandboxAccess.rx},
            SandboxAllow{base = "$CARGO_HOME", path = "registry", mode = SandboxAccess.rw},
            SandboxAllow{base = "$CARGO_HOME", path = "git", mode = SandboxAccess.rw},
            SandboxAllow{base = "home", path = ".cargo/bin", mode = SandboxAccess.rx},
            SandboxAllow{base = "home", path = ".cargo/registry", mode = SandboxAccess.rw},
            SandboxAllow{base = "home", path = ".cargo/git", mode = SandboxAccess.rw},
        ],
        env = SandboxEnv{passthrough = ["CARGO_HOME", "RUSTUP_HOME"]},
    };
}

export fun mgs_getLanguage() > Language {
    return Language{
        name = "rust",
        extensions = [".rs"],
        syntax = Syntax{
            comments = CommentSyntax{
                lineComments = ["//"],
                blockComments = [CommentBlock{open = "/*", close = "*/"}],
                nested = true,
                quotes = [
                    Quote{open = "r#\"", close = "\"#", ignoreEscape = true},
                    Quote{open = "r\"", close = "\"", ignoreEscape = true},
                    Quote{open = "\"", close = "\""},
                ],
            },
            stubs = StubSyntax{
                kinds = ["Function", "Method"],
                bodyStyle = "brace",
                body = "\{\n    todo!(\"\{\{&Name}} lands in \{\{&Branch}}\")\n\}",
            },
            operators = ["==", "!=", "<=", ">=", "&&", "||", "=>", "->", "::", "..", "..=", "+=", "-=", "<<=", ">>="],
            decisions = DecisionSyntax{keywords = ["if", "while", "for"], operators = ["&&", "||", "=>"]},
        },
    };
}

// mgs_listIgnoreDirs names non-source dirs cargo generates, pruned from the
// input-hashing walk. Dot-dirs are skipped structurally, so only target belongs here.
export fun mgs_listIgnoreDirs() > [Path] { return [Path{value = "target", isDir = true}]; }

// mgs_listManifests names the file this project's dependencies are declared in -
// not the toolchain's version (that's mgs_getVersionProbe) and not a cache input
// (Cargo.toml and Cargo.lock are separately listed in mgs_listRequiredGlobs above,
// because they also feed the cache key). A cargo crate has exactly one of each.
//
// In a cargo WORKSPACE only the workspace root holds a Cargo.lock; member crates
// have a Cargo.toml and no lock of their own. That is why the lock is declared as a
// bare filename and located by walking up from the project rather than being read
// beside the manifest.
//
// The install fetches into cargo's shared registry cache, so there is no tree to seed
// and no stamp to check, and it always runs. Under update, `cargo update` re-resolves
// and rewrites Cargo.lock.
export fun mgs_listManifests() > [Manifest] {
    final args = ["fetch", "--locked"];
    return [Manifest{value = "Cargo.toml", lockCandidates = ["Cargo.lock"], installs = {"Cargo.lock": Install{
        name = "cargo-fetch",
        command = Command{bin = "cargo", args = args, charms = {
            "update": Charm{ops = set(args, anchor: "fetch", val: "update").ops + drop(args, anchor: "--locked").ops},
        }},
    }}}];
}

fun cargoBuild(target: Target) > Command { return Command{bin = "cargo", args = ["build", "--release"]}; }
fun cargoClean(target: Target) > Command { return Command{bin = "cargo", args = ["clean"]}; }
// clippy and rustfmt ship as rustup COMPONENTS, not with the toolchain, so a fresh
// machine fails with "no such command" - which reads as a broken build rather than a
// one-line install. cargo prints the same shape for a genuine typo, so the advice names
// the component rather than asserting what went wrong.
final RUSTUP_COMPONENT_HINTS = [
    Hint{contains = "no such command",
         advise = "cargo subcommands like clippy and rustfmt are rustup components; install with `rustup component add clippy` (or rustfmt)"},
];
fun cargoClippy(target: Target) > Command { return Command{bin = "cargo", args = ["clippy", "--", "-D", "warnings"], hints = RUSTUP_COMPONENT_HINTS}; }
fun cargoFmt(target: Target) > Command {
    final args = ["fmt", "--", "--check"];
    // rw turns the check into a write by dropping --check then -- (`cargo fmt`).
    // Two ops in one charm: concatenate the drop constructors' op lists. Order
    // matters — drop --check (the higher index) before -- so the patch applies
    // sequentially without an index shifting out from under it.
    return Command{bin = "cargo", args = args, charms = {
        "rw": Charm{ ops = drop(args, anchor: "--check").ops + drop(args, anchor: "--").ops },
    }};
}
fun cargoTest(target: Target) > Command { return Command{bin = "cargo", args = ["test"]}; }
// The project's test target writes it with
// `cargo llvm-cov --lcov --output-path lcov.info`.
export fun mgs_getCoverage() > Coverage {
    return Coverage{format = CoverageFormat.lcov, profile = "lcov.info"};
}

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {"cargo-build": cargoBuild, "cargo-clean": cargoClean, "cargo-clippy": cargoClippy, "cargo-fmt": cargoFmt, "cargo-test": cargoTest};
}

// External, so it runs only where magus.yaml lists rust under spells.symbol_indexers.
// rust-analyzer's scip subcommand writes to MAGUS_SYMBOL_INDEX, never the tree.
export fun mgs_getSymbolIndexer() > SymbolIndexer {
    return SymbolIndexer{
        format = SymbolFormat.scip,
        command = Command{bin = "rust-analyzer", args = ["scip", ".", "--output", "$MAGUS_SYMBOL_INDEX"]},
    };
}

final DEPENDENCY_TABLES = ["dependencies", "dev-dependencies", "build-dependencies", "dev_dependencies", "build_dependencies"];

object Crate {
    dir: str,
    file: str,
    doc: {str: any},
}

object CargoWorkspace {
    dir: str,
    file: str,
    members: [str],
    exclude: [str],
    defaultMembers: [str],
    dependencies: {str: any},
}

fun tableOf(v: any?) > {str: any} {
    return (v as? {str: any}) ?? {<str: any>};
}

fun pathList(v: any?) > [str] {
    final cleaned = mut [<str>];
    foreach (item in (v as? [any]) ?? [<any>]) {
        if (item -> s) {
            if (s is str) {
                cleaned.append(path\clean(s as str));
            }
        }
    }
    return cleaned;
}

fun excluded(ws: CargoWorkspace, dir: str) > bool {
    foreach (ex in ws.exclude) {
        if (path\within(path\join([ws.dir, ex]), path: dir)) {
            return true;
        }
    }
    return false;
}

fun inWorkspace(ws: CargoWorkspace, dir: str) > bool {
    if (!path\within(ws.dir, path: dir) or excluded(ws, dir: dir)) {
        return false;
    }
    if (dir == ws.dir) {
        return true;
    }
    foreach (member in ws.members) {
        if (path\matches(member, path: path\rel(ws.dir, target: dir)) catch false) {
            return true;
        }
    }
    return false;
}

fun claim(dir: str, name: str, dependsOn: [str], spans: [str], gaps: [DiscoveryGap]) > DiscoveredProject {
    return DiscoveredProject{
        path = dir,
        role = DiscoveryRole.project,
        name = name,
        dependsOn = dependsOn,
        spans = spans,
        targets = {"build": ["cargo-build"], "test": ["cargo-test"], "lint": ["cargo-clippy"]},
        notInferred = gaps,
    };
}

// pathDependency resolves one dependency entry to the directory it points at, or a gap
// saying why it does not; a registry or git dependency answers neither.
fun pathDependency(crate: Crate, ws: CargoWorkspace?, table: str, name: str, spec: any, crates: {str: bool}) > obj{ dir: str?, gap: str? } {
    final entry = spec as? {str: any};
    if (entry == null) {
        return .{ dir = null, gap = null };
    }
    var base = crate.dir;
    var target = entry!["path"];
    if ((entry!["workspace"] as? bool) ?? false) {
        if (ws == null) {
            return .{ dir = null, gap = "{table}.{name}: workspace = true, and no workspace includes this crate" };
        }
        if (ws!.dependencies[name] == null) {
            return .{ dir = null, gap = "{table}.{name}: workspace = true, and {ws!.file} declares no workspace.dependencies.{name}" };
        }
        final inherited = ws!.dependencies[name] as? {str: any};
        if (inherited == null) {
            return .{ dir = null, gap = null };
        }
        base = ws!.dir;
        target = inherited!["path"];
    }
    final rel = target as? str;
    if (rel == null) {
        return .{ dir = null, gap = null };
    }
    if (path\isAbs(rel!)) {
        return .{ dir = null, gap = "{table}.{name}: path {rel!} is absolute, so it names no workspace project" };
    }
    final dir = path\join([base, rel!]);
    if (dir == ".." or dir.startsWith("../")) {
        return .{ dir = null, gap = "{table}.{name}: path {rel!} leaves the workspace root" };
    }
    if (!(crates[dir] ?? false)) {
        return .{ dir = null, gap = "{table}.{name}: path {rel!} holds no Cargo.toml with a [package]" };
    }
    return .{ dir = dir, gap = null };
}

fun dependencyTables(doc: {str: any}) > [obj{ label: str, deps: {str: any} }] {
    final tables = mut [<obj{ label: str, deps: {str: any} }>];
    foreach (table in DEPENDENCY_TABLES) {
        if (doc[table] as? {str: any} -> deps) {
            tables.append(.{ label = table, deps = deps });
        }
    }
    foreach (cfg, platform in tableOf(doc["target"])) {
        foreach (table in DEPENDENCY_TABLES) {
            if (tableOf(platform)[table] as? {str: any} -> deps) {
                tables.append(.{ label = "target.{cfg}.{table}", deps = deps });
            }
        }
    }
    return tables;
}

fun crateGaps(crate: Crate, ws: CargoWorkspace?, ancestor: CargoWorkspace?, rsFiles: {str: bool}) > [DiscoveryGap] {
    final gaps = mut [<DiscoveryGap>];
    final pkg = tableOf(crate.doc["package"]);
    final buildScript = path\join([crate.dir, (pkg["build"] as? str) ?? "build.rs"]);
    if (rsFiles[buildScript] ?? false) {
        gaps.append(DiscoveryGap{ file = buildScript, why = "build script: what it reads, runs or generates is not inferred" });
    }
    final features = tableOf(crate.doc["features"]);
    if (features.len() > 0) {
        final names = features.keys().cloneMutable();
        names.sort(fun (left: str, right: str) > bool => left < right);
        gaps.append(DiscoveryGap{ file = crate.file, why = "features {names.join(", ")}: cargo-build, cargo-test and cargo-clippy run the default features only" });
    }
    if (ws == null and ancestor != null and !excluded(ancestor!, dir: crate.dir)) {
        gaps.append(DiscoveryGap{ file = crate.file, why = "under the workspace at {ancestor!.file} but neither in its members nor its exclude, so cargo refuses to build it" });
    }
    return gaps;
}

fun workspaceGaps(ws: CargoWorkspace, crates: {str: bool}, doc: {str: any}) > [DiscoveryGap] {
    final gaps = mut [<DiscoveryGap>];
    foreach (member in ws.members) {
        var matched = false;
        foreach (dir, _ in crates) {
            if (path\within(ws.dir, path: dir) and (path\matches(member, path: path\rel(ws.dir, target: dir)) catch false)) {
                matched = true;
            }
        }
        if (!matched) {
            gaps.append(DiscoveryGap{ file = ws.file, why = "workspace.members {member}: matches no Cargo.toml with a [package]" });
        }
    }
    foreach (registry, overrides in tableOf(doc["patch"])) {
        foreach (name, spec in tableOf(overrides)) {
            if (tableOf(spec)["path"] != null) {
                gaps.append(DiscoveryGap{ file = ws.file, why = "patch.{registry}.{name}: a path override is not wired as a dependency of the crates that use it" });
            }
        }
    }
    if (doc["replace"] != null) {
        gaps.append(DiscoveryGap{ file = ws.file, why = "[replace]: overrides are not wired as dependencies" });
    }
    return gaps;
}

fun parseManifest(file: DiscoveryFile) > obj{ doc: {str: any}?, gap: str? } {
    if (file.content == null) {
        return .{ doc = null, gap = "Cargo.toml: core passed no content, so the manifest was not read" };
    }
    try {
        final parsed = toml\parse(file.content!);
        if (parsed as? {str: any} -> doc) {
            return .{ doc = doc, gap = null };
        }
        return .{ doc = null, gap = "Cargo.toml: not a TOML table" };
    } catch (err: any) {
        final message = (tableOf(err)["message"] as? str) ?? "{err}";
        return .{ doc = null, gap = "Cargo.toml: {message}" };
    }
    return .{ doc = null, gap = null };
}

// CargoScan is what discover_projects read of the query: every .rs file, each [package]
// dir, the manifests that parsed and the claims for those that did not.
object CargoScan {
    rsFiles: mut {str: bool},
    crates: mut {str: bool},
    parsed: mut [Crate],
    claims: mut [DiscoveredProject],
}

// cargoScan parses each Cargo.toml and keeps every other file as a .rs source.
fun cargoScan(req: DiscoveryQuery) > CargoScan {
    final scan = CargoScan{rsFiles = mut {}, crates = mut {}, parsed = mut [], claims = mut []};
    foreach (file in req.files) {
        if (file.path != "Cargo.toml" and !file.path.endsWith("/Cargo.toml")) {
            scan.rsFiles[file.path] = true;
            continue;
        }
        final dir = path\dir(file.path);
        final manifest = parseManifest(file);
        if (manifest.doc -> doc) {
            scan.parsed.append(Crate{ dir = dir, file = file.path, doc = doc });
            if (doc["package"] as? {str: any} != null) {
                scan.crates[dir] = true;
            }
        } else {
            scan.claims.append(DiscoveredProject{path = dir, role = DiscoveryRole.project,
                notInferred = [DiscoveryGap{ file = file.path, why = manifest.gap! }]});
        }
    }
    return scan;
}

// cargoWorkspaces is every parsed manifest's [workspace] table.
fun cargoWorkspaces(parsed: [Crate]) > [CargoWorkspace] {
    final workspaces = mut [<CargoWorkspace>];
    foreach (crate in parsed) {
        if (crate.doc["workspace"] as? {str: any} -> table) {
            workspaces.append(CargoWorkspace{dir = crate.dir, file = crate.file, members = pathList(table["members"]),
                exclude = pathList(table["exclude"]), defaultMembers = pathList(table["default-members"]),
                dependencies = tableOf(table["dependencies"])});
        }
    }
    return workspaces;
}

// CrateWorkspace is the workspace a crate belongs to, and the nearest one above it.
object CrateWorkspace {
    own: CargoWorkspace? = null,
    ancestor: CargoWorkspace? = null,
}

// crateWorkspace finds crate's workspace: the one its package names, else the nearest one
// above it that includes it.
fun crateWorkspace(crate: Crate, pkg: {str: any}?, workspaces: [CargoWorkspace]) > CrateWorkspace {
    var own: CargoWorkspace? = null;
    var ancestor: CargoWorkspace? = null;
    final explicit = tableOf(pkg)["workspace"] as? str;
    foreach (ws in workspaces) {
        if (explicit -> rel) {
            if (ws.dir == path\join([crate.dir, rel])) {
                own = ws;
            }
        } else if (path\within(ws.dir, path: crate.dir) and (ancestor == null or ws.dir.len() > ancestor!.dir.len())) {
            ancestor = ws;
        }
    }
    if (explicit == null and ancestor != null and inWorkspace(ancestor!, dir: crate.dir)) {
        own = ancestor;
    }
    return CrateWorkspace{own = own, ancestor = ancestor};
}

// virtualClaim claims a manifest with no [package]: a virtual workspace depends on its member
// crates and runs no target, and one that is no workspace either is a gap.
fun virtualClaim(crate: Crate, own: CargoWorkspace?, crates: {str: bool}, gaps: mut [DiscoveryGap]) > DiscoveredProject {
    if (own -> ws) {
        gaps.append(DiscoveryGap{ file = crate.file, why = "virtual workspace manifest: its members are projects with their own targets, so none runs cargo across the workspace here" });
        final members = mut [<str>];
        foreach (dir, _ in crates) {
            if (dir != crate.dir and inWorkspace(ws, dir: dir)) {
                members.append(dir);
            }
        }
        _ = members.sort(fun (left: str, right: str) > bool => left < right);
        return DiscoveredProject{path = crate.dir, role = DiscoveryRole.project, dependsOn = members, notInferred = gaps};
    }
    return DiscoveredProject{path = crate.dir, role = DiscoveryRole.project,
        notInferred = [DiscoveryGap{ file = crate.file, why = "neither [package] nor [workspace]: not a cargo manifest" }]};
}

// crateDeps is every crate dir crate's path dependencies resolve to, with a gap for each that
// does not.
fun crateDeps(crate: Crate, own: CargoWorkspace?, crates: {str: bool}, gaps: mut [DiscoveryGap]) > [str] {
    final deps = mut [<str>];
    foreach (table in dependencyTables(crate.doc)) {
        foreach (name, spec in table.deps) {
            final resolved = pathDependency(crate, ws: own, table: table.label, name: name, spec: spec, crates: crates);
            if (resolved.gap -> why) {
                gaps.append(DiscoveryGap{ file = crate.file, why = why });
            }
            if (resolved.dir -> dir) {
                if (dir != crate.dir and deps.indexOf(dir) == null) {
                    deps.append(dir);
                }
            }
        }
    }
    _ = deps.sort(fun (left: str, right: str) > bool => left < right);
    return deps;
}

// crateClaim claims one parsed manifest.
fun crateClaim(crate: Crate, scan: CargoScan, workspaces: [CargoWorkspace]) > DiscoveredProject {
    final pkg = crate.doc["package"] as? {str: any};
    final at = crateWorkspace(crate, pkg: pkg, workspaces: workspaces);
    final gaps = mut [<DiscoveryGap>];
    final spans = mut [<str>];
    if (at.own -> ws) {
        if (ws.dir == crate.dir) {
            foreach (gap in workspaceGaps(ws, crates: scan.crates, doc: crate.doc)) {
                gaps.append(gap);
            }
            foreach (member in ws.defaultMembers) {
                final dir = path\join([ws.dir, member]);
                if (dir != crate.dir and spans.indexOf(dir) == null) {
                    spans.append(dir);
                }
            }
        }
    }
    if (pkg == null) {
        return virtualClaim(crate, own: at.own, crates: scan.crates, gaps: gaps);
    }
    foreach (gap in crateGaps(crate, ws: at.own, ancestor: at.ancestor, rsFiles: scan.rsFiles)) {
        gaps.append(gap);
    }
    final deps = crateDeps(crate, own: at.own, crates: scan.crates, gaps: gaps);
    _ = spans.sort(fun (left: str, right: str) > bool => left < right);
    return claim(crate.dir, name: (pkg!["name"] as? str) ?? "", dependsOn: deps, spans: spans, gaps: gaps);
}

// discover_projects claims every Cargo.toml with a [package] as a project, with
// cargo-build, cargo-test and cargo-clippy as its build, test and lint, depending on the
// crates its path dependencies (and inherited workspace path dependencies) point at. A
// virtual workspace manifest is claimed with no targets: running cargo across its
// members there would repeat each member's own targets.
export fun discover_projects(target: Target, req: DiscoveryQuery) > [DiscoveredProject] {
    final scan = cargoScan(req);
    final workspaces = cargoWorkspaces(scan.parsed);
    foreach (crate in scan.parsed) {
        scan.claims.append(crateClaim(crate, scan: scan, workspaces: workspaces));
    }
    _ = scan.claims.sort(fun (left: DiscoveredProject, right: DiscoveredProject) > bool => left.path < right.path);
    return scan.claims;
}
