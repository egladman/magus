// GitHub integration spell for magus. Provides a remote cache backend over the
// GitHub Actions Cache, written as an ordinary magus spell. Wire it in a magusfile:
//
//   import "spells/github/actions" as github
//   magus\cache.remote(github)
//
// It carries two more contracts further down, each wired the same way and each inert
// outside Actions: a CI provider (magus\ci.provider) and a secret provider
// (magus\secret.provider). One spell per vendor, three contracts.
//
// magus knows nothing about GitHub Actions: it speaks only the generic spell
// contract. It exports the cache contract, functions typed fun(Target, fun(any))
// bool that the remote-cache subsystem detects by name and invokes with the
// work-unit Target and an input callback cb, reading the boolean result of:
//
//   enabled(target, cb)   -> bool   active here? (gates fetch/push; ignores cb)
//   get_artifact(target, cb) -> bool   download artifact into dest; true=hit
//   put_artifact(target, cb) -> bool   upload artifact at src;     true=stored
//
// A contract function reads its inputs by calling cb(io) with an empty map: the
// host writes the cache inputs ({project, hash, dest/src}) into io, which the
// function then reads. The input shape varies per function (and one may skip cb
// entirely), so io is typed `any`. Command ops do not use cb - they return a
// Command; cb survives only here, where the work happens in-VM.
//
// This targets the GitHub Actions Cache service **v2** — the Twirp API at
// ACTIONS_RESULTS_URL that replaced the v1 _apis/artifactcache REST service GitHub
// retired in early 2025. The flow is: CreateCacheEntry returns a pre-signed Azure
// blob URL, the artifact is PUT there directly, then FinalizeCacheEntryUpload
// commits it; reads call GetCacheEntryDownloadURL and GET the returned blob URL.
// It is implemented in Buzz using the magus host http module (http.post for the
// JSON-over-Twirp RPCs plus the byte-level http.download/upload_chunked/byteSize
// primitives), os.env for the runner environment, and serialize for JSON — so
// everything GitHub-specific stays out of the Go tree.
//
// Auth and endpoint come from the runner environment:
//   GITHUB_ACTIONS         — "true" only under GitHub Actions (gates the backend)
//   ACTIONS_RESULTS_URL    — cache service base URL (always ends in "/")
//   ACTIONS_RUNTIME_TOKEN  — bearer token

import "encoding"
import "http"
import "magus/spell"
import "serialize"
import "os"
import "std"

// "GitHub Actions" is the product's canonical name; the bare leaf "actions" named
// nothing on its own, and a spell's registered name has to stand alone - it is
// what `magus describe spells` and every diagnostic show, with no directory
// around it to supply the vendor. See CONTRIBUTING.md#naming.
export fun mgs_getName() > str { return "github-actions"; }

// A cache backend exports the well-known cache-contract functions below (enabled
// / get_artifact / put_artifact), which the remote-cache subsystem detects by name
// and invokes via magus\cache.remote(github). It declares no mgs_listTargets - a
// cache backend contributes no operations a target could compose.

// enabled gates the whole backend on running under GitHub Actions. The cache
// probes this once and skips fetch/push entirely when false, so wiring this spell
// in a magusfile is a no-op everywhere except GHA — no remote calls, no exports.
export fun enabled(target: Target, cb: fun(any)) > bool {
    return getenv("GITHUB_ACTIONS") == "true";
}

// getenv reads one environment variable, returning "" when unset (os.env returns
// null for an unset var; the callers below test against "").
// NOTE: byte-identical to the getenv in spells/aws/s3-cache/spell.buzz. The
// duplication is intentional/temporary: there is no shared magus/... buzz helper
// module for it yet (extracting one needs the embed+register plumbing magus/charm
// uses). Track for follow-up; keep the two copies in sync.
fun getenv(name: str) > str {
    final v = os\env(name);
    if (v == null) { return ""; }
    return "" + v;
}

// Version salt mixed into every entry's `version` field; bump to invalidate all
// artifacts at once. Independent of the cache *service* version (v2).
final CACHE_VERSION = "magus-remote-v1";
// Twirp service path; methods hang off this under ACTIONS_RESULTS_URL.
final SERVICE = "twirp/github.actions.results.api.v1.CacheService/";

fun base() > str { return getenv("ACTIONS_RESULTS_URL"); }
fun token() > str { return getenv("ACTIONS_RUNTIME_TOKEN"); }

// cache_key derives the cache key from the spec hash. The hash already folds in
// the project path (see cache/hash.go), so it is unique per project and needs no
// extra namespacing — and being hex, it is URL-safe.
// NOTE: cache-key format differs from spells/aws/s3-cache/spell.buzz on purpose:
// GHA keeps CACHE_VERSION in a separate `version` request field, while S3 folds it
// into the key string. Do NOT change the emitted string here — it would invalidate
// every existing GHA cache entry. Track the inconsistency for follow-up only.
fun cache_key(hash: str) > str { return "magus-" + hash; }

// rpc POSTs a JSON Twirp request to the named CacheService method and returns the
// host http response map ({status, body}).
fun rpc(method: str, payload: any) > any {
    final url = base() + SERVICE + method;
    final headers = mut {
        "Authorization": "Bearer " + token(),
        "Content-Type": "application/json",
        "Accept": "application/json",
    };
    return http\post(url, serialize\jsonEncode(payload), headers);
}

// get_artifact downloads the cache artifact for payload.hash into payload.dest. Returns
// true on a hit (dest written), false on a miss or when not running under Actions.
export fun get_artifact(target: Target, cb: fun(any)) > bool {
    if (base() == "" or token() == "") { return false; }
    var io = {};
    cb(io);
    final hash = "" + io["hash"];
    final dest = "" + io["dest"];
    final res = rpc("GetCacheEntryDownloadURL", {"key": cache_key(hash), "version": CACHE_VERSION});
    if (res["status"] != 200) { return false; }
    final decoded = serialize\jsonDecode(res["body"]);
    if (!decoded.q("ok").booleanValue()) { return false; }   // ok=false ⇒ miss
    final loc = decoded.q("signedDownloadUrl").stringValue();
    if (loc == "") { return false; }
    // The download URL is a pre-signed Azure blob URL; it needs no auth header.
    return http\download(loc, dest, {}) == 200;
}

// put_artifact uploads the artifact at payload.src for payload.hash. Returns true on
// success or when another runner already stored the same key, else false.
export fun put_artifact(target: Target, cb: fun(any)) > bool {
    if (base() == "" or token() == "") { return false; }
    var io = {};
    cb(io);
    final hash = "" + io["hash"];
    final src = "" + io["src"];
    final key = cache_key(hash);

    // 1. Reserve the entry → pre-signed Azure upload URL.
    final cres = rpc("CreateCacheEntry", {"key": key, "version": CACHE_VERSION});
    if (cres["status"] == 409) { return true; }   // another runner already reserved this key
    if (cres["status"] != 200) { return false; }
    final upload = serialize\jsonDecode(cres["body"]).q("signedUploadUrl").stringValue();
    if (upload == "") { return true; }             // ok=false with no URL ⇒ entry already exists

    // 2. Upload the artifact to Azure as a single Put Blob (chunk_size 0 = whole
    //    file, no Content-Range). Azure returns 201 Created on success.
    final ures = http\upload_chunked("PUT", upload, src, 0, mut {"x-ms-blob-type": "BlockBlob"});
    final ucode = ures[0];
    if (ucode != 201 and ucode != 200) { return false; }

    // 3. Commit with the exact byte size. int64 fields are JSON strings in proto3,
    //    so send sizeBytes as a string.
    final fres = rpc("FinalizeCacheEntryUpload",
        {"key": key, "sizeBytes": "" + http\byteSize(src), "version": CACHE_VERSION});
    if (fres["status"] != 200) { return false; }
    return serialize\jsonDecode(fres["body"]).q("ok").booleanValue();
}

// --- CI provider contract ----------------------------------------------------
//
// Wired with magus\ci.provider(github), alongside magus\cache.remote(github):
// one spell per vendor, two contracts. Both gate on the same enabled() above,
// so outside Actions this whole half is inert.
//
// magus core knows none of this syntax. It calls generic verbs (see
// internal/ci/annotate) and every "::" below lives here, in Buzz.

// escapeData encodes the characters Actions treats as structural in a command's
// message. A raw newline would end the command early and spill the rest into the
// log as loose text, and a failure's cause is usually the part after line one.
// Percent goes first, or it would corrupt the escapes introduced after it.
fun escapeData(s: str) > str {
    var acc = s.replace("%", "%25");
    acc = acc.replace("\r", "%0D");
    return acc.replace("\n", "%0A");
}

// escapeProp additionally encodes the separators between properties, so a title
// containing a comma or colon cannot be read as the start of another property.
fun escapeProp(s: str) > str {
    var acc = escapeData(s);
    acc = acc.replace(":", "%3A");
    return acc.replace(",", "%2C");
}

// group_start opens a fold. Actions has no expanded section: ::group:: always
// starts collapsed. A caller asking for an expanded one wants output the reader
// must not have to click for, so the group is skipped and the content stays
// inline. Folding it anyway would be worse - a hidden failure is one nobody sees.
export fun group_start(target: Target, cb: fun(any)) > bool {
    final io = {<str, any>};
    cb(io);
    final collapsed = io["collapsed"];
    if (collapsed != true) { return true; }
    std\print("::group::" + escapeData("" + io["title"]));
    return true;
}

// group_end closes the current fold. Actions tracks a single open group, so the
// id is unused; it is in the contract for providers keyed by section name.
export fun group_end(target: Target, cb: fun(any)) > bool {
    std\print("::endgroup::");
    return true;
}

// annotate raises a message that surfaces on the pull request, not just the log.
// Actions has no dedicated code field, so a diagnostic code leads the title where
// it stays greppable in the annotations list.
export fun annotate(target: Target, cb: fun(any)) > bool {
    final io = {<str, any>};
    cb(io);

    var title = "" + io["title"];
    final code = "" + io["code"];
    if (code != "") {
        if (title == "") { title = code; } else { title = code + " " + title; }
    }

    var props = "";
    fun addProp(k: str, v: str) > void {
        if (v == "") { return; }
        if (props != "") { props = props + ","; }
        props = props + k + "=" + escapeProp(v);
    }
    fun addNum(k: str, v: any) > void {
        if (v == null) { return; }
        final n = "" + v;
        if (n == "0" or n == "") { return; }
        if (props != "") { props = props + ","; }
        props = props + k + "=" + n;
    }

    addProp("file", "" + io["file"]);
    addNum("line", io["line"]);
    addNum("endLine", io["end_line"]);
    addNum("col", io["col"]);
    addNum("endColumn", io["end_col"]);
    addProp("title", title);

    var line = "::" + ("" + io["level"]);
    if (props != "") { line = line + " " + props; }
    std\print(line + "::" + escapeData("" + io["message"]));
    return true;
}

// quote_prefixes declares the line prefixes that introduce a workflow command.
// magus captures subprocess output and replays it, so a dependency printing
// "::error::" would otherwise have the runner execute it and forge annotations.
// Returned once per run; magus does the per-line matching itself.
export fun quote_prefixes(target: Target, cb: fun(any)) > [str] {
    return ["::"];
}

// --- Secret provider contract ------------------------------------------------
//
// Wired with magus\secret.provider(github): the third contract this one spell
// carries, alongside the cache backend and the CI provider. magus calls one op,
// resolve_secret, and passes the reference through without parsing it - the
// reference format is this file's business. See docs/concepts/secrets.md.
//
// Worth saying why this is not the built-in environment provider wearing a
// spell's clothes. An Actions secret is WRITE-ONLY: nothing running inside a job
// can fetch one, and interpolating it into a step's env: block is the only path
// there has ever been. So this provider does the two things the platform-neutral
// built-in structurally cannot:
//
//   oidc:<audience>   MINTS a short-lived token from the runner's own endpoint.
//                     It is the one credential on a runner that is genuinely
//                     fetched rather than injected, which is what lets a
//                     repository hold no long-lived cloud key at all.
//   <NAME>            reads the injected variable, registers the value with the
//                     RUNNER so every later step's log is masked too - not only
//                     the output magus captures - and on a miss says which line
//                     to add to the workflow rather than that a variable is unset.
//
// Selecting it is an environment decision, the same one docs/concepts/secrets.md
// draws for every provider - there is no fallback chain, so a workspace picks
// this under Actions and something else on a laptop:
//
//   if (os\env("GITHUB_ACTIONS") == "true") { magus\secret.provider(github); }

final OIDC_PREFIX = "oidc:";

// resolve_secret is the secret-provider contract, detected by name and invoked by
// magus\secret.read(). It receives the reference as payload.ref.
export fun resolve_secret(target: Target, cb: fun(any)) > str {
    final io = {<str, any>};
    cb(io);
    final ref = "" + io["ref"];
    if (ref == "") {
        throw "github-actions: no reference given";
    }

    var value = "";
    if (ref.startsWith(OIDC_PREFIX)) {
        value = oidcToken(ref.sub(OIDC_PREFIX.len()));
    } else {
        value = workflowEnv(ref);
    }
    maskInRunnerLog(value);
    return value;
}

// maskInRunnerLog asks the RUNNER to redact value from its own log. magus already
// redacts the output it captures; this covers the half magus cannot reach - a later
// step, or an action that never ran under magus at all. It is not pure belt and
// braces: the runner auto-masks anything interpolated from `secrets.*`, but NOT a
// step output injected into env:, and not a token minted mid-job like the OIDC one
// below.
//
// std\print rather than anything magus captures, for the same reason group_start
// above uses it: a workflow command is only a command if the runner reads it.
//
// THE GATE IS SPOOFABLE, AND THAT IS SAFE ONLY BECAUSE OF AN INVARIANT. This
// command has to carry the secret in the clear - that is the only way the runner
// can learn which bytes to mask - and GITHUB_ACTIONS is an ordinary environment
// variable anyone can set, so `GITHUB_ACTIONS=true magus run ...` on a laptop makes
// magus print a credential to a terminal. It escalates nothing TODAY because every
// value that reaches here was derived from the very environment the gate reads:
// workflowEnv returns a variable the caller already had, and oidcToken returns what
// an endpoint named by that same environment answered. Whoever can spoof the gate
// could only ever be shown what they themselves supplied.
//
// So the rule a future branch must keep: a value sourced from anywhere OTHER than
// this process's environment - a file, a keychain, a second backend - must not reach
// this function, because for that value the invariant is false and the gate is all
// that stands between it and a terminal.
fun maskInRunnerLog(value: str) > void {
    if (value == "") { return; }
    if (getenv("GITHUB_ACTIONS") != "true") { return; }
    std\print("::add-mask::" + escapeData(value));
}

// workflowEnv reads a secret the workflow injected. There is no other way in, so a
// miss is a workflow-file edit rather than anything this run could recover from -
// which is why the error is the snippet to paste rather than a status.
fun workflowEnv(name: str) > str {
    final value = getenv(name);
    if (value != "") { return value; }
    if (getenv("GITHUB_ACTIONS") != "true") {
        throw "github-actions: $" + name + " is not set, and GITHUB_ACTIONS is not "
            + "\"true\", so this is not an Actions runner. This provider resolves the "
            + "environment a workflow injects; select it only under Actions, and select "
            + "a backend a workstation can reach for local runs.";
    }
    throw "github-actions: $" + name + " is not set in this step's environment.\n"
        + "  An Actions secret is only readable through the workflow file - nothing\n"
        + "  running inside the job can fetch one. Add it to the step:\n"
        + "      env:\n"
        + "        " + name + ": $\{\{ secrets." + name + " \}\}";
}

// oidcToken mints an OIDC token for audience from the runner's token endpoint.
// Actions publishes the endpoint and its request token into the environment only
// when the job declares `permissions: id-token: write`, so an unset variable means
// a missing permission far more often than a broken runner - and the message says
// that rather than naming the variable.
//
// The audience identifies the relying party: "sts.amazonaws.com" for AWS, the
// workload-identity-pool provider URL for GCP, whatever the trust policy on the
// other end was written against.
fun oidcToken(audience: str) > str {
    if (audience == "") {
        throw "github-actions: an oidc: reference needs an audience, as in "
            + "magus\\secret.read(\"oidc:sts.amazonaws.com\")";
    }
    final endpoint = getenv("ACTIONS_ID_TOKEN_REQUEST_URL");
    final request_token = getenv("ACTIONS_ID_TOKEN_REQUEST_TOKEN");
    if (endpoint == "" or request_token == "") {
        throw "github-actions: this job has no OIDC token endpoint.\n"
            + "  Grant it permission to mint one:\n"
            + "      permissions:\n"
            + "        id-token: write\n"
            + "  The permission is off by default, and a job without it is given no endpoint.";
    }
    // The endpoint is read from the environment and the request token is sent to it as
    // a bearer credential, so whoever names the endpoint receives that token. An earlier
    // step in the same job can rewrite a job's environment by appending to $GITHUB_ENV,
    // which makes "wherever the environment points" an exfiltration target rather than a
    // given. Requiring TLS is the part that can be checked without guessing a hostname:
    // GitHub's own endpoint host is not stable, and GitHub Enterprise Server serves a
    // different one entirely, so pinning a domain would break real installations while
    // this rejects the plaintext case outright.
    if (!endpoint.startsWith("https://")) {
        throw "github-actions: refusing to send the OIDC request token to a non-HTTPS "
            + "endpoint. ACTIONS_ID_TOKEN_REQUEST_URL is not an https:// URL, which the "
            + "runner never produces - something in this job rewrote it.";
    }

    final res = http\get(tokenURL(endpoint, audience),
        mut {"Authorization": "Bearer " + request_token, "Accept": "application/json"});
    if (res["status"] != 200) {
        // The status, deliberately without the body. Every other failure path in this
        // file trims the backend's own stderr into the message, but this response body
        // is the one that can CONTAIN a token, and an error string is the least
        // redacted thing magus handles - it has not been resolved yet, so nothing is
        // registered for redaction at the moment it is thrown.
        throw "github-actions: the OIDC token endpoint answered " + ("" + res["status"])
            + " for audience " + audience;
    }
    final value = serialize\jsonDecode(res["body"]).q("value").stringValue();
    if (value == "") {
        throw "github-actions: the OIDC token endpoint returned no token for audience "
            + audience;
    }
    return value;
}

// tokenURL puts the audience on the runner's token endpoint. The separator is chosen
// rather than assumed: the endpoint arrives carrying ?api-version=2.0, so a
// hard-coded "?" would build a second query string and earn a 400 that names nothing.
fun tokenURL(endpoint: str, audience: str) > str {
    var sep = "&";
    if (endpoint.indexOf("?") == null) { sep = "?"; }
    return endpoint + sep + "audience=" + encoding\urlEncode(audience);
}

import "assert";

test "tokenURL appends the audience to whatever query the endpoint already carries" {
    assert\equal(tokenURL("https://run.example.com/token?api-version=2.0", "sts.amazonaws.com"),
        "https://run.example.com/token?api-version=2.0&audience=sts.amazonaws.com",
        "an endpoint with a query string gets &");
    assert\equal(tokenURL("https://run.example.com/token", "sts.amazonaws.com"),
        "https://run.example.com/token?audience=sts.amazonaws.com",
        "a bare endpoint gets ?");
    assert\equal(tokenURL("https://run.example.com/token?api-version=2.0", "https://github.com/egladman"),
        "https://run.example.com/token?api-version=2.0&audience=https%3A%2F%2Fgithub.com%2Fegladman",
        "an audience that is itself a URL is percent-encoded");
}

test "escapeProp encodes every separator, not just the first" {
    // Repetition on purpose. A one-of-each fixture passed for as long as str.replace
    // substituted only the first match, which is how the escapers in this repo shipped
    // broken; see libs/gopherbuzz/testdata/66_str_replace_all.buzz.
    assert\equal(escapeProp("a:b:c"), "a%3Ab%3Ac", "every colon");
    assert\equal(escapeProp("a,b,c"), "a%2Cb%2Cc", "every comma");
    // escapeProp layers on escapeData, so a value carrying both a separator and a
    // newline must come back with all of them encoded and nothing raw.
    assert\equal(escapeProp("x:1\ny,2"), "x%3A1%0Ay%2C2", "separators and newlines together");
}

test "escapeData keeps a multi-line secret inside one add-mask command" {
    // A raw newline would end the command at the first line, so the runner would mask
    // one line of a multi-line key and print the rest.
    assert\equal(escapeData("-----BEGIN KEY-----\nabc\n"), "-----BEGIN KEY-----%0Aabc%0A",
        "every newline is encoded");
}
