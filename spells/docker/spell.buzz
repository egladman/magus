import "magus/spell";

export fun mgs_getName() > str { return "docker"; }

export fun mgs_listRequiredGlobs() > [Path] {
    return [Path{value = "Dockerfile"}, Path{value = ".dockerignore"}, Path{value = "**/*"}];
}





fun dockerBuild(target: Target) > Command { return Command{bin = "docker", args = ["build"]}; }
fun dockerBuildx(target: Target) > Command { return Command{bin = "docker", args = ["buildx", "build"]}; }
fun dockerBuildCheck(target: Target) > Command { return Command{bin = "docker", args = ["build", "--check"]}; }
// Lints the Dockerfile with -f gnu, so magus reads each finding's file, line and rule
// instead of prose. Declared here rather than on mgs_getTools' hadolint entry: only
// the invocation knows the format, since a wrapped tool can run other binaries under
// the same bin that report differently.
fun hadolint(target: Target) > Command { return Command{bin = "hadolint", args = ["-f", "gnu", "Dockerfile"], diagnostics = DiagnosticFormat.gnu}; }
// --rm is baked in: an op that leaves containers behind turns a repeated target into a
// disk leak. The caller supplies mounts, workdir, image and command through args.
fun dockerRun(target: Target) > Command { return Command{bin = "docker", args = ["run", "--rm"]}; }

export fun mgs_listTargets() > {str: fun(Target) Command} {
    return {"docker-build": dockerBuild, "docker-buildx": dockerBuildx, "docker-build-check": dockerBuildCheck, "docker-run": dockerRun, "hadolint": hadolint};
}

// `docker --version` ends in a build hash (`29.3.1, build c2be9cc`) that moves with a
// rebuild of the same release, so patch extraction sheds it. And it is CLIENT-only - it
// exits 0 with no daemon - so `docker info` is what answers whether it is usable.
//
// hadolint gets no readiness probe: linting a Dockerfile talks to no daemon, and gating
// it here would make a lint wait on a service it never uses.
export fun mgs_getTools() > {str: Tool} {
    return {
        "docker": Tool{
            probe = Command{bin = "docker", args = ["--version"]},
            key = VersionKey{upTo = VersionComponent.patch},
            ready = Command{bin = "docker", args = ["info"]},
        },
        "hadolint": Tool{
            probe = Command{bin = "hadolint", args = ["--version"]},
        },
    };
}
