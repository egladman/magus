{
  // Shared Markdown formatting, extended by each project's dprint.json. Settings chosen
  // to minimize churn on an existing hand-written tree, not to express a preference:
  // maintain the hand wrapping, and keep the underscores the tree already favors
  // 110 files to 45.
  "markdown": {
    "textWrap": "maintain",
    "emphasisKind": "underscores",
    "strongKind": "asterisks"
  },
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.1.wasm"
  ]
}
