// Comment extraction for the prose check. Vale never reads a source file: the comment
// scanner the spells declare (internal/risk) writes one Markdown document of comment
// blocks and a table mapping each document line back to its file and line.
namespace prosecomments;

import "std";
import "fs";
import "os";
import "proc";
import "vcs";
import "magus";
import "magus/lint";
import "encoding/json";
import "hack/prose/vale" as prosevale;

// SKIPPED are trees whose comments are not this repository's prose: upstream and
// fixture corpora a test reads as data.
final SKIPPED = ["hack/testdata-upstream/", "testdata/", "/testdata/"];

// READS are the sources the comment check judges, for a target's readsFiles: every
// extension a spell declares comment syntax for, in each project holding one.
export final READS = ["**/*.go", "**/*.buzz", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs",
    "**/*.proto", "console/**/*.ts", "docs/**/*.ts", "docs/**/*.mjs", "libs/**/*.go",
    "libs/**/*.buzz", "proto/**/*.proto", ".vale.ini", ".vale/styles/**/*.yml",
    "internal/risk/*.go", "hack/prose/*.buzz"];

// syntax maps each extension a spell claims to the comment syntax it declares.
export fun syntax() > {str: any} !> any {
    final found = mut {<str: any>};
    foreach (s in magus\describe.spell()) {
        if (s.syntax?.comments == null) {
            continue;
        }
        foreach (ext in s.extensions) {
            if (found[ext] == null) {
                found[ext] = s.syntax?.comments;
            }
        }
    }
    return found;
}

// skipped reports whether p sits in a tree SKIPPED names.
export fun skipped(p: str) > bool {
    foreach (prefix in SKIPPED) {
        if (p.startsWith(prefix) or (prefix.startsWith("/") and p.indexOf(prefix) != null)) {
            return true;
        }
    }
    return false;
}

// sources are the tracked files a spell's comment syntax reads, less generated output
// (`magus describe file` role output) and SKIPPED trees.
export fun sources(exts: {str: any}) > [str] !> any {
    final listed = vcs\cmd(["ls-files"], opts: {"quiet": true}).stdout.split("\n");
    final candidates = mut [<str>];
    foreach (p in listed) {
        if (p != "" and exts[fs\ext(p)] != null and !skipped(p)) {
            candidates.append(p);
        }
    }
    final kept = mut [<str>];
    if (candidates.len() == 0) {
        return kept;
    }
    foreach (f in magus\describe.file(candidates).files) {
        if (f.role != "output") {
            kept.append(f.path);
        }
    }
    return kept;
}

// extract writes <prefix>.comments and <prefix>.json for paths through internal/risk's
// TestProseExport, the one entry to the Go scanner a Buzz script can reach.
export fun extract(paths: [str], exts: {str: any}, prefix: str) > [prosevale\SourceLine] !> any {
    final root = vcs\root();
    // go test runs in the package directory, so both paths it reads are absolute.
    final abs = if (prefix.startsWith("/")) prefix else root + "/" + prefix;
    final request = abs + ".request.json";
    fs\writeFile(request, content: json\stringify({"root": root, "syntax": exts, "paths": paths}));
    final env = {"MAGUS_PROSE_REQUEST": request, "MAGUS_PROSE_OUT": abs, "GOEXPERIMENT": "jsonv2"};
    os\withEnv(env, callback: fun () > void !> any {
        final res = proc\exec("go", args: ["test", "-count=1", "-run", "^TestProseExport$", "./internal/risk/"],
            dir: root, opts: {"quiet": true, "allow_failure": true});
        if (!res.ok) {
            throw "prose: extracting comments failed:\n{res.stdout}{res.stderr}";
        }
    });
    fs\rename(abs + ".md", dst: abs + ".comments");
    return origins(fs\readFile(abs + ".json"));
}

// origins decodes the position table extract writes.
export fun origins(table: str) > [prosevale\SourceLine] !> any {
    final rows: [any] = json\parse(table)["origins"] ?? [<any>];
    final found = mut [<prosevale\SourceLine>];
    foreach (r in rows) {
        found.append(prosevale\SourceLine{ path = r["path"] ?? "", line = std\toInt(r["line"] ?? 0),
            col = std\toInt(r["col"] ?? 0) });
    }
    return found;
}

// Judged is a check's result: the findings that fail it and the advice that does not.
export object Judged {
    blocking: [Finding] = [<Finding>],
    advice: [Finding] = [<Finding>],
}

// check judges every comment in the tree, writing its document under dir. vale is
// prosevale\run, or a magusfile's call of the vale spell's op.
export fun check(dir: str, vale: fun (paths: [str]) > str !> any) > Judged !> any {
    final exts = syntax();
    fs\mkdirAll(dir);
    final prefix = dir + "/comments";
    final table = extract(sources(exts), exts: exts, prefix: prefix);
    final doc = prefix + ".comments";
    final found = prosevale\alerts(vale([doc]));
    return Judged{ blocking = prosevale\blocking(found, origins: table, doc: doc),
        advice = prosevale\advice(found, origins: table, doc: doc) };
}

test "generated output and fixture trees are skipped" {
    std\assert(skipped("hack/testdata-upstream/x.buzz"), message: "upstream corpus");
    std\assert(skipped("libs/scipbuzz/testdata/a/main.buzz"), message: "nested testdata");
    std\assert(!skipped("internal/risk/prose.go"), message: "source");
}

test "the position table decodes separator rows as empty origins" {
    final got = origins(`{"origins":[{"path":"a.go","line":3,"col":4},{},{"path":"b.ts","line":1,"col":15}]}`)
        catch [<prosevale\SourceLine>];
    std\assert(got.len() == 3, message: "three rows");
    std\assert(got[0].path == "a.go" and got[0].line == 3 and got[0].col == 4, message: "first");
    std\assert(got[1].path == "", message: "separator");
}
