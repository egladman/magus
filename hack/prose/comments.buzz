// Comment extraction for the prose check. Vale never reads a source file: the comments
// host module hands back each comment block's prose with its file, line and column, and
// this renders them as one document of paragraphs beside a table mapping each document
// line back to its source.
namespace prosecomments;

import "std";
import "fs";
import "vcs";
import "magus";
import "comments";
import "magus/lint";
import "hack/prose/vale" as prosevale;

// SKIPPED are trees whose comments are not this repository's prose: upstream and
// fixture corpora a test reads as data.
final SKIPPED = ["hack/testdata-upstream/", "testdata/", "/testdata/"];

// READS are the sources the comment check judges, for a target's readsFiles: every
// extension a spell declares comment syntax for, in each project holding one.
export final READS = ["**/*.go", "**/*.buzz", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs",
    "**/*.proto", "console/**/*.ts", "docs/**/*.ts", "docs/**/*.mjs", "libs/**/*.go",
    "libs/**/*.buzz", "proto/**/*.proto"];

// syntax maps each extension a spell claims to the comment syntax it declares.
export fun syntax() > {str: any} !> any {
    final found = mut {<str: any>};
    foreach (s in magus\describe.spell()) {
        if (s.syntax?.comments == null) {
            continue;
        }
        foreach (ext in s.extensions) {
            if (found[ext] == null) {
                found[ext] = s.syntax?.comments;
            }
        }
    }
    return found;
}

// skipped reports whether p sits in a tree SKIPPED names.
export fun skipped(p: str) > bool {
    foreach (prefix in SKIPPED) {
        if (p.startsWith(prefix) or (prefix.startsWith("/") and p.indexOf(prefix) != null)) {
            return true;
        }
    }
    return false;
}

// sources are the tracked files a spell's comment syntax reads, less generated output
// (`magus describe file` role output) and SKIPPED trees.
export fun sources(exts: {str: any}) > [str] !> any {
    final listed = vcs\cmd(["ls-files"], opts: {"quiet": true}).stdout.split("\n");
    final candidates = mut [<str>];
    foreach (p in listed) {
        if (p != "" and exts[fs\ext(p)] != null and !skipped(p)) {
            candidates.append(p);
        }
    }
    final kept = mut [<str>];
    if (candidates.len() == 0) {
        return kept;
    }
    foreach (f in magus\describe.file(candidates).files) {
        if (f.role != "output") {
            kept.append(f.path);
        }
    }
    return kept;
}

// Document is a rendered comment document and the table mapping each of its lines back
// to its source; a separator line maps to an empty SourceLine.
export object Document {
    text: str = "",
    table: [prosevale\SourceLine] = [<prosevale\SourceLine>],
}

// render lays out blocks, as comments\blocks returns them, one paragraph each.
export fun render(blocks: [any]) > Document {
    final lines = mut [<str>];
    final table = mut [<prosevale\SourceLine>];
    foreach (i, b in blocks) {
        if (i > 0) {
            lines.append("");
            table.append(prosevale\SourceLine{});
        }
        final path: str = b["path"];
        final rows: [any] = b["lines"];
        foreach (r in rows) {
            final text: str = r["text"];
            lines.append(text);
            table.append(prosevale\SourceLine{ path = path, line = std\toInt(r["line"]), col = std\toInt(r["col"]) });
        }
    }
    return Document{ text = lines.join("\n") + "\n", table = table };
}

// Judged is a check's result: the findings that fail it and the advice that does not.
export object Judged {
    blocking: [Finding] = [<Finding>],
    advice: [Finding] = [<Finding>],
}

// check judges every comment in the tree, writing its document under dir. vale is
// prosevale\run, or a magusfile's call of the vale spell's op.
export fun check(dir: str, vale: fun (paths: [str]) > str !> any) > Judged !> any {
    final exts = syntax();
    final blocks: [any] = comments\blocks(sources(exts), syntax: exts);
    final rendered = render(blocks);
    final doc = prosevale\writeDocument(dir, name: "comments.comments", text: rendered.text);
    final found = prosevale\alerts(vale([doc]));
    return Judged{ blocking = prosevale\blocking(found, origins: rendered.table, doc: doc),
        advice = prosevale\advice(found, origins: rendered.table, doc: doc) };
}

test "generated output and fixture trees are skipped" {
    std\assert(skipped("hack/testdata-upstream/x.buzz"), message: "upstream corpus");
    std\assert(skipped("libs/scipbuzz/testdata/a/main.buzz"), message: "nested testdata");
    std\assert(!skipped("internal/risk/prose.go"), message: "source");
}

test "blocks render as paragraphs and each line maps back to its source column" {
    final blocks: [any] = [
        {"path": "a.go", "lines": [{"line": 3, "col": 4, "text": "Alpha simply."}, {"line": 4, "col": 4, "text": "Beta."}]},
        {"path": "b.ts", "lines": [{"line": 1, "col": 15, "text": "Epsilon."}]},
    ];
    final doc = render(blocks);
    std\assert(doc.text == "Alpha simply.\nBeta.\n\nEpsilon.\n", message: doc.text);
    std\assert(doc.table.len() == 4 and doc.table[2].path == "", message: "a separator has no source");
    final at = prosevale\locate(prosevale\Alert{ check = "Magus.Filler", message = "m", line = 1, col = 7 },
        origins: doc.table, doc: "doc");
    std\assert(at.path == "a.go" and at.line == 3 and at.col == 10, message: prosevale\render(at));
    final last = prosevale\locate(prosevale\Alert{ check = "Magus.Filler", message = "m", line = 4, col = 1 },
        origins: doc.table, doc: "doc");
    std\assert(last.path == "b.ts" and last.line == 1 and last.col == 15, message: prosevale\render(last));
}
