// The prose checks run by hand, without a target: Vale judges text magus extracts, and
// every finding names the file and line the text came from. The root prose,
// commit-messages, pr-title and pr-description targets run the same checks through the
// vale spell.
//
//	magus buzz hack/prose/run.buzz                           rule tests, comments and names
//	magus buzz hack/prose/run.buzz -- tree                   comments and names
//	magus buzz hack/prose/run.buzz -- tests|comments|names [--buzz] [--counts]
//	magus buzz hack/prose/run.buzz -- commits [<range>]       each commit in range (default <base>..HEAD)
//	magus buzz hack/prose/run.buzz -- pr-title <title>
//	magus buzz hack/prose/run.buzz -- pr-description <file>
//
// --counts prints how many findings each rule has instead of each finding. --buzz adds
// the Buzz symbol index to the name ban. It exits 1 on any error-level finding.
namespace prose;

import "std";
import "fs";
import "os";
import "vcs";
import "flags";
import "magus/lint";
import "hack/prose/vale" as prosevale;
import "hack/prose/comments" as prosecomments;
import "hack/prose/names" as prosenames;
import "hack/prose/messages" as prosemessages;

final USAGE = "usage: magus buzz hack/prose/run.buzz -- [all|tree|tests|comments|names|commits [<range>]|pr-title <title>|pr-description <file>] [--buzz] [--counts]";

fun report(blocking: [Finding], advice: [Finding], counts: bool) > void {
    if (counts) {
        final tally = mut {<str: int>};
        foreach (f in blocking) {
            tally[f.rule] = (tally[f.rule] ?? 0) + 1;
        }
        foreach (rule, n in tally) {
            std\print("{n}\t{rule}");
        }
        std\print("{blocking.len()}\ttotal");
        return;
    }
    foreach (f in blocking) {
        std\print(prosevale\render(f));
        if (f.fix != "") {
            std\print("    " + f.fix);
        }
    }
    foreach (f in advice) {
        std\print("note: " + prosevale\render(f));
    }
}

export fun main(args: [str]) > void !> any {
    // The command's own words follow it, so its switches are read from the tail by hand.
    final parsed = flags\parse(args, switches: ["--buzz", "--counts", "--help"], valued: [<str>], command: true);
    if (parsed.values["--help"] != null) {
        std\print(USAGE);
        return;
    }
    if (parsed.unknown.len() > 0) {
        throw USAGE;
    }
    final switches = mut {<str: bool>};
    foreach (k, _ in parsed.values) {
        switches[k] = true;
    }
    final words = mut [<str>];
    foreach (w in parsed.positionals) {
        if (w == "--buzz" or w == "--counts") {
            switches[w] = true;
        } else {
            words.append(w);
        }
    }
    final root = vcs\root();
    final dir = root + "/" + prosevale\SCRATCH;
    final command = if (words.len() > 0) words[0] else "all";
    final rest = words.sub(if (words.len() > 0) 1 else 0);
    final blocking = mut [<Finding>];
    final advice = mut [<Finding>];
    if (command == "all" or command == "tests") {
        foreach (f in prosevale\testFindings(prosevale\run(prosevale\TEST_ARGS))) {
            blocking.append(f);
        }
    }
    if (command == "all" or command == "tree" or command == "comments") {
        final judged = prosecomments\check(dir, vale: prosevale\run);
        foreach (f in judged.blocking) { blocking.append(f); }
        foreach (f in judged.advice) { advice.append(f); }
    }
    if (command == "all" or command == "tree" or command == "names") {
        final judged = prosenames\check(dir, buzz: switches["--buzz"] ?? false, vale: prosevale\run);
        foreach (f in judged.blocking) { blocking.append(f); }
        foreach (f in judged.advice) { advice.append(f); }
    }
    if (command == "commits") {
        final revs = if (rest.len() > 0) rest[0] else vcs\base() + "..HEAD";
        final judged = prosemessages\commits(dir, revs: revs, vale: prosevale\run);
        foreach (f in judged.blocking) { blocking.append(f); }
        foreach (f in judged.advice) { advice.append(f); }
    }
    if (command == "pr-title" or command == "pr-description") {
        if (rest.len() == 0) {
            throw USAGE;
        }
        final judged = if (command == "pr-title") prosemessages\title(dir, title: rest.join(" "), vale: prosevale\run)
            else prosemessages\description(dir, body: fs\readFile(rest[0]), label: rest[0], vale: prosevale\run);
        foreach (f in judged.blocking) { blocking.append(f); }
        foreach (f in judged.advice) { advice.append(f); }
    }
    report(blocking, advice: advice, counts: switches["--counts"] ?? false);
    if (blocking.len() > 0) {
        os\exit(1);
    }
}
