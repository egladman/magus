// The function-name ban for the prose check: no function, method or interface method
// name ends in the word Of or For. Names come from the SCIP symbol indexes magus already
// holds, never from a parse of their own, and Vale judges one name per document line.
namespace prosenames;

import "std";
import "magus";
import "magus/lint";
import "hack/prose/vale" as prosevale;

// LANGUAGES are the indexes the ban reads. Buzz joins with the --buzz flag until mise
// installs scip-buzz; until then a Buzz row would hold on one machine and not another.
export final LANGUAGES = ["go", "typescript"];

// GO_KINDS are the scip-go kinds that name a function; other indexes mark one by a
// `().` descriptor.
final GO_KINDS = {"Function": true, "Method": true, "MethodSpecification": true};

final TEST_SUFFIXES = ["_test.go", ".test.ts", ".test.tsx", ".spec.ts", ".spec.tsx", "_test.buzz"];

// ROWS is one defined symbol per line: language, kind, file:line, name, id.
final ROWS = `template={{range .nodes}}{{if and (eq .kind "symbol") (index . "source")}}{{.attrs.language}}	{{.attrs.symbol_kind}}	{{.source}}	{{.label}}	{{.id}}
{{end}}{{end}}`;

// Name is one function name and where it is defined.
export object Name {
    language: str = "",
    name: str = "",
    path: str = "",
    line: int = 0,
}

// parseRows keeps the function rows of ROWS in languages, outside test files.
export fun parseRows(text: str, languages: [str]) > [Name] {
    final kept = mut [<Name>];
    foreach (row in text.split("\n")) {
        final cols = row.split("\t");
        if (cols.len() < 5 or languages.indexOf(cols[0]) == null) {
            continue;
        }
        final isFunction = if (cols[0] == "go") GO_KINDS[cols[1]] ?? false else cols[4].endsWith("().");
        if (!isFunction) {
            continue;
        }
        final colon = cols[2].indexOf(":");
        if (colon == null) {
            continue;
        }
        final path = cols[2].sub(0, len: colon!);
        if (testFile(path)) {
            continue;
        }
        final line = std\parseInt(cols[2].sub(colon! + 1)) ?? 0;
        kept.append(Name{ language = cols[0], name = cols[3], path = path, line = line });
    }
    return kept;
}

fun testFile(path: str) > bool {
    foreach (suffix in TEST_SUFFIXES) {
        if (path.endsWith(suffix)) {
            return true;
        }
    }
    return path.indexOf("/__tests__/") != null;
}

// INDEXES prints, per language, each project index a `magus query` answer reports missing
// (`gap`) or older than its sources (`stale`): the freshness every knowledge answer carries.
final INDEXES = `template={{range .answer.gaps}}gap	{{.project.path}}	{{.language}}	{{.state}}	{{.hint}}
{{end}}{{range .answer.stale_index_details}}stale	{{.project}}	{{.language}}	out-of-date
{{end}}`;

// IndexGap is one project's symbol index for one language that is missing or stale.
export object IndexGap {
    project: str = "",
    language: str = "",
    state: str = "",
    hint: str = "",
}

// parseIndexes reads INDEXES output.
export fun parseIndexes(text: str) > [IndexGap] {
    final found = mut [<IndexGap>];
    foreach (row in text.split("\n")) {
        final cols = row.split("\t");
        if (cols.len() >= 4 and (cols[0] == "gap" or cols[0] == "stale")) {
            final hint = if (cols.len() > 4) cols[4].trim() else "";
            found.append(IndexGap{ project = cols[1], language = cols[2], state = cols[3], hint = hint });
        }
    }
    return found;
}

// indexGaps asks the knowledge graph which indexes are missing or stale.
export fun indexGaps() > [IndexGap] !> any {
    final res = magus\cmd("query", args: ["kind=symbol", "--budget", "1", "-o", INDEXES],
        opts: {"quiet": true, "allow_failure": true});
    return parseIndexes(res.stdout);
}

// freshness is a finding when no index is built, per missing or stale index of a language
// in languages, and per such language with no function in the export: a ban reading
// nothing finds nothing.
export fun freshness(indexed: bool, gaps: [IndexGap], names: [Name], languages: [str]) > [Finding] {
    final found = mut [<Finding>];
    if (!indexed) {
        found.append(Finding{ path = ".", rule = "prose-names",
            message = "no symbol index is built, so no function name was judged",
            fix = "Build it with `magus graph build`, then rerun." });
    }
    foreach (gap in gaps) {
        if (languages.indexOf(gap.language) == null) {
            continue;
        }
        final hint = if (gap.hint != "") "; " + gap.hint else "";
        found.append(Finding{ path = gap.project, rule = "prose-names",
            message = "the {gap.language} symbol index of {gap.project} is {gap.state}{hint}, so its names are not all judged",
            fix = "Rebuild it with `magus graph build`, then rerun." });
    }
    foreach (lang in languages) {
        var seen = false;
        foreach (n in names) {
            if (n.language == lang) {
                seen = true;
                break;
            }
        }
        if (!seen) {
            final fix = if (lang == "buzz") "Install scip-buzz through mise, then `magus graph build`."
                else "A spell binding {lang} declares its indexer; check `magus describe spell`.";
            found.append(Finding{ path = ".", rule = "prose-names",
                message = "the symbol indexes hold no {lang} function, so no {lang} name was judged", fix = fix });
        }
    }
    return found;
}

// document is one name per line and the table mapping each line to its definition.
export fun document(names: [Name]) > obj{ text: str, table: [prosevale\SourceLine] } {
    final lines = mut [<str>];
    final table = mut [<prosevale\SourceLine>];
    foreach (n in names) {
        lines.append(n.name);
        table.append(prosevale\SourceLine{ path = n.path, line = n.line });
    }
    return .{ text = lines.join("\n") + "\n", table = table };
}

// check judges every function name the indexes define, writing its document under dir.
// vale is prosevale\run, or a magusfile's call of the vale spell's op.
export fun check(dir: str, buzz: bool, vale: fun (paths: [str]) > str !> any) > obj{ blocking: [Finding], advice: [Finding] } !> any {
    final languages = mut [<str>];
    foreach (lang in LANGUAGES) {
        languages.append(lang);
    }
    if (buzz) {
        languages.append("buzz");
    }
    // TODO(prose): the prose target should ctx.needs the symbol index ops so the export is
    // current by construction. A nested `magus graph build` here is MGS3007, so until then
    // a stale index is a finding.
    final exported = magus\cmd("graph", args: ["export", "--symbols", "-o", ROWS], opts: {"quiet": true});
    final all = parseRows(exported.stdout, languages: languages);
    final paths = mut [<str>];
    final seen = mut {<str: bool>};
    foreach (n in all) {
        if (seen[n.path] == null) {
            seen[n.path] = true;
            paths.append(n.path);
        }
    }
    final generated = mut {<str: bool>};
    if (paths.len() > 0) {
        foreach (f in magus\describe.file(paths).files) {
            if (f.role == "output") {
                generated[f.path] = true;
            }
        }
    }
    final names = mut [<Name>];
    foreach (n in all) {
        if (generated[n.path] == null) {
            names.append(n);
        }
    }
    final stale = freshness(magus\symbolIndexDigest().indexed, gaps: indexGaps(), names: names,
        languages: languages);
    final doc = prosevale\writeDocument(dir, name: "functions.names", text: document(names).text);
    final found = prosevale\alerts(vale([doc]));
    final table = document(names).table;
    final blocking = mut [<Finding>];
    foreach (f in stale) {
        blocking.append(f);
    }
    foreach (f in prosevale\blocking(found, origins: table, doc: doc)) {
        blocking.append(f);
    }
    return .{ blocking = blocking, advice = prosevale\advice(found, origins: table, doc: doc) };
}

final SAMPLE = "go	Function	cmd/magus/main.go:12	exitCodeOf	symbol:gomod x `x`/exitCodeOf().
go	Method	types/a.go:40	Read	symbol:gomod x `x`/A#Read().
go	Field	types/a.go:41	OfField	symbol:gomod x `x`/A#OfField.
go	Function	cmd/magus/main_test.go:9	TestExitCodeOf	symbol:gomod x `x`/TestExitCodeOf().
typescript	<no value>	console/src/a.ts:7	rowOf	symbol:npm x `a.ts`/rowOf().
typescript	<no value>	console/src/a.ts:3	theme	symbol:npm x `a.ts`/theme.
buzz	Function	hack/x.buzz:2	fooFor	symbol:buzz x/fooFor().
";

test "only function rows outside tests are kept, in the languages asked for" {
    final got = parseRows(SAMPLE, languages: ["go", "typescript"]);
    std\assert(got.len() == 3, message: "{got.len()} rows");
    std\assert(got[0].name == "exitCodeOf" and got[0].path == "cmd/magus/main.go" and got[0].line == 12, message: "go function");
    std\assert(got[1].name == "Read", message: "go method");
    std\assert(got[2].name == "rowOf" and got[2].language == "typescript", message: "ts function by its descriptor");
    std\assert(parseRows(SAMPLE, languages: ["go", "typescript", "buzz"]).len() == 4, message: "buzz behind its flag");
}

test "a stale or missing index is a finding, never a pass" {
    final names = parseRows(SAMPLE, languages: ["go"]);
    final none = [<IndexGap>];
    std\assert(freshness(true, gaps: none, names: names, languages: ["go"]).len() == 0, message: "fresh go index");
    final nobuzz = freshness(true, gaps: none, names: names, languages: ["go", "buzz"]);
    std\assert(nobuzz.len() == 1 and nobuzz[0].fix.indexOf("scip-buzz") != null, message: "no buzz index");
    final unbuilt = freshness(false, gaps: none, names: names, languages: ["go"]);
    std\assert(unbuilt.len() == 1, message: "nothing indexed");
    final gaps = parseIndexes("gap\tdocs\tbuzz\tnot-indexed\tscip-buzz is not installed\n"
        + "gap\tlibs/scipbuzz\tgo\tnot-indexed\t\nstale\tconsole\ttypescript\tout-of-date\t\n");
    std\assert(gaps.len() == 3 and gaps[0].hint == "scip-buzz is not installed", message: "three rows");
    final judged = freshness(true, gaps: gaps, names: parseRows(SAMPLE, languages: ["go", "typescript"]),
        languages: ["go", "typescript"]);
    std\assert(judged.len() == 2, message: "{judged.len()}: a buzz gap is not judged without --buzz");
    std\assert(judged[0].path == "libs/scipbuzz" and judged[1].path == "console", message: "go then typescript");
}

test "each document line maps to its definition" {
    final doc = document(parseRows(SAMPLE, languages: ["go"]));
    std\assert(doc.text == "exitCodeOf\nRead\n", message: doc.text);
    std\assert(doc.table[0].path == "cmd/magus/main.go" and doc.table[0].line == 12, message: "first");
}
