// skills-generate-declares-every-shipped-skill keeps skills_generate's declared outputs
// in step with what magus actually installs, in both directions. Naming the shipped
// skills rather than `.claude/skills/**` keeps the hand-authored ones out, but goes
// stale on its own, so adding a skill fails here rather than ships an installed file
// magus calls hand-editable.
namespace skills;

import "assert";
import "path";
import "std";
import "magus/lint";
import "hack/lint/support" as support;

// SHIPPED is the shipped set: one directory per skill magus installs.
export final SHIPPED = "internal/agent/skills";

// CATALOG declares the suffix an install gives each skill's always-full twin.
export final CATALOG = "internal/agent/catalog.go";

// HAND_AUTHORED live beside the installed skills and are NOT written by `magus agent
// install`. Each is tracked through an explicit .gitignore negation, and
// magus-workspace-rules tells readers to put local rules in exactly this shape, so a
// declaration that claims them tells an author the one file they are supposed to edit is
// generated, and hands it to the regenerating merge driver on a conflict. The runner
// reports one the tree no longer has.
export final HAND_AUTHORED = ["magus-skill-authoring", "magus-local-development", "shepherd-pull-requests"];

// DESTINATIONS are the directories an install writes skills into.
export final DESTINATIONS = [".claude/skills", ".agents/skills", ".opencode/skills"];

final suffixDecl = std\pattern(`const fullTwinSuffix = "([^"]+)"`);

export fun reads() > [str] {
    final globs = mut [<str>];
    globs.append("magusfile.buzz");
    globs.append(CATALOG);
    globs.append(SHIPPED + "/*/SKILL.md");
    foreach (name in HAND_AUTHORED) {
        globs.append(".claude/skills/" + name + "/SKILL.md");
    }
    return globs;
}

export fun check(files: [Path]) > [Finding] !> any {
    final magusfile = support\named(files, p: "magusfile.buzz");
    final catalog = support\named(files, p: CATALOG);
    if (magusfile == null) {
        return [support\missing("magusfile.buzz")];
    }
    if (catalog == null) {
        return [support\missing(CATALOG)];
    }
    final suffix = suffixDecl.match(support\read(catalog!));
    if (suffix == null) {
        return [Finding{ path = CATALOG, message = "declares no fullTwinSuffix",
            fix = "Update this rule's pattern to where the full twin's suffix is declared now." }];
    }
    final shipped = mut [<str>];
    foreach (f in files) {
        if (path\matches(SHIPPED + "/*/SKILL.md", path: f.value)) {
            shipped.append(f.value.sub(SHIPPED.len() + 1, len: f.value.len() - SHIPPED.len() - "/SKILL.md".len() - 1));
        }
    }
    final outputs = mut [<str>];
    foreach (p in support\targets().projects) {
        if (p.path != ".") {
            continue;
        }
        foreach (n in p.nodes) {
            if (n.name == "skills-generate") {
                foreach (ref in n.writesFiles) {
                    outputs.append(ref.glob);
                }
            }
        }
    }
    return findings(outputs, shipped: shipped, twinSuffix: suffix![1], magusfile: support\read(magusfile!));
}

// findings grades skills_generate's declared output globs against the shipped skill
// names, each installed with its twin, and against HAND_AUTHORED.
export fun findings(outputs: [str], shipped: [str], twinSuffix: str, magusfile: str) > [Finding] !> any {
    if (outputs.len() == 0) {
        return [Finding{ path = "magusfile.buzz", message = "declares no installed-skill outputs" }];
    }
    final line = support\findLine(magusfile, needle: "export fun skills_generate(");
    final found = mut [<Finding>];
    foreach (name in support\sorted(shipped)) {
        foreach (dest in DESTINATIONS) {
            foreach (installed in [name, name + twinSuffix]) {
                final p = dest + "/" + installed + "/SKILL.md";
                if (path\matchesAny(outputs, path: p)) {
                    continue;
                }
                found.append(Finding{ path = "magusfile.buzz", line = line,
                    message = "{SHIPPED} ships {name}, but no declared output covers {p}",
                    fix = "An undeclared installed skill classifies as hand-editable source, and the merge\n"
                        + "driver stops covering it. Add the pattern to skills_generate." });
            }
        }
    }
    foreach (name in HAND_AUTHORED) {
        foreach (dest in DESTINATIONS) {
            final p = dest + "/" + name + "/SKILL.md";
            if (!path\matchesAny(outputs, path: p)) {
                continue;
            }
            found.append(Finding{ path = "magusfile.buzz", line = line,
                message = "declares {p} as a generated output, but magus never writes it",
                fix = "describe file will call it generated and the path guard will warn an author off it.\n"
                    + "Narrow the skills_generate pattern so it misses the hand-authored skill." });
        }
    }
    return found;
}

fun skillOutputGlobs(names: [str]) > [str] {
    final globs = mut [<str>];
    foreach (dest in DESTINATIONS) {
        foreach (name in names) {
            globs.append(dest + "/" + name + "*/**");
        }
    }
    return globs;
}

test "every shipped skill and its twin declared, no hand-authored one, passes" {
    assert\equal(findings(skillOutputGlobs(["magus-run", "magus-query"]), shipped: ["magus-run", "magus-query"], twinSuffix: "-full", magusfile: "").len(),
        want: 0, message: "clean");
}

test "a shipped skill with no output is reported at skills_generate" {
    final got = findings(skillOutputGlobs(["magus-run"]), shipped: ["magus-run", "magus-new"], twinSuffix: "-full",
        magusfile: "x\nexport fun skills_generate(ctx: magus\\Context) > void \{}\n");
    assert\equal(got.len(), want: 6, message: "three destinations, each with its twin");
    assert\equal(got[0].message, want: "internal/agent/skills ships magus-new, but no declared output covers .claude/skills/magus-new/SKILL.md", message: "message");
    assert\equal(got[0].line, want: 2, message: "line");
}

test "an output claiming a hand-authored skill is reported" {
    final got = findings([".claude/skills/**"], shipped: [<str>], twinSuffix: "-full", magusfile: "");
    assert\equal(support\messages(got), want: [
        "declares .claude/skills/magus-skill-authoring/SKILL.md as a generated output, but magus never writes it",
        "declares .claude/skills/magus-local-development/SKILL.md as a generated output, but magus never writes it",
        "declares .claude/skills/shepherd-pull-requests/SKILL.md as a generated output, but magus never writes it",
    ], message: "all three");
}
