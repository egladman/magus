// markdown-prose holds this repository's hand-written Markdown to the rules below, each an
// error:
//
//   - No spaced hyphen as a dash: ` - ` between words is the em dash typed in ASCII, and it
//     leaves the reader to guess the relation. A colon, semicolon, comma, parentheses or a
//     second sentence names it. List markers, table cells and code are not dashes; a code
//     span may wrap within its paragraph and still counts as code.
//   - Headings in sentence case: after the first word, a word is lowercase unless it is a
//     proper noun or an identifier in ALLOW. Title Case and SHOUTING read as emphasis the
//     heading does not mean, and sentence case is what the docs already write.
//   - The writing rules of docs/conventions.md, which libs/conventions/cmd/judge-docs
//     judges in one run per kind over every file, under this repository's decisions table
//     (hack/policy/prose.buzz): no reply to a request or to a conversation the reader never
//     saw, the present tense, no hedge on a claim, no credit to a tool, no filler, one
//     spelling per glossary term, and no typographic punctuation (an em or en dash, a
//     spaced double hyphen, a curly quote, an ellipsis character). A finding the table
//     decides `deny` fails; `advise` is the reader's to weigh. A post under blog/ is first
//     person by design, and the table exempts it from the voice rules. A judge that does
//     not run is an error, never a pass.
//   - A skill is judged by its own rules, since an agent pays for every word on every
//     load: what its short form shows is held to the terse rules too (a sentence and a
//     paragraph word cap, and wordy phrases with a shorter equivalent), and "rule"
//     names only what magus enforces, so a bare one is refused. A skill body
//     under internal/agent/skills/ renders a short and a full form, so text only the
//     full form shows is held to the Markdown rules alone.
//   - A guide, a page the reader follows with a terminal open (GUIDES), is judged by the
//     guide rules: the Markdown rules plus second person (no we, us or our), numbered
//     steps that open with their verb, and no word telling the reader a step is easy.
//
// .markdownlint.json holds the rest of the decided Markdown style, which markdownlint
// enforces: `-` bullets (MD004) and counting ordered lists (MD029), so a diff of a list
// touches only the lines that changed; ATX headings (MD003), the one form grep and the
// docs' heading anchors agree on; inline links only (MD054), so a link reads whole on
// its line; `_em_` and `**strong**` (MD049, MD050), one spelling of each.
//
// Generated Markdown is skipped: its generator owns the fix. It is what .gitattributes
// marks linguist-generated, what .markdownlintignore lists, and every MAGUS.md.
namespace markdownprose;

import "assert";
import "fs";
import "path";
import "proc";
import "std";
import "encoding/json";
import "magus/lint";
import "hack/lint/support" as support;
import "hack/policy/prose" as decisions;
import "libs/conventions/judge_docs" as judgeDocs;

// reads names the judge's module apart: a tree glob stops at a nested project.
export fun reads() > [str] {
    return ["**/*.md", "console/**/*.md", "docs/**/*.md", ".gitattributes", ".markdownlintignore",
        "libs/conventions/go.mod", "libs/conventions/go.sum", "libs/conventions/**/*.go",
        "libs/conventions/judge_docs.buzz"];
}

// HAND_WRITTEN are .markdownlintignore entries that are not generated: the changelog
// fragments and the AGENTS.md section open below an H1, and .claude/ is listed for the
// other checkouts under it, which the runner already prunes.
final HAND_WRITTEN = ["changes/unreleased/", "internal/agent/agents-section.md", ".claude/"];

// ALLOW are the capitalized words a heading may carry after its first: proper nouns and
// acronyms, each mined from the headings already in the tree. A word with a digit, a dot,
// a slash or an underscore, or one that starts lowercase (camelCase, macOS), is an
// identifier and needs no entry; so does a single letter, which is a label or `I`.
final ALLOW = [
    // Products, languages, projects and companies.
    "Backblaze", "Buildkite", "Buzz", "Chrome", "CircleCI", "Claude", "Cloudflare", "Cursor",
    "GitHub", "Go", "Jenkins", "Linux", "MinIO", "Nx", "OpenTelemetry", "PatternFly", "Python",
    "Swift", "TypeScript", "Unix", "Windows",
    // Acronyms and initialisms.
    "ADR", "AI", "API", "CI", "CLI", "CWD", "FAQ", "FFI", "HTTP", "ID", "IDs", "JIT", "JSON",
    "LLM", "MCP", "PATH", "PF", "REPL", "RFC", "SBOM", "SCIP", "SDK", "UI", "URL", "URLs",
    "VCS", "YAML",
];

// ALLOW_PHRASES are names whose second word is capitalized only as part of the name.
final ALLOW_PHRASES = ["Azure Pipelines", "Claude Code", "GitHub Actions", "GitHub Enterprise",
    "Goblin Tools", "JSON Patch", "SWE-bench Verified", "VS Code"];

final JUDGE = "libs/conventions/cmd/judge-docs";

// KINDS are the judge's kinds this rule runs, one judge run each.
final KINDS = ["reference", "guide", "agent-instructions", "agent-instructions-template"];

// GUIDES are the procedural pages; concepts, reference, doctrine and the decision records
// explain and keep the general Markdown rules.
final GUIDES = ["docs/guides/**"];

// kindOf is the judge's kind for the hand-written file at rel: a skill body the
// agent package renders, a skill an agent loads as written, a guide, or any other
// Markdown, which a reader looks things up in.
export fun kindOf(rel: str) > str !> any {
    if (path\matchesAny(["internal/agent/skills/*/SKILL.md"], path: rel)) {
        return "agent-instructions-template";
    }
    if (path\matchesAny([".claude/skills/*/SKILL.md"], path: rel)) {
        return "agent-instructions";
    }
    if (path\matchesAny(GUIDES, path: rel)) {
        return "guide";
    }
    return "reference";
}

export fun check(files: [Path]) > [Finding] !> any {
    final generated = mut [<str>];
    final attrs = support\named(files, p: ".gitattributes");
    if (attrs != null) {
        foreach (g in support\attributeGlobs(support\read(attrs!))) { generated.append(g); }
    }
    final ignore = support\named(files, p: ".markdownlintignore");
    if (ignore != null) {
        foreach (g in ignoreGlobs(support\read(ignore!))) { generated.append(g); }
    }
    final found = mut [<Finding>];
    final pages = mut [<Page>];
    final bases = mut [<str>];
    foreach (f in files) {
        if (!f.value.endsWith(".md") or isGenerated(f.value, globs: generated)) {
            continue;
        }
        foreach (finding in proseFindings(f.value, md: support\read(f))) {
            found.append(finding);
        }
        pages.append(Page{ base = f.base, rel = f.value, kind = kindOf(f.value) });
        if (bases.indexOf(f.base) == null) {
            bases.append(f.base);
        }
    }
    foreach (kind in KINDS) {
        foreach (base in bases) {
            final rels = mut [<str>];
            foreach (p in pages) {
                if (p.kind == kind and p.base == base) {
                    rels.append(p.rel);
                }
            }
            foreach (finding in judge(rels, base: base, module: judgeDocs\home, kind: kind)) {
                found.append(finding);
            }
        }
    }
    return found;
}

// Page is one hand-written file: the directory its path is relative to ("" for the
// workspace), that path, and the judge's kind for it.
object Page {
    base: str,
    rel: str,
    kind: str,
}

// judge runs the writing rules of kind over files, workspace paths relative to base, in
// one run of the judge built in module. The judge runs from base, so a finding names the
// file as given and the decisions table's path globs match workspace paths.
fun judge(files: [str], base: str, module: str, kind: str) > [Finding] !> any {
    if (files.len() == 0) {
        return [<Finding>];
    }
    final bin = path\abs("{module}/{judgeDocs\binary}");
    final table = decisions\writeDecisions(files);
    final args = mut ["-kind", kind, "-decisions", table];
    foreach (rel in support\sorted(files)) {
        args.append(rel);
    }
    final fix = "Run `{judgeDocs\build}`, then {module}/{judgeDocs\binary} -kind {kind} <file>, and read why it stopped.";
    final run = proc\exec(bin, args: args, dir: if (base == "") "." else base,
        opts: {"quiet": true, "allow_failure": true}) catch null;
    fs\remove(table) catch void;
    if (run == null or run!.code != 0) {
        final why = if (run == null) "the judge binary did not start" else "it exited {run!.code}: " + run!.stderr.trim();
        return [Finding{ path = JUDGE, message = "the prose judge did not run, so no Markdown was judged; " + why, fix = fix }];
    }
    final rows: [any]? = json\parse(run!.stdout) catch null;
    if (rows == null) {
        return [Finding{ path = JUDGE, message = "the prose judge printed no JSON array, so no Markdown was judged", fix = fix }];
    }
    return judgedFindings(rows!);
}

// judgedFindings reports the judge's rows the decisions table denies, each at the file it
// names. An advisory finding is the reader's to weigh; a lint that failed on one would
// teach everyone to stop reading it.
export fun judgedFindings(rows: [any]) > [Finding] {
    final found = mut [<Finding>];
    foreach (r in rows) {
        if ((r["decision"] ?? "") != "deny") {
            continue;
        }
        final node: str = r["node"] ?? "";
        final source: str = r["source"] ?? "";
        final rule: str = r["rule"] ?? "";
        final line = if (source.len() > node.len()) std\parseInt(source.sub(node.len() + 1)) ?? 0 else 0;
        final said: str = r["message"] ?? "";
        found.append(Finding{ path = node, line = line, message = "{said} [{rule}]", url = r["url"] ?? "",
            fix = "Reword it to the writing rules in docs/conventions.md; a quoted word is a mention, not a use." });
    }
    return found;
}

// ignoreGlobs are .markdownlintignore's entries as globs, less HAND_WRITTEN.
export fun ignoreGlobs(src: str) > [str] {
    final globs = mut [<str>];
    foreach (line in src.split("\n")) {
        final t = line.trim();
        if (t == "" or t.startsWith("#") or HAND_WRITTEN.indexOf(t) != null) {
            continue;
        }
        if (t.endsWith("/")) {
            globs.append(support\rooted(t) + "**");
        } else {
            globs.append(support\rooted(t));
        }
    }
    return globs;
}

fun isGenerated(rel: str, globs: [str]) > bool !> any {
    if (rel == "MAGUS.md" or rel.endsWith("/MAGUS.md")) {
        return true;
    }
    return path\matchesAny(globs, path: rel);
}

// fenceRun is the fence a line opens or closes, or "".
fun fenceRun(t: str) > str {
    if (!t.startsWith("```") and !t.startsWith("~~~")) {
        return "";
    }
    final ch = t.byte(0);
    var n = 0;
    while (n < t.len() and t.byte(n) == ch) {
        n = n + 1;
    }
    return t.sub(0, len: n);
}

// prose is line with its inline code spans blanked to spaces, newlines kept, so lines and
// columns still line up. line may be a whole paragraph, since a span can wrap.
export fun prose(line: str) > str {
    final parts = mut [<str>];
    var i = 0;
    var start = 0;
    while (i < line.len()) {
        if (line.byte(i) != 96) {   // 96 = backtick
            i = i + 1;
            continue;
        }
        var run = 0;
        while (i + run < line.len() and line.byte(i + run) == 96) {
            run = run + 1;
        }
        final ticks = line.sub(i, len: run);
        final close = line.indexOf(ticks, from: i + run);
        if (close == null) {
            i = i + run;
            continue;
        }
        parts.append(line.sub(start, len: i - start));
        final blanked = mut [<str>];
        foreach (row in line.sub(i, len: close! + run - i).split("\n")) {
            blanked.append(" ".repeat(row.len()));
        }
        parts.append(blanked.join("\n"));
        i = close! + run;
        start = i;
    }
    parts.append(line.sub(start));
    return parts.join("");
}

// LIST_ITEM matches a trimmed line that opens a list item.
final LIST_ITEM = std\pattern(`^([-*+]|[0-9]+[.)])( |$)`);

// proseLines is each line as prose: "" for a line of fenced or indented code, and code
// spans blanked by prose one paragraph at a time. A paragraph ends at a blank line, and
// a list item, heading or table row starts a new one.
export fun proseLines(lines: [str]) > [str] {
    final rows = mut [<str>];
    var para = mut [<str>];
    var fence = "";
    // list is the content column of the open list item: indented code sits 4 past it,
    // so a list's continuation lines are prose.
    var list = 0;
    var code = false;
    var blank = true;
    // ended is set when para holds a heading or table row, which never wraps.
    var ended = false;
    foreach (line in lines) {
        final t = line.trim();
        final run = fenceRun(t);
        var indent = 0;
        while (indent < line.len() and line.byte(indent) == 32) {
            indent = indent + 1;
        }
        final item = LIST_ITEM.match(t) != null;
        if (fence == "" and blank and t != "" and !item and indent < list) {
            list = 0;
        }
        final fenced = fence != "" or run != "";
        if (fence != "") {
            if (run != "" and run.byte(0) == fence.byte(0) and run.len() >= fence.len() and run == t) {
                fence = "";
            }
        } else if (run != "") {
            fence = run;
        }
        final indented = t != "" and !fenced and (blank or code)
            and (line.startsWith("\t") or indent >= list + 4);
        final single = t.startsWith("#") or t.startsWith("|");
        if (para.len() > 0 and (ended or t == "" or fenced or indented or item or single)) {
            foreach (p in prose(para.join("\n")).split("\n")) { rows.append(p); }
            para = mut [<str>];
        }
        if (t == "" or fenced or indented) {
            rows.append("");
            code = indented or (code and t == "");
            blank = t == "";
            continue;
        }
        if (item) {
            list = indent + (t.indexOf(" ") ?? t.len()) + 1;
        }
        para.append(line);
        ended = single;
        code = false;
        blank = false;
    }
    if (para.len() > 0) {
        foreach (p in prose(para.join("\n")).split("\n")) { rows.append(p); }
    }
    return rows;
}

// dashColumns are the 1-based columns of each spaced `-` in line that stands as a dash
// between words, given text, its prose. A hyphen with nothing but `>` and spaces before it
// is a list marker, and one beside a `|` is a table cell or a delimiter row. A spaced `--`
// is the judge's dash rule.
export fun dashColumns(line: str, text: str) > [int] {
    final cols = mut [<int>];
    var i = 2;
    while (i < text.len()) {
        if (text.byte(i) != 45 or line.byte(i - 1) != 32) {   // 45 = hyphen, 32 = space
            i = i + 1;
            continue;
        }
        var end = i;
        while (end < text.len() and text.byte(end) == 45) {
            end = end + 1;
        }
        final before = line.sub(i - 2, len: 1);
        final rest = line.sub(end);
        final after = if (rest.startsWith(" ")) rest.sub(1, len: 1) else "";
        final wrapped = rest.trim() == "";
        if (end - i == 1 and (wrapped or (after != "" and " \t|".indexOf(after) == null))
            and " \t|".indexOf(before) == null and line.sub(0, len: i).replace(">", with: " ").trim() != "") {
            cols.append(i + 1);
        }
        i = end;
    }
    return cols;
}

// proseFindings checks one file's lines outside code.
export fun proseFindings(file: str, md: str) > [Finding] !> any {
    final found = mut [<Finding>];
    final lines = md.split("\n");
    final texts = proseLines(lines);
    var n = 0;
    while (n < lines.len()) {
        final line = lines[n];
        final text = texts[n];
        n = n + 1;
        foreach (col in dashColumns(line, text: text)) {
            found.append(Finding{ path = file, line = n, col = col, message = "a spaced hyphen used as a dash",
                fix = "Say what the dash meant: a colon, a semicolon, a comma, parentheses or two sentences." });
        }
        if (text.startsWith("#")) {
            final word = headingWord(text);
            if (word != "") {
                found.append(Finding{ path = file, line = n,
                    message = "heading word `{word}` is capitalized; headings are sentence case",
                    fix = "Lowercase it. A proper noun or identifier goes in ALLOW in hack/lint/markdown-prose.buzz." });
            }
        }
    }
    return found;
}

// headingWord returns the first word of an ATX heading that breaks sentence case, or "".
export fun headingWord(line: str) > str {
    var h = prose(line);
    while (h.startsWith("#")) {
        h = h.sub(1);
    }
    if (!h.startsWith(" ")) {
        return "";
    }
    foreach (phrase in ALLOW_PHRASES) {
        h = h.replace(phrase, with: "x");
    }
    h = h.replace("](", with: "] (");
    final words = mut [<str>];
    foreach (w in h.split(" ")) {
        if (w.trim() != "") {
            words.append(w.trim());
        }
    }
    // A leading label (`3b.`, `A.`, `S4:`) numbers the heading and is not its first word.
    if (words.len() > 0 and std\pattern(`^([0-9]+[a-z]?|[A-Z]'?|[A-Z][0-9]+)[.:]$`).match(words[0]) != null) {
        words.remove(0);
    }
    var first = true;
    foreach (raw in words) {
        final w = bare(raw);
        if (first) {
            if (w.len() > 1 and w.upper() == w and w.lower() != w and ALLOW.indexOf(w) == null and !isIdentifier(w)) {
                return w;
            }
        } else {
            foreach (part in w.split("-")) {
                if (!lowerOrAllowed(part)) {
                    return w;
                }
            }
        }
        first = raw.endsWith(".") or raw.endsWith("?") or raw.endsWith("!");
    }
    return "";
}

// bare strips the markup and punctuation around a word, and a possessive. An underscore
// goes only in pairs, as `_em_`: `MAGUS_*` keeps its, which marks it an identifier.
fun bare(raw: str) > str {
    final edge = `[](){}<>"'*,.:;!?`;
    var w = raw;
    while (w.len() > 0 and edge.indexOf(w.sub(0, len: 1)) != null) {
        w = w.sub(1);
    }
    while (w.len() > 0 and edge.indexOf(w.sub(w.len() - 1)) != null) {
        w = w.sub(0, len: w.len() - 1);
    }
    if (w.len() > 1 and w.startsWith("_") and w.endsWith("_")) {
        w = bare(w.sub(1, len: w.len() - 2));
    }
    if (w.endsWith("'s")) {
        w = w.sub(0, len: w.len() - 2);
    }
    return w;
}

fun isIdentifier(w: str) > bool {
    return std\pattern(`[0-9./\\_=@$<>]`).match(w) != null;
}

fun lowerOrAllowed(w: str) > bool {
    if (w.len() <= 1 or w.lower() == w or ALLOW.indexOf(w) != null or isIdentifier(w)) {
        return true;
    }
    final b = w.byte(0);
    return b >= 97 and b <= 122;   // a-z: camelCase or a lowercase brand
}

test "typographic punctuation outside code is the judge's, under this repository's table" {
    final got = check(support\fixture({"docs/a.md": "# A page\n\nOne — two.\nIt’s `a — b` fine.\n```\n“quoted”\n```\nWait…\nThen -- go.\n"}));
    final where = mut [<str>];
    foreach (f in got) {
        where.append("{f.path}:{f.line} " + f.message.sub(f.message.indexOf("[") ?? 0));
    }
    assert\equal(where, want: ["docs/a.md:3 [dash]", "docs/a.md:9 [dash]", "docs/a.md:4 [ascii]", "docs/a.md:8 [ascii]"],
        message: "prose only");
    assert\equal(got[0].url.endsWith("/prose/dash/"), want: true, message: got[0].url);
}

test "a spaced hyphen between words is a dash" {
    final got = proseFindings("a.md", md: "One - two.\nWait -- then go.\n**Term** - its gloss.\n`code` - after a span.\n"
        + "A line that ends -\non a dash.\n| a - b | c |\n> Quoted - prose.\n- an item - with a dash\n\n  continued - prose\n"
        + "  that wraps --\n  twice.\n");
    final where = mut [<str>];
    foreach (f in got) { where.append("{f.line}:{f.col} {f.message}"); }
    assert\equal(where, want: [
        "1:5 a spaced hyphen used as a dash",
        "3:10 a spaced hyphen used as a dash",
        "4:8 a spaced hyphen used as a dash",
        "5:18 a spaced hyphen used as a dash",
        "7:5 a spaced hyphen used as a dash",
        "8:10 a spaced hyphen used as a dash",
        "9:11 a spaced hyphen used as a dash",
        "11:13 a spaced hyphen used as a dash",
    ], message: "each dash at its column, a wrapped one included; a double one is the judge's");
}

test "code, list markers and table cells are not dashes" {
    final md = "- item\n  - nested\n1. ordered\n> - quoted item\n\n| a | b |\n| - | --- |\n| x | - |\n\n"
        + "Use `a - b` and `magus run x -- -v`, then\n``a ` - b``.\nA span `magus run test\n-- -run X` wraps, as does `magus run x --\n-v`.\n\n-\n  -\n\n"
        + "```sh\necho a - b\n```\n\n    indented - code — too\n\n- item\n\n      code - in a list\n\n---\nSee a-b, x -y and --flag.\n";
    assert\equal(support\messages(proseFindings("a.md", md: md)), want: [<str>], message: "no dashes");
}

test "arrows and box drawing stay" {
    assert\equal(support\messages(check(support\fixture({"docs/a.md": "# A page\n\nThe key goes a → b.\n\n├── c\n"}))),
        want: [<str>], message: "clean");
}

test "headings are sentence case, with proper nouns, acronyms and identifiers allowed" {
    assert\equal(headingWord("## Charm vs Target: the boundary"), want: "Target", message: "title case");
    assert\equal(headingWord("## What this is NOT"), want: "NOT", message: "shouting");
    assert\equal(headingWord("## FAST PATH: start here"), want: "FAST", message: "a shouted first word");
    assert\equal(headingWord("### The Graph's Figures mode"), want: "Graph", message: "possessive");
    assert\equal(headingWord("## Using Buzz with GitHub Actions and the MCP server"), want: "", message: "allowed");
    assert\equal(headingWord("## Why `Target` stays `pkg.Name` in code"), want: "", message: "code span");
    assert\equal(headingWord("## Calls createLogger from macOS, see MGS1001, MAGUS_* and BENCHMARKS.md"), want: "", message: "identifiers");
    assert\equal(headingWord("## Keep _Emphasis_ lowercase"), want: "Emphasis", message: "emphasis is stripped");
    assert\equal(headingWord("### 3b. Two forms from one body"), want: "", message: "numbered");
    assert\equal(headingWord("### S4: Cold build, parallel"), want: "", message: "labelled");
    assert\equal(headingWord("## Why is it read-only? How do I fix it"), want: "", message: "a second sentence");
    assert\equal(headingWord("## The PATH-shim and CWD-relative paths"), want: "", message: "hyphenated");
    assert\equal(headingWord("## Tier A vs Tier B"), want: "Tier", message: "single letters pass, words do not");
    assert\equal(headingWord("## See [the Guide](guide.md)"), want: "Guide", message: "link text counts");
}

test "headings are read from prose only" {
    final got = proseFindings("a.md", md: "# Title\n\n```md\n## Not A Heading\n```\n\n## A Real One\n");
    assert\equal(support\messages(got), want: ["heading word `Real` is capitalized; headings are sentence case"],
        message: "fenced heading skipped");
    assert\equal(got[0].line, want: 7, message: "line");
}

test "generated Markdown is skipped by .gitattributes, .markdownlintignore and MAGUS.md" {
    final got = check(support\fixture({
        ".gitattributes": "*.md diff=markdown\ndocs/reference/rules/*.md merge=magus linguist-generated\n/MAGUS.md merge=magus linguist-generated\n",
        ".markdownlintignore": "# comment\n**/gen/\ndocs/concepts/spells/\nCHANGELOG.md\nchanges/unreleased/\n",
        "docs/reference/rules/x.md": "## Bad Heading\n",
        "docs/concepts/spells/go.md": "## Bad Heading\n",
        "CHANGELOG.md": "## Bad Heading\n",
        "libs/x/MAGUS.md": "## Bad Heading\n",
        "changes/unreleased/frag.md": "### Added\n\n- One — two.\n",
        "docs/page.md": "## Bad Heading\n",
    }));
    final paths = mut [<str>];
    foreach (f in got) { paths.append(f.path); }
    assert\equal(support\sorted(paths), want: ["changes/unreleased/frag.md", "docs/page.md"], message: "hand-written only");
}

fun row(node: str, line: int, rule: str, decision: str) > {str: any} {
    return {"node": node, "source": "{node}:{line}", "kind": "reference", "rule": rule, "code": "PRS4001",
        "decision": decision, "message": "the judge's message", "match": "x",
        "url": "https://eli.gladman.cc/magus/reference/prose/{rule}/"};
}

test "a denied finding is reported at its path and line with its rule and page; advice is not" {
    final got = judgedFindings([row("docs/a.md", line: 12, rule: "filler", decision: "deny"),
        row("docs/a.md", line: 3, rule: "verdict", decision: "advise")]);
    assert\equal(got.len(), want: 1, message: "the deny alone");
    assert\equal(got[0].path, want: "docs/a.md", message: "workspace path");
    assert\equal(got[0].line, want: 12, message: "line");
    assert\equal(got[0].message, want: "the judge's message [filler]", message: "message and rule");
    assert\equal(got[0].url, want: "https://eli.gladman.cc/magus/reference/prose/filler/", message: "the rule's page");
}

test "the judge runs once over every hand-written file and reports at the file's path" {
    final post = "I think this will probably help.\n";
    final got = check(support\fixture({
        "blog/p.md": "# A post\n\n" + post,
        "docs/page.md": "# A page\n\n" + post,
        "docs/note.md": "# A note\n\nThe cache is simply a map.\n",
    }));
    final where = mut [<str>];
    foreach (f in got) {
        where.append("{f.path}:{f.line} " + f.message.sub(f.message.indexOf("[") ?? 0));
    }
    assert\equal(where, want: ["docs/note.md:3 [filler]", "docs/page.md:3 [tense]", "docs/page.md:3 [hedge]"],
        message: "the table exempts blog/ from tense and hedge");
}

test "a judge that does not run is an error, not a pass" {
    final got = judge(["docs/a.md"], base: "", module: "libs/no-such-module", kind: "reference");
    assert\equal(got.len(), want: 1, message: "one error");
    assert\equal(got[0].path, want: JUDGE, message: "at the judge");
    assert\equal(got[0].message.startsWith("the prose judge did not run"), want: true, message: got[0].message);
    assert\equal(judge([<str>], base: "", module: "libs/no-such-module", kind: "reference").len(), want: 0,
        message: "no file, no run");
}

test "a skill body, a loaded skill, a guide and any other page each take their own kind" {
    assert\equal(kindOf("internal/agent/skills/magus-run/SKILL.md"), want: "agent-instructions-template", message: "a body");
    assert\equal(kindOf(".claude/skills/shepherd-pull-requests/SKILL.md"), want: "agent-instructions", message: "a loaded skill");
    assert\equal(kindOf("internal/agent/agents-section.md"), want: "reference", message: "not a skill");
    assert\equal(kindOf(".claude/skills/x/notes.md"), want: "reference", message: "not a SKILL.md");
    foreach (page in ["docs/guides/integrations/agents/leases.md", "docs/guides/setup.md",
        "docs/guides/setup/linux.md", "docs/guides/migrating/from-nx.md"]) {
        assert\equal(kindOf(page), want: "guide", message: page);
    }
    assert\equal(kindOf("docs/concepts/cache.md"), want: "reference", message: "a concept page");
    assert\equal(kindOf("docs/doctrine.md"), want: "reference", message: "doctrine");
}

test "a guide is held to the guide rules and a concept page is not" {
    final page = "# A page\n\nWe keep it easy.\n\n1. Run `magus init`.\n2. The target builds.\n";
    final got = check(support\fixture({"docs/guides/a.md": page, "docs/concepts/a.md": page}));
    final where = mut [<str>];
    foreach (f in got) {
        where.append("{f.path}:{f.line} " + f.message.sub(f.message.indexOf("[")!));
    }
    assert\equal(where, want: ["docs/guides/a.md:3 [second-person]", "docs/guides/a.md:6 [step-verb]",
        "docs/guides/a.md:3 [condescension]"], message: "guide findings only on the guide");
}

test "a skill's short form is held to the terse rules and its full-only text is not" {
    final got = check(support\fixture({
        "internal/agent/skills/magus-x/SKILL.md": "# X\n\nRun it\{\{if .Full}} in order to replay\{\{else}} in order to warm it\{\{end}}.\n",
        ".claude/skills/y/SKILL.md": "---\nname: y\ndescription: \"Y.\"\n---\n\n# Y\n\nRun it in order to replay.\n",
        "docs/page.md": "# A page\n\nRun it to replay the build from the cache when the inputs match the key it was stored under, "
            + "so a warm tree skips every step it already ran on this machine.\n",
    }));
    final where = mut [<str>];
    foreach (f in got) {
        where.append("{f.path}:{f.line} " + f.message.sub(f.message.indexOf("[")!));
    }
    assert\equal(where, want: [".claude/skills/y/SKILL.md:8 [wordy]", "internal/agent/skills/magus-x/SKILL.md:3 [wordy]"],
        message: "one wordy finding per skill, none on the page");
}

test "ignore globs anchor a slashed entry and float a bare one" {
    assert\equal(ignoreGlobs("node_modules/\n**/gen/\ndocs/reference/buzz/\nCHANGELOG.md\n.claude/\n"),
        want: ["**/node_modules/**", "**/gen/**", "docs/reference/buzz/**", "**/CHANGELOG.md"], message: "globs");
}
