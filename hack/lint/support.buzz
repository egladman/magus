// What the lint rules share: reading a handed-in file, turning a byte offset into a line,
// and writing a fixture tree for a rule's tests. Not a rule itself, so hack/lint/run.buzz
// does not name it.
namespace support;

import "fs";
import "std";
import "magus";
import "serialize";
import "strings";
import "encoding/yaml";
import "magus/lint";

import "assert";

// SCRIPT_DIRS are the hack/ directories whose files a person, an agent or a workflow runs,
// each *.buzz directly inside one. hack/magusfile holds the modules magusfiles import, and
// lint, policy and git-hooks are run through their own entry points.
export final SCRIPT_DIRS = ["hack/dev/", "hack/remote/", "hack/bench/", "hack/ci/"];

// scriptDir is the SCRIPT_DIRS entry p sits directly inside, or "".
export fun scriptDir(p: str) > str {
    foreach (dir in SCRIPT_DIRS) {
        if (p.startsWith(dir) and p.endsWith(".buzz") and p.indexOf("/", from: dir.len()) == null) {
            return dir;
        }
    }
    return "";
}

// read returns the file f names. The runner hands workspace-relative paths with no base;
// a test's fixture carries its temporary directory as the base.
export fun read(f: Path) > str !> any {
    if (f.base == "") {
        return fs\readFile(f.value);
    }
    return fs\readFile(f.base + "/" + f.value);
}

// named returns the handed-in file whose workspace path is p, or null.
export fun named(files: [Path], p: str) > Path? {
    foreach (f in files) {
        if (f.value == p) {
            return f;
        }
    }
    return null;
}

// attributeGlobs are the patterns .gitattributes marks linguist-generated, as globs
// rooted at the workspace.
export fun attributeGlobs(src: str) > [str] {
    final globs = mut [<str>];
    foreach (line in src.split("\n")) {
        final fields = line.trim().split(" ");
        if (fields.len() < 2 or fields[0].startsWith("#") or fields.indexOf("linguist-generated") == null) {
            continue;
        }
        globs.append(rooted(fields[0]));
    }
    return globs;
}

// rooted turns a gitignore-style pattern into a workspace glob: a leading slash, or a
// slash inside the pattern, anchors it at the root; otherwise it matches at any depth.
export fun rooted(p: str) > str {
    if (p.startsWith("/")) {
        return p.sub(1);
    }
    final inner = if (p.endsWith("/")) p.sub(0, len: p.len() - 1) else p;
    if (inner.indexOf("/") != null) {
        return p;
    }
    return "**/" + p;
}

// lineAt returns the 1-based line holding byte offset off of src.
export fun lineAt(src: str, off: int) > int {
    var line = 1;
    var nl = src.indexOf("\n");
    while (nl != null and nl! < off) {
        line = line + 1;
        nl = src.indexOf("\n", from: nl! + 1);
    }
    return line;
}

// findLine returns the line of the first occurrence of needle in src, or 0. A needle may
// lead with newlines to anchor at a line start; the line reported is the one its text
// starts on.
export fun findLine(src: str, needle: str) > int {
    final i = src.indexOf(needle);
    if (i == null) {
        return 0;
    }
    return lineAt(src, off: i! + needle.len() - strings\trimPrefix(needle, prefix: "\n").len());
}

// The workspace reads several rules share, each made once per run.
var graphMemo: TargetGraph? = null;
var projectsMemo: Projects? = null;
var skipCacheMemo: {str: bool}? = null;

// targets is magus\describe.graph(): every target of every project, read statically
// from the magusfiles.
export fun targets() > TargetGraph !> any {
    if (graphMemo == null) {
        graphMemo = magus\describe.graph();
    }
    return graphMemo!;
}

// projects is magus\describe.project(): each project with its resolved source globs.
export fun projects() > Projects !> any {
    if (projectsMemo == null) {
        projectsMemo = magus\describe.project();
    }
    return projectsMemo!;
}

// skipsCache is every target that declares skip_cache, keyed `<project>:<target>`,
// read from each evaluated project's target policies.
export fun skipsCache() > {str: bool} !> any {
    if (skipCacheMemo == null) {
        final acc = mut {<str: bool>};
        foreach (p in magus\describe.evaluatedProject()) {
            foreach (target, policy in p.targetPolicies) {
                if (policy.skip_cache) {
                    acc["{p.path}:{target}"] = true;
                }
            }
        }
        skipCacheMemo = acc;
    }
    return skipCacheMemo!;
}

// scalar is a YAML scalar as its text, the way a workflow's runner reads it: `cache: false`
// is "false" whether YAML typed it a bool or a string. Anything else is "".
export fun scalar(b: serialize\Boxed) > str {
    final s = b.string();
    if (s != null) {
        return s!;
    }
    final flag = b.boolean();
    if (flag != null) {
        return if (flag!) "true" else "false";
    }
    final n = b.integer();
    if (n != null) {
        return "{n!}";
    }
    return "";
}

// has reports whether mapping b carries key, even with a null value.
export fun has(b: serialize\Boxed, key: str) > bool {
    return b.mapValue()[key] != null;
}

// pointer escapes a mapping key into one segment of a yaml\positions key.
export fun pointer(key: str) > str {
    return key.replace("~", with: "~0").replace("/", with: "~1");
}

// magusfilePath is the workspace path of the magusfile declaring project.
export fun magusfilePath(project: str) > str {
    if (project == ".") {
        return "magusfile.buzz";
    }
    return project + "/magusfile.buzz";
}

// sorted returns keys in byte order, so a rule reports in the same order every run.
export fun sorted(keys: [str]) > [str] {
    final copy = mut [<str>];
    foreach (k in keys) {
        copy.append(k);
    }
    return copy.sort(fun (a: str, b: str) > bool => strings\compare(a, b: b) < 0);
}

// Staleness is what a rule reading a symbol index makes of one index's freshness: the
// findings it fails, and whether the rest of the index is current enough to judge.
export object Staleness {
    findings: [Finding],
    judgeable: bool,
}

// staleness judges freshness per changed file. An out-of-date index that lists every source
// changed since it was built fails each of them, so a run scoped to other files passes and
// the rest is judged. One that lists only some, or a missing or unvouched index, fails at
// its project and leaves nothing to judge. judging names what the rule could not judge.
export fun staleness(idx: any, judging: str) > Staleness {
    final freshness: str = idx["freshness"] ?? "";
    if (freshness == "up-to-date") {
        return Staleness{ findings = [<Finding>], judgeable = true };
    }
    final project: str = idx["project"]["path"] ?? ".";
    final lang: str = idx["language"] ?? "";
    final detail: str = idx["detail"] ?? "";
    final rebuild = "Rebuild it with `magus graph build`, then rerun lint.";
    final fix = if (detail != "") detail + "\n" + rebuild else rebuild;
    final changed: [str] = idx["changed"] ?? [<str>];
    final count = std\toInt(idx["changed_count"] ?? 0);
    if (freshness != "out-of-date" or changed.len() == 0 or count > changed.len()) {
        return Staleness{ judgeable = false, findings = [Finding{ path = project,
            message = "the {lang} symbol index of {project} is {freshness}, so its {judging} cannot be judged",
            fix = fix }] };
    }
    final found = mut [<Finding>];
    foreach (file in changed) {
        found.append(Finding{ path = file,
            message = "changed since the {lang} symbol index of {project} was built, so its {judging} cannot be judged",
            fix = fix });
    }
    return Staleness{ findings = found, judgeable = true };
}

// missing is the finding a rule reports for a file it reads that the tree lacks.
export fun missing(p: str) > Finding {
    return Finding{ path = p, message = "cannot read " + p,
        fix = "this rule reads it; restore the file or move the rule with it" };
}

// fixture writes files, each a workspace path and its content, under a new temporary
// directory and returns them as the runner would hand them to a rule.
export fun fixture(files: {str: str}) > [Path] !> any {
    final root = fs\tempDir("lint-");
    final paths = mut [<Path>];
    foreach (p in sorted(files.keys())) {
        final full = root + "/" + p;
        fs\mkdirAll(fs\dirname(full));
        fs\writeFile(full, content: files[p]!);
        paths.append(Path{ value = p, base = root });
    }
    return paths;
}

// messages is each finding's message, which is what most tests compare.
export fun messages(found: [Finding]) > [str] {
    final acc = mut [<str>];
    foreach (f in found) {
        acc.append(f.message);
    }
    return acc;
}

test "lineAt and findLine count from 1 and anchor a leading newline" {
    final src = "a\nb\n  c: 1\n";
    assert\equal(lineAt(src, off: 0), want: 1, message: "first byte");
    assert\equal(lineAt(src, off: 2), want: 2, message: "after a newline");
    assert\equal(findLine(src, needle: "\n  c:"), want: 3, message: "anchored needle");
    assert\equal(findLine(src, needle: "zz"), want: 0, message: "absent");
}

test "scalar reads a YAML scalar as its text" {
    final doc = serialize\Boxed.init(yaml\parse("a: false\nb: x\nc: 3\nd: [1]\n"));
    assert\equal(scalar(doc.q(["a"])), want: "false", message: "bool");
    assert\equal(scalar(doc.q(["b"])), want: "x", message: "string");
    assert\equal(scalar(doc.q(["c"])), want: "3", message: "int");
    assert\equal(scalar(doc.q(["d"])), want: "", message: "list");
    assert\equal(has(doc, key: "a"), want: true, message: "present");
    assert\equal(has(doc, key: "z"), want: false, message: "absent");
    assert\equal(pointer("a/b~c"), want: "a~1b~0c", message: "escaped");
}

test "a stale index fails each changed file it lists and stays judgeable" {
    final fresh = staleness({"project": {"path": "."}, "language": "go", "freshness": "up-to-date"}, judging: "docs");
    assert\equal(fresh.findings.len(), want: 0, message: "current");
    assert\isTrue(fresh.judgeable, message: "current is judged");
    final listed = staleness({"project": {"path": "."}, "language": "go", "freshness": "out-of-date",
        "changed": ["a.go", "b/c.go"], "changed_count": 2.0}, judging: "docs");
    assert\equal(listed.findings.len(), want: 2, message: "one per changed file");
    assert\equal(listed.findings[1].path, want: "b/c.go", message: "at the file");
    assert\isTrue(listed.judgeable, message: "the rest is current");
}

test "a stale index that lists only some changes, or none, fails at its project" {
    final short = staleness({"project": {"path": "libs/x"}, "language": "go", "freshness": "out-of-date",
        "changed": ["libs/x/a.go"], "changed_count": 9.0}, judging: "docs");
    assert\equal(messages(short.findings), want: ["the go symbol index of libs/x is out-of-date, so its docs cannot be judged"], message: "truncated");
    assert\isTrue(!short.judgeable, message: "an unlisted change could be anywhere");
    final missing = staleness({"project": {"path": "libs/x"}, "language": "go", "freshness": "not-indexed"}, judging: "docs");
    assert\equal(missing.findings[0].path, want: "libs/x", message: "at the project");
    assert\isTrue(!missing.judgeable, message: "nothing to judge");
}

test "fixture round-trips through read" {
    final files = fixture({"a/b.lock": "x\n"});
    assert\equal(files[0].value, want: "a/b.lock", message: "workspace path kept");
    assert\equal(read(files[0]), want: "x\n", message: "content");
}
