// typescript-never-throws refuses a `throw`, a `Promise.reject` or a `new Promise` whose
// executor takes a reject, in every hand-written TypeScript file in the repository. A fallible call there returns a Result (gen/magus/types.ts), so its caller has
// to read the failure; an exception unwinds past every caller that forgot to catch it. Code
// that cannot be reached ends `const exhausted: never = value; return exhausted;`, which the
// compiler checks and nothing throws.
//
// No comment excuses a site. Two files hold the whole allowance:
// console/src/lib/unreachable.ts and console/src/lib/rejected.ts.
// A test double takes its rejection from the second.
//
// Tier 2, measured shape: the fix returns a Result, a refactor anyone can do. There is no
// baseline: a file it reads has no violation.
namespace typescriptthrows;

import "assert";
import "std";
import "magus/lint";
import "hack/lint/support" as support;

// UNREACHABLE is the one file whose throw is the sanctioned one: unreachable(x: never) ends a
// branch the type system proves cannot run, and a switch over a closed set calls it
// (hack/lint/closed-switches-name-every-member.buzz).
final UNREACHABLE = "console/src/lib/unreachable.ts";

// REJECTED holds the one sanctioned Promise.reject, for test doubles.
final REJECTED = "console/src/lib/rejected.ts";

// THROW matches the statement, not the word: `throw` followed by what it throws. A keyword list
// in a string ("catch throw true") has no operand after it.
final THROW = std\pattern(`(^|[;{}(\s])throw\s+(new\b|[A-Za-z_$][\w$.]*\s*([;(]|$)|[(\x60"'])`);
final REJECT = std\pattern(`\bPromise\.reject\s*\(`);
final REJECTING = std\pattern(`\bnew\s+Promise\s*(<[^>]*>)?\s*\(\s*(async\s*)?(\(\s*[\w$]+\s*(:[^,)]*)?,|function\s*\(\s*[\w$]+\s*(:[^,)]*)?,)`);

export fun reads() > [str] {
    return ["**/*.ts", "**/*.tsx"];
}

export fun check(files: [Path]) > [Finding] !> any {
    final found = mut [<Finding>];
    foreach (f in files) {
        if (f.value.endsWith(".d.ts") or f.value == UNREACHABLE or f.value == REJECTED) {
            continue;
        }
        final readResult = support\read(f);
        if (readResult.error != null) {
            throw readResult.error!.message;
        }
        judge(f.value, src: readResult.value!, found: found);
    }
    return found;
}

fun isTest(path: str) > bool {
    return path.endsWith(".test.ts") or path.endsWith(".test.tsx");
}

// code drops a line comment, so prose about throwing is not a throw. A `//` inside a string
// (a URL) cuts the line short, which can only hide a throw after it on that line.
fun code(line: str) > str {
    final t = line.trim();
    if (t.startsWith("//") or t.startsWith("*") or t.startsWith("/*")) {
        return "";
    }
    final at = line.indexOf("//");
    if (at -> i) {
        return line.sub(0, len: i);
    }
    return line;
}

fun kind(line: str) > str? {
    if (THROW.match(line) != null) {
        return "a throw";
    }
    if (REJECT.match(line) != null) {
        return "a Promise.reject";
    }
    if (REJECTING.match(line) != null) {
        return "a new Promise that rejects";
    }
    return null;
}

fun judge(path: str, src: str, found: mut [Finding]) > void {
    var n = 0;
    foreach (line in src.split("\n")) {
        n = n + 1;
        if (kind(code(line)) -> k) {
            if (isTest(path)) {
                found.append(Finding{ path = path, line = n,
                    message = "{k} in a test; no comment excuses it",
                    hint = "Assert instead (node:assert fails the test). A double for a failing platform call takes its rejection from rejected(reason) in console/src/lib/rejected.ts." });
            } else {
                found.append(Finding{ path = path, line = n,
                    message = "{k} in hand-written TypeScript; a fallible call here returns a Result",
                    hint = "Return fail(new MagusError(...)) from gen/magus/types, or wrap the call in attempt or fromPromise, and let the caller read it. An unreachable branch ends `const exhausted: never = value; return exhausted;`." });
            }
        }
    }
}

test "a throw, a reject and a rejecting promise in app code are each reported" {
    final src = "export function a(): void \{\n  throw new Error(\"no\");\n}\nconst b = () => Promise.reject(new Error(\"no\"));\nconst c = new Promise<void>((resolve, reject) => reject(1));\nconst d = new Promise((resolve) => resolve(1));\n";
    final got = check(support\fixture({"console/src/lib/a.ts": src}).value!);
    assert\equal(support\messages(got), want: [
        "a throw in hand-written TypeScript; a fallible call here returns a Result",
        "a Promise.reject in hand-written TypeScript; a fallible call here returns a Result",
        "a new Promise that rejects in hand-written TypeScript; a fallible call here returns a Result",
    ], message: "three");
    assert\equal(got[0].line, want: 2, message: "the throw's line");
}

test "prose and strings about throwing pass" {
    final src = "// a caller that throws here unwinds\n  * nothing can throw\nconst words = \"set static this throw true try\";\nconst x = 1; // throw new Error(\"x\")\n";
    assert\equal(check(support\fixture({"console/src/a.ts": src}).value!).len(), want: 0, message: "clean");
}

test "a throw or a reject in a test is reported, whatever comment sits above it" {
    final stub = "platform " + "double: fetch";
    final src = "// " + stub + "\nglobalThis.fetch = () => Promise.reject(new TypeError(\"x\"));\nconst t = () => \{ throw new Error(\"x\"); };\n";
    final got = check(support\fixture({"console/src/a.test.ts": src}).value!);
    assert\equal(got.len(), want: 2, message: "no marker excuses either");
    assert\equal(got[0].line, want: 2, message: "the reject");
    assert\equal(got[1].line, want: 3, message: "the throw");
}

test "the one shared rejection file passes" {
    final src = "export function rejected(reason: unknown): Promise<never> \{\n  return Promise.reject(reason);\n}\n";
    assert\equal(check(support\fixture({"console/src/lib/rejected.ts": src}).value!).len(), want: 0, message: "rejected.ts");
}

test "a throw in the mod's tsx is read with or without a semicolon" {
    final got = check(support\fixture({"docs/guides/integrations/agents/claude-code/mod/hooks/a.tsx": "  throw err\n  throw err;\n"}).value!);
    assert\equal(got.len(), want: 2, message: "with and without a semicolon");
}

test "a throw under a contract comment is reported like any other" {
    final contract = "platform " + "contract: opencode tool.execute.before";
    final src = "// " + contract + "\nthrow new Error(reason);\n";
    assert\equal(check(support\fixture({"docs/guides/integrations/agents/a.ts": src}).value!).len(), want: 1, message: "the throw");
}
