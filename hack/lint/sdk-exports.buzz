// sdk-exports holds the root package, the public SDK, to a committed allow list: every
// exported name and method in api-go.lock needs a line in hack/lint/sdk-exports.jsonl saying
// why it is exported, and a line naming something no longer exported is stale. The SDK is a
// substrate that should shrink, so growing it takes a stated reason.
//
// Tier 3, judgment: whether a new export belongs in the SDK is a person's call.
namespace sdkexports;

import "assert";
import "magus/lint";
import "encoding/json";
import "hack/lint/support" as support;

final LOCK = "internal/commands/testdata/api-go.lock";
final ALLOWED = "hack/lint/sdk-exports.jsonl";
final PREFIX = "github.com/egladman/magus.";

export fun reads() > [str] {
    return [LOCK, ALLOWED];
}

export fun check(files: [Path]) > [Finding] !> any {
    final lock = support\named(files, p: LOCK);
    final allowed = support\named(files, p: ALLOWED);
    if (lock == null or allowed == null) {
        return [Finding{ path = ALLOWED, message = "the allow list or the API lock was not handed in",
            fix = "Restore " + LOCK + " and " + ALLOWED + "." }];
    }
    return judge(exported(support\read(lock!)), allowed: support\read(allowed!));
}

// exported is the root package's top-level names and the methods of its types, as the lock
// spells them: Open, Magus.Run. Fields are the owning type's business.
export fun exported(lock: str) > [str] {
    final names = mut [<str>];
    foreach (line in lock.split("\n")) {
        if (!line.startsWith(PREFIX)) {
            continue;
        }
        final fields = line.split(" ");
        if (fields.len() < 2) {
            continue;
        }
        final name = fields[0].sub(PREFIX.len(), len: fields[0].len() - PREFIX.len());
        if (name.indexOf(".") == null or fields[1].startsWith("method") or fields[1].startsWith("imethod")) {
            names.append(name);
        }
    }
    return names;
}

// reasons is each allow-list line's reason by name; the last line for a name wins.
export fun reasons(src: str) > {str: str} !> any {
    final got = mut {<str: str>};
    foreach (line in src.split("\n")) {
        if (line.trim() == "") {
            continue;
        }
        final doc = json\parse(line);
        final name: str = doc["name"] ?? "";
        final reason: str = doc["reason"] ?? "";
        got[name] = reason;
    }
    return got;
}

// judge is each finding for the exported names against the allow list.
export fun judge(names: [str], allowed: str) > [Finding] !> any {
    final found = mut [<Finding>];
    final have = reasons(allowed);
    final seen = mut {<str: bool>};
    foreach (name in names) {
        seen[name] = true;
        final reason = have[name];
        if (reason == null) {
            found.append(Finding{ path = ALLOWED, message = "the root package exports " + name + ", which the SDK allow list leaves out",
                fix = "Prefer not exporting it. If the SDK needs it, append a line with a name and a reason for " + name + " to " + ALLOWED + "." });
        } else if (reason!.trim() == "") {
            found.append(Finding{ path = ALLOWED, message = "the SDK allow list names " + name + " with no reason",
                fix = "Give " + name + " a one-line reason in " + ALLOWED + "." });
        }
    }
    foreach (name in support\sorted(have.keys())) {
        if (seen[name] == null) {
            found.append(Finding{ path = ALLOWED, message = "the SDK allow list names " + name + ", which the root package no longer exports",
                fix = "Delete its line from " + ALLOWED + "." });
        }
    }
    return found;
}

test "exported keeps top-level names and methods but not fields" {
    final lock = PREFIX + "Open func(ctx) Magus\n" + PREFIX + "Magus type struct\n" + PREFIX + "Magus.Run method(ptr) func()\n" + PREFIX + "Event.Kind field string\n" + "github.com/egladman/magus/types.Other type\n";
    assert\equal(exported(lock), want: ["Open", "Magus", "Magus.Run"], message: "names");
}

fun row(name: str, reason: str) > str !> any {
    return json\stringify({"name": name, "reason": reason}) + "\n";
}

test "a listed name with a reason passes" {
    assert\equal(support\messages(judge(["Open"], allowed: row("Open", reason: "entry point"))), want: [<str>], message: "clean");
}

test "an export absent from the allow list fails and names the remedy" {
    final got = judge(["Magus.ModelRows"], allowed: "");
    assert\equal(got.len(), want: 1, message: "one finding");
    assert\equal(got[0].message, want: "the root package exports Magus.ModelRows, which the SDK allow list leaves out", message: "message");
    assert\equal(got[0].fix.startsWith("Prefer not exporting it."), want: true, message: "remedy");
}

test "a blank reason fails and the last line for a name wins" {
    assert\equal(judge(["Open"], allowed: row("Open", reason: "")).len(), want: 1, message: "blank");
    assert\equal(judge(["Open"], allowed: row("Open", reason: "") + row("Open", reason: "why")).len(), want: 0, message: "last wins");
}

test "an allow-list line for a removed export is stale" {
    assert\equal(support\messages(judge([<str>], allowed: row("Gone", reason: "x"))), want: ["the SDK allow list names Gone, which the root package no longer exports"], message: "stale");
}
