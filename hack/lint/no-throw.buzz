// no-throw: errors are values below the entry. A function returns one value
// carrying its result and its error; only an entry throws. Three constructs
// count per file against the no-throw baseline in the analyzers.yaml of the
// file's own project, whose counts may only fall. A project with no
// analyzers.yaml, or one with no no-throw key, allows none:
//
//	throw                  a TS or JS throw below an entry
//	async-no-result        an exported TS async function that returns no Promise of a Result
//	buzz-error-signature   a Buzz function that declares `!>` and is no entry
//
// The entry kinds, where a throw or a `!>` is allowed:
//
//	TS and JS  module scope; unreachable(x: never); each scope no-throw.exits names (a host hook)
//	Buzz       a script main; an exported magusfile target or spell op shaped
//	           (ctx: magus\Context, args: [str]); an exported lint check(files: [Path])
//
// no-throw.mjs parses TS and JS. Buzz is scanned here by line, and a signature
// split over lines is joined up to its opening brace. gen/ and testdata/ are
// not read. No marker comment waives a site: the only exits are a count or an
// exit a person types into analyzers.yaml, and a count above the real one fails.
//
// Tier 2, measured shape: no file holds more of a construct than its recorded count.
namespace nothrow;

import "assert";
import "proc";
import "result";
import "std";
import "encoding/json";
import "encoding/yaml";
import "magus/lint";
import "hack/lint/support" as support;

final POLICY = "analyzers.yaml";
final CEILING = "no-throw.baseline in its project's " + POLICY;
final PARSER = "hack/lint/no-throw.mjs";

final FIX = "Return an error value; throw only in the top-level entry. "
    + "A count in the " + CEILING + " may only fall.";

final FIX_ASYNC = "Return Promise<Result<T>> (types.Result from gen/magus/types) and let the caller read the failure. "
    + "A count in the " + CEILING + " may only fall.";

final FIX_BUZZ = "Return result\\Result::<T> (import \"result\") and drop `!>`. Only a script main, an exported "
    + "(ctx: magus\\Context, args: [str]) target or an exported lint check(files: [Path]) declares it. "
    + "A count in the " + CEILING + " may only fall.";

fun remedy(construct: str) > str {
    if (construct == "async-no-result") {
        return FIX_ASYNC;
    }
    if (construct == "buzz-error-signature") {
        return FIX_BUZZ;
    }
    return FIX;
}

fun subject(s: Site) > str {
    if (s.construct == "async-no-result") {
        return "exported async {s.scope} returns no Result";
    }
    if (s.construct == "buzz-error-signature") {
        return "`!>` on {s.scope}";
    }
    return "{s.construct} in {s.scope}";
}

// Site is one construct as a scanner reports it. scope is the dotted chain of
// classes and functions around it, outermost first; a Buzz site names its function.
export object Site {
    path: str,
    line: int = 0,
    col: int = 0,
    construct: str = "throw",
    scope: str = "",
    moduleScope: bool = false,
    unreachable: bool = false,
}

// Entry is a scope the host calls as its entry, where a throw is the only
// answer the host reads: one of no-throw.exits. path is the workspace path;
// file is the analyzers.yaml that names it.
export object Entry {
    path: str,
    scope: str,
    reason: str,
    file: str = POLICY,
}

// Ceiling is one count of the no-throw baseline, at its workspace path.
export object Ceiling {
    path: str,
    construct: str,
    count: int,
    file: str = POLICY,
}

// Policy is the no-throw key of one project's analyzers.yaml.
export object Policy {
    ceilings: {str: Ceiling},
    exits: [Entry],
}

export fun reads() > [str] {
    return ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.buzz", "**/" + POLICY, POLICY, PARSER];
}

// owner is the project holding path, as magus resolves one: the deepest
// project root path sits under, or "." for the root project.
export fun owner(path: str, projects: [str]) > str {
    var best = ".";
    foreach (p in projects) {
        if (p != "." and path.startsWith(p + "/") and (best == "." or p.len() > best.len())) {
            best = p;
        }
    }
    return best;
}

// policyFile is the analyzers.yaml at project's root.
export fun policyFile(project: str) > str {
    return if (project == ".") POLICY else project + "/" + POLICY;
}

export fun check(files: [Path]) > [Finding] !> any {
    final projects = mut [<str>];
    final projectsResult = support\projects();
    if (projectsResult.error != null) {
        throw projectsResult.error!.message;
    }
    foreach (p in projectsResult.value!.projects) {
        projects.append(p.path);
    }
    final ceilings = mut {<str: Ceiling>};
    final exits = mut [<Entry>];
    final sources = mut [<Path>];
    final found = mut [<Site>];
    foreach (f in files) {
        if (f.value == POLICY or f.value.endsWith("/" + POLICY)) {
            final project = owner(f.value, projects: projects);
            if (f.value == policyFile(project)) {
                final readResult = support\read(f);
                if (readResult.error != null) {
                    throw readResult.error!.message;
                }
                final rule = yaml\parse(readResult.value!)["no-throw"];
                if (rule != null) {
                    final p = policy(rule, project: project);
                    foreach (k, c in p.ceilings) {
                        ceilings[k] = c;
                    }
                    foreach (e in p.exits) {
                        exits.append(e);
                    }
                }
            }
        } else if (scanned(f.value)) {
            sources.append(f);
        } else if (scannedBuzz(f.value)) {
            final readResult2 = support\read(f);
            if (readResult2.error != null) {
                throw readResult2.error!.message;
            }
            foreach (s in buzzSites(f.value, src: readResult2.value!)) {
                found.append(s);
            }
        }
    }
    final ran = sites(sources);
    if (ran.error != null) {
        throw ran.error!.message;
    }
    foreach (s in ran.value!) {
        found.append(s);
    }
    return judge(found, ceilings: ceilings, entries: exits, projects: projects);
}

// scannedBuzz reports whether the Buzz scan reads p. Generated declarations and
// planted fixtures hold no hand-written entry or helper.
export fun scannedBuzz(p: str) > bool {
    final rooted = "/" + p;
    if (rooted.indexOf("/testdata/") != null or rooted.indexOf("/gen/") != null) {
        return false;
    }
    return p.endsWith(".buzz");
}

// Signature is a named Buzz function's parameter text and whether the function itself,
// not a parameter's function type, declares `!>`.
object Signature {
    name: str,
    params: str,
    errs: bool,
}

// declaration is the text of the named function line `at` opens, from its name to its
// opening brace or `=>`, or null when the line opens none.
fun declaration(lines: [str], at: int) > str? {
    final head = lines[at].trim();
    var start = -1;
    if (head.startsWith("export fun ")) {
        start = 11;
    } else if (head.startsWith("fun ")) {
        start = 4;
    }
    if (start < 0) {
        return null;
    }
    var text = head.sub(start, len: head.len() - start);
    var next = at + 1;
    while (text.indexOf("\{") == null and text.indexOf("=>") == null and next < lines.len() and next < at + 6) {
        text = text + " " + lines[next].trim();
        next = next + 1;
    }
    return text;
}

fun signature(text: str) > Signature? {
    final open = text.indexOf("(");
    if (open == null) {
        return null;
    }
    final paren = open!;
    var depth = 0;
    var close = -1;
    var i = paren;
    while (i < text.len() and close < 0) {
        final ch = text.sub(i, len: 1);
        if (ch == "(") {
            depth = depth + 1;
        } else if (ch == ")") {
            depth = depth - 1;
            if (depth == 0) {
                close = i;
            }
        }
        i = i + 1;
    }
    final name = text.sub(0, len: paren).trim();
    if (close < 0 or name == "" or name.indexOf(" ") != null) {
        return null;
    }
    final rest = text.sub(close + 1, len: text.len() - close - 1);
    var tail = rest;
    if (rest.indexOf("\{") -> b) {
        tail = rest.sub(0, len: b);
    }
    return Signature{ name = name, params = text.sub(paren + 1, len: close - paren - 1).trim(),
        errs = tail.indexOf("!>") != null };
}

// buzzEntry reports whether a Buzz function is an entry: a script main, an exported
// target or op the host calls with a context and the argument vector, or an exported
// lint rule check. Only an entry declares `!>`.
export fun buzzEntry(exported: bool, sig: Signature) > bool {
    if (sig.name == "main") {
        return true;
    }
    if (!exported) {
        return false;
    }
    if (sig.params.startsWith("ctx: magus\\Context, args: [str]")) {
        return true;
    }
    return sig.name == "check" and sig.params.startsWith("files: [Path]");
}

// buzzSites answers each named function in a Buzz file that declares `!>` and is no entry.
export fun buzzSites(path: str, src: str) > [Site] {
    final found = mut [<Site>];
    final lines = src.split("\n");
    var n = 0;
    while (n < lines.len()) {
        final text = declaration(lines, at: n);
        if (text -> t) {
            final sig = signature(t);
            if (sig -> s) {
                if (s.errs and !buzzEntry(lines[n].trim().startsWith("export "), sig: s)) {
                    found.append(Site{ path = path, line = n + 1, col = 1,
                        construct = "buzz-error-signature", scope = s.name });
                }
            }
        }
        n = n + 1;
    }
    return found;
}

// scanned reports whether the parser reads p. testdata plants throws.
export fun scanned(p: str) > bool {
    if (("/" + p).indexOf("/testdata/") != null) {
        return false;
    }
    foreach (ext in [".ts", ".tsx", ".js", ".mjs"]) {
        if (p.endsWith(ext)) {
            return true;
        }
    }
    return false;
}

// sites runs the parser once per base directory the files sit under.
export fun sites(files: [Path]) > result\Result::<[Site]> {
    try {
        final byBase = mut {<str: mut [str]>};
        foreach (f in files) {
            final base = if (f.base == "") "." else f.base;
            if (byBase[base] == null) {
                byBase[base] = mut [<str>];
            }
            byBase[base]!.append(f.value);
        }
        final found = mut [<Site>];
        foreach (base in support\sorted(byBase.keys())) {
            final run = proc\exec("node", args: [PARSER, base],
                opts: proc\ExecOptions{ stdin = byBase[base]!.join("\n"), quiet = true, allowFailure = true });
            if (run.code != 0) {
                throw "{PARSER} exited {run.code}: " + run.stderr.trim();
            }
            foreach (line in run.stdout.split("\n")) {
                if (line != "") {
                    found.append(site(json\parse(line)));
                }
            }
        }
        return result\ok::<[Site]>(found);
    } catch (err: any) {
        return result\caught::<[Site]>(err);
    }
}

fun site(row: {str: any}) > Site {
    return Site{ path = row["path"] ?? "", line = std\toInt(row["line"] ?? 0), col = std\toInt(row["col"] ?? 0),
        construct = row["construct"] ?? "throw", scope = row["scope"] ?? "",
        moduleScope = row["moduleScope"] ?? false, unreachable = row["unreachable"] ?? false };
}

// policy reads the no-throw key of project's analyzers.yaml, as yaml\parse
// answers it: baseline maps a construct to {file: count}, and each exit names a
// path, a scope and a reason. Its paths are relative to project, and policy
// answers them as workspace paths.
export fun policy(rule: any, project: str) > Policy {
    final file = policyFile(project);
    final prefix = if (project == ".") "" else project + "/";
    final acc = mut {<str: Ceiling>};
    if (rule["baseline"] -> baseline) {
        foreach (construct, counts in baseline) {
            foreach (path, count in counts) {
                final at = prefix + path;
                acc[key(at, construct: construct)] = Ceiling{ path = at, construct = construct, count = std\toInt(count), file = file };
            }
        }
    }
    final exits = mut [<Entry>];
    if (rule["exits"] -> rows) {
        foreach (row in rows) {
            exits.append(Entry{ path = prefix + (row["path"] ?? ""), scope = row["scope"] ?? "", reason = row["reason"] ?? "", file = file });
        }
    }
    return Policy{ ceilings = acc, exits = exits };
}

fun key(path: str, construct: str) > str {
    return construct + " " + path;
}

fun entryFor(s: Site, entries: [Entry]) > Entry? {
    foreach (e in entries) {
        if (e.path == s.path and e.scope == s.scope) {
            return e;
        }
    }
    return null;
}

// judge fails each site of a file over its count, a count above what its file
// holds, and an entry no site uses.
export fun judge(sites: [Site], ceilings: {str: Ceiling}, entries: [Entry], projects: [str]) > [Finding] {
    final counted = mut {<str: mut [Site]>};
    final used = mut {<str: bool>};
    foreach (s in sites) {
        final entry = entryFor(s, entries: entries);
        if (entry -> e) {
            used[e.path + " " + e.scope] = true;
            continue;
        }
        if (s.moduleScope or s.unreachable) {
            continue;
        }
        final k = key(s.path, construct: s.construct);
        if (counted[k] == null) {
            counted[k] = mut [<Site>];
        }
        counted[k]!.append(s);
    }

    final found = mut [<Finding>];
    foreach (k in support\sorted(counted.keys())) {
        final held = counted[k]!;
        final allowed = ceilings[k]?.count ?? 0;
        if (held.len() <= allowed) {
            continue;
        }
        foreach (s in held) {
            found.append(Finding{ path = s.path, line = s.line, col = s.col,
                message = "{subject(s)}, below the top-level entry: {s.path} holds {held.len()}, "
                    + "over the {allowed} that the no-throw.baseline of {policyFile(owner(s.path, projects: projects))} allows",
                fix = remedy(s.construct) });
        }
    }
    foreach (k in support\sorted(ceilings.keys())) {
        final c = ceilings[k]!;
        final held = counted[k]?.len() ?? 0;
        if (held < c.count) {
            found.append(Finding{ path = c.file,
                message = "no-throw.baseline.{c.construct} records {c.count} for {c.path}, which holds {held}",
                fix = if (held == 0) "Delete the entry: the count only falls." else "Lower it to {held}: the count only falls." });
        }
    }
    foreach (e in entries) {
        if (e.reason.trim() == "") {
            found.append(Finding{ path = e.file, message = "no-throw.exits names {e.scope} in {e.path} with no reason",
                fix = "Give the exit a reason, or delete it." });
        }
        if (used[e.path + " " + e.scope] == null) {
            found.append(Finding{ path = e.file, message = "no-throw.exits names {e.scope} in {e.path}, and it holds no throw",
                fix = "Delete the exit from no-throw.exits." });
        }
    }
    return found;
}

final HELPER_TS = `export function parse(text: string): number \{
  if (text === "") throw new Error("empty");
  return Number(text);
}
export const load = async (): Promise<void> => \{
  throw new Error("load");
};
class Store \{
  get(key: string): string \{
    throw new Error(key);
  }
}
function unreachable(x: string): never \{
  throw new Error(x);
}
`;

final ENTRY_TS = `const port = Number(process.env.PORT);
if (Number.isNaN(port)) \{
  throw new Error("PORT is not a number");
}
export function unreachable(x: never): never \{
  throw new Error("unreachable: " + String(x));
}
const note = "a throw in a string is not one";
// throw in a comment is not one either
`;

fun lines(found: [Finding]) > [str] {
    final acc = mut [<str>];
    foreach (f in found) {
        acc.append("{f.path}:{f.line} {f.message}");
    }
    return acc;
}

test "a throw at the module's top level or in unreachable(x: never) passes" {
    final files = support\fixture({"entry.ts": ENTRY_TS}).value!;
    assert\equal(lines(judge(sites(files).value!, ceilings: {<str: Ceiling>}, entries: [<Entry>], projects: ["."])), want: [<str>],
        message: "entry throws");
}

test "a throw in a function, an arrow, a method or a mistyped unreachable fails" {
    final files = support\fixture({"helper.ts": HELPER_TS}).value!;
    final over = ", below the top-level entry: helper.ts holds 4, over the 0 that the no-throw.baseline of analyzers.yaml allows";
    assert\equal(lines(judge(sites(files).value!, ceilings: {<str: Ceiling>}, entries: [<Entry>], projects: ["."])), want: [
        "helper.ts:5 exported async load returns no Result, below the top-level entry: helper.ts holds 1, "
            + "over the 0 that the no-throw.baseline of analyzers.yaml allows",
        "helper.ts:2 throw in parse" + over,
        "helper.ts:6 throw in load" + over,
        "helper.ts:10 throw in Store.get" + over,
        "helper.ts:14 throw in unreachable" + over,
    ], message: "helper throws");
}

test "tsx and mjs parse as their own kinds" {
    final files = support\fixture({"a.tsx": `export const A = () => \{ if (!ok) throw new Error("x"); return <div />; };`,
        "b.mjs": `export function b() \{ throw new Error("b"); }`}).value!;
    assert\equal(sites(files).value!.len(), want: 2, message: "one throw each");
}

test "a file at its count passes, over it fails, and a count above the file fails" {
    final helper = Site{ path = "a.ts", line = 3, scope = "f" };
    final at = policy(yaml\parse("baseline:\n  throw:\n    a.ts: 1\n"), project: ".").ceilings;
    final over = "a.ts:3 throw in f, below the top-level entry: a.ts holds 2, over the 1 that the no-throw.baseline of analyzers.yaml allows";
    assert\equal(lines(judge([helper], ceilings: at, entries: [<Entry>], projects: ["."])), want: [<str>], message: "at its count");
    assert\equal(lines(judge([helper, helper], ceilings: at, entries: [<Entry>], projects: ["."])), want: [over, over], message: "over it");
    assert\equal(lines(judge([<Site>], ceilings: at, entries: [<Entry>], projects: ["."])),
        want: ["analyzers.yaml:0 no-throw.baseline.throw records 1 for a.ts, which holds 0"], message: "a stale count");
}

test "a named exit passes, an exit with no throw fails, and an exit needs a reason" {
    final exits = policy(yaml\parse("exits:\n  - path: plugin.ts\n    scope: Plugin.apply\n    reason: the host reads a throw\n"), project: ".").exits;
    final s = Site{ path = "plugin.ts", line = 9, scope = "Plugin.apply" };
    assert\equal(lines(judge([s], ceilings: {<str: Ceiling>}, entries: exits, projects: ["."])), want: [<str>], message: "used");
    assert\equal(lines(judge([<Site>], ceilings: {<str: Ceiling>}, entries: exits, projects: ["."])),
        want: ["analyzers.yaml:0 no-throw.exits names Plugin.apply in plugin.ts, and it holds no throw"],
        message: "unused");
    final bare = Entry{ path = "plugin.ts", scope = "Plugin.apply", reason = "" };
    assert\equal(lines(judge([s], ceilings: {<str: Ceiling>}, entries: [bare], projects: ["."])),
        want: ["analyzers.yaml:0 no-throw.exits names Plugin.apply in plugin.ts with no reason"],
        message: "no reason");
}

test "a project's analyzers.yaml counts its own files and no other project's" {
    final projects = [".", "libs/a"];
    final at = policy(yaml\parse("baseline:\n  throw:\n    x.ts: 1\n"), project: "libs/a").ceilings;
    final inside = Site{ path = "libs/a/x.ts", line = 2, scope = "f" };
    final outside = Site{ path = "x.ts", line = 2, scope = "f" };
    assert\equal(lines(judge([inside], ceilings: at, entries: [<Entry>], projects: projects)), want: [<str>], message: "its own file");
    assert\equal(lines(judge([outside, inside], ceilings: at, entries: [<Entry>], projects: projects)),
        want: ["x.ts:2 throw in f, below the top-level entry: x.ts holds 1, over the 0 that the no-throw.baseline of analyzers.yaml allows"],
        message: "the root project's file has no count of its own");
    assert\equal(lines(judge([<Site>], ceilings: at, entries: [<Entry>], projects: projects)),
        want: ["libs/a/analyzers.yaml:0 no-throw.baseline.throw records 1 for libs/a/x.ts, which holds 0"], message: "stale in its project");
    assert\equal(owner("libs/a/b/c.ts", projects: projects), want: "libs/a", message: "owner");
    assert\equal(policyFile("."), want: "analyzers.yaml", message: "root file");
}

final BUZZ_SRC = "fun helper(path: str) > str !> any \{\n"
    + "    return path;\n"
    + "}\n"
    + "export fun target(ctx: magus\\Context, args: [str]) > void !> any \{}\n"
    + "fun inner(ctx: magus\\Context, args: [str]) > void !> any \{}\n"
    + "export fun check(files: [Path]) > [Finding] !> any \{\n"
    + "    return [<Finding>];\n"
    + "}\n"
    + "fun main(args: [str]) > void !> any \{}\n"
    + "export fun pure(n: int) > int \{\n"
    + "    return n;\n"
    + "}\n"
    + "fun takes(run: fun (n: int) > void !> any) > void \{}\n"
    + "fun split(\n"
    + "    a: int,\n"
    + "    b: int\n"
    + ") > int !> str \{\n"
    + "    return a;\n"
    + "}\n";

test "a Buzz function declaring !> fails unless it is an entry" {
    final names = mut [<str>];
    foreach (s in buzzSites("a.buzz", src: BUZZ_SRC)) {
        names.append("{s.scope}:{s.line}");
    }
    assert\equal(names, want: ["helper:1", "inner:5", "split:14"], message: "non-entries with !>");
}

test "generated and planted Buzz is not read" {
    assert\equal(scannedBuzz("internal/spell/gen/decls/fs.buzz"), want: false, message: "gen");
    assert\equal(scannedBuzz("x/testdata/a.buzz"), want: false, message: "testdata");
    assert\equal(scannedBuzz("hack/lint/a.buzz"), want: true, message: "hand-written");
}

test "an exported async function with no Result return is counted" {
    final src = "type Read = Result<number>;\nexport async function a(): Promise<Result<number>> \{ return x; }\nexport async function b(): Promise<Read> \{ return x; }\nexport async function c(): Promise<void> \{}\nexport const d = async () => 1;\nasync function e() \{}\n";
    final got = lines(judge(sites(support\fixture({"a.ts": src}).value!).value!, ceilings: {<str: Ceiling>}, entries: [<Entry>], projects: ["."]));
    final over = " returns no Result, below the top-level entry: a.ts holds 2, over the 0 that the no-throw.baseline of analyzers.yaml allows";
    assert\equal(got, want: ["a.ts:4 exported async c" + over, "a.ts:5 exported async d" + over], message: "async sites");
}
