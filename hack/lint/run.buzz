// This repository's file linter: the conventions on its non-Go files that no compiler or
// off-the-shelf linter checks. The root lint-rules target runs it:
//
//	magus buzz hack/lint/run.buzz
//
// A person narrows a run to the files they touched or to one rule:
//
//	magus buzz hack/lint/run.buzz -- <path>...       the findings at these files
//	magus buzz hack/lint/run.buzz -- --rule <name>   one rule over the whole tree
//
// Each rule is a file hack/lint/<rule>.buzz exporting reads(), the globs it reads, and
// check(files), which returns a Finding per violation. The runner walks the tree once,
// hands each rule the files its globs match, prints every finding as
// `path:line:col: message [rule]` with the fix indented under it, and exits 1 when there
// is any. A glob that matches nothing is itself a finding: a rule reading a file the tree
// no longer has is misconfigured, not clean.
namespace lint;

import "assert";
import "flags";
import "fs";
import "os";
import "path";
import "std";
import "magus/lint";
import "hack/lint/support" as support;
import "hack/lint/buzz-glue-is-wired-as-plain-argv" as buzzglue;
import "hack/lint/cd-runs-agree-across-workflows" as cdruns;
import "hack/lint/code-follows-mined-precedents" as precedents;
import "hack/lint/figure-modules-type-check-strictly" as figurecheck;
import "hack/lint/generate-drift-throw-names-the-engine-drift-code" as generatedrift;
import "hack/lint/hack-scripts-parse-argv-with-flags" as scriptflags;
import "hack/lint/hack-scripts-start-with-a-verb" as hackverbs;
import "hack/lint/landing-rotator-slots-match-headline-count" as landing;
import "hack/lint/lockfiles-are-sorted" as lockfiles;
import "hack/lint/magusfile-modules-have-no-main" as magusfilemodules;
import "hack/lint/magusfiles-hold-no-tests" as magusfiletests;
import "hack/lint/markdown-carries-no-mermaid" as nomermaid;
import "hack/lint/markdown-prose" as markdownprose;
import "hack/lint/package-install-targets-never-replay" as installs;
import "hack/lint/package-manifests-carry-no-scripts" as manifestscripts;
import "hack/lint/provider-io-is-buzz" as providerio;
import "hack/lint/prose-names-targets-that-exist" as prosetargets;
import "hack/lint/published-magus-is-built-first-and-verified-by-digest" as publishedmagus;
import "hack/lint/root-project-declares-the-configs-its-tools-read" as rootconfigs;
import "hack/lint/setup-magus-mints-the-queue-app-token-only-as-an-output" as queuetoken;
import "hack/lint/skills-generate-declares-every-shipped-skill" as skills;
import "hack/lint/testlayout-pairing-has-no-exemptions" as testpairing;
import "hack/lint/trusted-jobs-restore-no-actions-cache" as trustedcache;
import "hack/lint/whole-tree-targets-key-on-the-go-tree" as wholetree;

export object Rule {
    name: str,
    reads: [str],
    check: fun (files: [Path]) > [Finding] !> any,
}

// rules is every rule that runs. A rule file nothing names here never runs.
export fun rules() > [Rule] {
    return [
        Rule{ name = "lockfiles-are-sorted", reads = lockfiles\reads(), check = lockfiles\check },
        Rule{ name = "trusted-jobs-restore-no-actions-cache", reads = trustedcache\reads(), check = trustedcache\check },
        Rule{ name = "cd-runs-agree-across-workflows", reads = cdruns\reads(), check = cdruns\check },
        Rule{ name = "setup-magus-mints-the-queue-app-token-only-as-an-output", reads = queuetoken\reads(), check = queuetoken\check },
        Rule{ name = "published-magus-is-built-first-and-verified-by-digest", reads = publishedmagus\reads(), check = publishedmagus\check },
        Rule{ name = "package-install-targets-never-replay", reads = installs\reads(), check = installs\check },
        Rule{ name = "package-manifests-carry-no-scripts", reads = manifestscripts\reads(), check = manifestscripts\check },
        Rule{ name = "whole-tree-targets-key-on-the-go-tree", reads = wholetree\reads(), check = wholetree\check },
        Rule{ name = "root-project-declares-the-configs-its-tools-read", reads = rootconfigs\reads(), check = rootconfigs\check },
        Rule{ name = "skills-generate-declares-every-shipped-skill", reads = skills\reads(), check = skills\check },
        Rule{ name = "generate-drift-throw-names-the-engine-drift-code", reads = generatedrift\reads(), check = generatedrift\check },
        Rule{ name = "landing-rotator-slots-match-headline-count", reads = landing\reads(), check = landing\check },
        Rule{ name = "buzz-glue-is-wired-as-plain-argv", reads = buzzglue\reads(), check = buzzglue\check },
        Rule{ name = "magusfiles-hold-no-tests", reads = magusfiletests\reads(), check = magusfiletests\check },
        Rule{ name = "markdown-carries-no-mermaid", reads = nomermaid\reads(), check = nomermaid\check },
        Rule{ name = "markdown-prose", reads = markdownprose\reads(), check = markdownprose\check },
        Rule{ name = "provider-io-is-buzz", reads = providerio\reads(), check = providerio\check },
        Rule{ name = "hack-scripts-start-with-a-verb", reads = hackverbs\reads(), check = hackverbs\check },
        Rule{ name = "hack-scripts-parse-argv-with-flags", reads = scriptflags\reads(), check = scriptflags\check },
        Rule{ name = "magusfile-modules-have-no-main", reads = magusfilemodules\reads(), check = magusfilemodules\check },
        Rule{ name = "figure-modules-type-check-strictly", reads = figurecheck\reads(), check = figurecheck\check },
        Rule{ name = "testlayout-pairing-has-no-exemptions", reads = testpairing\reads(), check = testpairing\check },
        Rule{ name = "prose-names-targets-that-exist", reads = prosetargets\reads(), check = prosetargets\check },
        Rule{ name = "code-follows-mined-precedents", reads = precedents\reads(), check = precedents\check },
    ];
}

// PRUNED are the directories the walk never enters: VCS metadata, local state, installed
// dependencies and generated output hold nothing this repository authors.
final PRUNED = {".git": true, ".magus": true, "node_modules": true, "gen": true};

// PRUNED_PATHS are pruned by their whole path: other checkouts of this repository, whose
// files would each be reported twice.
final PRUNED_PATHS = {".claude/worktrees": true};

// KEPT_PATHS are generated trees walked despite PRUNED, because a rule reads them: the
// figures import their observed halves.
final KEPT_PATHS = {"docs/site/diagrams/gen": true};

// walk returns every file under root outside the pruned trees, as root-relative paths.
export fun walk(root: str) > [str] !> any {
    final acc = mut [<str>];
    walkInto(root, rel: "", acc: acc);
    return acc;
}

fun walkInto(root: str, rel: str, acc: mut [str]) > void !> any {
    final dir = if (rel == "") root else root + "/" + rel;
    foreach (name in fs\listDir(dir)) {
        final p = if (rel == "") name else rel + "/" + name;
        if (!fs\isDir(root + "/" + p)) {
            acc.append(p);
        } else if ((PRUNED[name] == null or KEPT_PATHS[p] != null) and PRUNED_PATHS[p] == null) {
            walkInto(root, rel: p, acc: acc);
        }
    }
}

// select returns the files each of reads matches, and the globs matching none.
export fun select(files: [str], reads: [str]) > obj{ matched: [Path], unmatched: [str] } !> any {
    final matched = mut [<Path>];
    final unmatched = mut [<str>];
    foreach (glob in reads) {
        var hit = false;
        foreach (f in files) {
            if (path\matches(glob, path: f)) {
                hit = true;
                break;
            }
        }
        if (!hit) {
            unmatched.append(glob);
        }
    }
    foreach (f in files) {
        if (path\matchesAny(reads, path: f)) {
            matched.append(Path{ value = f });
        }
    }
    return .{ matched = matched, unmatched = unmatched };
}

// run applies each rule to the files it reads and returns every finding, stamped with
// its rule.
export fun run(rules: [Rule], files: [str]) > [Finding] !> any {
    final found = mut [<Finding>];
    foreach (r in rules) {
        final sel = select(files, reads: r.reads);
        foreach (glob in sel.unmatched) {
            found.append(Finding{ path = "hack/lint/" + r.name + ".buzz", rule = r.name,
                message = "reads " + glob + ", which matches no file in the tree",
                fix = "Restore the file, or update the rule's reads() to what it reads now." });
        }
        if (sel.unmatched.len() > 0) {
            continue;
        }
        foreach (f in r.check(sel.matched)) {
            found.append(Finding{ path = f.path, line = f.line, col = f.col, rule = r.name,
                message = f.message, fix = f.fix, url = f.url });
        }
    }
    return found;
}

// FOOTPRINT names the runner's own check: lint-rules keys on exactly what the rules read.
export final FOOTPRINT = "lint-rules-keys-on-what-the-rules-read";

// SOURCES are the linter's own files, which lint-rules keys on beside what the rules read.
export final SOURCES = ["hack/lint/*.buzz"];

// claims reports whether a readsFiles glob of the root project keys rel. It mirrors
// types.GlobClaims: a file inside a nested project is that project's, so only a glob
// rooted at or inside that project reaches it, and `**/*.lock` stops at docs/.
export fun claims(glob: str, rel: str, nested: [str]) > bool !> any {
    if (!path\matches(glob, path: rel)) {
        return false;
    }
    var owner = "";
    foreach (d in nested) {
        if (d.len() > owner.len() and rel.startsWith(d + "/")) {
            owner = d;
        }
    }
    if (owner == "") {
        return true;
    }
    var base = glob;
    final wild = std\pattern(`[*?\[\{]`).match(glob);
    if (wild != null) {
        final head = glob.sub(0, len: glob.indexOf(wild![0])!);
        final slash = head.split("/");
        base = slash.sub(0, len: slash.len() - 1).join("/");
    }
    return base == owner or base.startsWith(owner + "/");
}

// footprintFindings holds lint-rules's declared readsFiles to read, every file a rule
// was handed plus the linter's own sources: each is keyed, and each glob keys one.
// nested are the workspace's projects other than the root.
export fun footprintFindings(read: [str], declared: [str], nested: [str], line: int) > [Finding] !> any {
    final found = mut [<Finding>];
    foreach (rel in read) {
        var keyed = false;
        foreach (glob in declared) {
            keyed = keyed or claims(glob, rel: rel, nested: nested);
        }
        if (!keyed) {
            found.append(Finding{ path = "magusfile.buzz", line = line, rule = FOOTPRINT,
                message = "lint-rules reads " + rel + " but its ctx.readsFiles does not key it",
                fix = "Declare it in lint_rules, or an edit to it replays a verdict computed without it.\n"
                    + "A glob rooted above a nested project does not reach into it: name the project's path." });
        }
    }
    foreach (glob in declared) {
        var keys = false;
        foreach (rel in read) {
            keys = keys or claims(glob, rel: rel, nested: nested);
        }
        if (!keys) {
            found.append(Finding{ path = "magusfile.buzz", line = line, rule = FOOTPRINT,
                message = "lint-rules declares " + glob + ", which keys no file a rule reads",
                fix = "Drop it from lint_rules's ctx.readsFiles, or point it at what a rule reads now." });
        }
    }
    return found;
}

// footprint runs footprintFindings against the tree: the files rules reads, the root's
// lint-rules declaration and the workspace's nested projects.
fun footprint(rules: [Rule], files: [str]) > [Finding] !> any {
    final seen = mut {<str: bool>};
    final read = mut [<str>];
    final globs = mut [<str>];
    foreach (glob in SOURCES) {
        globs.append(glob);
    }
    foreach (r in rules) {
        foreach (glob in r.reads) {
            globs.append(glob);
        }
    }
    foreach (f in files) {
        if (seen[f] == null and path\matchesAny(globs, path: f)) {
            seen[f] = true;
            read.append(f);
        }
    }
    final nested = mut [<str>];
    foreach (p in support\projects().projects) {
        if (p.path != ".") {
            nested.append(p.path);
        }
    }
    var declared: [str]? = null;
    foreach (p in support\targets().projects) {
        foreach (n in p.nodes) {
            if (p.path == "." and n.name == "lint-rules") {
                final acc = mut [<str>];
                foreach (ref in n.readsFiles) {
                    acc.append(ref.glob);
                }
                declared = acc;
            }
        }
    }
    if (declared == null) {
        return [Finding{ path = "magusfile.buzz", rule = FOOTPRINT, message = "declares no lint-rules target",
            fix = "hack/lint/run.buzz is what lint-rules runs; update this check if the target was renamed." }];
    }
    final line = support\findLine(fs\readFile("magusfile.buzz"), needle: "export fun lint_rules(");
    return footprintFindings(read, declared: declared!, nested: nested, line: line);
}

// render is a finding as the runner prints it.
export fun render(f: Finding) > str {
    var pos = f.path;
    if (f.line > 0) {
        pos = pos + ":{f.line}";
        if (f.col > 0) {
            pos = pos + ":{f.col}";
        }
    }
    var s = pos + ": " + f.message + " [" + f.rule + "]";
    if (f.fix != "") {
        s = s + "\n    " + f.fix.replace("\n", with: "\n    ");
    }
    if (f.url != "") {
        s = s + "\n    see: " + f.url;
    }
    return s;
}

final usage = "usage: magus buzz hack/lint/run.buzz [-- [--rule <name>] [<path>...]]\n"
    + "  bare            every rule over the whole tree\n"
    + "  <path>...       only the findings at these files, from the rules that read them\n"
    + "  --rule <name>   only that rule";

// Selection is what a run lints: the rule it names, or every rule when rule is null, and
// the findings at paths, or every finding when paths is empty.
export object Selection {
    rule: str?,
    paths: [str],
}

// parse reads --rule and the paths, refusing any other flag and a rule not in names. A
// path after `--` may start with a dash.
export fun parse(args: [str], names: [str]) > Selection !> any {
    final parsed = flags\parse(args, switches: [<str>], valued: ["--rule"]);
    final paths = mut [<str>];
    foreach (word in parsed.unknown) {
        if (word.startsWith("-")) {
            throw "lint: unknown flag {word}\n{usage}";
        }
        paths.append(word);
    }
    foreach (word in parsed.positionals) {
        paths.append(word);
    }
    // walk yields paths with no ./ prefix, and at() compares against them.
    final clean = mut [<str>];
    foreach (p in paths) {
        if (p.startsWith("./")) {
            clean.append(p.sub(2, len: p.len() - 2));
        } else {
            clean.append(p);
        }
    }
    final rule = parsed.values["--rule"];
    if (rule != null) {
        var known = false;
        foreach (n in names) {
            known = known or n == rule!;
        }
        if (!known) {
            throw "lint: no rule is named \"{rule!}\"; the rules are:\n  " + names.join("\n  ");
        }
    }
    return Selection{ rule = rule, paths = clean };
}

// pick returns the rules sel runs: the one it names, or all, less those reading none of
// its paths.
export fun pick(all: [Rule], sel: Selection) > [Rule] !> any {
    final picked = mut [<Rule>];
    foreach (r in all) {
        if (sel.rule != null and r.name != sel.rule!) {
            continue;
        }
        var reads = sel.paths.len() == 0;
        foreach (p in sel.paths) {
            reads = reads or path\matchesAny(r.reads, path: p);
        }
        if (reads) {
            picked.append(r);
        }
    }
    return picked;
}

// at keeps the findings located at one of paths, or every finding when paths is empty.
export fun at(found: [Finding], paths: [str]) > [Finding] {
    if (paths.len() == 0) {
        return found;
    }
    final kept = mut [<Finding>];
    foreach (f in found) {
        var named = false;
        foreach (p in paths) {
            named = named or f.path == p;
        }
        if (named) {
            kept.append(f);
        }
    }
    return kept;
}

// Report is a run's findings and how many rules produced them.
export object Report {
    rules: int,
    findings: [Finding],
}

// check lints the tree under the working directory as sel says. A picked rule still reads
// every file it declares, since some rules relate several files and a subset would judge
// half a relation. The footprint check runs only with no --rule, and only when its
// findings, which sit at magusfile.buzz, could be reported.
export fun check(sel: Selection) > Report !> any {
    final all = rules();
    final picked = pick(all, sel: sel);
    final files = walk(".");
    var found = run(picked, files: files);
    var magusfile = sel.paths.len() == 0;
    foreach (p in sel.paths) {
        magusfile = magusfile or p == "magusfile.buzz";
    }
    if (sel.rule == null and magusfile) {
        found = found + footprint(all, files: files);
    }
    return Report{ rules = picked.len(), findings = at(found, paths: sel.paths) };
}

export fun main(args: [str]) > void !> any {
    final names = mut [<str>];
    foreach (r in rules()) {
        names.append(r.name);
    }
    final sel = parse(args, names: names);
    final report = check(sel);
    foreach (f in report.findings) {
        std\print(render(f));
    }
    if (report.findings.len() > 0) {
        std\print("lint: {report.findings.len()} finding(s)");
        os\exit(1);
    }
    if (report.rules == 0) {
        std\print("lint: no rule reads " + sel.paths.join(" "));
        return;
    }
    std\print("lint: {report.rules} rules, no findings");
}

// refusal is the message parse throws for args, or "" when it accepts them.
fun refusal(args: [str]) > str {
    try {
        parse(args, names: ["a", "b"]);
    } catch (e) {
        return "{e}";
    }
    return "";
}

test "a bare run selects every rule over the whole tree" {
    final sel = parse([<str>], names: ["a"]);
    assert\equal(sel.rule, want: null, message: "no rule");
    assert\equal(sel.paths.len(), want: 0, message: "no paths");
}

test "paths and --rule parse in any order, and a dashed path follows --" {
    final sel = parse(["./x.lock", "--rule", "b", "docs/y.lock", "--", "-odd.lock"], names: ["a", "b"]);
    assert\equal(sel.rule!, want: "b", message: "rule");
    assert\equal(sel.paths, want: ["x.lock", "docs/y.lock", "-odd.lock"], message: "paths, ./ dropped");
}

test "an unknown flag and an unknown rule are refused" {
    assert\equal(refusal(["--fix"]), want: "lint: unknown flag --fix\n" + usage, message: "flag");
    assert\equal(refusal(["--rule", "c"]), want: "lint: no rule is named \"c\"; the rules are:\n  a\n  b", message: "rule");
    assert\equal(refusal(["--rule", ""]), want: "lint: no rule is named \"\"; the rules are:\n  a\n  b", message: "empty rule");
    assert\isTrue(refusal(["--rule"]) != "", message: "--rule with no value");
}

test "paths pick the rules that read them, and a path no rule reads picks none" {
    final none = fun (files: [Path]) > [Finding] !> any => [<Finding>];
    final all = [
        Rule{ name = "locks", reads = ["**/*.lock"], check = none },
        Rule{ name = "workflows", reads = [".github/workflows/*.yaml"], check = none },
    ];
    assert\equal(pick(all, sel: Selection{ rule = null, paths = [<str>] }).len(), want: 2, message: "bare");
    final locks = pick(all, sel: Selection{ rule = null, paths = ["docs/a.lock"] });
    assert\equal(locks.len(), want: 1, message: "one rule reads it");
    assert\equal(locks[0].name, want: "locks", message: "the lockfile rule");
    assert\equal(pick(all, sel: Selection{ rule = null, paths = ["README.md"] }).len(), want: 0, message: "no rule reads it");
    assert\equal(pick(all, sel: Selection{ rule = "workflows", paths = [<str>] })[0].name, want: "workflows", message: "--rule");
    assert\equal(pick(all, sel: Selection{ rule = "workflows", paths = ["a.lock"] }).len(), want: 0, message: "--rule and a path it does not read");
}

test "with paths, only the findings at them are reported" {
    final found = [Finding{ path = "a.lock", message = "m" }, Finding{ path = "b.lock", message = "m" }];
    assert\equal(at(found, paths: [<str>]).len(), want: 2, message: "bare keeps all");
    final kept = at(found, paths: ["b.lock", "c.lock"]);
    assert\equal(kept.len(), want: 1, message: "one named");
    assert\equal(kept[0].path, want: "b.lock", message: "the named file");
}

test "render names the position, message, rule and indented fix" {
    assert\equal(render(Finding{ path = "a.lock", line = 3, rule = "r", message = "b follows c", fix = "Move it.\nSecond line." }),
        want: "a.lock:3: b follows c [r]\n    Move it.\n    Second line.", message: "full");
    assert\equal(render(Finding{ path = "a.lock", line = 3, col = 7, rule = "r", message = "m" }), want: "a.lock:3:7: m [r]", message: "column");
    assert\equal(render(Finding{ path = "a.lock", rule = "r", message = "gone" }), want: "a.lock: gone [r]", message: "no line");
}

test "every finding is stamped with the rule that found it" {
    final rule = Rule{ name = "always", reads = ["*.lock"],
        check = fun (files: [Path]) > [Finding] !> any => [Finding{ path = files[0].value, message = "m" }] };
    final got = run([rule], files: ["x.lock", "y.txt"]);
    assert\equal(got.len(), want: 1, message: "one finding");
    assert\equal(got[0].rule, want: "always", message: "stamped");
    assert\equal(got[0].path, want: "x.lock", message: "the matched file");
}

test "a glob that matches nothing is a finding, and its rule does not run" {
    final rule = Rule{ name = "absent", reads = ["x.lock", "gone.json"],
        check = fun (files: [Path]) > [Finding] !> any => [Finding{ message = "ran" }] };
    assert\equal(run([rule], files: ["x.lock"]).len(), want: 1, message: "only the unmatched glob");
    assert\equal(run([rule], files: ["x.lock"])[0].message, want: "reads gone.json, which matches no file in the tree", message: "message");
}

test "a glob keys a nested project's file only when rooted inside it" {
    final nested = ["docs", "docs/agents", "libs/gopherbuzz"];
    assert\equal(claims("**/*.lock", rel: "benchmarks/v.lock", nested: nested), want: true, message: "root file");
    assert\equal(claims("**/*.lock", rel: "docs/a.lock", nested: nested), want: false, message: "tree glob stops at docs");
    assert\equal(claims("docs/**/*.lock", rel: "docs/a.lock", nested: nested), want: true, message: "rooted in docs");
    assert\equal(claims("docs/**/magusfile.buzz", rel: "docs/agents/magusfile.buzz", nested: nested), want: false, message: "stops at a grandchild");
    assert\equal(claims("docs/agents/magusfile.buzz", rel: "docs/agents/magusfile.buzz", nested: nested), want: true, message: "literal");
    assert\equal(claims("libs/*/magusfile.buzz", rel: "libs/gopherbuzz/magusfile.buzz", nested: nested), want: false, message: "wildcard above the project");
}

test "lint-rules keys exactly what the rules read" {
    final nested = ["docs"];
    assert\equal(footprintFindings(["a.lock", "docs/b.lock"], declared: ["**/*.lock", "docs/**/*.lock"], nested: nested, line: 1).len(),
        want: 0, message: "exact");
    assert\equal(support\messages(footprintFindings(["a.lock", "docs/b.lock"], declared: ["**/*.lock", "console/*.lock"], nested: nested, line: 1)), want: [
        "lint-rules reads docs/b.lock but its ctx.readsFiles does not key it",
        "lint-rules declares console/*.lock, which keys no file a rule reads",
    ], message: "unkeyed and stale");
}

test "the walk prunes what no rule reads" {
    final root = fs\tempDir("lint-walk-");
    foreach (p in ["a.lock", "gen/b.lock", "x/node_modules/c.lock", ".claude/worktrees/w/d.lock", ".claude/settings.json",
                   "docs/site/diagrams/gen/e.buzz"]) {
        fs\mkdirAll(fs\dirname(root + "/" + p));
        fs\writeFile(root + "/" + p, content: "");
    }
    final got = walk(root);
    assert\equal(got.len(), want: 3, message: "three files survive");
    assert\contains(got, item: "a.lock", message: "top level");
    assert\contains(got, item: ".claude/settings.json", message: ".claude outside worktrees");
    assert\contains(got, item: "docs/site/diagrams/gen/e.buzz", message: "a gen tree a rule reads");
}
