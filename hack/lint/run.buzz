// run holds this repository's footprint check: the conventions target keys exactly the
// files its analyzers read. analyzers.buzz lists it beside the rules; it is no entry.
namespace lint;

import "assert";
import "fs";
import "path";
import "result";
import "std";
import "magus/lint";
// Aliased, as a plain file import merges the library's Finding over magus/lint's.
import "libs/analyzer/analyzer" as analyzer;
import "libs/analyzer/runner" as runner;
import "hack/lint/support" as support;

// FOOTPRINT names the check: conventions keys on exactly what the rules read.
export final FOOTPRINT = "conventions-keys-on-what-the-rules-read";

// SOURCES are the linter's own files, which conventions keys on beside what the rules
// read.
export final SOURCES = ["hack/lint/*.buzz", "analyzers.buzz", "libs/analyzer/*.buzz"];

// claims reports whether a readsFiles glob of the root project keys rel. It mirrors
// types.GlobClaims: a file inside a nested project is that project's, so only a glob
// rooted at or inside that project reaches it, and `**/*.lock` stops at docs/.
export fun claims(glob: str, rel: str, nested: [str]) > result\Result::<bool> {
    try {
        if (!path\matches(glob, path: rel)) {
            return result\ok::<bool>(false);
        }
        var owner = "";
        foreach (d in nested) {
            if (d.len() > owner.len() and rel.startsWith(d + "/")) {
                owner = d;
            }
        }
        if (owner == "") {
            return result\ok::<bool>(true);
        }
        var base = glob;
        final wild = std\pattern(`[*?\[\{]`).match(glob);
        if (wild != null) {
            final head = glob.sub(0, len: glob.indexOf(wild![0])!);
            final slash = head.split("/");
            base = slash.sub(0, len: slash.len() - 1).join("/");
        }
        return result\ok::<bool>(base == owner or base.startsWith(owner + "/"));
    } catch (err: any) {
        return result\caught::<bool>(err);
    }
}

// footprintFindings holds the conventions target's declared readsFiles to read. read is
// every file a rule was handed plus the linter's own sources. Each is keyed, and each
// glob keys one. nested are the workspace's projects other than the root.
export fun footprintFindings(read: [str], declared: [str], nested: [str], line: int) > result\Result::<[Finding]> {
    final found = mut [<Finding>];
    foreach (rel in read) {
        var keyed = false;
        foreach (glob in declared) {
            if (!keyed) {
                final claimed = claims(glob, rel: rel, nested: nested);
                if (claimed.error != null) {
                    return result\Result::<[Finding]>{ error = claimed.error };
                }
                keyed = claimed.value!;
            }
        }
        if (!keyed) {
            found.append(Finding{ path = "magusfile.buzz", line = line,
                message = "conventions reads " + rel + " but its ctx.readsFiles does not key it",
                hint = "Declare it in conventions, or an edit to it replays a verdict computed without it.\n"
                    + "A glob rooted above a nested project does not reach into it: name the project's path." });
        }
    }
    foreach (glob in declared) {
        var keys = false;
        foreach (rel in read) {
            if (!keys) {
                final claimed = claims(glob, rel: rel, nested: nested);
                if (claimed.error != null) {
                    return result\Result::<[Finding]>{ error = claimed.error };
                }
                keys = claimed.value!;
            }
        }
        if (!keys) {
            found.append(Finding{ path = "magusfile.buzz", line = line,
                message = "conventions declares " + glob + ", which keys no file a rule reads",
                hint = "Drop it from the ctx.readsFiles of conventions, or point it at what a rule reads now." });
        }
    }
    return result\ok::<[Finding]>(found);
}

// footprint runs footprintFindings against the tree w walks: the files globs match, the
// root's conventions declaration and the workspace's nested projects. globs are every
// rule's reads.
export fun footprint(globs: [str], w: analyzer\Walk) > result\Result::<[Finding]> {
    try {
        final files = runner\walk(".", w: w);
        if (files.error != null) {
            return result\Result::<[Finding]>{ error = files.error };
        }
        final read = files.value!.filter(fun (index: int, f: str) > bool
            => path\matchesAny(globs, path: f) or path\matchesAny(SOURCES, path: f));
        final nested = mut [<str>];
        final projectsResult = support\projects();
        if (projectsResult.error != null) {
            return result\Result::<[Finding]>{ error = projectsResult.error };
        }
        foreach (p in projectsResult.value!.projects) {
            if (p.path != ".") {
                nested.append(p.path);
            }
        }
        var declared: [str]? = null;
        final targetsResult = support\targets();
        if (targetsResult.error != null) {
            return result\Result::<[Finding]>{ error = targetsResult.error };
        }
        foreach (p in targetsResult.value!.projects) {
            foreach (n in p.nodes) {
                if (p.path == "." and n.name == "conventions") {
                    final acc = mut [<str>];
                    foreach (ref in n.readsFiles) {
                        acc.append(ref.glob);
                    }
                    declared = acc;
                }
            }
        }
        if (declared == null) {
            return result\ok::<[Finding]>([Finding{ path = "magusfile.buzz", message = "declares no conventions target",
                hint = "conventions is what runs analyzers.buzz; update this check if the target was renamed." }]);
        }
        final line = support\findLine(fs\readFile("magusfile.buzz"), needle: "export fun conventions(");
        return footprintFindings(read, declared: declared!, nested: nested, line: line);
    } catch (err: any) {
        return result\caught::<[Finding]>(err);
    }
}

test "a glob keys a nested project's file only when rooted inside it" {
    final nested = ["docs", "docs/agents", "libs/gopherbuzz"];
    assert\equal(claims("**/*.lock", rel: "benchmarks/v.lock", nested: nested).value!, want: true, message: "root file");
    assert\equal(claims("**/*.lock", rel: "docs/a.lock", nested: nested).value!, want: false, message: "tree glob stops at docs");
    assert\equal(claims("docs/**/*.lock", rel: "docs/a.lock", nested: nested).value!, want: true, message: "rooted in docs");
    assert\equal(claims("docs/**/magusfile.buzz", rel: "docs/agents/magusfile.buzz", nested: nested).value!, want: false, message: "stops at a grandchild");
    assert\equal(claims("docs/agents/magusfile.buzz", rel: "docs/agents/magusfile.buzz", nested: nested).value!, want: true, message: "literal");
    assert\equal(claims("libs/*/magusfile.buzz", rel: "libs/gopherbuzz/magusfile.buzz", nested: nested).value!, want: false, message: "wildcard above the project");
}

test "conventions keys exactly what the rules read" {
    final nested = ["docs"];
    assert\equal(footprintFindings(["a.lock", "docs/b.lock"], declared: ["**/*.lock", "docs/**/*.lock"], nested: nested, line: 1).value!.len(),
        want: 0, message: "exact");
    assert\equal(support\messages(footprintFindings(["a.lock", "docs/b.lock"], declared: ["**/*.lock", "console/*.lock"], nested: nested, line: 1).value!), want: [
        "conventions reads docs/b.lock but its ctx.readsFiles does not key it",
        "conventions declares console/*.lock, which keys no file a rule reads",
    ], message: "unkeyed and stale");
}
