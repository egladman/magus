// markdown-carries-no-mermaid refuses a mermaid fence in this repository's markdown. magus
// draws its figures with magus/figure, and nothing here renders mermaid any more, so a
// fence would show as a block of source.
namespace nomermaid;

import "assert";
import "magus/lint";
import "hack/lint/support" as support;

export fun reads() > [str] {
    return ["**/*.md", "console/**/*.md", "docs/**/*.md"];
}

export fun check(files: [Path]) > [Finding] !> any {
    final found = mut [<Finding>];
    foreach (f in files) {
        var n = 0;
        foreach (line in support\read(f).split("\n")) {
            n = n + 1;
            final t = line.trim();
            if (t.startsWith("```mermaid") or t.startsWith("~~~mermaid")) {
                found.append(Finding{ path = f.value, line = n,
                    message = "a mermaid fence; nothing in this repository renders mermaid",
                    fix = "Draw it with magus/figure (see the magus-diagram skill), or describe it as a table or list." });
            }
        }
    }
    return found;
}

test "a mermaid fence is reported at its line" {
    final got = check(support\fixture({"docs/a.md": "# A\n\n```mermaid\ngraph LR\n```\n", "b.md": "  ~~~mermaid\n~~~\n"}));
    assert\equal(got.len(), want: 2, message: "two fences");
    final lines = mut {<str: int>};
    foreach (f in got) { lines[f.path] = f.line; }
    assert\equal(lines["docs/a.md"], want: 3, message: "backtick fence line");
    assert\equal(lines["b.md"], want: 1, message: "tilde fence line");
}

test "other fences and prose naming mermaid pass" {
    final got = check(support\fixture({"a.md": "Mermaid is gone.\n\n```buzz\nimport \"std\";\n```\n"}));
    assert\equal(got.len(), want: 0, message: "clean");
}
