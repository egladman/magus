// Tier 1, mechanical: each family in FAMILIES holds everywhere, and SANCTIONED names a
// departure with why.
namespace minedprecedents;

import "assert";
import "std";
import "magus";
import "magus/lint";
import "hack/lint/support" as support;

// FAMILIES are the precedents this repository holds itself to. dep-direction and imported-packages
// stay advice: depguard and importceiling enforce the layering by declaration. ctx-first and
// error-last repeat revive's rules, but revive does not lint every nested module (gopherbuzz
// runs go vet alone), and these read every Go index. param-name-by-type and param-order stay advice: measured at 3e29af6ff they
// establish 176 and 435 keys, most of them a local habit (a rune named r), with 144 and 76
// departures.
export final FAMILIES = [magus\PrecedentFamily.ctxFirst, magus\PrecedentFamily.errSentinelName, magus\PrecedentFamily.errorLast, magus\PrecedentFamily.testPackageName];

// LANGUAGES are the indexes the rule judges. Buzz joins once CI installs scip-buzz; until
// then a Buzz row would hold on one machine and not another.
export final LANGUAGES = ["go"];

// SANCTIONED holds each departure kept on purpose, by the node the row names, with why. An
// entry whose case no longer departs is a finding, so the list only shrinks.
export final SANCTIONED = {
    "symbol:gomod github.com/egladman/magus `github.com/egladman/magus/cmd/magus`/magusErr.": "a lazy singleton's memoized open error beside its value, not a sentinel to compare against",
    "symbol:gomod github.com/egladman/magus `github.com/egladman/magus/cmd/magus`/inspectErr.": "a lazy singleton's memoized open error beside its value, not a sentinel to compare against",
    "file:example_test.go": "package magus_test on purpose (458ef9da7): the examples show the public API as a caller imports it",
};

// THIS is where a finding sends a reader to sanction a departure.
final THIS = "hack/lint/code-follows-mined-precedents.buzz";

// reads keys conventions on every Go source the indexes cover: a tree glob
// stops at a nested project, so each project holding Go is named. proto's Go is
// all generated.
export fun reads() > [str] {
    return ["**/*.go", "libs/conventions/**/*.go", "libs/diagnostics/**/*.go",
        "libs/figure/**/*.go","libs/gopherbuzz/**/*.go", "libs/proofread/**/*.go", "libs/scipbuzz/**/*.go", "libs/testpairing/**/*.go",
        "libs/text/**/*.go", "libs/xdg/**/*.go", "libs/cmdline/**/*.go"];
}

// check fails every departure from an established precedent in FAMILIES.
// SANCTIONED departures pass.
// magus\graph().precedents() mines them from the live symbol index.
// A missing or stale index is a finding: a rule reading nothing finds nothing.
export fun check(files: [Path]) > [Finding] !> any {
    return judge(magus\graph(languages: LANGUAGES).precedents(), sanctioned: SANCTIONED);
}

// judge is check over a magus\graph().precedents() report.
export fun judge(report: magus\Holds, sanctioned: {str: str}) > [Finding] !> any {
    final found = mut [<Finding>];
    final indexes = report.indexes;
    final rows = report.holds;
    var judgeable = true;
    foreach (lang in LANGUAGES) {
        var declared = false;
        foreach (idx in indexes) {
            if (idx.language != lang) {
                continue;
            }
            declared = true;
            final stale = support\staleness({"freshness": idx.freshness.value, "project": {"path": idx.project.path}, "language": idx.language, "detail": idx.detail, "changed": idx.changed, "changed_count": idx.changedCount}, judging: "precedents");
            judgeable = judgeable and stale.judgeable;
            foreach (f in stale.findings) {
                found.append(f);
            }
        }
        if (!declared) {
            judgeable = false;
            found.append(Finding{ path = ".", message = "no {lang} symbol index is declared, so no {lang} precedent was judged",
                fix = "A spell binding {lang} declares its indexer; check `magus describe spell`." });
        }
    }
    if (!judgeable) {
        return found;
    }

    final departed = mut {<str: bool>};
    foreach (lang in LANGUAGES) {
        foreach (family in FAMILIES) {
            // A keyed family (a parameter type, a pair of names) makes a row per key, and each
            // established one is held.
            final held = mut [<magus\Precedent>];
            foreach (r in rows) {
                if (r.family == family and r.scope.language == lang and r.established == true) {
                    held.append(r);
                }
            }
            if (held.len() == 0) {
                found.append(Finding{ path = ".", message = "the index establishes no {lang} {family.value} precedent to hold",
                    fix = "The miner or the index changed under this rule; read `magus\\graph().precedents()` before dropping the family." });
                continue;
            }
            foreach (row in held) {
                final follow = row.follow;
                final cohort = row.cohort;
                final departures = row.departures;
                foreach (d in departures) {
                    final node: str = d.node;
                    departed[node] = true;
                    if (sanctioned[node] != null) {
                        continue;
                    }
                    final at = position(d.source);
                    found.append(Finding{ path = at.path, line = at.line,
                        message = "departs from the {family.value} precedent that {follow} of {cohort} {lang} cases follow: {node}",
                        fix = "Follow it, or add the node to SANCTIONED in " + THIS + " with the reason it departs." });
                }
            }
        }
    }
    foreach (node, reason in sanctioned) {
        if (departed[node] == null) {
            found.append(Finding{ path = THIS, message = "sanctions {node}, which no longer departs",
                fix = "Delete the entry: the list only shrinks." });
        } else if (reason.trim() == "") {
            found.append(Finding{ path = THIS, message = "sanctions {node} without a reason",
                fix = "Say in one line why it departs." });
        }
    }
    return found;
}

// Position is a case's source split into a file and a line, 0 when the index named none.
object Position {
    path: str,
    line: int,
}

fun position(source: str) > Position {
    final colon = source.indexOf(":");
    if (colon == null) {
        return Position{ path = source, line = 0 };
    }
    return Position{ path = source.sub(0, len: colon!),
        line = std\parseInt(source.sub(colon! + 1, len: source.len() - colon! - 1)) ?? 0 };
}

fun fresh(lang: str) > magus\SymbolIndexStatus {
    return magus\SymbolIndexStatus{ project = magus\ProjectRef{ path = "." }, language = lang, freshness = magus\SymbolIndexFreshness.upToDate };
}

fun row(family: magus\PrecedentFamily, departures: [magus\Case]) > magus\Precedent {
    return magus\Precedent{ family = family, scope = magus\PrecedentScope{ language = "go" }, established = true,
        follow = 85, cohort = 86, departures = departures };
}

// report holds a row of every family, with departures under err-sentinel-name.
fun report(indexes: [magus\SymbolIndexStatus], departures: [magus\Case]) > magus\Holds {
    final rows = mut [<magus\Precedent>];
    foreach (family in FAMILIES) {
        rows.append(row(family, departures: if (family == magus\PrecedentFamily.errSentinelName) departures else [<magus\Case>]));
    }
    return magus\Holds{ indexes = indexes, holds = rows };
}

test "an unsanctioned departure is reported at its line" {
    final d = magus\Case{ node = "symbol:x/magusErr.", source = "cmd/magus/helpers.go:107" };
    final got = judge(report([fresh("go")], departures: [d]), sanctioned: {<str: str>});
    assert\equal(got.len(), want: 1, message: "one departure");
    assert\equal(got[0].path, want: "cmd/magus/helpers.go", message: "file");
    assert\equal(got[0].line, want: 107, message: "line");
    assert\equal(got[0].message.indexOf("85 of 86 go cases") != null, want: true, message: got[0].message);
}

test "a sanctioned departure passes and a sanction that no longer departs fails" {
    final d = magus\Case{ node = "symbol:x/magusErr.", source = "cmd/magus/helpers.go:107" };
    final kept = judge(report([fresh("go")], departures: [d]), sanctioned: {"symbol:x/magusErr.": "a sync.Once memo slot"});
    assert\equal(kept.len(), want: 0, message: "sanctioned");
    final stale = judge(report([fresh("go")], departures: [<magus\Case>]), sanctioned: {"symbol:x/magusErr.": "a sync.Once memo slot"});
    assert\equal(stale.len(), want: 1, message: "the list only shrinks");
    assert\equal(stale[0].path, want: THIS, message: "points at the list");
    final bare = judge(report([fresh("go")], departures: [d]), sanctioned: {"symbol:x/magusErr.": " "});
    assert\equal(bare.len(), want: 1, message: "a sanction needs a reason");
}

test "a stale or missing index fails instead of passing on what it lacks" {
    final stale = magus\SymbolIndexStatus{ project = magus\ProjectRef{ path = "libs/x" }, language = "go", freshness = magus\SymbolIndexFreshness.outOfDate };
    final got = judge(report([fresh("go"), stale], departures: [<magus\Case>]), sanctioned: {<str: str>});
    assert\equal(got.len(), want: 1, message: "the stale index");
    assert\equal(got[0].path, want: "libs/x", message: "names the project");
    final none = judge(report([fresh("buzz")], departures: [<magus\Case>]), sanctioned: {<str: str>});
    assert\equal(none.len(), want: 1, message: "no go index at all");
}

test "a stale index listing its changes fails at each one and still judges the rest" {
    final stale = magus\SymbolIndexStatus{ project = magus\ProjectRef{ path = "." }, language = "go", freshness = magus\SymbolIndexFreshness.outOfDate,
        changed = ["cmd/magus/edited.go"], changedCount = 1 };
    final d = magus\Case{ node = "symbol:x/magusErr.", source = "cmd/magus/helpers.go:107" };
    final got = judge(report([stale], departures: [d]), sanctioned: {<str: str>});
    assert\equal(got.len(), want: 2, message: "the changed file and the departure");
    assert\equal(got[0].path, want: "cmd/magus/edited.go", message: "staleness at the file");
    assert\equal(got[1].path, want: "cmd/magus/helpers.go", message: "a current file is judged");
}

test "a family the index no longer establishes fails" {
    final r = report([fresh("go")], departures: [<magus\Case>]);
    final rows = r.holds;
    final kept = mut [<magus\Precedent>];
    foreach (p in rows) {
        if (p.family != magus\PrecedentFamily.errSentinelName) {
            kept.append(p);
        }
    }
    final got = judge(magus\Holds{ indexes = r.indexes, holds = kept }, sanctioned: {<str: str>});
    assert\equal(got.len(), want: 1, message: "err-sentinel-name is missing");
}

test "every established row of a keyed family is held and an unestablished one is not" {
    final r = report([fresh("go")], departures: [<magus\Case>]);
    final rows = r.holds;
    final keyed = mut [<magus\Precedent>];
    foreach (p in rows) {
        keyed.append(p);
    }
    keyed.append(row(magus\PrecedentFamily.ctxFirst, departures: [magus\Case{ node = "symbol:x/callValue().", source = "vm/operators.go:1344" }]));
    keyed.append(magus\Precedent{ family = magus\PrecedentFamily.ctxFirst, scope = magus\PrecedentScope{ language = "go" }, established = false,
        follow = 3, cohort = 6, departures = [magus\Case{ node = "symbol:x/other().", source = "vm/other.go:1" }] });
    final got = judge(magus\Holds{ indexes = r.indexes, holds = keyed }, sanctioned: {<str: str>});
    assert\equal(got.len(), want: 1, message: "the second established row's departure, and not the loose row's");
    assert\equal(got[0].path, want: "vm/operators.go", message: got[0].message);
}
