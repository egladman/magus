// Tier 2, measured shape: a function the change touches may not score
// above CRAP 10. A function it leaves alone is never refused.
namespace crapRule;

import "assert";
import "std";
import "vcs";
import "magus";
import "magus/lint";

export final THRESHOLD = 10;

// reads keys lint-rules on the sources a score comes from: functions and tests.
export fun reads() > [str] {
    return ["**/*.go", "**/*_test.go", "libs/**/*.go", "libs/**/*_test.go", "magus.yaml"];
}

// check refuses each touched function past THRESHOLD and each gap that the
// worst case cannot decide.
export fun check(files: [Path]) > [Finding] !> any {
    return judge(magus\crap(vcs\base()));
}

// judge is check's verdict over a magus\crap answer. CRAP has no exception.
export fun judge(crap: magus\Crap) > [Finding] {
    final found = mut [<Finding>];
    foreach (f in crap.functions) {
        if (f.score > 10.0) {
            found.append(refuse(f));
        }
    }
    foreach (g in crap.gaps) {
        if (!decided(g.complexity)) {
            found.append(unscored(g));
        }
    }
    return found;
}

// decided repeats types.FunctionGap.Decided, which the Buzz mirror lacks.
// Zero coverage is the worst case, so within THRESHOLD there holds anywhere.
export fun decided(complexity: int) > bool {
    return complexity > 0 and complexity * complexity + complexity <= THRESHOLD;
}

fun refuse(f: magus\CrapFunction) > Finding {
    return Finding{ path = f.path, line = f.line,
        message = "{f.label} scores CRAP {hundredths(f.score)} (complexity {f.complexity}, coverage {coverage(f)}), past {THRESHOLD}",
        fix = "Cover it with tests, or split it into functions that each score {THRESHOLD} or less." };
}

fun unscored(g: magus\FunctionGap) > Finding {
    return Finding{ path = g.path, line = g.line,
        message = "{g.label} has no CRAP score ({g.reason}) and complexity {g.complexity} does not decide it within {THRESHOLD}",
        fix = "Give its language a coverage measure, or split it until complexity squared plus complexity is {THRESHOLD} or less." };
}

fun coverage(f: magus\CrapFunction) > str {
    if (f.coverable == 0) {
        return "no coverable lines";
    }
    return "{f.covered * 100 / f.coverable}%";
}

fun hundredths(score: double) > str {
    final h = std\toInt(score * 100.0 + 0.5);
    final frac = h % 100;
    final pad = if (frac < 10) "0" else "";
    return "{(h - frac) / 100}.{pad}{frac}";
}

fun fn(label: str, complexity: int, covered: int, coverable: int, score: double) > magus\CrapFunction {
    return magus\CrapFunction{ label = label, path = "a.go", line = 3, complexity = complexity,
        covered = covered, coverable = coverable, score = score };
}

fun gap(complexity: int) > magus\FunctionGap {
    return magus\FunctionGap{ label = "a.F", path = "a.go", line = 9, complexity = complexity, reason = "spell bash declares no coverage" };
}

test "a touched function past ten is refused with its score, complexity and coverage" {
    final got = judge(magus\Crap{ functions = [fn("a.Long", complexity: 12, covered: 1, coverable: 4, score: 31.5)] });
    assert\equal(got.len(), want: 1, message: "one finding");
    assert\equal(got[0].line, want: 3, message: "at the function");
    assert\equal(got[0].message, want: "a.Long scores CRAP 31.50 (complexity 12, coverage 25%), past 10", message: "figures");
}

test "a function at ten passes" {
    assert\equal(judge(magus\Crap{ functions = [fn("a.Ok", complexity: 3, covered: 4, coverable: 4, score: 10.0)] }).len(), want: 0,
        message: "ten is within");
}

test "a gap is decided by its worst case, and refused otherwise with its reason" {
    final got = judge(magus\Crap{ gaps = [gap(2), gap(3), gap(0)] });
    assert\equal(got.len(), want: 2, message: "2 decides (6), 3 does not (12), 0 decides nothing");
    assert\equal(got[0].message, want: "a.F has no CRAP score (spell bash declares no coverage) and complexity 3 does not decide it within 10",
        message: "reason shown");
}

test "a function with no coverable line says so" {
    assert\equal(coverage(fn("a.F", complexity: 1, covered: 0, coverable: 0, score: 0.0)), want: "no coverable lines", message: "none");
}
