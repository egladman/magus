// package-install-targets-never-replay: a target that installs packages must never
// replay. Its effect is node_modules, which no cache entry records, so a hit on a fresh
// checkout (a restored CI store, a remote-tier entry) restores nothing and the next
// target runs without its packages. That is how the console shard of #268 failed:
// preflight hit, build ran, esbuild could not resolve @connectrpc/connect.
//
// A target installs when it calls an install op of its spell, which magus\describe.graph()
// records statically; skip_cache is read from the evaluated projects.
namespace installs;

import "assert";
import "magus/lint";
import "hack/lint/support" as support;

// INSTALL_OPS are the spell ops that install a project's packages.
export final INSTALL_OPS = {"pnpm-install": true, "npm-ci": true, "go-mod-download": true, "uv-sync": true, "cargo-fetch": true};

// InstallTarget is one target calling an install op. declaredAs is the name its
// magusfile declares it under.
export object InstallTarget {
    project: str,
    name: str,
    declaredAs: str,
    skipsCache: bool,
}

export fun reads() > [str] {
    return ["**/magusfile.buzz"];
}

export fun check(files: [Path]) > [Finding] !> any {
    final skips = support\skipsCache();
    final targets = mut [<InstallTarget>];
    final sources = mut {<str: str>};
    foreach (p in support\targets().projects) {
        foreach (n in p.nodes) {
            var installs = false;
            foreach (use in n.spells) {
                foreach (op in use.ops) {
                    installs = installs or INSTALL_OPS[op] != null;
                }
            }
            if (!installs) {
                continue;
            }
            targets.append(InstallTarget{ project = p.path, name = n.name,
                declaredAs = if (n.declared != "") n.declared else n.name,
                skipsCache = skips["{p.path}:{n.name}"] ?? false });
            final magusfile = support\named(files, p: support\magusfilePath(p.path));
            if (magusfile != null) {
                sources[magusfile!.value] = support\read(magusfile!);
            }
        }
    }
    return findings(targets, sources: sources);
}

// findings grades each install target; sources holds each magusfile's text, keyed by
// its workspace path, for the line a finding points at.
export fun findings(targets: [InstallTarget], sources: {str: str}) > [Finding] {
    if (targets.len() == 0) {
        return [Finding{ path = ".", message = "no install target found",
            fix = "INSTALL_OPS no longer matches how projects install; update it." }];
    }
    final found = mut [<Finding>];
    foreach (t in targets) {
        if (t.skipsCache) {
            continue;
        }
        final magusfile = support\magusfilePath(t.project);
        found.append(Finding{ path = magusfile,
            line = support\findLine(sources[magusfile] ?? "", needle: "export fun " + t.declaredAs + "("),
            message = "target \"{t.name}\" installs packages but may replay",
            fix = "Its effect is node_modules, which no cache entry records, so a hit on a fresh checkout\n"
                + "restores nothing. Declare \"{t.name}\": \{\"skip_cache\": \"<why>\"} in the project's targets." });
    }
    return found;
}

test "an install target that skips the cache passes" {
    final got = findings([InstallTarget{ project = "console", name = "install", declaredAs = "install", skipsCache = true }], sources: {});
    assert\equal(got.len(), want: 0, message: "clean");
}

test "an install target that may replay is reported at its definition" {
    final got = findings([InstallTarget{ project = "console", name = "install", declaredAs = "install", skipsCache = false }],
        sources: {"console/magusfile.buzz": "import \"magus\";\n\nexport fun install(ctx: magus\\Context) > void \{}\n"});
    assert\equal(got.len(), want: 1, message: "one finding");
    assert\equal(got[0].path, want: "console/magusfile.buzz", message: "path");
    assert\equal(got[0].line, want: 3, message: "line");
    assert\equal(got[0].message, want: "target \"install\" installs packages but may replay", message: "message");
}

test "no install target at all is reported" {
    assert\equal(support\messages(findings([<InstallTarget>], sources: {})), want: ["no install target found"], message: "none");
}
