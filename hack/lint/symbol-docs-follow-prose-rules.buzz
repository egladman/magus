namespace symbolprose;

import "assert";
import "std";
import "magus";
import "magus/lint";

// RULES are the prose rules every doc comment and callable name is held to. history stays
// off: a doc that says what a symbol replaced is judged by a reader, not a pattern.
export final RULES = ["comment-block", "comment-sentence", "filler", "terms", "name-suffix", "aside", "docstub"];

// LANGUAGES are the indexes the rule judges. A language whose index judged no symbol is
// reported, so an indexer that stops emitting docs cannot turn the rule into a pass.
export final LANGUAGES = ["go", "typescript"];

// SANCTIONED holds each finding kept on purpose, by the node the finding names, with why. An
// entry whose node no longer has a finding is itself a finding, so the list only shrinks.
export final SANCTIONED = {<str: str>};

// THIS is where a finding sends a reader to sanction a symbol.
final THIS = "hack/lint/symbol-docs-follow-prose-rules.buzz";

// reads keys lint-rules on every source the indexes cover: a tree glob stops at a nested
// project, so each project holding Go or TypeScript is named. proto's Go is all generated.
export fun reads() > [str] {
    return ["**/*.go", "libs/conventions/**/*.go", "libs/diagnostics/**/*.go",
        "libs/figure/**/*.go", "libs/gopherbuzz/**/*.go", "libs/scipbuzz/**/*.go", "libs/testlayout/**/*.go",
        "console/**/*.ts", "docs/**/*.ts", "docs/guides/integrations/agents/**/*.ts",
        "libs/textsearch/**/*.ts"];
}

// check fails every prose finding that SANCTIONED does not name, read from the live symbol
// indexes by magus\prose. A missing or stale index, and a language that judged nothing, is a
// finding, never a pass: a rule reading nothing finds nothing.
export fun check(files: [Path]) > [Finding] !> any {
    return judge(magus\prose(), sanctioned: SANCTIONED);
}

// judge is check over a magus\prose report.
export fun judge(report: {str: any}, sanctioned: {str: str}) > [Finding] !> any {
    final found = mut [<Finding>];
    final indexes: [any] = report["indexes"] ?? [<any>];
    final judged: {str: any} = report["judged"] ?? {<str: any>};
    final rows: [any] = report["findings"] ?? [<any>];
    foreach (lang in LANGUAGES) {
        var declared = false;
        foreach (idx in indexes) {
            if (idx["language"] != lang) {
                continue;
            }
            declared = true;
            final freshness: str = idx["freshness"] ?? "";
            if (freshness != "up-to-date") {
                final project: str = idx["project"]["path"] ?? ".";
                final detail: str = idx["detail"] ?? "";
                final rebuild = "Rebuild it with `magus graph build`, then rerun lint.";
                final fix = if (detail != "") detail + "\n" + rebuild else rebuild;
                found.append(Finding{ path = project,
                    message = "the {lang} symbol index of {project} is {freshness}, so its docs cannot be judged",
                    fix = fix });
            }
        }
        if (!declared) {
            found.append(Finding{ path = ".", message = "no {lang} symbol index is declared, so no {lang} doc was judged",
                fix = "A spell binding {lang} declares its indexer; check `magus describe spell`." });
        } else if (std\toInt(judged[lang] ?? 0) == 0) {
            found.append(Finding{ path = ".", message = "no {lang} symbol was judged: silence, not a pass",
                fix = "The indexer emitted no {lang} docs or names; read `magus\\prose()` before dropping the language." });
        }
    }
    if (found.len() > 0) {
        return found;
    }

    final flagged = mut {<str: bool>};
    foreach (f in rows) {
        final rule: str = f["rule"] ?? "";
        if (RULES.indexOf(rule) == null) {
            continue;
        }
        final node: str = f["node"] ?? "";
        flagged[node] = true;
        if (sanctioned[node] != null) {
            continue;
        }
        final at = position(f["source"] ?? "");
        final matched: str = f["match"] ?? "";
        final said: str = f["message"] ?? "";
        final shown = if (matched == "") "" else ": {matched}";
        found.append(Finding{ path = at.path, line = at.line,
            message = "{said}{shown} [{rule}]",
            fix = "Reword the doc or the name, or add the node {node} to SANCTIONED in " + THIS + " with the reason it stays." });
    }
    foreach (node, reason in sanctioned) {
        if (flagged[node] == null) {
            found.append(Finding{ path = THIS, message = "sanctions {node}, which no longer has a finding",
                fix = "Delete the entry: the list only shrinks." });
        } else if (reason.trim() == "") {
            found.append(Finding{ path = THIS, message = "sanctions {node} without a reason",
                fix = "Say in one line why it stays." });
        }
    }
    return found;
}

// Position is a finding's source split into a file and a line, 0 when the index named none.
object Position {
    path: str,
    line: int,
}

fun position(source: str) > Position {
    final colon = source.indexOf(":");
    if (colon == null) {
        return Position{ path = source, line = 0 };
    }
    return Position{ path = source.sub(0, len: colon!),
        line = std\parseInt(source.sub(colon! + 1, len: source.len() - colon! - 1)) ?? 0 };
}

fun fresh(lang: str) > {str: any} {
    return {"project": {"path": "."}, "language": lang, "freshness": "up-to-date"};
}

fun both() > [any] {
    return [fresh("go"), fresh("typescript")];
}

fun counts() > {str: any} {
    return {"go": 12.0, "typescript": 7.0};
}

fun finding(rule: str, node: str, source: str) > {str: any} {
    return {"node": node, "source": source, "language": "go", "rule": rule,
        "message": "the doc opens with filler", "match": "simply"};
}

fun report(findings: [any]) > {str: any} {
    return {"findings": findings, "judged": counts(), "indexes": both()};
}

test "a finding is reported at its declaration with the rule and the match" {
    final got = judge(report([finding("filler", node: "symbol:x/Run().", source: "cmd/magus/run.go:41")]),
        sanctioned: {<str: str>});
    assert\equal(got.len(), want: 1, message: "one finding");
    assert\equal(got[0].path, want: "cmd/magus/run.go", message: "file");
    assert\equal(got[0].line, want: 41, message: "line");
    assert\equal(got[0].message, want: "the doc opens with filler: simply [filler]", message: got[0].message);
}

test "a sanctioned finding is skipped and a sanction that no longer applies fails" {
    final f = finding("filler", node: "symbol:x/Run().", source: "cmd/magus/run.go:41");
    final kept = judge(report([f]), sanctioned: {"symbol:x/Run().": "quotes a protocol phrase"});
    assert\equal(kept.len(), want: 0, message: "sanctioned");
    final stale = judge(report([<any>]), sanctioned: {"symbol:x/Run().": "quotes a protocol phrase"});
    assert\equal(stale.len(), want: 1, message: "the list only shrinks");
    assert\equal(stale[0].path, want: THIS, message: "points at the list");
    final bare = judge(report([f]), sanctioned: {"symbol:x/Run().": " "});
    assert\equal(bare.len(), want: 1, message: "a sanction needs a reason");
}

test "a stale or missing index fails instead of passing on what it lacks" {
    final stale: {str: any} = {"project": {"path": "console"}, "language": "typescript", "freshness": "out-of-date"};
    final got = judge({"findings": [<any>], "judged": counts(), "indexes": [fresh("go"), stale]},
        sanctioned: {<str: str>});
    assert\equal(got.len(), want: 1, message: "the stale index");
    assert\equal(got[0].path, want: "console", message: "names the project");
    final none = judge({"findings": [<any>], "judged": counts(), "indexes": [fresh("go")]},
        sanctioned: {<str: str>});
    assert\equal(none.len(), want: 1, message: "no typescript index at all");
}

test "a language with no judged symbol is silence, not a pass" {
    final got = judge({"findings": [<any>], "judged": {"go": 12.0}, "indexes": both()},
        sanctioned: {<str: str>});
    assert\equal(got.len(), want: 1, message: "typescript judged nothing");
    assert\equal(got[0].message.indexOf("no typescript symbol was judged") != null, want: true, message: got[0].message);
    final zero = judge({"findings": [<any>], "judged": {"go": 0.0, "typescript": 7.0}, "indexes": both()},
        sanctioned: {<str: str>});
    assert\equal(zero.len(), want: 1, message: "go judged zero");
}

test "the history rule is ignored and every other rule is held" {
    final rows = mut [<any>];
    rows.append(finding("history", node: "symbol:x/Old().", source: "a/old.go:3"));
    foreach (rule in RULES) {
        rows.append(finding(rule, node: "symbol:x/" + rule + ".", source: "a/" + rule + ".go:1"));
    }
    final got = judge(report(rows), sanctioned: {<str: str>});
    assert\equal(got.len(), want: RULES.len(), message: "one per held rule, none for history");
    assert\equal(RULES.indexOf("history") == null, want: true, message: "history is not a held rule");
}
