// published-magus-is-built-first-and-verified-by-digest: ci.yaml builds magus once and
// later jobs install that binary. The upload must precede any cache extraction that
// could overwrite it, and every consumer must verify the digest its publisher recorded.
namespace publishedmagus;

import "assert";
import "encoding/yaml";
import "fs";
import "serialize";
import "std";
import "magus/lint";
import "hack/lint/support" as support;

export final ACTION = ".github/actions/setup-magus/action.yml";
final setupMagus = "./.github/actions/setup-magus";
final jobOutput = std\pattern(`^\$\{\{ needs\.([\w-]+)\.outputs\.([\w-]+) \}\}$`);

export fun reads() > [str] {
    return [ACTION, ".github/workflows/*.yaml"];
}

export fun check(files: [Path]) > [Finding] !> any {
    final action = support\named(files, p: ACTION);
    if (action == null) {
        return [support\missing(ACTION)];
    }
    final workflows = mut {<str: str>};
    foreach (f in files) {
        if (f.value != ACTION) {
            workflows[f.value] = support\read(f);
        }
    }
    final found = mut [<Finding>];
    foreach (f in actionFindings(support\read(action!))) {
        found.append(f);
    }
    foreach (f in workflowFindings(workflows)) {
        found.append(f);
    }
    return found;
}

// actionFindings holds setup-magus to uploading the binary it built before it extracts
// any cache entry.
export fun actionFindings(raw: str) > [Finding] !> any {
    final steps = serialize\Boxed.init(yaml\parse(raw)).q(["runs", "steps"]).listValue();
    final lines = yaml\positions(raw).lines;
    var publish = -1;
    var restore = -1;
    foreach (i in 0..steps.len()) {
        if (support\scalar(steps[i].q(["id"])) == "publish") {
            publish = i;
        }
        if (support\scalar(steps[i].q(["uses"])).startsWith("actions/cache/restore@")) {
            restore = i;
        }
    }
    if (publish < 0) {
        return [Finding{ path = ACTION, message = "setup-magus has no step with id publish",
            fix = "The step uploading the binary it built carries id: publish." }];
    }
    if (restore < 0) {
        return [Finding{ path = ACTION, message = "setup-magus restores no run history",
            fix = "Update this rule if the history restore moved out of setup-magus." }];
    }
    if (publish > restore) {
        return [Finding{ path = ACTION, line = lines["/runs/steps/{restore}"] ?? 0,
            message = "setup-magus extracts a cache entry before it uploads the binary it built",
            fix = "Move the publish step above the restore: an extracted entry could overwrite the binary." }];
    }
    return [<Finding>];
}

// workflowFindings holds every job that publishes magus to building it first, and every
// job that installs a published one to the digest and commit its publisher recorded.
// workflows maps each workflow's workspace path to its text.
export fun workflowFindings(workflows: {str: str}) > [Finding] !> any {
    final found = mut [<Finding>];
    var published = 0;
    foreach (p in support\sorted(workflows.keys())) {
        final raw = workflows[p]!;
        final lines = yaml\positions(raw).lines;
        final file = fs\basename(p);
        final jobs = serialize\Boxed.init(yaml\parse(raw)).q(["jobs"]).mapValue();
        foreach (name in support\sorted(jobs.keys())) {
            final job = jobs[name]!;
            final steps = job.q(["steps"]).listValue();
            foreach (i in 0..steps.len()) {
                final step = steps[i];
                if (support\scalar(step.q(["uses"])) != setupMagus) {
                    continue;
                }
                final line = lines["/jobs/{support\pointer(name)}/steps/{i}"] ?? 0;
                final flag = fun (message: str, fix: str) > void {
                    found.append(Finding{ path = p, line = line, message = "{file}/{name}: " + message, fix = fix });
                };
                if (support\scalar(step.q(["with", "publish-artifact"])) != "") {
                    published = published + 1;
                    foreach (j in 0..i) {
                        final prior = support\scalar(steps[j].q(["uses"]));
                        if (!prior.startsWith("actions/checkout@")) {
                            flag("\"{prior}{support\scalar(steps[j].q(["run"]))}\" runs before the magus it publishes is built",
                                fix: "Publish from a job that checks out and then builds magus first.");
                        }
                    }
                }
                if (support\scalar(step.q(["with", "installation-strategy"])) != "artifact") {
                    continue;
                }
                final m = jobOutput.match(support\scalar(step.q(["with", "artifact-sha256"])));
                if (m == null) {
                    flag("artifact-sha256 is not a job output of the publisher",
                        fix: "Pass $\{\{ needs.<publisher>.outputs.<name> }}, the digest the publisher recorded.");
                    continue;
                }
                final publisher = m![1];
                final output = m![2];
                final needs = mut [<str>];
                final declared = job.q(["needs"]);
                if (declared.string() != null) {
                    needs.append(declared.string()!);
                }
                foreach (n in declared.listValue()) {
                    needs.append(support\scalar(n));
                }
                if (needs.indexOf(publisher) == null) {
                    flag("reads {publisher}'s output but does not need {publisher}", fix: "Add {publisher} to the job's needs.");
                }
                var producer = "";
                foreach (s in jobs[publisher]?.q(["steps"]).listValue() ?? [<serialize\Boxed>]) {
                    if (support\scalar(s.q(["uses"])) == setupMagus and support\scalar(s.q(["with", "publish-artifact"])) != "") {
                        producer = support\scalar(s.q(["id"]));
                    }
                }
                if (producer == "") {
                    flag("{publisher} publishes magus from no step with an id",
                        fix: "Give {publisher}'s publishing setup-magus step an id; its sha256 output is the digest.");
                    continue;
                }
                final want = "$\{\{ steps.{producer}.outputs.sha256 }}";
                final got = support\scalar(jobs[publisher]!.q(["outputs", output]));
                if (got != want) {
                    flag("{publisher}'s output {output} is \"{got}\"", fix: "Set it to \"{want}\".");
                }
                if (support\scalar(step.q(["with", "artifact-commit"])) != "$\{\{ github.sha }}") {
                    flag("artifact-commit is not $\{\{ github.sha }}", fix: "Install the binary built from this run's commit.");
                }
            }
        }
    }
    if (published == 0) {
        found.append(Finding{ path = ".github/workflows", message = "no job publishes magus for later jobs to install",
            fix = "ci.yaml builds magus once and shares it; update this rule if that changed." });
    }
    return found;
}

fun shipped() > {str: str} !> any {
    final acc = mut {<str: str>};
    foreach (p in fs\glob(".github/workflows/*.yaml")) {
        acc[p.value] = fs\readFile(p.value);
    }
    return acc;
}

final publisher = "jobs:\n  plan:\n    outputs:\n      magus_sha256: $\{\{ steps.magus.outputs.sha256 }}\n    steps:\n"
    + "      - uses: actions/checkout@v4\n      - id: magus\n        uses: ./.github/actions/setup-magus\n        with:\n          publish-artifact: magus\n";

fun consumer(needs: str, sha: str) > str {
    return "  test:\n    needs: " + needs + "\n    steps:\n      - uses: ./.github/actions/setup-magus\n        with:\n"
        + "          installation-strategy: artifact\n          artifact-sha256: " + sha + "\n          artifact-commit: $\{\{ github.sha }}\n";
}

test "the shipped action and workflows pass" {
    assert\equal(support\messages(actionFindings(fs\readFile(ACTION))), want: [<str>], message: "action");
    assert\equal(support\messages(workflowFindings(shipped())), want: [<str>], message: "workflows");
}

test "a publisher and a verifying consumer pass" {
    final got = workflowFindings({".github/workflows/ci.yaml": publisher + consumer("[plan]", sha: "$\{\{ needs.plan.outputs.magus_sha256 }}")});
    assert\equal(support\messages(got), want: [<str>], message: "clean");
}

test "an unverified or unneeded consumer is reported at its step" {
    final got = workflowFindings({".github/workflows/ci.yaml": publisher + consumer("lint", sha: "abc")});
    assert\equal(support\messages(got), want: ["ci.yaml/test: artifact-sha256 is not a job output of the publisher"], message: "digest");
    assert\equal(got[0].line, want: 14, message: "line");
    assert\equal(support\messages(workflowFindings({".github/workflows/ci.yaml": publisher + consumer("lint", sha: "$\{\{ needs.plan.outputs.magus_sha256 }}")})),
        want: ["ci.yaml/test: reads plan's output but does not need plan"], message: "needs");
}

test "a publisher building after another step, or none at all, is reported" {
    final late = publisher.replace("      - uses: actions/checkout@v4\n", with: "      - run: make\n");
    assert\equal(support\messages(workflowFindings({".github/workflows/ci.yaml": late})),
        want: ["ci.yaml/plan: \"make\" runs before the magus it publishes is built"], message: "late");
    assert\equal(support\messages(workflowFindings({})), want: ["no job publishes magus for later jobs to install"], message: "none");
}

test "a restore ahead of the publish is reported" {
    final got = actionFindings("runs:\n  steps:\n    - uses: actions/cache/restore@v4\n    - id: publish\n      run: x\n");
    assert\equal(support\messages(got), want: ["setup-magus extracts a cache entry before it uploads the binary it built"], message: "order");
    assert\equal(got[0].line, want: 3, message: "line");
}
