// generate-drift-throw-names-the-engine-drift-code: the root magusfile's whole-tree drift
// throw and the engine's declared-output path (types.ClassifyDrift) both diagnose
// "generated output drifted", and must name it with the same code so a reader does not
// learn two spellings of one condition. The throw deliberately does not CALL
// ClassifyDrift (whole-tree drift has no single target's inputs to classify against), so
// this pins only the code text, read from the Go constant the engine emits.
namespace generatedrift;

import "assert";
import "std";
import "magus/lint";
import "hack/lint/support" as support;

export final MAGUSFILE = "magusfile.buzz";
export final CODES = "types/diagnostic.go";

final anchor = "regeneration changed generated files";
final constant = std\pattern(`\bStaleGeneratedOutput\s+DiagnosticCode = "(MGS\d+)"`);

export fun reads() > [str] {
    return [MAGUSFILE, CODES];
}

export fun check(files: [Path]) > [Finding] !> any {
    final magusfile = support\named(files, p: MAGUSFILE);
    final codes = support\named(files, p: CODES);
    if (magusfile == null) {
        return [support\missing(MAGUSFILE)];
    }
    if (codes == null) {
        return [support\missing(CODES)];
    }
    final m = constant.match(support\read(codes!));
    if (m == null) {
        return [Finding{ path = CODES, message = "declares no StaleGeneratedOutput code",
            fix = "Update this rule's pattern to where the engine's drift code is declared now." }];
    }
    final code = m![1];
    final src = support\read(magusfile!);
    final i = src.indexOf(anchor);
    if (i == null) {
        return [Finding{ path = MAGUSFILE, message = "the whole-tree drift throw moved or was reworded",
            fix = "Update this rule's anchor text to the throw's new wording." }];
    }
    // The code is a plain-text prefix on the throw, not a magus\raise call: magus\raise
    // refuses the MGS namespace as reserved for magus's own diagnostics.
    final start = if (i! > 80) i! - 80 else 0;
    if (src.sub(start, len: i! - start).indexOf(code) != null) {
        return [<Finding>];
    }
    return [Finding{ path = MAGUSFILE, line = support\lineAt(src, off: i!),
        message = "the whole-tree drift throw does not carry " + code,
        fix = "Prefix it with the code the engine's declared-output path emits via types.ClassifyDrift." }];
}

final codesGo = "\tStaleGeneratedOutput      DiagnosticCode = \"MGS4006\"\n";

test "a throw carrying the engine's code passes" {
    final files = support\fixture({MAGUSFILE: "x\n    throw \"MGS4006: generate: regeneration changed generated files\";\n", CODES: codesGo});
    assert\equal(check(files).len(), want: 0, message: "clean");
}

test "a throw without the code is reported at its line" {
    final got = check(support\fixture({MAGUSFILE: "x\n    throw \"generate: regeneration changed generated files\";\n", CODES: codesGo}));
    assert\equal(got.len(), want: 1, message: "one finding");
    assert\equal(got[0].line, want: 2, message: "line");
    assert\equal(got[0].message, want: "the whole-tree drift throw does not carry MGS4006", message: "message");
}

test "a reworded throw or a moved constant is reported" {
    assert\equal(support\messages(check(support\fixture({MAGUSFILE: "x\n", CODES: codesGo}))),
        want: ["the whole-tree drift throw moved or was reworded"], message: "reworded");
    assert\equal(support\messages(check(support\fixture({MAGUSFILE: "x\n", CODES: "package types\n"}))),
        want: ["declares no StaleGeneratedOutput code"], message: "constant moved");
}
