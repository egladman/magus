// Tier 1, mechanical: a missing host link is a fact of the tree, found without judgment.
// Authored skills are neutral sources; bootstrap installs their host links.
namespace localskills;

import "assert";
import "path";
import "magus/lint";
import "hack/lint/support" as support;

export final AGENTS = ".agents/skills";
final STAMP = "generated by: magus agent install";

export fun reads() > [str] {
    return [AGENTS + "/*/SKILL.md", ".gitignore"];
}

export fun check(files: [Path]) > [Finding] !> any {
    final ignore = support\named(files, p: ".gitignore");
    if (ignore == null) { return [support\missing(".gitignore")]; }
    final skills = mut [<str>];
    foreach (f in files) {
        if (!path\matches(AGENTS + "/*/SKILL.md", path: f.value)) { continue; }
        if (support\read(f).indexOf(STAMP) != null) { continue; }
        skills.append(f.value.sub(AGENTS.len() + 1, len: f.value.len() - AGENTS.len() - "/SKILL.md".len() - 1));
    }
    return findings(skills, ignore: support\read(ignore!));
}

export fun findings(skills: [str], ignore: str) > [Finding] !> any {
    final found = mut [<Finding>];
    final lines = "\n" + ignore + "\n";
    foreach (name in support\sorted(skills)) {
        if (lines.indexOf("\n!" + AGENTS + "/" + name + "\n") == null) {
            found.append(Finding{path = ".gitignore",
                message = "{AGENTS}/{name} is an authored skill, but .gitignore has no negation for its canonical source",
                fix = "Add !{AGENTS}/{name} without a trailing slash; bootstrap installs its host links."});
        }
    }
    foreach (dir in [".claude", ".codex", ".cursor", ".opencode"]) {
        if (lines.indexOf("\n/" + dir + "/\n") == null) {
            found.append(Finding{path = ".gitignore", message = "{dir} is an installed harness tree and must remain local",
                fix = "Add /{dir}/ to .gitignore; commit the neutral harness sources instead."});
        }
    }
    return found;
}

final INSTALLED = "/.claude/\n/.codex/\n/.cursor/\n/.opencode/\n";

test "canonical authored skill and ignored installations pass without host links" {
    assert\equal(findings(["a"], ignore: INSTALLED + "!.agents/skills/a\n").len(), want: 0, message: "neutral source");
}

test "an ignored canonical source is reported" {
    final got = findings(["a"], ignore: INSTALLED);
    assert\equal(got.len(), want: 1, message: "one source missing");
    assert\isTrue(got[0].message.indexOf("canonical source") != null, message: "source");
}

test "a trailing slash is not a canonical source exception" {
    assert\equal(findings(["a"], ignore: INSTALLED + "!.agents/skills/a/\n").len(), want: 1, message: "exact exception");
}

test "a host installation must be ignored" {
    final got = findings([<str>], ignore: INSTALLED.replace("/.cursor/\n", with: ""));
    assert\equal(got.len(), want: 1, message: "one host");
    assert\isTrue(got[0].message.indexOf(".cursor") != null, message: "host");
}
