// local-skills-reach-every-host holds hand-written skills to one layout.
// The source sits in .agents/skills, which Codex, Cursor and OpenCode read.
// Claude Code reads only .claude/skills, so that entry is a tracked symlink.
// Installed skills carry a stamp and are skipped.
//
// Tier 1, mechanical: the fix is a symlink or a .gitignore negation.
namespace localskills;

import "assert";
import "fs";
import "path";
import "magus/lint";
import "hack/lint/support" as support;

export final AGENTS = ".agents/skills";
export final CLAUDE = ".claude/skills";

final STAMP = "generated by: magus agent install";

export fun reads() > [str] {
    return [AGENTS + "/*/SKILL.md", CLAUDE + "/*/SKILL.md", ".gitignore"];
}

fun skillName(p: str, dir: str) > str {
    return p.sub(dir.len() + 1, len: p.len() - dir.len() - "/SKILL.md".len() - 1);
}

fun diskPath(f: Path, p: str) > str {
    if (f.base == "") {
        return p;
    }
    return f.base + "/" + p;
}

export fun check(files: [Path]) > [Finding] !> any {
    final ignore = support\named(files, p: ".gitignore");
    if (ignore == null) {
        return [support\missing(".gitignore")];
    }
    final agents = mut [<str>];
    final claude = mut [<str>];
    final links: mut {str: str} = mut {};
    foreach (f in files) {
        final inAgents = path\matches(AGENTS + "/*/SKILL.md", path: f.value);
        final inClaude = path\matches(CLAUDE + "/*/SKILL.md", path: f.value);
        if (!inAgents and !inClaude) {
            continue;
        }
        if (support\read(f).indexOf(STAMP) != null) {
            continue;
        }
        final dir = if (inAgents) AGENTS else CLAUDE;
        final name = skillName(f.value, dir: dir);
        if (inAgents) {
            agents.append(name);
        } else {
            claude.append(name);
        }
        links[name] = fs\readlink(diskPath(f, p: CLAUDE + "/" + name)) catch "";
    }
    return findings(agents, claude: claude, links: links, ignore: support\read(ignore!));
}

// findings grades each hand-written skill. links maps a .claude/skills name
// to its symlink target, or "" for a real directory.
export fun findings(agents: [str], claude: [str], links: {str: str}, ignore: str) > [Finding] !> any {
    final found = mut [<Finding>];
    final lines = "\n" + ignore + "\n";
    foreach (name in support\sorted(agents)) {
        final want = "../../" + AGENTS + "/" + name;
        if ((links[name] ?? "") != want) {
            found.append(Finding{ path = CLAUDE + "/" + name,
                message = "{AGENTS}/{name} is a hand-written skill, but {CLAUDE}/{name} is not a symlink to it, so Claude Code cannot see it",
                fix = "Run: ln -s {want} {CLAUDE}/{name}" });
        }
        foreach (dir in [AGENTS, CLAUDE]) {
            if (lines.indexOf("\n!" + dir + "/" + name + "\n") == null) {
                found.append(Finding{ path = ".gitignore",
                    message = "{dir}/{name} is a hand-written skill, but .gitignore has no negation for it, so a fresh clone lacks it",
                    fix = "Add the line !{dir}/{name} (no trailing slash: git sees a symlink as a file)." });
            }
        }
    }
    foreach (name in support\sorted(claude)) {
        if ((links[name] ?? "") == "") {
            found.append(Finding{ path = CLAUDE + "/" + name + "/SKILL.md",
                message = "{CLAUDE}/{name} is a hand-written skill kept only where Claude Code reads it; Codex, Cursor and OpenCode never see it",
                fix = "Move it to {AGENTS}/{name} and link {CLAUDE}/{name} to it." });
        }
    }
    return found;
}

final IGNORE = "x\n!.agents/skills/a\n!.claude/skills/a\n";

test "a skill with its link and both negations passes" {
    final got = findings(["a"], claude: ["a"], links: {"a": "../../.agents/skills/a"}, ignore: IGNORE);
    assert\equal(got.len(), want: 0, message: "clean");
}

test "a skill with no symlink is reported at the link" {
    final got = findings(["a"], claude: [<str>], links: {<str: str>}, ignore: IGNORE);
    assert\equal(support\messages(got), want: [
        ".agents/skills/a is a hand-written skill, but .claude/skills/a is not a symlink to it, so Claude Code cannot see it",
    ], message: "missing link");
}

test "a negation with a trailing slash does not count" {
    final got = findings(["a"], claude: ["a"], links: {"a": "../../.agents/skills/a"}, ignore: "!.agents/skills/a\n!.claude/skills/a/\n");
    assert\equal(got.len(), want: 1, message: "one");
    assert\equal(got[0].path, want: ".gitignore", message: "path");
}

test "a skill kept only under .claude is reported" {
    final got = findings([<str>], claude: ["b"], links: {"b": ""}, ignore: IGNORE);
    assert\equal(support\messages(got), want: [
        ".claude/skills/b is a hand-written skill kept only where Claude Code reads it; Codex, Cursor and OpenCode never see it",
    ], message: "orphan");
}
