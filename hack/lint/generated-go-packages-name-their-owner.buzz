// generated-go-packages-name-their-owner holds every Go package under a gen/ directory to
// a clause of its own: never `gen` or `mocks`, which several packages would share and
// every importer would alias, a mockery double named `<package>test` after the standard
// library's httptest, and no clause two generated packages share. The walk prunes gen/,
// so the rule asks the graph for the directories rather than reading handed-in files.
namespace generatedpackages;

import "assert";
import "fs";
import "magus";
import "magus/lint";
import "hack/lint/support" as support;

// SHARED are clauses many generated packages would take, each needing an alias.
final SHARED = {"gen": true, "mocks": true};

// GeneratedPackage is one Go directory under gen/ and the clause its files declare.
export object GeneratedPackage {
    dir: str,
    clause: str,
    mockery: bool,
}

export fun reads() > [str] {
    return [".mockery.yaml"];
}

export fun check(files: [Path]) > [Finding] !> any {
    final found = mut [<GeneratedPackage>];
    final dirs: [magus\Dir] = magus\dirs("**/gen/**", opts: magus\DirsOptions{ language = "go" });
    foreach (d in dirs) {
        if (d.path.indexOf("testdata") != null) {
            continue;
        }
        if (inspect(d.path) -> p) {
            found.append(p);
        }
    }
    return judge(found);
}

// inspect reads the package clause dir's Go files declare, or null when it holds none.
// A `_test` suffix is an external test package of the same clause.
export fun inspect(dir: str) > GeneratedPackage? !> any {
    var clause = "";
    var mockery = false;
    foreach (name in fs\listDir(dir)) {
        if (!name.endsWith(".go")) {
            continue;
        }
        final src = fs\readFile(fs\join(dir, name: name));
        if (src.indexOf("Code generated by mockery") != null) {
            mockery = true;
        }
        if (clause == "") {
            clause = packageClause(src);
        }
    }
    if (clause == "") {
        return null;
    }
    return GeneratedPackage{ dir = dir, clause = clause, mockery = mockery };
}

// packageClause is the name a Go file's package clause declares, without a _test suffix.
export fun packageClause(src: str) > str {
    foreach (line in src.split("\n")) {
        if (line.startsWith("package ")) {
            final name = line.sub(8, len: line.len() - 8).trim();
            if (name.endsWith("_test")) {
                return name.sub(0, len: name.len() - 5);
            }
            return name;
        }
    }
    return "";
}

// judge reports each package whose clause is shared by convention, a mockery double not
// named <package>test, and every package past the first that takes a clause another
// generated package already declares.
export fun judge(pkgs: [GeneratedPackage]) > [Finding] {
    final found = mut [<Finding>];
    final owner = mut {<str: str>};
    foreach (p in pkgs) {
        if (SHARED[p.clause] != null) {
            found.append(Finding{ path = p.dir,
                message = "the generated package in {p.dir} is named {p.clause}, which other generated packages would share",
                fix = "Name it for its owner: <owner>gen for a generator's output (bindgen, flaggen), <package>test for test doubles." });
        } else if (p.mockery and !p.clause.endsWith("test")) {
            found.append(Finding{ path = p.dir,
                message = "the mockery doubles in {p.dir} are package {p.clause}, not <package>test",
                fix = "Set pkgname in .mockery.yaml to <package>test, as the top-level template does." });
        }
        if (owner[p.clause] -> first) {
            found.append(Finding{ path = p.dir,
                message = "the generated package in {p.dir} is named {p.clause}, as is {first}",
                fix = "Give one of them a clause of its own; an importer of both would alias one." });
        } else {
            owner[p.clause] = p.dir;
        }
    }
    return found;
}

test "owner-named packages and test doubles pass" {
    final pkgs = [
        GeneratedPackage{ dir = "cmd/magus/gen", clause = "flaggen", mockery = false },
        GeneratedPackage{ dir = "spells/gen/spellstest", clause = "spellstest", mockery = true },
    ];
    assert\equal(judge(pkgs).len(), want: 0, message: "clean");
}

test "a shared clause, a misnamed double and a duplicate are each reported" {
    final got = support\messages(judge([
        GeneratedPackage{ dir = "a/gen", clause = "gen", mockery = false },
        GeneratedPackage{ dir = "b/gen/mocks", clause = "bmocks", mockery = true },
        GeneratedPackage{ dir = "c/gen", clause = "flaggen", mockery = false },
        GeneratedPackage{ dir = "d/gen", clause = "flaggen", mockery = false },
    ]));
    assert\equal(got, want: [
        "the generated package in a/gen is named gen, which other generated packages would share",
        "the mockery doubles in b/gen/mocks are package bmocks, not <package>test",
        "the generated package in d/gen is named flaggen, as is c/gen",
    ], message: "findings");
}

test "the clause drops an external test suffix" {
    assert\equal(packageClause("// Code generated.\n\npackage spellstest_test\n"), want: "spellstest", message: "suffix");
    assert\equal(packageClause("//go:build wasm\n\npackage bindgen\n"), want: "bindgen", message: "build tag first");
    assert\equal(packageClause("no clause"), want: "", message: "none");
}

test "this repository's generated packages each name their owner" {
    assert\equal(support\messages(check([<Path>])), want: [<str>], message: "the tree");
}
