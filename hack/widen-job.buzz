// Adds write paths to a live job without touching its state, which a CLI re-fork would
// reset to declared.
//
//	magus buzz hack/widen-job.buzz -- --job <id> [--drop <prefix>] -- <path>...
//
// magus\job\put REPLACES a named list, so this reads the row, merges, and puts the whole
// list back. --drop removes every write path starting with <prefix> first, for swapping
// a placeholder path for the real one.
namespace widenjob;

import "flags";
import "magus";
import "std";

import "assert";

final USAGE = "usage: magus buzz hack/widen-job.buzz -- --job <id> [--drop <prefix>] -- <path>...";

export fun widen(current: [str], add: [str], drop: str) > [str] {
    final paths = mut [<str>];
    foreach (p in current) {
        if ((drop == "" or !p.startsWith(drop)) and paths.indexOf(p) == null) {
            paths.append(p);
        }
    }
    foreach (p in add) {
        if (paths.indexOf(p) == null) {
            paths.append(p);
        }
    }
    return paths;
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: [], valued: ["--job", "--drop"]);
    if (parsed.unknown.len() > 0) {
        throw "widen-job: unknown {parsed.unknown.join(" ")}\n{USAGE}";
    }
    final id = parsed.values["--job"] ?? "";
    if (id == "") {
        throw "widen-job: --job is required\n{USAGE}";
    }
    final add = parsed.positionals;
    final drop = parsed.values["--drop"] ?? "";
    if (add.len() == 0 and drop == "") {
        throw "widen-job: nothing to add or drop\n{USAGE}";
    }

    final list: magus\JobList = magus\job\list();
    var current: [str]? = null;
    foreach (j in list.jobs) {
        if (j.id == id) {
            current = j.writePaths;
        }
    }
    if (current == null) {
        throw "widen-job: there is no job {id} (run `magus ls jobs` to see them)";
    }
    final paths = widen(current!, add: add, drop: drop);
    final row: magus\Job = magus\job\put(id, opts: {"write_paths": paths});
    std\print("{row.id} {row.state}: {row.writePaths.len()} write paths");
}

test "widen appends new paths once and keeps the order" {
    assert\equal(widen(["a", "b"], add: ["b", "c"], drop: ""), want: ["a", "b", "c"], message: "dedupe and append");
}

test "widen drops a prefix before adding" {
    assert\equal(widen(["x/old.go", "x/old_test.go", "y"], add: ["x/new/**"], drop: "x/old"), want: ["y", "x/new/**"], message: "drop then add");
}
