// Comment once on a PR whose merge conflicts land in GENERATED files.
//
// GitHub never runs a merge driver, so those conflicts cannot resolve themselves and the
// web editor is the worst place to try: the correct merge of build output is whatever
// regenerating produces, which is what `magus vcs resolve` does. Silent unless generated
// files actually conflict - an ordinary source conflict is the author's business.
//
// Reads PR_NUMBER and PR_BASE from the environment; shells out to `gh` to comment.
import "os";
import "fs";
import "serialize";
import "std";

final bodyFile = "/tmp/merge-conflict-advice.md";
final marker = "<!-- magus:merge-conflict-advice -->";

fun env(name: str) > str {
    final v = os\env(name);
    if (v == null) { return ""; }
    return "" + v;
}

fun git(argv: [str], tolerate: bool) > str {
    return os\exec("git", args: argv, dir: ".", opts: {"allow_failure": tolerate}).stdout;
}

// conflicted merges base into the checkout to learn which paths collide, then aborts.
// `gh pr view --json mergeable` reports only THAT a PR conflicts, never which files, and
// the files decide both whether to comment and what to name.
fun conflicted(base: str) > [str] {
    git(["fetch", "--no-tags", "origin", base], tolerate: false);
    var paths = mut [];
    if (!os\exec("git", args: ["merge", "--no-commit", "--no-ff", "origin/" + base],
            dir: ".", opts: {"allow_failure": true}).ok) {
        foreach (line in git(["diff", "--name-only", "--diff-filter=U"], tolerate: false).split("\n")) {
            if (line != "") { paths.append(line); }
        }
    }
    git(["merge", "--abort"], tolerate: true);
    return paths;
}

// generated keeps the paths the workspace declares as build output (role: output).
fun generated(paths: [str]) > [str] {
    var found = mut [];
    if (paths.len() == 0) { return found; }
    var argv = mut ["describe", "file"];
    foreach (p in paths) { argv.append(p); }
    argv.append("-o");
    argv.append("json");
    final report = os\exec("magus", args: argv, dir: ".", opts: {}).stdout;
    foreach (f in serialize\jsonDecode(report).q("files").listValue()) {
        if (f.q("role").stringValue() == "output") { found.append(f.q("path").stringValue()); }
    }
    return found;
}

fun advice(base: str, files: [str]) > str {
    var body = marker + "\nThis branch conflicts with `" + base + "` in files magus generates:\n\n";
    foreach (f in files) { body = body + "- `" + f + "`\n"; }
    return body
        + "\nThese are build output, so the correct merge is whatever regenerating produces:\n\n"
        + "```sh\ngit merge origin/" + base + "\nmagus vcs resolve\n```\n\n"
        + "`magus vcs resolve` settles every conflicted generated file at once and regenerates "
        + "once. Conflicts in hand-written files are still yours.\n";
}

fun main() > void {
    final pr = env("PR_NUMBER");
    final base = env("PR_BASE");
    if (pr == "" or base == "") {
        throw "merge-conflict-advice: PR_NUMBER and PR_BASE are required";
    }

    final files = generated(conflicted(base));
    if (files.len() == 0) {
        std\print("no generated files conflict with " + base);
        return;
    }

    fs\writeFile(bodyFile, content: advice(base, files: files));
    // --edit-last --create-if-none is the upsert: post once, rewrite in place after that.
    os\exec("gh", args: ["pr", "comment", pr, "--body-file", bodyFile, "--edit-last", "--create-if-none"],
        dir: ".", opts: {});
    std\print("advised on PR " + pr + ": " + files.join(", "));
}

main();
