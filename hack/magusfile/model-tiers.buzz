// The model alias each wired harness spawns for a tier of magus/modeltiers. The root
// magusfile registers these with magus\job.modelTiers. A host left out is refused at
// strict when a job row's spawn names a model, and the refusal names the hosts entry
// to add. Each string is the exact id that host's spawn takes, read from the host's
// own docs on 2026-10-25, not copied from another host's rows.
namespace modeltierhosts;

import "magus/modeltiers" as modeltiers;
import "assert";

// claudeCode keeps the exact id the Claude Code spell's economy, standard and
// principal rows name, so the agents magus ships stay on claude-haiku-5-5. The
// spell's short aliases still resolve a spawn of haiku, sonnet or opus.
export fun claudeCode(tier: modeltiers\ModelTier) > str {
    return match (tier) {
        .economy -> "claude-haiku-5-5",
        .standard -> "claude-sonnet-5-5",
        .principal -> "claude-opus-5-5",
    };
}

// codex follows developers.openai.com/codex/subagents: gpt-6-luna for lighter
// work, gpt-6.1-sol where a task should start, and gpt-6-astra for the flagship
// the model page prices above both.
export fun codexHost(tier: modeltiers\ModelTier) > str {
    return match (tier) {
        .economy -> "gpt-6-luna",
        .standard -> "gpt-6.1-sol",
        .principal -> "gpt-6-astra",
    };
}

// cursor uses Composer 2.5 for the fast rung, Sonnet at medium effort for the
// standard one, and claude-opus-5-5-high, an id this repository already records
// Cursor sending. The spell still writes model inherit on a shipped agent.
export fun cursorHost(tier: modeltiers\ModelTier) > str {
    return match (tier) {
        .economy -> "composer-2.5",
        .standard -> "claude-sonnet-5-5-medium",
        .principal -> "claude-opus-5-5-high",
    };
}

// opencode selects provider/model, as opencode.ai/docs/models shows with
// anthropic/claude-sonnet-5-5. The three rungs are the Claude models the spell
// already prices, under that spelling. The spell sets no model on a shipped agent.
export fun opencodeHost(tier: modeltiers\ModelTier) > str {
    return match (tier) {
        .economy -> "anthropic/claude-haiku-5-5",
        .standard -> "anthropic/claude-sonnet-5-5",
        .principal -> "anthropic/claude-opus-5-5",
    };
}

test "each harness maps the three tiers to the ids its docs name" {
    assert\equal(claudeCode(modeltiers\ModelTier.economy), "claude-haiku-5-5", "shipped agents stay on the exact id");
    assert\equal(claudeCode(modeltiers\ModelTier.standard), "claude-sonnet-5-5", "the spell's standard row");
    assert\equal(claudeCode(modeltiers\ModelTier.principal), "claude-opus-5-5", "the spell's principal row");
    assert\equal(codexHost(modeltiers\ModelTier.economy), "gpt-6-luna", "the lighter Codex model");
    assert\equal(codexHost(modeltiers\ModelTier.standard), "gpt-6.1-sol", "the model Codex says to start with");
    assert\equal(codexHost(modeltiers\ModelTier.principal), "gpt-6-astra", "the flagship above both");
    assert\equal(cursorHost(modeltiers\ModelTier.economy), "composer-2.5", "Cursor's fast model");
    assert\equal(cursorHost(modeltiers\ModelTier.standard), "claude-sonnet-5-5-medium", "Sonnet at medium effort");
    assert\equal(cursorHost(modeltiers\ModelTier.principal), "claude-opus-5-5-high", "the id the agents guide records");
    assert\equal(opencodeHost(modeltiers\ModelTier.economy), "anthropic/claude-haiku-5-5", "OpenCode's provider/model spelling");
    assert\equal(opencodeHost(modeltiers\ModelTier.standard), "anthropic/claude-sonnet-5-5", "the id the OpenCode docs show");
    assert\equal(opencodeHost(modeltiers\ModelTier.principal), "anthropic/claude-opus-5-5", "the same rung as Claude's principal");
}
