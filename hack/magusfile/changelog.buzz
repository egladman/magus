// The changelog's one grammar and its one renderer. pr-changelog, the release preflight and
// the docs changelog page all read fragments through here; changes/README.md describes one.
// `magus-utils cut` still parses them in Go, held to this grammar by the shared cases in
// changes/testdata/fragments.txtar.
namespace changelog;

import "std";
import "fs";
import "sort";
import "semver";
import "template";
import "serialize";
import "encoding/yaml";
import "hack/magusfile/commits" as commits;

// FRAGMENT_DIR holds one file per unreleased entry.
export final FRAGMENT_DIR = "changes/unreleased/";

// GROUPS is Keep a Changelog 1.1.0's group set, in the order it lists them and the page
// renders them.
export final GROUPS = ["Added", "Changed", "Deprecated", "Removed", "Fixed", "Security"];

// WORD_CAP bounds one entry. An entry states the change and why a reader cares; the
// reasoning behind it belongs in the diff, the pull request or an ADR.
export final WORD_CAP = 60;

// Fragment is one parsed entry. entry is the "- **headline**" line and its two-space
// continuations, exactly as written.
export object Fragment {
    path: str,
    group: str,
    entry: str,
}

// Release is one shipped version as releases/<version>.yaml records it. body is the notes
// Markdown verbatim: the older manifests carry prose their structured notes dropped.
export object Release {
    version: str,
    date: str,
    body: str,
}

// problems returns every way text departs from the fragment format, empty when it holds
// exactly one well-formed entry under one known group. Line numbers count from 1.
export fun problems(text: str) > [str] {
    final body = trimEnd(text.replace("\r\n", with: "\n"));
    final found = lintBody(body);
    if (found.len() > 0) {
        return found;
    }
    var group = "";
    var entries = 0;
    foreach (line in body.split("\n")) {
        if (line.startsWith("### ")) {
            if (group != "") {
                return ["holds more than one section heading; write one fragment per entry"];
            }
            group = line.sub(4).trim();
        } else if (line.startsWith("- ")) {
            entries = entries + 1;
        }
    }
    if (group == "") {
        return ["opens with no `### <group>` heading, one of " + GROUPS.join(", ")];
    }
    if (entries != 1) {
        return ["holds {entries} entries; write one fragment per entry"];
    }
    return [<str>];
}

// parse returns the fragment text holds, or throws "<path>: <problem>; <problem>".
export fun parse(path: str, text: str) > Fragment !> str {
    final found = problems(text);
    if (found.len() > 0) {
        throw "{path}: " + found.join("; ");
    }
    var group = "";
    final lines = mut [<str>];
    foreach (line in trimEnd(text.replace("\r\n", with: "\n")).split("\n")) {
        if (line.startsWith("### ")) {
            group = line.sub(4).trim();
        } else if (line != "") {
            lines.append(line);
        }
    }
    return Fragment{ path = path, group = group, entry = lines.join("\n") };
}

// lint returns one "<path>: <problems>" line per malformed fragment among paths, empty
// when all of them parse. A path that is not a .md file or cannot be read is malformed.
export fun lint(paths: [str]) > [str] {
    final found = mut [<str>];
    foreach (path in paths) {
        if (!path.endsWith(".md")) {
            found.append("{path}: not a fragment; fragments are <name>.md files");
            continue;
        }
        final text = fs\readFile(path) catch "\u{0}";
        if (text == "\u{0}") {
            found.append("{path}: cannot be read");
            continue;
        }
        final these = problems(text);
        if (these.len() > 0) {
            found.append("{path}: " + these.join("; "));
        }
    }
    return found;
}

// read parses every fragment in dir in file-name order, the order entries render in within
// a group. A missing dir holds none and dotfiles are skipped. It throws every malformed
// file at once, one per line, rather than the first.
export fun read(dir: str) > [Fragment] !> str {
    final names = mut [<str>];
    foreach (name in fs\listDir(dir)) {
        if (!name.startsWith(".")) { names.append(name); }
    }
    final frags = mut [<Fragment>];
    final errs = mut [<str>];
    foreach (name in sort\strings(names)) {
        final path = fs\join(dir, name);
        if (!name.endsWith(".md") or (fs\isDir(path) catch true)) {
            errs.append("{path}: not a fragment; {dir} holds only <name>.md files");
            continue;
        }
        final these = lint([path]);
        if (these.len() > 0) {
            errs.append(these[0]);
            continue;
        }
        frags.append(parse(path, text: fs\readFile(path) catch ""));
    }
    if (errs.len() > 0) {
        throw errs.join("\n");
    }
    return frags;
}

// releases reads every <version>.yaml manifest in dir, newest first. A manifest whose
// version is not semver, or a dir with none, throws: the page would silently lose history.
export fun releases(dir: str) > [Release] !> any {
    final byVersion = mut {<str: Release>};
    foreach (p in fs\glob(fs\join(dir, "*.yaml"))) {
        final doc = serialize\Boxed.init(yaml\parse(fs\readFile(p.value)));
        final version = doc.q("version").stringValue();
        if (!semver\isValid(version)) {
            throw "{p.value}: version \"{version}\" is not semver";
        }
        byVersion[version] = Release{
            version = version,
            date = doc.q("date").stringValue(),
            body = doc.q("body").stringValue(),
        };
    }
    if (byVersion.size() == 0) {
        throw "no release manifests in {dir} (expected v<semver>.yaml files)";
    }
    final newest = mut [<Release>];
    foreach (version in sort\semver(byVersion.keys()).reverse()) {
        newest.append(byVersion[version]!);
    }
    return newest;
}

// render fills page, a Mustache template, with
// {unreleased: [{group, entries}], releases: [{version, date, body}]}: groups in GROUPS
// order holding their fragments' entries in the order given, and releases as given. Every
// value is Markdown, so the template interpolates it unescaped with {{{...}}}.
export fun render(page: str, fragments: [Fragment], shipped: [Release]) > str !> any {
    final unreleased = mut [<{str: any}>];
    foreach (group in GROUPS) {
        final entries = mut [<str>];
        foreach (f in fragments) {
            if (f.group == group) { entries.append(f.entry); }
        }
        if (entries.len() > 0) {
            unreleased.append({<str: any>, "group": group, "entries": entries});
        }
    }
    final released = mut [<{str: any}>];
    foreach (r in shipped) {
        released.append({<str: any>, "version": r.version, "date": r.date, "body": r.body});
    }
    return template\render(page, data: {<str: any>, "unreleased": unreleased, "releases": released});
}

// lintBody reports the per-line departures: unknown or repeated groups, stray lines, and
// entries without a bold headline, a closing period, or within WORD_CAP words.
fun lintBody(body: str) > [str] {
    final found = mut [<str>];
    var last = -1;
    var inGroup = false;
    var entryLine = 0;
    var entryParts = mut [<str>];
    final lines = body.split("\n");
    foreach (i, line in lines) {
        final n = i + 1;
        final blank = line.trim() == "";
        final continues = !blank and entryLine > 0 and line.startsWith("  ");
        if (!continues and entryLine > 0) {
            foreach (p in entryProblems(entryLine, text: entryParts.join(" ").trim())) { found.append(p); }
            entryLine = 0;
            entryParts = mut [<str>];
        }
        if (blank) {
            continue;
        }
        if (continues) {
            entryParts.append(line.trim());
        } else if (line.startsWith("### ")) {
            inGroup = true;
            final name = line.sub(4).trim();
            final idx = GROUPS.indexOf(name);
            if (idx == null) {
                found.append("line {n}: \"{name}\" is not a Keep a Changelog section (" + GROUPS.join(", ") + ")");
            } else if (idx! <= last) {
                found.append("line {n}: \"{name}\" is out of order or repeated; the order is " + GROUPS.join(", "));
            } else {
                last = idx!;
            }
        } else if (line.startsWith("- ")) {
            if (!inGroup) {
                found.append("line {n}: an entry sits under a section heading");
            }
            entryLine = n;
            entryParts.append(line.sub(2));
        } else {
            found.append("line {n}: not a heading, an entry, or an entry's two-space continuation");
        }
    }
    if (entryLine > 0) {
        foreach (p in entryProblems(entryLine, text: entryParts.join(" ").trim())) { found.append(p); }
    }
    return found;
}

fun entryProblems(line: int, text: str) > [str] {
    final found = mut [<str>];
    if (!text.startsWith("**") or text.split("**").len() < 3) {
        found.append("line {line}: an entry opens with a **bold headline**");
    }
    // A headline-only entry closes its sentence inside the bold.
    if (!text.endsWith(".") and !text.endsWith(".**")) {
        found.append("line {line}: an entry ends with a period");
    }
    var words = 0;
    foreach (w in text.replace("\t", with: " ").split(" ")) {
        if (w != "") { words = words + 1; }
    }
    if (words > WORD_CAP) {
        found.append("line {line}: entry is {words} words; the cap is {WORD_CAP}");
    }
    return found;
}

fun trimEnd(text: str) > str {
    var end = text.len();
    while (end > 0 and (text.sub(end - 1, len: 1) == "\n" or text.sub(end - 1, len: 1) == " ")) {
        end = end - 1;
    }
    return text.sub(0, len: end);
}

// problem returns "" when a pull request titled title, changing the repository-relative
// paths in changed and adding or editing the fragments in added (see fragments), passes,
// and otherwise the reason it fails, phrased to be printed as is.
//
// An entry is owed only when the title's type is feat, fix or perf, or the title is marked
// breaking, AND a changed path ships. The title is the author's claim about what a user
// notices; the paths keep a feat that only moved tests from owing one. There is no waiver:
// a change no user notices is retitled rather than excused.
export fun problem(title: str, changed: [str], added: [str]) > str {
    final titleProblem = commits\problem(title);
    if (titleProblem != "") {
        return "title \"{title}\" does not say whether an entry is owed: {titleProblem}";
    }
    final shipped = owed(title, changed: changed);
    if (shipped.len() == 0 or added.len() > 0) {
        return "";
    }
    var listed = shipped.join("\n  ");
    if (shipped.len() > 10) {
        listed = shipped.sub(0, len: 10).join("\n  ") + "\n  ...and {shipped.len() - 10} more";
    }
    return "\"{title}\" changes {shipped.len()} shipped path(s) and adds no changelog fragment. "
        + "Add {FRAGMENT_DIR}<branch>.md (changes/README.md has the format); if no user can "
        + "notice the change, its type is not feat, fix or perf, so retitle it.\n  " + listed;
}

// owed returns the paths in changed that make a pull request titled title owe an entry:
// the shipped ones when the title's type is feat, fix or perf or it is marked breaking,
// and none otherwise.
export fun owed(title: str, changed: [str]) > [str] {
    if (!commits\isBreaking(title) and ["feat", "fix", "perf"].indexOf(commits\typeOf(title)) == null) {
        return [<str>];
    }
    var shipped = mut [<str>];
    foreach (path in changed) {
        if (ships(path)) { shipped.append(path); }
    }
    return shipped;
}

// ships reports whether a change to path, relative to the repository root, reaches a user
// of a released magus.
//
// Everything ships unless listed here. Failing closed means a new top-level directory
// counts as shipped until someone decides otherwise.
// .github/actions is NOT exempt: other workspaces `uses:` those actions.
export fun ships(path: str) > bool {
    if (path.endsWith(".md") or path.endsWith("_test.go") or path.endsWith(".test.ts")) {
        return false;
    }
    if (path.indexOf("/testdata/") != null or path.startsWith("testdata/")) {
        return false;
    }
    if (path == "magusfile.buzz" or path.endsWith("/magusfile.buzz")) {
        return false;
    }
    // Repository tooling, plans and host wiring for working on magus itself. The root gen/
    // holds this repository's own graphs and test mocks, which move with any magusfile edit.
    final exemptDirs = [
        ".claude/", ".codex/", ".cursor/", ".github/workflows/", "benchmarks/", "blog/",
        "cmd/magus-", "gen/", "hack/", "notes/", "releases/", "tapes/",
    ];
    foreach (dir in exemptDirs) {
        if (path.startsWith(dir)) { return false; }
    }
    final exemptFiles = [
        ".gitignore", "_typos.toml", "badge.buzz", "dprint-base.json",
        "dprint.json", "magus.yaml", "mise.toml", "opencode.json", "releaser.buzz",
    ];
    if (exemptFiles.indexOf(path) != null) {
        return false;
    }
    // The docs site is prose, except the guard templates a harness runs by path.
    if (path.startsWith("docs/") and !path.startsWith("docs/guides/integrations/agents/")) {
        return false;
    }
    return true;
}

// fragments returns the paths in changed that are changelog fragments. The caller keeps
// only those still present, since a release deletes the fragments it folds. A path is
// changed against the merge base, so a branch behind main finds exactly its own; an
// edited fragment counts, as a reworded entry always has.
export fun fragments(changed: [str]) > [str] {
    var found = mut [<str>];
    foreach (path in changed) {
        if (path.startsWith(FRAGMENT_DIR) and path.endsWith(".md")) { found.append(path); }
    }
    return found;
}

test "engine code ships and the exempt paths do not" {
    std\assert(ships("internal/cache/key.go"), message: "engine code");
    std\assert(ships("spells/golang/spell.buzz"), message: "a built-in spell");
    std\assert(ships(".github/actions/advice/action.yml"), message: "an action other workspaces use");
    std\assert(ships("docs/guides/integrations/agents/magus-command.buzz"), message: "a guard template a harness runs");
    std\assert(ships("go.mod"), message: "dependencies ship in the binary");
    std\assert(!ships("docs/concepts/targets.md"), message: "docs");
    std\assert(!ships("internal/agent/skills/magus-run/SKILL.md"), message: "markdown anywhere");
    std\assert(!ships("internal/cache/key_test.go"), message: "a Go test");
    std\assert(!ships("cmd/magus/testdata/run.txtar"), message: "testdata");
    std\assert(!ships(".github/workflows/ci.yaml"), message: "a workflow");
    std\assert(!ships("libs/gopherbuzz/magusfile.buzz"), message: "a project's build");
    std\assert(!ships("cmd/magus-utils/release.go"), message: "a repository tool");
    std\assert(!ships("docs/render.buzz"), message: "the docs renderer");
    std\assert(!ships("gen/target-graph.json"), message: "the repository's own graph");
    std\assert(ships("cmd/magus/gen/cli_flags.go"), message: "generated code in the binary");
}

test "a feat touching shipped paths without an entry fails" {
    final got = problem("feat(cache): add a key", changed: ["internal/cache/key.go"], added: [<str>]);
    std\assert(got.startsWith("\"feat(cache): add a key\" changes 1 shipped path(s)"), message: got);
    std\assert(got.endsWith("\n  internal/cache/key.go"), message: "names the shipped path");
    std\assert(problem("feat(cache): add a key", changed: ["internal/cache/key.go"], added: ["changes/unreleased/key.md"]) == "",
        message: "a fragment covers it");
}

test "a refactor touching shipped paths passes" {
    std\assert(problem("refactor(cache): split the key", changed: ["internal/cache/key.go"], added: [<str>]) == "",
        message: "refactor");
    foreach (kind in ["build", "chore", "ci", "docs", "revert", "test"]) {
        std\assert(problem("{kind}: tidy", changed: ["internal/cache/key.go"], added: [<str>]) == "", message: kind);
    }
}

test "a feat touching only tests passes" {
    std\assert(problem("feat: cover the key", changed: ["internal/cache/key_test.go", "cmd/magus/testdata/run.txtar"],
        added: [<str>]) == "", message: "nothing shipped");
}

test "a breaking chore touching shipped paths fails" {
    final got = problem("chore!: drop go 1.24", changed: ["go.mod", "docs/install.md"], added: [<str>]);
    std\assert(got.endsWith("retitle it.\n  go.mod"), message: got);
    std\assert(problem("perf: skip a probe", changed: ["internal/cache/key.go"], added: [<str>]) != "", message: "perf owes one");
    std\assert(problem("fix: keep the key", changed: ["internal/cache/key.go"], added: [<str>]) != "", message: "fix owes one");
}

test "a title that is not a conventional subject is a failure, not a pass" {
    final got = problem("Refactor the cache", changed: ["internal/cache/key.go"], added: [<str>]);
    std\assert(got.startsWith("title \"Refactor the cache\" does not say whether an entry is owed: no `<type>: ` prefix"),
        message: got);
    std\assert(problem("", changed: [<str>], added: [<str>]) != "", message: "an empty title");
}

test "only markdown files under the fragment directory are fragments" {
    final got = fragments(["internal/cache/key.go", "changes/unreleased/key.md", "changes/README.md",
        "changes/unreleased/notes.txt", "CHANGELOG.md"]);
    std\assert(got.len() == 1 and got[0] == "changes/unreleased/key.md", message: "{got}");
    std\assert(!ships("changes/unreleased/key.md"), message: "a fragment ships nothing itself");
}

// cases splits the shared fixture into its named files. cmd/magus-utils reads the same one
// with go-internal's txtar, so this follows that format: a "-- name --" line opens a file.
fun cases() > {str: str} !> any {
    final files = mut {<str: str>};
    var name = "";
    var lines = mut [<str>];
    foreach (line in fs\readFile("changes/testdata/fragments.txtar").split("\n")) {
        if (line.startsWith("-- ") and line.endsWith(" --") and line.len() > 6) {
            if (name != "") { files[name] = lines.join("\n"); }
            name = line.sub(3, len: line.len() - 6);
            lines = mut [<str>];
        } else if (name != "") {
            lines.append(line);
        }
    }
    if (name != "") { files[name] = lines.join("\n"); }
    return files;
}

test "every valid fixture parses and every invalid one names its problem" {
    final files = cases() catch mut {<str: str>};
    var valid = 0;
    var invalid = 0;
    foreach (name, text in files) {
        if (name.startsWith("valid/")) {
            valid = valid + 1;
            std\assert(problems(text).len() == 0, message: "{name}: {problems(text)}");
        } else if (name.startsWith("invalid/") and name.endsWith(".md")) {
            invalid = invalid + 1;
            final want = (files[name.sub(0, len: name.len() - 3) + ".want"] ?? "").trim();
            std\assert(want != "", message: "{name} has a .want beside it");
            final got = problems(text).join("; ");
            std\assert(got.indexOf(want) != null, message: "{name}: want \"{want}\", got \"{got}\"");
        }
    }
    std\assert(valid >= 3 and invalid >= 10, message: "the fixture read: {valid} valid, {invalid} invalid");
}

test "parse keeps the group and the entry as written" {
    final text = (cases() catch mut {<str: str>})["valid/removed-breaking.md"] ?? "";
    final got = parse("f.md", text: text) catch Fragment{ path = "", group = "", entry = "" };
    std\assert(got.path == "f.md" and got.group == "Removed", message: "{got.path} {got.group}");
    std\assert(got.entry == "- **Breaking: the `exclusive` option.** Delete\n  the key.", message: got.entry);
    final err = parse("f.md", text: "### Fix\n\n- **A thing.**\n") catch "threw";
    std\assert(err is str, message: "an unknown group throws");
}

test "lint names every malformed path and passes good ones" {
    final dir = fs\tempDir("fragments") catch "";
    fs\writeFile(fs\join(dir, "ok.md"), content: "### Security\n\n- **Patched.**\n") catch void;
    fs\writeFile(fs\join(dir, "bad.md"), content: "### Added\n\n- no headline\n") catch void;
    std\assert(lint([fs\join(dir, "ok.md")]).len() == 0, message: "a good fragment");
    final got = lint([fs\join(dir, "ok.md"), fs\join(dir, "bad.md"), fs\join(dir, "x.txt"), fs\join(dir, "gone.md")]);
    std\assert(got.len() == 3, message: "{got}");
    std\assert(got[0] == fs\join(dir, "bad.md") + ": line 3: an entry opens with a **bold headline**; line 3: an entry ends with a period",
        message: got[0]);
    std\assert(got[1].endsWith("x.txt: not a fragment; fragments are <name>.md files"), message: got[1]);
    std\assert(got[2].endsWith("gone.md: cannot be read"), message: got[2]);
    fs\removeAll(dir) catch void;
}

test "read skips dotfiles, reports every bad file, and orders by name" {
    std\assert((read("changes/testdata/absent") catch [<Fragment>]).len() == 0, message: "a missing dir holds none");
    final dir = fs\tempDir("fragments") catch "";
    fs\writeFile(fs\join(dir, ".DS_Store"), content: "binary") catch void;
    fs\writeFile(fs\join(dir, "b.md"), content: "### Added\n\n- **Second.**\n") catch void;
    fs\writeFile(fs\join(dir, "a.md"), content: "### Added\n\n- **First.**\n") catch void;
    final good = read(dir) catch [<Fragment>];
    std\assert(good.len() == 2 and good[0].entry == "- **First.**", message: "{good.len()}");
    fs\writeFile(fs\join(dir, "bad.md"), content: "### Fix\n\n- **Typo.**\n") catch void;
    fs\writeFile(fs\join(dir, "notes.txt"), content: "### Added\n\n- **Wrong extension.**\n") catch void;
    var err = "";
    try {
        read(dir);
    } catch (e) {
        err = e;
    }
    std\assert(err.indexOf("bad.md: line 1: \"Fix\" is not a Keep a Changelog section") != null, message: err);
    std\assert(err.indexOf("notes.txt: not a fragment") != null, message: err);
    fs\removeAll(dir) catch void;
}

test "render groups entries in Keep a Changelog order under the page's template" {
    final page = fs\readFile("docs/templates/changelog.mustache") catch "";
    final frags = [
        Fragment{ path = "c.md", group = "Fixed", entry = "- **A fix.**" },
        Fragment{ path = "a.md", group = "Added", entry = "- **First.**" },
        Fragment{ path = "b.md", group = "Added", entry = "- **Second.** It\n  wraps & <escapes>." },
    ];
    final shipped = [Release{ version = "v0.1.0", date = "2026-01-02", body = "### Added\n\n- **Shipped.**" }];
    final got = render(page, fragments: frags, shipped: shipped) catch "render threw";
    final want = "## [Unreleased]\n\n### Added\n\n- **First.**\n- **Second.** It\n  wraps & <escapes>.\n\n"
        + "### Fixed\n\n- **A fix.**\n\n## [v0.1.0] - 2026-01-02\n\n### Added\n\n- **Shipped.**\n";
    std\assert(got.endsWith(want), message: got);
    std\assert(lintBody("### Added\n\n- **First.**\n- **Second.** It\n  wraps.\n\n### Fixed\n\n- **A fix.**").len() == 0,
        message: "the rendered groups lint clean");
    final empty = render(page, fragments: [<Fragment>], shipped: shipped) catch "render threw";
    std\assert(empty.indexOf("## [Unreleased]\n\n## [v0.1.0]") != null, message: empty);
}

test "releases reads the manifests newest first" {
    final got = releases("releases") catch [<Release>];
    std\assert(got.len() > 1, message: "{got.len()}");
    foreach (i, r in got) {
        if (i > 0) {
            std\assert(semver\compare(got[i - 1].version, b: r.version) > 0, message: "{got[i - 1].version} before {r.version}");
        }
    }
    std\assert(got[0].body != "" and got[0].date != "", message: got[0].version);
}
