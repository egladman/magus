namespace mockassert;

import "fs";
import "sort";
import "std";
import "serialize";
import "encoding/yaml";

final MODULE = "github.com/egladman/magus";

// AssertFile is one generated assertion file: its workspace path and its bytes.
export object AssertFile {
    path: str,
    body: str,
}

// isInternal reports a package no consumer can import. Its mocks serve only this repo's
// tests, which fail at the use site, and those tests sit in the mocked package itself
// (internal/dry/eval_test.go is `package dry`), so an assertion importing it would close
// an import cycle.
fun isInternal(pkgPath: str) > bool {
    return pkgPath.indexOf("/internal/") != null or pkgPath.endsWith("/internal");
}

// mocksDir mirrors .mockery.yaml's dir template, "{{.InterfaceDir}}/gen/mocks". The
// module root is the one case the template's path arithmetic leaves empty.
fun mocksDir(pkgPath: str) > str !> any {
    if (pkgPath == MODULE) {
        return "gen/mocks";
    }
    if (pkgPath.startsWith(MODULE + "/")) {
        return pkgPath.sub(MODULE.len() + 1) + "/gen/mocks";
    }
    throw "package \"{pkgPath}\" is outside {MODULE}; this generator only knows this module";
}

// render is one package's assertion file, already in gofmt's layout: the var block's
// type column is padded to its widest entry. The import takes a fixed alias because a
// package name is not derivable from its path (project/impact is package impact, the
// module root package magus).
export fun render(pkgPath: str, interfaces: [str]) > str {
    var width = 0;
    foreach (name in interfaces) {
        if (name.len() > width) { width = name.len(); }
    }
    final lines = mut [<str>];
    foreach (name in interfaces) {
        lines.append("\t_ iface.{name}" + " ".repeat(width - name.len()) + " = (*Mock{name})(nil)\n");
    }
    return "// Code generated by hack/magusfile/mockassert.buzz; DO NOT EDIT.\n"
        + "//\n"
        + "// Each line fails to compile when a mock stops satisfying the interface it was\n"
        + "// generated from, which mockery's own output does not check. Regenerate with\n"
        + "// `magus run generate` after changing .mockery.yaml or an interface.\n\n"
        + "package mocks\n\n"
        + "import iface \"{pkgPath}\"\n\n"
        + "var (\n"
        + lines.join("")
        + ")\n";
}

// files derives, from .mockery.yaml's text, the assertion file each published mocked
// package gets, interfaces sorted by byte so the output is stable. Raises on a config
// declaring no packages, which means its schema moved rather than that nothing is
// mocked, and on a package outside this module.
//
// mockery's testify template emits no `var _ Iface = (*Mock)(nil)`, so a stale mock still
// compiles and fails only at a use site, and a published mock has none here: the first
// build to break would be a consumer's. A file beside mockery's output rather than a
// forked template, which a mockery upgrade would silently keep rendering stale.
export fun files(config: str) > [AssertFile] !> any {
    final packages = serialize\Boxed.init(yaml\parse(config)).q(["packages"]).mapValue();
    if (packages.size() == 0) {
        throw "the mockery config declares no packages";
    }
    final assertions = mut [<AssertFile>];
    foreach (pkgPath in sort\strings(packages.keys())) {
        if (isInternal(pkgPath)) { continue; }
        final names = sort\strings(packages[pkgPath]!.q(["interfaces"]).mapValue().keys());
        if (names.len() == 0) { continue; }
        assertions.append(AssertFile{
            path = mocksDir(pkgPath) + "/assert.go",
            body = render(pkgPath, interfaces: names),
        });
    }
    return assertions;
}

// write writes each file beside the mocks mockery produced, leaving an unchanged file
// untouched so its mtime does not dirty every downstream target.
export fun write(files: [AssertFile]) > void !> any {
    foreach (f in files) {
        if (fs\exists(f.path) and fs\readFile(f.path) == f.body) { continue; }
        fs\writeFile(f.path, content: f.body);
    }
}

test "the var block pads the type column the way gofmt does" {
    final want = "// Code generated by hack/magusfile/mockassert.buzz; DO NOT EDIT.\n"
        + "//\n"
        + "// Each line fails to compile when a mock stops satisfying the interface it was\n"
        + "// generated from, which mockery's own output does not check. Regenerate with\n"
        + "// `magus run generate` after changing .mockery.yaml or an interface.\n"
        + "\n"
        + "package mocks\n"
        + "\n"
        + "import iface \"github.com/egladman/magus/types\"\n"
        + "\n"
        + "var (\n"
        + "\t_ iface.Inspector  = (*MockInspector)(nil)\n"
        + "\t_ iface.Repository = (*MockRepository)(nil)\n"
        + ")\n";
    std\assert(render("github.com/egladman/magus/types", interfaces: ["Inspector", "Repository"]) == want,
        message: "render");
}

test "only published packages that mock something get a file" {
    final got = files(`packages:
  github.com/egladman/magus/types:
    interfaces:
      Repository:
      Inspector:
  github.com/egladman/magus:
    interfaces:
      Server:
  github.com/egladman/magus/internal/dry:
    interfaces:
      Evaluator:
  github.com/egladman/magus/internalize:
    interfaces:
      Thing:
  github.com/egladman/magus/empty:
    interfaces:
`);
    std\assert(got.len() == 3, message: "the root, internalize and types; internal and empty skipped");
    std\assert(got[0].path == "gen/mocks/assert.go", message: "the module root writes under gen/mocks");
    std\assert(got[0].body.indexOf("\t_ iface.Server = (*MockServer)(nil)\n") != null, message: "root body");
    std\assert(got[1].path == "internalize/gen/mocks/assert.go", message: "a name containing internal is not internal");
    std\assert(got[2].path == "types/gen/mocks/assert.go", message: "a nested package");
    std\assert(got[2].body == render("github.com/egladman/magus/types", interfaces: ["Inspector", "Repository"]),
        message: "interfaces sorted by byte");
}

fun refusal(config: str) > str {
    try {
        _ = files(config);
    } catch (e) {
        return "{e}";
    }
    return "";
}

test "a broken config is refused" {
    std\assert(refusal("packages:\n").indexOf("declares no packages") != null, message: "no packages");
    std\assert(refusal("packages: [\n") != "", message: "unparsable yaml");
    std\assert(refusal("packages:\n  example.com/elsewhere:\n    interfaces:\n      Thing:\n").indexOf("example.com/elsewhere") != null,
        message: "a package outside the module");
}
