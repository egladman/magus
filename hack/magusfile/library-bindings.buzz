namespace librarybindings;

import "magus";
import "proc";

export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["libs/termkit/**/*.go", "internal/generate/emit/*.go",
        "cmd/magus-libmodules/*.go", "go.mod", "go.sum", "go.work", "go.work.sum"]);
    _ = proc\exec("go", ["run", "./cmd/magus-libmodules", "-dir", "libs/termkit",
        "-outdir", "std/termkit/gen", "-import", "github.com/egladman/magus/std/termkit/gen"]);
}
