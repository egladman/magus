namespace recompose;

import "magus";
import "result";
import "std";
import "vcs";

import "assert";

export fun git(dir: str, args: [str]) > result\Result::<str> {
    try {
        return result\ok::<str>(vcs\cmd(args, opts: vcs\CommandOptions{ quiet = true, dir = dir }).stdout.trim());
    } catch (err: any) {
        return result\caught::<str>(err, doing: "git {args.join(" ")}");
    }
}

export fun gitOK(dir: str, args: [str]) > result\Result::<bool> {
    try {
        return result\ok::<bool>(vcs\cmd(args, opts: vcs\CommandOptions{ quiet = true, dir = dir, allowFailure = true }).code == 0);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "git {args.join(" ")}");
    }
}

export fun lines(text: str) > [str] {
    final acc = mut [<str>];
    foreach (l in text.split("\n")) {
        if (l.trim() != "") { acc.append(l.trim()); }
    }
    return acc;
}

// unstaged is every path in dir changed and not staged: modified, deleted or untracked.
export fun unstaged(dir: str) > result\Result::<[str]> {
    final acc = mut [<str>];
    final modified = git(dir, args: ["diff", "--name-only"]);
    if (modified.error -> err) { return result\Result::<[str]>{ error = err }; }
    foreach (p in lines(modified.value!)) { acc.append(p); }
    final untracked = git(dir, args: ["ls-files", "--others", "--exclude-standard"]);
    if (untracked.error -> err) { return result\Result::<[str]>{ error = err }; }
    foreach (p in lines(untracked.value!)) { acc.append(p); }
    return result\ok::<[str]>(acc);
}

fun claimsOutput(e: magus\FileEntry) > [magus\FileClaim] {
    return e.claims.filter(fun (index: int, c: magus\FileClaim) > bool => c.role == "output" and c.target != "");
}

fun readsFor(e: magus\FileEntry, producer: magus\FileClaim) > bool {
    foreach (c in e.claims) {
        if (c.role == "source" and c.project == producer.project and c.target == producer.target) { return true; }
    }
    return false;
}

// JobCommit is one recomposed commit: a merged job branch's paths, with the
// outputs its sources invalidated.
export object JobCommit {
    branch: str,
    paths: [str],
    notes: [str],
}

fun lastTouch(branches: [str], touched: {str: [str]}, path: str) > int {
    for (i: int = branches.len() - 1; i >= 0; i = i - 1) {
        if ((touched[branches[i]] ?? [<str>]).indexOf(path) != null) { return i; }
    }
    return -1;
}

fun firstTouch(branches: [str], touched: {str: [str]}, path: str) > int {
    for (i: int = 0; i < branches.len(); i = i + 1) {
        if ((touched[branches[i]] ?? [<str>]).indexOf(path) != null) { return i; }
    }
    return -1;
}

// ownerOf is the branch an entry joins and a note when it fell back. An output
// joins the first branch that changed a source its producer reads; with none,
// the last branch that changed it, else the last branch.
fun ownerOf(e: magus\FileEntry, entries: [magus\FileEntry], branches: [str], touched: {str: [str]}) > [str] {
    final own = lastTouch(branches, touched: touched, path: e.path);
    final last = branches[branches.len() - 1];
    final producers = claimsOutput(e);
    if (e.role != "output" or producers.len() == 0) {
        if (own >= 0) { return [branches[own], ""]; }
        return [last, "{e.path}: no job branch changed it, so it joins {last}"];
    }
    var best = -1;
    foreach (p in producers) {
        foreach (s in entries) {
            if (s.role == "output" or !readsFor(s, producer: p)) { continue; }
            final at = firstTouch(branches, touched: touched, path: s.path);
            if (at >= 0 and (best < 0 or at < best)) { best = at; }
        }
    }
    if (best >= 0) { return [branches[best], ""]; }
    var joins = last;
    if (own >= 0) { joins = branches[own]; }
    return [joins, "{e.path}: no changed source is read by {producers[0].project}:{producers[0].target}, so it joins {joins}"];
}

// assignPaths makes one commit per branch that owns a path, in branches order.
// touched maps a branch to the paths its own commits changed. branches may not
// be empty.
export fun assignPaths(entries: [magus\FileEntry], branches: [str], touched: {str: [str]}) > [JobCommit] {
    final paths = mut {<str: mut [str]>};
    final notes = mut {<str: mut [str]>};
    foreach (b in branches) {
        paths[b] = mut [<str>];
        notes[b] = mut [<str>];
    }
    foreach (e in entries) {
        final owner = ownerOf(e, entries: entries, branches: branches, touched: touched);
        paths[owner[0]]!.append(e.path);
        if (owner[1] != "") { notes[owner[0]]!.append(owner[1]); }
    }
    final acc = mut [<JobCommit>];
    foreach (b in branches) {
        if (paths[b]!.len() > 0) { acc.append(JobCommit{ branch = b, paths = paths[b]!, notes = notes[b]! }); }
    }
    return acc;
}

// CommitWeight is a landed commit's subject and the lines it changed.
export object CommitWeight {
    subject: str,
    lines: int,
}

final SUBJECT_MAX = 72;

// subjectFrom joins the consolidated commits' clauses, heaviest first, within
// SUBJECT_MAX; the first always fits. Regeneration clauses go in only alone:
// the output now travels with its source.
export fun subjectFrom(commits: [CommitWeight], fallback: str) > str {
    final clauses = mut [<str>];
    final weight = mut {<str: int>};
    foreach (c in commits) {
        foreach (part in c.subject.split(";")) {
            final clause = part.trim();
            if (clause == "") { continue; }
            if (weight[clause] == null) { clauses.append(clause); weight[clause] = 0; }
            weight[clause] = weight[clause]! + c.lines;
        }
    }
    final kept = clauses.filter(fun (index: int, c: str) > bool => !c.startsWith("regenerate"));
    final pool = mut [<str>];
    foreach (c in (if (kept.len() > 0) kept else clauses)) { pool.append(c); }
    if (pool.len() == 0) { return fallback; }
    final ranked = mut [<str>];
    while (pool.len() > 0) {
        var best = 0;
        foreach (i, c in pool) {
            if (weight[c]! > weight[pool[best]]!) { best = i; }
        }
        ranked.append(pool[best]);
        _ = pool.remove(best);
    }
    var subject = capped(ranked[0]);
    for (i: int = 1; i < ranked.len(); i = i + 1) {
        if (subject.len() + 2 + ranked[i].len() <= SUBJECT_MAX) { subject = "{subject}; {ranked[i]}"; }
    }
    return subject;
}

fun literal(paths: [str]) > [str] {
    return paths.map(fun (index: int, p: str) > str => ":(literal){p}");
}

fun capped(subject: str) > str {
    if (subject.len() <= SUBJECT_MAX) { return subject; }
    return subject.sub(0, len: SUBJECT_MAX - 3) + "...";
}

// weightsIn is each commit reachable from revs, oldest first. A rev starting
// with ^ excludes what it reaches.
fun weightsIn(dir: str, revs: [str]) > result\Result::<[CommitWeight]> {
    final args = mut ["log", "--no-merges", "--reverse", "--format=@@%s", "--numstat"];
    foreach (r in revs) { args.append(r); }
    final logged = git(dir, args: args);
    if (logged.error -> err) { return result\Result::<[CommitWeight]>{ error = err }; }
    final acc = mut [<CommitWeight>];
    var subject = "";
    var count = 0;
    var open = false;
    foreach (l in lines(logged.value!)) {
        if (l.startsWith("@@")) {
            if (open) { acc.append(CommitWeight{ subject = subject, lines = count }); }
            subject = l.sub(2);
            count = 0;
            open = true;
            continue;
        }
        final cols = l.split("\t");
        if (cols.len() < 3) { continue; }
        // numstat prints "-" for a binary file; it counts as one line.
        count = count + (std\parseInt(cols[0]) ?? 1) + (std\parseInt(cols[1]) ?? 0);
    }
    if (open) { acc.append(CommitWeight{ subject = subject, lines = count }); }
    return result\ok::<[CommitWeight]>(acc);
}

// pushedFloor is the newest commit of HEAD a remote ref of into holds, else
// base: everything up to it is published and stays. Remote histories neither
// of which contains the other are an error, since no one floor keeps both.
export fun pushedFloor(dir: str, base: str, into: str) > result\Result::<str> {
    final floorRun = git(dir, args: ["rev-parse", base]);
    if (floorRun.error -> err) { return result\Result::<str>{ error = err }; }
    var floor = floorRun.value!;
    final refs = git(dir, args: ["for-each-ref", "--format=%(refname)", "refs/remotes/*/{into}"]);
    if (refs.error -> err) { return result\Result::<str>{ error = err }; }
    foreach (r in lines(refs.value!)) {
        final related = gitOK(dir, args: ["merge-base", "HEAD", r]);
        if (related.error -> err) { return result\Result::<str>{ error = err }; }
        if (!related.value!) { continue; }
        final held = git(dir, args: ["merge-base", "HEAD", r]);
        if (held.error -> err) { return result\Result::<str>{ error = err }; }
        final newer = gitOK(dir, args: ["merge-base", "--is-ancestor", floor, held.value!]);
        if (newer.error -> err) { return result\Result::<str>{ error = err }; }
        if (newer.value!) { floor = held.value!; continue; }
        final older = gitOK(dir, args: ["merge-base", "--is-ancestor", held.value!, floor]);
        if (older.error -> err) { return result\Result::<str>{ error = err }; }
        if (!older.value!) {
            return result\fail::<str>("merge-job-branches: {r} and the history below {floor} are both published and neither contains the other, so no recomposition keeps both");
        }
    }
    return result\ok::<str>(floor);
}

export fun describeAt(dir: str, paths: [str]) > result\Result::<[magus\FileEntry]> {
    try {
        return result\ok::<[magus\FileEntry]>(magus\describe.file(paths, opts: magus\CommandOptions{ dir = dir, root = dir }).files);
    } catch (err: any) {
        return result\caught::<[magus\FileEntry]>(err, doing: "merge-job-branches: describe the changed files in {dir}");
    }
}

// jobRevs selects the commits only the branch at position i brought: not the
// floor's, not an earlier branch's.
fun jobRevs(branches: [str], i: int, floor: str) > [str] {
    final revs = mut [branches[i], "^{floor}"];
    for (j: int = 0; j < i; j = j + 1) { revs.append("^{branches[j]}"); }
    return revs;
}

// Landed is what each merged branch brought: its changed paths and commits.
object Landed {
    touched: {str: [str]},
    weights: {str: [CommitWeight]},
}

fun landedBy(dir: str, branches: [str], floor: str) > result\Result::<Landed> {
    final touched = mut {<str: [str]>};
    final weights = mut {<str: [CommitWeight]>};
    foreach (i, b in branches) {
        final revs = jobRevs(branches, i: i, floor: floor);
        final named = mut ["log", "--no-merges", "--name-only", "--format="];
        foreach (r in revs) { named.append(r); }
        final names = git(dir, args: named);
        if (names.error -> err) { return result\Result::<Landed>{ error = err }; }
        touched[b] = lines(names.value!);
        final own = weightsIn(dir, revs: revs);
        if (own.error -> err) { return result\Result::<Landed>{ error = err }; }
        weights[b] = own.value!;
    }
    return result\ok::<Landed>(Landed{ touched = touched, weights = weights });
}

fun commitGroups(dir: str, floor: str, groups: [JobCommit], subjects: [str]) > result\Result::<[str]> {
    final reset = git(dir, args: ["reset", "-q", "--mixed", floor]);
    if (reset.error -> err) { return result\Result::<[str]>{ error = err }; }
    final made = mut [<str>];
    foreach (i, g in groups) {
        final add = mut ["add", "-A", "--"];
        foreach (p in literal(g.paths)) { add.append(p); }
        final staged = git(dir, args: add);
        if (staged.error -> err) { return result\Result::<[str]>{ error = err }; }
        final committed = git(dir, args: ["commit", "-q", "--no-verify", "-m", subjects[i]]);
        if (committed.error -> err) { return result\Result::<[str]>{ error = err }; }
        final short = git(dir, args: ["rev-parse", "--short", "HEAD"]);
        if (short.error -> err) { return result\Result::<[str]>{ error = err }; }
        made.append("{short.value!} {subjects[i]}");
        foreach (n in g.notes) { made.append("     {n}"); }
    }
    return result\ok::<[str]>(made);
}

fun keepsTree(dir: str, before: str, tip: str) > result\Result::<bool> {
    final afterRun = git(dir, args: ["rev-parse", "HEAD^\{tree\}"]);
    if (afterRun.error -> err) { return result\Result::<bool>{ error = err }; }
    final left = unstaged(dir);
    if (left.error -> err) { return result\Result::<bool>{ error = err }; }
    if (afterRun.value! != before or left.value!.len() > 0) {
        return result\fail::<bool>("merge-job-branches: recomposing changed the merged tree from {before} to {afterRun.value!}, leaving {left.value!.join(", ")} uncommitted; the merged commit was {tip}");
    }
    return result\ok::<bool>(true);
}

fun changedSince(dir: str, floor: str, tip: str) > result\Result::<[str]> {
    final changedRun = git(dir, args: ["diff", "--name-only", "--no-renames", floor, tip]);
    if (changedRun.error -> err) { return result\Result::<[str]>{ error = err }; }
    return result\ok::<[str]>(lines(changedRun.value!));
}

// recompose rewrites HEAD's commits above pushedFloor into one commit per
// merged branch, in branches order, with no merge left. HEAD's tree stays
// byte-identical or it fails naming both trees. It returns `<short> <subject>`
// lines, oldest first.
export fun recompose(dir: str, base: str, into: str, branches: [str], describe: fun (dir: str, paths: [str]) > result\Result::<[magus\FileEntry]>) > result\Result::<[str]> {
    final floorRun = pushedFloor(dir, base: base, into: into);
    if (floorRun.error -> err) { return result\Result::<[str]>{ error = err }; }
    final floor = floorRun.value!;
    final tipRun = git(dir, args: ["rev-parse", "HEAD"]);
    if (tipRun.error -> err) { return result\Result::<[str]>{ error = err }; }
    final tip = tipRun.value!;
    final treeRun = git(dir, args: ["rev-parse", "HEAD^\{tree\}"]);
    if (treeRun.error -> err) { return result\Result::<[str]>{ error = err }; }
    final changedRun = changedSince(dir, floor: floor, tip: tip);
    if (changedRun.error -> err) { return result\Result::<[str]>{ error = err }; }
    final changed = changedRun.value!;
    if (changed.len() == 0) { return result\ok::<[str]>([<str>]); }
    if (branches.len() == 0) { return result\fail::<[str]>("merge-job-branches: no merged branch to recompose {changed.len()} changed paths into"); }
    final described = describe(dir, paths: changed);
    if (described.error -> err) { return result\Result::<[str]>{ error = err }; }
    final landed = landedBy(dir, branches: branches, floor: floor);
    if (landed.error -> err) { return result\Result::<[str]>{ error = err }; }
    final groups = assignPaths(described.value!, branches: branches, touched: landed.value!.touched);
    final subjects = mut [<str>];
    foreach (g in groups) {
        subjects.append(capped(subjectFrom(landed.value!.weights[g.branch]!, fallback: "carry the merge resolutions of {g.branch}")));
    }
    final made = commitGroups(dir, floor: floor, groups: groups, subjects: subjects);
    if (made.error -> err) { return result\Result::<[str]>{ error = err }; }
    final kept = keepsTree(dir, before: treeRun.value!, tip: tip);
    if (kept.error -> err) { return result\Result::<[str]>{ error = err }; }
    return made;
}

fun source(path: str, project: str, dependsOn: [str], reads: [magus\FileClaim]) > magus\FileEntry {
    return magus\FileEntry{ path = path, project = project, role = "source", dependsOn = dependsOn, claims = reads };
}

test "a path goes to the job that changed it, each output beside the first source its producer reads" {
    final catalog = magus\FileClaim{ project = "docs", target = "catalog", role = "source" };
    final commits = assignPaths([
        source("docs/guide.md", project: "docs", dependsOn: ["."], reads: [<magus\FileClaim>]),
        magus\FileEntry{ path = "docs/reference/skill.md", project = "docs", role = "output", dependsOn = ["."],
            claims = [magus\FileClaim{ project = "docs", target = "catalog", role = "output" }] },
        magus\FileEntry{ path = "docs/reference/stale.md", project = "docs", role = "output", dependsOn = ["."],
            claims = [magus\FileClaim{ project = "docs", target = "glossary", role = "output" }] },
        source("internal/skills/a/SKILL.md", project: ".", dependsOn: [<str>], reads: [catalog]),
    ], branches: ["docs-job", "skill-job"], touched: {
        "docs-job": ["docs/guide.md"],
        "skill-job": ["internal/skills/a/SKILL.md", "docs/guide.md"],
    });
    final shape = mut [<str>];
    foreach (g in commits) { shape.append("{g.branch}={g.paths.join(",")}"); }
    assert\equal(shape, want: ["skill-job=docs/guide.md,docs/reference/skill.md,docs/reference/stale.md,internal/skills/a/SKILL.md"],
        message: "guide.md goes to the last job to change it; skill.md to the job whose source it reads");
    assert\equal(commits[0].notes, want: ["docs/reference/stale.md: no changed source is read by docs:glossary, so it joins skill-job"],
        message: "an output no changed source explains says where it went");
}

test "an unrelated job keeps its own paths" {
    final commits = assignPaths([
        source("a.txt", project: ".", dependsOn: [<str>], reads: [<magus\FileClaim>]),
        source("b.txt", project: ".", dependsOn: [<str>], reads: [<magus\FileClaim>]),
    ], branches: ["one", "two"], touched: { "one": ["a.txt"], "two": ["b.txt"] });
    final shape = mut [<str>];
    foreach (g in commits) { shape.append("{g.branch}={g.paths.join(",")}"); }
    assert\equal(shape, want: ["one=a.txt", "two=b.txt"], message: "one commit per job, in branch order");
    assert\equal(commits[0].notes, want: [<str>], message: "a matched path needs no note");
}

test "a subject takes the heaviest clauses within the limit and drops regeneration beside them" {
    final subject = subjectFrom([
        CommitWeight{ subject = "add the recompose step", lines = 40 },
        CommitWeight{ subject = "regenerate the skill docs", lines = 400 },
        CommitWeight{ subject = "pin the floor; add the recompose step", lines = 10 },
        CommitWeight{ subject = "say the integrator recomposes in the multi-agent skill", lines = 5 },
    ], fallback: "unused");
    assert\equal(subject, want: "add the recompose step; pin the floor", message: "the third clause would pass {SUBJECT_MAX}");
    assert\equal(subjectFrom([CommitWeight{ subject = "regenerate the outputs", lines = 3 }], fallback: "unused"),
        want: "regenerate the outputs", message: "a regeneration alone keeps its clause");
    assert\equal(subjectFrom([<CommitWeight>], fallback: "carry the merge resolutions of x"),
        want: "carry the merge resolutions of x", message: "no commit falls back");
    final long = capped("rework the integrator so every merged job branch becomes exactly one reviewable commit");
    assert\equal(long.len(), want: SUBJECT_MAX, message: "a long subject is clipped: {long}");
}

