namespace ratchetprune;

import "assert";
import "std";
import "fs";
import "magus";
import "encoding/json";

// CLONES is the one metric whose known entry is stale whole: a clone entry names a group,
// and an item leaving it can break the pair the rest still form.
final CLONES = "clone-tokens";

// Pruned is a record after prune: its lines, what left it, and why nothing did when the
// report could not vouch for staleness.
object Pruned {
    lines: [str],
    removed: [str],
    refused: str,
}

// run deletes from the record at path every known item a fresh conformance report calls
// stale. It never adds an item, changes a threshold or edits a reason, and when an index is
// not up to date or the answer is not found it leaves the record as it is and says why.
// magus\conformance refreshes a stale index first, which format must not pay for, so run
// asks `magus status` before it and prunes only when every index is already current.
export fun run(path: str) > void !> any {
    final status: {str: any} = json\parse(magus\cmd("status", args: ["--symbols", "-o", "json"], opts: {"quiet": true}).stdout);
    if (!status.hasKey("symbol_indexes")) {
        throw "conformance-ratchet: `magus status --symbols -o json` reported no symbol_indexes";
    }
    final behind = staleIndex(status["symbol_indexes"]);
    if (behind != "") {
        std\print("ratchet not pruned: {behind} is stale");
        return;
    }
    final got = prune(magus\conformance(), record: fs\readLines(path));
    if (got.refused != "") {
        std\print("conformance-ratchet: left {path} as it is: {got.refused}");
        return;
    }
    if (got.removed.len() == 0) {
        return;
    }
    fs\writeFileAtomic(path, content: got.lines.join("\n") + "\n");
    foreach (item in got.removed) {
        std\print("conformance-ratchet: deleted {item} from {path}: it no longer violates");
    }
}

// prune is record without the stale items of report, a known row left empty dropped. An
// item of a metric other than CLONES leaves every row of its metric, since staleness is per
// item; a clone entry leaves only as the whole row it was read from.
export fun prune(report: {str: any}, record: [str]) > Pruned !> any {
    final refused = unvouched(report);
    if (refused != "") {
        return Pruned{ lines = record, removed = [<str>], refused = refused };
    }
    final staleItems = mut {<str: bool>};
    final staleClones = mut {<str: bool>};
    final stale: [any] = report["stale"] ?? [<any>];
    foreach (k in stale) {
        final metric: str = k["metric"] ?? "";
        final items = names(k["items"]);
        if (metric == CLONES) {
            staleClones[items.join(", ")] = true;
            continue;
        }
        foreach (item in items) {
            staleItems["{metric} {item}"] = true;
        }
    }

    final kept = mut [<str>];
    final seen = mut {<str: bool>};
    final removed = mut [<str>];
    foreach (i, text in record) {
        if (text.trim() == "") {
            continue;
        }
        final row: {str: any} = json\parse(text);
        if (row["kind"] != "known") {
            kept.append(text);
            continue;
        }
        final metric: str = row["metric"] ?? "";
        final items = names(row["items"]);
        if (metric == CLONES) {
            if (staleClones[items.join(", ")] ?? false) {
                removed.append("the {metric} entry {items.join(", ")}");
                continue;
            }
            kept.append(text);
            continue;
        }
        final left = mut [<str>];
        foreach (item in items) {
            if (staleItems["{metric} {item}"] ?? false) {
                removed.append("{metric} {item}");
            } else {
                left.append(item);
            }
        }
        if (left.len() == items.len()) {
            kept.append(text);
            continue;
        }
        if (left.len() == 0) {
            continue;
        }
        final at = text.indexOf(`"items":`);
        if (at == null or !text.endsWith("]}")) {
            return Pruned{ lines = record, removed = [<str>],
                refused = "line {i + 1} does not end with its items, so it cannot be narrowed without rewriting the rest" };
        }
        final narrowed = text.sub(0, len: at!) + `"items":` + json\stringify(left) + "}";
        // Narrowing can leave two rows equal, and the record refuses a repeated line.
        if (seen[narrowed] ?? false) {
            continue;
        }
        seen[narrowed] = true;
        kept.append(narrowed);
    }
    return Pruned{ lines = kept, removed = removed, refused = "" };
}

// unvouched is why report cannot say what is stale, or "" when it can: an index that is not
// up to date measured old code, and an answer that is not found measured nothing.
fun unvouched(report: {str: any}) > str {
    final indexes: [any] = report["indexes"] ?? [<any>];
    foreach (idx in indexes) {
        final freshness: str = idx["freshness"] ?? "";
        if (freshness != "up-to-date") {
            return "{indexLabel(idx)} is {freshness}";
        }
    }
    final answer: {str: any} = report["answer"] ?? {<str: any>};
    final verdict: str = answer["verdict"] ?? "missing";
    if (verdict != "found") {
        final reason: str = answer["reason"] ?? "no reason given";
        return "magus\\conformance answered {verdict} ({reason})";
    }
    return "";
}

// staleIndex names the first of indexes that is not up to date, or is "" when all are.
fun staleIndex(indexes: [any]) > str {
    foreach (idx in indexes) {
        final freshness: str = idx["freshness"] ?? "";
        if (freshness != "up-to-date") {
            return indexLabel(idx);
        }
    }
    return "";
}

fun indexLabel(idx: any) > str {
    final project: str = idx["project"]["path"] ?? ".";
    final lang: str = idx["language"] ?? "";
    return "the {lang} symbol index of {project}";
}

fun names(items: any) > [str] {
    final list: [any] = items ?? [<any>];
    final strs = mut [<str>];
    foreach (item in list) {
        strs.append("{item}");
    }
    return strs;
}

fun fresh() > {str: any} {
    return {"project": {"path": "."}, "language": "go", "freshness": "up-to-date"};
}

fun report(stale: [any]) > {str: any} {
    final indexes: [any] = [fresh()];
    return {"indexes": indexes, "answer": {"verdict": "found"}, "stale": stale};
}

final RECORD = [
    `{"kind":"schema","schema":1}`,
    `{"kind":"threshold","metric":"file-lines","population":"source","value":899,"n":1690,"percentile":95,"why":"p95"}`,
    `{"kind":"known","metric":"file-lines","reason":"split pending","items":["a.go","b.go","c.go"]}`,
    `{"kind":"known","metric":"func-lines","reason":"long on purpose","items":["a.go#F"]}`,
    `{"kind":"known","metric":"clone-tokens","reason":"driver twins","items":["vcs/hg.go#hgVCS.Bisect","vcs/sapling.go#saplingVCS.Bisect"]}`,
    `{"kind":"known","metric":"clone-tokens","reason":"one home pending","items":["x.go#A","y.go#B"]}`,
];

test "prune narrows a row, drops an emptied one and a stale clone entry, and keeps the rest verbatim" {
    final stale: [any] = [
        {"metric": "file-lines", "items": ["b.go"], "reason": "split pending"},
        {"metric": "func-lines", "items": ["a.go#F"], "reason": "long on purpose"},
        {"metric": "clone-tokens", "items": ["x.go#A", "y.go#B"], "reason": "one home pending"},
    ];
    final got = prune(report(stale), record: RECORD);
    assert\equal(got.refused, want: "", message: "a fresh report");
    assert\equal(got.lines.len(), want: 4, message: got.lines.join("\n"));
    assert\equal(got.lines[0], want: RECORD[0], message: "schema");
    assert\equal(got.lines[1], want: RECORD[1], message: "a threshold is never changed");
    assert\equal(got.lines[2],
        want: `{"kind":"known","metric":"file-lines","reason":"split pending","items":["a.go","c.go"]}`,
        message: "b.go leaves; the reason stays");
    assert\equal(got.lines[3], want: RECORD[4], message: "a live clone entry");
    assert\equal(got.removed.len(), want: 3, message: got.removed.join("; "));
}

test "a clone item shared with a stale entry stays in a live one" {
    final record = [`{"kind":"schema","schema":1}`,
        `{"kind":"known","metric":"clone-tokens","reason":"r","items":["x.go#A","y.go#B"]}`,
        `{"kind":"known","metric":"clone-tokens","reason":"r","items":["x.go#A","z.go#C"]}`];
    final stale: [any] = [{"metric": "clone-tokens", "items": ["x.go#A", "y.go#B"], "reason": "r"}];
    final got = prune(report(stale), record: record);
    assert\equal(got.lines.len(), want: 2, message: got.lines.join("\n"));
    assert\equal(got.lines[1], want: record[2], message: "x.go#A stays with z.go#C");
}

test "nothing stale leaves the record byte for byte" {
    final got = prune(report([<any>]), record: RECORD);
    assert\equal(got.lines.join("\n"), want: RECORD.join("\n"), message: "unchanged");
    assert\equal(got.removed.len(), want: 0, message: "nothing removed");
}

test "a stale index or an unknown answer changes nothing and says why" {
    final stale: [any] = [{"metric": "file-lines", "items": ["b.go"], "reason": "split pending"}];
    final indexes: [any] = [fresh(), {"project": {"path": "libs/x"}, "language": "go", "freshness": "out-of-date"}];
    final behind = prune({"indexes": indexes, "answer": {"verdict": "found"}, "stale": stale}, record: RECORD);
    assert\equal(behind.lines.join("\n"), want: RECORD.join("\n"), message: "unchanged");
    assert\equal(behind.refused, want: "the go symbol index of libs/x is out-of-date", message: behind.refused);

    final answer: {str: any} = {"verdict": "unknown", "reason": "no-index"};
    final fresher: [any] = [fresh()];
    final unknown = prune({"indexes": fresher, "answer": answer, "stale": stale}, record: RECORD);
    assert\equal(unknown.lines.join("\n"), want: RECORD.join("\n"), message: "unchanged");
    assert\equal(unknown.refused, want: "magus\\conformance answered unknown (no-index)", message: unknown.refused);
}

test "the first index that is not up to date is named; all current names none" {
    final behind: [any] = [fresh(), {"project": {"path": "docs"}, "language": "buzz", "freshness": "out-of-date"}];
    assert\equal(staleIndex(behind), want: "the buzz symbol index of docs", message: "the stale one");
    final current: [any] = [fresh()];
    assert\equal(staleIndex(current), want: "", message: "all current");
}

test "a row whose items are not last is refused rather than reformatted" {
    final record = [`{"kind":"known","metric":"file-lines","items":["a.go","b.go"],"reason":"r"}`];
    final stale: [any] = [{"metric": "file-lines", "items": ["b.go"], "reason": "r"}];
    final got = prune(report(stale), record: record);
    assert\equal(got.lines[0], want: record[0], message: "unchanged");
    assert\equal(got.refused.indexOf("line 1") != null, want: true, message: got.refused);
}
