// run-golangci.buzz - runs .magus/custom-gcl, the golangci-lint carrying this repo's own linters.
// .golangci.yml names those linters, so the stock binary on PATH refuses it with
// `plugin("...") not found`. Nothing here falls back to the stock binary.
namespace golangci;

import "fs";
import "os";
import "proc";
import "std";
import "magus";
import "crypto";
import "encoding/json";

import "assert";

// LINTER_SOURCES are the files `golangci-lint custom` compiles into
// .magus/custom-gcl. libs/proofread enters through a go.mod replace.
// install_linter's readsFiles repeats this list; keep the two in step.
export final LINTER_SOURCES = ["libs/testpairing/.custom-gcl.yml", "libs/testpairing/go.mod",
    "libs/testpairing/go.sum", "libs/testpairing/**/*.go",
    "libs/conventions/go.mod", "libs/conventions/go.sum", "libs/conventions/**/*.go",
    "libs/proofread/go.mod", "libs/proofread/go.sum", "libs/proofread/**/*.go"];

// The digest of LINTER_SOURCES the build at .magus/custom-gcl was linked from.
final LINKED_FROM = ".magus/custom-gcl.inputs";

// binary is the workspace's custom build; it throws, naming the target that builds it, when absent.
export fun binary() > str !> any {
    final path = magus\describe.project().workspace + "/.magus/custom-gcl";
    if (!fs\exists(path)) {
        throw "{path} is missing; build it with `magus run install-linter .`. The stock golangci-lint cannot read .golangci.yml";
    }
    return path;
}

// linkerInputs is the digest of every file LINTER_SOURCES matches under root.
fun linkerInputs(root: str) > str !> any {
    final lines = mut [<str>];
    foreach (pattern in LINTER_SOURCES) {
        foreach (path in fs\glob(root + "/" + pattern)) {
            final rel = path.value.sub(root.len() + 1, len: path.value.len() - root.len() - 1);
            lines.append("{rel} {crypto\sha256File(path.value)}");
        }
    }
    _ = lines.sort(fun (left: str, right: str) > bool => left < right);
    return crypto\sha256Hex(lines.join("\n"));
}

// whyRelink says why the build must be linked again, or "" when it may run.
fun whyRelink(linked: bool, linkedFrom: str, inputs: str) > str {
    if (!linked) {
        return ".magus/custom-gcl is not built";
    }
    if (linkedFrom.trim() != inputs) {
        return ".magus/custom-gcl was linked from other linter sources than the tree holds";
    }
    return "";
}

// linkFresh links the custom build unless the one at hand was linked from
// the linter sources the tree holds. A digest decides, not a cache key:
// install-linter declares no outputs, so its replay restores no binary.
export fun linkFresh() > void !> any {
    final root = magus\describe.project().workspace;
    final inputs = linkerInputs(root);
    final why = whyRelink(fs\exists(root + "/.magus/custom-gcl"), linkedFrom: fs\readFile(root + "/" + LINKED_FROM) catch "", inputs: inputs);
    if (why == "") {
        return;
    }
    magus\log.info("linking the custom golangci-lint: {why}");
    // A fresh inode: macOS keys the code signature on the inode, and an
    // in-place rewrite gets the next exec SIGKILLed.
    fs\remove(root + "/.magus/custom-gcl");
    // custom-gcl's version salt hashes only plugin dirs with a path, so a
    // rebuilt binary would replay stale findings from this cache.
    fs\removeAll(root + "/.magus/golangci-lint");
    _ = proc\exec("golangci-lint", args: ["custom"], dir: root + "/libs/testpairing");
    fs\writeFile(root + "/" + LINKED_FROM, content: inputs + "\n");
}

// readLibFiles declares what a lib module's run reads. Restated in full because readsFiles
// replaces the project baseline.
export fun readLibFiles(ctx: magus\Context) > void !> any {
    ctx.readsFiles(["**/*.go", "go.mod", "go.sum",
                    "../../.golangci.yml", "../testpairing/.custom-gcl.yml",
                    "../testpairing/**/*.go", "../testpairing/go.mod", "../testpairing/go.sum",
                    "../conventions/**/*.go", "../conventions/go.mod", "../conventions/go.sum"]);
}

// run executes the custom build with the workspace config. dir is workspace-relative.
export fun run(dir: str, args: [str]) > void !> any {
    final root = magus\describe.project().workspace;
    final bin = binary();
    // An in-checkout cache: golangci-lint keys findings by absolute path, so sibling
    // worktrees would replay each other's. The go spell's sandbox entry reaches only its ops.
    os\withEnv({"GOLANGCI_LINT_CACHE": root + "/.magus/golangci-lint"}, callback: fun () > void !> any {
        _ = proc\exec(bin, args: ["run", "--config", root + "/.golangci.yml"] + args, dir: root + "/" + dir);
    });
}

// lintLib runs the tree-wide conventions over the lib module at dir; a module is a separate
// golangci-lint root, so the root run never reaches it. gopherbuzz's error text follows
// upstream Buzz, not Go's error-string idiom, so it skips errmsg. The --enable-only list
// stays on one line: hack/lint/testpairing-pairing-has-no-exemptions.buzz refuses it without testpair.
export fun lintLib(dir: str, fix: bool) > void !> any {
    final args = libArgs(dir).cloneMutable();
    if (fix) {
        args.append("--fix");
    }
    run(dir, args);
}

fun libArgs(dir: str) > [str] {
    final errorStrings = if (fs\basename(dir) != "gopherbuzz") ",errmsg" else "";
    return ["--enable-only", "filenames,hostagnostic,namewords,stutter,testifylint,testpairing,testpair" + errorStrings];
}

// packagesOf groups the Go files among files by the module holding them, "." or one of
// libs, each module's packages relative to it as golangci-lint takes them. golangci-lint
// stops at a go.mod, so each module runs alone.
// A file `./...` leaves out is in no package: the scoped run lints what
// the bare run lints.
export fun packagesOf(files: [str], libs: [str]) > {str: [str]} {
    final packages = mut {<str: [str]>};
    foreach (f in files) {
        if (!f.endsWith(".go")) {
            continue;
        }
        var module = ".";
        foreach (lib in libs) {
            if (f.startsWith(lib + "/") and (module == "." or lib.len() > module.len())) {
                module = lib;
            }
        }
        final rel = if (module == ".") f else f.sub(module.len() + 1, len: f.len() - module.len() - 1);
        final slash = rel.split("/");
        final dirs = slash.sub(0, len: slash.len() - 1);
        if (dirs.filter(fun (i: int, d: str) > bool => d == "testdata" or d == "vendor" or d.startsWith("_") or d.startsWith(".")).len() > 0) {
            continue;
        }
        final pkg = if (dirs.len() == 0) "." else "./" + dirs.join("/");
        final held = packages[module] ?? [<str>];
        if (held.indexOf(pkg) == null) {
            packages[module] = held + [pkg];
        }
    }
    return packages;
}

// atOrUnder is the files among files that are one of paths or lie under one.
export fun atOrUnder(files: [str], paths: [str]) > [str] {
    return files.filter(fun (i: int, f: str) > bool => paths.filter(fun (j: int, p: str) > bool => f == p or f.startsWith(p + "/")).len() > 0);
}

// issuesIn reads a `--output.json.path stdout --path-mode abs` report and keeps each issue
// at one of files, workspace-relative under root, as `path:line: text (linter)`. An issue at
// any other file is dropped: a package holds files the caller did not write.
export fun issuesIn(report: str, root: str, files: [str]) > [str] !> any {
    final doc: {str: any} = json\parse(report);
    final issues: [any] = doc["Issues"] ?? [<any>];
    final kept = mut [<str>];
    foreach (issue in issues) {
        final abs: str = issue["Pos"]["Filename"] ?? "";
        final rel = if (abs.startsWith(root + "/")) abs.sub(root.len() + 1, len: abs.len() - root.len() - 1) else abs;
        if (files.indexOf(rel) != null) {
            final line = std\toInt(issue["Pos"]["Line"] ?? 0);
            final linter: str = issue["FromLinter"] ?? "";
            final text: str = issue["Text"] ?? "";
            kept.append("{rel}:{line}: {text} ({linter})");
        }
    }
    return kept;
}

// reportArgs is the argument list issuesAt runs. The default text writer and
// the stats also print to stdout, so the writer goes to stderr and the stats
// go off: stdout stays the JSON report.
export fun reportArgs(root: str, dir: str, packages: [str]) > [str] {
    return ["run", "--config", root + "/.golangci.yml", "--output.json.path", "stdout",
        "--output.text.path", "stderr", "--show-stats=false", "--path-mode", "abs", "--issues-exit-code", "0"]
        + (if (dir != ".") libArgs(dir) else [<str>]) + packages;
}

// issuesAt runs the custom build over packages of the module at dir, with
// lintLib's linters for a lib, and returns [issuesIn] files. Paths are
// workspace-relative.
export fun issuesAt(dir: str, packages: [str], files: [str]) > [str] !> any {
    final root = magus\describe.project().workspace;
    final bin = binary();
    final args = reportArgs(root, dir: dir, packages: packages);
    var run = proc\ExecResult{};
    os\withEnv({"GOLANGCI_LINT_CACHE": root + "/.magus/golangci-lint"}, callback: fun () > void !> any {
        run = proc\exec(bin, args: args, dir: root + "/" + dir, opts: proc\ExecOptions{quiet = true, allowFailure = true});
    });
    return reportOf(run, root: root, dir: dir, packages: packages, files: files);
}

// reportOf reads a finished run. With --issues-exit-code 0, a non-zero exit
// is a failure to lint, and stderr is its only account.
fun reportOf(run: proc\ExecResult, root: str, dir: str, packages: [str], files: [str]) > [str] !> any {
    if (!run.ok) {
        final stderr = run.stderr.trim();
        final named = packages.join(" ");
        throw "golangci-lint exited {run.code} with no report: {stderr} (module {dir}, packages {named})";
    }
    return issuesIn(run.stdout, root: root, files: files);
}

test "a non-zero exit with no report raises with its code, stderr and module" {
    final failed = proc\ExecResult{code = 7, stderr = "  config: unknown linter\n", ok = false};
    var message = "";
    try {
        _ = reportOf(failed, root: "/w", dir: "libs/x", packages: ["./y"], files: ["libs/x/y/a.go"]);
    } catch (err: any) {
        message = "{err}";
    }
    assert\equal(message.indexOf("exited 7 with no report") != null, want: true, message: "the exit code is named");
    assert\equal(message.indexOf("config: unknown linter (module libs/x, packages ./y)") != null, want: true, message: "stderr is trimmed and the module and packages are named");
}

test "Go files group by their nearest module, as packages relative to it" {
    final got = packagesOf(["main.go", "internal/job/a.go", "internal/job/b.go", "libs/x/y/c.go", "libs/x/d.go", "libs/xy/e.go", "README.md"],
        libs: ["libs/x", "libs/xy"]);
    assert\equal(got["."], want: [".", "./internal/job"], message: "the root module, one entry per package");
    assert\equal(got["libs/x"], want: ["./y", "."], message: "relative to the lib");
    assert\equal(got["libs/xy"], want: ["."], message: "a lib sharing a prefix is its own module");
    assert\equal(got.len(), want: 3, message: "no module for Markdown");
}

test "a file go's ./... leaves out names no package" {
    final got = packagesOf(["internal/job/testdata/a.go", "libs/x/y/testdata/src/b.go", "vendor/v/c.go",
        "_tools/d.go", ".github/e.go", "internal/job/f.go"], libs: ["libs/x"]);
    assert\equal(got["."], want: ["./internal/job"], message: "testdata, vendor, _ and . dirs are left out");
    assert\equal(got["libs/x"] == null, want: true, message: "a lib's testdata is left out too");
}

test "a build linked from other linter sources is linked again" {
    assert\equal(whyRelink(false, linkedFrom: "", inputs: "abc") != "", want: true, message: "no build");
    assert\equal(whyRelink(true, linkedFrom: "old\n", inputs: "abc") != "", want: true, message: "a lint rule moved since the link");
    assert\equal(whyRelink(true, linkedFrom: "", inputs: "abc") != "", want: true, message: "a build with no record of its sources");
    assert\equal(whyRelink(true, linkedFrom: "abc\n", inputs: "abc"), want: "", message: "linked from the tree's sources");
}

test "the files at or under paths are kept" {
    final got = atOrUnder(["README.md", "libs/x/README.md", "changes/README.md", "changes/unreleased/a.md", "changesets.md"],
        paths: ["README.md", "changes"]);
    assert\equal(got, want: ["README.md", "changes/README.md", "changes/unreleased/a.md"], message: "a nested README and a shared prefix are left out");
}

test "only the issues at the files are kept" {
    final mine = `{"FromLinter":"revive","Text":"mine","Pos":{"Filename":"/w/internal/job/a.go","Line":3}}`;
    final theirs = `{"FromLinter":"revive","Text":"theirs","Pos":{"Filename":"/w/internal/job/b.go","Line":9}}`;
    final report = "\{\"Issues\":[" + mine + "," + theirs + "]\}";
    assert\equal(issuesIn(report, root: "/w", files: ["internal/job/a.go"]), want: ["internal/job/a.go:3: mine (revive)"], message: "one inside, one outside");
    assert\equal(issuesIn(`{"Issues":null}`, root: "/w", files: ["a.go"]).len(), want: 0, message: "a clean run");
}

test "the text report goes to stderr so stdout stays JSON" {
    final args = reportArgs("/w", dir: ".", packages: ["./a"]);
    final at = args.indexOf("--output.text.path");
    assert\equal(at != null, want: true, message: "the text writer is routed");
    assert\equal(args[(at ?? 0) + 1], want: "stderr", message: "the text writer prints to stderr");
    final json = args.indexOf("--output.json.path");
    assert\equal(args[(json ?? 0) + 1], want: "stdout", message: "the JSON report owns stdout");
    assert\equal(args.indexOf("--show-stats=false") != null, want: true, message: "the stats summary stays off stdout");
}

test "a report followed by the text writer's line is refused as invalid JSON" {
    final mixed = "\{\"Issues\":null\}\n0 issues.\n";
    var message = "";
    try {
        _ = issuesIn(mixed, root: "/w", files: ["a.go"]);
    } catch (err: any) {
        message = "{err}";
    }
    assert\equal(message.indexOf("json.parse") != null, want: true, message: "the parse error names the mixed input");
}
