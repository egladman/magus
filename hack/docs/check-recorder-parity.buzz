import "std";
import "fs";
import "termkit/screen";
import "termkit/recorder";

object Capture {
    name: str,
    width: int,
    height: int,
    pace: {str: double},
}

fun main(args: [str]) > void !> any {
    final captures = [
        Capture{name = "core-loop", width = 100, height = 48,
            pace = {"base": 0.28, "perLine": 0.028, "max": 0.85, "last": 1.3}},
        Capture{name = "showcase", width = 132, height = 34,
            pace = {"base": 0.42, "perLine": 0.028, "max": 0.95, "last": 1.5}},
    ];
    var checked = 0;
    foreach (capture in captures) {
        final source = fs\readFile("tapes/{capture.name}.capture");
        final segments = if (capture.name == "core-loop")
            recorder\commands(source, prompt: std\char(27) + "[38;5;73m$" + std\char(27) + "[0m ")
            else recorder\marked(source, marker: std\char(0) + "FRAME" + std\char(0));
        foreach (light in [false, true]) {
            final theme = if (light) screen\lightTheme() else screen\darkTheme();
            final suffix = if (light) "-light" else "";
            final rendered = recorder\animate(segments, width: capture.width, height: capture.height,
                pace: capture.pace, theme: theme);
            final path = "assets/gen/{capture.name}{suffix}.svg";
            std\assert(rendered == fs\readFile(path), message: "Buzz output differs byte for byte: {path}");
            checked += 1;
        }
    }
    var failure = "";
    try {
        failure = recorder\animate(["hello"], width: 0, height: 1, pace: captures[0].pace, theme: screen\darkTheme());
    } catch (err: any) {
        failure = "{err}";
    }
    std\assert(failure.indexOf("terminal dimensions must be positive, got 0x1") != null, message: "unexpected dimension error: {failure}");
    std\print("{checked} SVGs match the Go renderer byte for byte");
}
