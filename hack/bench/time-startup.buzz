// Cost: one Go build of a release magus into a temporary directory, then
// cases x count x runs magus processes; writes nothing in the tree.
//
// Times magus's cold start as a person meets it: a fresh process of a release-mode binary,
// run against a fresh temporary workspace with no server to hand off to. The in-process
// BenchmarkStartup in cmd/magus cannot see this: package init and runtime bootstrap run
// once per test binary, not once per iteration. The output is benchstat input, so a
// change is two runs and a diff:
//
//	magus buzz hack/bench/time-startup.buzz -- --binary "$(command -v magus)" > old.txt
//	magus buzz hack/bench/time-startup.buzz > new.txt
//	benchstat old.txt new.txt
//
// Each sample is one batch of runs back to back, divided by the runs: the clock a script
// reads ticks in milliseconds, which a single 20ms start would round away. Every run also
// carries the cost of spawning it from here, the same on both sides of a comparison.
// magus warns once that proc\exec runs a magus binary: here that is the point, since
// magus\cmd runs in-process and would time no start at all.
namespace timestartup;

import "flags";
import "fs";
import "os";
import "proc";
import "std";

import "assert";

final USAGE = "usage: magus buzz hack/bench/time-startup.buzz -- [--binary <path>] [--cases <name,...>] [--count <n>] [--runs <n>]";
// Case is one command line whose start is timed.
export object Case {
    name: str,
    argv: [str],
}

// CASES reach progressively further into startup: argument parsing alone, the version
// stamp, a generated completion script, and loading a workspace.
final CASES = [
    Case{ name = "help", argv = ["help"] },
    Case{ name = "version", argv = ["version"] },
    Case{ name = "completion_bash", argv = ["completion", "bash"] },
    Case{ name = "ls", argv = ["ls"] },
];

// WARMUP runs are untimed, so a sample measures a started process and not a cold page
// cache reading the binary off disk.
final WARMUP = 3;

export object Options {
    binary: str,
    cases: [Case],
    count: int,
    runs: int,
}

export object Sample {
    name: str,
    runs: int,
    nsPerOp: int,
}

export object Timing {
    binary: str,
    version: str,
    samples: [Sample],
}

fun caseNames(cases: [Case]) > str {
    final names = mut [<str>];
    foreach (c in cases) {
        names.append(c.name);
    }
    return names.join(",");
}

final HELP = "cost: one Go build of a release magus, then cases x count x runs magus processes; writes nothing in the tree\n{USAGE}\n"
    + "  --binary <path>   time this binary instead of building one from the checkout\n"
    + "  --cases <names>   a comma-separated subset of: {caseNames(CASES)}\n"
    + "  --count <n>       samples per case, what benchstat compares (default 10)\n"
    + "  --runs <n>        processes timed as one batch per sample (default 20)";

fun positive(flag: str, value: str?, fallback: int) > int !> any {
    if (value == null) {
        return fallback;
    }
    final n = std\parseInt(value!) ?? 0;
    if (n <= 0) {
        throw "time-startup: {flag} takes a positive count, not \"{value!}\"\n{USAGE}";
    }
    return n;
}

// parse returns the run's options, or null for --help.
export fun parse(args: [str]) > Options? !> any {
    final parsed = flags\parse(args, switches: ["--help"], valued: ["--binary", "--cases", "--count", "--runs"]);
    if (parsed.values["--help"] != null) {
        return null;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "time-startup: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    var cases = CASES;
    final wanted = parsed.values["--cases"];
    if (wanted != null) {
        final picked = mut [<Case>];
        foreach (name in wanted!.split(",")) {
            var found = false;
            foreach (c in CASES) {
                if (c.name == name) {
                    picked.append(c);
                    found = true;
                }
            }
            if (!found) {
                throw "time-startup: no case is named \"{name}\"; the cases are {caseNames(CASES)}";
            }
        }
        cases = picked;
    }
    return Options{
        binary = parsed.values["--binary"] ?? "",
        cases = cases,
        count = positive("--count", value: parsed.values["--count"], fallback: 10),
        runs = positive("--runs", value: parsed.values["--runs"], fallback: 20),
    };
}

// build links magus the way a release does (static, stripped, trimmed) into dir.
export fun build(dir: str) > str !> any {
    final bin = dir + "/magus";
    os\withEnv({"CGO_ENABLED": "0", "GOEXPERIMENT": "jsonv2"}, callback: fun () > void !> any {
        proc\exec("go", args: ["build", "-trimpath", "-tags", "noffi", "-ldflags", "-w -s", "-o", bin, "./cmd/magus"], opts: {"quiet": true});
    });
    return bin;
}

// workspace makes the smallest tree magus loads as a workspace: one Go module, so `ls`
// resolves a spell, and an empty magusfile.
fun workspace(dir: str) > str !> any {
    final ws = dir + "/ws";
    fs\mkdirAll(ws);
    fs\writeFile(ws + "/go.mod", content: "module bench\n\ngo 1.25\n");
    fs\writeFile(ws + "/magusfile.buzz", content: "");
    return ws;
}

// sample runs c runs times back to back in ws and returns the mean wall time of one.
fun sample(bin: str, c: Case, ws: str, runs: int) > Sample !> any {
    final began = os\time();
    for (var i = 0; i < runs; i = i + 1) {
        proc\exec(bin, args: c.argv, dir: ws, opts: {"quiet": true});
    }
    final elapsedMs = os\time() - began;
    return Sample{ name = c.name, runs = runs, nsPerOp = std\toInt(elapsedMs * 1000000.0 / std\toDouble(runs)) };
}

fun measure(o: Options, scratch: str) > Timing !> any {
    final bin = if (o.binary != "") o.binary else build(scratch);
    final ws = workspace(scratch);
    final samples = mut [<Sample>];
    var version = "";
    // A server would answer `ls` from its warm graph, and a proc socket inherited from this
    // script would hand each run to the magus running it: neither is a cold start.
    os\withEnv({"MAGUS_SERVER_ENABLED": "false", "MAGUS_PROC_SOCKET": ""}, callback: fun () > void !> any {
        version = proc\exec(bin, args: ["version"], dir: ws, opts: {"quiet": true}).stdout.split("\n")[0].trim();
        foreach (c in o.cases) {
            for (var i = 0; i < WARMUP; i = i + 1) {
                proc\exec(bin, args: c.argv, dir: ws, opts: {"quiet": true});
            }
            for (var n = 0; n < o.count; n = n + 1) {
                samples.append(sample(bin, c: c, ws: ws, runs: o.runs));
            }
        }
    });
    return Timing{ binary = bin, version = version, samples = samples };
}

// timeStartup builds a release binary unless o names one, times each case, and removes
// everything it made.
export fun timeStartup(o: Options) > Timing !> any {
    final scratch = fs\tempDir("time-startup-");
    var timing: Timing? = null;
    try {
        timing = measure(o, scratch: scratch);
    } catch (e) {
        fs\removeAll(scratch);
        throw e;
    }
    fs\removeAll(scratch);
    return timing!;
}

// benchstat renders t as benchstat reads it: config lines, then one line per sample. The
// version stays out of the config, where a difference would split old and new into
// separate tables instead of comparing them.
export fun benchstat(t: Timing, goos: str, goarch: str) > [str] {
    final lines = mut ["goos: {goos}", "goarch: {goarch}", "pkg: github.com/egladman/magus/cmd/magus"];
    foreach (s in t.samples) {
        lines.append("BenchmarkColdStart/{s.name} \t{s.runs}\t{s.nsPerOp} ns/op");
    }
    return lines;
}

export fun main(args: [str]) > void !> any {
    final o = parse(args);
    if (o == null) {
        std\print(HELP);
        return;
    }
    final t = timeStartup(o!);
    final host = os\platform();
    std\print("timed cold starts of {t.version}: {o!.cases.len()} case(s), {o!.count} samples of {o!.runs} runs each");
    foreach (line in benchstat(t, goos: host[0], goarch: host[1])) {
        std\print(line);
    }
}

test "defaults run every case, ten samples of twenty runs" {
    final o = parse([<str>])!;
    assert\equal(caseNames(o.cases), want: "help,version,completion_bash,ls", message: "cases");
    assert\equal(o.count, want: 10, message: "count");
    assert\equal(o.runs, want: 20, message: "runs");
    assert\equal(o.binary, want: "", message: "builds by default");
}

test "--cases picks a subset in the order given, and refuses a name it lacks" {
    assert\equal(caseNames(parse(["--cases", "ls,help"])!.cases), want: "ls,help", message: "subset");
    var refused = "";
    try {
        parse(["--cases", "run"]);
    } catch (e) {
        refused = "{e}";
    }
    assert\equal(refused, want: "time-startup: no case is named \"run\"; the cases are help,version,completion_bash,ls", message: "unknown");
}

test "a count must be positive, and --help runs nothing" {
    var refused = "";
    try {
        parse(["--runs", "0"]);
    } catch (e) {
        refused = "{e}";
    }
    assert\isTrue(refused.startsWith("time-startup: --runs takes a positive count, not \"0\""), message: "zero runs");
    assert\equal(parse(["--help"]), want: null, message: "help");
    assert\isTrue(HELP.startsWith("cost: "), message: "the first help line is the cost");
}

test "benchstat reads config lines, then one line per sample" {
    final t = Timing{ binary = "/x/magus", version = "magus v0.5.0", samples = [
        Sample{ name = "help", runs = 20, nsPerOp = 12500000 },
        Sample{ name = "ls", runs = 20, nsPerOp = 48000000 },
    ] };
    assert\equal(benchstat(t, goos: "darwin", goarch: "arm64"), want: [
        "goos: darwin",
        "goarch: arm64",
        "pkg: github.com/egladman/magus/cmd/magus",
        "BenchmarkColdStart/help \t20\t12500000 ns/op",
        "BenchmarkColdStart/ls \t20\t48000000 ns/op",
    ], message: "lines");
}
