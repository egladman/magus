namespace failures;

import "flags";
import "fs";
import "io";
import "os";
import "proc";
import "serialize";
import "std";
import "vcs";

import "assert";

final WORKFLOW = "CI";
final ARTIFACT_PREFIX = "magus-logs-";
final RECORDS = "failed-outputs.jsonl";
final NOT_FOUND = 3;
final usage = "usage: magus buzz hack/ci/show-failures.buzz -- [--commit <rev>] [--run <id>]";

object Filter {
    commit: str = "HEAD",
    run: str = "",
}

export fun parseFilter(argv: [str]) > Filter !> any {
    final parsed = flags\parse(argv, switches: [<str>], valued: ["--commit", "--run"]);
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "failures: does not take {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{usage}";
    }
    final run = parsed.values["--run"] ?? "";
    if (run != "" and (std\parseInt(run) ?? 0) <= 0) {
        throw "failures: --run \"{run}\" is not a run id\n{usage}";
    }
    return Filter{ commit = parsed.values["--commit"] ?? "HEAD", run = run };
}

// logArtifacts names the run's unexpired magus-logs artifacts, as the artifacts API lists them.
export fun logArtifacts(listing: str) > [str] !> any {
    final names = mut [<str>];
    foreach (a in serialize\jsonDecode(listing).q("artifacts").listValue()) {
        final name = a.q("name").stringValue();
        if (name.startsWith(ARTIFACT_PREFIX) and !a.q("expired").booleanValue()) {
            names.append(name);
        }
    }
    return names;
}

export final TAIL_LINES = 80;

export object FailedJob {
    id: int,
    name: str,
}

// failedJobs lists the run's jobs that concluded in failure, as `gh run view --json jobs` prints them.
export fun failedJobs(listing: str) > [FailedJob] !> any {
    final jobs = mut [<FailedJob>];
    foreach (j in serialize\jsonDecode(listing).q("jobs").listValue()) {
        if (j.q("conclusion").stringValue() == "failure") {
            jobs.append(FailedJob{ id = j.q("databaseId").integerValue(), name = j.q("name").stringValue() });
        }
    }
    return jobs;
}

// tail keeps the last count lines of text.
export fun tail(text: str, count: int) > str {
    final lines = text.trim().split("\n");
    if (lines.len() <= count) {
        return lines.join("\n");
    }
    return lines.sub(lines.len() - count, len: count).join("\n");
}

// fallbackLogs reads each failed job's `gh run view --log-failed` tail, for a run whose
// failed jobs wrote no magus-logs artifact; gh is the call to the gh CLI.
export fun fallbackLogs(run: str, gh: fun (args: [str]) > str !> any) > str !> any {
    final report = mut [<str>];
    foreach (job in failedJobs(gh(["run", "view", run, "--json", "jobs"]))) {
        final log = gh(["run", "view", "--job", "{job.id}", "--log-failed"]);
        report.append("== {job.name} (job {job.id}): last {TAIL_LINES} lines of gh run view --job {job.id} --log-failed\n{tail(log, count: TAIL_LINES)}");
    }
    return report.join("\n");
}

fun note(line: str) > void {
    io\stderr.write(line + "\n") catch void;
}

fun capture(cmd: str, args: [str]) > str !> any {
    final res = proc\exec(cmd, args: args, opts: {"quiet": true, "allow_failure": true});
    if (!res.ok) {
        throw "failures: {cmd} {args.join(" ")}: exit {res.code}: {res.stderr}";
    }
    return res.stdout;
}

// main copies the records in the run's artifacts to stdout untouched, for
// `magus query output --stdin`; a commit with no CI run exits 3.
export fun main(args: [str]) > void !> any {
    final want = parseFilter(args);
    var run = want.run;
    if (run == "") {
        final parsed = vcs\cmd(["rev-parse", "--verify", "{want.commit}^\{commit}"], opts: {"quiet": true, "allow_failure": true});
        if (!parsed.ok) {
            throw "failures: git rev-parse --verify {want.commit}: exit {parsed.code}: {parsed.stderr}";
        }
        final sha = parsed.stdout.trim();
        final listed = serialize\jsonDecode(capture("gh", args: ["run", "list", "--commit", sha, "--workflow", WORKFLOW,
            "--limit", "1", "--json", "databaseId"])).listValue();
        if (listed.len() == 0) {
            note("no {WORKFLOW} run for {sha}");
            os\exit(NOT_FOUND);
        }
        run = "{listed[0].q("databaseId").integerValue()}";
    }
    final names = logArtifacts(capture("gh", args: ["api", "repos/\{owner}/\{repo}/actions/runs/{run}/artifacts?per_page=100"]));
    if (names.len() == 0) {
        final fallback = fallbackLogs(run, gh: fun (ghArgs: [str]) > str !> any => capture("gh", args: ghArgs));
        if (fallback == "") {
            note("run {run} has no {ARTIFACT_PREFIX}* artifact and no failed job: nothing failed, or it has not finished");
            return;
        }
        note("run {run} has no {ARTIFACT_PREFIX}* artifact: fell back to the failed jobs' gh logs");
        io\stdout.write(fallback + "\n") catch void;
        return;
    }
    final dir = fs\tempDir("show-failures-");
    capture("gh", args: ["run", "download", run, "--pattern", "{ARTIFACT_PREFIX}*", "--dir", dir]);
    var found = 0;
    foreach (f in fs\glob(dir + "/*/" + RECORDS)) {
        io\stdout.write(fs\readFile(f.value)) catch void;
        found = found + 1;
    }
    fs\removeAll(dir) catch void;
    if (found == 0) {
        note("run {run}: {names.join(", ")} hold no {RECORDS}; the run predates the step that writes it");
    }
}

final LISTING = "\{\"artifacts\": [\{\"name\": \"magus-logs-01\", \"expired\": false}, \{\"name\": \"magus-history-01\", \"expired\": false}, \{\"name\": \"magus-logs-02\", \"expired\": true}]}";

test "only unexpired magus-logs artifacts are downloaded" {
    assert\equal(logArtifacts(LISTING) catch [<str>], want: ["magus-logs-01"], message: "names");
}

final JOBS = "\{\"jobs\": [\{\"databaseId\": 11, \"name\": \"doctor\", \"conclusion\": \"failure\"}, \{\"databaseId\": 12, \"name\": \"lint\", \"conclusion\": \"success\"}]}";

test "a failed plain job falls back to its gh log tail" {
    final seen = mut [<str>];
    final stub = fun (ghArgs: [str]) > str !> any {
        seen.append(ghArgs.join(" "));
        if (ghArgs.indexOf("--json") != null) {
            return JOBS;
        }
        return "setup\nerror one\nerror two";
    };
    final report = fallbackLogs("99", gh: stub) catch "";
    assert\equal(report.indexOf("doctor (job 11)") != null, want: true, message: "names the job");
    assert\equal(report.indexOf("error two") != null, want: true, message: "carries the log");
    assert\equal(report.indexOf("lint") == null, want: true, message: "passing job skipped");
    assert\equal(seen[1], want: "run view --job 11 --log-failed", message: "log call");
}

test "tail keeps the last lines" {
    assert\equal(tail("a\nb\nc\nd", count: 2), want: "c\nd", message: "last two");
    assert\equal(tail("a\nb", count: 5), want: "a\nb", message: "short log whole");
}

test "the run id must be a number" {
    final f = parseFilter(["--run", "37808757097"]) catch Filter{};
    assert\equal(f.run, want: "37808757097", message: "run");
    assert\equal(f.commit, want: "HEAD", message: "default commit");
    final bad = parseFilter(["--run", "abc"]) catch Filter{ run = "refused" };
    assert\equal(bad.run, want: "refused", message: "non-numeric run");
}
