// The gate creates a private checkout: ignored installations from the calling
// workspace never reach it. Install there before running the requested command.
import "magus";
import "os";
import "assert";

// Queue hooks insert project operands before their first --. Buzz forwards
// those operands and the following flags together, so gate mode restores run's
// delimiter before forwarding target arguments.
export fun commandArgs(args: [str]) > [str] {
    if (args.len() == 0 or args[0] != "gate") { return args; }
    final command = mut ["run", "ci:gha", "--no-default-charms"];
    final forwarded = mut [<str>];
    foreach (arg in args.sub(1)) {
        if (arg.startsWith("--")) { forwarded.append(arg); }
        else { command.append(arg); }
    }
    if (forwarded.len() > 0) { command.append("--"); }
    return command + forwarded;
}

fun main(args: [str]) > void !> any {
    if (args.len() == 0) { throw "usage: magus buzz hack/ci/with-harnesses.buzz -- <subcommand> [args...]"; }
    _ = magus\cmd("buzz", args: ["hack/dev/bootstrap-harnesses.buzz"]);
    final command = commandArgs(args);
    final checked = magus\cmd(command[0], args: command.sub(1), opts: magus\CommandOptions{allowFailure = true});
    if (checked.code != 0) { os\exit(checked.code); }
}

test "queue projects remain run operands before forwarded target flags" {
    assert\equal(commandArgs(["gate", "libs/a", "docs", "--inherited=fatal"]),
        want: ["run", "ci:gha", "--no-default-charms", "libs/a", "docs", "--", "--inherited=fatal"], message: "queue argv");
}

test "direct commands preserve every argument and delimiter" {
    final args = ["run", "ci:gha", ".", "--", "--inherited=fatal"];
    assert\equal(commandArgs(args), want: args, message: "direct argv");
}
