// Lines of `gh run view --log-failed`, trimmed from main's run 36279682496: job, step,
// timestamp, then the job's own output.
final FAILED_LOG = "magus shard 0: .\tRun CI for shard\t2026-09-26T23:42:55.9402489Z --- FAIL: TestAcquireDefersToAPredecessorThatHolds (0.05s)\n"
    + "magus shard 0: .\tRun CI for shard\t2026-09-26T23:42:55.9409496Z     --- FAIL: TestPipe/red_upstream (0.00s)\n"
    + "magus shard 0: .\tRun CI for shard\t2026-09-26T23:42:55.9415197Z --- FAIL: TestAcquireDefersToAPredecessorThatHolds (0.05s)\n"
    + "magus shard 2: docs\tRun CI for shard\t2026-09-26T23:37:10.6360667Z Getting action download info\n"
    + "magus shard 0: .\tRun CI for shard\t2026-09-26T23:42:56.0000000Z FAIL\tgithub.com/egladman/magus/internal/pipe\t4.1s\n";

final MAIN = Baseline{ url = "https://github.com/egladman/magus/actions/runs/36279682496",
    failingChecks = ["magus shard 0: .", "ci gate"], failingTests = ["TestAcquireDefersToAPredecessorThatHolds"] };

fun failed(name: str) > Check {
    return Check{ name = name, conclusion = "FAILURE", run = "11", job = "7", runUrl = "https://github.com/egladman/magus/actions/runs/11" };
}

test "a job log's failing Go tests are read once each, subtests included" {
    assert\equal(failingTestsOf(FAILED_LOG), want: ["TestAcquireDefersToAPredecessorThatHolds", "TestPipe/red_upstream"], message: "tests");
    assert\equal(failingTestsOf("ok  \tgithub.com/egladman/magus\t1.2s\n").len(), want: 0, message: "a passing log");
}

test "main's baseline is its latest run that passed or failed, and its failed jobs" {
    final runs = `[{"databaseId": 3, "conclusion": "cancelled", "url": "u3"}, {"databaseId": 2, "conclusion": "failure", "url": "u2"}, {"databaseId": 1, "conclusion": "success", "url": "u1"}]`;
    assert\equal(baselineRunOf(runs)!.q("url").stringValue(), want: "u2", message: "a cancelled run judged nothing");
    assert\equal(baselineRunOf(`[{"databaseId": 3, "conclusion": "cancelled", "url": "u3"}]`), want: null, message: "none judged");
    final jobs = `{"jobs": [{"name": "magus plan", "conclusion": "success"}, {"name": "magus shard 0: .", "conclusion": "failure"}, {"name": "magus advisor", "conclusion": "skipped"}, {"name": "magus shard 1: docs", "conclusion": "cancelled"}, {"name": "ci gate", "conclusion": "failure"}]}`;
    assert\equal(failingJobsOf(jobs), want: ["magus shard 0: .", "ci gate"], message: "failed jobs only");
}

test "a check's run page is kept for the evidence" {
    final p = pullOf(serialize\jsonDecode(SAMPLE));
    assert\equal(p.checks[1].runUrl, want: "https://github.com/egladman/magus/actions/runs/36074168245", message: "the run, not the job");
}

test "the checks on the head decide running, green, red-inherited and red" {
    final expect = fun (checks: [Check], facts: Facts, want: str) > Verdict {
        final v = verdictOf(Pull{ number = 1, checks = checks }, facts: facts);
        assert\equal(v.state, want: want, message: want);
        return v;
    };
    expect([<Check>], facts: Facts{}, want: "running");
    expect([green("t"), Check{ name = "u", conclusion = "PENDING" }], facts: Facts{ baseline = MAIN }, want: "running");
    expect([failed("magus shard 0: ."), Check{ name = "u", conclusion = "PENDING" }], facts: Facts{ baseline = MAIN }, want: "running");
    expect([green("t"), Check{ name = "u", conclusion = "SKIPPED" }], facts: Facts{}, want: "green");

    final inherited = expect([green("t"), failed("magus shard 0: ."), failed("ci gate")],
        facts: Facts{ baseline = MAIN, failingTests = ["TestAcquireDefersToAPredecessorThatHolds"] }, want: "red-inherited");
    assert\equal(inherited.mainRun, want: MAIN.url, message: "names main's run");
    assert\equal(inherited.headRuns, want: ["https://github.com/egladman/magus/actions/runs/11"], message: "names the head's run");

    final newTest = expect([failed("magus shard 0: ."), failed("ci gate")],
        facts: Facts{ baseline = MAIN, failingTests = ["TestAcquireDefersToAPredecessorThatHolds", "TestKeyIsStable"] }, want: "red");
    assert\equal([newTest.newChecks.len(), newTest.newTests.len()], want: [0, 1], message: "only the test main passes");
    assert\equal(newTest.newTests, want: ["TestKeyIsStable"], message: "names it");

    final newCheck = expect([failed("magus shard 0: ."), failed(HYGIENE)], facts: Facts{ baseline = MAIN }, want: "red");
    assert\equal(newCheck.newChecks, want: [HYGIENE], message: "the check main passes");

    expect([failed("magus shard 1: ."), failed("ci gate")],
        facts: Facts{ baseline = MAIN, failingTests = ["TestAcquireDefersToAPredecessorThatHolds"] }, want: "red-inherited");
    assert\equal([checkKey("magus shard 0: docs"), checkKey("magus shard 2: docs"), checkKey("ci gate")],
        want: ["magus shard : docs", "magus shard : docs", "ci gate"], message: "a shard is matched by its project");
    final cancelled = expect([Check{ name = "magus shard 0: .", conclusion = "CANCELLED", run = "11" }], facts: Facts{ baseline = MAIN }, want: "red");
    assert\equal(cancelled.newChecks, want: ["magus shard 0: ."], message: "a run that never judged the change is not main's failure");
    expect([failed("magus shard 0: .")], facts: Facts{}, want: "red");
}

test "only a green or red-inherited pull request on a merge-ready stage carries a merge command" {
    final inheritedFacts = Facts{ baseline = MAIN, failingTests = ["TestAcquireDefersToAPredecessorThatHolds"] };
    final expect = fun (p: Pull, facts: Facts, state: str, merge: bool) > Record {
        final r = classify(p, open: [p], facts: facts);
        assert\equal(r.state, want: state, message: "#{p.number} {r.reason}");
        assert\equal(r.merge == "gh pr merge {p.number} --squash --admin", want: merge, message: "#{p.number} merge");
        if (!merge) {
            assert\equal(r.merge, want: "", message: "#{p.number} no command");
        }
        return r;
    };
    final lone = expect(Pull{ number = 1, checks = [green("t")] }, facts: Facts{}, state: "green", merge: true);
    assert\equal(lone.action, want: "queue", message: "apply still queues green");
    expect(Pull{ number = 2, checks = [green("t")], mergeState = "BEHIND" }, facts: Facts{}, state: "green", merge: true);
    expect(Pull{ number = 3, checks = [green("t")], autoMerge = true }, facts: Facts{}, state: "green", merge: true);

    final inherited = expect(Pull{ number = 4, checks = [failed("magus shard 0: .")] }, facts: inheritedFacts, state: "red-inherited", merge: true);
    assert\equal([inherited.action, inherited.model], want: ["none", "none"], message: "nothing for an agent to fix");
    assert\equal(applyCommands(inherited, method: "squash").len(), want: 0, message: "apply neither queues nor reruns it");

    expect(Pull{ number = 5, checks = [failed("magus shard 0: .")] }, facts: Facts{}, state: "red", merge: false);
    expect(Pull{ number = 6, checks = [green("t"), Check{ name = "u", conclusion = "PENDING" }] }, facts: Facts{}, state: "running", merge: false);
    expect(Pull{ number = 7, checks = [green("t")], draft = true }, facts: Facts{}, state: "green", merge: false);
    expect(Pull{ number = 8, checks = [green("t")], mergeable = "CONFLICTING" }, facts: Facts{}, state: "green", merge: false);
    expect(Pull{ number = 9, checks = [green("t")], labels = [KICKED] }, facts: Facts{}, state: "green", merge: false);
    expect(Pull{ number = 10, checks = [green("t")], state = "MERGED" }, facts: Facts{}, state: "green", merge: false);
    expect(Pull{ number = 11, checks = [green("t")], mergeable = "UNKNOWN" }, facts: Facts{}, state: "green", merge: false);
}

test "a red-inherited line names both runs, a red one the failures main does not have" {
    final inherited = classify(Pull{ number = 4, head = "h", checks = [failed("magus shard 0: .")] }, open: [<Pull>],
        facts: Facts{ baseline = MAIN, failingTests = ["TestAcquireDefersToAPredecessorThatHolds"] });
    final line = render(inherited);
    foreach (want in [`"state":"red-inherited"`, `"merge":"gh pr merge 4 --squash --admin"`, `"main_run":"{MAIN.url}"`,
        `"head_runs":["https://github.com/egladman/magus/actions/runs/11"]`, `"failing_tests":["TestAcquireDefersToAPredecessorThatHolds"]`]) {
        assert\equal(line.indexOf(want) != null, want: true, message: "{want} in {line}");
    }
    final red = render(classify(Pull{ number = 5, checks = [failed("magus shard 0: .")] }, open: [<Pull>],
        facts: Facts{ baseline = MAIN, failingTests = ["TestKeyIsStable"] }));
    assert\equal(red.indexOf(`"tests_main_passes":["TestKeyIsStable"]`) != null, want: true, message: red);
    assert\equal(red.indexOf(`"merge"`) == null, want: true, message: "no merge command on red");
    assert\equal(red.indexOf("ready") == null and line.indexOf("ready") == null, want: true, message: "no word the board does not define");
}

final AT = "2026-09-26T20:00:00Z";

fun has(page: str, want: str) > void !> any {
    assert\equal(page.indexOf(want) != null, want: true, message: "{want} in:\n{page}");
}

fun lacks(page: str, want: str) > void !> any {
    assert\equal(page.indexOf(want) == null, want: true, message: "no {want} in:\n{page}");
}

// figureIn decodes the graph a page links, and throws when it links none.
fun figureIn(page: str) > serialize\Boxed !> any {
    final open = "[The queue as a graph](";
    final at = page.indexOf(open);
    if (at == null) {
        throw "no graph link in:\n{page}";
    }
    final rest = page.sub(at! + open.len());
    return figurelink\decodeFigureLink(rest.sub(0, len: rest.indexOf(")")!));
}

// idsOf is the ids of the graph's nodes, in order.
fun idsOf(doc: serialize\Boxed) > [str] {
    final acc = mut [<str>];
    foreach (n in doc.q("nodes").listValue()) {
        acc.append(n.q("id").stringValue());
    }
    return acc;
}

// edgesOf is the graph's edges as "from>to".
fun edgesOf(doc: serialize\Boxed) > [str] {
    final acc = mut [<str>];
    foreach (e in doc.q("edges").listValue()) {
        acc.append(e.listValue()[0].stringValue() + ">" + e.listValue()[1].stringValue());
    }
    return acc;
}

fun isAscii(page: str) > bool {
    var i = 0;
    while (i < page.len()) {
        if (page.byte(i) >= 128) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fun board(open: [Pull], queue: [Queued]) > Board {
    return Board{ base = "main", at = AT, tip = "cba6465e8617a1b2", open = open, pulls = open, queue = queue };
}

fun kickedBy(n: int, code: str) > Pull {
    return Pull{ number = n, head = "k{n}", title = "kicked {code}", labels = [KICKED],
        kick = Kick{ code = code, paths = ["a.go", "b.go"], url = "https://github.com/o/r/pull/{n}#issuecomment-1",
            reason = "The merge queue cannot merge this change.", requeue = "gh pr merge {n} --auto --rebase", at = "2026-09-26T18:55:51Z" } };
}

test "an empty queue says so, links nothing, and ends with the marker" {
    final page = dashboardOf(board([<Pull>], queue: [<Queued>]));
    has(page, want: "## Merge queue\n\nUpdated 2026-09-26 20:00 UTC, with `main` at `cba6465e8617`.");
    has(page, want: "In flight 0 | Queued 0 | Needs the author 0 | Needs a manual merge 0 | Could join 0 | Drafts and forks 0");
    has(page, want: "Nothing is queued.");
    lacks(page, want: "#figure=");
    lacks(page, want: "```mermaid");
    lacks(page, want: "###");
    assert\equal(page.endsWith("\n" + DASHBOARD_MARKER + "\n"), want: true, message: "the marker closes the page");
    assert\equal(isAscii(page), want: true, message: "ASCII");
}

test "a partition of three links each behind the base, and tables them" {
    final open = [
        Pull{ number = 1, head = "a", title = "one", autoMerge = true, checks = [green("t")] },
        Pull{ number = 2, head = "b", title = "two", autoMerge = true, checks = [green("t")] },
        Pull{ number = 3, head = "c", title = "three", autoMerge = true },
    ];
    final b = Board{ base = "main", at = AT, open = open, pulls = open,
        queue = [Queued{ id = 1 }, Queued{ id = 2 }, Queued{ id = 3 }],
        waits = {2: Wait{ description = "waiting: WAIT_BEHIND a change validated beneath it did not merge", since = "2026-09-26T19:00:00Z" }},
        flights = {1: Flight{ url = "https://github.com/o/r/actions/runs/9/job/8", since = "2026-09-26T19:30:00Z" }} };
    final page = dashboardOf(b);
    has(page, want: "[The queue as a graph](" + figurelink\defaultConsoleBase + "graph/#figure=");
    lacks(page, want: "```mermaid");
    final doc = figureIn(page);
    assert\equal(doc.q("kind").stringValue(), want: "deps", message: "kind");
    assert\equal(doc.q("title").stringValue(), want: "Merge queue into main", message: "title");
    assert\equal(idsOf(doc), want: ["base", "pr1", "pr2", "pr3"], message: "the base, then each change");
    assert\equal(doc.q("nodes").listValue()[0].q("label").stringValue(), want: "main", message: "the base's label");
    assert\equal(doc.q("nodes").listValue()[1].q("label").stringValue(), want: "#1 one", message: "a change's label");
    assert\equal(edgesOf(doc), want: ["base>pr1", "base>pr2", "base>pr3"], message: "each behind the base");
    has(page, want: "In flight 1 | Queued 2 |");
    has(page, want: "### In flight\n\n| Pull request | Head | Since (UTC) | Why | What to do |\n| --- | --- | --- | --- | --- |\n"
        + "| #1 one | `a` | 2026-09-26 19:30 | validating in [its run](https://github.com/o/r/actions/runs/9/job/8) | wait for the run |");
    has(page, want: "| #2 two | `b` | 2026-09-26 19:00 | waiting: WAIT_BEHIND a change validated beneath it did not merge | wait |");
    has(page, want: "| #3 three | `c` | - | queued | wait |");
    lacks(page, want: "Nothing is queued.");
}

test "a stack links each member behind the one it is stacked on" {
    final open = [
        Pull{ number = 10, head = "s1", title = "bottom" },
        Pull{ number = 11, head = "s2", base = "s1", title = "top", labels = ["merge-queue: squash"] },
    ];
    final page = dashboardOf(board(open, queue: [Queued{ id = 10 }, Queued{ id = 11, parent = 10 }]));
    assert\equal(edgesOf(figureIn(page)), want: ["base>pr10", "pr10>pr11"], message: "the top behind the bottom");
    has(page, want: "| #11 top | `s2` | - | stacked on #10, which has not merged | wait |");
}

test "an empty queue has no graph" {
    assert\equal(queueGraphOf(board([<Pull>], queue: [<Queued>]), sections: {<int: str>}) == null, want: true, message: "an empty queue has none");
}

test "each kick code goes to the author, and a regeneration to a manual merge" {
    final open = [kickedBy(1, code: "KICK_CONFLICT"), kickedBy(2, code: "KICK_RED"), kickedBy(3, code: "KICK_REFUSED"),
        kickedBy(4, code: "KICK_REGENERATION"), Pull{ number = 5, head = "k5", title = "unexplained", labels = [KICKED] }];
    final page = dashboardOf(board(open, queue: [<Queued>]));
    has(page, want: "Needs the author 4 | Needs a manual merge 1 |");
    foreach (code in ["KICK_CONFLICT", "KICK_RED", "KICK_REFUSED"]) {
        has(page, want: "| {code}: The merge queue cannot merge this change. (2 files) [comment](https://github.com/o/r/pull/");
    }
    has(page, want: "| #1 kicked KICK_CONFLICT | `k1` | 2026-09-26 18:55 | KICK_CONFLICT: ");
    has(page, want: "| fix it, then `gh pr merge 1 --auto --rebase` |");
    has(page, want: "| #5 unexplained | `k5` | - | labeled {KICKED}, and no kick-back comment says why | fix it, then `gh pr merge 5 --auto --squash` |");
    has(page, want: "### Needs a manual merge\n\n| Pull request | Head | Since (UTC) | Why | What to do |\n| --- | --- | --- | --- | --- |\n"
        + "| #4 kicked KICK_REGENERATION | `k4` | 2026-09-26 18:55 | KICK_REGENERATION: The merge queue cannot merge this change. (2 files) "
        + "[comment](https://github.com/o/r/pull/4#issuecomment-1) | merge `main` in, run `magus run generate:rw`, push, then "
        + "`gh pr merge 4 --auto --rebase`; or a person merges it past the queue: `gh pr merge 4 --squash --admin` |");
    final doc = figureIn(page);
    assert\equal(idsOf(doc), want: ["base", "pr1", "pr2", "pr3", "pr4", "pr5"], message: "a kicked change is a node");
    assert\equal(doc.q("nodes").listValue()[4].q("label").stringValue(), want: "#4 kicked KICK_REGENERATION", message: "its label");
    assert\equal(edgesOf(doc).len(), want: 0, message: "stacked on nothing");
    final labeled = dashboardOf(board([Pull{ number = 6, labels = [NEEDS_REGENERATION] }], queue: [<Queued>]));
    has(labeled, want: "Needs a manual merge 1");
}

test "a draft and a fork are one line each, and neither is graphed" {
    final open = [Pull{ number = 7, title = "wip", draft = true, autoMerge = true }, Pull{ number = 8, title = "outside", fork = true, review = "APPROVED", checks = [green("t")] }];
    final page = dashboardOf(board(open, queue: [<Queued>]));
    has(page, want: "### Drafts and forks\n\n- #7 wip: a draft\n- #8 outside: from a fork, which the queue refuses; a person decides how it reaches `main`\n");
    has(page, want: "Drafts and forks 2");
    lacks(page, want: "#figure=");
    lacks(page, want: "```mermaid");
}

test "an approved green pull request with no intent could join, by the command that queues it" {
    final lone = Pull{ number = 20, head = "j", title = "join me", review = "APPROVED", checks = [green("t")] };
    final conflicting = Pull{ number = 21, head = "c", title = "conflicts", review = "APPROVED", checks = [green("t")], mergeable = "CONFLICTING" };
    final bottom = Pull{ number = 22, head = "b1", title = "bottom", review = "APPROVED", checks = [green("t")] };
    final top = Pull{ number = 23, head = "b2", base = "b1", title = "top" };
    final unapproved = Pull{ number = 24, head = "u", title = "unapproved", checks = [green("t")] };
    final page = dashboardOf(board([lone, conflicting, bottom, top, unapproved], queue: [<Queued>]));
    has(page, want: "| #20 join me | `j` | - | approved; checks green | `gh pr merge 20 --auto --squash` |");
    has(page, want: "| `gh pr edit 21 --add-label \"merge-queue: squash\"` |");
    has(page, want: "| `gh pr edit 23 --add-label \"merge-queue: squash\"` |");
    has(page, want: "2 more open, with no merge intent and not both approved and green: #23, #24.");
}

test "the page is ASCII, and a title cannot break a table or the graph" {
    final open = [Pull{ number = 30, head = "t", title = "caf\195\169 | \"quoted\" #1; <b>", autoMerge = true }];
    final page = dashboardOf(board(open, queue: [Queued{ id = 30 }]));
    assert\equal(isAscii(page), want: true, message: page);
    has(page, want: "| #30 caf? \\| \"quoted\" #1; <b> | `t` |");
    assert\equal(figureIn(page).q("nodes").listValue()[1].q("label").stringValue(), want: "#30 caf? | \"quoted\" #1; <b>", message: "the label");
}

test "the week's merges are counted by who merged them" {
    final b = Board{ base = "main", at = AT, open = [<Pull>], pulls = [<Pull>], merged = [
        Merged{ number = 3, at = "2026-09-26T10:00:00Z", byQueue = true },
        Merged{ number = 2, at = "2026-09-22T10:00:00Z", byQueue = false },
        Merged{ number = 1, at = "2026-09-10T10:00:00Z", byQueue = false },
    ] };
    has(dashboardOf(b), want: "Merged into `main` in the last 7 days: 1 by the queue, 1 past it (its `merge-queue` status was not success when it merged).");
}

test "the dashboard's reads parse into what it renders" {
    final ls = `{"schema":"mergequeue.changes/v1","base":"main","changes":[{"id":"4","head":"h4","base":"main","method":"squash","fork":false,"affected":[]},{"id":"5","head":"h5","base":"main","method":"squash","parent":"4","fork":false,"affected":[]}]}`;
    final q = queueOf(ls);
    assert\equal([q[0].id, q[1].id, q[1].parent ?? 0], want: [4, 5, 4], message: "queue order and parent");
    assert\equal(q[0].parent, want: null, message: "on the base");
    assert\equal(queueOf(`{"schema":"mergequeue.changes/v1","base":"main","changes":null}`).len(), want: 0, message: "an empty queue");

    final merged = mergedOf(`[{"number": 9, "mergedAt": "2026-09-26T10:00:00Z", "statusCheckRollup": [{"__typename": "StatusContext", "context": "merge-queue", "state": "SUCCESS"}]},
        {"number": 8, "mergedAt": "2026-09-26T09:00:00Z", "statusCheckRollup": [{"__typename": "StatusContext", "context": "merge-queue", "state": "PENDING"}]}]`);
    assert\equal([merged[0].byQueue, merged[1].byQueue], want: [true, false], message: "who merged");

    final w = waitOf(`{"statuses": [{"context": "ci", "description": "x"}, {"context": "merge-queue", "description": "waiting: WAIT_CHECKS", "updated_at": "2026-09-26T19:00:00Z"}]}`);
    assert\equal([w!.description, w!.since], want: ["waiting: WAIT_CHECKS", "2026-09-26T19:00:00Z"], message: "the queue's status");
    assert\equal(waitOf(`{"statuses": []}`), want: null, message: "none posted");

    final flights = flightsOf(`{"jobs": [{"name": "queue plan", "status": "completed", "url": "p"},
        {"name": "queue validate #4", "status": "in_progress", "url": "u4", "startedAt": "2026-09-26T19:30:00Z"},
        {"name": "queue validate #5", "status": "completed", "url": "u5"}]}`);
    assert\equal(flights.len(), want: 1, message: "the running validation only");
    assert\equal(flights[4]!.url, want: "u4", message: "by pull request");
}

test "a kick-back comment gives its first report line and its requeue command" {
    final p = pullOf(serialize\jsonDecode(SAMPLE));
    assert\equal([p.kick!.reason, p.kick!.requeue], want: ["It conflicts with main outside the generated files.", "gh pr merge 317 --auto --squash"], message: "plain");
    final stack = kickProse("### Merge queue: kicked back\n\nThe gate was red.\n\nQueue the stack again once fixed: `gh pr edit 9 --add-label \"merge-queue: squash\"`\n\n<!-- mergequeue: \{} -->");
    assert\equal(stack, want: ["The gate was red.", "gh pr edit 9 --add-label \"merge-queue: squash\""], message: "a stack's");
    assert\equal(kickProse("<!-- mergequeue: \{} -->"), want: ["", ""], message: "nothing but the marker");
}
