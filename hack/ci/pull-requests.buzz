}

test "each kick code goes to the author, and a regeneration to a manual merge, as a node with no edge" {
    final open = [kickedBy(1, code: "KICK_CONFLICT"), kickedBy(2, code: "KICK_RED"), kickedBy(3, code: "KICK_REFUSED"),
        kickedBy(4, code: "KICK_REGENERATION"), Pull{ number = 5, head = "k5", title = "unexplained", labels = [KICKED] }];
    final page = renderDashboard(board(open, queue: [<Queued>]));
    has(page, want: "1 to merge by hand · 4 kicked back");
    foreach (code in ["KICK_CONFLICT", "KICK_RED", "KICK_REFUSED"]) {
        has(page, want: "`{code}`: The merge queue cannot merge this change. (2 files) · [comment](https://github.com/o/r/pull/");
    }
    has(page, want: "- **#5** labeled {KICKED}, and no kick-back comment says why<br>by hand, once fixed: `gh pr merge 5 --auto --squash`");
    final doc = figureIn(page);
    assert\equal(idsOf(doc), want: ["base", "pr1", "pr2", "pr3", "pr4", "pr5"], message: "a kicked change is a node");
    assert\equal(edgesOf(doc).len(), want: 0, message: "stacked on nothing");
    final labeled = renderDashboard(board([Pull{ number = 6, labels = [NEEDS_REGENERATION] }], queue: [<Queued>]));
    has(labeled, want: "1 to merge by hand");
}

test "a title cannot break a table, a box line or the graph" {
    final open = [Pull{ number = 30, head = "t", title = "caf\195\169 | \"quoted\" #1; <!-- magus-queue: start -->", autoMerge = true }];
    final page = renderDashboard(board(open, queue: [Queued{ id = 30 }]));
    has(page, want: "| 1 | #30 caf? \\| \"quoted\" #1; &lt;!-- magus-queue: start --><br><sub>`t`</sub> | queued 1st | running | - | wait: queued |\n");
    final odd = Pull{ number = 31, head = "a|b", author = "x|y", title = "t", review = "APPROVED", checks = [green("t")] };
    has(renderDashboard(board([odd], queue: [<Queued>])), want: "| 1 | #31 t<br><sub>x\\|y · `a\\|b`</sub> | can join |");
    assert\equal(marksOf(page).len(), want: 2, message: "the title's marker is no box: {marksOf(page)}");
    assert\equal(figureIn(page).q("nodes").listValue()[1].q("label").stringValue(), want: "#30 caf? | \"quoted\" #1; <!-- magus-queue...", message: "the label");
}

test "the week's merges are counted by who merged them" {
