        Merged{ number = 3, at = "2026-09-26T10:00:00Z", byQueue = true },
        Merged{ number = 2, at = "2026-09-22T10:00:00Z", byQueue = false },
        Merged{ number = 1, at = "2026-09-10T10:00:00Z", byQueue = false },
    ] };
    has(renderDashboard(b), want: "merged in 7 days: 1 by the queue, 1 past it");
}

test "the dashboard's reads parse into what it renders" {
    final ls = `{"schema":"mergequeue.changes/v1","base":"main","changes":[{"id":"4","head":"h4","base":"main","method":"squash","fork":false,"affected":[]},{"id":"5","head":"h5","base":"main","method":"squash","parent":"4","fork":false,"affected":[]}]}`;
    final q = queueOf(ls);
    assert\equal([q[0].id, q[1].id, q[1].parent ?? 0], want: [4, 5, 4], message: "queue order and parent");
    assert\equal(q[0].parent, want: null, message: "on the base");
    assert\equal(queueOf(`{"schema":"mergequeue.changes/v1","base":"main","changes":null}`).len(), want: 0, message: "an empty queue");

    final merged = mergedOf(`[{"number": 9, "mergedAt": "2026-09-26T10:00:00Z", "statusCheckRollup": [{"__typename": "StatusContext", "context": "merge-queue", "state": "SUCCESS"}]},
        {"number": 8, "mergedAt": "2026-09-26T09:00:00Z", "statusCheckRollup": [{"__typename": "StatusContext", "context": "merge-queue", "state": "PENDING"}]}]`);
    assert\equal([merged[0].byQueue, merged[1].byQueue], want: [true, false], message: "who merged");

    final w = waitOf(`{"statuses": [{"context": "ci", "description": "x"}, {"context": "merge-queue", "description": "waiting: WAIT_CHECKS", "updated_at": "2026-09-26T19:00:00Z"}]}`);
    assert\equal([w!.description, w!.since], want: ["waiting: WAIT_CHECKS", "2026-09-26T19:00:00Z"], message: "the queue's status");
    assert\equal(waitOf(`{"statuses": []}`), want: null, message: "none posted");

    final flights = flightsOf(`{"jobs": [{"name": "queue plan", "status": "completed", "url": "p"},
        {"name": "queue validate #4", "status": "in_progress", "url": "u4", "startedAt": "2026-09-26T19:30:00Z"},
        {"name": "queue validate #5", "status": "completed", "url": "u5"}]}`);
    assert\equal(flights.len(), want: 1, message: "the running validation only");
    assert\equal(flights[4]!.url, want: "u4", message: "by pull request");

    final running = mainRunOf(`[{"status": "in_progress", "conclusion": "", "url": "r3"}, {"status": "completed", "conclusion": "success", "url": "r2"}]`);
    assert\equal([running!.state, running!.url], want: ["running", "r3"], message: "a run still going");
    final red = mainRunOf(`[{"status": "completed", "conclusion": "cancelled", "url": "r3"}, {"status": "completed", "conclusion": "failure", "url": "r2"}]`);
    assert\equal([red!.state, red!.url], want: ["red", "r2"], message: "a cancelled run judged nothing");
    assert\equal(mainRunOf(`[]`), want: null, message: "no run");
}

test "a kick-back comment gives its first report line and its requeue command" {
    final p = pullOf(serialize\jsonDecode(SAMPLE));
    assert\equal([p.kick!.reason, p.kick!.requeue], want: ["It conflicts with main outside the generated files.", "gh pr merge 317 --auto --squash"], message: "plain");
    final stack = kickProse("### Merge queue: kicked back\n\nThe gate was red.\n\nQueue the stack again once fixed: `gh pr edit 9 --add-label \"merge-queue: squash\"`\n\n<!-- mergequeue: \{} -->");
    assert\equal(stack, want: ["The gate was red.", "gh pr edit 9 --add-label \"merge-queue: squash\""], message: "a stack's");
    assert\equal(kickProse("<!-- mergequeue: \{} -->"), want: ["", ""], message: "nothing but the marker");
}

fun keysOf(marks: [Mark]) > [str] {
    final acc = mut [<str>];
    foreach (m in marks) {
        var state = " ";
        if (m.checked) {
            state = "x";
        }
        acc.append("{state} {m.action} {m.pr}");
    }
    return acc;
}

test "each box offered is drawn unchecked, and reads back as the box it is" {
    final b = fullBoard();
    final offered = offeredBoxes(b, placed: placePulls(b));
    final want = mut [<str>];
    foreach (x in offered) {
        want.append("  {x.action} {x.pr}");
    }
    assert\equal(want, want: ["  start 0", "  render 0", "  rerun 3", "  requeue 6", "  rerun 6", "  requeue 7", "  queue 8", "  rerun 12"], message: "the boxes");
    final drawn = mut [<str>];
    foreach (k in keysOf(marksOf(renderDashboard(b)))) {
        drawn.append(k);
    }
    drawn.sort(fun (a: str, c: str) > bool => a < c);
    want.sort(fun (a: str, c: str) > bool => a < c);
    assert\equal(drawn, want: want, message: "drawn unchecked, once each");
    foreach (x in offered) {
        if (x.action == "requeue") {
            assert\equal(x.method, want: "rebase", message: "the kick-back's method");
        }
        if (x.action == "rerun" and x.pr != 3) {
            assert\equal(x.runs, want: ["11"], message: "each failed run once");
        }
    }
}

test "a stack, a conflicting pull request and one in flight offer no box of their own" {
    final b = fullBoard();
    foreach (x in offeredBoxes(b, placed: placePulls(b))) {
        assert\equal([4, 5, 9, 1, 10, 11].indexOf(x.pr) == null, want: true, message: "a box for #{x.pr}");
    }
    final bottom = Pull{ number = 40, head = "b1", labels = [KICKED], kick = Kick{ code = "KICK_RED" } };
    final top = Pull{ number = 41, head = "b2", base = "b1" };
    final kicked = board([bottom, top], queue: [<Queued>]);
    final boxes = offeredBoxes(kicked, placed: placePulls(kicked));
    assert\equal(boxes.len(), want: 2, message: "the controls alone for a kicked stack");
    has(renderDashboard(kicked), want: "fix it, then requeue (see why)");
}

test "box markers parse only in the shape the page draws" {
    final body = "- [ ] <!-- magus-queue: start --> run\n"
        + "- [x] <!-- magus-queue: requeue 514 --> requeue\n"
        + "  * [X] <!-- magus-queue: rerun 7 --> nested\n"
        + "- [x] <!-- magus-queue: requeue --> no number\n"
        + "- [x] <!-- magus-queue: start 3 --> a number it does not take\n"
        + "- [x] <!-- magus-queue: merge 5 --> no such action\n"
        + "- [x] <!-- magus-queue: queue 05 --> not a plain number\n"
        + "- [x] <!-- magus-queue: queue -1 --> not a number\n"
        + "[x] <!-- magus-queue: render --> not a list item\n"
        + "- [x] see <!-- magus-queue: render --> marker not first\n"
        + "<!-- magus-queue-dashboard -->";
    assert\equal(keysOf(marksOf(body)), want: ["  start 0", "x requeue 514", "x rerun 7"], message: "the boxes");
}

test "only a box unchecked before the edit and checked after it counts, once" {
    final before = "- [ ] <!-- magus-queue: start -->\n- [x] <!-- magus-queue: requeue 6 -->\n- [ ] <!-- magus-queue: queue 8 -->";
    final after = "- [x] <!-- magus-queue: start -->\n- [x] <!-- magus-queue: requeue 6 -->\n- [x] <!-- magus-queue: queue 8 -->\n- [x] <!-- magus-queue: queue 8 -->";
    assert\equal(keysOf(checkedNow(before, after: after)), want: ["x start 0", "x queue 8"], message: "the new checks");
    assert\equal(checkedNow(after, after: after).len(), want: 0, message: "already checked runs nothing again");
    assert\equal(keysOf(checkedNow("", after: "- [x] <!-- magus-queue: render -->")), want: ["x render 0"], message: "absent before counts as unchecked");
    final web = "- [ ] <!-- magus-queue: start -->\r\n- [x] <!-- magus-queue: rerun 3 -->\r\n";
    assert\equal(keysOf(checkedNow(web, after: web.replace("[ ]", with: "[x]"))), want: ["x start 0"], message: "the web editor's CRLF");
}

fun edit(sender: str, bot: bool) > Edit {
    return Edit{ issue = 515, sender = sender, bot = bot, bodyEdited = true,
        before = "- [ ] <!-- magus-queue: requeue 6 -->\n- [ ] <!-- magus-queue: rerun 3 -->",
        after = "- [x] <!-- magus-queue: requeue 6 -->\n- [x] <!-- magus-queue: rerun 3 -->" };
}

test "an edit acts only for a writer, on the dashboard's body" {
    assert\equal(refusalOf(edit("eli", bot: false), issue: 515, role: null), want: "", message: "before the role is read");
    foreach (role in ACTING_ROLES) {
        assert\equal(refusalOf(edit("eli", bot: false), issue: 515, role: role), want: "", message: role);
    }
    assert\equal(refusalOf(edit("eli", bot: false), issue: 516, role: "admin"), want: "issue #515 is not the dashboard, #516", message: "another issue");
    final title = Edit{ issue = 515, sender = "eli", bot = false, bodyEdited = false };
    assert\equal(refusalOf(title, issue: 515, role: "admin"), want: "the edit changed the title, not the body", message: "a title edit");
    assert\equal(refusalOf(edit("renovate[bot]", bot: true), issue: 515, role: null), want: "renovate[bot] is a bot, and a bot's checks are ignored", message: "a bot");
    assert\equal(refusalOf(edit("a/../b", bot: false), issue: 515, role: null), want: "\"a/../b\" is not a user's login", message: "a login for a path");
    assert\equal(refusalOf(edit("pat", bot: false), issue: 515, role: "triage"), want: "pat has triage access, and a box acts only for admin, maintain, write", message: "triage");
    assert\equal(refusalOf(edit("pat", bot: false), issue: 515, role: ""), want: "pat has no access, and a box acts only for admin, maintain, write", message: "none");
}

test "an unauthorized sender's checks take nothing, even a box the board offers" {
    final offered = [Box{ action = "requeue", pr = 6, method = "rebase" }, Box{ action = "rerun", pr = 3, runs = ["11"] }];
    final reader = respond(edit("pat", bot: false), issue: 515, role: "read", offered: offered);
    assert\equal(reader.refusal != "", want: true, message: "refused");
    assert\equal(reader.marks.len(), want: 2, message: "it still says what was checked");
    assert\equal(reader.choice.take.len(), want: 0, message: "and takes none");
    assert\equal(planOf(reader.choice.take), want: "[]", message: "an empty plan");
    has(replySummary(edit("pat", bot: false), role: "read", res: reader), want: "> [!WARNING]\n> Ignored 2 checked box(es) on #515: pat has read access");
    final bot = respond(edit("renovate[bot]", bot: true), issue: 515, role: "", offered: offered);
    assert\equal(bot.choice.take.len(), want: 0, message: "a bot takes none");

    final writer = respond(edit("eli", bot: false), issue: 515, role: "maintain", offered: offered);
    assert\equal(writer.refusal, want: "", message: "a maintainer");
    assert\equal(writer.choice.take.len(), want: 2, message: "takes both");
}

test "a checked box the board no longer offers is skipped, and says so" {
    final res = respond(edit("eli", bot: false), issue: 515, role: "write", offered: [Box{ action = "rerun", pr = 3, runs = ["11"] }]);
    assert\equal(res.choice.take.len(), want: 1, message: "the rerun");
    assert\equal(res.choice.skip, want: ["requeue #6: the queue no longer offers that box; the page shows what it does now"], message: "the requeue");
    final summary = replySummary(edit("eli", bot: false), role: "write", res: res);
    has(summary, want: "eli (write) checked 2 box(es) on #515.");
    has(summary, want: "- done: rerun the failed jobs of #3 (11)");
    has(summary, want: "- skipped: requeue #6:");
}

test "a box's commands are auto-merge and reruns; the plan carries them to act" {
    final take = [Box{ action = "requeue", pr = 6, method = "rebase" }, Box{ action = "queue", pr = 8 },
        Box{ action = "rerun", pr = 3, runs = ["11", "12"] }, Box{ action = "start" }, Box{ action = "render" }];
    final cmds = mut [<[str]>];
    foreach (x in boxesFromPlan(planOf(take))) {
        foreach (c in commandsOf(x)) {
            cmds.append(c);
        }
    }
    assert\equal(cmds, want: [
        ["gh", "pr", "merge", "6", "--auto", "--rebase"],
        ["gh", "pr", "merge", "8", "--auto", "--squash"],
        ["gh", "run", "rerun", "11", "--failed"],
        ["gh", "run", "rerun", "12", "--failed"],
    ], message: "the commands");
    var refused = false;
    try {
        boxesFromPlan(`[{"action": "queue", "pr": 8, "method": "squash --admin", "runs": []}]`);
    } catch (e) {
        refused = true;
    }
    assert\equal(refused, want: true, message: "a method the queue does not take");
}

test "an issues edited event reads into an edit" {
    final e = editOf(`{"action": "edited", "changes": {"body": {"from": "- [ ] <!-- magus-queue: start -->"}},
        "issue": {"number": 515, "body": "- [x] <!-- magus-queue: start -->"}, "sender": {"login": "eli", "type": "User"}}`);
    assert\equal([e.issue, e.sender, e.bot, e.bodyEdited], want: [515, "eli", false, true], message: "the edit");
    assert\equal(keysOf(checkedNow(e.before, after: e.after)), want: ["x start 0"], message: "the box");
    final title = editOf(`{"action": "edited", "changes": {"title": {"from": "x"}}, "issue": {"number": 515, "body": "- [x] <!-- magus-queue: start -->"},
        "sender": {"login": "github-actions[bot]", "type": "Bot"}}`);
    assert\equal([title.bodyEdited, title.bot], want: [false, true], message: "a bot's title edit");
}

test "boxes and act take their flags, and refuse what is missing" {
    final o = boxFlagsOf("boxes", argv: ["--event", "e.json", "--issue", "515", "--plan", "p.json", "--out", "s.md"]);
    assert\equal([o.event, o.plan, o.summary, o.base], want: ["e.json", "p.json", "s.md", "main"], message: "boxes");
    assert\equal(o.issue, want: 515, message: "the issue");
    assert\equal(boxFlagsOf("act", argv: ["--plan", "p.json"]).plan, want: "p.json", message: "act");
    foreach (c in [["boxes", "--event", "e", "--issue", "", "--plan", "p", "--out", "s"], ["boxes", "--event", "e", "--issue", "x", "--plan", "p", "--out", "s"],
            ["boxes", "--issue", "5", "--plan", "p", "--out", "s"], ["act"], ["act", "--plan", "p", "--issue", "5"]]) {
        var refused = false;
        try {
            boxFlagsOf(c[0], argv: c.sub(1));
        } catch (e) {
            refused = true;
        }
        assert\equal(refused, want: true, message: c.join(" "));
    }
}
