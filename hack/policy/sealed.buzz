// sealed-read (deny): a shell line that reads, lists, copies or searches the sealed
//   proofread sets under $XDG_CACHE_HOME/proofread-calibration/sealed (~/.cache when
//   XDG_CACHE_HOME is unset or relative). The labels beside it stay open.
namespace agentpolicy\sealed;

import "std";
import "env";
import "path";
import "magus";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/verdict" as verdict;

final sealedDenial = "the sealed proofread set stays sealed until its round is scored; the labels and the tuning cases are open.\n"
    + "Reading a sealed case or label spends the set, and a score read before the round is frozen is a free oracle for the rule being tuned. "
    + "The round's scores come from the person who froze it; the sibling labels directory holds what a tuner may read.";

final nameChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-";

// calibrationDir is the directory below the cache home that holds the labels and the sealed
// sets; sealed is the part of it a tuner may not read.
final calibrationDir = "proofread-calibration";

// Roots are the two environment facts that place the sealed directory: HOME, and
// XDG_CACHE_HOME as the shell has it, which may be empty or relative.
export object Roots {
    home: str,
    xdg: str,
}

export fun rootsFromEnv() > Roots {
    var home = env\getOr("HOME", def: "") catch "";
    if (home == "") {
        home = env\home() catch "";
    }
    return Roots{ home = home, xdg = env\getOr("XDG_CACHE_HOME", def: "") catch "" };
}

// cacheHome follows the XDG rule: an absolute XDG_CACHE_HOME, else ~/.cache.
export fun cacheHome(roots: Roots) > str {
    if (roots.xdg != "" and path\isAbs(roots.xdg)) {
        return path\clean(roots.xdg);
    }
    return path\clean(roots.home + "/.cache");
}

export fun sealedDir(roots: Roots) > str {
    return cacheHome(roots) + "/" + calibrationDir + "/sealed";
}

// decideSealed denies a line that names the sealed directory, however it spells it, unless
// every program on it only carries text (echo, printf, a commit message) and nothing on the
// line substitutes or redirects.
export fun decideSealed(programs: [helpers\Program], line: str, roots: Roots) > GuardVerdict {
    if (!namesSealed(programs, line: line, roots: roots)) {
        return magus\guard.allow();
    }
    if (carriesTextOnly(programs) and !readsIndirectly(line)) {
        return magus\guard.allow();
    }
    return magus\guard.deny(sealedDenial);
}

fun namesSealed(programs: [helpers\Program], line: str, roots: Roots) > bool {
    final cache = cacheHome(roots);
    final parent = cache + "/" + calibrationDir;
    final sealed = parent + "/sealed";
    final tokens = tokenize(expand(line, roots: roots));
    var inCalibration = false;
    var sealedWord = false;
    foreach (t in tokens) {
        if (namesPath(t, needle: sealed) or namesPath(t, needle: calibrationDir + "/sealed")) {
            return true;
        }
        if (globsSealed(t, parent: parent)) {
            return true;
        }
        if (t.indexOf(calibrationDir) != null) {
            inCalibration = true;
        }
        if (t.split("/").indexOf("sealed") != null) {
            sealedWord = true;
        }
    }
    if (inCalibration and sealedWord) {
        return true;
    }
    if (!searchesRecursively(programs)) {
        return false;
    }
    foreach (t in tokens) {
        if (t == parent or t == cache) {
            return true;
        }
    }
    return false;
}

// expand writes out the spellings of the home and cache directories a shell would
// resolve, so the line reads as the paths it means. An unset XDG_CACHE_HOME expands to the
// default rather than to nothing: the stricter reading.
fun expand(line: str, roots: Roots) > str {
    final cache = cacheHome(roots);
    return line
        .replace("$\{XDG_CACHE_HOME\}", with: cache)
        .replace("$XDG_CACHE_HOME", with: cache)
        .replace("$\{HOME\}", with: roots.home)
        .replace("$HOME", with: roots.home)
        .replace("~/", with: roots.home + "/");
}

// tokenize splits a line into words and cleans each path-like one, so a doubled slash,
// a ./ or a .. does not hide the directory. Quotes and shell punctuation separate words,
// which also reads a path inside `sh -c '...'` or `python -c "..."`.
fun tokenize(line: str) > [str] {
    var text = line;
    foreach (c in ["\"", "'", "`", ";", "|", "&", "(", ")", "<", ">", "=", "\t", "\n", "\{", "\}", ","]) {
        text = text.replace(c, with: " ");
    }
    final tokens = mut [<str>];
    foreach (t in text.split(" ")) {
        if (t == "") {
            continue;
        }
        if (t.indexOf("/") != null) {
            tokens.append(path\clean(t));
        } else {
            tokens.append(t);
        }
    }
    return tokens;
}

// namesPath reports whether text holds needle as a whole path: the next character does not
// continue a file name, so sealed-old is not sealed.
fun namesPath(text: str, needle: str) > bool {
    var start = 0;
    while (start < text.len()) {
        final at = text.indexOf(needle, from: start);
        if (at == null) {
            return false;
        }
        final end = at! + needle.len();
        if (end >= text.len() or nameChars.indexOf(text.sub(end, len: 1)) == null) {
            return true;
        }
        start = at! + 1;
    }
    return false;
}

// globsSealed reports whether a pattern word under the calibration directory has a
// component that matches "sealed", as in proofread-calibration/sea*/x.
fun globsSealed(token: str, parent: str) > bool {
    if (!token.startsWith(parent + "/")) {
        return false;
    }
    final component = token.sub(parent.len() + 1).split("/")[0];
    if (component.indexOf("*") == null and component.indexOf("?") == null and component.indexOf("[") == null) {
        return false;
    }
    return path\matches(component, path: "sealed") catch false;
}

final searchers = ["rg", "ag", "ack", "fd", "find", "tree", "cp", "rsync", "tar", "ditto", "zip"];

// searchesRecursively reports whether a program on the line walks the directories it is
// handed, so naming the cache home or the calibration directory reaches the sealed sets.
fun searchesRecursively(programs: [helpers\Program]) > bool {
    foreach (p in programs) {
        if (searchers.indexOf(p.name) != null) {
            return true;
        }
        if (p.name == "grep" and hasFlag(p.args, short: ["r", "R"])) {
            return true;
        }
        if (p.name == "ls" and hasFlag(p.args, short: ["R"])) {
            return true;
        }
    }
    return false;
}

// hasFlag reports whether args carry --recursive, `-d recurse`, or a short-flag cluster
// holding one of the letters.
fun hasFlag(args: [str], short: [str]) > bool {
    foreach (arg in args) {
        if (arg == "--recursive" or arg == "recurse") {
            return true;
        }
        if (arg.startsWith("-") and !arg.startsWith("--")) {
            foreach (letter in short) {
                if (arg.indexOf(letter) != null) {
                    return true;
                }
            }
        }
    }
    return false;
}

// carriesTextOnly: every program only moves text it was handed, so naming the directory
// in a message or an echo reads nothing.
fun carriesTextOnly(programs: [helpers\Program]) > bool {
    if (programs.len() == 0) {
        return false;
    }
    foreach (p in programs) {
        if (p.name == "echo" or p.name == "printf") {
            continue;
        }
        if (p.vcs != null and ["commit", "tag", "describe"].indexOf(p.vcs!.subcommand) != null) {
            continue;
        }
        return false;
    }
    return true;
}

// readsIndirectly: the line substitutes a command or redirects a file, either of which
// reads a path the text-only programs never see as an argument.
fun readsIndirectly(line: str) > bool {
    return line.indexOf("$(") != null or line.indexOf("`") != null or line.indexOf("<") != null;
}

fun judged(line: str, argvs: [[str]], roots: Roots) > GuardVerdict {
    return verdict\checked(decideSealed(helpers\request(argvs), line: line, roots: roots), label: line);
}

final ada = Roots{ home = "/Users/ada", xdg = "" };
final adaXdg = Roots{ home = "/Users/ada", xdg = "/var/cache/ada" };

test "the sealed directory is the XDG cache home's, and an unset or relative one means ~/.cache" {
    std\assert(sealedDir(ada) == "/Users/ada/.cache/proofread-calibration/sealed", message: "unset");
    std\assert(sealedDir(Roots{ home = "/Users/ada", xdg = "cache" }) == "/Users/ada/.cache/proofread-calibration/sealed", message: "relative");
    std\assert(sealedDir(adaXdg) == "/var/cache/ada/proofread-calibration/sealed", message: "absolute");
    std\assert(sealedDir(Roots{ home = "/Users/ada", xdg = "/var/cache/ada/" }) == "/var/cache/ada/proofread-calibration/sealed", message: "trailing slash");
}

test "every spelling of the sealed directory is denied, naming the sealing and the open labels" {
    foreach (line in [
        "cat /Users/ada/.cache/proofread-calibration/sealed/round5/cases.txtar",
        "cat ~/.cache/proofread-calibration/sealed/round5/cases.txtar",
        "cat $HOME/.cache/proofread-calibration/sealed/round5/cases.txtar",
        "cat $\{HOME\}/.cache/proofread-calibration/sealed/round5/cases.txtar",
        "cat $XDG_CACHE_HOME/proofread-calibration/sealed/round5/cases.txtar",
        "cat $\{XDG_CACHE_HOME\}/proofread-calibration/sealed/round5/cases.txtar",
        "cat \"$XDG_CACHE_HOME/proofread-calibration/sealed/round5/cases.txtar\"",
        "cat /Users/ada/.cache//proofread-calibration/./sealed/round5/cases.txtar",
        "cat /Users/ada/.cache/proofread-calibration/labels/../sealed/round5/cases.txtar",
        "cat ~/.cache/proofread-calibration/sealed/",
    ]) {
        final v = judged(line, argvs: [["cat", "x"]], roots: ada);
        std\assert(v.decision == "deny", message: line);
        std\assert(v.reason.indexOf("sealed until its round is scored") != null, message: "says why: " + v.reason);
        std\assert(v.reason.indexOf("labels") != null, message: "names the open directory");
    }
}

test "an absolute XDG_CACHE_HOME moves the directory, and the default spelling stays denied" {
    std\assert(judged("cat /var/cache/ada/proofread-calibration/sealed/a", argvs: [["cat", "x"]], roots: adaXdg).decision == "deny", message: "the XDG path");
    std\assert(judged("cat $XDG_CACHE_HOME/proofread-calibration/sealed/a", argvs: [["cat", "x"]], roots: adaXdg).decision == "deny", message: "the variable");
    std\assert(judged("cat ~/.cache/proofread-calibration/sealed/a", argvs: [["cat", "x"]], roots: adaXdg).decision == "deny", message: "the literal tail");
}

test "a read, list, copy and search of the sealed directory are all denied" {
    foreach (argv in [
        ["ls", "-la", "~/.cache/proofread-calibration/sealed"],
        ["head", "-n", "5", "~/.cache/proofread-calibration/sealed/round5/cases.txtar"],
        ["cp", "-r", "~/.cache/proofread-calibration/sealed", "/tmp/x"],
        ["rg", "never", "~/.cache/proofread-calibration/sealed"],
        ["grep", "-rn", "never", "~/.cache/proofread-calibration/sealed"],
        ["find", "~/.cache/proofread-calibration/sealed", "-name", "*.txtar"],
        ["sed", "-n", "1,20p", "~/.cache/proofread-calibration/sealed/a"],
        ["tar", "cf", "/tmp/s.tar", "~/.cache/proofread-calibration/sealed"],
    ]) {
        final v = judged(argv.join(" "), argvs: [argv], roots: ada);
        std\assert(v.decision == "deny", message: argv.join(" "));
    }
}

test "a command that reaches the directory through an interpreter, a redirect or a cd is denied" {
    foreach (line in [
        "bash -c 'cat ~/.cache/proofread-calibration/sealed/a'",
        "python3 -c \"print(open('/Users/ada/.cache/proofread-calibration/sealed/a').read())\"",
        "cat < ~/.cache/proofread-calibration/sealed/a",
        "cd ~/.cache/proofread-calibration && cat sealed/a",
        "cd ~/.cache/proofread-calibration/sealed && ls",
        "cat ~/.cache/proofread-calibration/\{labels,sealed\}/round5/a",
        "git commit -m \"$(cat ~/.cache/proofread-calibration/sealed/a)\"",
    ]) {
        final v = judged(line, argvs: [["sh"]], roots: ada);
        std\assert(v.decision == "deny", message: line);
    }
}

test "a pattern that matches the sealed name is denied" {
    foreach (line in [
        "cat ~/.cache/proofread-calibration/sea*/round5/a",
        "cat ~/.cache/proofread-calibration/*/round5/a",
        "cat ~/.cache/proofread-calibration/s?aled/a",
        "cat ~/.cache/proofread-calibration/[s]ealed/a",
    ]) {
        std\assert(judged(line, argvs: [["cat", "x"]], roots: ada).decision == "deny", message: line);
    }
    std\assert(judged("cat ~/.cache/proofread-calibration/lab*/round4/scores.json", argvs: [["cat", "x"]], roots: ada).decision == "allow", message: "a pattern that cannot match sealed");
}

test "a recursive search from the calibration directory or the cache home is denied; a plain listing is not" {
    foreach (argv in [
        ["rg", "never", "~/.cache/proofread-calibration"],
        ["grep", "-r", "never", "~/.cache/proofread-calibration/"],
        ["find", "~/.cache", "-name", "*.txtar"],
        ["cp", "-r", "~/.cache/proofread-calibration", "/tmp/c"],
    ]) {
        std\assert(judged(argv.join(" "), argvs: [argv], roots: ada).decision == "deny", message: argv.join(" "));
    }
    foreach (argv in [
        ["ls", "~/.cache/proofread-calibration"],
        ["ls", "-l", "~/.cache"],
        ["grep", "never", "~/.cache/proofread-calibration/labels/round4/scores.json"],
    ]) {
        std\assert(judged(argv.join(" "), argvs: [argv], roots: ada).decision == "allow", message: argv.join(" "));
    }
}

test "the labels directory, a sibling that only starts with sealed and unrelated reads stay silent" {
    foreach (line in [
        "ls ~/.cache/proofread-calibration/labels",
        "cat $XDG_CACHE_HOME/proofread-calibration/labels/round4/scores.json",
        "rg never ~/.cache/proofread-calibration/labels",
        "cat ~/.cache/proofread-calibration/sealed-old/a",
        "cat ~/.cache/proofread-calibration/sealed.json",
        "cat /var/cache/ada/proofread-calibration/labels/a",
        "git switch -c sealed-holdout proofread",
        "cat libs/conventions/proofread/testdata/cases/claim.txtar",
        "ls ~/.cache/other/sealed",
    ]) {
        std\assert(judged(line, argvs: [["cat", "x"]], roots: ada).decision == "allow", message: line);
    }
}

test "a message or an echo that only names the directory is allowed; a substitution or another program is not" {
    final commit = helpers\vcsRequest([["git", "commit", "-m", "stop reading ~/.cache/proofread-calibration/sealed"]]);
    std\assert(decideSealed(commit, line: "git commit -m \"stop reading ~/.cache/proofread-calibration/sealed\"", roots: ada).decision == "allow", message: "commit message");
    std\assert(judged("echo ~/.cache/proofread-calibration/sealed", argvs: [["echo", "x"]], roots: ada).decision == "allow", message: "echo");
    std\assert(judged("echo $(cat ~/.cache/proofread-calibration/sealed/a)", argvs: [["echo", "x"]], roots: ada).decision == "deny", message: "substitution");
    std\assert(judged("echo ~/.cache/proofread-calibration/sealed && cat ~/.cache/proofread-calibration/sealed/a", argvs: [["echo", "x"], ["cat", "x"]], roots: ada).decision == "deny", message: "echo then cat");
    std\assert(decideSealed([<helpers\Program>], line: "cat ~/.cache/proofread-calibration/sealed/a", roots: ada).decision == "deny", message: "a line that did not parse");
}
