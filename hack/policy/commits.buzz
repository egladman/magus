// The commit-subject rule: the message a commit records from the command line, in every
// version-control tool magus drives: `git commit -m`, `hg commit -m`, `sl commit -m`,
// `jj commit -m` and `jj describe -m`. A commit made on the base branch lands as written, so
// it answers to the conventional-commit rule the repository's commit-msg hook applies there;
// anywhere else the subject is one plain lowercase line.
namespace agentpolicy\commits;

import "std";
import "magus";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/verdict" as verdict;
import "./hack/magusfile/commits" as conventional;

// One subject cap everywhere: pr-title and the commit-msg hook read the same one.
final maxSubject = conventional\maxLength();

final plainFix = "Write one subject line, lowercase and imperative, in plain ASCII, with clauses joined "
    + "by `;` and at most {maxSubject} characters: no body, no area prefix, no trailing period and no "
    + "attribution. Detail belongs in the pull request description.";

final attribution = $"(?i)co-authored-by|generated with";
final nonASCII = $"[^ -~\n\t]";
// A capital followed by a lowercase letter: `Fix the port` is titlecased, `URL-parse the
// port` opens with an acronym and passes.
final titlecased = $"^[^A-Za-z]*[A-Z][a-z]";
final conventionalPrefix = $"^[a-z]+(\([^)\n]*\))?!?: ";
final pastOrThirdPerson = $"(?i)^(added|adds|adding|fixed|fixes|fixing|updated|updates|updating|removed|removes|removing|changed|changes|changing|implemented|implements|implementing|refactored|refactors|refactoring|improved|improves|improving|created|creates|creating|introduced|introduces|introducing|renamed|renames|renaming|moved|moves|moving|made|makes|making)\b";
export final puffery = $"(?i)\b(comprehensive|robust|seamless|seamlessly|powerful|elegant|elegantly|cutting-edge|state-of-the-art|world-class|effortless|effortlessly)\b";

// Syntax is how one tool's commit command spells its options: the long options and the
// single-letter ones that take a value, attached or as the next word, and whether a second
// -m adds a body paragraph (git, jj) or replaces the first (hg, sl).
object Syntax {
    valueLongs: [str],
    valueShorts: [str],
    paragraphs: bool,
}

final gitSyntax = Syntax{
    valueLongs = ["--file", "--author", "--date", "--cleanup", "--reuse-message", "--reedit-message",
        "--fixup", "--squash", "--trailer", "--template", "--pathspec-from-file"],
    valueShorts = ["F", "C", "c", "t"],
    paragraphs = true,
};

final hgSyntax = Syntax{
    valueLongs = ["--logfile", "--date", "--user", "--include", "--exclude", "--reuse-message"],
    valueShorts = ["l", "d", "u", "I", "X", "M"],
    paragraphs = false,
};

final jjSyntax = Syntax{
    valueLongs = ["--tool", "--author", "--revision"],
    valueShorts = ["r"],
    paragraphs = true,
};

// commitSyntax is the option syntax of p's commit command, or null when p records no commit
// message: another subcommand, a request for help, or a program that is no version control.
// hg and sl also spell commit `ci`; jj spells describe `desc`.
fun commitSyntax(p: helpers\Program) > Syntax? {
    if (p.vcs == null) {
        return null;
    }
    final call = p.vcs!;
    if (call.args.indexOf("--help") != null or call.args.indexOf("-h") != null) {
        return null;
    }
    final sub = call.subcommand;
    if (call.tool == "git" and sub == "commit") {
        return gitSyntax;
    }
    if ((call.tool == "hg" or call.tool == "sl") and (sub == "commit" or sub == "ci")) {
        return hgSyntax;
    }
    if (call.tool == "jj" and (sub == "commit" or sub == "describe" or sub == "desc")) {
        return jjSyntax;
    }
    return null;
}

// Message is one -m value: its text, and the index of the argument holding it, which is
// null when the value is attached to its flag (`-mtext`, `--message=text`).
object Message {
    text: str,
    slot: int?,
}

fun parseMessages(args: [str], syntax: Syntax) > [Message] {
    final found = mut [<Message>];
    var i = 0;
    while (i < args.len()) {
        final arg = args[i];
        if (arg == "--") {
            break;
        }
        if (arg == "--message") {
            if (i + 1 < args.len()) {
                found.append(Message{ text = args[i + 1], slot = i + 1 });
            }
            i = i + 2;
        } else if (arg.startsWith("--message=")) {
            found.append(Message{ text = arg.sub(10), slot = null });
            i = i + 1;
        } else if (arg.startsWith("--")) {
            if (arg.indexOf("=") == null and syntax.valueLongs.indexOf(arg) != null) {
                i = i + 1;
            }
            i = i + 1;
        } else if (arg.startsWith("-") and arg.len() > 1) {
            var k = 1;
            var consumed = false;
            while (k < arg.len()) {
                final flag = arg.sub(k, len: 1);
                final rest = arg.sub(k + 1);
                if (flag == "m") {
                    if (rest != "") {
                        found.append(Message{ text = rest, slot = null });
                    } else if (i + 1 < args.len()) {
                        found.append(Message{ text = args[i + 1], slot = i + 1 });
                        consumed = true;
                    }
                    break;
                }
                if (syntax.valueShorts.indexOf(flag) != null) {
                    consumed = rest == "";
                    break;
                }
                k = k + 1;
            }
            if (consumed) {
                i = i + 1;
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return found;
}

// messageSlots are the indices into p's vcs.args holding a commit message the parser
// rendered empty, a substitution such as `-m "$(cat <<'EOF' ...)"`.
export fun messageSlots(p: helpers\Program) > [int] {
    final slots = mut [<int>];
    final syntax = commitSyntax(p);
    if (syntax == null) {
        return slots;
    }
    foreach (m in parseMessages(p.vcs!.args, syntax: syntax!)) {
        if (m.text == "" and m.slot != null) {
            slots.append(m.slot!);
        }
    }
    return slots;
}

// wordingProblems judges the words of one subject: it opens in the imperative and sells
// nothing. A conventional subject is judged after its `<type>(<scope>)!: ` prefix, which is
// not part of the description. Pull request titles read the same rule.
export fun wordingProblems(subject: str, conventional: bool) > [str] {
    final problems = mut [<str>];
    var text = subject.trim();
    if (conventional) {
        final prefix = conventionalPrefix.match(text);
        if (prefix != null) {
            text = text.sub(prefix![0].len());
        }
    }
    final verb = pastOrThirdPerson.match(text);
    if (verb != null) {
        problems.append("\"{verb![0]}\": write the subject in the imperative: 'add', not 'added' or 'adds'");
    }
    final selling = puffery.match(text);
    if (selling != null) {
        problems.append("\"{selling![0]}\": drop it and say what changed");
    }
    return problems;
}

// subjectProblems names what is wrong with one commit's message, read from its arguments
// after the subcommand. baseBranch is the branch the commit lands on as written, "" when it
// is made anywhere else. A message that still renders empty is a value only known at run
// time, so its subject goes unjudged.
fun subjectProblems(call: helpers\VcsCall, syntax: Syntax, baseBranch: str) > [str] {
    final problems = mut [<str>];
    if (attribution.match(call.args.join("\n")) != null) {
        problems.append("an attribution (Co-Authored-By, Generated with): credit nobody in a commit");
    }
    final messages = parseMessages(call.args, syntax: syntax);
    if (messages.len() > 1 and syntax.paragraphs) {
        problems.append("more than one -m: {call.tool} makes each after the first a body paragraph");
    } else if (messages.len() > 1) {
        problems.append("more than one -m: {call.tool} keeps only the last and drops the rest");
    }
    if (messages.len() == 0) {
        return problems;
    }
    var message = messages[0].text;
    if (!syntax.paragraphs) {
        message = messages[messages.len() - 1].text;
    }
    if (message == "") {
        return problems;
    }
    if (message.indexOf("\n") != null) {
        problems.append("a line break: the message has a body");
    }
    final subject = message.trim().split("\n")[0].trim();
    if (subject == "") {
        problems.append("an empty subject");
        return problems;
    }
    if (nonASCII.match(subject) != null) {
        problems.append("a character outside plain ASCII (an em dash, a curly quote, an emoji)");
    }
    if (baseBranch != "") {
        final problem = conventional\baseProblem(subject);
        if (problem != "") {
            problems.append("\"{subject}\": {problem}");
        }
        foreach (problem in wordingProblems(subject, conventional: true)) {
            problems.append(problem);
        }
        return problems;
    }
    foreach (problem in wordingProblems(subject, conventional: false)) {
        problems.append(problem);
    }
    if (titlecased.match(subject) != null) {
        problems.append("a capitalized first word: write it lowercase; an acronym may lead");
    }
    if (subject.endsWith(".")) {
        problems.append("a trailing period");
    }
    if (subject.indexOf(",") != null) {
        problems.append("a comma: join clauses with `;`");
    }
    if (subject.indexOf(":") != null) {
        problems.append("a colon: no area prefix, and clauses join with `;`");
    }
    if (subject.indexOf("(") != null or subject.indexOf(")") != null) {
        problems.append("a parenthesis: join clauses with `;`");
    }
    if (subject.indexOf("!") != null) {
        problems.append("an exclamation mark");
    }
    if (subject.indexOf("?") != null) {
        problems.append("a question mark");
    }
    if (subject.indexOf(" - ") != null) {
        problems.append("a spaced hyphen used as a dash: join clauses with `;`");
    }
    if (subject.len() > maxSubject) {
        problems.append("{subject.len()} characters, past {maxSubject}: cut it, or split the commit along a code boundary");
    }
    return problems;
}

fun baseFix(baseBranch: str) > str {
    return "A commit made on {baseBranch} lands as written, so its subject is a conventional commit, "
        + "as pull request titles are: `<type>(<scope>): <description>`, e.g. `fix(cache): keep the key "
        + "stable across runs`, with a type from " + conventional\types().join(", ") + ", a lowercase "
        + "scope, a lowercase description with no trailing period, at most "
        + "{conventional\maxLength()} bytes on one line, and no attribution. A commit on any other branch "
        + "keeps the plain lowercase subject instead.";
}

// decideCommit denies every commit on the line whose message breaks the subject rules.
// Each commit is judged on its own: two chained commits are two subjects, not a subject and
// a body. baseBranch is the branch the checkout is on when that is the base branch, which
// takes the conventional form; "" for any other branch or an unknown checkout.
export fun decideCommit(programs: [helpers\Program], baseBranch: str) > GuardVerdict {
    final problems = mut [<str>];
    foreach (p in programs) {
        final syntax = commitSyntax(p);
        if (syntax != null) {
            foreach (problem in subjectProblems(p.vcs!, syntax: syntax!, baseBranch: baseBranch)) {
                if (problems.indexOf(problem) == null) {
                    problems.append(problem);
                }
            }
        }
    }
    if (problems.len() == 0) {
        return magus\guard.allow();
    }
    var fix = plainFix;
    if (baseBranch != "") {
        fix = baseFix(baseBranch);
    }
    return magus\guard.deny(verdict\opening("this commit message breaks a subject rule", problem: problems[0])
        + "\n  - " + problems.join("\n  - ") + "\n" + fix);
}

// judged is decideCommit with every denial held to the verdict shape.
fun judged(programs: [helpers\Program], baseBranch: str) > GuardVerdict {
    final label = programs.map(fun (index: int, p: helpers\Program) > str => p.name + " " + p.args.join(" ")).join(" ; ");
    return verdict\checked(decideCommit(programs, baseBranch: baseBranch), label: label);
}

fun ask(call: [str]) > GuardVerdict {
    return judged(helpers\vcsRequest([call]), baseBranch: "");
}

fun askReason(call: [str]) > str {
    return ask(call).reason;
}

test "a plain lowercase imperative subject passes in every tool" {
    foreach (call in [
        ["git", "commit", "-m", "trim a fragment; keep the key stable"],
        ["git", "commit", "-m", "URL-parse the port"],
        ["git", "commit", "-am", "drop the v1 key"],
        ["git", "commit", "-q", "--message=bump go to 1.25"],
        ["git", "commit", "-mtrim a fragment"],
        ["git", "commit", "--amend", "--no-edit"],
        ["git", "commit", "-F", "msg.txt"],
        ["hg", "commit", "-m", "trim a fragment"],
        ["hg", "ci", "-A", "-u", "Some One", "-m", "trim a fragment"],
        ["sl", "commit", "--message", "trim a fragment"],
        ["jj", "commit", "-m", "trim a fragment"],
        ["jj", "describe", "-r", "@-", "-m", "trim a fragment"],
        ["jj", "desc", "--message=trim a fragment"],
    ]) {
        final v = ask(call);
        std\assert(v.decision == "allow", message: "{call.join(" ")}: {v.reason}");
    }
}

test "a broken subject is denied in every tool" {
    foreach (call in [
        ["git", "commit", "-m", "Fix the port."],
        ["hg", "commit", "-m", "Fix the port."],
        ["hg", "ci", "-mFix the port."],
        ["sl", "commit", "-m", "Fix the port."],
        ["jj", "commit", "-m", "Fix the port."],
        ["jj", "describe", "-m", "Fix the port."],
    ]) {
        final reason = askReason(call);
        std\assert(reason.indexOf("capitalized first word") != null and reason.indexOf("trailing period") != null, message: "{call.join(" ")}: {reason}");
        std\assert(reason.indexOf("Write one subject line, lowercase and imperative") != null, message: "states the fix");
    }
}

test "each subject rule is named when broken" {
    final cases = {
        "Fix the port": "capitalized first word",
        "trim a fragment.": "trailing period",
        "trim a fragment, keep the key": "a comma",
        "fix(cache): keep the key": "a colon",
        "keep the key (stable)": "a parenthesis",
        "keep the key!": "exclamation mark",
        "keep the key?": "question mark",
        "keep the key - stable": "spaced hyphen",
        "keep the café key": "plain ASCII",
        "keep the key\n\nbody text": "line break",
        "   ": "an empty subject",
    };
    foreach (subject, want in cases) {
        final v = ask(["git", "commit", "-m", subject]);
        std\assert(v.decision == "deny", message: subject);
        std\assert(v.reason.indexOf(want) != null, message: "{subject}: {v.reason}");
    }
    std\assert(askReason(["git", "commit", "-m", "x".repeat(101)]).indexOf("101 characters, past 100") != null, message: "too long");
    std\assert(ask(["git", "commit", "-m", "x".repeat(100)]).decision == "allow", message: "100 is the cap");
}

test "a subject opens in the imperative" {
    foreach (subject in ["added a vale spell", "adds a vale spell", "fixing the key", "Made the key stable", "renames the flag", "introduced a cache"]) {
        final v = ask(["git", "commit", "-m", subject]);
        std\assert(v.decision == "deny", message: subject);
        std\assert(v.reason.indexOf("not 'added' or 'adds'") != null, message: "{subject}: {v.reason}");
    }
    foreach (subject in ["add a vale spell", "keep the key stable", "fix the port", "move the rule", "address the review", "fixture the key"]) {
        std\assert(ask(["git", "commit", "-m", subject]).decision == "allow", message: subject);
    }
    std\assert(wordingProblems("added a vale spell", conventional: false).len() == 1, message: "past tense");
    std\assert(wordingProblems("feat(prose): adds a vale spell", conventional: true).len() == 1, message: "third person after a prefix");
    std\assert(wordingProblems("feat(prose)!: adds a vale spell", conventional: true).len() == 1, message: "a breaking prefix");
    std\assert(wordingProblems("fix: updated the key", conventional: true).len() == 1, message: "a prefix without a scope");
    std\assert(wordingProblems("fix(cache): keep the key stable", conventional: true).len() == 0, message: "imperative");
    std\assert(wordingProblems("added a vale spell", conventional: true).len() == 1, message: "no prefix to strip");
    std\assert(wordingProblems("keep the key; moved the rule", conventional: false).len() == 0, message: "only the first word counts");
}

test "a subject sells nothing" {
    foreach (subject in ["add a robust vale spell", "Add a ROBUST vale spell", "add seamless retries", "add a cutting-edge cache", "add state-of-the-art hashing", "add a powerful flag", "elegantly keep the key", "add comprehensive tests"]) {
        final v = ask(["git", "commit", "-m", subject]);
        std\assert(v.decision == "deny", message: subject);
        std\assert(v.reason.indexOf("drop it and say what changed") != null, message: "{subject}: {v.reason}");
    }
    foreach (subject in ["add a vale spell", "add robustness checks", "add a seamlessness test"]) {
        std\assert(ask(["git", "commit", "-m", subject]).decision == "allow", message: "a whole word only: {subject}");
    }
    final problems = wordingProblems("feat(cache): add a robust key", conventional: true);
    std\assert(problems.len() == 1 and problems[0].indexOf("\"robust\"") != null, message: "names the word");
    std\assert(wordingProblems("feat(cache)!: added a robust key", conventional: true).len() == 2, message: "both rules");
}

test "a commit on the base branch has its wording judged after the prefix" {
    final onBase = fun (subject: str) > GuardVerdict {
        return judged(helpers\vcsRequest([["git", "commit", "-m", subject]]), baseBranch: "main");
    };
    std\assert(onBase("feat(prose): adds a vale spell").reason.indexOf("not 'added' or 'adds'") != null, message: "third person");
    std\assert(onBase("fix(cache): add a robust key").reason.indexOf("drop it and say what changed") != null, message: "puffery");
    std\assert(onBase("fix(cache): keep the key stable").decision == "allow", message: "imperative");
}

test "a body, a second -m and an attribution are denied" {
    std\assert(askReason(["git", "commit", "-m", "trim a fragment", "-m", "why it matters"]).indexOf("git makes each after the first a body paragraph") != null, message: "two -m in git");
    std\assert(askReason(["jj", "describe", "-m", "trim a fragment", "-m", "why"]).indexOf("jj makes each after the first a body paragraph") != null, message: "two -m in jj");
    std\assert(askReason(["hg", "commit", "-m", "trim a fragment", "-m", "why"]).indexOf("hg keeps only the last") != null, message: "two -m in hg");
    std\assert(askReason(["hg", "commit", "-m", "trim a fragment", "-m", "Why."]).indexOf("trailing period") != null, message: "hg records the last");
    std\assert(askReason(["git", "commit", "-m", "trim a fragment", "--trailer", "Co-Authored-By: a <b@c>"]).indexOf("an attribution") != null, message: "a trailer");
    std\assert(askReason(["jj", "commit", "-m", "trim a fragment\n\nGenerated with a tool"]).indexOf("an attribution") != null, message: "in the message");
}

test "a commit on the base branch takes the conventional subject the commit-msg hook requires" {
    final onBase = fun (call: [str]) > GuardVerdict {
        return judged(helpers\vcsRequest([call]), baseBranch: "main");
    };
    foreach (call in [
        ["git", "commit", "-m", "fix(cache): keep the key stable across runs"],
        ["hg", "commit", "-m", "feat: add a commit-msg hook"],
        ["jj", "describe", "-m", "docs: README framing; one line per audience"],
    ]) {
        final v = onBase(call);
        std\assert(v.decision == "allow", message: "{call.join(" ")}: {v.reason}");
    }
    final plain = onBase(["git", "commit", "-m", "trim a fragment"]);
    std\assert(plain.decision == "deny", message: "a plain subject on the base branch");
    std\assert(plain.reason.indexOf("\"trim a fragment\": " + conventional\problem("trim a fragment")) != null, message: plain.reason);
    std\assert(plain.reason.indexOf("A commit made on main lands as written") != null, message: "states the rule");
    std\assert(plain.reason.indexOf("`<type>(<scope>): <description>`") != null, message: "states the fix");
    std\assert(onBase(["git", "commit", "-m", "feat: Add a hook"]).reason.indexOf("sentence case") != null, message: "the hook's own message");
    std\assert(onBase(["git", "commit", "-m", "feat: add a hook", "--trailer", "Co-Authored-By: a <b@c>"]).reason.indexOf("an attribution") != null, message: "still credits nobody");
    std\assert(ask(["git", "commit", "-m", "fix(cache): keep the key"]).reason.indexOf("a colon") != null, message: "off the base branch a prefix is denied");
}

test "every problem is named, once, across chained commits" {
    final line = helpers\vcsRequest([
        ["git", "commit", "-m", "Fix the port."],
        ["jj", "commit", "-m", "Keep the key."],
    ]);
    final v = judged(line, baseBranch: "");
    std\assert(v.decision == "deny", message: "denied");
    std\assert(v.reason.split("- a trailing period").len() == 2, message: "named once");
    final second = helpers\vcsRequest([["git", "commit", "-m", "trim a fragment"], ["git", "commit", "-m", "Keep the key"]]);
    std\assert(judged(second, baseBranch: "").decision == "deny", message: "the second commit is judged on its own");
}

test "a line that only mentions a commit, and other version-control calls, stay silent" {
    final quiet = helpers\request([["rg", "git commit"], ["echo", "git", "commit", "-m", "Bad."]]);
    std\assert(judged(quiet, baseBranch: "").decision == "allow", message: "no version control ran");
    foreach (call in [
        ["git", "log", "-m", "Bad."],
        ["git", "help", "commit"],
        ["git", "commit", "--help"],
        ["git", "status"],
        ["hg", "log", "-m"],
        ["jj", "new", "-m", "Bad."],
        ["jj", "describe", "-h"],
    ]) {
        std\assert(ask(call).decision == "allow", message: call.join(" "));
    }
}

test "a message written through a heredoc substitution is judged from its body" {
    final line = "git commit -m \"$(cat <<'EOF'\nFix the port.\n\nCo-Authored-By: a <b@c>\nEOF\n)\"";
    final programs = helpers\vcsRequest([["git", "commit", "-m", ""]]) + helpers\request([["cat"]]);
    final slots = mut [<[int]>];
    foreach (p in programs) {
        slots.append(messageSlots(p));
    }
    std\assert(slots[0].len() == 1 and slots[0][0] == 1, message: "the -m value is the slot");
    final filled = helpers\fillSlots(programs, slots: slots, texts: helpers\substitutedHeredocs(line));
    final v = judged(filled, baseBranch: "");
    std\assert(v.decision == "deny", message: "denied");
    foreach (want in ["an attribution", "line break", "capitalized first word", "trailing period"]) {
        std\assert(v.reason.indexOf(want) != null, message: want);
    }
    final plain = helpers\fillSlots(programs, slots: slots, texts: helpers\substitutedHeredocs("git commit -m \"$(cat <<'EOF'\ntrim a fragment\nEOF\n)\""));
    std\assert(judged(plain, baseBranch: "").decision == "allow", message: "a one-line heredoc subject passes");
    std\assert(judged(programs, baseBranch: "").decision == "allow", message: "a value known only at run time goes unjudged");
}

test "no message sends the reader to a skill" {
    foreach (reason in [
        askReason(["git", "commit", "-m", "Fix the port."]),
        judged(helpers\vcsRequest([["git", "commit", "-m", "trim a fragment"]]), baseBranch: "main").reason,
    ]) {
        std\assert(reason != "" and reason.indexOf("Skill(") == null, message: reason);
    }
}

test "a problem that quotes a long subject keeps the verdict to one short line" {
    final long = "Fixed the `cache` key so it stays stable across every run of the build, however many shards it fans out to";
    foreach (baseBranch in ["", "main"]) {
        final v = judged(helpers\vcsRequest([["git", "commit", "-m", long]]), baseBranch: baseBranch);
        std\assert(v.decision == "deny", message: baseBranch);
        std\assert(v.reason.split("\n")[0].startsWith("this commit message breaks a subject rule"), message: v.reason);
    }
}
