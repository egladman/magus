// Mandates, this repository's reference policy (ADR 0019). A mandate is what the person
// issues with `hack/dev/issue-mandate.buzz issue` so a long session carries out the plan they
// approved while they are away: inside it the guard lets the root and its workers work the
// mandated rows and denies every act the person keeps. A mandate raises the bar; a grant
// lowers one rule. Copy it and edit it: the ceiling, the reserved paths and the loop limit
// below are opinions, not magus's.
//
// The mandate is one JSON Lines entry per issue or revoke, in the repository's git common
// directory under magus/mandate.jsonl, so every worktree reads one; the last line wins.
namespace agentpolicy\mandate;

import "std";
import "fs";
import "os";
import "encoding/json";
import "magus";
import "vcs";
import "./hack/magusfile/branch-stack" as branchstack;
import "./hack/policy/helpers" as helpers;
import "./hack/policy/verdict" as verdict;

// ceiling is the highest tolerance `issue` accepts: the most an unsettled job's proven tier
// may be for its work to be integrated with no one present.
export final ceiling = "mechanical";

// tiers are the risk tiers, lowest first, as internal/risk proves them.
export final tiers = ["trivial", "mechanical", "scoped", "full"];

// loopLimit is how many stops running a refusal naming the same rows holds before it lets the
// turn end and files an attention entry.
export final loopLimit = 3;

// reservedPaths are the workspace paths the root and its workers do not write under a
// mandate: decisions, design pages, and hook and permission config.
final reservedPaths = ["docs/decisions/", "docs/design/", ".claude/", ".codex/", "hack/policy/", "spells/harness/", "magus.yaml"];

// Mandate is one line of the mandate file: an issue, or a revoke.
export object Mandate {
    action: str,
    // at is when the line was written, in Unix milliseconds.
    at: int,
    // endClock is the end time as the person typed it, HH:MM local.
    endClock: str = "",
    // ends is endClock resolved to Unix milliseconds when the mandate was issued.
    ends: int = 0,
    tolerance: str = "",
    rows: [str] = [],
    // budget is the most scoped or full lines a settled job may change and
    // still be integrated with no one present.
    budget: int = branchstack\reviewBudget,
}

// Row is what the rules read of one job store row.
// It is copied out of magus\workspace().jobs() so a test can build one.
export object Row {
    id: str,
    state: magus\JobState,
    parent: str = "",
    paused: bool = false,
    dependsOn: [str] = [],
    created: int = 0,
    checkpoint: str = "",
    checkoutRoot: str = "",
    unresolvedRisks: [str] = [],
    // holderStopped is when the holder ended its turn, 0 when it did not.
    holderStopped: int = 0,
}

// Assessed is a job's proven risk tier and the evidence behind it.
export object Assessed {
    tier: str,
    evidence: [str] = [],
    // lines is how many lines the job changed in its scoped or full paths,
    // -1 when they could not be counted.
    lines: int = -1,
}

// assess is id's proven tier: measure's report on the change in the job's own checkout since
// the checkpoint it was handed. A row measure cannot reach, or a measure that raises, is full,
// and its evidence says which, so an unmeasured job never reads as a measured tier.
export fun assess(id: str, jobs: [Row], measure: fun (row: Row) > TierReport !> any, count: fun (row: Row) > {str: int} !> any) > Assessed {
    final row = byId(jobs, id: id);
    if (row == null) {
        return Assessed{ tier = "full", evidence = ["{id}: full (no job row by that id, so nothing was measured)"] };
    }
    if (row!.checkoutRoot == "" or row!.checkpoint == "") {
        return Assessed{ tier = "full", evidence = ["{id}: full (the row records no checkout or checkpoint to measure its change from)"] };
    }
    var report = TierReport{};
    try {
        report = measure(row!);
    } catch (e: any) {
        return Assessed{ tier = "full", evidence = ["{id}: full (magus\\change().tier raised: {e})"] };
    }
    var changed = {<str: int>};
    try {
        changed = count(row!);
    } catch (e: any) {
        changed = {<str: int>};
        final lines = mut [<str>];
        foreach (ev in report.evidence) {
            lines.append(evidenceLine(ev));
        }
        lines.append("{id}: lines not counted ({e})");
        return Assessed{ tier = report.tier.value, evidence = lines };
    }
    final lines = mut [<str>];
    var reviewable = 0;
    foreach (e in report.evidence) {
        final n = changed[e.path] ?? 0;
        if (e.path != "" and (e.tier == magus\Tier.scoped or e.tier == magus\Tier.full)) {
            reviewable = reviewable + n;
            lines.append("{evidenceLine(e)}, {n} lines");
        } else {
            lines.append(evidenceLine(e));
        }
    }
    return Assessed{ tier = report.tier.value, evidence = lines, lines = reviewable };
}

// counted is assess's count outside a test: each path's changed lines in the
// job's checkout since its checkpoint, added plus deleted.
export fun counted(row: Row) > {str: int} !> any {
    final lines = mut {<str: int>};
    foreach (s in vcs\diffStat(row.checkpoint, dir: row.checkoutRoot)) {
        lines[s.path] = s.added + s.deleted;
    }
    return lines;
}

// measured is assess's measure outside a test: the ci gate's tier for the job's change.
export fun measured(row: Row) > TierReport !> any {
    return magus\change(row.checkpoint).tier("ci", opts: TierOptions{ checkout = row.checkoutRoot });
}

// evidenceLine renders e as `magus affected ci` prints it: `<path>: <tier> (<class>: <why>)`.
fun evidenceLine(e: TierEvidence) > str {
    var subject = e.path;
    if (subject == "") {
        subject = "{e.project} {e.target}".trim();
    }
    var why = e.why;
    if (e.class != "") {
        why = "{e.class}: {why}";
    }
    if (subject == "") {
        return "{e.tier.value} ({why})";
    }
    return "{subject}: {e.tier.value} ({why})";
}

// rows copies a job store's rows, each with the risks its live try's
// result names.
export fun rows(list: JobList) > [Row] {
    final found = mut [<Row>];
    foreach (j in list.jobs) {
        var risks = [<str>];
        var live = 0;
        foreach (a in list.attempts) {
            if (a.job == j.id and a.n > live and a.status.state == magus\JobState.none) {
                live = a.n;
                risks = [<str>];
                if (a.status.result != null) {
                    risks = a.status.result!.unresolvedRisks;
                }
            }
        }
        found.append(Row{ id = j.id, state = j.state, parent = j.parent, paused = j.paused != 0, dependsOn = j.dependsOn,
            created = j.created, checkpoint = j.checkpoint, checkoutRoot = j.checkoutRoot, unresolvedRisks = risks, holderStopped = j.holderStopped });
    }
    return found;
}

// commonDir is the git common directory of the repository holding workspace, read from the
// checkout's .git without running git, since a guard rule runs on every call; null when the
// workspace is not a git checkout.
export fun commonDir(workspace: str) > str? {
    final dotgit = workspace + "/.git";
    if (fs\isDir(dotgit) catch false) {
        return dotgit;
    }
    final text = fs\readFile(dotgit) catch "";
    if (!text.startsWith("gitdir: ")) {
        return null;
    }
    var gitdir = text.sub(8).trim();
    if (!gitdir.startsWith("/")) {
        gitdir = workspace + "/" + gitdir;
    }
    final common = (fs\readFile(gitdir + "/commondir") catch "").trim();
    if (common == "") {
        return gitdir;
    }
    if (common.startsWith("/")) {
        return common;
    }
    return gitdir + "/" + common;
}

// mandateFile is where the mandate of the repository holding workspace lives, null outside a
// git checkout.
export fun mandateFile(workspace: str) > str? {
    if (commonDir(workspace) -> dir) {
        return dir + "/magus/mandate.jsonl";
    }
    return null;
}

// attentionFile is where the Stop rule files the rows a refusal loop gave up on.
export fun attentionFile(workspace: str) > str? {
    if (commonDir(workspace) -> dir) {
        return dir + "/magus/mandate-attention.jsonl";
    }
    return null;
}

// parseMandate reads one mandate line, null for one that is not a mandate.
export fun parseMandate(line: str) > Mandate? {
    if (line.trim() == "") {
        return null;
    }
    final doc: {str: any} = json\parse(line) catch {<str: any>};
    final action: str = doc["action"] ?? "";
    if (action != "issue" and action != "revoke") {
        return null;
    }
    final named: [any] = doc["rows"] ?? [<any>];
    final ids = mut [<str>];
    foreach (r in named) {
        final id: str = r;
        ids.append(id);
    }
    return Mandate{
        action = action,
        at = std\toInt(doc["at"] ?? 0),
        endClock = doc["until"] ?? "",
        ends = std\toInt(doc["ends"] ?? 0),
        tolerance = doc["tolerance"] ?? "",
        rows = ids,
        budget = std\toInt(doc["budget"] ?? branchstack\reviewBudget),
    };
}

// encodeMandate is m as one mandate line, without its newline.
export fun encodeMandate(m: Mandate) > str !> any {
    return json\stringify({"action": m.action, "at": m.at, "until": m.endClock, "ends": m.ends, "tolerance": m.tolerance, "rows": m.rows, "budget": m.budget});
}

// lastMandate is the last mandate line in text, null when it holds none.
export fun lastMandate(text: str) > Mandate? {
    var last: Mandate? = null;
    foreach (line in text.split("\n")) {
        if (parseMandate(line) -> m) {
            last = m;
        }
    }
    return last;
}

// loadMandate is the last mandate line of the repository holding workspace, null when none
// was ever issued there.
export fun loadMandate(workspace: str) > Mandate? {
    if (mandateFile(workspace) -> file) {
        return lastMandate(fs\readFile(file) catch "");
    }
    return null;
}

// now is the current time in Unix milliseconds.
export fun now() > int {
    return std\toInt(os\time());
}

// inForce reports whether m is a mandate issued and not yet past its end at now.
export fun inForce(m: Mandate?, now: int) > bool {
    if (m -> mandate) {
        return mandate.action == "issue" and now < mandate.ends;
    }
    return false;
}

// pastCap reports whether m is an issued mandate whose end time has passed with no revoke.
export fun pastCap(m: Mandate?, now: int) > bool {
    if (m -> mandate) {
        return mandate.action == "issue" and now >= mandate.ends;
    }
    return false;
}

// rank is tier's place in tiers, full for a tier magus does not prove.
export fun rank(tier: str) > int {
    return tiers.indexOf(tier) ?? tiers.len() - 1;
}

// decideBudget holds a settled job whose scoped or full lines pass the
// mandate's budget, naming the split a person may run. It never splits.
fun decideBudget(id: str, m: Mandate, row: Row, got: Assessed) > GuardVerdict {
    if (got.lines >= 0 and got.lines <= m.budget) {
        return magus\guard.allow();
    }
    final split = "magus buzz hack/dev/split-into-branches.buzz -- --by symbols --base {row.checkpoint} --budget {m.budget}";
    final counted = if (got.lines < 0) "its scoped and full lines could not be counted" else "{got.lines} lines in scoped or full paths, above the mandate's budget of {m.budget}";
    return deny("{id} is held for review: settled, with {counted}; fork the next row\n"
        + "ADR 0019 section 4. To split it, run in {row.checkoutRoot}: `{split}`. Evidence:\n" + got.evidence.join("\n"));
}

// settled reports whether a job is done with no call left for the person: `job wait`
// recorded it pass and its exit record names no unresolved risk. A worker's own report can
// only unsettle a job.
export fun settled(row: Row) > bool {
    return row.state == magus\JobState.pass and row.unresolvedRisks.len() == 0;
}

fun byId(jobs: [Row], id: str) > Row? {
    foreach (r in jobs) {
        if (r.id == id) {
            return r;
        }
    }
    return null;
}

// mandated reports whether id is a row m names, or a child forked from one, which by the job
// rules narrows its parent.
export fun mandated(id: str, m: Mandate, jobs: [Row]) > bool {
    var at = id;
    var hops = 0;
    while (at != "" and hops <= jobs.len()) {
        if (m.rows.indexOf(at) != null) {
            return true;
        }
        if (byId(jobs, id: at) -> row) {
            at = row.parent;
        } else {
            at = "";
        }
        hops = hops + 1;
    }
    return false;
}

fun isMagus(p: helpers\Program) > bool {
    return p.name == "magus";
}

// mandateAction is the subcommand a line runs hack/dev/issue-mandate.buzz with, "" for any other
// line.
fun mandateAction(p: helpers\Program) > str {
    if (!isMagus(p)) {
        return "";
    }
    final ops = helpers\magusOperands(p.args);
    if (ops.len() < 3 or ops[0] != "buzz" or !ops[1].endsWith("hack/dev/issue-mandate.buzz")) {
        return "";
    }
    return ops[2];
}

// jobVerb is a magus job line's verb and its operands after it, [] for any other line.
fun jobVerb(p: helpers\Program) > [str] {
    if (!isMagus(p)) {
        return [<str>];
    }
    final ops = helpers\magusOperands(p.args);
    if (ops.len() < 2 or ops[0] != "job") {
        return [<str>];
    }
    return ops.sub(1);
}

// Fork is a `magus job fork` as the rule reads it: the row it declares, its parent, and the
// rows it integrates, read from a --stdin record the line carries as a heredoc.
export object Fork {
    id: str,
    parent: str = "",
    integrates: [str] = [],
    // known is false for a --stdin fork whose record the line does not carry.
    known: bool = true,
}

// readFork is the fork p declares; body is the heredoc the line feeds it, "" for none.
export fun readFork(p: helpers\Program, body: str) > Fork {
    if (!helpers\hasFlag(p.args, long: "--stdin")) {
        final ops = helpers\stripFlags(p.args, valueFlags: ["--parent", "--write-paths", "--deny-paths", "--read-paths", "--depends-on", "--instructions", "--new-worker",
            "--check", "--checkout", "--checkpoint", "--model", "--timeout", "--brief-format"]);
        final named = helpers\magusOperands(ops);
        final id = if (named.len() > 2) named[2] else "";
        return Fork{ id = id, parent = helpers\flagValue(p.args, long: "--parent", short: "") ?? "" };
    }
    final doc: {str: any} = json\parse(body) catch {<str: any>};
    final id: str = doc["id"] ?? "";
    if (id == "") {
        return Fork{ id = "", known = false };
    }
    final listed: [any] = doc["integrates"] ?? [<any>];
    final integrates = mut [<str>];
    foreach (i in listed) {
        final name: str = i;
        integrates.append(name);
    }
    return Fork{ id = id, parent = doc["parent"] ?? "", integrates = integrates };
}

// plainHeredocs are the bodies of every heredoc on line, in order, fed to a command
// substitution or straight to a program's stdin.
export fun plainHeredocs(line: str) > [str] {
    final bodies = mut [<str>];
    final lines = line.split("\n");
    var i = 0;
    while (i < lines.len()) {
        final at = lines[i].indexOf("<<");
        if (at == null) {
            i = i + 1;
            continue;
        }
        final rest = lines[i].sub(at! + 2).replace("-", with: "").trim();
        final word = rest.split(" ")[0].replace("'", with: "").replace("\"", with: "");
        final body = mut [<str>];
        var j = i + 1;
        while (j < lines.len() and lines[j].trim() != word) {
            body.append(lines[j]);
            j = j + 1;
        }
        bodies.append(body.join("\n"));
        i = j + 1;
    }
    return bodies;
}

fun deny(reason: str) > GuardVerdict {
    return magus\guard.deny(reason, opts: {"rule": "mandate"});
}

// decideCommand judges one shell line against the mandate. Issuing or revoking one is the
// person's act, so it is denied whether or not one is in force; every other denial holds
// only while one is.
export fun decideCommand(programs: [helpers\Program], line: str, m: Mandate?, jobs: [Row], now: int, assess: fun (id: str) > Assessed) > GuardVerdict {
    foreach (p in programs) {
        final action = mandateAction(p);
        if (action == "issue" or action == "revoke") {
            return deny("a mandate is issued and revoked by the person, never by the root or a worker; propose the line and let them type it\n"
                + "ADR 0019 section 2: issuing it is the decision. `hack/dev/issue-mandate.buzz report` reads it.");
        }
    }
    if (pastCap(m, now: now)) {
        foreach (p in programs) {
            final verb = jobVerb(p);
            if (verb.len() > 0 and verb[0] == "fork") {
                return deny("the mandate ended at {m!.endClock}, so no fork runs until the person revokes it\n"
                    + "ADR 0019 section 3: the end time is the cap. `hack/dev/issue-mandate.buzz report` lists what is left.");
            }
        }
    }
    if (!inForce(m, now: now)) {
        return magus\guard.allow();
    }
    final mandate = m!;
    final bodies = plainHeredocs(line);
    var body = "";
    if (bodies.len() > 0) {
        body = bodies[0];
    }
    foreach (p in programs) {
        final judged = decideProgram(p, body: body, m: mandate, jobs: jobs, assess: assess);
        if (judged.decision != magus\GuardDecision.allow) {
            return judged;
        }
    }
    return magus\guard.allow();
}

fun decideProgram(p: helpers\Program, body: str, m: Mandate, jobs: [Row], assess: fun (id: str) > Assessed) > GuardVerdict {
    final verb = jobVerb(p);
    if (verb.len() > 0) {
        return decideJob(p, verb: verb, body: body, m: m, jobs: jobs, assess: assess);
    }
    if (p.name == "gh" and p.args.len() > 1 and p.args[0] == "pr" and p.args[1] == "merge") {
        return deny("merging is the person's under a mandate; the report lists the pull request\n"
            + "ADR 0019 section 5: merge and push stay reserved.");
    }
    if (p.vcs -> call) {
        if (call.subcommand == "push") {
            return deny("pushing is the person's under a mandate; the report lists the branch\n"
                + "ADR 0019 section 5: merge and push stay reserved.");
        }
        if (call.subcommand == "branch" and (call.args.indexOf("-D") != null or call.args.indexOf("-d") != null or call.args.indexOf("--delete") != null)) {
            foreach (name in helpers\stripFlags(call.args, valueFlags: [<str>])) {
                if (!madeUnder(jobs, id: name, m: m)) {
                    return deny("branch {name} is older than the mandate, so deleting it is the person's\n"
                        + "ADR 0019 section 5: a mandate deletes only work made under it.");
                }
            }
        }
        if (call.subcommand == "worktree" and call.args.len() > 1 and call.args[0] == "remove") {
            foreach (dir in helpers\stripFlags(call.args.sub(1), valueFlags: [<str>])) {
                if (!checkoutMadeUnder(jobs, dir: dir, m: m)) {
                    return deny("worktree {dir} is not one a row made under the mandate owns, so removing it is the person's\n"
                        + "ADR 0019 section 5: a mandate deletes only work made under it.");
                }
            }
        }
    }
    return magus\guard.allow();
}

fun madeUnder(jobs: [Row], id: str, m: Mandate) > bool {
    if (byId(jobs, id: id) -> row) {
        return row.created >= m.at;
    }
    return false;
}

fun checkoutMadeUnder(jobs: [Row], dir: str, m: Mandate) > bool {
    foreach (r in jobs) {
        if (r.checkoutRoot != "" and (r.checkoutRoot == dir or r.checkoutRoot.endsWith("/" + dir)) and r.created >= m.at) {
            return true;
        }
    }
    return false;
}

fun decideJob(p: helpers\Program, verb: [str], body: str, m: Mandate, jobs: [Row], assess: fun (id: str) > Assessed) > GuardVerdict {
    final what = verb[0];
    if (what == "grant") {
        return deny("a grant is typed by the person, never by the root or a worker\nADR 0019 section 5: the report names the grant left.");
    }
    if (what == "apply") {
        return deny("a plan goes into the store before its mandate is issued; `job apply` under one is new scope\n"
            + "ADR 0019, Consequences: the mandate can name only rows that exist when it is issued.");
    }
    if (what == "rm") {
        foreach (id in verb.sub(1)) {
            if (!madeUnder(jobs, id: id, m: m)) {
                return deny("job {id} is older than the mandate, so removing it is the person's\n"
                    + "ADR 0019 section 5: a mandate deletes only work made under it.");
            }
        }
        return magus\guard.allow();
    }
    if (what != "fork") {
        return magus\guard.allow();
    }
    final fork = readFork(p, body: body);
    if (!fork.known) {
        return deny("this --stdin fork's record is not on the line, so the mandate cannot place it; feed it as a heredoc\n"
            + "ADR 0019 section 5: a fork the mandate cannot read is judged as new scope.");
    }
    if (!mandated(fork.id, m: m, jobs: jobs) and !mandated(fork.parent, m: m, jobs: jobs)) {
        return deny("{fork.id} is new scope: the mandate names {m.rows.join(", ")} and their children\n"
            + "ADR 0019 section 2: a row the mandate does not name waits for the person.");
    }
    foreach (id in fork.integrates) {
        final held = decideHold(id, m: m, jobs: jobs, assess: assess);
        if (held.decision != magus\GuardDecision.allow) {
            return held;
        }
    }
    return magus\guard.allow();
}

// decideHold holds an unsettled job for review when its proven tier is above the mandate's
// tolerance: the integration fork naming it is denied, the row stays for the person, and the
// root goes on with the next row.
export fun decideHold(id: str, m: Mandate, jobs: [Row], assess: fun (id: str) > Assessed) > GuardVerdict {
    if (byId(jobs, id: id) -> row) {
        if (settled(row)) {
            return decideBudget(id, m: m, row: row, got: assess(id));
        }
    }
    final got = assess(id);
    if (rank(got.tier) <= rank(m.tolerance)) {
        return magus\guard.allow();
    }
    return deny("{id} is held for review: unsettled at tier {got.tier}, above the mandate's tolerance {m.tolerance}; fork the next row\n"
        + "ADR 0019 section 4. Evidence:\n" + got.evidence.join("\n"));
}

// relative is path as a workspace-relative path, "" when it lies outside workspace.
fun relative(path: str, workspace: str) > str {
    if (!path.startsWith("/")) {
        return path;
    }
    if (path.startsWith(workspace + "/")) {
        return path.sub(workspace.len() + 1);
    }
    return "";
}

// decideWrite judges one file write. The mandate file is denied always, since writing it
// issues a mandate; the reserved paths only while one is in force.
export fun decideWrite(path: str, workspace: str, m: Mandate?, now: int) > GuardVerdict {
    final file = mandateFile(workspace) ?? "";
    final attention = attentionFile(workspace) ?? "";
    if (path != "" and (path == file or path == attention)) {
        return deny("the mandate file is written by `hack/dev/issue-mandate.buzz`, run by the person\nADR 0019 section 8.");
    }
    if (!inForce(m, now: now)) {
        return magus\guard.allow();
    }
    final rel = relative(path, workspace: workspace);
    foreach (reserved in reservedPaths) {
        if (rel == reserved or (reserved.endsWith("/") and rel.startsWith(reserved))) {
            return deny("{rel} is reserved under a mandate: decisions, design and hook config stay the person's\n"
                + "ADR 0019 section 5.");
        }
    }
    return magus\guard.allow();
}

// StopFacts is what the Stop rule reads of a stop.
export object StopFacts {
    role: str,
    stopHookActive: bool,
    // running are the tries the guard saw start whose end nobody has
    // observed, read under each job's deadline.
    running: [Try] = [],
}

// Try is one try of a job: started at a unix second, end unobserved.
export object Try {
    job: str,
    n: int,
    started: int,
}

// runningTries are the tries in attempts the guard saw start and
// nobody saw end.
export fun runningTries(attempts: [magus\Attempt]) > [Try] {
    final found = mut [<Try>];
    foreach (a in attempts) {
        if (a.status.started != 0 and a.status.ended == 0) {
            found.append(Try{ job = a.job, n = a.n, started = a.status.started });
        }
    }
    return found;
}

// runningLine names each try still counted as running.
fun runningLine(running: [Try], now: int) > str {
    final named = mut [<str>];
    foreach (t in running) {
        named.append("{t.job} attempt {t.n}, started {(now - t.started) / 60}m ago");
    }
    return "this stop stands: {named.join("; ")}: started, end unobserved. "
        + "A handback, `magus job exit` or the job's deadline ends each.";
}

// Queue is the job store as the Stop rule reads it.
export object Queue {
    jobs: [Row],
    // blocked are the rows the store reports waiting on another.
    blocked: [str] = [],
    // unmerged is magus\workspace().unmerged() on the root's branch.
    unmerged: JobUnmergedReport = JobUnmergedReport{},
}

// unmergedShown is how many facts one refusal spells out.
final unmergedShown = 10;

// unmergedLines renders each fact with its row, head and remedy. An
// unknown read is a line of its own: it never reads as merged.
fun unmergedLines(report: JobUnmergedReport) > [str] {
    final lines = mut [<str>];
    if (report.unknown != "") {
        lines.append("unknown: {report.unknown}. Nothing is taken as merged until that read answers.");
    }
    foreach (i, u in report.rows) {
        if (i == unmergedShown) {
            lines.append("and {report.rows.len() - unmergedShown} more; `./magus ls jobs` lists every one.");
            break;
        }
        var subject = u.job;
        if (u.head != "") {
            subject = "{subject} at {u.head}";
        }
        if (u.item != "") {
            subject = "{subject}, item \"{u.item}\"";
        }
        lines.append("{subject}: {u.why}. Remedy: {u.remedy}.");
    }
    return lines;
}

// unmergedRows names what a refusal is over, for its count and attention.
fun unmergedRows(report: JobUnmergedReport) > [str] {
    final names = mut [<str>];
    if (report.unknown != "") {
        names.append("unknown");
    }
    foreach (u in report.rows) {
        if (names.indexOf(u.job) == null) {
            names.append(u.job);
        }
    }
    return names;
}

// forkable are the rows the root could work next: declared, not paused or blocked, every row
// they depend on passed. Under a mandate they are the mandated rows; with none, every row.
export fun forkable(q: Queue, m: Mandate?, now: int) > [str] {
    final under = inForce(m, now: now);
    final found = mut [<str>];
    foreach (r in q.jobs) {
        if (r.state != magus\JobState.declared or r.paused or q.blocked.indexOf(r.id) != null) {
            continue;
        }
        if (under and !mandated(r.id, m: m!, jobs: q.jobs)) {
            continue;
        }
        var ready = true;
        foreach (dep in r.dependsOn) {
            final row = byId(q.jobs, id: dep);
            if (row == null or row!.state != magus\JobState.pass) {
                ready = false;
            }
        }
        if (ready) {
            found.append(r.id);
        }
    }
    return found;
}

fun stoppedLine(stopped: [str]) > str {
    return "stopped with no result: {stopped.join(", ")}. Exit each with `./magus job exit <job>`, or continue that worker.";
}

// idleStopReason is why decideStop refuses. The first line is all the
// person sees; the rest reaches the agent alone.
fun idleStopReason(ready: [str], unmerged: [str], stopped: [str]) > str {
    var reason = "this stop is refused: finished work is not merged, or a deferred item stands";
    if (ready.len() > 0) {
        reason = "this stop is refused: rows wait to be worked and no worker runs to wake this session\n"
            + "ready: {ready.join(", ")}. Spawn a worker on {ready[0]}; `./magus describe job {ready[0]}` prints its terms.\n"
            + "To stop instead, pause the rows: `./magus job pause {ready.join(" ")}`.";
    }
    if (unmerged.len() > 0) {
        reason = reason + "\n" + unmerged.join("\n");
    }
    if (stopped.len() > 0) {
        reason = reason + "\n" + stoppedLine(stopped);
    }
    return reason;
}

// mandateEnded is true once the mandate in force has run past its end.
fun mandateEnded(m: Mandate?, now: int) > bool {
    if (m -> mandate) {
        return mandate.action == "issue" and now >= mandate.ends;
    }
    return false;
}

// decideStop refuses the root's stop while rows it could fork wait and no worker runs to wake
// it. With no mandate in force it refuses once per stop, so a person present can end a turn.
// Under a mandate a refusal naming the same rows loopLimit stops running lets the turn end and
// calls file with the rows, for the person. Past the mandate's end the turn ends.
// What magus\workspace().unmerged() reports refuses as a waiting row does.
// A try started and not seen to end is worked, whatever its row's state,
// and the stop stands saying so.
// A running row whose holder stopped wakes nobody.
// With nothing else waiting it refuses once.
export fun decideStop(facts: StopFacts, q: Queue, m: Mandate?, now: int, count: fun (key: str) > int, file: fun (rows: [str]) > void) > GuardVerdict {
    if (facts.role != "root") {
        return magus\guard.allow();
    }
    if (facts.running.len() > 0) {
        return magus\guard.advise(runningLine(facts.running, now: now), opts: {"rule": "idle-stop"});
    }
    final stopped = mut [<str>];
    foreach (r in q.jobs) {
        if (r.state == magus\JobState.running) {
            if (r.holderStopped == 0) {
                return magus\guard.allow();
            }
            if (!r.paused) {
                stopped.append(r.id);
            }
        }
    }
    if (mandateEnded(m, now: now)) {
        return magus\guard.allow();
    }
    final ready = forkable(q, m: m, now: now);
    final unmerged = unmergedLines(q.unmerged);
    if (ready.len() == 0 and unmerged.len() == 0) {
        if (stopped.len() == 0 or facts.stopHookActive) {
            return magus\guard.allow();
        }
        final reason = "this stop is refused: a stopped worker's row has no result\n{stoppedLine(stopped)}";
        return magus\guard.deny(reason, opts: {"rule": "idle-stop"});
    }
    final reason = idleStopReason(ready, unmerged: unmerged, stopped: stopped);
    var names = ready;
    if (unmerged.len() > 0) {
        names = ready + unmergedRows(q.unmerged);
    }
    if (!inForce(m, now: now)) {
        if (facts.stopHookActive) {
            return magus\guard.allow();
        }
        return magus\guard.deny(reason, opts: {"rule": "idle-stop"});
    }
    if (count("mandate-idle-stop:" + names.join(",")) >= loopLimit) {
        file(names);
        return magus\guard.advise("the mandate refused this stop {loopLimit} times over the same rows, so the turn ends and they wait for the person: {names.join(", ")}",
            opts: {"rule": "idle-stop"});
    }
    return magus\guard.deny(reason, opts: {"rule": "idle-stop"});
}

// fileAttention appends one attention entry for rows to the repository's attention file.
export fun fileAttention(workspace: str, rows: [str], now: int) > void {
    if (attentionFile(workspace) -> file) {
        fs\mkdirAll(fs\dirname(file)) catch void;
        final line = json\stringify({"at": now, "rows": rows, "why": "a fork kept failing: the Stop rule refused {loopLimit} stops over these rows"}) catch "";
        if (line != "") {
            fs\appendFile(file, content: line + "\n") catch void;
        }
    }
}

final issued = Mandate{ action = "issue", at = 1000, endClock = "07:30", ends = 5000, tolerance = "mechanical", rows = ["naming-lint", "go-indexer"] };
final store = [
    Row{ id = "naming-lint", state = magus\JobState.declared, created = 500 },
    Row{ id = "go-indexer", state = magus\JobState.pass, created = 500 },
    Row{ id = "naming-lint/docs", state = magus\JobState.declared, parent = "naming-lint", created = 1500 },
    Row{ id = "landing", state = magus\JobState.declared, created = 500 },
    Row{ id = "late", state = magus\JobState.pass, created = 2000, unresolvedRisks = ["picked a name"] },
];
final fullTier = fun (id: str) > Assessed => Assessed{ tier = "full", evidence = ["x.go: full (unproven)"], lines = 120 };
final mechanicalTier = fun (id: str) > Assessed => Assessed{ tier = "mechanical", lines = 0 };
final largeTier = fun (id: str) > Assessed => Assessed{ tier = "full", evidence = ["x.go: full (unproven), 900 lines"], lines = 900 };
final uncountedTier = fun (id: str) > Assessed => Assessed{ tier = "full", evidence = ["x.go: full (unproven)"] };

fun magusLine(args: [str]) > [helpers\Program] {
    return helpers\request([["magus"] + args]);
}

test "a mandate file's last line wins and a line that is no mandate is skipped" {
    final text = "\{\"action\":\"issue\",\"at\":1,\"ends\":9,\"tolerance\":\"mechanical\",\"rows\":[\"a\"]\}\nnot json\n\{\"action\":\"revoke\",\"at\":5\}\n";
    final m = lastMandate(text);
    std\assert(m != null and m!.action == "revoke" and m!.at == 5, message: "the revoke line wins");
    std\assert(lastMandate("") == null, message: "no mandate");
    std\assert(lastMandate("\{\"action\":\"issue\",\"at\":1,\"ends\":9,\"rows\":[\"a\",\"b\"]\}").rows.len() == 2, message: "rows decode");
}

test "a mandate is in force from its issue until its end time, and a revoke line ends it" {
    std\assert(inForce(issued, now: 4999), message: "before the end");
    std\assert(!inForce(issued, now: 5000), message: "at the end");
    std\assert(!inForce(Mandate{ action = "revoke", at = 2000 }, now: 3000), message: "revoked");
    std\assert(!inForce(null, now: 3000), message: "none");
}

test "a mandate round-trips through its line" {
    final again = parseMandate(encodeMandate(issued) catch "");
    std\assert(again != null and again!.ends == 5000 and again!.rows.join(",") == "naming-lint,go-indexer" and again!.tolerance == "mechanical", message: "round trip");
}

test "a named row and its children are mandated and another row is new scope" {
    std\assert(mandated("naming-lint", m: issued, jobs: store), message: "named");
    std\assert(mandated("naming-lint/docs", m: issued, jobs: store), message: "child");
    std\assert(!mandated("landing", m: issued, jobs: store), message: "unnamed");
    std\assert(!mandated("", m: issued, jobs: store), message: "empty");
}

test "issuing or revoking a mandate is denied to the root and its workers, in force or not" {
    final issue = magusLine(["buzz", "hack/dev/issue-mandate.buzz", "--", "issue", "--until", "07:30"]);
    std\assert(decideCommand(issue, line: "", m: null, jobs: store, now: 0, assess: fullTier).decision == magus\GuardDecision.deny, message: "issue");
    std\assert(decideCommand(magusLine(["buzz", "hack/dev/issue-mandate.buzz", "--", "revoke"]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.deny, message: "revoke");
    std\assert(decideCommand(magusLine(["buzz", "hack/dev/issue-mandate.buzz", "--", "report"]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.allow, message: "report");
}

test "a fork inside the mandate is allowed and new scope is denied while it is in force" {
    final child = magusLine(["job", "fork", "naming-lint/tests", "--parent", "naming-lint"]);
    std\assert(decideCommand(child, line: "", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.allow, message: "child of a named row");
    final scope = magusLine(["job", "fork", "new-idea"]);
    final denied = decideCommand(scope, line: "", m: issued, jobs: store, now: 2000, assess: fullTier);
    std\assert(denied.decision == magus\GuardDecision.deny, message: "new scope");
    std\assert(denied.reason.indexOf("naming-lint, go-indexer") != null, message: "names the mandate");
    std\assert(decideCommand(child, line: "", m: issued, jobs: store, now: 6000, assess: fullTier).decision == magus\GuardDecision.deny, message: "past the end, every fork waits for a revoke");
    std\assert(decideCommand(scope, line: "", m: Mandate{ action = "revoke", at = 6000 }, jobs: store, now: 7000, assess: fullTier).decision == magus\GuardDecision.allow, message: "revoked, the mandate holds nothing");
    std\assert(decideCommand(magusLine(["job", "apply", "plan.jsonl"]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.deny, message: "apply");
}

test "a --stdin fork is read from its heredoc and one the line does not carry is denied" {
    final line = "./magus job fork --stdin <<'EOF'\n\{\"id\":\"naming-lint/land\",\"parent\":\"naming-lint\",\"integrates\":[\"go-indexer\"]\}\nEOF";
    final stdin = magusLine(["job", "fork", "--stdin"]);
    std\assert(decideCommand(stdin, line: line, m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.allow, message: "a settled job is integrated at any tier");
    std\assert(decideCommand(stdin, line: "./magus job fork --stdin < job.json", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.deny, message: "unread record");
}

test "an unsettled job above the tolerance is held for review and one at or below it is integrated" {
    std\assert(decideHold("late", m: issued, jobs: store, assess: fullTier).decision == magus\GuardDecision.deny, message: "risks above tolerance");
    std\assert(decideHold("late", m: issued, jobs: store, assess: mechanicalTier).decision == magus\GuardDecision.allow, message: "at tolerance");
    std\assert(decideHold("naming-lint", m: issued, jobs: store, assess: fullTier).decision == magus\GuardDecision.deny, message: "not passed is unsettled");
    std\assert(decideHold("go-indexer", m: issued, jobs: store, assess: fullTier).decision == magus\GuardDecision.allow, message: "settled");
    final held = decideHold("late", m: issued, jobs: store, assess: fullTier);
    std\assert(held.reason.indexOf("x.go: full (unproven)") != null, message: "carries the evidence");
}

test "a settled job over the budget is held and names the split, one within it is integrated" {
    std\assert(decideHold("go-indexer", m: issued, jobs: store, assess: fullTier).decision == magus\GuardDecision.allow, message: "120 lines is within 400");
    final held = decideHold("go-indexer", m: issued, jobs: store, assess: largeTier);
    std\assert(held.decision == magus\GuardDecision.deny, message: "900 lines is past 400");
    std\assert(held.reason.indexOf("900 lines in scoped or full paths, above the mandate's budget of 400") != null, message: held.reason);
    std\assert(held.reason.indexOf("split-into-branches.buzz -- --by symbols") != null, message: "names the split a person runs");
    final tight = Mandate{ action = "issue", at = 1000, endClock = "07:30", ends = 5000, tolerance = "mechanical", rows = ["go-indexer"], budget = 100 };
    std\assert(decideHold("go-indexer", m: tight, jobs: store, assess: fullTier).decision == magus\GuardDecision.deny, message: "the mandate's own budget decides");
    final unknown = decideHold("go-indexer", m: issued, jobs: store, assess: uncountedTier);
    std\assert(unknown.decision == magus\GuardDecision.deny and unknown.reason.indexOf("could not be counted") != null, message: "an uncounted job is never taken as small");
}

test "a mandate line without a budget reads as the review budget, and one with it round-trips" {
    final old = parseMandate(`{"action":"issue","at":1,"until":"07:30","ends":2,"tolerance":"mechanical","rows":["a"]}`);
    std\assert(old!.budget == branchstack\reviewBudget, message: "older lines carry no budget");
    final kept = parseMandate(encodeMandate(Mandate{ action = "issue", at = 1, tolerance = "mechanical", rows = ["a"], budget = 250 }) catch "");
    std\assert(kept!.budget == 250, message: "the budget survives its line");
}

test "a job's tier is measured in its checkout from its checkpoint, and anything unmeasured is full" {
    final measured = [Row{ id = "late", state = magus\JobState.pass, checkpoint = "abc", checkoutRoot = "/w/late" }, Row{ id = "bare", state = magus\JobState.pass }];
    final asked = mut [<str>];
    final mechanical = fun (row: Row) > TierReport !> any {
        asked.append("{row.checkoutRoot}@{row.checkpoint}");
        return TierReport{ tier = magus\Tier.mechanical, evidence = [TierEvidence{ path = "x.go", tier = magus\Tier.mechanical, class = "comment", why = "comments only" }] };
    };
    final none = fun (row: Row) > {str: int} !> any {
        return {"x.go": 7};
    };
    final got = assess("late", jobs: measured, measure: mechanical, count: none);
    std\assert(got.tier == "mechanical" and asked.join(",") == "/w/late@abc", message: "measured in the job's checkout");
    std\assert(got.evidence.join("\n") == "x.go: mechanical (comment: comments only)", message: "evidence as affected ci prints it");
    std\assert(got.lines == 0, message: "a mechanical path's lines are not reviewable");
    std\assert(assess("bare", jobs: measured, measure: mechanical, count: none).tier == "full", message: "no checkout recorded");
    std\assert(assess("gone", jobs: measured, measure: mechanical, count: none).tier == "full", message: "no row");
    final raises = fun (row: Row) > TierReport !> any {
        throw "no workspace";
    };
    final raised = assess("late", jobs: measured, measure: raises, count: none);
    std\assert(raised.tier == "full" and raised.evidence[0].indexOf("no workspace") != null, message: "a raise is full and says why");
}

test "merge, push, grant and deleting older work are reserved under a mandate" {
    std\assert(decideCommand(helpers\request([["gh", "pr", "merge", "625"]]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.deny, message: "merge");
    std\assert(decideCommand(helpers\vcsRequest([["git", "push", "origin", "x"]]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.deny, message: "push");
    std\assert(decideCommand(magusLine(["job", "grant", "x"]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.deny, message: "grant");
    std\assert(decideCommand(magusLine(["job", "rm", "landing"]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.deny, message: "older row");
    std\assert(decideCommand(magusLine(["job", "rm", "naming-lint/docs"]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.allow, message: "row made under the mandate");
    std\assert(decideCommand(helpers\vcsRequest([["git", "branch", "-D", "landing"]]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.deny, message: "older branch");
    std\assert(decideCommand(helpers\vcsRequest([["git", "push", "origin", "x"]]), line: "", m: null, jobs: store, now: 2000, assess: fullTier).decision == magus\GuardDecision.allow, message: "no mandate adds nothing");
}

test "reserved paths are denied only under a mandate and the mandate file always" {
    std\assert(decideWrite("/w/docs/decisions/0020.md", workspace: "/w", m: issued, now: 2000).decision == magus\GuardDecision.deny, message: "decision");
    std\assert(decideWrite("/w/magus.yaml", workspace: "/w", m: issued, now: 2000).decision == magus\GuardDecision.deny, message: "config");
    std\assert(decideWrite("/w/internal/guard/x.go", workspace: "/w", m: issued, now: 2000).decision == magus\GuardDecision.allow, message: "code");
    std\assert(decideWrite("/w/docs/decisions/0020.md", workspace: "/w", m: null, now: 2000).decision == magus\GuardDecision.allow, message: "no mandate");
}

test "an idle root stop is refused once with no mandate and every time under one" {
    final q = Queue{ jobs = store };
    final none = fun (key: str) > int => 1;
    final skip = fun (rows: [str]) > void {};
    final once = decideStop(StopFacts{ role = "root", stopHookActive = false }, q: q, m: null, now: 2000, count: none, file: skip);
    std\assert(once.decision == magus\GuardDecision.deny, message: "first stop");
    std\assert(once.reason.indexOf("naming-lint") != null, message: "names the row");
    std\assert(once.reason.split("\n")[0].indexOf("`") == null, message: "the line the person sees carries no command");
    std\assert(decideStop(StopFacts{ role = "root", stopHookActive = true }, q: q, m: null, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "second stop");
    std\assert(decideStop(StopFacts{ role = "root", stopHookActive = true }, q: q, m: issued, now: 2000, count: none, file: skip).decision == magus\GuardDecision.deny, message: "under a mandate");
    std\assert(decideStop(StopFacts{ role = "root", stopHookActive = false }, q: q, m: issued, now: 6000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "past the end");
    std\assert(decideStop(StopFacts{ role = "worker", stopHookActive = false }, q: q, m: issued, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "a worker");
}

test "a running row lets the root stop, and so do rows paused, blocked or waiting on a dependency" {
    final none = fun (key: str) > int => 1;
    final skip = fun (rows: [str]) > void {};
    final root = StopFacts{ role = "root", stopHookActive = false };
    final running = Queue{ jobs = [Row{ id = "naming-lint", state = magus\JobState.declared }, Row{ id = "go-indexer", state = magus\JobState.running }] };
    std\assert(decideStop(root, q: running, m: issued, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "a worker will wake it");
    final held = Queue{ jobs = [Row{ id = "naming-lint", state = magus\JobState.declared, paused = true }, Row{ id = "go-indexer", state = magus\JobState.declared, dependsOn = ["gone"] }] };
    std\assert(decideStop(root, q: held, m: issued, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "paused and waiting");
    final blocked = Queue{ jobs = [Row{ id = "naming-lint", state = magus\JobState.declared }], blocked = ["naming-lint"] };
    std\assert(decideStop(root, q: blocked, m: issued, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "blocked");
}

test "a stopped holder's row refuses the root's stop once and never reads as a running worker" {
    final none = fun (key: str) > int => 1;
    final skip = fun (rows: [str]) > void {};
    final root = StopFacts{ role = "root", stopHookActive = false };
    final again = StopFacts{ role = "root", stopHookActive = true };
    final alone = Queue{ jobs = [Row{ id = "go-indexer", state = magus\JobState.running, holderStopped = 1500 }] };
    final refused = decideStop(root, q: alone, m: null, now: 2000, count: none, file: skip);
    std\assert(refused.decision == magus\GuardDecision.deny, message: "refused");
    std\assert(refused.reason.indexOf("go-indexer") != null, message: "names the row");
    std\assert(refused.reason.split("\n")[0].indexOf("`") == null, message: "the line the person sees carries no command");
    std\assert(refused.reason.indexOf("continue that worker") != null, message: "names the continuation and no tool");
    _ = verdict\checked(refused, label: "stopped holder");
    std\assert(decideStop(again, q: alone, m: null, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "the second stop stands");
    std\assert(decideStop(again, q: alone, m: issued, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "once under a mandate too");

    final beside = Queue{ jobs = [alone.jobs[0], Row{ id = "naming-lint", state = magus\JobState.running }] };
    std\assert(decideStop(root, q: beside, m: null, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "a running worker still wakes the root");
    final paused = Queue{ jobs = [Row{ id = "go-indexer", state = magus\JobState.running, holderStopped = 1500, paused = true }] };
    std\assert(decideStop(root, q: paused, m: null, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "a person paused it");
}

test "a stopped holder's row does not let the root idle with work queued" {
    final none = fun (key: str) > int => 1;
    final skip = fun (rows: [str]) > void {};
    final queued = Queue{ jobs = [Row{ id = "go-indexer", state = magus\JobState.running, holderStopped = 1500 }, Row{ id = "naming-lint", state = magus\JobState.declared }] };
    final refused = decideStop(StopFacts{ role = "root", stopHookActive = true }, q: queued, m: issued, now: 2000, count: none, file: skip);
    std\assert(refused.decision == magus\GuardDecision.deny, message: "every stop under a mandate");
    std\assert(refused.reason.indexOf("naming-lint") != null, message: "names the waiting row");
    std\assert(refused.reason.indexOf("stopped with no result: go-indexer") != null, message: "names the stopped row");
}

test "a try started and not seen to end lets the root stop and says so, whatever its row reads" {
    final none = fun (key: str) > int => 1;
    final skip = fun (rows: [str]) > void {};
    final spawned = Queue{ jobs = [Row{ id = "naming-lint", state = magus\JobState.declared }] };
    final live = StopFacts{ role = "root", stopHookActive = false, running = [Try{ job = "naming-lint", n = 1, started = 1880 }] };
    final stands = decideStop(live, q: spawned, m: issued, now: 2000, count: none, file: skip);
    std\assert(stands.decision == magus\GuardDecision.advise, message: "spawned, not yet past job exec");
    std\assert(stands.reason.indexOf("naming-lint attempt 1, started 2m ago: started, end unobserved") != null, message: stands.reason);
    final waiting = Queue{ jobs = [Row{ id = "naming-lint", state = magus\JobState.running, holderStopped = 1500 }] };
    std\assert(decideStop(live, q: waiting, m: null, now: 2000, count: none, file: skip).decision == magus\GuardDecision.advise, message: "waiting on its own background run");
    final ended = decideStop(StopFacts{ role = "root", stopHookActive = false }, q: waiting, m: null, now: 2000, count: none, file: skip);
    std\assert(ended.decision == magus\GuardDecision.deny and ended.reason.indexOf("stopped with no result: naming-lint") != null, message: "stopped once its end was observed");
}

test "a try runs from its start until an end is observed" {
    final tries = [
        Attempt{ job = "a", n = 1, status = AttemptStatus{ started = 10 } },
        Attempt{ job = "b", n = 2, status = AttemptStatus{ started = 10, ended = 20, end = magus\AttemptEnd.handback } },
        Attempt{ job = "c", n = 1 },
    ];
    final running = runningTries(tries);
    std\assert(running.len() == 1 and running[0].job == "a" and running[0].n == 1, message: "only the started try with no end");
}

final offBranch = JobUnmergedReport{ branch = "feat/x", rows = [JobUnmerged{ job = "go-indexer", head = "abc123", why = "2 commit(s) are not on feat/x", remedy = "merge abc123" }] };
final doneStore = [Row{ id = "go-indexer", state = magus\JobState.pass }];

test "finished work off the branch refuses the root's stop, naming the row, its head and the remedy" {
    final none = fun (key: str) > int => 1;
    final skip = fun (rows: [str]) > void {};
    final root = StopFacts{ role = "root", stopHookActive = false };
    final refused = decideStop(root, q: Queue{ jobs = doneStore, unmerged = offBranch }, m: null, now: 2000, count: none, file: skip);
    std\assert(refused.decision == magus\GuardDecision.deny, message: "refused");
    std\assert(refused.reason.split("\n")[0].indexOf("`") == null, message: "the line the person sees carries no command");
    std\assert(refused.reason.indexOf("go-indexer at abc123") != null, message: "row and head");
    std\assert(refused.reason.indexOf("Remedy: merge abc123") != null, message: "remedy");
    std\assert(decideStop(root, q: Queue{ jobs = doneStore }, m: null, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "nothing off the branch");
    std\assert(decideStop(StopFacts{ role = "root", stopHookActive = true }, q: Queue{ jobs = doneStore, unmerged = offBranch }, m: null, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "a person present can still stop on the second");
    std\assert(decideStop(StopFacts{ role = "worker", stopHookActive = false }, q: Queue{ jobs = doneStore, unmerged = offBranch }, m: null, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "a worker");
}

test "a deferred item refuses the stop and an unknown read is never taken as merged" {
    final none = fun (key: str) > int => 1;
    final skip = fun (rows: [str]) > void {};
    final root = StopFacts{ role = "root", stopHookActive = false };
    final item = JobUnmergedReport{ rows = [JobUnmerged{ job = "go-indexer", item = "picked a name", why = "no row carries it", remedy = "declare a row" }] };
    final deferred = decideStop(root, q: Queue{ jobs = doneStore, unmerged = item }, m: null, now: 2000, count: none, file: skip);
    std\assert(deferred.decision == magus\GuardDecision.deny and deferred.reason.indexOf("picked a name") != null, message: "names the item");
    final unknown = decideStop(root, q: Queue{ jobs = doneStore, unmerged = JobUnmergedReport{ unknown = "no branch" } }, m: null, now: 2000, count: none, file: skip);
    std\assert(unknown.decision == magus\GuardDecision.deny and unknown.reason.indexOf("no branch") != null, message: "says why");
}

test "a row with only unresolved risks lets the root stop, with no mandate and under one" {
    final none = fun (key: str) > int => 1;
    final skip = fun (rows: [str]) > void {};
    final root = StopFacts{ role = "root", stopHookActive = false };
    final risks = JobUnmergedReport{ risks = [JobUnmerged{ job = "go-indexer", item = "a caveat", why = "listed", remedy = "dismiss it" }] };
    std\assert(decideStop(root, q: Queue{ jobs = doneStore, unmerged = risks }, m: null, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "no mandate");
    std\assert(decideStop(root, q: Queue{ jobs = doneStore, unmerged = risks }, m: issued, now: 2000, count: none, file: skip).decision == magus\GuardDecision.allow, message: "under a mandate");
}

test "a long report names the first facts and points at the whole list" {
    final many = mut [<JobUnmerged>];
    for (var i = 0; i < unmergedShown + 2; i = i + 1) {
        many.append(JobUnmerged{ job = "r{i}", why = "off", remedy = "merge" });
    }
    final lines = unmergedLines(JobUnmergedReport{ rows = many });
    std\assert(lines.len() == unmergedShown + 1, message: "the first ones and a count");
    std\assert(lines[unmergedShown].startsWith("and 2 more"), message: "says how many are left");
}

test "an unmerged refusal carries the verdict shape" {
    final none = fun (key: str) > int => 1;
    final skip = fun (rows: [str]) > void {};
    _ = verdict\checked(decideStop(StopFacts{ role = "root", stopHookActive = false }, q: Queue{ jobs = doneStore, unmerged = offBranch }, m: null, now: 2000, count: none, file: skip), label: "unmerged");
}

test "under a mandate unmerged work refuses until the loop limit, then files the rows" {
    final filed = mut [<str>];
    final record = fun (rows: [str]) > void {
        foreach (r in rows) {
            filed.append(r);
        }
    };
    final root = StopFacts{ role = "root", stopHookActive = true };
    final q = Queue{ jobs = doneStore, unmerged = offBranch };
    std\assert(decideStop(root, q: q, m: issued, now: 2000, count: fun (key: str) > int => 1, file: record).decision == magus\GuardDecision.deny, message: "refused");
    std\assert(decideStop(root, q: q, m: issued, now: 2000, count: fun (key: str) > int => 3, file: record).decision == magus\GuardDecision.advise, message: "the turn ends");
    std\assert(filed.join(",") == "go-indexer", message: "files the row");
}

test "every denial carries the verdict shape" {
    final none = fun (key: str) > int => 1;
    final skip = fun (rows: [str]) > void {};
    _ = verdict\checked(decideCommand(magusLine(["buzz", "hack/dev/issue-mandate.buzz", "--", "issue"]), line: "", m: null, jobs: store, now: 0, assess: fullTier), label: "issue");
    _ = verdict\checked(decideCommand(magusLine(["job", "fork", "new-idea"]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier), label: "new scope");
    _ = verdict\checked(decideCommand(magusLine(["job", "apply", "plan.jsonl"]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier), label: "apply");
    _ = verdict\checked(decideCommand(magusLine(["job", "rm", "landing"]), line: "", m: issued, jobs: store, now: 2000, assess: fullTier), label: "rm");
    _ = verdict\checked(decideHold("late", m: issued, jobs: store, assess: fullTier), label: "held for review");
    _ = verdict\checked(decideWrite("/w/docs/design/x.md", workspace: "/w", m: issued, now: 2000), label: "write");
    _ = verdict\checked(decideStop(StopFacts{ role = "root", stopHookActive = false }, q: Queue{ jobs = store }, m: null, now: 2000, count: none, file: skip), label: "stop");
}

test "the third refusal over the same rows lets the turn end and files them" {
    final filed = mut [<str>];
    final third = fun (key: str) > int => 3;
    final record = fun (rows: [str]) > void {
        foreach (r in rows) {
            filed.append(r);
        }
    };
    final v = decideStop(StopFacts{ role = "root", stopHookActive = true }, q: Queue{ jobs = store }, m: issued, now: 2000, count: third, file: record);
    std\assert(v.decision == magus\GuardDecision.advise, message: "the turn ends");
    std\assert(filed.join(",") == "naming-lint,naming-lint/docs", message: "files the rows");
}
