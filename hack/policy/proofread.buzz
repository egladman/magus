namespace agentpolicy\proofread;

import "std";
import "fs";
import "path";
import "encoding/json";

// RULES is this repository's decisions table for libs/proofread: the house style the
// judge ships off, turned on here, each with what justified it. A rule left out keeps its
// shipped default. history stays off: a doc that says what a symbol replaced is judged by a
// reader, and the symbol-docs lint never held it.
final RULES: {str: str} = {
    // One spelling per glossary term (docs/conventions.md), so a search finds every use.
    "terms": "deny",
    // A page and a description state what the code does now; "will" and "I added" date it.
    "tense": "deny",
    // An em or en dash has a plain spelling everyone can type and grep for; a page mixing
    // the two is searched with two patterns or not at all.
    "dash": "deny",
    // Curly quotes, the ellipsis character and emoji, for the same reason as dash.
    "ascii": "deny",
    // A commit, a pull request and a page in this repository credit no tool and no session.
    "attribution": "deny",
    // The doc-comment budgets the symbol-docs lint held every Go and TypeScript doc to.
    "comment-block": "deny",
    "comment-sentence": "deny",
    // A spaced hyphen is the em dash typed in ASCII: in a doc comment, and in the help text of
    // a command or flag, which hack/lint/cli-help-follows-proofread-rules.buzz judges.
    "aside": "deny",
    "docstub": "deny",
    // An agent pays for every word of a skill on every load.
    "terse-sentence": "deny",
    "terse-paragraph": "deny",
    // "rule" names only what magus enforces, so an agent can tell a check from a habit.
    "bare-rule": "deny",
    // A skill body that does not render cannot be judged, and silence would read as a pass.
    "template": "deny",
    // The Go comment budget and the banned words, carried over to the comments of a
    // stylesheet, which hack/policy/comments.buzz judges on a write.
    "restates": "deny",
    "comment-budget": "deny",
    "block-budget": "deny",
    "banned-word": "deny",
    // Graded where their words can mean another thing, but the Markdown lint, the
    // pr-description step and the commit guard denied them on pages, changelog fragments,
    // descriptions and commits: a stock label, "in order to", "let's dive in", a template's
    // unfilled placeholder, a fragment's unknown group.
    "reply-voice": "deny",
    "wordy": "deny",
    "signpost": "deny",
    "leak": "deny",
    "changelog-group": "deny",
    // The review rules ship off until a labeling round measures them; here they run graded,
    // at weight 0 until one does, each backed by the study or convention its page cites.
    "no-reason": "advise",
    "nit-label": "advise",
    "empty-request-changes": "advise",
    "approve-blocker": "advise",
    "bare-lgtm": "advise",
    "deferral-no-link": "advise",
    "decline-no-reason": "advise",
    "impatience": "advise",
    "review-length": "advise",
    // Generated-writing tells in descriptions, commits and review text, which ship off until
    // a labeling round measures them.
    "triad": "advise",
    "stacked-colon": "advise",
    "restates-diff": "advise",
    // The list and date rules ship off until a labeling round measures them; here they run
    // graded, at weight 0 until one does, backed by the Google and Microsoft list guidance and the date mix in decision record 0001.
    "list-marks": "advise",
    "list-parallel": "advise",
    "date-format": "advise",
    // The agent-compact rules and the skill rules ship off until a labeling round measures them;
    // here they run graded, at weight 0 until one does, each backed by the token counts and studies its page cites. None denies
    // while the short skill forms are not yet compressed to the floor.
    "compact-filler": "advise",
    "compact-markup": "advise",
    "compact-costly-abbrev": "advise",
    "compact-symbol-negation": "advise",
    "compact-line": "advise",
    "compact-duplicate": "advise",
    "skill-description-budget": "advise",
    "skill-set-description-budget": "advise",
    "instruction-position": "advise",
};

// MINIMUMS are the grades this repository holds each kind it judges to; proofread ships
// none, and a run over a kind with no minimum exits 2. Each was set on 2026-10-20 at
// 002e91670 to the lowest grade that kind had in the tree, so no text that passed then
// fails, and a raise is a commit with its reason. The texts behind each are in the comment.
final MINIMUMS: {str: int} = {
    // 305 hand-written pages; the lowest, libs/gopherbuzz/docs/codes/BZZ1008.md, grades 82.7
    // on its participles.
    "reference": 82,
    // 49 pages under docs/guides; the lowest, docs/guides/migrating/from-nx.md, grades 92.4.
    "guide": 92,
    // The 6 skills and AGENTS.md files an agent loads; every one grades 100.
    "agent-brief": 100,
    // The 16 shipped skill bodies; every one grades 100.
    "skill-template": 100,
    // 1076 changelog fragments; the lowest, model-tier-first-pass.md, grades 52.3 on a hedge.
    "changelog": 52,
    // The doc comments of 16065 Go and TypeScript declarations; the lowest,
    // docs/src/site/diagram-zoom.ts, grades 69.9 on a filler word.
    "doc-comment": 69,
    // 510 help texts in internal/commands/registry.go; every one grades 100.
    "cli-help": 100,
    // 22 MCP tool and skill descriptions; every one grades 100.
    "tool-description": 100,
    // The last 200 commits on main grade 74.1 at the lowest (claim). 20 is lower, so one
    // finding of the strongest graded rule (subject-mood, 0.80) passes a subject of any
    // length and two fail one under 100 words; libs/proofread/grade_test.go pins both.
    "commit-message": 20,
    // The last 100 merged pull requests: #537 grades 0 on claim and a defect lead.
    "change-description": 0,
    // The 2 issues filed; the lower, #527, grades 95.3.
    "issue": 95,
    // The 4 pull request comments people wrote; every one grades 100.
    "review-reply": 100,
    // No review summary, inline comment or agent reply is kept in this repository's history,
    // so none was measured and none fails on its grade until one is.
    "review-summary": 0,
    "review-inline": 0,
    "agent-reply": 0,
    // docs/src/styles grade 47.1 at the lowest comment, but console's stylesheets were not
    // measured, so none fails on its grade until they are.
    "stylesheet": 0,
};

// DECISIONS_FILE is RULES and MINIMUMS as the JSON file a caller that cannot import this
// module hands proofread: the console's stylesheet lint and the comment guard for a
// stylesheet read from stdin. The root magusfile generates it. It omits PATHS because
// proofread refuses a glob that matches no argument, and a stdin run has none.
export final DECISIONS_FILE = "hack/policy/gen/proofread-decisions.json";

// PATHS are the exemptions by workspace-relative glob, each with its reason. A glob that
// stops matching any file in the tree fails this file's test, so the list only shrinks.
final PATHS: {str: {str: str}} = {
    // A post is one author's account of what they did and think, in their own voice, so
    // neither the reply and tense rules nor the generated-voice rules (signpost to
    // staccato) hold it. Its adjectives are that voice too ("a powerful idea"), so filler
    // only advises. Attribution and the glossary still deny.
    "blog/**": {
        "reply-voice": "off", "tense": "off", "hedge": "off", "signpost": "off", "buzzword": "off",
        "buzzword-weak": "off", "contrast": "off", "vague": "off", "closer": "off", "ing-tail": "off",
        "staccato": "off", "filler": "advise",
    },
};

// table is the decisions file proofread reads, for a run over files: a PATHS entry joins
// only when one of files matches it, since proofread refuses a glob matching no argument.
// Text read from stdin has no files and takes RULES alone.
export fun table(files: [str]) > {str: any} !> any {
    final paths = mut {<str: any>};
    foreach (glob, decisions in PATHS) {
        foreach (file in files) {
            if (path\matches(glob, path: file)) {
                paths[glob] = decisions;
                break;
            }
        }
    }
    final decisions = mut {<str: any>};
    decisions["rules"] = RULES;
    decisions["minimums"] = MINIMUMS;
    if (paths.len() > 0) {
        decisions["paths"] = paths;
    }
    return decisions;
}

// writeDecisions writes table(files) to a new temp file and returns its path, for
// `proofread -decisions`. The caller removes it.
export fun writeDecisions(files: [str]) > str !> any {
    final file = fs\tempFile("proofread-decisions");
    fs\writeFile(file, content: json\stringify(table(files)));
    return file;
}

// decide is the decision this repository gives a finding of rule that a judge outside
// libs/proofread reported as given: RULES wins, as it does for proofread.
export fun decide(rule: str, given: str) > str {
    return RULES[rule] ?? given;
}

test "a path exemption joins only a run whose files it matches" {
    final bare = table([<str>]) catch {<str: any>};
    std\assert(bare["paths"] == null, message: "stdin text takes the rules alone");
    std\assert(bare["rules"] != null, message: "the rules");
    final docs = table(["docs/a.md"]) catch {<str: any>};
    std\assert(docs["paths"] == null, message: "no file under blog/");
    final posts = table(["docs/a.md", "blog/p.md"]) catch {<str: any>};
    std\assert(posts["paths"] != null, message: "a post brings its exemption");
}

test "the decisions file is the table as JSON" {
    final file = writeDecisions(["blog/p.md"]) catch "";
    std\assert(file != "", message: "a file");
    final read: {str: any} = json\parse(fs\readFile(file) catch "\{}") catch {<str: any>};
    std\assert(read["rules"]?["tense"] == "deny", message: "{read}");
    std\assert(read["paths"]?["blog/**"]?["tense"] == "off", message: "{read}");
    std\assert(read["minimums"]?["commit-message"] != null, message: "{read}");
    fs\remove(file) catch void;
}

test "the checked-in decisions file for the Stop hook holds RULES and MINIMUMS" {
    final read: {str: any} = json\parse(fs\readFile(DECISIONS_FILE) catch "\{}") catch {<str: any>};
    final rules: {str: any} = read["rules"] ?? {<str: any>};
    final minimums: {str: any} = read["minimums"] ?? {<str: any>};
    std\assert(read.len() == 2, message: "{DECISIONS_FILE} holds rules and minimums alone: a reply is read from stdin, which no path glob matches");
    std\assert(rules.len() == RULES.len(), message: "{DECISIONS_FILE} lists {rules.len()} rules, RULES {RULES.len()}");
    foreach (rule, decision in RULES) {
        std\assert(rules[rule] == decision, message: "{DECISIONS_FILE}: {rule} is not {decision}");
    }
    std\assert(minimums.len() == MINIMUMS.len(), message: "{DECISIONS_FILE} lists {minimums.len()} minimums, MINIMUMS {MINIMUMS.len()}");
    foreach (kind, minimum in MINIMUMS) {
        std\assert(std\toInt(minimums[kind] ?? -1) == minimum, message: "{DECISIONS_FILE}: the {kind} minimum is not {minimum}");
    }
}

test "the commit-message minimum is the one proofread's short-commit test pins" {
    final source = fs\readFile("libs/proofread/grade_test.go") catch "";
    final pinned = "const commitMessageMinimum = {MINIMUMS["commit-message"] ?? -1}\n";
    std\assert(source.indexOf(pinned) != null, message: "libs/proofread/grade_test.go does not hold `{pinned.trim()}`");
}

test "an outside judge's finding takes this repository's decision" {
    std\assert(decide("attribution", given: "advise") == "deny", message: "the table wins");
    std\assert(decide("my-rule", given: "advise") == "advise", message: "a rule the table leaves keeps its own");
}

test "every path exemption still matches a file in the tree" {
    foreach (glob, decisions in PATHS) {
        final found = fs\glob(glob) catch [<Path>];
        std\assert(found.len() > 0, message: "{glob} matches no file: drop the exemption");
        std\assert(decisions.len() > 0, message: "{glob} exempts nothing");
    }
}
