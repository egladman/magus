// The code-comments rule. proofread (libs/proofread) judges the comments a
// write adds: Go, Buzz or TypeScript by its code-comment kind, a stylesheet by
// its stylesheet kind. A code finding on an added line is denied. The first
// write of a session that adds comments to code is advised once.
namespace agentpolicy\comments;

import "std";
import "proc";
import "magus";
import "encoding/json";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/verdict" as verdict;
import "./libs/proofread/proofread" as proofread;
import "./hack/policy/proofread" as decisions;

final commentAdvice = "This write adds code comments. Audit each one: keep only the comments that say "
    + "what the code cannot, which is why it is written this way, a constraint or invariant it relies "
    + "on, a workaround and what it works around, or a public symbol's contract. Delete the ones that "
    + "narrate the code, restate a name or the next line, or record the change's history, which "
    + "belongs in the commit message. Keep a sentence to 25 words. This is said once per session.";

// A line that opens a comment in the common languages. `#!` is a shebang, not a comment.
final commentLine = $"(?m)^[ \t]*(#([^!]|$)|//|/\*|\* |<!--|-- |;;)";
// A comment after code on the same line.
final trailingComment = $"\S[ \t]+(//|#)[ \t]+\S";
// A line inside a //, /* */ or JSDoc comment block.
final blockLine = $"^[ \t]*(//|/\*|\*)";

// The formats whose `#`, `--` or `//` lines are content rather than comments.
final proseExtensions = [".md", ".markdown", ".mdx", ".txt", ".rst", ".adoc", ".json", ".csv", ".tsv",
    ".log", ".lock", ".svg", ".diff", ".patch"];

final houseStyle = "Comments here follow the repository owner's house style, which `proofread code-comment` "
    + "judges: a comment says only what the code cannot, in short sentences. A trailing comment holds 12 "
    + "words on 1 line, one inside a body 30 words on 3 lines, a doc on an unexported declaration 40 on 4, "
    + "and an exported doc or a file header 60 on 8; blank comment lines, code, tables and URLs count for "
    + "nothing. A sentence holds 25 words. A comment carries no date, pull request number, commit hash or "
    + "incident, no path to docs/design, docs/decisions or a Markdown file, no word in capitals for emphasis, "
    + "no I or we, no banner and no account of what changed. A TODO, FIXME, BUG, compat or Deprecated paragraph "
    + "is never judged. A line the write keeps costs nothing.";

final remedy = "Cut each to the why the code cannot show, in short sentences; a design record belongs in "
    + "the commit message or the docs.";

final preambleRule = "The owner's Go house style keeps nothing above the package clause but what Go "
    + "tooling reads: //go:build, a //go: directive, a generated-code header. A package keeps no "
    + "package comment, in doc.go or anywhere else.";

// houseRules is the house style as a sentence for a verdict.
export fun houseRules() > str {
    return houseStyle;
}

fun fileExtension(path: str) > str {
    final slash = path.split("/");
    final name = slash[slash.len() - 1];
    final parts = name.split(".");
    if (parts.len() < 2) {
        return "";
    }
    return "." + parts[parts.len() - 1].lower();
}

// language is proofread's --language for path, "" for a file it reads no
// comments of.
fun language(path: str) > str {
    final ext = fileExtension(path);
    if (ext == ".go") {
        return "go";
    }
    if (ext == ".buzz") {
        return "buzz";
    }
    if (ext == ".ts" or ext == ".tsx") {
        return "ts";
    }
    return "";
}

// gradesComments reports whether commentProblems grades path's comments.
export fun gradesComments(path: str) > bool {
    return language(path) != "";
}

// addedLines is the text a write adds: the lines of after that before does not hold.
export fun addedLines(before: str, after: str) > str {
    final had = mut {<str: bool>};
    foreach (line in before.split("\n")) {
        had[line] = true;
    }
    final added = mut [<str>];
    foreach (line in after.split("\n")) {
        if (!(had[line] ?? false)) {
            added.append(line);
        }
    }
    return added.join("\n");
}

// hasComment reports whether text holds a comment line or a trailing comment.
export fun hasComment(text: str) > bool {
    return commentLine.match(text) != null or trailingComment.match(text) != null;
}

// Finding is one finding proofread reports over a write's text.
export object Finding {
    rule: str,
    line: int,
    message: str,
}

// JUDGE_FAILED is the rule of a finding that says proofread could not run.
export final JUDGE_FAILED = "judge";

// judgeRunner returns a judge that runs the built proofread over text on
// stdin, under this repository's decisions table. A judge that is missing,
// stale or did not run returns one JUDGE_FAILED finding naming why.
export fun judgeRunner(workspace: str) > fun (args: [str], text: str) > [Finding] {
    final dir = workspace + "/" + proofread\home;
    return fun (args: [str], text: str) > [Finding] {
        final stale = proofread\whyStale(dir);
        if (stale != "") {
            return [unrun("proofread cannot run: {stale}")];
        }
        final bin = "{dir}/{proofread\binary}";
        final run = proc\exec(bin,
            args: args + ["--stdin", "--decisions", workspace + "/" + decisions\DECISIONS_FILE],
            opts: proc\ExecOptions{stdin = text, quiet = true, allowFailure = true}) catch null;
        // Exit 1 is a deny finding, written to stdout like any other.
        if (run == null) {
            return [unrun("proofread did not run: {bin} did not start")];
        }
        if (run!.code != 0 and run!.code != 1) {
            return [unrun("proofread did not run: {bin} exited {run!.code}: {run!.stderr.trim()}")];
        }
        return parseFindings(run!.stdout);
    };
}

fun unrun(why: str) > Finding {
    return Finding{ rule = JUDGE_FAILED, line = 0, message = "{why}; run `{proofread\build}`, then retry" };
}

// parseFindings reads proofread's findings, whose source is `<kind>:<line>`.
export fun parseFindings(stdout: str) > [Finding] {
    final rows: [any] = json\parse(stdout) catch [<any>];
    final found = mut [<Finding>];
    foreach (r in rows) {
        final source: str = r["source"] ?? "";
        final colon = source.indexOf(":");
        var line = 0;
        if (colon != null) {
            line = std\parseInt(source.sub(colon! + 1)) ?? 0;
        }
        found.append(Finding{ rule = r["rule"] ?? "", line = line, message = r["message"] ?? "" });
    }
    return found;
}

// judgeFailure is the message of the first JUDGE_FAILED finding, or "".
fun judgeFailure(found: [Finding]) > str {
    foreach (f in found) {
        if (f.rule == JUDGE_FAILED) {
            return f.message;
        }
    }
    return "";
}

// touches reports whether a finding at line speaks of an added line. A
// budget speaks of the block opening there; any other rule, of its line.
fun touches(lines: [str], f: Finding, had: {str: bool}) > bool {
    var i = f.line - 1;
    while (i >= 0 and i < lines.len()) {
        if (!(had[lines[i]] ?? false)) {
            return true;
        }
        if (f.rule != "code-comment-budget") {
            return false;
        }
        i = i + 1;
        if (i >= lines.len() or blockLine.match(lines[i]) == null) {
            return false;
        }
    }
    return false;
}

// preambleProblems names the comment lines a write adds above a Go file's
// package clause.
fun preambleProblems(path: str, before: str, after: str) > [str] {
    if (language(path) != "go") {
        return [<str>];
    }
    final had = mut {<str: bool>};
    foreach (line in before.split("\n")) {
        had[line] = true;
    }
    var added = 0;
    var first = 0;
    foreach (i, line in after.split("\n")) {
        final t = line.trim();
        if (t.startsWith("package ")) {
            break;
        }
        final tooling = t.startsWith("//go:") or t.startsWith("// +build") or t.startsWith("// Code generated ");
        if (t.startsWith("//") and !tooling and !(had[line] ?? false)) {
            added = added + 1;
            if (first == 0) {
                first = i + 1;
            }
        }
    }
    if (added == 0) {
        return [<str>];
    }
    return ["{path}:{first}: {added} comment lines above the package clause. " + preambleRule + " Delete them."];
}

// judgeCode lists what the comments a write adds to code break, path:line
// first. Only a finding on a comment the write adds counts. A judge that could
// not run is one problem naming why.
export fun judgeCode(path: str, before: str, after: str, judge: fun (args: [str], text: str) > [Finding]) > [str] {
    final lang = language(path);
    if (lang == "") {
        return [<str>];
    }
    final added = addedLines(before, after: after);
    if (added == "" or !hasComment(added)) {
        return [<str>];
    }
    final found = mut [<str>];
    foreach (p in preambleProblems(path, before: before, after: after)) {
        found.append(p);
    }
    final judged = judge(["code-comment", "--language", lang], after);
    final failed = judgeFailure(judged);
    if (failed != "") {
        found.append("{path}: the comment judge could not run: {failed}");
        return found;
    }
    final had = mut {<str: bool>};
    foreach (line in before.split("\n")) {
        had[line] = true;
    }
    final lines = after.split("\n");
    foreach (f in judged) {
        if (touches(lines, f: f, had: had)) {
            found.append("{path}:{f.line}: {f.message} [{f.rule}]");
        }
    }
    return found;
}

// commentProblems is judgeCode with this checkout's built proofread, for a
// caller running at the workspace root.
export fun commentProblems(path: str, before: str, after: str) > [str] {
    return judgeCode(path, before: before, after: after, judge: judgeRunner("."));
}

// decideCode denies a write whose comments proofread refuses, naming each
// problem. The house style goes with a session's first denial only.
export fun decideCode(path: str, before: str, after: str, once: fun (key: str) > bool, judge: fun (args: [str], text: str) > [Finding]) > GuardVerdict {
    final found = judgeCode(path, before: before, after: after, judge: judge);
    if (found.len() == 0) {
        return magus\guard.defer();
    }
    final style = if (once("comment-house-style")) houseStyle + "\n\n" else "";
    return magus\guard.deny(verdict\opening("a comment breaks the house style", problem: found[0]) + "\n"
        + style + found.join("\n") + "\n\n" + remedy);
}

// A CSS comment over this many times its budget is refused.
final denyFactor = 2;

// The most lines a CSS comment may span before the write is refused: twice
// the budget of a header, the largest a comment here earns.
final cssFileBudget = 8;

final cssStyle = "CSS comments meet the same prose rules as Go ones: a comment says only what the code "
    + "cannot, in a few lines. Budget: {cssFileBudget} lines heading a file, 4 above a rule, 3 above a "
    + "declaration or between rules, 2 after a declaration, and a block's comments sum to a budget its "
    + "size earns. A comment is also refused for repeating the code beside it, narrating a change, a "
    + "banned word, or the writing rules of docs/conventions.md.";

// longestAddedCssComment is the line count of the longest `/* */` comment of
// after whose opening line before did not hold.
export fun longestAddedCssComment(before: str, after: str) > int {
    final had = mut {<str: bool>};
    foreach (line in before.split("\n")) {
        had[line.trim()] = true;
    }
    var longest = 0;
    var run = 0;
    var fresh = false;
    var open = false;
    foreach (line in after.split("\n")) {
        final t = line.trim();
        var rest = t;
        if (!open) {
            final at = t.indexOf("/*");
            if (at == null) {
                continue;
            }
            open = true;
            run = 0;
            fresh = !(had[t] ?? false);
            rest = t.sub(at! + 2);
        }
        run = run + 1;
        if (rest.indexOf("*/") != null) {
            open = false;
            if (fresh and run > longest) {
                longest = run;
            }
        }
    }
    return longest;
}

// decideCss judges a stylesheet write that adds a comment. One over twice
// the largest budget is refused. A proofread finding on an added line is
// advised; a judge that could not run denies.
export fun decideCss(path: str, before: str, after: str, once: fun (key: str) > bool, judge: fun (args: [str], text: str) > [Finding]) > GuardVerdict {
    final added = addedLines(before, after: after);
    if (added == "" or !hasComment(added)) {
        return magus\guard.defer();
    }
    final longest = longestAddedCssComment(before, after: after);
    if (longest > denyFactor * cssFileBudget) {
        return magus\guard.deny("a CSS comment runs {longest} lines against a budget of at most {cssFileBudget}\n"
            + "The write is to {path}. " + cssStyle + "\n\n" + remedy);
    }
    final found = judge(["stylesheet"], after);
    final failed = judgeFailure(found);
    if (failed != "") {
        return magus\guard.deny("the CSS comment judge could not run: {failed}\n"
            + "The write to {path} adds a comment, and no rule judged it.");
    }
    final had = mut {<str: bool>};
    foreach (line in before.split("\n")) {
        had[line.trim()] = true;
    }
    final lines = after.split("\n");
    final reasons = mut [<str>];
    foreach (f in found) {
        if (f.line < 1 or f.line > lines.len()) {
            continue;
        }
        if (had[lines[f.line - 1].trim()] ?? false) {
            continue;
        }
        reasons.append("{path}:{f.line}: {f.message} [{f.rule}]");
    }
    if (reasons.len() > 0) {
        return magus\guard.advise(cssStyle + "\n\n" + reasons.join("\n") + "\n\n" + remedy);
    }
    if (once("code-comments")) {
        return magus\guard.advise(commentAdvice);
    }
    return magus\guard.defer();
}

// decideWrite grades a write: a stylesheet by decideCss, Go, Buzz and
// TypeScript by decideCode. Any other code write adding comments is advised
// once per session.
export fun decideWrite(path: str, before: str, after: str, once: fun (key: str) > bool, judge: fun (args: [str], text: str) > [Finding]) > GuardVerdict {
    if (fileExtension(path) == ".css") {
        return decideCss(path, before: before, after: after, once: once, judge: judge);
    }
    if (proseExtensions.indexOf(fileExtension(path)) != null) {
        return magus\guard.defer();
    }
    final graded = decideCode(path, before: before, after: after, once: once, judge: judge);
    if (graded.decision != magus\GuardDecision.defer) {
        return graded;
    }
    final added = addedLines(before, after: after);
    if (added == "" or !hasComment(added)) {
        return magus\guard.defer();
    }
    if (once("code-comments")) {
        return magus\guard.advise(commentAdvice);
    }
    return magus\guard.defer();
}

fun spent() > fun (key: str) > bool {
    final once = helpers\counter();
    _ = once("code-comments");
    return once;
}

fun noJudge() > fun (args: [str], text: str) > [Finding] {
    return fun (args: [str], text: str) > [Finding] => [<Finding>];
}

// judgeSays reports rule on line, and records the args it was run with.
fun judgeSays(rule: str, line: int, ran: mut [str]) > fun (args: [str], text: str) > [Finding] {
    return fun (args: [str], text: str) > [Finding] {
        ran.append(args.join(" "));
        return [Finding{ rule = rule, line = line, message = "said" }];
    };
}

test "a write that adds a comment to code is advised once per session" {
    final once = helpers\counter();
    final v = decideWrite("/w/internal/cache/key.go", before: "", after: "package cache\n\n// keyOf hashes the inputs.\nfunc keyOf() \{}", once: once, judge: noJudge());
    std\assert(v.decision == magus\GuardDecision.advise, message: "the first");
    std\assert(v.reason.indexOf("keep only the comments that say what the code cannot") != null, message: "states the rule");
    std\assert(v.reason.indexOf("Keep a sentence to 25 words") != null, message: "states the limit");
    std\assert(decideWrite("/w/a.go", before: "", after: "package a\n// again", once: once, judge: noJudge()).decision == magus\GuardDecision.defer, message: "only once");
}

test "a code finding on an added line is denied, with the language proofread reads" {
    final ran = mut [<str>];
    final after = "package p\n\n// f does it on 2026-09-04.\nfunc f() \{}\n";
    final v = decideWrite("/w/p.go", before: "", after: after, once: spent(), judge: judgeSays("provenance", line: 3, ran: ran));
    std\assert(v.decision == magus\GuardDecision.deny, message: "{v.decision}");
    std\assert(v.reason.indexOf("/w/p.go:3: said [provenance]") != null, message: v.reason);
    std\assert(ran.len() == 1 and ran[0] == "code-comment --language go", message: "{ran}");
}

test "a finding on a comment the write keeps costs nothing" {
    final ran = mut [<str>];
    final before = "package p\n\n// f is old and long.\nfunc f() \{}\n";
    final after = before + "\n// g is new.\nfunc g() \{}\n";
    final v = decideWrite("/w/p.go", before: before, after: after, once: spent(), judge: judgeSays("code-comment-budget", line: 3, ran: ran));
    std\assert(v.decision == magus\GuardDecision.defer, message: "{v.decision}: {v.reason}");
}

test "a block the write grows is judged at the line it opens on" {
    final ran = mut [<str>];
    final before = "package p\n\n// f is old.\nfunc f() \{}\n";
    final after = "package p\n\n// f is old.\n// It grew a second line.\nfunc f() \{}\n";
    final v = decideWrite("/w/p.go", before: before, after: after, once: spent(), judge: judgeSays("code-comment-budget", line: 3, ran: ran));
    std\assert(v.decision == magus\GuardDecision.deny, message: "{v.decision}");
}

test "a line finding speaks of its own line alone" {
    final ran = mut [<str>];
    final before = "package p\n\n// f is old.\nfunc f() \{}\n";
    final after = "package p\n\n// f is old.\n// It grew a second line.\nfunc f() \{}\n";
    final v = decideWrite("/w/p.go", before: before, after: after, once: spent(), judge: judgeSays("provenance", line: 3, ran: ran));
    std\assert(v.decision == magus\GuardDecision.defer, message: "{v.decision}: {v.reason}");
}

test "a Buzz or TypeScript write is judged in its own language" {
    final ran = mut [<str>];
    _ = decideWrite("/w/a.buzz", before: "", after: "// x.\nfun f() > void \{}\n", once: spent(), judge: judgeSays("banner", line: 9, ran: ran));
    _ = decideWrite("/w/a.tsx", before: "", after: "// x.\nexport const a = 1;\n", once: spent(), judge: judgeSays("banner", line: 9, ran: ran));
    std\assert(ran.len() == 2 and ran[0] == "code-comment --language buzz" and ran[1] == "code-comment --language ts", message: "{ran}");
}

test "a judge that cannot run denies a code write that adds a comment" {
    final failing = fun (args: [str], text: str) > [Finding] => [unrun("proofread cannot run: not built")];
    final v = decideWrite("/w/p.go", before: "", after: "package p\n\n// f.\nfunc f() \{}\n", once: spent(), judge: failing);
    std\assert(v.decision == magus\GuardDecision.deny, message: "{v.decision}");
    std\assert(v.reason.indexOf("could not run") != null, message: v.reason);
}

test "a comment above the package clause is denied, a directive is not" {
    final v = decideWrite("/w/p.go", before: "", after: "// Package p does things.\npackage p\n", once: spent(), judge: noJudge());
    std\assert(v.decision == magus\GuardDecision.deny, message: "{v.decision}");
    std\assert(v.reason.indexOf("above the package clause") != null, message: v.reason);
    std\assert(preambleProblems("/w/p.go", before: "", after: "//go:build linux\n\npackage p\n").len() == 0, message: "a build tag is tooling");
}

test "a prose file and a file with no added comment are never judged" {
    final ran = mut [<str>];
    final judge = judgeSays("banner", line: 1, ran: ran);
    std\assert(decideWrite("/w/README.md", before: "", after: "// a\n", once: spent(), judge: judge).decision == magus\GuardDecision.defer, message: "prose");
    std\assert(decideWrite("/w/p.go", before: "", after: "package p\n", once: spent(), judge: judge).decision == magus\GuardDecision.defer, message: "no comment");
    std\assert(ran.len() == 0, message: "{ran}");
}

test "a stylesheet finding on an added line is advised, a judge failure denied" {
    final ran = mut [<str>];
    final after = "/* One. */\n.a \{ color: red; }\n";
    final v = decideWrite("/w/a.css", before: "", after: after, once: spent(), judge: judgeSays("restates", line: 1, ran: ran));
    std\assert(v.decision == magus\GuardDecision.advise, message: "{v.decision}");
    std\assert(ran.len() == 1 and ran[0] == "stylesheet", message: "{ran}");
    final failing = fun (args: [str], text: str) > [Finding] => [unrun("not built")];
    std\assert(decideWrite("/w/a.css", before: "", after: after, once: spent(), judge: failing).decision == magus\GuardDecision.deny, message: "a failed judge");
}

test "proofread's findings parse to their source line" {
    final found = parseFindings(`[{"source":"code-comment:12","rule":"banner","message":"m"}]`);
    std\assert(found.len() == 1 and found[0].line == 12 and found[0].rule == "banner", message: "{found.len()}");
}
