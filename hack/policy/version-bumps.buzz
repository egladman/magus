// The version-bump rule: a branch bumps each schema or format counter once.
// Every bump restamps what the counter stamps and invalidates every store
// written at the old value. A second bump on one branch costs every reader
// again. No one outside the branch read the value in between.
namespace agentpolicy\versions;

import "std";
import "fs";
import "vcs";
import "magus";
import "./hack/policy/verdict" as verdict;

export object Counter {
    name: str,
    file: str,
    declaration: str,
}

// counters are the hand-maintained version counters, each found by the line in file that
// starts with declaration. A counter missing here is not guarded.
export final counters = [
    Counter{ name = "skill-stamp-format", file = "internal/agent/catalog.go", declaration = "const skillStampFormat types.APIVersion = " },
    Counter{ name = "guard-template-version", file = "internal/agent/guard.go", declaration = "const GuardTemplateVersion = " },
    Counter{ name = "guard-schema-version", file = "internal/agent/guard.go", declaration = "const GuardAPIVersion = " },
    Counter{ name = "agent-session-schema-version", file = "internal/agent/session.go", declaration = "const SessionAPIVersion types.APIVersion = " },
