    Counter{ name = "job-result-schema-version", file = "types/job.go", declaration = "const JobResultAPIVersion APIVersion = " },
    Counter{ name = "event-schema-version", file = "types/event.go", declaration = "const EventAPIVersion APIVersion = " },
    Counter{ name = "stored-output-schema-version", file = "types/output_record.go", declaration = "const StoredOutputAPIVersion APIVersion = " },
    Counter{ name = "sessions-schema-version", file = "internal/sessions/sessions.go", declaration = "const APIVersion types.APIVersion = " },
    Counter{ name = "goindex-format-version", file = "internal/symbols/goindex/goindex.go", declaration = "const formatVersion = " },
    Counter{ name = "auth-store-version", file = "internal/auth/store.go", declaration = "const storeVersion types.APIVersion = " },
    Counter{ name = "trail-command-schema-version", file = "internal/trail/trail.go", declaration = "const agentCommandAPIVersion types.APIVersion = " },
    Counter{ name = "trail-spawn-schema-version", file = "internal/trail/trail.go", declaration = "const agentSpawnAPIVersion types.APIVersion = " },
    Counter{ name = "project-cache-schema-version", file = "project/cache.go", declaration = "const cacheAPIVersion types.APIVersion = " },
    Counter{ name = "owed-schema-version", file = "vcs/owed.go", declaration = "const owedAPIVersion types.APIVersion = " },
    Counter{ name = "release-index-version", file = "internal/selfupdate/selfupdate.go", declaration = "const IndexAPIVersion types.APIVersion = " },
