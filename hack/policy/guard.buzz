// This repository's rules for the coding agents that work on it, registered from the root
// magusfile with magus\guard.command, magus\guard.spawn and magus\guard.write. They are this
// repository's preference, not a magus default: nothing here is compiled into or shipped
// with magus. Copy them as a reference for your own repository's policy.
//
// Edits apply at once when they tighten a rule. A loosening waits until it is committed,
// because the guard runs the committed copy of these files beside the working tree's and keeps
// the stricter answer.
//
// Rules, each keyed on facts the guard hands over (parsed programs, titles, paths), never
// on prose:
//   ci-watch (deny): a gh invocation that blocks until CI or the merge queue finishes.
//   ci-batch-poll (advise once per session): CI status summaries,
//     not failure artifacts.
//   ci-log-read (advise once per session): prefer artifacts, leaving raw job diagnostics available.
//   queue-poll (advise once per session): the merge queue's state read through GitHub.
//   admin-merge (deny): `gh pr merge --admin`, which lands a pull request past the queue.
//   pr-watch (deny): a pull request's own state (merged, auto-merge, mergeability) read
//     again and again, which the host's PR monitor reports as it changes.
//   auto-merge (deny): `gh pr merge --auto`, or a `gh api` call naming the
//     enablePullRequestAutoMerge mutation. A person enables auto-merge; disabling it and
//     reading it stay open.
//   worker-runs-gate (deny): the gate run by a subagent that is not the checkout's integrator.
//   detached-push-unqualified (deny): `git push <remote> HEAD:<name>` from a detached HEAD
//     to a branch the checkout does not know the remote has.
//   push-authority (deny): a push or `gh pr create` by any caller but the main session, and
//     by one the host reported no session for.
//   unplaced-call (deny): a push, pull request call or relink after a cd magus
//     cannot follow, which the other rules would judge in the wrong checkout.
//   branch-name (deny, or advise on a topic miss alone): a pushed branch or bookmark, or a
//     pull request's head, that is not a short topic of lowercase words.
//   foreign-binary (deny): a magus binary built in one checkout of magus run against another.
//   go-into-checkout (deny): `go -C` into another checkout of magus, the bootstrap aside.
//   worker-builds-magus (deny): a caller holding a worker lease compiling magus (`go run`,
//     `go build` or `go install` of cmd/magus, or `magus run go-build` / `build` of the root
//     project), the bootstrap included. The checkout's integrator builds ./magus once per base
//     commit and hack/dev/bootstrap-worktree.buzz places it; the integrator and a person build,
//     and no worker does: no job row pins its build.
//   brief-builds-magus (deny, spawn): a spawn brief that tells its worker to compile magus. A
//     line that names the command only to forbid it ("never ...") is not graded, and an
//     integrate spawn's brief is not either.
//   worker-bootstrap (deny): the bootstrap run by any subagent but the checkout's integrator;
//     a worker is placed ./magus instead, and foreign-binary lets the placement script through.
//   stale-binary (advise once per state): the ./magus answering this hook was built from
//     sources that have since moved, by the stamp go-build links into it.
//   stale-write (deny): a magus verb that writes state other checkouts or magus versions
//     read (init, server start, config set, agent install, agent harness install)
//     run by a ./magus stale-binary judges stale, or, for state outside the checkout, by one
//     whose stamped commit is not on the base branch.
//   spawn-without-job-row (deny, spawn): a spawn whose `<parent>/<role> <job>` title names no
//     live job row the spawner may hand out; an unreadable job store advises instead.
//   change-role-spawn-not-isolated (deny, spawn): a code-changing worker sharing a checkout.
//   commit-subject (deny): a message recorded with -m by git, hg or sl commit, or jj commit
//     or describe, that carries an attribution or a body, or whose subject breaks the form
//     its branch takes: the conventional subject hack/magusfile/commits.buzz defines on the base
//     branch, one lowercase imperative line anywhere else.
//   pull-request-text (deny, named): a pull request title, description or review reply,
//     posted by any forge command its table lists, with a finding proofread in
//     libs/proofread decides deny under hack/policy/proofread.buzz, a description past
//     the word budget its diff earns after the lead, or a title the pr-title check would
//     fail. Advise findings, prose outside the lead, bullets and headed sections, and an
//     area the diff touches that the description never names are advised once per pull
//     request.
//   code-comments (write): a Go comment block the write adds over the owner's budget is
//     advised, over twice it or above the package clause denied; the first write of a
//     session adding comments to any code file is advised once.
//   host-capture (deny): cat, sed, rg, grep, head or tail of a run log or a task
//     capture. The compiled rule only advises a filter of those files.
//   host-terminals (deny): creating or reading a directory named terminals. A host
//     session folder is not a run; magus server status reads the lock.
//   host-cursor-rules (deny, write): a .mdc file written under a .cursor/rules directory.
//     This repository delivers Cursor guidance through hooks and skills.
//   sealed-read (deny): a line that reads, lists, copies or searches the sealed proofread
//     sets under $XDG_CACHE_HOME/proofread/calibration/sealed, however it spells the path.
//     The labels beside them stay open.
//   version-bump-once (deny, write): an edit that changes a schema or format counter this
//     branch already changed against its merge base; the first bump, and a return to the
//     base value, pass.
//
// Each rule lives beside its tests in the file named for what it guards: gh.buzz (the
// GitHub calls), cadence.buzz (the gate and the push), branches.buzz (push-authority and
// branch-name), binaries.buzz (foreign-binary and
// go-into-checkout, with worker-builds-magus run first), builds.buzz (what counts as compiling
// magus, and both build rules), stale.buzz, spawn.buzz (brief-builds-magus runs there),
// commits.buzz, pull_requests.buzz,
// comments.buzz, host.buzz (a run log, and a directory named terminals), sealed.buzz and
// version-bumps.buzz.
// helpers.buzz holds the argv parsing they share. Imports are root-relative because `magus buzz -t` resolves an entry
// file's imports against the working directory, not the file. An alias the root magusfile
// already binds (github, changelog) shadows the one here, so these avoid them.
namespace agentpolicy;

import "std";
import "magus";
import "fs";
import "vcs";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/verdict" as verdict;
import "./hack/policy/gh" as gh;
import "./hack/policy/cadence" as cadence;
import "./hack/policy/binaries" as binaries;
import "./hack/policy/builds" as builds;
import "./hack/policy/stale" as stale;
import "./hack/policy/spawn" as spawn;
import "./hack/policy/commits" as subjects;
import "./hack/policy/pull_requests" as pullRequests;
import "./hack/policy/comments" as comments;
import "./hack/policy/host" as host;
import "./hack/policy/sealed" as sealed;
import "./hack/policy/branches" as branches;
import "./hack/policy/mandate" as mandate;
import "./hack/policy/version-bumps" as versions;
import "./hack/magusfile/commits" as conventional;

// noForge is a verb that recognizes no command as opening a pull request.
fun noForge(argv: [str]) > {str: str}? {
    return null;
}

// refusedEarly is the first refusal of the sealed, delivery and mandate rules,
// or null when all three allow req.
fun refusedEarly(req: CommandRequest, programs: [helpers\Program], opens: fun (argv: [str]) > {str: str}?) > GuardVerdict? {
    final held = sealed\decideSealed(programs, line: req.command, roots: sealed\rootsFromEnv());
    if (held.decision != magus\GuardDecision.allow) {
        return held;
    }
    var lease: pullRequests\Delivered? = null;
    if (req.lease -> row) {
        lease = pullRequests\Delivered{ id = row.id, delivery = row.delivery, parentHead = row.parentHead };
    }
    final delivered = pullRequests\decideDelivery(programs, lease: lease, opens: opens);
    if (delivered.decision != magus\GuardDecision.allow) {
        return delivered;
    }
    final kept = mandateVerdict(req, programs: programs);
    if (kept.decision != magus\GuardDecision.allow) {
        return kept;
    }
    return null;
}

// forkVerdict is the fork limit's answer for req's line. Workers and the root
// both reach it, because every agent shell command passes through judge.
fun forkVerdict(req: CommandRequest, programs: [helpers\Program]) > GuardVerdict {
    final read = fun (path: str) > str {
        final file = if (path.startsWith("/")) path else "{req.dir}/{path}";
        return fs\readFile(file) catch "";
    };
    final facts = fun () > spawn\ForkCounts {
        return forkCounts(req.workspace);
    };
    return spawn\decideForkLine(programs, line: req.command, read: read, facts: facts, limit: spawn\finishedBranchLimit);
}

// forkCounts is magus\workspace().forkFacts() for the fork rule.
// A failed read leaves
// both counts unknown, which refuses nothing.
fun forkCounts(workspace: str) > spawn\ForkCounts {
    try {
        return countsFrom(magus\workspace(workspace).forkFacts());
    } catch (e) {
        final why = errorText(e);
        return spawn\ForkCounts{ branchesUnknown = why, testUnknown = why };
    }
}

fun countsFrom(facts: JobForkFacts) > spawn\ForkCounts {
    return spawn\ForkCounts{
        finishedBranches = facts.finishedBranches,
        branchesUnknown = facts.branchesUnknown,
        integrateRecord = facts.integrateRecord,
        commitsSinceTest = facts.commitsSinceTest,
        lastTest = "{facts.lastTestRef} at {facts.lastTestRevision}",
        testUnknown = facts.testUnknown,
    };
}

test "the fork counts read every fact the host hands over" {
    final counts = countsFrom(JobForkFacts{
        finishedBranches = ["done (job done, 1 commit(s))"],
        integrateRecord = "\{\}",
        commitsSinceTest = 4,
        lastTestRef = "out1",
        lastTestRevision = "abc",
    });
    std\assert(counts.finishedBranches.len() == 1 and counts.commitsSinceTest == 4, message: "counts");
    std\assert(counts.lastTest == "out1 at abc" and counts.testUnknown == "", message: counts.lastTest);
}

// judge is the command rule the root magusfile registers. opens is the
// pull request verb the delivery rule reads.
export fun judge(req: CommandRequest, opens: fun (argv: [str]) > {str: str}?) > GuardVerdict {
    if (req.unplaced) {
        return magus\guard.deny(unplacedDenial);
    }
    final programs = parsePrograms(req);
    if (refusedEarly(req, programs: programs, opens: opens) -> refused) {
        return refused;
    }
    final forked = forkVerdict(req, programs: programs);
    if (forked.decision == magus\GuardDecision.deny) {
        return forked;
    }
    final denial = binariesDenial(req, programs: programs);
    if (denial != "") {
        return magus\guard.deny(denial);
    }
    final hook = fun () > stale\HookBinary {
        return stale\hookBinary(req.workspace);
    };
    final write = stale\decideStateWrite(programs, bin: hook, onBase: stale\onBase(req.workspace));
    if (write.decision != magus\GuardDecision.allow) {
        return write;
    }
    var checkout: cadence\Checkout? = null;
    var baseBranch = "";
    if (req.checkout != null) {
        checkout = cadence\Checkout{ detached = req.checkout!.branch == "", remoteBranches = req.checkout!.remoteBranches };
        if (conventional\onBase(req.checkout!.branch, base: req.checkout!.base)) {
            baseBranch = req.checkout!.branch;
        }
    }
    final once = fun (key: str) > bool {
        return magus\guard.once(key);
    };
    final commented = pullRequests\decideCommitComments(programs, read: pullRequests\committedReader(req.dir));
    if (commented.decision != magus\GuardDecision.allow) {
        return commented;
    }
    final pusher = requestPusher(req);
    final topic = fun (source: str) > branches\Topic {
        return branchTopic(req.dir, source: source);
    };
    final texts = withHeredocs(programs, line: req.command);
    final decided = decide(texts, caller: cadence\Caller{ role = req.role, title = req.parent, holdsCheckout = cadence\gatesInHeldCheckout(req.lease, programs: programs, dir: req.dir, workspace: req.workspace) }, checkout: checkout,
        baseBranch: baseBranch, line: req.command, files: bodyFiles(texts, dir: req.dir),
        diff: pullRequests\pullRequestDiff(req.workspace), judge: pullRequests\judgeRunner(req.workspace), once: once,
        publishing: Publishing{ pusher = pusher, current = currentBranch(req), remote = requestRemote(req), topic = topic },
        reads: host\readsFrom(req.workspace, dir: req.dir));
    return lastWord(req, programs: programs, decided: decided, forked: forked, once: once);
}

// lastWord is judge's answer once nothing denied: another rule's verdict, then
// the fork rule's note, then the stale binary's advice.
fun lastWord(req: CommandRequest, programs: [helpers\Program], decided: GuardVerdict, forked: GuardVerdict, once: fun (key: str) > bool) > GuardVerdict {
    if (decided.decision != magus\GuardDecision.allow) {
        return decided;
    }
    if (forked.decision != magus\GuardDecision.allow) {
        return forked;
    }
    if (stale\rebuilds(programs)) {
        return decided;
    }
    return stale\decideStale(stale\hookBinary(req.workspace), once: once);
}

// unplacedDenial refuses a line magus would judge in the wrong checkout.
final unplacedDenial = "this line's push, pull request or relink runs where only running it shows, so it cannot be judged; spell the directory as a literal path\n"
    + "A `cd` to a variable or substitution leaves the rules reading the checkout the line starts in. "
    + "Name the checkout outright (`cd /abs/checkout && ...` or `git -C /abs/checkout push ...`), then run the line again.";

test "a push that only running the line can place is refused, naming the fix" {
    final push = CommandInvocation{ program = "git", args = ["push", "origin", "HEAD:x"],
        vcs = VCSInvocation{ tool = "git", subcommand = "push", args = ["origin", "HEAD:x"] } };
    final unplaced = judge(CommandRequest{ session = "s1", role = magus\AgentRole.root, unplaced = true, commands = [push] }, opens: noForge);
    std\assert(unplaced.decision == magus\GuardDecision.deny and unplaced.reason == unplacedDenial, message: unplaced.reason);
    verdict\assertVerdict(unplaced.reason, label: "an unplaced push");
}

// binariesDenial is the binaries rule's answer for req's programs, "" when it allows them.
fun binariesDenial(req: CommandRequest, programs: [helpers\Program]) > str {
    var lease = "";
    var leaseRoot = "";
    if (req.lease != null) {
        lease = req.lease!.id;
        final tree = req.lease!.worktree;
        if (tree != null and tree!.removed == 0) { leaseRoot = tree!.root; }
    }
    final integrator = req.role == magus\AgentRole.integrator;
    return binaries\decideBinaries(programs, where: binaries\Where{ dir = req.dir, workspace = req.workspace, lease = lease, integrator = integrator, owned = req.ownedCheckouts, leaseRoot = leaseRoot }, disk: binaries\onDisk(),
        worker: !integrator and (req.role == magus\AgentRole.worker or req.parent != "" or req.agent != ""));
}

// mandateVerdict is the mandate's answer for req's line (ADR 0019). The job store is read
// only while a mandate is in force, since nothing else it judges needs it.
fun mandateVerdict(req: CommandRequest, programs: [helpers\Program]) > GuardVerdict {
    final issued = mandate\loadMandate(req.workspace);
    final now = mandate\now();
    var jobs = [<mandate\Row>];
    if (mandate\inForce(issued, now: now)) {
        jobs = mandate\rows(magus\workspace().jobs() catch JobList{});
    }
    final store = jobs;
    final assess = fun (id: str) > mandate\Assessed {
        return mandate\assess(id, jobs: store, measure: mandate\measured, count: mandate\counted);
    };
    return mandate\decideCommand(programs, line: req.command, m: issued, jobs: jobs, now: now, assess: assess);
}

// judgeStop is the stop rule the root magusfile registers: the mandate's idle-stop rule
// (ADR 0019 section 5) over the job store, counting refusals per session.
export fun judgeStop(req: StopRequest) > GuardVerdict !> any {
    if (req.workspace == "") {
        return magus\guard.allow();
    }
    final list = magus\workspace().jobs() catch JobList{};
    final blocked = mut [<str>];
    foreach (b in list.blocked) {
        blocked.append(b.job);
    }
    var unmerged = JobUnmergedReport{};
    if (req.role.value == "root") {
        try {
            unmerged = magus\workspace(req.workspace).unmerged();
        } catch (e: any) {
            unmerged = JobUnmergedReport{ unknown = "magus\\workspace().unmerged raised: {e}" };
        }
    }
    final count = fun (key: str) > int {
        return magus\guard.count(key);
    };
    final now = mandate\now();
    final file = fun (rows: [str]) > void {
        mandate\fileAttention(req.workspace, rows: rows, now: now);
    };
    return mandate\decideStop(mandate\StopFacts{ role = req.role.value, stopHookActive = req.stopHookActive, running = mandate\runningTries(list.attempts) },
        q: mandate\Queue{ jobs = mandate\rows(list), blocked = blocked, unmerged = unmerged }, m: mandate\loadMandate(req.workspace), now: now, count: count, file: file);
}

fun parsePrograms(req: CommandRequest) > [helpers\Program] {
    final programs = mut [<helpers\Program>];
    foreach (c in req.commands) {
        var call: helpers\VcsCall? = null;
        if (c.vcs != null) {
            call = helpers\VcsCall{ tool = c.vcs!.tool, subcommand = c.vcs!.subcommand, args = c.vcs!.args };
        }
        programs.append(helpers\Program{ name = c.program, args = c.args, repeats = c.repeats, path = c.path, vcs = call });
    }
    return programs;
}

// requestPusher is the caller as the guard recorded it. agent is the host's subagent id, which
// marks a subagent magus never saw spawned and that holds no lease: its session is the
// main session's, so nothing else tells the two apart.
fun requestPusher(req: CommandRequest) > branches\Pusher {
    var lease = "";
    if (req.lease != null) {
        lease = req.lease!.id;
    }
    return branches\Pusher{ role = req.role, title = req.parent, session = req.session, lease = lease, agent = req.agent };
}

// Publishing is what the publishing rules read about a line: who runs it, the branch or
// bookmark its checkout is on, what the checkout knows of the remote, and the topic of the
// branch's diff, read only when a name is judged.
export object Publishing {
    pusher: branches\Pusher,
    current: str,
    remote: branches\Remote,
    topic: fun (source: str) > branches\Topic,
}

// currentBranch is the branch or bookmark the guard read for a push, else the one the
// caller's checkout is on, "" when neither names one.
fun currentBranch(req: CommandRequest) > str {
    if (req.checkout != null) {
        return req.checkout!.branch;
    }
    return (vcs\ref(dir: req.dir) catch null) ?? "";
}

fun requestRemote(req: CommandRequest) > branches\Remote {
    if (req.checkout != null) {
        return branches\Remote{ base = req.checkout!.base, branches = req.checkout!.remoteBranches };
    }
    final base = vcs\base(dir: req.dir) catch null;
    if (base == null) {
        return branches\Remote{ base = "", branches = [<str>], unreadable = "the base ref of the checkout at `{req.dir}` cannot be resolved" };
    }
    return branches\Remote{ base = base!, branches = [<str>] };
}

// branchTopic is the topic of what a push publishes: source against base.
// An empty source is dir's HEAD. A diff it cannot read is no topic.
fun branchTopic(dir: str, source: str) > branches\Topic {
    final paths = mut [<str>];
    try {
        if (source == "") {
            foreach (p in vcs\changedFiles(dir: dir)) {
                paths.append(p.value);
            }
        } else {
            final diff = vcs\cmd(["diff", "--name-only", vcs\base(dir: dir) + "..." + source], opts: vcs\CommandOptions{ dir = dir, quiet = true });
            foreach (line in diff.stdout.split("\n")) {
                if (line.trim() != "") {
                    paths.append(line.trim());
                }
            }
        }
    } catch (e) {
        return branches\unknownTopic();
    }
    return branches\withSubjects(branches\readTopic(paths), subjects: branchSubjects(dir, paths: paths, source: source));
}

// branchSubjects are the topics the branch adds: its changelog fragments,
// else its commit subjects. A fragment or a log it cannot read adds none.
fun branchSubjects(dir: str, paths: [str], source: str) > [branches\Subject] {
    final found = mut [<branches\Subject>];
    foreach (path in paths) {
        if (!path.startsWith("changes/unreleased/") or !path.endsWith(".md")) {
            continue;
        }
        if (source != "") {
            final shown = vcs\cmd(["show", "{source}:{path}"], opts: vcs\CommandOptions{ dir = dir, quiet = true }) catch null;
            if (shown != null) {
                found.append(branches\fragmentSubject(path, text: shown!.stdout));
            }
            continue;
        }
        final file = fs\join(dir, name: path);
        if (fs\exists(file) catch false) {
            found.append(branches\fragmentSubject(path, text: fs\readFile(file) catch ""));
        }
    }
    if (found.len() > 0) {
        return found;
    }
    var tip = "HEAD";
    if (source != "") {
        tip = source;
    }
    try {
        final log = vcs\cmd(["log", "--format=%s", vcs\base(dir: dir) + ".." + tip], opts: vcs\CommandOptions{ dir = dir, quiet = true });
        foreach (line in log.stdout.split("\n")) {
            if (line.trim() != "") {
                found.append(branches\commitSubjectTopic(line.trim()));
            }
        }
    } catch (e) {
        return [<branches\Subject>];
    }
    return found;
}

// withHeredocs fills each commit message, title and description the parser rendered empty
// with the heredoc the line feeds it through a command substitution.
fun withHeredocs(programs: [helpers\Program], line: str) > [helpers\Program] {
    final bodies = helpers\substitutedHeredocs(line);
    if (bodies.len() == 0) {
        return programs;
    }
    final slots = mut [<[int]>];
    foreach (p in programs) {
        slots.append(subjects\messageSlots(p) + pullRequests\textSlots(p));
    }
    return helpers\fillSlots(programs, slots: slots, texts: bodies);
}

// bodyFiles reads the description files the line's pull request calls name, relative to
// dir. One that does not exist yet is left out, which the rule reads as unknown.
fun bodyFiles(programs: [helpers\Program], dir: str) > {str: str} {
    final files = mut {<str: str>};
    foreach (name in pullRequests\bodyFiles(programs)) {
        var file = name;
        if (!name.startsWith("/") and dir != "") {
            file = "{dir}/{name}";
        }
        try {
            if (fs\exists(file)) {
                files[name] = fs\readFile(file);
            }
        } catch (e) {
            continue;
        }
    }
    return files;
}

// judgeSpawn is the spawn rule the root magusfile registers.
// magus\workspace().jobs() answers from the rows the guard pinned for the call.
// It throws when the store could not be read.
export fun judgeSpawn(req: SpawnRequest) > GuardVerdict {
    var rows: [helpers\JobRow]? = null;
    var unreadable = "";
    try {
        rows = jobRows(magus\workspace().jobs().jobs);
    } catch (e) {
        unreadable = errorText(e);
    }
    return spawn\decideSpawn(spawnFacts(req), rows: rows, unreadable: unreadable);
}

fun spawnFacts(req: SpawnRequest) > spawn\Spawn {
    var lease = "";
    if (req.lease != null) {
        lease = req.lease!.id;
    }
    return spawn\Spawn{ kind = req.kind, title = req.description, isolated = req.isolated, model = req.model, lease = lease, prompt = req.prompt, checkout = req.checkout };
}

fun jobRows(jobs: [Job]) > [helpers\JobRow] {
    final read = mut [<helpers\JobRow>];
    foreach (row in jobs) {
        read.append(helpers\JobRow{ id = row.id, parent = row.parent, state = row.state, checkoutRoot = row.checkoutRoot });
    }
    return read;
}

test "an integrate spawn for a row bound to another checkout is refused end to end and a matching checkout passes" {
    final rows = jobRows([
        Job{ id = "land", state = magus\JobState.declared, checkoutRoot = "/w/other" },
        Job{ id = "here", state = magus\JobState.declared, checkoutRoot = "/w/main" },
    ]);
    final facts = fun (title: str) > spawn\Spawn {
        return spawnFacts(SpawnRequest{ kind = magus\SpawnKind.spawn, description = title, checkout = "/w/main" });
    };
    final denied = spawn\decideSpawn(facts("orchestrator/integrate land"), rows: rows, unreadable: "");
    std\assert(denied.decision == magus\GuardDecision.deny and denied.reason.indexOf("`/w/other`") != null, message: denied.decision.value + " " + denied.reason);
    final allowed = spawn\decideSpawn(facts("orchestrator/integrate here"), rows: rows, unreadable: "");
    std\assert(allowed.decision == magus\GuardDecision.allow, message: allowed.reason);
}

// errorText is a caught host error's message: a magus\* call throws a map, not a str.
fun errorText(e: any) > str {
    if (e is {str: str}) {
        return (e as? {str: str})!["message"] ?? "{e}";
    }
    return "{e}";
}

// judgeWrite is the write rule the root magusfile registers. It reads the file from disk
// only when the write carries a comment, to tell the comments it adds from the ones it
// keeps: an edit is applied to the file's text so a comment is graded beside the
// declaration it documents.
export fun judgeWrite(req: WriteRequest) > GuardVerdict !> any {
    if (req.workspace == "") {
        return magus\guard.allow();
    }
    final once = fun (key: str) > bool {
        return magus\guard.once(key);
    };
    var before = req.oldText;
    var after = req.newText;
    if (req.content != "") {
        before = "";
        after = req.content;
    }
    final kept = mandate\decideWrite(req.path, workspace: req.workspace, m: mandate\loadMandate(req.workspace), now: mandate\now());
    if (kept.decision != magus\GuardDecision.allow) {
        return kept;
    }
    final pathDenial = host\writePath(req.path);
    if (pathDenial != "") {
        return magus\guard.deny(pathDenial);
    }
    final bump = versions\judgeWrite(req);
    if (bump -> v) {
        return v;
    }
    if (!comments\hasComment(after)) {
        return magus\guard.allow();
    }
    if (fs\exists(req.path)) {
        final current = fs\readFile(req.path);
        if (req.content != "") {
            before = current;
        } else if (req.oldText != "" and current.indexOf(req.oldText) != null) {
            before = current;
            after = current.replace(req.oldText, with: req.newText);
        }
    }
    return comments\decideWrite(req.path, before: before, after: after, once: once,
        judge: comments\cssJudgeRunner(req.workspace));
}

// decide is judge over plain records. The order is the verdict: push authority first, then
// the gate and push denials, then the branch name denials, then the gh denials, then the
// commit and pull request text denials, then the gh advisories, then the pull request text
// advisories, then the branch name advisories. baseBranch is the checkout's branch when it
// is the base branch, "" otherwise; line is the shell line as sent, files the description
// files it names, diff reads the branch's diff for a description's budget, judge runs
// proofread over a pull request's text of a kind, and reads gives the host rule a task
// capture's text and whether the workspace holds a ./magus.
export fun decide(programs: [helpers\Program], caller: cadence\Caller, checkout: cadence\Checkout?, baseBranch: str, line: str, files: {str: str}, diff: fun (head: str, base: str, number: str) > pullRequests\Facts, judge: fun (text: str, kind: str) > [pullRequests\Judged], once: fun (key: str) > bool, publishing: Publishing, reads: host\Reads) > GuardVerdict {
    final hostVerdict = host\decideHost(programs, reads: reads);
    if (hostVerdict.decision != magus\GuardDecision.allow) {
        return hostVerdict;
    }
    final authority = branches\decideAuthority(programs, caller: publishing.pusher);
    if (authority.decision != magus\GuardDecision.allow) {
        return authority;
    }
    final cadenceVerdict = cadence\decideCadence(programs, caller: caller, checkout: checkout);
    if (cadenceVerdict.decision != magus\GuardDecision.allow) {
        return cadenceVerdict;
    }
    final names = branches\decideNames(programs, current: publishing.current, remote: publishing.remote,
        topic: publishing.topic, once: once);
    if (names.decision == magus\GuardDecision.deny) {
        return names;
    }
    final rest = decideText(programs, baseBranch: baseBranch, line: line, files: files, diff: diff, judge: judge, once: once);
    if (rest.decision == magus\GuardDecision.allow) {
        return names;
    }
    return rest;
}

// decideText is decide's gh and text rules: the gh denials, the commit and pull request text
// denials, the gh advisories, then the pull request text advisories.
fun decideText(programs: [helpers\Program], baseBranch: str, line: str, files: {str: str}, diff: fun (head: str, base: str, number: str) > pullRequests\Facts, judge: fun (text: str, kind: str) > [pullRequests\Judged], once: fun (key: str) > bool) > GuardVerdict {
    final github = gh\decideGitHub(programs, once: once, line: line);
    if (github.decision == magus\GuardDecision.deny) {
        return github;
    }
    final commit = subjects\decideCommit(programs, baseBranch: baseBranch);
    final pull = pullRequests\decidePullRequest(programs, line: line, files: files, diff: diff, judge: judge, once: once);
    if (commit.decision == magus\GuardDecision.deny and pull.decision == magus\GuardDecision.deny) {
        return magus\guard.deny(commit.reason + "\n\n" + pull.reason);
    }
    if (commit.decision == magus\GuardDecision.deny) {
        return commit;
    }
    if (pull.decision == magus\GuardDecision.deny or github.decision == magus\GuardDecision.allow) {
        return pull;
    }
    return github;
}

// go-build links buildStamp into ./magus from the root magusfile.
export stale\buildStamp as buildStamp;

test "the remote's base is read from the caller's checkout, and one that cannot be read says why" {
    final here = requestRemote(CommandRequest{ dir = "." });
    std\assert(here.unreadable == "" and here.base == (vcs\base() catch "?"), message: "the caller's own checkout: {here.unreadable}");
    final missing = (fs\tempDir("remote-of") catch "") + "/gone";
    final gone = requestRemote(CommandRequest{ dir = missing });
    std\assert(gone.unreadable.indexOf(missing) != null, message: gone.unreadable);
}

test "a commit and a pull request text denied together open with one verdict" {
    final line = helpers\vcsRequest([["git", "commit", "-m", "Fixed the port."]])
        + helpers\request([["gh", "pr", "create", "--title", "Fixed the port.", "--body", "Pins the port."]]);
    final diff = fun (head: str, base: str, number: str) > pullRequests\Facts {
        return pullRequests\Facts{ known = true, fragments = 0, shipped = 0, lines = 1 };
    };
    final judge = fun (text: str, kind: str) > [pullRequests\Judged] {
        return [<pullRequests\Judged>];
    };
    final once = fun (key: str) > bool {
        return true;
    };
    final both = decideText(line, baseBranch: "", line: "", files: {<str: str>}, diff: diff, judge: judge, once: once);
    std\assert(both.decision == magus\GuardDecision.deny, message: both.reason);
    verdict\assertVerdict(both.reason, label: "a commit and a pull request together");
    std\assert(both.reason.indexOf("this pull request text breaks") != null, message: "both rationales are kept: " + both.reason);
}

test "a write into a run log is denied with the verdict a command's read gets" {
    final write = judgeWrite(WriteRequest{ workspace = "/w", path = ".magus/logs/abc.log", content = "x" });
    std\assert(write.decision == magus\GuardDecision.deny, message: write.decision);
    verdict\assertVerdict(write.reason, label: "a write into a run log");
}

test "a push is refused to a subagent the host names, under no lease and unseen spawning" {
    final push = CommandInvocation{ program = "git", args = ["push", "origin", "HEAD:x"],
        vcs = VCSInvocation{ tool = "git", subcommand = "push", args = ["origin", "HEAD:x"] } };
    final main = CommandRequest{ session = "s1", role = magus\AgentRole.root, commands = [push] };
    std\assert(branches\decideAuthority(parsePrograms(main), caller: requestPusher(main)).decision == magus\GuardDecision.allow, message: "the main session");

    final unseen = CommandRequest{ session = "s1", role = magus\AgentRole.root, agent = "a534fcfe", commands = [push] };
    final refused = branches\decideAuthority(parsePrograms(unseen), caller: requestPusher(unseen));
    std\assert(refused.decision == magus\GuardDecision.deny, message: "a subagent magus never saw spawned");
    std\assert(refused.reason.indexOf("subagent `a534fcfe`") != null, message: refused.reason);

    final worker = CommandRequest{ session = "s1", role = magus\AgentRole.worker, lease = Job{ id = "guard-caller-identity" }, commands = [push] };
    final leased = branches\decideAuthority(parsePrograms(worker), caller: requestPusher(worker));
    std\assert(leased.decision == magus\GuardDecision.deny, message: "a leased worker");
    std\assert(leased.reason.indexOf("lease guard-caller-identity") != null, message: leased.reason);
}

test "the line judge refuses the sealed directory before any other rule, and leaves the labels open" {
    final dir = sealed\sealedDir(sealed\rootsFromEnv());
    final read = CommandRequest{ command = "cat {dir}/round5/cases.txtar",
        commands = [CommandInvocation{ program = "cat", args = ["{dir}/round5/cases.txtar"] }] };
    final refused = judge(read, opens: noForge);
    std\assert(refused.decision == magus\GuardDecision.deny, message: "a cat of the sealed directory");
    verdict\assertVerdict(refused.reason, label: "a cat of the sealed directory");
    std\assert(refused.reason.indexOf("sealed until its round is scored") != null, message: refused.reason);

    final open = CommandRequest{ command = "cat {dir}/../labels/round4/scores.json",
        commands = [CommandInvocation{ program = "cat", args = ["{dir}/../labels/round4/scores.json"] }] };
    std\assert(judge(open, opens: noForge).decision == magus\GuardDecision.allow, message: "the labels directory");
}

test "the main session's cat of a task capture outside the workspace is denied naming the capture's ref" {
    final ws = fs\tempDir("capture-ws") catch "";
    final host = fs\tempDir("capture-host") catch "";
    std\assert(ws != "" and host != "", message: "temp dirs");
    fs\mkdirAll("{host}/claude-501/project/session/tasks");
    final capture = "{host}/claude-501/project/session/tasks/bi3m8xyic.output";
    fs\writeFile(capture, content: "[fail] magus run (ran, 3s)\n  output: out1afa17d04e90\n");
    final cat = CommandInvocation{ program = "cat", args = [capture] };
    final req = CommandRequest{ session = "s1", role = magus\AgentRole.root, dir = ws, workspace = ws, command = "cat {capture}", commands = [cat] };

    fs\writeFile("{ws}/magus", content: "");
    final denied = judge(req, opens: noForge);
    std\assert(denied.decision == magus\GuardDecision.deny, message: "a workspace holding ./magus: " + denied.decision + " " + denied.reason);
    std\assert(denied.reason.split("\n")[0].indexOf("`magus query output out1afa17d04e90`") != null, message: denied.reason);

    fs\remove("{ws}/magus");
    final allowed = judge(req, opens: noForge);
    std\assert(allowed.decision == magus\GuardDecision.allow, message: "a workspace with no ./magus: " + allowed.decision + " " + allowed.reason);
    fs\removeAll(ws);
    fs\removeAll(host);
}
