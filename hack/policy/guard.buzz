// This repository's rules for the coding agents that work on it, registered from the root
// magusfile with magus\guard.command, magus\guard.spawn and magus\guard.write. They are this
// repository's preference, not a magus default: nothing here is compiled into or shipped
// with magus. Copy them as a reference for your own repository's policy.
//
// Edits apply at once when they tighten a rule. A loosening waits until it is committed,
// because the guard runs the committed copy of these files beside the working tree's and keeps
// the stricter answer.
//
// Rules, each keyed on facts the guard hands over (parsed programs, titles, paths), never
// on prose:
//   ci-watch (deny): a gh invocation that blocks until CI or the merge queue finishes.
//   ci-batch-poll (advise once per session): one pull request's CI read piecemeal.
//   queue-poll (advise once per session): the merge queue's state read through GitHub.
//   admin-merge (deny): `gh pr merge --admin`, which lands a pull request past the queue.
//   pr-watch (deny): a pull request's own state (merged, auto-merge, mergeability) read
//     again and again, which the host's PR monitor reports as it changes.
//   worker-runs-gate (deny): the gate run by a subagent whose role is not integrate.
//   detached-push-unqualified (deny): `git push <remote> HEAD:<name>` from a detached HEAD
//     to a branch the checkout does not know the remote has.
//   push-authority (deny): a push or `gh pr create` by any caller but the main session, and
//     by one the host reported no session for.
//   branch-name (deny, or advise on a topic miss alone): a pushed branch or bookmark, or a
//     pull request's head, that is not a short topic of lowercase words.
//   foreign-binary (deny): a magus binary built in one checkout of magus run against another.
//   go-into-checkout (deny): `go -C` into another checkout of magus, the bootstrap aside.
//   stale-binary (advise once per state): the ./magus answering this hook was built from
//     sources that have since moved, by the stamp go-build links into it.
//   stale-write (deny): a magus verb that writes state other checkouts or magus versions
//     read (init, server start, config set, agent install, agent harness install)
//     run by a ./magus stale-binary judges stale, or, for state outside the checkout, by one
//     whose stamped commit is not on the base branch.
//   spawn-without-job-row (deny, spawn): a spawn whose `<parent>/<role> <job>` title names no
//     live job row the spawner may hand out; an unreadable job store advises instead.
//   change-role-spawn-not-isolated (deny, spawn): a code-changing worker sharing a checkout.
//   commit-subject (deny): a message recorded with -m by git, hg or sl commit, or jj commit
//     or describe, that carries an attribution or a body, or whose subject breaks the form
//     its branch takes: the conventional subject hack/magusfile/commits.buzz defines on the base
//     branch, one lowercase imperative line anywhere else.
//   pull-request-text (deny, named): a pull request title, description or review reply,
//     posted by any forge command its table lists, with a finding proofread in
//     libs/conventions/proofread decides deny under hack/policy/proofread.buzz, a description past
//     the word budget its diff earns after the lead, or a title the pr-title check would
//     fail. Advise findings, prose outside the lead, bullets and headed sections, and an
//     area the diff touches that the description never names are advised once per pull
//     request.
//   code-comments (write): a Go comment block the write adds over the owner's budget is
//     advised, over twice it or above the package clause denied; the first write of a
//     session adding comments to any code file is advised once.
//   host-capture (deny): cat, sed, rg, grep, head or tail of a run log or a task
//     capture. The compiled rule only advises a filter of those files.
//   host-terminals (deny): creating or reading a directory named terminals. A host
//     session folder is not a run; magus status reads the lock.
//
// Each rule lives beside its tests in the file named for what it guards: gh.buzz (the first
// five), cadence.buzz (the gate and the push), branches.buzz (push-authority and
// branch-name), binaries.buzz (foreign-binary and
// go-into-checkout), stale.buzz, spawn.buzz, commits.buzz, pull_requests.buzz,
// comments.buzz and host.buzz (a run log, and a directory named terminals).
// helpers.buzz holds the argv parsing they share. Imports are root-relative because `magus buzz -t` resolves an entry
// file's imports against the working directory, not the file. An alias the root magusfile
// already binds (github, changelog) shadows the one here, so these avoid them.
namespace agentpolicy;

import "std";
import "magus";
import "fs";
import "vcs";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/gh" as gh;
import "./hack/policy/cadence" as cadence;
import "./hack/policy/binaries" as binaries;
import "./hack/policy/stale" as stale;
import "./hack/policy/spawn" as spawn;
import "./hack/policy/commits" as subjects;
import "./hack/policy/pull_requests" as pullRequests;
import "./hack/policy/comments" as comments;
import "./hack/policy/host" as host;
import "./hack/policy/branches" as branches;
import "./hack/magusfile/commits" as conventional;

// judge is the command rule the root magusfile registers.
export fun judge(req: CommandRequest) > GuardVerdict {
    final programs = parsePrograms(req);
    final denial = binaries\decideBinaries(programs, where: binaries\Where{ dir = req.dir, workspace = req.workspace }, disk: binaries\onDisk());
    if (denial != "") {
        return magus\guard.deny(denial);
    }
    final hook = fun () > stale\HookBinary {
        return stale\hookBinary(req.workspace);
    };
    final write = stale\decideStateWrite(programs, bin: hook, onBase: stale\onBase(req.workspace));
    if (write.decision != "allow") {
        return write;
    }
    var checkout: cadence\Checkout? = null;
    var baseBranch = "";
    if (req.checkout != null) {
        checkout = cadence\Checkout{ detached = req.checkout!.branch == "", remoteBranches = req.checkout!.remoteBranches };
        if (conventional\onBase(req.checkout!.branch, base: req.checkout!.base)) {
            baseBranch = req.checkout!.branch;
        }
    }
    final once = fun (key: str) > bool {
        return magus\guard.once(key);
    };
    final pusher = requestPusher(req);
    final topic = fun () > branches\Topic {
        return branchTopic(req.dir);
    };
    final texts = withHeredocs(programs, line: req.command);
    final verdict = decide(texts, caller: cadence\Caller{ role = req.role, title = req.parent }, checkout: checkout,
        baseBranch: baseBranch, line: req.command, files: bodyFiles(texts, dir: req.dir),
        diff: pullRequests\branchDiff(req.workspace), judge: pullRequests\judgeRunner(req.workspace), once: once,
        publishing: Publishing{ pusher = pusher, current = currentBranch(req), remote = requestRemote(req), topic = topic });
    if (verdict.decision != "allow" or stale\rebuilds(programs)) {
        return verdict;
    }
    return stale\decideStale(stale\hookBinary(req.workspace), once: once);
}

fun parsePrograms(req: CommandRequest) > [helpers\Program] {
    final programs = mut [<helpers\Program>];
    foreach (c in req.commands) {
        var call: helpers\VcsCall? = null;
        if (c.vcs != null) {
            call = helpers\VcsCall{ tool = c.vcs!.tool, subcommand = c.vcs!.subcommand, args = c.vcs!.args };
        }
        programs.append(helpers\Program{ name = c.program, args = c.args, repeats = c.repeats, path = c.path, vcs = call });
    }
    return programs;
}

// requestPusher is the caller as the guard recorded it. agent is the host's subagent id, which
// marks a subagent magus never saw spawned and that holds no lease: its session is the
// main session's, so nothing else tells the two apart.
fun requestPusher(req: CommandRequest) > branches\Pusher {
    var lease = "";
    if (req.lease != null) {
        lease = req.lease!.id;
    }
    return branches\Pusher{ role = req.role, title = req.parent, session = req.session, lease = lease, agent = req.agent };
}

// Publishing is what the publishing rules read about a line: who runs it, the branch or
// bookmark its checkout is on, what the checkout knows of the remote, and the topic of the
// branch's diff, read only when a name is judged.
export object Publishing {
    pusher: branches\Pusher,
    current: str,
    remote: branches\Remote,
    topic: fun () > branches\Topic,
}

// currentBranch is the branch or bookmark the guard read for a push, else the one the
// caller's checkout is on, "" when neither names one.
fun currentBranch(req: CommandRequest) > str {
    if (req.checkout != null) {
        return req.checkout!.branch;
    }
    return (vcs\ref(dir: req.dir) catch null) ?? "";
}

fun requestRemote(req: CommandRequest) > branches\Remote {
    if (req.checkout != null) {
        return branches\Remote{ base = req.checkout!.base, branches = req.checkout!.remoteBranches };
    }
    final base = vcs\base(dir: req.dir) catch null;
    if (base == null) {
        return branches\Remote{ base = "", branches = [<str>], unreadable = "the base ref of the checkout at `{req.dir}` cannot be resolved" };
    }
    return branches\Remote{ base = base!, branches = [<str>] };
}

// branchTopic is the topic of the branch's changes against the base in the checkout holding
// dir, the caller's rather than the hook process's. A diff it cannot read is no topic.
fun branchTopic(dir: str) > branches\Topic {
    final paths = mut [<str>];
    try {
        foreach (p in vcs\changedFiles(dir: dir)) {
            paths.append(p.value);
        }
    } catch (e) {
        return branches\unknownTopic();
    }
    return branches\readTopic(paths);
}

// withHeredocs fills each commit message, title and description the parser rendered empty
// with the heredoc the line feeds it through a command substitution.
fun withHeredocs(programs: [helpers\Program], line: str) > [helpers\Program] {
    final bodies = helpers\substitutedHeredocs(line);
    if (bodies.len() == 0) {
        return programs;
    }
    final slots = mut [<[int]>];
    foreach (p in programs) {
        slots.append(subjects\messageSlots(p) + pullRequests\textSlots(p));
    }
    return helpers\fillSlots(programs, slots: slots, texts: bodies);
}

// bodyFiles reads the description files the line's pull request calls name, relative to
// dir. One that does not exist yet is left out, which the rule reads as unknown.
fun bodyFiles(programs: [helpers\Program], dir: str) > {str: str} {
    final files = mut {<str: str>};
    foreach (name in pullRequests\bodyFiles(programs)) {
        var file = name;
        if (!name.startsWith("/") and dir != "") {
            file = "{dir}/{name}";
        }
        try {
            if (fs\exists(file)) {
                files[name] = fs\readFile(file);
            }
        } catch (e) {
            continue;
        }
    }
    return files;
}

// judgeSpawn is the spawn rule the root magusfile registers. magus\job.list answers from the
// rows the guard pinned for this hook call, and throws when the store could not be read.
export fun judgeSpawn(req: SpawnRequest) > GuardVerdict {
    var lease = "";
    if (req.lease != null) {
        lease = req.lease!.id;
    }
    final facts = spawn\Spawn{ kind = req.kind, title = req.description, isolated = req.isolated, model = req.model, lease = lease };
    var rows: [helpers\JobRow]? = null;
    var unreadable = "";
    try {
        final read = mut [<helpers\JobRow>];
        foreach (row in magus\job.list().jobs) {
            read.append(helpers\JobRow{ id = row.id, parent = row.parent, state = row.state });
        }
        rows = read;
    } catch (e) {
        unreadable = errorText(e);
    }
    return spawn\decideSpawn(facts, rows: rows, unreadable: unreadable);
}

// errorText is a caught host error's message: a magus\* call throws a map, not a str.
fun errorText(e: any) > str {
    if (e is {str: str}) {
        return (e as? {str: str})!["message"] ?? "{e}";
    }
    return "{e}";
}

// judgeWrite is the write rule the root magusfile registers. It reads the file from disk
// only when the write carries a comment, to tell the comments it adds from the ones it
// keeps: an edit is applied to the file's text so a comment is graded beside the
// declaration it documents.
export fun judgeWrite(req: WriteRequest) > GuardVerdict !> any {
    if (req.workspace == "") {
        return magus\guard.allow();
    }
    final once = fun (key: str) > bool {
        return magus\guard.once(key);
    };
    var before = req.oldText;
    var after = req.newText;
    if (req.content != "") {
        before = "";
        after = req.content;
    }
    final pathDenial = host\writePath(req.path);
    if (pathDenial != "") {
        return magus\guard.deny(pathDenial);
    }
    if (!comments\hasComment(after)) {
        return magus\guard.allow();
    }
    if (fs\exists(req.path)) {
        final current = fs\readFile(req.path);
        if (req.content != "") {
            before = current;
        } else if (req.oldText != "" and current.indexOf(req.oldText) != null) {
            before = current;
            after = current.replace(req.oldText, with: req.newText);
        }
    }
    return comments\decideComments(req.path, before: before, after: after, once: once);
}

// decide is judge over plain records. The order is the verdict: push authority first, then
// the gate and push denials, then the branch name denials, then the gh denials, then the
// commit and pull request text denials, then the gh advisories, then the pull request text
// advisories, then the branch name advisories. baseBranch is the checkout's branch when it
// is the base branch, "" otherwise; line is the shell line as sent, files the description
// files it names, diff reads the branch's diff for a description's budget, and judge runs
// proofread over a pull request's text of a kind.
export fun decide(programs: [helpers\Program], caller: cadence\Caller, checkout: cadence\Checkout?, baseBranch: str, line: str, files: {str: str}, diff: fun (base: str) > pullRequests\Facts, judge: fun (text: str, kind: str) > [pullRequests\Judged], once: fun (key: str) > bool, publishing: Publishing) > GuardVerdict {
    final hostVerdict = host\decideHost(programs);
    if (hostVerdict.decision != "allow") {
        return hostVerdict;
    }
    final authority = branches\decideAuthority(programs, caller: publishing.pusher);
    if (authority.decision != "allow") {
        return authority;
    }
    final verdict = cadence\decideCadence(programs, caller: caller, checkout: checkout);
    if (verdict.decision != "allow") {
        return verdict;
    }
    final names = branches\decideNames(programs, current: publishing.current, remote: publishing.remote,
        topic: publishing.topic, once: once);
    if (names.decision == "deny") {
        return names;
    }
    final rest = decideText(programs, baseBranch: baseBranch, line: line, files: files, diff: diff, judge: judge, once: once);
    if (rest.decision == "allow") {
        return names;
    }
    return rest;
}

// decideText is decide's gh and text rules: the gh denials, the commit and pull request text
// denials, the gh advisories, then the pull request text advisories.
fun decideText(programs: [helpers\Program], baseBranch: str, line: str, files: {str: str}, diff: fun (base: str) > pullRequests\Facts, judge: fun (text: str, kind: str) > [pullRequests\Judged], once: fun (key: str) > bool) > GuardVerdict {
    final github = gh\decideGitHub(programs, once: once);
    if (github.decision == "deny") {
        return github;
    }
    final commit = subjects\decideCommit(programs, baseBranch: baseBranch);
    final pull = pullRequests\decidePullRequest(programs, line: line, files: files, diff: diff, judge: judge, once: once);
    if (commit.decision == "deny" and pull.decision == "deny") {
        return magus\guard.deny(commit.reason + "\n\n" + pull.reason);
    }
    if (commit.decision == "deny") {
        return commit;
    }
    if (pull.decision == "deny" or github.decision == "allow") {
        return pull;
    }
    return github;
}

// go-build links buildStamp into ./magus from the root magusfile.
export stale\buildStamp as buildStamp;

test "the remote's base is read from the caller's checkout, and one that cannot be read says why" {
    final here = requestRemote(CommandRequest{ dir = "." });
    std\assert(here.unreadable == "" and here.base == (vcs\base() catch "?"), message: "the caller's own checkout: {here.unreadable}");
    final missing = (fs\tempDir("remote-of") catch "") + "/gone";
    final gone = requestRemote(CommandRequest{ dir = missing });
    std\assert(gone.unreadable.indexOf(missing) != null, message: gone.unreadable);
}

test "a push is refused to a subagent the host names, under no lease and unseen spawning" {
    final push = CommandInvocation{ program = "git", args = ["push", "origin", "HEAD:x"],
        vcs = VCSInvocation{ tool = "git", subcommand = "push", args = ["origin", "HEAD:x"] } };
    final main = CommandRequest{ session = "s1", role = "root", commands = [push] };
    std\assert(branches\decideAuthority(parsePrograms(main), caller: requestPusher(main)).decision == "allow", message: "the main session");

    final unseen = CommandRequest{ session = "s1", role = "root", agent = "a534fcfe", commands = [push] };
    final refused = branches\decideAuthority(parsePrograms(unseen), caller: requestPusher(unseen));
    std\assert(refused.decision == "deny", message: "a subagent magus never saw spawned");
    std\assert(refused.reason.indexOf("subagent `a534fcfe`") != null, message: refused.reason);

    final worker = CommandRequest{ session = "s1", role = "worker", lease = Job{ id = "guard-caller-identity" }, commands = [push] };
    final leased = branches\decideAuthority(parsePrograms(worker), caller: requestPusher(worker));
    std\assert(leased.decision == "deny", message: "a leased worker");
    std\assert(leased.reason.indexOf("lease guard-caller-identity") != null, message: leased.reason);
}
