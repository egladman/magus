import "std";
import "magus";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/branches" as branches;

fun fragment(slug: str, headline: str) > branches\Subject {
    return branches\fragmentSubject("changes/unreleased/{slug}.md", text: "### Added\n\n- **{headline}.** Body.\n");
}

fun squash() > [branches\Subject] {
    return [
        fragment("mod-views-tables", headline: "The mod renders tables"),
        fragment("mod-views-links", headline: "The mod links references"),
        fragment("mod-views-figures", headline: "The mod draws ADR figures"),
        fragment("mod-views-install", headline: "The mod checks its install"),
        fragment("lint-portable-config", headline: "Portable lint config per workspace"),
        fragment("lint-vocabulary", headline: "One lint vocabulary file"),
        fragment("guard-comment-budget", headline: "The guard budgets comments"),
        fragment("proofread-stop-silent", headline: "Proofread stops silent fixes"),
    ];
}

fun rules(v: branches\Verdict) > str {
    final names = mut [<str>];
    foreach (f in v.failures) { names.append(f.rule); }
    return names.join(",");
}

test "a squash of many topics with a name for two is denied and told to split" {
    final topic = branches\withSubjects(branches\unknownTopic(), subjects: squash());
    final v = branches\judgeName("portable-lint", topic: topic);
    std\assert(rules(v) == "theme", message: rules(v));
    std\assert(v.failures[0].why.indexOf("Split the branch") != null, message: v.failures[0].why);
    std\assert(v.failures[0].why.indexOf("proofread-stop-silent") != null, message: "names a topic it misses");
    std\assert(v.served == "", message: "no name serves a wide branch");
}

test "a wide branch with a word shared by most topics passes" {
    final subjects = mut [<branches\Subject>];
    foreach (s in squash()) { subjects.append(s); }
    foreach (slug in ["alpha", "bravo", "charlie", "delta"]) {
        subjects.append(fragment("views-{slug}", headline: "Views gain {slug}"));
    }
    final topic = branches\withSubjects(branches\unknownTopic(), subjects: subjects);
    final v = branches\judgeName("mod-views", topic: topic);
    std\assert(rules(v) == "", message: rules(v));
}

test "a branch of one topic named for it passes" {
    final topic = branches\withSubjects(branches\unknownTopic(), subjects: [fragment("branch-name-covers-topics", headline: "Branch names cover their topics")]);
    std\assert(rules(branches\judgeName("branch-name-covers-topics", topic: topic)) == "", message: "named for it");
    std\assert(rules(branches\judgeName("startup-latency", topic: topic)) == "coverage", message: "named for nothing it adds");
}

test "a narrow branch whose name covers under half is denied with the topics it misses" {
    final subjects = [
        fragment("cache-keys", headline: "Cache keys include the toolchain"),
        fragment("sandbox-grants", headline: "Sandbox grants compose"),
        fragment("release-notes", headline: "Release notes group by type"),
        fragment("guard-floors", headline: "Guard floors apply"),
    ];
    final topic = branches\withSubjects(branches\unknownTopic(), subjects: subjects);
    final v = branches\judgeName("cache-keys", topic: topic);
    std\assert(rules(v) == "coverage", message: rules(v));
    std\assert(v.failures[0].why.indexOf("1 of the 4") != null, message: v.failures[0].why);
    std\assert(v.failures[0].why.indexOf("guard-floors") != null, message: v.failures[0].why);
    std\assert(v.served != "", message: "serves a name");
    std\assert(rules(branches\judgeName(v.served, topic: topic)) == "", message: "the served name passes: {v.served}");
    std\assert(rules(branches\judgeName("cache-sandbox", topic: topic)) == "", message: "two of four is half");
}

test "commit subjects stand in when the branch adds no fragment" {
    final subjects = [
        branches\commitSubjectTopic("feat(image): assemble OCI image layouts"),
        branches\commitSubjectTopic("fix(guard): close the bypasses"),
    ];
    final topic = branches\withSubjects(branches\unknownTopic(), subjects: subjects);
    std\assert(rules(branches\judgeName("image-layouts", topic: topic)) == "", message: "covers one of two");
    std\assert(rules(branches\judgeName("startup-latency", topic: topic)) == "coverage", message: "covers none");
}

test "a coverage miss is denied at the push, naming the topics" {
    final topic = fun (source: str) > branches\Topic {
        return branches\withSubjects(branches\unknownTopic(), subjects: squash());
    };
    final push = helpers\vcsRequest([["git", "push", "-u", "origin", "HEAD:portable-lint"]]);
    final remote = branches\Remote{ base = "origin/main", branches = [<str>] };
    final v = branches\decideNames(push, current: "portable-lint", remote: remote, topic: topic, once: helpers\counter());
    std\assert(v.decision == magus\GuardDecision.deny, message: "denied");
    std\assert(v.reason.indexOf("theme:") != null, message: v.reason);
}

test "a coverage miss on a two-topic branch advises at the push" {
    final topic = fun (source: str) > branches\Topic {
        return branches\withSubjects(branches\unknownTopic(), subjects: [
            fragment("guard-rule-precision", headline: "The guard judges a rule only where it applies."),
            fragment("proofread-local-path", headline: "proofread flags a local path in a reply."),
        ]);
    };
    final push = helpers\vcsRequest([["git", "push", "-u", "origin", "HEAD:startup-latency"]]);
    final remote = branches\Remote{ base = "origin/main", branches = [<str>] };
    final v = branches\decideNames(push, current: "startup-latency", remote: remote, topic: topic, once: helpers\counter());
    std\assert(v.decision == magus\GuardDecision.advise, message: v.reason);
    std\assert(v.reason.indexOf("coverage:") != null, message: v.reason);
}

fun gitIn(dir: str, argv: [str]) > helpers\Program {
    return helpers\Program{ name = "git", args = ["-C", dir] + argv, repeats = false,
        vcs = helpers\VcsCall{ tool = "git", subcommand = argv[0], args = argv.sub(1) } };
}

fun shell(name: str, args: [str]) > helpers\Program {
    return helpers\Program{ name = name, args = args, repeats = false };
}

// merged: the 11 fragments #719 added, which a branch squash-merged as
// #719 still adds against origin/main.
fun merged() > [branches\Subject] {
    final found = mut [<branches\Subject>];
    foreach (slug in ["admission-refusal-says-why", "console-serves-only-the-embedded-app",
        "hack-scripts-pass-their-own-checks", "hook-delegates-only-to-its-own-repository",
        "lease-writes-stay-inside-the-boundary", "mcp-unix-socket-mcp", "push-refuses-host-named-branches",
        "sandbox-control-files-fold-case", "small-cache-and-vcs-fixes", "small-harness-gaps", "small-network-hardening"]) {
        found.append(fragment(slug, headline: slug.replace("-", with: " ")));
    }
    return found;
}

// placedAt reads the topic where the guard placed the request, as guard.buzz's
// branchTopic does: narrow at a pushed fork, wide at the host's hook-lease.
fun placedAt(placed: str, seen: mut [str]) > fun (source: str) > branches\Topic {
    return fun (source: str) > branches\Topic {
        seen.append(source);
        if (source == "bafc60786" or placed != "/w/root") {
            return branches\withSubjects(branches\unknownTopic(), subjects: [
                branches\commitSubjectTopic("hand TestResolve_FunctionValueTargets a Charm object as upstream Buzz requires"),
                branches\commitSubjectTopic("align the MCP transport table to dprint"),
            ]);
        }
        return branches\withSubjects(branches\unknownTopic(), subjects: merged());
    };
}

test "a push names the source rev it publishes" {
    final sha = branches\findPushes(helpers\vcsRequest([["git", "push", "origin", "bafc60786:refs/heads/buzz-checker-fiber-json"]]), current: "hook-lease");
    std\assert(sha[0].name == "buzz-checker-fiber-json" and sha[0].source == "bafc60786", message: "sha: {sha[0].name} {sha[0].source}");
    final bare = branches\findPushes(helpers\vcsRequest([["git", "push", "origin", "topic-a"]]), current: "hook-lease");
    std\assert(bare[0].source == "topic-a", message: "branch source");
    final head = branches\findPushes(helpers\vcsRequest([["git", "push", "-u", "origin", "HEAD"]]), current: "hook-lease");
    std\assert(head[0].source == "", message: "the checkout's own HEAD");
}

test "a sha:ref push is scored by the commits it publishes" {
    final remote = branches\Remote{ base = "origin/main", branches = [<str>] };
    final seen = mut [<str>];
    final sha = branches\decideNames(helpers\vcsRequest([["git", "push", "origin", "bafc60786:refs/heads/buzz-checker-fiber-json"]]), current: "hook-lease", remote: remote, topic: placedAt("/w/root", seen: seen), once: helpers\counter());
    std\assert(sha.decision == magus\GuardDecision.allow, message: "sha: {sha.reason}");
    std\assert(seen.join(",") == "bafc60786", message: seen.join(","));
}

test "a cd or git -C push is scored where the guard placed it, not on the host's branch" {
    final remote = branches\Remote{ base = "origin/main", branches = [<str>] };
    final seen = mut [<str>];
    final cd = [shell("cd", args: ["/w/fix"])] + helpers\vcsRequest([["git", "push", "-u", "origin", "HEAD:main-spell-charms"]]);
    final moved = branches\decideNames(cd, current: "fix-main-spell-charms-and-mcp-table", remote: remote, topic: placedAt("/w/fix", seen: seen), once: helpers\counter());
    std\assert(moved.decision != magus\GuardDecision.deny, message: "cd: {moved.reason}");
    final other = branches\decideNames([gitIn("../fix", ["push", "origin", "HEAD:main-spell-charms"])], current: "fix", remote: remote, topic: placedAt("/w/fix", seen: seen), once: helpers\counter());
    std\assert(other.decision != magus\GuardDecision.deny, message: "git -C: {other.reason}");
    std\assert(seen.join(",") == "HEAD,HEAD", message: "the source each push publishes: {seen.join(",")}");
    final host = branches\decideNames(helpers\vcsRequest([["git", "push", "-u", "origin", "HEAD:main-spell-charms"]]), current: "hook-lease", remote: remote, topic: placedAt("/w/root", seen: mut [<str>]), once: helpers\counter());
    std\assert(host.reason.indexOf("adds 11 topics") != null, message: "the host checkout's own wide branch is still judged: {host.reason}");
}
