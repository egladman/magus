// Rules for host tools that answer a question magus already answered.
//
// host-capture (deny): cat, sed, rg, grep, head or tail aimed at a run log
//   (.magus/logs/<hex>.log) or a host task capture (tasks/<id>.output). The
//   compiled rule only advises a filter of those files, and a range read
//   (sed -n) is the same filter. The log's ref is what query output reads.
// host-terminals (deny): creating or reading a directory named terminals.
//   A host session folder is not a run; magus status reads the project lock.
namespace agentpolicy\host;

import "std";
import "magus";
import "./hack/policy/helpers" as helpers;

final captureDenial = "Use `magus query output <ref>`. A failure prints `output: out<hex>` on the line under `cause:`, and that ref is the whole log.\n"
    + "Reading `.magus/logs` or a task capture, by cat or by a range, drops the ref and keeps a slice.";

final terminalsDenial = "Use `magus status`. It reads the project lock: who holds it, what they are running, and how long they have held it.\n"
    + "A directory named terminals is not a run. Do not create one and do not read its files.";

// decideHost denies a command that reads a run capture or that creates or reads
// a terminals directory. Anything else is allowed, including a search whose
// pattern merely mentions those names.
export fun decideHost(programs: [helpers\Program]) > GuardVerdict {
    foreach (p in programs) {
        if (readsCapture(p)) {
            return magus\guard.deny(captureDenial);
        }
        if (touchesTerminals(p)) {
            return magus\guard.deny(terminalsDenial);
        }
    }
    return magus\guard.allow();
}

// writePath is the denial for a write whose path is a capture or sits in a
// terminals directory, "" when the path is ordinary source.
export fun writePath(path: str) > str {
    if (isCapture(path)) {
        return captureDenial;
    }
    if (hasComponent(path, name: "terminals")) {
        return terminalsDenial;
    }
    return "";
}

fun readsCapture(p: helpers\Program) > bool {
    final recursive = p.name == "rg" or p.name == "grep" or p.name == "find";
    foreach (file in readerPaths(p)) {
        if (isCapture(file)) { return true; }
        if (recursive and isLogDir(file)) { return true; }
    }
    return false;
}

fun touchesTerminals(p: helpers\Program) > bool {
    if (p.name == "mkdir") {
        foreach (dir in positionals(p.name, args: p.args)) {
            if (hasComponent(dir, name: "terminals")) { return true; }
        }
        return false;
    }
    foreach (file in readerPaths(p)) {
        if (hasComponent(file, name: "terminals")) { return true; }
    }
    return false;
}

// readerPaths are the paths a reader is aimed at. A filter's pattern and a sed
// script are not paths: `rg terminals internal/` searches for the word.
fun readerPaths(p: helpers\Program) > [str] {
    final pos = positionals(p.name, args: p.args);
    if (p.name == "find") {
        return pos;
    }
    if (p.name == "rg" or p.name == "grep" or p.name == "sed" or p.name == "awk") {
        if (suppliedProgram(p)) { return pos; }
        if (pos.len() < 2) { return [<str>]; }
        return pos.sub(1);
    }
    if (p.name == "cat" or p.name == "head" or p.name == "tail" or p.name == "less"
        or p.name == "more" or p.name == "bat" or p.name == "nl" or p.name == "ls") {
        return pos;
    }
    return [<str>];
}

// suppliedProgram: the pattern or script arrived on a flag, so every positional
// is a file. grep -e, sed -e/-f, awk -e/-f, rg -e.
fun suppliedProgram(p: helpers\Program) > bool {
    foreach (arg in p.args) {
        if (arg == "-e" or arg == "-f" or arg.startsWith("-e=") or arg.startsWith("-f=")
            or arg.startsWith("--expression=") or arg.startsWith("--file=") or arg.startsWith("--regexp=")) {
            return true;
        }
    }
    return false;
}

// positionals drops flags. A flag in valueFlags consumes the next word; a
// flag written as --name=value consumes only itself.
fun positionals(name: str, args: [str]) > [str] {
    final valued = valueFlags(name);
    final kept = mut [<str>];
    var skip = false;
    var done = false;
    foreach (arg in args) {
        if (skip) {
            skip = false;
        } else if (done or arg == "-" or !arg.startsWith("-")) {
            kept.append(arg);
        } else if (arg == "--") {
            done = true;
        } else if (arg.indexOf("=") == null and valued.indexOf(arg) != null) {
            skip = true;
        }
    }
    return kept;
}

fun valueFlags(name: str) > [str] {
    if (name == "head" or name == "tail") {
        return ["-n", "-c", "--lines", "--bytes"];
    }
    if (name == "sed") {
        return ["-e", "-f", "--expression", "--file"];
    }
    if (name == "rg") {
        return ["-e", "-g", "-m", "-t", "-T", "-A", "-B", "-C", "--glob", "--max-count", "--regexp", "--type", "--type-not"];
    }
    if (name == "grep") {
        return ["-e", "-f", "-m", "-A", "-B", "-C"];
    }
    if (name == "awk") {
        return ["-e", "-f", "-v", "--file"];
    }
    if (name == "mkdir") {
        return ["-m", "--mode"];
    }
    if (name == "find") {
        return ["-name", "-iname", "-path", "-ipath", "-regex", "-iregex", "-type", "-maxdepth", "-mindepth"];
    }
    if (name == "ls") {
        return ["-I", "--ignore", "-w", "--width", "--time-style", "--quoting-style", "--sort"];
    }
    return [<str>];
}

fun isCapture(path: str) > bool {
    final p = slashed(path);
    if (p.endsWith(".log") and (p.startsWith(".magus/logs/") or p.indexOf("/.magus/logs/") != null)) {
        return true;
    }
    if (p.endsWith(".output") and (p.startsWith("tasks/") or p.indexOf("/tasks/") != null)) {
        return true;
    }
    return false;
}

// isLogDir is the run log directory itself, which a recursive search reads
// every capture in.
fun isLogDir(path: str) > bool {
    var p = slashed(path);
    while (p.endsWith("/")) { p = p.sub(0, len: p.len() - 1); }
    return p == ".magus/logs" or p.endsWith("/.magus/logs");
}

fun hasComponent(path: str, name: str) > bool {
    foreach (part in slashed(path).split("/")) {
        if (part == name) { return true; }
    }
    return false;
}

// slashed lets a Windows path such as C:\repo\terminals meet the same rules.
fun slashed(path: str) > str {
    return path.replace("\\", with: "/");
}

test "a recursive search of the log directory is denied" {
    foreach (argv in [
        ["rg", "needle", ".magus/logs"],
        ["grep", "-r", "needle", ".magus/logs/"],
        ["find", "/tmp/repo/.magus/logs", "-name", "*.log"],
    ]) {
        std\assert(decideHost(helpers\request([argv])).decision == "deny", message: argv.join(" "));
    }
}

test "a Windows path to a capture or a terminals directory is denied" {
    std\assert(writePath("C:\\repo\\.magus\\logs\\abc.log") != "", message: "log");
    std\assert(writePath("C:\\repo\\terminals\\x.txt") != "", message: "terminals");
}

test "a range read, a grep and a cat of a run log are denied, naming query output" {
    foreach (argv in [
        ["sed", "-n", "1280,1340p", ".magus/logs/c553bb6244f4.log"],
        ["rg", "SC2148", ".magus/logs/c553bb6244f4.log"],
        ["cat", "/tmp/repo/.magus/logs/fa96423d5dfa.log"],
        ["grep", "cause:", "tasks/266090.output"],
        ["head", "-n", "15", ".magus/logs/abc.log"],
    ]) {
        final v = decideHost(helpers\request([argv]));
        std\assert(v.decision == "deny", message: argv.join(" "));
        std\assert(v.reason.indexOf("magus query output") != null, message: "names the ref read");
    }
}

test "a search whose pattern mentions a log, and a read of source, stay silent" {
    foreach (argv in [
        ["rg", ".magus/logs", "internal/guard"],
        ["rg", "-t", "go", "terminals", "."],
        ["grep", "filters a run capture", "internal/guard/shell.go"],
        ["cat", "internal/guard/shell.go"],
        ["sed", "-n", "592,611p", "internal/cache/hash.go"],
        ["head", "-n", "20", "README.md"],
        ["magus", "status"],
    ]) {
        std\assert(decideHost(helpers\request([argv])).decision == "allow", message: argv.join(" "));
    }
}

test "creating or reading a terminals directory is denied, naming magus status" {
    foreach (argv in [
        ["mkdir", "-p", "terminals"],
        ["mkdir", "-p", "foo/terminals"],
        ["ls", "/Users/eli/.cursor/projects/magus/terminals"],
        ["cat", "/Users/eli/.cursor/projects/magus/terminals/266091.txt"],
        ["sed", "-n", "1,15p", "terminals/266091.txt"],
        ["head", "-n", "10", "terminals/266091.txt"],
        ["find", "/Users/eli/.cursor/projects/magus/terminals", "-name", "*.txt"],
    ]) {
        final v = decideHost(helpers\request([argv]));
        std\assert(v.decision == "deny", message: argv.join(" "));
        std\assert(v.reason.indexOf("magus status") != null, message: "names the lock");
    }
}

test "a directory that is not named terminals, and a search for the word, stay silent" {
    foreach (argv in [
        ["mkdir", "-p", "src/pkg"],
        ["ls", "src"],
        ["ls", "-l", "internal"],
        ["rg", "terminals", "hack/policy"],
        ["find", ".", "-name", "*.sh"],
        ["cat", "internal/term.go"],
    ]) {
        std\assert(decideHost(helpers\request([argv])).decision == "allow", message: argv.join(" "));
    }
}

test "a write into a terminals directory or a run log is denied; source is not" {
    std\assert(writePath("terminals/266091.txt").indexOf("magus status") != null, message: "a new session file");
    std\assert(writePath(".magus/logs/abc.log").indexOf("magus query output") != null, message: "a log");
    std\assert(writePath("internal/guard/shell.go") == "", message: "source");
    std\assert(writePath("internal/term.go") == "", message: "a name that only starts the same way");
}
