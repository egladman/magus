// The model alias each wired harness spawns for a tier of magus/modeltiers. The root
// magusfile registers these with magus\modelTiers.
// A host left out is refused at
// strict when a job row's spawn names a model, and the refusal names the hosts entry
// to add. Each string is the exact id that host's spawn takes, read from the host's
// docs or observed in a successful spawn.
// A host with three models gives frontier design's id.
namespace modeltierhosts;

import "magus/modeltiers" as modeltiers;
import "assert";

// claude keeps the exact id each tiered row of the Claude Code spell names,
// so the agents magus ships stay on claude-haiku-5-5. The spell's short
// aliases still resolve a spawn of haiku, sonnet, opus or fable.
export fun claude(tier: modeltiers\ModelTier) > str {
    // Opus handles design. Fable is the escalation for harder work.
    // https://www.anthropic.com/claude-fable-and-mythos-5-2
    return match (tier) {
        .routine -> "claude-haiku-5-5",
        .bounded -> "claude-sonnet-5-5",
        .design -> "claude-opus-5-5",
        .frontier -> "claude-fable-5-2",
    };
}

// codex uses the exact model IDs seen by the spawn guard.
export fun codex(tier: modeltiers\ModelTier) > str {
    // Sol handles bounded work. Astra handles complex design work.
    // https://developers.openai.com/api/docs/guides/model-selection
    return match (tier) {
        .routine -> "gpt-6-luna",
        .bounded -> "gpt-6.1-sol",
        .design -> "gpt-6.2-astra",
        .frontier -> "gpt-6.2-astra",
    };
}

// cursor uses Composer 2.5 for the fast rung, Sonnet at medium effort for the
// bounded one, and claude-opus-5-5-high, an id this repository already records
// Cursor sending. The spell still writes model inherit on a shipped agent.
export fun cursor(tier: modeltiers\ModelTier) > str {
    return match (tier) {
        .routine -> "composer-2.5",
        .bounded -> "claude-sonnet-5-5-medium",
        .design -> "claude-opus-5-5-high",
        .frontier -> "claude-opus-5-5-high",
    };
}

// opencode selects provider/model, as opencode.ai/docs/models shows with
// anthropic/claude-sonnet-5-5. The three rungs are the Claude models the spell
// already prices, under that spelling. The spell sets no model on a shipped agent.
export fun opencode(tier: modeltiers\ModelTier) > str {
    return match (tier) {
        .routine -> "anthropic/claude-haiku-5-5",
        .bounded -> "anthropic/claude-sonnet-5-5",
        .design -> "anthropic/claude-opus-5-5",
        .frontier -> "anthropic/claude-opus-5-5",
    };
}

test "each harness maps the four tiers to the ids it accepts" {
    assert\equal(claude(modeltiers\ModelTier.routine), want: "claude-haiku-5-5", message: "shipped agents stay on the exact id");
    assert\equal(claude(modeltiers\ModelTier.bounded), want: "claude-sonnet-5-5", message: "the spell's bounded row");
    assert\equal(claude(modeltiers\ModelTier.design), want: "claude-opus-5-5", message: "the spell's design row");
    assert\equal(claude(modeltiers\ModelTier.frontier), want: "claude-fable-5-2", message: "the spell's frontier row");
    assert\equal(codex(modeltiers\ModelTier.routine), want: "gpt-6-luna", message: "the lighter Codex model");
    assert\equal(codex(modeltiers\ModelTier.bounded), want: "gpt-6.1-sol", message: "the model Codex says to start with");
    assert\equal(codex(modeltiers\ModelTier.design), want: "gpt-6.2-astra", message: "the design model accepted by the collaboration tool");
    assert\equal(cursor(modeltiers\ModelTier.routine), want: "composer-2.5", message: "Cursor's fast model");
    assert\equal(cursor(modeltiers\ModelTier.bounded), want: "claude-sonnet-5-5-medium", message: "Sonnet at medium effort");
    assert\equal(cursor(modeltiers\ModelTier.design), want: "claude-opus-5-5-high", message: "the id the agents guide records");
    assert\equal(opencode(modeltiers\ModelTier.routine), want: "anthropic/claude-haiku-5-5", message: "OpenCode's provider/model spelling");
    assert\equal(opencode(modeltiers\ModelTier.bounded), want: "anthropic/claude-sonnet-5-5", message: "the id the OpenCode docs show");
    assert\equal(opencode(modeltiers\ModelTier.design), want: "anthropic/claude-opus-5-5", message: "the same rung as Claude's design");
}

test "a host with three models gives frontier the id design runs" {
    assert\equal(codex(modeltiers\ModelTier.frontier), want: codex(modeltiers\ModelTier.design), message: "Codex has no fourth model");
    assert\equal(cursor(modeltiers\ModelTier.frontier), want: cursor(modeltiers\ModelTier.design), message: "Cursor has no fourth model");
    assert\equal(opencode(modeltiers\ModelTier.frontier), want: opencode(modeltiers\ModelTier.design), message: "OpenCode has no fourth model");
}
