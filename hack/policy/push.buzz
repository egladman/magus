// push-unverified: a push or `gh pr create` whose commit changed a file, since its merge
// base, that a target declares and no passing run in the pushing checkout read as that
// commit holds it; and one magus could not judge. It advises while `advising` holds, and
// refuses once that is false.
//
// A changed file no target declares as an input or output has no run that could read it. It
// does not block: the reply names it, and declaring it as a target's input is how it gets
// checked.
//
// A line whose directory only running it reveals reaches this rule with `req.push` carrying
// Unknown, and unplaced-call refuses it first (guard.buzz judge). This rule still reads
// Unknown as unjudged, so it does not rely on that order for correctness.
namespace agentpolicy\push;

import "std";
import "magus";
import "result";
import "./hack/policy/verdict" as verdict;

// advising makes the rule answer with advice wherever it would refuse, so no push is
// blocked while every would-be refusal is still spoken and counted. It stays true until a
// run records the content id of each uncommitted path and the policy snapshot holds each
// target's declared inputs; until then the read can call a file unread that a run did
// read, and can run out of the hook's time. Set it false to refuse.
final advising = true;

// named is how many unread files a reply lists by path.
final named = 5;

// readUnverified is magus\workspace(dir).unverified(revision), its raise returned as a value.
export fun readUnverified(dir: str, revision: str) > result\Result::<UnverifiedReport> {
    try {
        return result\ok::<UnverifiedReport>(magus\workspace(dir).unverified(revision));
    } catch (err: any) {
        return result\caught::<UnverifiedReport>(err, doing: "magus\\workspace(`{dir}`).unverified");
    }
}

// decidePush refuses push (advises, while advising holds) when its commit changed a file a
// target declares and no passing run read as the commit holds it, and as unjudged when what
// it publishes, or which runs read it, is unknown. A line that publishes nothing is allowed
// without a read.
// Files no target declares are named in an advisory and never block. The hook and
// hack/dev/land-commits.buzz both call it, with the same read.
export fun decidePush(push: CommandPush?, read: fun (dir: str, revision: str) > result\Result::<UnverifiedReport>) > GuardVerdict {
    if (push == null) {
        return magus\guard.defer();
    }
    final p = push!;
    if (p.revision == "") {
        return refused(lineUnjudged(p.unknown));
    }
    final got = read(p.dir, revision: p.revision);
    if (got.error -> e) {
        return refused(readUnjudged(e.message));
    }
    final report = got.value!;
    if (report.unknown != "") {
        return refused(readUnjudged(report.unknown));
    }
    final checkable = mut [<UnverifiedFile>];
    final unclaimed = mut [<UnverifiedFile>];
    foreach (f in report.unverified) {
        if (!f.declared) {
            unclaimed.append(f);
        } else {
            checkable.append(f);
        }
    }
    if (checkable.len() == 0 and unclaimed.len() == 0) {
        return magus\guard.defer();
    }
    if (checkable.len() == 0) {
        return magus\guard.advise(unclaimedNote(unclaimed, report: report, dir: p.dir), opts: {"rule": "push-unverified"});
    }
    return refused(unverifiedDenial(p, report: report, checkable: checkable, unclaimed: unclaimed));
}

// later says what the answer does now: it advises while advising holds.
fun later() > str {
    if (advising) {
        return "this advises for now and will refuse later";
    }
    return "this refuses the push";
}

// refused is the rule's answer where it would refuse: advice while advising holds.
fun refused(text: str) > GuardVerdict {
    if (advising) {
        return magus\guard.advise(text, opts: {"rule": "push-unverified"});
    }
    return magus\guard.deny(text, opts: {"rule": "push-unverified"});
}

fun short(revision: str) > str {
    if (revision.len() > 12) {
        return revision.sub(0, len: 12);
    }
    return revision;
}

fun files(n: int) > str {
    if (n == 1) {
        return "1 file";
    }
    return "{n} files";
}

fun published(p: CommandPush) > str {
    if (p.opensPullRequest) {
        return "opening a pull request at {short(p.revision)}";
    }
    return "pushing {short(p.revision)}";
}

// lineUnjudged refuses a push whose commit magus cannot name before the line runs; why is
// what about the line hides it.
fun lineUnjudged(why: str) > str {
    return "magus cannot tell, before the line runs, which commit this push publishes; {later()}:\n"
        + "{why}\n"
        + "Run the push as one call of its own, naming one revision in literal words.";
}

// readUnjudged refuses a push whose files the read could not weigh; why is the step that did
// not finish.
fun readUnjudged(why: str) > str {
    return "magus could not finish checking this push's changed files against the recorded runs; {later()}:\n"
        + "{why}\n"
        + "Nothing on the line is wrong. Run it again; if the same reason comes back twice, report it and stop.";
}

// unclaimedNote names the changed files no target declares, which no run can check, and
// says when that is because no magus workspace holds the checkout at dir.
fun unclaimedNote(unclaimed: [UnverifiedFile], report: UnverifiedReport, dir: str) > str {
    final names = mut [<str>];
    foreach (f in unclaimed) {
        if (names.len() == named) {
            break;
        }
        names.append(f.path);
    }
    var rest = "";
    if (unclaimed.len() > named) {
        rest = " and {files(unclaimed.len() - named)} more";
    }
    var why = "no target of this workspace declares";
    if (report.noWorkspace) {
        why = "no target declares, since no magus workspace holds `{dir}`";
    }
    if (unclaimed.len() == 1) {
        return "1 file changed here that {why}, so no run can check it: {names.join(", ")}\n"
            + "It does not block this push. Declaring it as a target's input is how it gets checked.";
    }
    return "{files(unclaimed.len())} changed here that {why}, so no run can check them: {names.join(", ")}{rest}\n"
        + "They do not block this push. Declaring each as a target's input is how it gets checked.";
}

// staleReaders names each target a remedy line runs whose run claims an unread file but ran
// while that file differed from the commit, once per target.
fun staleReaders(report: UnverifiedReport, checkable: [UnverifiedFile], remedy: [str]) > [str] {
    final unread = mut [<str>];
    foreach (f in checkable) {
        unread.append(f.path);
    }
    final found = mut [<str>];
    foreach (r in report.runs) {
        if (r.failed) {
            continue;
        }
        final label = "`{r.target} {r.project}`";
        if (found.indexOf(label) != null or !listedTarget(remedy, target: r.target, project: r.project)) {
            continue;
        }
        foreach (c in r.claims) {
            if (unread.indexOf(c) != null and r.reads.indexOf(c) == null) {
                found.append(label);
                break;
            }
        }
    }
    return found;
}

// listedTarget reports whether one of commands runs target in project, named bare or by
// its spell.
fun listedTarget(commands: [str], target: str, project: str) > bool {
    foreach (c in commands) {
        if (c.indexOf(" run {target} {project} ") != null or c.indexOf("::{target} {project} ") != null) {
            return true;
        }
    }
    return false;
}

// directory is the directory holding path, "." for one at the root.
fun directory(path: str) > str {
    final parts = path.split("/");
    if (parts.len() < 2) {
        return ".";
    }
    return parts.sub(0, len: parts.len() - 1).join("/");
}

// remedy is what reads every path of unread as committed, built from the paths: one lint
// over all of them, and one test run per Go package among them. <Name> stands for the tests
// that cover the change, which only the reader knows.
export fun remedy(unread: [str]) > [str] {
    final lines = mut ["./magus run lint . -- {unread.join(" ")}"];
    final packages = mut [<str>];
    foreach (path in unread) {
        final dir = directory(path);
        if (path.endsWith(".go") and packages.indexOf(dir) == null) {
            packages.append(dir);
        }
    }
    foreach (dir in packages) {
        var where = "./{dir}";
        if (dir == ".") {
            where = ".";
        }
        lines.append("./magus run go-test . -s -- -run '<Name>' {where}");
    }
    return lines;
}

fun unverifiedDenial(p: CommandPush, report: UnverifiedReport, checkable: [UnverifiedFile], unclaimed: [UnverifiedFile]) > str {
    final n = checkable.len();
    final lines = mut ["{published(p)} changes {files(n)} that no passing run has read as committed; {later()}: run the command on each line before you push"];
    final unread = mut [<str>];
    foreach (f in report.unverified) {
        unread.append(f.path);
    }
    final commands = remedy(unread);
    foreach (c in commands) {
        lines.append("  `{c}`");
    }
    if (commands.len() > 1) {
        lines.append("<Name> is a pattern for the tests that cover the change.");
    }
    var i = 0;
    foreach (f in checkable) {
        if (i == named) {
            lines.append("  and {files(n - named)} more");
            break;
        }
        lines.append("  unread: {f.path}");
        i = i + 1;
    }
    final stale = staleReaders(report, checkable: checkable, remedy: commands);
    if (stale.len() > 0) {
        lines.append("{stale.join(", ")} ran while some of these files differed from the commit, or before they last changed, so those runs do not count for them.");
    }
    if (unclaimed.len() > 0) {
        lines.append(unclaimedNote(unclaimed, report: report, dir: p.dir));
    }
    lines.append("A run counts when it passed and, as it ran, the file was the same as in {short(p.revision)}; only runs recorded in this checkout (`{p.dir}`) or on a job row count. The files are those changed since the merge base with {report.base}.");
    return lines.join("\n");
}

fun stub(report: UnverifiedReport, asked: mut [str]) > fun (dir: str, revision: str) > result\Result::<UnverifiedReport> {
    return fun (dir: str, revision: str) > result\Result::<UnverifiedReport> {
        asked.append(revision);
        return result\ok::<UnverifiedReport>(report);
    };
}

final pushed = CommandPush{ tool = "git", dir = "/w", revision = "0123456789abcdef0123" };

test "a line that publishes nothing is allowed without a read" {
    final asked = mut [<str>];
    std\assert(decidePush(null, read: stub(UnverifiedReport{}, asked: asked)).decision == magus\GuardDecision.defer, message: "no push");
    std\assert(asked.len() == 0, message: "read {asked.len()} times");
}

test "a push whose changed files a passing run read is allowed" {
    final asked = mut [<str>];
    final v = decidePush(pushed, read: stub(UnverifiedReport{ revision = pushed.revision, base = "origin/main", changed = ["a.go"] }, asked: asked));
    std\assert(v.decision == magus\GuardDecision.defer, message: v.reason);
    std\assert(asked.len() == 1 and asked[0] == pushed.revision, message: "the pushed revision is read");
}

test "a push with an unread file is advised naming it and the commands that read it" {
    final asked = mut [<str>];
    final report = UnverifiedReport{ revision = pushed.revision, base = "origin/main", changed = ["a.go", "b.md"],
        unverified = [UnverifiedFile{ path = "a.go", declared = true, commands = ["magus run go-test . -- -run 'A'"] }, UnverifiedFile{ path = "b.md" }] };
    final v = decidePush(pushed, read: stub(report, asked: asked));
    std\assert(v.decision == magus\GuardDecision.advise, message: "advised while advising");
    std\assert(verdict\checked(v, label: "an unread file").decision == v.decision, message: "a deny keeps the verdict shape");
    std\assert(v.reason.split("\n")[0] == "pushing 0123456789ab changes 1 file that no passing run has read as committed; this advises for now and will refuse later: run the command on each line before you push", message: v.reason);
    std\assert(v.reason.split("\n")[1] == "  `./magus run lint . -- a.go b.md`", message: v.reason);
    std\assert(v.reason.split("\n")[2] == "  `./magus run go-test . -s -- -run '<Name>' .`", message: v.reason);
    std\assert(v.reason.indexOf("  unread: a.go") != null, message: v.reason);
    std\assert(v.reason.indexOf("recorded in this checkout (`/w`)") != null, message: v.reason);
    std\assert(v.rule == "push-unverified", message: v.rule);
}

test "a file no target declares does not block and is named" {
    final report = UnverifiedReport{ revision = pushed.revision, base = "origin/main", changed = ["LICENSE"],
        unverified = [UnverifiedFile{ path = "LICENSE" }] };
    final v = decidePush(pushed, read: stub(report, asked: mut [<str>]));
    std\assert(v.decision == magus\GuardDecision.advise, message: v.decision.value);
    std\assert(v.reason.indexOf("1 file changed here that no target of this workspace declares, so no run can check it: LICENSE") != null, message: v.reason);
    std\assert(v.reason.indexOf("It does not block this push.") != null, message: v.reason);
}

test "two files no target declares are named in the plural" {
    final report = UnverifiedReport{ revision = pushed.revision, base = "origin/main", changed = ["LICENSE", "NOTICE"],
        unverified = [UnverifiedFile{ path = "LICENSE" }, UnverifiedFile{ path = "NOTICE" }] };
    final v = decidePush(pushed, read: stub(report, asked: mut [<str>]));
    std\assert(v.decision == magus\GuardDecision.advise, message: v.decision.value);
    std\assert(v.reason.indexOf("2 files changed here that no target of this workspace declares, so no run can check them: LICENSE, NOTICE") != null, message: v.reason);
    std\assert(v.reason.indexOf("They do not block this push.") != null, message: v.reason);
}

test "a declared file only a generator reads is unread, not undeclared" {
    final report = UnverifiedReport{ revision = pushed.revision, base = "origin/main", changed = ["a.go"],
        unverified = [UnverifiedFile{ path = "a.go", declared = true }] };
    final v = decidePush(pushed, read: stub(report, asked: mut [<str>]));
    std\assert(v.reason.indexOf("changes 1 file that no passing run") != null, message: v.reason);
    std\assert(v.reason.indexOf("  `./magus run lint . -- a.go`") != null, message: v.reason);
}

test "a checkout no magus workspace holds says so" {
    final report = UnverifiedReport{ revision = pushed.revision, base = "origin/main", changed = ["README.md"], noWorkspace = true,
        unverified = [UnverifiedFile{ path = "README.md" }] };
    final v = decidePush(pushed, read: stub(report, asked: mut [<str>]));
    std\assert(v.decision == magus\GuardDecision.advise, message: v.decision.value);
    std\assert(v.reason.indexOf("1 file changed here that no target declares, since no magus workspace holds `/w`, so no run can check it: README.md") != null, message: v.reason);
}

test "a reply names a file no target declares beside the ones to run" {
    final report = UnverifiedReport{ revision = pushed.revision, base = "origin/main",
        unverified = [UnverifiedFile{ path = "a.go", declared = true, commands = ["magus run test ."] }, UnverifiedFile{ path = "LICENSE" }] };
    final v = decidePush(pushed, read: stub(report, asked: mut [<str>]));
    std\assert(v.decision == magus\GuardDecision.advise, message: "advised while advising");
    std\assert(v.reason.indexOf("changes 1 file that no passing run") != null, message: "only the checkable file is counted: " + v.reason);
    std\assert(v.reason.indexOf("check it: LICENSE") != null and v.reason.indexOf("It does not block") != null, message: v.reason);
}

test "a reply names five files and counts the rest" {
    final many = mut [<UnverifiedFile>];
    foreach (name in ["a", "b", "c", "d", "e", "f", "g"]) {
        many.append(UnverifiedFile{ path = name, declared = true, commands = ["magus run test ."] });
    }
    final v = decidePush(pushed, read: stub(UnverifiedReport{ revision = pushed.revision, unverified = many }, asked: mut [<str>]));
    std\assert(v.reason.indexOf("  unread: e\n") != null and v.reason.indexOf("  unread: f") == null, message: v.reason);
    std\assert(v.reason.indexOf("  and 2 files more") != null, message: v.reason);
}

test "the remedy lints every unread path in one command" {
    final lines = remedy(["docs/a.md", "hack/policy/push.buzz", "LICENSE"]);
    std\assert(lines.len() == 1, message: lines.join("\n"));
    std\assert(lines[0] == "./magus run lint . -- docs/a.md hack/policy/push.buzz LICENSE", message: lines[0]);
}

test "the remedy runs each Go package's tests once" {
    final lines = remedy(["internal/guard/a.go", "internal/guard/a_test.go", "std/b.go", "c.go"]);
    std\assert(lines.len() == 4, message: lines.join("\n"));
    std\assert(lines[1] == "./magus run go-test . -s -- -run '<Name>' ./internal/guard", message: lines[1]);
    std\assert(lines[2] == "./magus run go-test . -s -- -run '<Name>' ./std", message: lines[2]);
    std\assert(lines[3] == "./magus run go-test . -s -- -run '<Name>' .", message: lines[3]);
}

test "the remedy names neither a generator nor one command per file" {
    final report = UnverifiedReport{ revision = pushed.revision, unverified = [
        UnverifiedFile{ path = "internal/a.go", declared = true, commands = ["magus run go-api-generate .", "magus run lint . -- internal/a.go"] },
        UnverifiedFile{ path = "internal/b.go", declared = true, commands = ["magus run lint . -- internal/b.go"] },
    ] };
    final v = decidePush(pushed, read: stub(report, asked: mut [<str>]));
    std\assert(v.reason.indexOf("go-api-generate") == null, message: v.reason);
    std\assert(v.reason.indexOf("lint . -- internal/a.go`") == null, message: "one lint for both: " + v.reason);
    std\assert(v.reason.indexOf("  `./magus run lint . -- internal/a.go internal/b.go`") != null, message: v.reason);
}

test "a run that claims the file but did not read it as committed is named once" {
    final report = UnverifiedReport{ revision = pushed.revision, unverified = [UnverifiedFile{ path = "a.go", declared = true, commands = ["magus run go-test ."] }],
        runs = [RunEvidence{ ref = "out1", project = ".", target = "go-test", dirty = true, claims = ["a.go"] },
                RunEvidence{ ref = "out2", project = ".", target = "go-test", dirty = true, claims = ["a.go"] }] };
    final v = decidePush(pushed, read: stub(report, asked: mut [<str>]));
    std\assert(v.reason.indexOf("`go-test .` ran while some of these files differed from the commit") != null, message: v.reason);
    std\assert(v.reason.split("`go-test .` ran while").len() == 2, message: "named once: " + v.reason);
}

test "a run of a target no listed command runs is not named" {
    final report = UnverifiedReport{ revision = pushed.revision, unverified = [UnverifiedFile{ path = "a.go", declared = true, commands = ["magus run go-test ."] }],
        runs = [RunEvidence{ ref = "out1", project = ".", target = "vet", dirty = true, claims = ["a.go"] }] };
    final v = decidePush(pushed, read: stub(report, asked: mut [<str>]));
    std\assert(v.reason.indexOf("`vet .`") == null, message: v.reason);
}

test "a read that did not finish is advised as unjudged with its reason" {
    final v = decidePush(pushed, read: stub(UnverifiedReport{ unknown = "the output store is unread: permission denied" }, asked: mut [<str>]));
    std\assert(v.decision == magus\GuardDecision.advise, message: "advised while advising");
    std\assert(verdict\checked(v, label: "an unfinished read").decision == v.decision, message: "a deny keeps the verdict shape");
    std\assert(v.reason.split("\n")[1] == "the output store is unread: permission denied", message: v.reason);
    std\assert(v.reason.split("\n")[0] == "magus could not finish checking this push's changed files against the recorded runs; this advises for now and will refuse later:", message: v.reason);
    std\assert(v.reason.split("\n")[2] == "Nothing on the line is wrong. Run it again; if the same reason comes back twice, report it and stop.", message: v.reason);
}

test "a read that raised is advised as unjudged" {
    final raised = fun (dir: str, revision: str) > result\Result::<UnverifiedReport> {
        return result\fail::<UnverifiedReport>("magus\\workspace(`/w`).unverified: no workspace");
    };
    final v = decidePush(pushed, read: raised);
    std\assert(v.decision == magus\GuardDecision.advise and v.reason.indexOf("no workspace") != null, message: v.reason);
}

test "a push whose revision is unknown is advised as unjudged without a read" {
    final asked = mut [<str>];
    final moved = CommandPush{ tool = "git", dir = "/w", unknown = "this line runs `git commit` before it pushes, so the revision it publishes exists only once the line runs" };
    final v = decidePush(moved, read: stub(UnverifiedReport{}, asked: asked));
    std\assert(v.decision == magus\GuardDecision.advise and asked.len() == 0, message: v.reason);
    std\assert(v.reason.indexOf("`git commit` before it pushes") != null, message: v.reason);
    std\assert(v.reason.split("\n")[0] == "magus cannot tell, before the line runs, which commit this push publishes; this advises for now and will refuse later:", message: v.reason);
    std\assert(v.reason.split("\n")[2] == "Run the push as one call of its own, naming one revision in literal words.", message: v.reason);
}

test "a pull request call is worded as opening one" {
    final pr = CommandPush{ tool = "gh", dir = "/w", revision = "0123456789abcdef0123", opensPullRequest = true };
    final report = UnverifiedReport{ revision = pr.revision, unverified = [UnverifiedFile{ path = "a.go", declared = true, commands = ["magus run test ."] }] };
    final v = decidePush(pr, read: stub(report, asked: mut [<str>]));
    std\assert(v.reason.split("\n")[0].startsWith("opening a pull request at 0123456789ab changes 1 file"), message: v.reason);
}
