// The pull-request-text rule: the text a forge command posts to a pull request, either its
// title and description (the change-description kind) or a review comment, a review's body
// or a reply in a thread (review-reply). COMMANDS says which command writes which kind, and
// through which flags.
//
// The words are judged by libs/conventions/proofread under this repository's decisions table
// (hack/policy/proofread.buzz), with any OUTSIDE_JUDGES beside it. A finding decided deny is
// denied, every one listed with its rule; one decided advise is told once per pull request.
// The pr-description CI step runs judgeText too, so the guard and CI reach one decision.
// This rule keeps what proofread does not read: the spaced hyphen, the word budget, the
// shape past the lead, the areas the diff touches and the title. When the text cannot be
// read, the whole line is judged for credit and typography instead.
//
// A description gets a word budget that grows with the change, counted after its lead so a
// cut never removes the outcome or how the work came up: W = baseWords + wordsPerChange * U,
// where U, the distinct changes the branch proves, is at least 1 and the largest of:
//   the changelog fragments it adds or edits, plus one for a title marked breaking;
//   the clauses its title joins with `;`;
//   1 + floor(log2(1 + shipped source files));
//   1 + floor(log2(1 + changed lines / linesPerChange)), over every path not generated.
// Each term is a lower bound on what a reviewer must check. The paths and lines come from
// vcs\diffStat against the base, read for a description of the checkout's own branch. When
// the diff cannot be read (no base, a failed or empty diff, or a call about another
// branch's pull request) its terms count as 1 and a description over the budget is
// advised, never denied: the denial would rest on a fact nobody read. A hook that runs out
// of time fails open as a whole, as every rule does.
//
// The shape past the lead: bullets (a list may follow a one-line lead-in ending in `:`),
// at most one closing sentence after them, and headed sections, whose prose is free. Prose
// outside that shape, a lead or bullet past blockWords, and an area the diff touches that
// the description never names are advised, once per pull request.
namespace agentpolicy\pullRequests;

import "std";
import "magus";
import "vcs";
import "proc";
import "fs";
import "path";
import "encoding/json";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/commits" as subjects;
import "./hack/policy/proofread" as decisions;
import "./hack/magusfile/commits" as conventional;
import "./hack/magusfile/changelog" as entries;
import "./libs/conventions/proofread" as proofread;

final descriptionKind = "change-description";
final replyKind = "review-reply";

// example is the shape a denial teaches, since an agent sees only the denial text.
final example = "    fix(cache): sort the key's inputs before hashing\n"
    + "    Warm builds hit the cache again. A failing CI run showed the key hashing its inputs\n"
    + "    in map order, so two runs of one tree missed each other's entries.\n"
    + "\n"
    + "    - The key sorts its inputs before hashing them.\n"
    + "    - `TestKeyStable` pins one key across 50 runs.";
final fixLine = "Rewrite it in this shape: a conventional title, then a lead paragraph whose first "
    + "sentence says what a reader can now do or no longer has to do, followed by how the work "
    + "came up and why it mattered; then one present-tense bullet per change, with the code as "
    + "the subject; headed sections (Why this approach, Evidence, Not verified) only when they "
    + "carry something. Keep it within the budget the change earns, in plain ASCII, with no "
    + "credit to a tool or an agent. For example:\n" + example;
final shapeLine = "The shape: a lead paragraph with the outcome and how the work came up, one bullet "
    + "per change, then headed sections only where they carry something. This is said once per "
    + "pull request. For example:\n" + example;
final replyLine = "Rewrite the reply: acknowledge the point it answers, state what you know with its "
    + "evidence, label a judgment call and give its reason, and ask where you do not know. For "
    + "example: \"I'd move the retry into the client: the upstream drops about 1% of calls. "
    + "Open to keeping it here if you see a cleaner seam.\"";

// The budget's constants, each a norm this repository or its sources already set.
// wordsPerChange is the 60-word changelog fragment cap (changelogEntryWordCap in
// cmd/magus-utils/release.go) less its bold headline; linesPerChange is Google's "100
// lines is usually a reasonable size" for one change (eng-practices, small CLs).
// baseWords is blockWords, room for a section such as Not verified beside the bullets.
final baseWords = 60;
final wordsPerChange = 50;
final linesPerChange = 100;
// A lead or bullet past the fragment cap is carrying more than one change.
final blockWords = 60;
// A line whose text could not be read past this length is judged long anyway.
final maxLine = 3000;
// The judge's rules that read a whole command line sensibly when its text could not be
// read: credit to a tool, and typography.
final lineRules = ["attribution", "dash", "ascii"];

final spacedHyphen = $"\S - \S";
final word = $"\S+";
final heading = $"^ {0,3}#{1,6}(\s|$)";
final bullet = $"^\s*([-*+]|[0-9]+[.)])\s";
final codeSpan = $"`[^`]*`";
final sentenceEnd = $"[.!?]+(\s|$)";
final sourceLine = $":([0-9]+)$";
final outputRef = $"\bout[0-9a-f]{6,}\b";
final maxCitedRefs = 10;

// TextCommand is one forge command that posts text to a pull request: the program and the
// words naming the command, the kind of text it writes, and the flags carrying it. title,
// body and bodyFile hold flags whose value is the title, the text, or a file holding the
// text. fields hold the flags of a raw API call taking `name=value`, where `body=` carries
// the text and `body=@file` names a file; endpoint is the pattern the call's path must
// match. base and head name the branches a description's pull request merges, which decide
// whether the checkout's diff is its diff. values are every other flag taking a value, so
// what remains names the pull request.
export object TextCommand {
    program: str,
    command: [str],
    kind: str,
    title: [str] = [<str>],
    body: [str] = [<str>],
    bodyFile: [str] = [<str>],
    fields: [str] = [<str>],
    endpoint: str = "",
    base: [str] = [<str>],
    head: [str] = [<str>],
    values: [str] = [<str>],
}

// COMMANDS is every command this rule reads. Adding a forge is a row.
final COMMANDS = [
    TextCommand{ program = "gh", command = ["pr", "create"], kind = descriptionKind,
        title = ["--title", "-t"], body = ["--body", "-b"], bodyFile = ["--body-file", "-F"],
        base = ["--base", "-B"], head = ["--head", "-H"],
        values = ["-R", "--repo", "-a", "--assignee", "-l", "--label", "-m", "--milestone", "-p", "--project",
            "-r", "--reviewer", "-T", "--template"] },
    TextCommand{ program = "gh", command = ["pr", "edit"], kind = descriptionKind,
        title = ["--title", "-t"], body = ["--body", "-b"], bodyFile = ["--body-file", "-F"],
        base = ["--base", "-B"],
        values = ["-R", "--repo", "-m", "--milestone", "--add-label", "--remove-label",
            "--add-reviewer", "--remove-reviewer", "--add-assignee", "--remove-assignee",
            "--add-project", "--remove-project"] },
    TextCommand{ program = "gh", command = ["pr", "comment"], kind = replyKind,
        body = ["--body", "-b"], bodyFile = ["--body-file", "-F"], values = ["-R", "--repo"] },
    TextCommand{ program = "gh", command = ["pr", "review"], kind = replyKind,
        body = ["--body", "-b"], bodyFile = ["--body-file", "-F"], values = ["-R", "--repo"] },
    // A review comment, a reply to one, a review, or a comment on the pull request's
    // conversation, posted through the REST API.
    TextCommand{ program = "gh", command = ["api"], kind = replyKind,
        fields = ["-f", "--raw-field", "-F", "--field"],
        endpoint = `(^|/)(pulls/[0-9]+/(comments|reviews)|pulls/[0-9]+/comments/[0-9]+/replies|pulls/[0-9]+/reviews/[0-9]+/events|issues/[0-9]+/comments)$`,
        values = ["-X", "--method", "-H", "--header", "-q", "--jq", "-t", "--template", "--input",
            "--hostname", "--cache", "-p", "--preview"] },
    TextCommand{ program = "glab", command = ["mr", "create"], kind = descriptionKind,
        title = ["--title", "-t"], body = ["--description", "-d"],
        base = ["--target-branch", "-b"], head = ["--source-branch", "-s"],
        values = ["-R", "--repo", "-a", "--assignee", "-l", "--label", "-m", "--milestone", "--reviewer"] },
    TextCommand{ program = "glab", command = ["mr", "update"], kind = descriptionKind,
        title = ["--title", "-t"], body = ["--description", "-d"], base = ["--target-branch"],
        values = ["-R", "--repo", "-a", "--assignee", "-l", "--label", "-u", "--unlabel", "-m", "--milestone",
            "--reviewer"] },
    TextCommand{ program = "glab", command = ["mr", "note"], kind = replyKind,
        body = ["--message", "-m"], values = ["-R", "--repo"] },
];

// OutsideJudge is a command that judges text the way proofread does: it reads the text on
// stdin and writes one JSON array of findings on stdout, {source, rule, decision, message,
// match, url} at least, and exits 0 whatever it found. Its findings join proofread's under
// the same decisions table, so a rule it names that the table decides takes the table's
// decision. kinds are the text kinds it judges.
export object OutsideJudge {
    argv: [str],
    kinds: [str],
}

// OUTSIDE_JUDGES is empty here: libs/conventions/proofread is this repository's only judge.
export final OUTSIDE_JUDGES = [<OutsideJudge>];

// matchCommand is the row of COMMANDS p runs, or null.
fun matchCommand(p: helpers\Program) > TextCommand? {
    foreach (c in COMMANDS) {
        if (p.name != c.program) {
            continue;
        }
        final ops = helpers\stripFlags(p.args, valueFlags: flagsIn(c));
        if (ops.len() < c.command.len()) {
            continue;
        }
        var same = true;
        foreach (i, w in c.command) {
            if (ops[i] != w) {
                same = false;
            }
        }
        if (!same) {
            continue;
        }
        if (c.endpoint != "" and (ops.len() <= c.command.len() or std\pattern(c.endpoint).match(ops[c.command.len()]) == null)) {
            continue;
        }
        return c;
    }
    return null;
}

// writesText reports whether p is a command of COMMANDS carrying text.
export fun writesText(p: helpers\Program) > bool {
    final c = matchCommand(p);
    if (c == null) {
        return false;
    }
    if (fieldValues(p.args, flags: c!.fields).len() > 0) {
        return true;
    }
    foreach (arg in p.args) {
        foreach (flag in c!.title + c!.body + c!.bodyFile) {
            if (arg == flag or arg.startsWith(flag + "=")) {
                return true;
            }
        }
    }
    return false;
}

// Value is one text flag's value and, when it is the next argument, that argument's index.
object Value {
    text: str,
    slot: int?,
}

// flagValues are the values given to any of flags, in order.
fun flagValues(args: [str], flags: [str]) > [Value] {
    final found = mut [<Value>];
    foreach (i, arg in args) {
        foreach (flag in flags) {
            if (arg == flag and i + 1 < args.len()) {
                found.append(Value{ text = args[i + 1], slot = i + 1 });
            } else if (arg.startsWith(flag + "=")) {
                found.append(Value{ text = arg.sub(flag.len() + 1), slot = null });
            }
        }
    }
    return found;
}

// fieldValues are the `body=` values given to any of flags, the prefix left out.
fun fieldValues(args: [str], flags: [str]) > [Value] {
    final found = mut [<Value>];
    foreach (v in flagValues(args, flags: flags)) {
        if (v.text.startsWith("body=")) {
            found.append(Value{ text = v.text.sub(5), slot = null });
        }
    }
    return found;
}

// textSlots are the arguments of p holding a title or text the parser rendered empty, a
// substitution such as `--body "$(cat <<'EOF' ...)"`.
export fun textSlots(p: helpers\Program) > [int] {
    final slots = mut [<int>];
    final c = matchCommand(p);
    if (c == null or !writesText(p)) {
        return slots;
    }
    foreach (v in flagValues(p.args, flags: c!.title + c!.body)) {
        if (v.text == "" and v.slot != null) {
            slots.append(v.slot!);
        }
    }
    return slots;
}

// bodyFiles are the files the line's commands read their text from, `-` (stdin) left out.
export fun bodyFiles(programs: [helpers\Program]) > [str] {
    final paths = mut [<str>];
    foreach (p in programs) {
        if (writesText(p)) {
            final file = textFile(p);
            if (file != null and file! != "" and file! != "-") {
                paths.append(file!);
            }
        }
    }
    return paths;
}

// textFile is the file p reads its text from: a body-file flag's, or an API field's
// `body=@file`. null when p names none.
fun textFile(p: helpers\Program) > str? {
    final c = matchCommand(p);
    if (c == null) {
        return null;
    }
    final named = last(flagValues(p.args, flags: c!.bodyFile));
    if (named != null) {
        return named;
    }
    final field = last(fieldValues(p.args, flags: c!.fields));
    if (field != null and field!.startsWith("@")) {
        return field!.sub(1);
    }
    return null;
}

fun last(values: [Value]) > str? {
    if (values.len() == 0) {
        return null;
    }
    return values[values.len() - 1].text;
}

// Facts is what the branch a pull request is opened from changed against its base: the
// changelog fragments it adds or edits, the shipped source files it touches, and the lines
// it adds and deletes outside generated files. known is false when the diff could not be
// read, and the counts are then zero. paths are the changed paths outside generated
// files, and areas the projects and top-level packages they sit in (see touchedAreas),
// which only branchDiff fills.
export object Facts {
    known: bool,
    fragments: int,
    shipped: int,
    lines: int,
    paths: [str] = [<str>],
    areas: [str] = [<str>],
}

export fun unknownFacts() > Facts {
    return Facts{ known = false, fragments = 0, shipped = 0, lines = 0 };
}

// generated reports a path a generator writes, which proves nothing about what changed:
// one under a gen/ directory, or an index or lockfile regenerated with its sources.
fun generated(path: str) > bool {
    if (path.startsWith("gen/") or path.indexOf("/gen/") != null) {
        return true;
    }
    final parts = path.split("/");
    return ["MAGUS.md", "go.sum", "magus.lock", "pnpm-lock.yaml"].indexOf(parts[parts.len() - 1]) != null;
}

// statFacts reads vcs\diffStat's records. A fragment counts only when lines were added to
// it, so one a release folds and deletes does not; a binary file is a path with no lines.
// An empty diff is unknown, since a pull request always changes something.
export fun statFacts(stats: [FileStat]) > Facts {
    var fragments = 0;
    var shipped = 0;
    var lines = 0;
    final sources = mut [<str>];
    foreach (s in stats) {
        if (entries\fragments([s.path]).len() > 0 and s.added > 0) {
            fragments = fragments + 1;
        }
        if (!generated(s.path)) {
            sources.append(s.path);
            lines = lines + s.added + s.deleted;
            if (entries\ships(s.path)) {
                shipped = shipped + 1;
            }
        }
    }
    if (stats.len() == 0) {
        return unknownFacts();
    }
    return Facts{ known = true, fragments = fragments, shipped = shipped, lines = lines, paths = sources };
}

// The section of .gitattributes magus writes from every project's declared outputs, per
// target ctx.writesFiles included (internal/settle DriverGlobs). An output line sets
// linguist-generated; a tracked file an output's exclusion carves back out follows as
// `!linguist-generated`; a vcs.auto_resolve line sets merge=magus alone and is source.
final attributesFile = ".gitattributes";
final attributesBegin = "# BEGIN magus-generated";
final attributesEnd = "# END magus-generated";

// OutputAttributes are the patterns of that section, workspace-relative. managed is false
// when the file carries no section, and then nothing is known to be generated.
export object OutputAttributes {
    managed: bool,
    outputs: [str],
    carved: [str],
}

// outputAttributes reads the managed section of a .gitattributes file's text.
export fun outputAttributes(text: str) > OutputAttributes {
    final outputs = mut [<str>];
    final carved = mut [<str>];
    var managed = false;
    var inside = false;
    foreach (raw in text.split("\n")) {
        final row = raw.trim();
        if (row.startsWith(attributesBegin)) {
            managed = true;
            inside = true;
            continue;
        }
        if (row.startsWith(attributesEnd)) {
            inside = false;
            continue;
        }
        if (!inside or row == "" or row.startsWith("#")) {
            continue;
        }
        final fields = row.split(" ");
        var pattern = fields[0];
        // magus anchors a slashless pattern with a leading `/`; a doublestar glob is rooted
        // already.
        if (pattern.startsWith("/")) {
            pattern = pattern.sub(1);
        }
        if (fields.indexOf("linguist-generated") != null) {
            outputs.append(pattern);
        } else if (fields.indexOf("!linguist-generated") != null) {
            carved.append(pattern);
        }
    }
    return OutputAttributes{ managed = managed, outputs = outputs, carved = carved };
}

// The directory names the workspace load never descends, as internal/describe
// loadSkipDirs lists them: a magusfile under one belongs to another tree.
final skippedDirs = [".claude", ".git", ".hg", ".jj", ".magus", ".sl", "__pycache__", "dist", "node_modules", "target", "vendor"];

// projectRoot reports whether dir, workspace-relative, is a project's root by the rule
// internal/describe IsProjectRoot applies: it holds magusfile.buzz, magus.yaml, or a
// magusfiles/ directory with a .buzz file in it. A project a workspace provider reports
// has no such file, and its paths fall to the project above it.
fun projectRoot(workspace: str, dir: str) > bool {
    foreach (seg in dir.split("/")) {
        if (skippedDirs.indexOf(seg) != null) {
            return false;
        }
    }
    final abs = "{workspace}/{dir}";
    if ((fs\isFile("{abs}/magusfile.buzz") catch false) or (fs\isFile("{abs}/magus.yaml") catch false)) {
        return true;
    }
    if (!(fs\isDir("{abs}/magusfiles") catch false)) {
        return false;
    }
    foreach (name in fs\listDir("{abs}/magusfiles") catch [<str>]) {
        if (name.endsWith(".buzz")) {
            return true;
        }
    }
    return false;
}

// classify gives each path the record `magus describe file` would, {path, project, role},
// read in process: magus\describe.file runs a nested magus, which took 10s over 500 paths
// against the guard's 3s rule timeout, and a rule out of time fails open whole. role is "output" for a path the managed .gitattributes section marks
// generated, "maintained" for that .gitattributes itself (types.IsMagusMaintained), and
// "source" otherwise; project is the nearest project root above the path. Lockfiles are
// left to touchedAreas, which knows them by name.
export fun classify(workspace: str, paths: [str]) > [any] {
    final attrs = outputAttributes(fs\readFile("{workspace}/{attributesFile}") catch "");
    final roots = mut {<str: bool>};
    final files = mut [<any>];
    foreach (p in paths) {
        var role = "source";
        if (p == attributesFile and attrs.managed) {
            role = "maintained";
        } else if ((path\matchesAny(attrs.outputs, path: p) catch false) and !(path\matchesAny(attrs.carved, path: p) catch false)) {
            role = "output";
        }
        var project = ".";
        final parts = p.split("/");
        var depth = parts.len() - 1;
        while (depth > 0) {
            final dir = parts.sub(0, len: depth).join("/");
            if (roots[dir] == null) {
                roots[dir] = projectRoot(workspace, dir: dir);
            }
            if (roots[dir]!) {
                project = dir;
                break;
            }
            depth = depth - 1;
        }
        files.append({"path": p, "project": project, "role": role});
    }
    return files;
}

// changedAreas returns the areas touchedAreas finds among paths, changed in the checkout at
// workspace.
export fun changedAreas(workspace: str, paths: [str]) > [str] {
    return touchedAreas(classify(workspace, paths: paths));
}

// touchedAreas names the areas a change touches, from records shaped as `magus describe
// file` prints them (see classify): the owning project, or for the root project the top
// two directories of the path (a top-level package such as `internal/guard`). Generated
// outputs, files magus maintains, lockfiles and changelog fragments are left out: each
// follows from another change, so none asks a question of its own.
export fun touchedAreas(files: [any]) > [str] {
    final areas = mut [<str>];
    foreach (f in files) {
        final path: str = f["path"] ?? "";
        final role: str = f["role"] ?? "";
        final project: str = f["project"] ?? ".";
        if (path == "" or role == "output" or role == "maintained" or generated(path)
            or entries\fragments([path]).len() > 0) {
            continue;
        }
        var area = project;
        if (project == "." or project == "") {
            final parts = path.split("/");
            if (parts.len() > 2) {
                area = parts[0] + "/" + parts[1];
            } else {
                area = parts[0];
            }
        }
        if (areas.indexOf(area) == null) {
            areas.append(area);
        }
    }
    return areas;
}

// unnamedAreas are the areas text never names, by their path or by their last segment
// without its extension, so "the guard" names internal/guard.
export fun unnamedAreas(areas: [str], text: str) > [str] {
    final lower = text.lower();
    final unnamed = mut [<str>];
    foreach (area in areas) {
        final parts = area.split("/");
        final base = parts[parts.len() - 1].split(".")[0];
        if (lower.indexOf(area.lower()) == null and (base == "" or lower.indexOf(base.lower()) == null)) {
            unnamed.append(area);
        }
    }
    return unnamed;
}

// areaQuestions asks of each unnamed area what a reviewer asks first.
export fun areaQuestions(unnamed: [str]) > [str] {
    final asked = mut [<str>];
    foreach (area in unnamed) {
        asked.append("why does this touch {area}? The description never names it; say why, or ignore this if it is plain");
    }
    return asked;
}

// branchDiff reads the Facts of the checkout's branch at workspace: vcs\diffStat over the
// commits a pull request carries, which every backend magus drives can count.
// vcs\changedFiles is not used because it diffs the working tree. base is the pull
// request's --base, "" when it names none; one other than the repository's base is unknown
// rather than guessed.
export fun branchDiff(workspace: str) > fun (base: str) > Facts {
    return fun (base: str) > Facts {
        final ref = vcs\base(workspace) catch "";
        if (ref == "" or (base != "" and ref != base and !ref.endsWith("/" + base))) {
            return unknownFacts();
        }
        final stats = vcs\diffStat(ref, dir: workspace) catch null;
        if (stats == null) {
            return unknownFacts();
        }
        final facts = statFacts(stats!);
        return Facts{ known = facts.known, fragments = facts.fragments, shipped = facts.shipped,
            lines = facts.lines, paths = facts.paths, areas = changedAreas(workspace, paths: facts.paths) };
    };
}

// Judged is one finding of a judge, in the findings JSON libs/conventions/readme.md
// describes: line counts from the first line of the text judged, 0 when the finding has
// none, and decision is "deny" or "advise".
export object Judged {
    rule: str,
    line: int,
    message: str,
    matched: str = "",
    decision: str = "deny",
    url: str = "",
}

// judgeRunner returns a judge that runs the built libs/conventions/cmd/proofread over text
// of a kind, under this repository's decisions table, and then each of OUTSIDE_JUDGES that
// judges the kind. The judge lives in Go, where the Markdown lint and the CI step reach the
// same rules; a judge that is missing, stale or did not run is a finding, since silence
// would read as a pass.
export fun judgeRunner(workspace: str) > fun (text: str, kind: str) > [Judged] {
    final dir = "{workspace}/{proofread\home}";
    return fun (text: str, kind: str) > [Judged] {
        final notRunnable = proofread\whyStale(dir);
        if (notRunnable != "") {
            return [Judged{ rule = "judge", line = 0,
                message = "proofread cannot run: {notRunnable}; run `{proofread\build}`, then retry" }];
        }
        final table = decisions\writeDecisions([<str>]) catch "";
        if (table == "") {
            return [Judged{ rule = "judge", line = 0,
                message = "proofread cannot run: its decisions file could not be written to a temp dir" }];
        }
        // No dir: proc\exec resolves a relative cmd against dir, which names libs/conventions
        // twice when workspace is relative (the pr-description target passes "."), so the
        // judge must run from the path stale checked.
        final bin = "{dir}/{proofread\binary}";
        final found = mut [<Judged>];
        final run = proc\exec(bin, args: [kind, "-decisions", table],
            opts: {"stdin": text, "quiet": true, "allow_failure": true}) catch null;
        fs\remove(table) catch void;
        if (run == null or run!.code != 0) {
            var why = "{bin} did not start";
            if (run != null) {
                why = judgeFailure(code: run!.code, stdout: run!.stdout, stderr: run!.stderr, bin: bin);
            }
            found.append(Judged{ rule = "judge", line = 0,
                message = "proofread did not run ({why}); run {proofread\home}/{proofread\binary} {kind} "
                    + "with the text on stdin, and read why" });
        } else {
            foreach (f in parseJudged(run!.stdout)) {
                found.append(f);
            }
        }
        foreach (outside in OUTSIDE_JUDGES) {
            if (outside.kinds.indexOf(kind) != null) {
                foreach (f in outsideFindings(outside, text: text)) {
                    found.append(f);
                }
            }
        }
        return found;
    };
}

// outsideFindings runs one outside judge over text. Its findings take this repository's
// decisions, and one decided off is dropped; a judge that fails is a finding, as
// proofread failing is.
fun outsideFindings(outside: OutsideJudge, text: str) > [Judged] {
    final run = proc\exec(outside.argv[0], args: outside.argv.sub(1),
        opts: {"stdin": text, "quiet": true, "allow_failure": true}) catch null;
    if (run == null or run!.code != 0) {
        var why = "it did not start";
        if (run != null) {
            why = "it exited {run!.code}: {run!.stderr.trim()}";
        }
        return [Judged{ rule = "judge", line = 0, message = "the judge `{outside.argv.join(" ")}` did not run ({why})" }];
    }
    final kept = mut [<Judged>];
    foreach (f in parseJudged(run!.stdout)) {
        final decision = decisions\decide(f.rule, given: f.decision);
        if (decision != "off") {
            kept.append(Judged{ rule = f.rule, line = f.line, message = f.message, matched = f.matched,
                decision = decision, url = f.url });
        }
    }
    return kept;
}

// judgeFailure names why the judge at bin exited non-zero. With allow_failure, proc\exec
// reports both a process that never started and one a signal ended as exit -1 and drops
// the error, so an empty stderr falls back to the exit code, stdout, and what the policy
// can test for itself: whether bin exists and is executable.
export fun judgeFailure(code: int, stdout: str, stderr: str, bin: str) > str {
    if (stderr.trim() != "") {
        return stderr.trim();
    }
    var why = "proofread exited {code} with nothing on stderr";
    if (code == -1) {
        final info = fs\stat(bin) catch null;
        if (info == null or info!.is_dir) {
            why = "{why}: it never started, since {bin} does not exist";
        } else if ((info!.mode & 0b001001001) == 0) {
            why = "{why}: it never started, since {bin} is not executable";
        } else {
            why = "{why}: {bin} is an executable file, so a signal ended it or the system refused to load it";
        }
    }
    if (stdout.trim() != "") {
        why = "{why}; stdout: {stdout.trim()}";
    }
    return why;
}

// parseJudged reads a judge's findings, whose source ends in `:<line>`.
export fun parseJudged(stdout: str) > [Judged] {
    final rows: [any] = json\parse(stdout) catch [<any>];
    final found = mut [<Judged>];
    foreach (r in rows) {
        final source: str = r["source"] ?? "";
        var line = 0;
        final at = sourceLine.match(source);
        if (at != null) {
            line = std\parseInt(at![1]) ?? 0;
        }
        final decision: str = r["decision"] ?? "deny";
        found.append(Judged{ rule = r["rule"] ?? "", line = line, message = r["message"] ?? "", matched = r["match"] ?? "",
            decision = decision, url = r["url"] ?? "" });
    }
    return found;
}

// judgedProblem renders a finding as a verdict line. A description is judged with its
// title on line 1 and its description after it, counted from the description's first line;
// a reply is counted from its own first line.
export fun judgedProblem(f: Judged, kind: str) > str {
    if (kind == descriptionKind and f.line == 1) {
        return "the title: {f.message} [{f.rule}]";
    }
    if (kind == descriptionKind and f.line > 1) {
        return "description line {f.line - 1}: {f.message} [{f.rule}]";
    }
    if (f.line > 0) {
        return "line {f.line}: {f.message} [{f.rule}]";
    }
    return "{f.message} [{f.rule}]";
}

// Units is the count of distinct changes a pull request proves, with each term it is the
// largest of, so a verdict can say why.
export object Units {
    count: int,
    breaking: bool,
    clauses: int,
    files: int,
    lines: int,
    facts: Facts,
}

// floorLog2 is floor(log2(n)) for n >= 1.
fun floorLog2(n: int) > int {
    var k = 0;
    var v = n;
    while (v > 1) {
        v = v / 2;
        k = k + 1;
    }
    return k;
}

// countUnits counts the changes a pull request titled title proves. An unknown diff's terms
// count as 1.
export fun countUnits(title: str, facts: Facts) > Units {
    final breaking = conventional\isBreaking(title);
    var fragments = facts.fragments;
    if (breaking) {
        fragments = fragments + 1;
    }
    final clauses = title.split(";").len();
    final files = 1 + floorLog2(1 + facts.shipped);
    // Integer division keeps the floor exact: every power of two is a whole number.
    final lines = 1 + floorLog2((linesPerChange + facts.lines) / linesPerChange);
    var count = 1;
    foreach (term in [fragments, clauses, files, lines]) {
        if (term > count) {
            count = term;
        }
    }
    return Units{ count = count, breaking = breaking, clauses = clauses, files = files, lines = lines, facts = facts };
}

export fun wordBudget(units: Units) > int {
    return baseWords + wordsPerChange * units.count;
}

fun plural(n: int, noun: str) > str {
    if (n == 1) {
        return "1 {noun}";
    }
    return "{n} {noun}s";
}

// overBudget names a description of words words after its lead past its budget, and what
// U counted.
fun overBudget(words: int, units: Units) > str {
    final u = units.count;
    final f = units.facts;
    var breaking = "";
    if (units.breaking) {
        breaking = " plus 1 for the breaking title";
    }
    var terms = "{plural(units.clauses, noun: "title clause")}";
    if (f.known) {
        terms = "{plural(f.fragments, noun: "changelog fragment")}{breaking}, " + terms
            + ", {plural(f.shipped, noun: "shipped source file")} (counting {units.files}) and "
            + "{plural(f.lines, noun: "changed line")} outside generated files (counting {units.lines})";
    } else if (units.breaking) {
        terms = terms + ", 1 for the breaking title";
    }
    var read = "";
    if (!f.known) {
        read = "; the branch's diff against its base could not be read, so it counts as 1 and this is advice, not a denial";
    }
    return "{words} words after the lead, past this pull request's budget of {wordBudget(units)} "
        + "({baseWords} + {wordsPerChange} for each of {plural(u, noun: "change")}, "
        + "the most of {terms}){read}. Cut it to what a reviewer needs to review it, or split the "
        + "pull request if it carries more changes than that";
}
// Block is one blank-line-separated block of a description: a paragraph, a list, a
// heading or a code fence.
object Block {
    kind: str,
    lines: [str],
}

// splitBlocks splits body into blocks. A heading is its own block, a list may follow a
// paragraph line directly (`Inside the box:` then `- ...`), and a line after a bullet
// continues it until a blank line.
fun splitBlocks(body: str) > [Block] {
    final blocks = mut [<Block>];
    var current = mut [<str>];
    var kind = "";
    var fence = "";
    final flush = fun () > void {
        if (current.len() > 0) {
            blocks.append(Block{ kind = kind, lines = current });
            current = mut [<str>];
        }
    };
    foreach (line in body.split("\n")) {
        final trimmed = line.trim();
        if (fence != "") {
            if (trimmed.startsWith(fence)) {
                fence = "";
            }
        } else if (trimmed.startsWith("```") or trimmed.startsWith("~~~")) {
            flush();
            blocks.append(Block{ kind = "code", lines = [trimmed] });
            fence = trimmed.sub(0, len: 3);
        } else if (trimmed == "") {
            flush();
        } else if (heading.match(line) != null) {
            flush();
            blocks.append(Block{ kind = "heading", lines = [trimmed] });
        } else if (bullet.match(line) != null and kind != "list") {
            flush();
            kind = "list";
            current.append(line);
        } else {
            if (current.len() == 0) {
                kind = "paragraph";
            }
            current.append(line);
        }
    }
    flush();
    return blocks;
}

fun wordsIn(text: str) > int {
    return (word.matchAll(text) ?? [<[str]>]).len();
}

// listItems are a list block's bullets, each with its continuation lines, marker left out.
fun listItems(list: Block) > [str] {
    final items = mut [<str>];
    foreach (line in list.lines) {
        if (bullet.match(line) != null or items.len() == 0) {
            final marker = bullet.match(line);
            var text = line.trim();
            if (marker != null) {
                text = line.sub(marker![0].len()).trim();
            }
            items.append(text);
        } else {
            items[items.len() - 1] = items[items.len() - 1] + " " + line.trim();
        }
    }
    return items;
}

// sentencesIn counts sentence ends outside code spans, so `v0.4.3` or `a.b` is not one.
fun sentencesIn(text: str) > int {
    final n = (sentenceEnd.matchAll(codeSpan.replaceAll(text, with: "")) ?? [<[str]>]).len();
    if (n == 0) {
        return 1;
    }
    return n;
}

// Findings are the problems with one text, split by verdict.
export object Findings {
    denies: [str],
    advice: [str],
}

// judgeShape advises on body's shape past the lead: bullets and at most one closing
// sentence after them, then headed sections, whose prose is free. A fenced code block may
// sit anywhere after the lead. A missing lead and a stock heading are proofread's
// (lead-context and reply-voice), so this denies nothing.
export fun judgeShape(body: str) > Findings {
    final denies = mut [<str>];
    final advice = mut [<str>];
    final blocks = splitBlocks(body);
    if (blocks.len() == 0) {
        return Findings{ denies = denies, advice = advice };
    }
    if (blocks[0].kind == "paragraph") {
        final lead = wordsIn(blocks[0].lines.join(" "));
        if (lead > blockWords) {
            advice.append("a lead of {lead} words, past {blockWords}: keep the outcome and how the work came up, and move the rest into bullets");
        }
    }
    var headed = blocks.len();
    var lastList = -1;
    foreach (i, b in blocks) {
        if (b.kind == "heading" and i < headed) {
            headed = i;
        }
        if (b.kind == "list") {
            if (i < headed) {
                lastList = i;
            }
            foreach (item in listItems(b)) {
                final n = wordsIn(item);
                if (n > blockWords) {
                    advice.append("a bullet of {n} words, past {blockWords}: a bullet that long carries two changes, so split it");
                }
            }
        }
    }
    var walls = 0;
    foreach (i, b in blocks) {
        if (i > 0 and i < headed and b.kind == "paragraph") {
            final leadIn = i + 1 < blocks.len() and blocks[i + 1].kind == "list" and b.lines.len() == 1
                and b.lines[0].trim().endsWith(":");
            final coda = lastList >= 0 and i > lastList and i == headed - 1
                and sentencesIn(b.lines.join(" ")) == 1;
            if (!leadIn and !coda) {
                walls = walls + 1;
            }
        }
    }
    if (walls > 0) {
        advice.append("prose between the lead and the first heading outside the bullets ({plural(walls, noun: "paragraph")}): "
            + "make each change a bullet, and put the rest under a heading such as Why this approach or Not verified");
    }
    return Findings{ denies = denies, advice = advice };
}

// wordsAfterLead counts body's words outside code, its lead paragraph left out.
fun wordsAfterLead(body: str) > int {
    final prose = mut [<str>];
    foreach (i, b in splitBlocks(body)) {
        if (i == 0 and b.kind == "paragraph") {
            continue;
        }
        if (b.kind == "list") {
            prose.append(listItems(b).join(" "));
        } else if (b.kind != "code") {
            prose.append(b.lines.join(" "));
        }
    }
    return wordsIn(prose.join(" "));
}

// Text is what one command posts: its kind, and the title and body it sets, null for one
// it leaves alone.
export object Text {
    kind: str,
    title: str? = null,
    body: str? = null,
}

// judgeText is this rule's decision over one readable text, the one the guard and the
// pr-description CI step both reach. judge runs over the body, a description's title on
// the line above it; a deny finding is a denial and an advise finding advice. facts reads
// the branch's Facts, and is called only for a description's body. cited judges each output
// ref a description cites (see citedRun): the guard holds the author's runs and passes
// citedRun; CI's checkout holds none of them and passes skipCited.
export fun judgeText(t: Text, facts: fun () > Facts, judge: fun (text: str, kind: str) > [Judged], cited: fun (ref: str) > str) > Findings {
    final problems = mut [<str>];
    final advice = mut [<str>];
    var text = t.body ?? "";
    if (t.kind == descriptionKind) {
        text = "{t.title ?? ""}\n{t.body ?? ""}";
    }
    final judgedWords = mut [<str>];
    if (t.body != null) {
        foreach (f in judge(text, kind: t.kind)) {
            final problem = judgedProblem(f, kind: t.kind);
            if (f.decision == "advise") {
                advice.append(problem);
            } else {
                problems.append(problem);
            }
            if (f.matched != "") {
                judgedWords.append(f.matched.lower());
            }
        }
    }
    if (spacedHyphen.match(text) != null) {
        problems.append("a spaced hyphen used as a dash: restructure the sentence");
    }
    if (t.kind == descriptionKind and t.body != null) {
        final shape = judgeShape(t.body!);
        foreach (note in shape.advice) {
            advice.append(note);
        }
        final read = facts();
        final units = countUnits(t.title ?? "", facts: read);
        final words = wordsAfterLead(t.body!);
        if (words > wordBudget(units)) {
            if (units.facts.known) {
                problems.append(overBudget(words, units: units));
            } else {
                advice.append(overBudget(words, units: units));
            }
        }
        foreach (question in areaQuestions(unnamedAreas(read.areas, text: text))) {
            advice.append(question);
        }
    }
    if (t.kind == descriptionKind and t.title != null and t.title! != "") {
        foreach (problem in titleProblems(t.title!, judged: judgedWords)) {
            problems.append(problem);
        }
    }
    if (t.kind == descriptionKind) {
        foreach (ref in citedRefs(text)) {
            final problem = cited(ref);
            if (problem != "") {
                problems.append(problem);
            }
        }
    }
    return Findings{ denies = problems, advice = advice };
}

// citedRefs are the distinct output refs text cites outside fenced code. The guard has a
// time budget and each ref is a store lookup.
fun citedRefs(text: str) > [str] {
    final lines = mut [<str>];
    foreach (block in splitBlocks(text)) {
        if (block.kind != "code") {
            foreach (line in block.lines) {
                lines.append(line);
            }
        }
    }
    final refs = mut [<str>];
    foreach (m in outputRef.matchAll(lines.join("\n")) ?? [<[str]>]) {
        if (refs.len() < maxCitedRefs and refs.indexOf(m[0]) == null) {
            refs.append(m[0]);
        }
    }
    return refs;
}

// citedRun is the problem with the run ref names, "" when this checkout holds it and it
// passed. A `grd` ref is a guard verdict, not a run, and never reaches here.
export fun citedRun(ref: str) > str {
    return runProblem(ref, run: magus\output(ref) catch null);
}

// runProblem is citedRun's verdict over run, the record ref resolved to or null.
fun runProblem(ref: str, run: magus\OutputRecord?) > str {
    if (run == null) {
        return "`{ref}` cites a run this checkout holds no record of: cite one that `magus query output {ref}` shows here";
    }
    if (run!.failed) {
        return "`{ref}` cites a failed run ({run!.project}:{run!.target}): cite a passing run, or say the run failed";
    }
    return "";
}

// skipCited accepts every ref, for a checkout that holds none of the author's runs.
export fun skipCited(ref: str) > str {
    return "";
}

// titleProblems are the checks CI's pr-title step runs on title, less a word the prose
// judge already reported (judged holds those, lowercased).
fun titleProblems(title: str, judged: [str]) > [str] {
    final problems = mut [<str>];
    final problem = conventional\problem(title);
    if (problem != "") {
        problems.append("the title fails the check CI runs on it: pr-title: \"{title}\": {problem}");
    }
    foreach (wording in subjects\wordingProblems(title, conventional: true)) {
        if (!alreadyJudged(wording, judged: judged)) {
            problems.append("the title: {wording}");
        }
    }
    return problems;
}

// alreadyJudged reports whether problem quotes a word proofread reported.
fun alreadyJudged(problem: str, judged: [str]) > bool {
    foreach (w in judged) {
        if (problem.lower().indexOf("\"{w}\"") != null) {
            return true;
        }
    }
    return false;
}

// flagsIn are every flag of c that takes a value.
fun flagsIn(c: TextCommand) > [str] {
    return c.title + c.body + c.bodyFile + c.fields + c.base + c.head + c.values;
}

// describesBranch reports whether p, a description command, describes the checkout's
// branch, the only one whose diff the rule can read: it names no pull request and no head
// branch.
fun describesBranch(p: helpers\Program, c: TextCommand) > bool {
    return helpers\stripFlags(p.args, valueFlags: flagsIn(c)).len() == c.command.len()
        and flagValues(p.args, flags: c.head).len() == 0;
}

// textProblems names what is wrong with one call's text. files holds the contents of the
// text files the guard could read; diff reads the branch's Facts against a base (see
// branchDiff), and is called only for the checkout's own pull request; judge is the prose
// judge (see judgeRunner); cited judges the output refs a description cites (see judgeText).
// A value the parser could not render is unknown, and then the whole line is judged for
// credit and typography in its place.
export fun textProblems(p: helpers\Program, line: str, files: {str: str}, diff: fun (base: str) > Facts, judge: fun (text: str, kind: str) > [Judged], cited: fun (ref: str) > str) > Findings {
    final c = matchCommand(p)!;
    final title = last(flagValues(p.args, flags: c.title));
    var body = last(flagValues(p.args, flags: c.body));
    final field = last(fieldValues(p.args, flags: c.fields));
    if (body == null and field != null and !field!.startsWith("@")) {
        body = field;
    }
    final file = textFile(p);
    var known = title != "" and body != "";
    if (file != null) {
        final content = files[file!];
        if (content == null) {
            known = false;
        } else {
            body = content!;
        }
    }
    if (known) {
        final facts = fun () > Facts {
            if (describesBranch(p, c: c)) {
                return diff(last(flagValues(p.args, flags: c.base)) ?? "");
            }
            return unknownFacts();
        };
        return judgeText(Text{ kind = c.kind, title = title, body = body }, facts: facts, judge: judge, cited: cited);
    }
    final problems = mut [<str>];
    foreach (f in judge(line, kind: c.kind)) {
        if (f.decision == "deny" and (lineRules.indexOf(f.rule) != null or f.rule == "judge")) {
            problems.append("{f.message} [{f.rule}]");
        }
    }
    if (spacedHyphen.match(line) != null) {
        problems.append("a spaced hyphen used as a dash: restructure the sentence");
    }
    if (line.len() > maxLine) {
        problems.append("the command runs {line.len()} characters: cut the text to what a reviewer needs");
    }
    if (c.kind == descriptionKind and title != null and title! != "") {
        foreach (problem in titleProblems(title!, judged: [<str>])) {
            problems.append(problem);
        }
    }
    return Findings{ denies = problems, advice = [<str>] };
}

final pullNumber = $"(pulls|issues|merge_requests)/([0-9]+)";

// adviceKey names the pull request p writes to, so its advice is given once: the one it
// names, else its title, else the checkout's branch's.
fun adviceKey(p: helpers\Program, c: TextCommand) > str {
    final ops = helpers\stripFlags(p.args, valueFlags: flagsIn(c));
    if (ops.len() > c.command.len()) {
        final named = ops[c.command.len()];
        final number = pullNumber.match(named);
        if (number != null) {
            return "pull-request-text:" + number![2];
        }
        return "pull-request-text:" + named;
    }
    return "pull-request-text:" + (last(flagValues(p.args, flags: c.title)) ?? "branch");
}

// decidePullRequest denies any pull request text a judge or this rule finds a deny in,
// listing every one with its rule, and advises, once per pull request, on advise findings,
// a description that departs from the shape or leaves a touched area unnamed. The verdict
// names the rule, so the trail and a repeated denial tell it apart. The guard holds the
// author's runs, so it holds the output refs a description cites to them.
export fun decidePullRequest(programs: [helpers\Program], line: str, files: {str: str}, diff: fun (base: str) > Facts, judge: fun (text: str, kind: str) > [Judged], once: fun (key: str) > bool) > GuardVerdict {
    return decideCiting(programs, line: line, files: files, diff: diff, judge: judge, once: once, cited: citedRun);
}

// decideCiting is decidePullRequest with the check on cited output refs chosen by the caller.
fun decideCiting(programs: [helpers\Program], line: str, files: {str: str}, diff: fun (base: str) > Facts, judge: fun (text: str, kind: str) > [Judged], once: fun (key: str) > bool, cited: fun (ref: str) > str) > GuardVerdict {
    final problems = mut [<str>];
    final advice = mut [<str>];
    final denied = mut [<str>];
    final advised = mut [<str>];
    var key = "";
    foreach (p in programs) {
        if (!writesText(p)) {
            continue;
        }
        final c = matchCommand(p)!;
        final found = textProblems(p, line: line, files: files, diff: diff, judge: judge, cited: cited);
        foreach (problem in found.denies) {
            if (problems.indexOf(problem) == null) {
                problems.append(problem);
            }
        }
        if (found.denies.len() > 0 and denied.indexOf(c.kind) == null) {
            denied.append(c.kind);
        }
        if (found.advice.len() > 0) {
            if (key == "") {
                key = adviceKey(p, c: c);
            }
            if (advised.indexOf(c.kind) == null) {
                advised.append(c.kind);
            }
        }
        foreach (note in found.advice) {
            if (advice.indexOf(note) == null) {
                advice.append(note);
            }
        }
    }
    final named = {"rule": "pull-request-text"};
    if (problems.len() > 0) {
        return magus\guard.deny(opening(denied, description: "This pull request text breaks the description rules:",
            reply: "This review reply breaks the reply rules:") + "\n  - " + problems.join("\n  - ") + "\n"
            + teaching(denied, description: fixLine), named);
    }
    if (advice.len() > 0 and once(key)) {
        return magus\guard.advise(opening(advised, description: "This pull request description could read better:",
            reply: "This review reply could read better:") + "\n  - " + advice.join("\n  - ") + "\n"
            + teaching(advised, description: shapeLine), named);
    }
    return magus\guard.allow();
}

// opening is the first line of a verdict on text of kinds.
fun opening(kinds: [str], description: str, reply: str) > str {
    if (kinds.indexOf(descriptionKind) != null) {
        return description;
    }
    return reply;
}

// teaching is the shape a verdict on text of kinds teaches: description's for a
// description, replyLine for a reply, both for both.
fun teaching(kinds: [str], description: str) > str {
    final lines = mut [<str>];
    if (kinds.indexOf(descriptionKind) != null) {
        lines.append(description);
    }
    if (kinds.indexOf(replyKind) != null) {
        lines.append(replyLine);
    }
    return lines.join("\n");
}

final goodTitle = "fix(guard): keep the key stable";

fun create(title: str, body: str) > [helpers\Program] {
    return helpers\request([["gh", "pr", "create", "--base", "main", "--title", title, "--body", body]]);
}

// facts is a diff reader that answers f and never touches a repository.
fun facts(f: Facts) > fun (base: str) > Facts {
    return fun (base: str) > Facts {
        return f;
    };
}

// passing is a judge that finds nothing, so a case sees only this rule's own verdicts;
// libs/conventions/proofread tests proofread itself.
fun passing() > fun (text: str, kind: str) > [Judged] {
    return fun (text: str, kind: str) > [Judged] {
        return [<Judged>];
    };
}

// reporting is a judge that reports f whatever it reads.
fun reporting(f: Judged) > fun (text: str, kind: str) > [Judged] {
    return fun (text: str, kind: str) > [Judged] {
        return [f];
    };
}

fun judged(programs: [helpers\Program], line: str, files: {str: str}) > GuardVerdict {
    return decideCiting(programs, line: line, files: files, diff: facts(unknownFacts()), judge: passing(), once: helpers\counter(), cited: skipCited);
}

fun judgedReason(title: str, body: str) > str {
    return judged(create(title, body: body), line: "", files: {<str: str>}).reason;
}

fun verdictWith(title: str, body: str, f: Facts) > GuardVerdict {
    return decideCiting(create(title, body: body), line: "", files: {<str: str>}, diff: facts(f), judge: passing(), once: helpers\counter(), cited: skipCited);
}

// sized is a well-shaped description: a 20-word lead, then n words of bullets of at most
// 20 words each.
fun sized(n: int) > str {
    final lines = mut ["word ".repeat(20)];
    var left = n;
    while (left > 0) {
        var take = left;
        if (take > 20) {
            take = 20;
        }
        lines.append("- " + "word ".repeat(take));
        left = left - take;
    }
    return lines.join("\n");
}

fun shipping(shipped: int, lines: int) > Facts {
    return Facts{ known = true, fragments = 0, shipped = shipped, lines = lines };
}

// Call is one text a recording judge was handed, with its kind.
object Call {
    text: str,
    kind: str,
}

test "a conventional title and a plain description pass" {
    foreach (argv in [
        ["gh", "pr", "create", "--title", goodTitle, "--body", "The key drifted between runs; this pins it to the source digest."],
        ["gh", "pr", "create", "-t", "feat: add a commit-msg hook", "-b", "Adds the hook.", "--base", "main"],
        ["gh", "pr", "edit", "412", "--body", "Moves the rule under .claude/skills/ and hack/policy; an agent reads it at spawn."],
        ["gh", "-R", "egladman/magus", "pr", "edit", "412", "--title=docs: README framing; one line per audience"],
    ]) {
        final v = judged(helpers\request([argv]), line: argv.join(" "), files: {<str: str>});
        std\assert(v.decision == "allow", message: "{argv.join(" ")}: {v.reason}");
    }
}

test "a spaced hyphen is denied with the shape and its example" {
    final reason = judgedReason(goodTitle, body: "Pins the key - for good.");
    std\assert(reason.indexOf("spaced hyphen") != null, message: reason);
    std\assert(reason.indexOf("first sentence says what a reader can now do") != null, message: "teaches the lead: {reason}");
    std\assert(reason.indexOf(example) != null, message: "carries the example: {reason}");
}

test "every deny finding is listed with where it sits and its rule, under the rule's name" {
    final lead = Judged{ rule = "lead-context", line = 2, message = "It opens with a heading: open with a paragraph." };
    final v = decidePullRequest(create(goodTitle, body: "## Summary"), line: "", files: {<str: str>},
        diff: facts(unknownFacts()), judge: reporting(lead), once: helpers\counter());
    std\assert(v.decision == "deny", message: v.reason);
    std\assert(v.rule == "pull-request-text", message: "named: {v.rule}");
    std\assert(v.reason.indexOf("description line 1: It opens with a heading: open with a paragraph. [lead-context]") != null, message: v.reason);
    final title = Judged{ rule = "filler", line = 1, message = "Drop 'robust': state the fact.", matched = "robust" };
    final t = decidePullRequest(create("fix(cache): add a robust key", body: "Pins the key."), line: "", files: {<str: str>},
        diff: facts(unknownFacts()), judge: reporting(title), once: helpers\counter());
    std\assert(t.reason.indexOf("the title: Drop 'robust': state the fact. [filler]") != null, message: t.reason);
    std\assert(t.reason.indexOf("\"robust\": drop it") == null, message: "a word proofread reported is not reported twice: {t.reason}");
}

test "an advise finding is told once per pull request and never denies" {
    final verdict = Judged{ rule = "verdict", line = 2, message = "Name the behavior 'broken' stands for.", decision = "advise" };
    final once = helpers\counter();
    final first = decidePullRequest(create(goodTitle, body: "The key was broken."), line: "", files: {<str: str>},
        diff: facts(unknownFacts()), judge: reporting(verdict), once: once);
    std\assert(first.decision == "advise" and first.rule == "pull-request-text", message: first.reason);
    std\assert(first.reason.indexOf("description line 1: Name the behavior 'broken' stands for. [verdict]") != null, message: first.reason);
    final again = decidePullRequest(create(goodTitle, body: "The key was broken."), line: "", files: {<str: str>},
        diff: facts(unknownFacts()), judge: reporting(verdict), once: once);
    std\assert(again.decision == "allow", message: "said once: {again.reason}");
}

fun run(ref: str, project: str, target: str, failed: bool) > magus\OutputRecord {
    return magus\OutputRecord{ ref = ref, project = project, target = target, failed = failed, durationMs = 1, output = "" };
}

// holding is a cited check over a store holding runs, standing in for this checkout's.
fun holding(runs: {str: magus\OutputRecord}, asked: mut [str]) > fun (ref: str) > str {
    return fun (ref: str) > str {
        asked.append(ref);
        return runProblem(ref, run: runs[ref]);
    };
}

fun citing(body: str, cited: fun (ref: str) > str) > GuardVerdict {
    return decideCiting(create(goodTitle, body: body), line: "", files: {<str: str>}, diff: facts(unknownFacts()),
        judge: passing(), once: helpers\counter(), cited: cited);
}

test "a cited ref this checkout does not hold is denied" {
    final v = citing("`TestX` passed (out1a2b3c4d5e6f).", cited: holding({<str: magus\OutputRecord>}, asked: mut [<str>]));
    std\assert(v.decision == "deny" and v.rule == "pull-request-text", message: v.reason);
    std\assert(v.reason.indexOf("`out1a2b3c4d5e6f` cites a run this checkout holds no record of") != null, message: v.reason);
    std\assert(v.reason.indexOf("magus query output out1a2b3c4d5e6f") != null, message: "says how to cite one: {v.reason}");
}

test "a cited ref that names a failed run is denied with its project and target" {
    final runs = {"out1a2b3c4d5e6f": run("out1a2b3c4d5e6f", project: "libs/cache", target: "go-test", failed: true)};
    final v = citing("`TestX` passed (out1a2b3c4d5e6f).", cited: holding(runs, asked: mut [<str>]));
    std\assert(v.decision == "deny", message: v.reason);
    std\assert(v.reason.indexOf("`out1a2b3c4d5e6f` cites a failed run (libs/cache:go-test)") != null, message: v.reason);
}

test "a cited ref that names a passing run passes" {
    final runs = {"out1a2b3c4d5e6f": run("out1a2b3c4d5e6f", project: "libs/cache", target: "go-test", failed: false)};
    final v = citing("`TestX` passed (out1a2b3c4d5e6f).", cited: holding(runs, asked: mut [<str>]));
    std\assert(v.decision == "allow", message: v.reason);
}

test "CI skips the cited refs a checkout cannot hold" {
    std\assert(citing("`TestX` passed (out1a2b3c4d5e6f).", cited: skipCited).decision == "allow", message: "decideCiting");
    final found = judgeText(Text{ kind = descriptionKind, title = goodTitle, body = "`TestX` passed (out1a2b3c4d5e6f)." },
        facts: fun () > Facts => unknownFacts(), judge: passing(), cited: skipCited);
    std\assert(found.denies.len() == 0, message: "judgeText: {found.denies}");
}

test "only whole output refs outside fenced code are looked up, each once" {
    final asked = mut [<str>];
    final body = "Ran it twice (out1a2b3c4d5e6f), then again (out1a2b3c4d5e6f) beside outface and out12345.\n"
        + "A guard verdict grd1a2b3c4d5e6f is not a run, and xout1a2b3c4d5e6f is not a ref.\n\n"
        + "```\nout999999999999\n```\n\nLast: out0a0b0c0d0e0f.";
    citing(body, cited: holding({<str: magus\OutputRecord>}, asked: asked));
    std\assert(asked.len() == 2 and asked[0] == "out1a2b3c4d5e6f" and asked[1] == "out0a0b0c0d0e0f", message: "{asked}");
}

test "a description is looked up for at most ten distinct refs" {
    final asked = mut [<str>];
    final refs = mut [<str>];
    for (var i = 0; i < 14; i = i + 1) {
        refs.append("out0000{i + 100}");
    }
    citing("Cites " + refs.join(" ") + ".", cited: holding({<str: magus\OutputRecord>}, asked: asked));
    std\assert(asked.len() == 10, message: "{asked.len()}");
}

test "a review reply is not held to the runs it cites" {
    final asked = mut [<str>];
    final v = decideCiting(helpers\request([["gh", "pr", "comment", "412", "--body", "It passed (out1a2b3c4d5e6f)."]]), line: "",
        files: {<str: str>}, diff: facts(unknownFacts()), judge: passing(), once: helpers\counter(),
        cited: holding({<str: magus\OutputRecord>}, asked: asked));
    std\assert(v.decision == "allow" and asked.len() == 0, message: "{v.reason} {asked}");
}

test "proofread reads the title and the description as one pull request" {
    final seen = mut [<Call>];
    final recording = fun (text: str, kind: str) > [Judged] {
        seen.append(Call{ text = text, kind = kind });
        return [<Judged>];
    };
    decidePullRequest(create(goodTitle, body: "Pins the key."), line: "", files: {<str: str>},
        diff: facts(unknownFacts()), judge: recording, once: helpers\counter());
    std\assert(seen.len() == 1 and seen[0].text == goodTitle + "\nPins the key." and seen[0].kind == "change-description",
        message: "{seen.len()}");
    final unread = helpers\request([["gh", "pr", "create", "--title", goodTitle, "--body", ""]]);
    decidePullRequest(unread, line: "gh pr create --body \"$BODY\"", files: {<str: str>},
        diff: facts(unknownFacts()), judge: recording, once: helpers\counter());
    std\assert(seen.len() == 2 and seen[1].text == "gh pr create --body \"$BODY\"", message: "an unreadable description is judged as its line");
}

test "each forge command is judged as the kind it writes" {
    final cases: {str: [str]} = {
        "review-reply|Good catch, the map is shared.": ["gh", "pr", "comment", "412", "--body", "Good catch, the map is shared."],
        "review-reply|I'd keep the retry.": ["gh", "pr", "review", "412", "--comment", "-b", "I'd keep the retry."],
        "review-reply|It needs a lock.": ["gh", "api", "repos/o/r/pulls/412/comments", "-f", "body=It needs a lock.", "-f", "path=a.go"],
        "review-reply|A reply in the thread.": ["gh", "api", "-X", "POST", "/repos/o/r/pulls/412/comments/99/replies", "--raw-field", "body=A reply in the thread."],
        "review-reply|From a file.": ["gh", "api", "repos/o/r/issues/412/comments", "-F", "body=@reply.md"],
        "change-description|fix: pin the key\nPins the key.": ["glab", "mr", "create", "-t", "fix: pin the key", "-d", "Pins the key."],
        "review-reply|Thanks, done.": ["glab", "mr", "note", "12", "-m", "Thanks, done."],
    };
    foreach (want, argv in cases) {
        final seen = mut [<Call>];
        final recording = fun (text: str, kind: str) > [Judged] {
            seen.append(Call{ text = text, kind = kind });
            return [<Judged>];
        };
        decidePullRequest(helpers\request([argv]), line: argv.join(" "), files: {"reply.md": "From a file."},
            diff: facts(unknownFacts()), judge: recording, once: helpers\counter());
        final got = if (seen.len() > 0) seen[0].kind + "|" + seen[0].text else "not judged";
        std\assert(seen.len() == 1 and got == want, message: "{argv.join(" ")}: {got}");
    }
}

test "a reply denial teaches a reply, not a description" {
    final opener = Judged{ rule = "reply-opener", line = 1, message = "Open with the point you answer." };
    final v = decidePullRequest(helpers\request([["gh", "pr", "comment", "412", "--body", "No, as I said."]]), line: "",
        files: {<str: str>}, diff: facts(unknownFacts()), judge: reporting(opener), once: helpers\counter());
    std\assert(v.decision == "deny", message: v.reason);
    std\assert(v.reason.startsWith("This review reply breaks the reply rules:"), message: v.reason);
    std\assert(v.reason.indexOf("line 1: Open with the point you answer. [reply-opener]") != null, message: v.reason);
    std\assert(v.reason.indexOf("acknowledge the point it answers") != null and v.reason.indexOf("conventional title") == null, message: v.reason);
}

test "parseJudged reads each finding's line, decision and page" {
    final got = parseJudged("[\{\"node\":\"change-description\",\"source\":\"change-description:3\",\"kind\":\"change-description\","
        + "\"rule\":\"hedge\",\"code\":\"PRF3002\",\"decision\":\"deny\",\"message\":\"Drop 'might fix'.\",\"match\":\"might fix\","
        + "\"url\":\"https://eli.gladman.cc/magus/reference/proofread/hedge/\"}]");
    std\assert(got.len() == 1 and got[0].rule == "hedge" and got[0].line == 3 and got[0].matched == "might fix"
        and got[0].decision == "deny" and got[0].url.endsWith("/proofread/hedge/"), message: "{got.len()}");
    std\assert(judgedProblem(got[0], kind: "change-description") == "description line 2: Drop 'might fix'. [hedge]", message: judgedProblem(got[0], kind: "change-description"));
    std\assert(judgedProblem(got[0], kind: "review-reply") == "line 3: Drop 'might fix'. [hedge]", message: judgedProblem(got[0], kind: "review-reply"));
    std\assert(parseJudged("[]").len() == 0, message: "no finding");
}

test "a judge that failed is named by its stderr, else by whether its binary exists and runs" {
    std\assert(judgeFailure(code: 1, stdout: "", stderr: " no Go files \n", bin: ".") == "no Go files", message: "stderr wins");
    final gone = judgeFailure(code: -1, stdout: "", stderr: "", bin: "./gone/gen/proofread");
    std\assert(gone == "proofread exited -1 with nothing on stderr: it never started, since ./gone/gen/proofread does not exist", message: gone);
    final said = judgeFailure(code: 2, stdout: "bad flag", stderr: "", bin: ".");
    std\assert(said == "proofread exited 2 with nothing on stderr; stdout: bad flag", message: said);

    final dir = fs\tempDir("judge-failure") catch "";
    std\assert(dir != "", message: "a temp dir");
    final bin = "{dir}/proofread";
    fs\writeFile(bin, content: "#!/bin/sh\n") catch void;
    fs\chmod(bin, mode: 0b110100100) catch void;
    final flat = judgeFailure(code: -1, stdout: "", stderr: "", bin: bin);
    std\assert(flat == "proofread exited -1 with nothing on stderr: it never started, since {bin} is not executable", message: flat);
    fs\chmod(bin, mode: 0b111101101) catch void;
    final killed = judgeFailure(code: -1, stdout: "", stderr: "", bin: bin);
    std\assert(killed == "proofread exited -1 with nothing on stderr: {bin} is an executable file, so a signal ended it or the system refused to load it", message: killed);
    fs\removeAll(dir) catch void;
}

// The pr-description target passes the workspace as ".", the guard as an absolute path;
// both must reach the one built judge, and neither may pass without it.
test "proofread runs from a relative workspace and its absence is a finding" {
    final ws = fs\tempDir("judge-runner") catch "";
    std\assert(ws != "", message: "a temp dir");
    final dir = "{ws}/{proofread\home}";
    fs\mkdirAll("{dir}/proofread") catch void;
    fs\mkdirAll("{dir}/cmd/proofread") catch void;
    fs\mkdirAll("{dir}/gen") catch void;
    fs\writeFile("{dir}/go.mod", content: "module m\n") catch void;
    fs\writeFile("{dir}/go.sum", content: "") catch void;
    fs\writeFile("{dir}/proofread/proofread.go", content: "package proofread\n") catch void;
    fs\writeFile("{dir}/cmd/proofread/main.go", content: "package main\n") catch void;
    final relative = path\rel(path\abs(".") catch ".", target: ws) catch ws;
    std\assert(!path\isAbs(relative), message: relative);

    final missing = judgeRunner(relative)("docs: a title\nA body.", kind: "change-description");
    std\assert(missing.len() == 1 and missing[0].rule == "judge" and missing[0].message.indexOf("is not built") != null,
        message: if (missing.len() > 0) missing[0].message else "no finding");

    final bin = "{dir}/{proofread\binary}";
    fs\writeFile(bin, content: "#!/bin/sh\ncat >/dev/null\n"
        + "echo '[\{\"source\":\"change-description:2\",\"rule\":\"hedge\",\"decision\":\"advise\",\"message\":\"Drop it.\",\"match\":\"might\"}]'\n") catch void;
    fs\chmod(bin, mode: 0b111101101) catch void;
    fs\writeFile("{dir}/{proofread\inputsFile}", content: (proofread\inputs(dir) catch "") + "\n") catch void;
    final ran = judgeRunner(relative)("docs: a title\nA body.", kind: "change-description");
    std\assert(ran.len() == 1 and ran[0].rule == "hedge" and ran[0].line == 2 and ran[0].decision == "advise",
        message: if (ran.len() > 0) ran[0].message else "no finding");
    fs\removeAll(ws) catch void;
}

test "an outside judge's findings take this repository's decisions" {
    final dir = fs\tempDir("outside-judge") catch "";
    std\assert(dir != "", message: "a temp dir");
    final bin = "{dir}/judge";
    fs\writeFile(bin, content: "#!/bin/sh\ncat >/dev/null\n"
        + "echo '[\{\"source\":\"stdin:2\",\"rule\":\"attribution\",\"decision\":\"advise\",\"message\":\"Credit.\",\"match\":\"x\"},"
        + "\{\"source\":\"stdin:3\",\"rule\":\"team-voice\",\"decision\":\"advise\",\"message\":\"Ours.\",\"match\":\"y\"}]'\n") catch void;
    fs\chmod(bin, mode: 0b111101101) catch void;
    final got = outsideFindings(OutsideJudge{ argv = [bin], kinds = ["change-description"] }, text: "t\nb");
    std\assert(got.len() == 2 and got[0].decision == "deny" and got[1].decision == "advise",
        message: "the table turns attribution to deny and leaves the rest: {got.len()}");
    final broken = outsideFindings(OutsideJudge{ argv = ["{dir}/missing"], kinds = ["change-description"] }, text: "t");
    std\assert(broken.len() == 1 and broken[0].rule == "judge" and broken[0].decision == "deny", message: "a judge that did not run is a finding");
    fs\removeAll(dir) catch void;
}

test "a title is judged for the imperative and puffery after its prefix" {
    foreach (title, want in {
        "feat(proofread): adds a vale spell": "not 'added' or 'adds'",
        "feat(proofread)!: added a vale spell": "not 'added' or 'adds'",
        "fix: updated the key": "not 'added' or 'adds'",
        "fix(cache): add a robust key": "drop it and say what changed",
        "feat(cache): add a powerful cache": "\"powerful\"",
    }) {
        final reason = judgedReason(title, body: "Pins the key.");
        std\assert(reason.indexOf("the title: ") != null and reason.indexOf(want) != null, message: "{title}: {reason}");
    }
    std\assert(judgedReason("fix(cache): keep the key stable", body: "Pins the key.") == "", message: "imperative title");
    std\assert(judgedReason(goodTitle, body: "Adds the hook.") == "", message: "a body is not held to the imperative");
}

test "the budget counts the changes the diff proves" {
    final one = countUnits(goodTitle, facts: shipping(1, lines: 40));
    std\assert(one.count == 2 and wordBudget(one) == 160, message: "one shipped file earns a second change: {one.count}");
    std\assert(countUnits(goodTitle, facts: shipping(0, lines: 0)).count == 1, message: "nothing proven is still one change");
    std\assert(countUnits("fix: a; b; c", facts: shipping(0, lines: 0)).count == 3, message: "each title clause");
    std\assert(countUnits("feat!: drop x", facts: Facts{ known = true, fragments = 1, shipped = 0, lines = 0 }).count == 2, message: "a breaking title adds to the fragments");
    foreach (shipped, want in {1: 2, 3: 3, 6: 3, 7: 4, 15: 5, 31: 6}) {
        std\assert(countUnits(goodTitle, facts: shipping(shipped, lines: 0)).files == want, message: "{shipped} files");
    }
    foreach (lines, want in {99: 1, 100: 2, 300: 3, 700: 4, 1500: 5}) {
        std\assert(countUnits(goodTitle, facts: shipping(0, lines: lines)).lines == want, message: "{lines} lines");
    }
    std\assert(wordBudget(countUnits(goodTitle, facts: unknownFacts())) == 110, message: "the title alone earns 110 words");
}

test "words after the lead past the budget are denied with the budget and why; the lead is free" {
    final small = shipping(0, lines: 10);
    std\assert(verdictWith(goodTitle, body: sized(110), f: small).decision == "allow", message: "110 is the budget for one change");
    final over = verdictWith(goodTitle, body: sized(111), f: small);
    std\assert(over.decision == "deny", message: over.reason);
    std\assert(over.reason.indexOf("111 words after the lead, past this pull request's budget of 110 (60 + 50 for each of 1 change, the most of 0 changelog fragments, 1 title clause, 0 shipped source files (counting 1) and 10 changed lines outside generated files (counting 1))") != null, message: over.reason);
    std\assert(over.reason.indexOf("split the pull request") != null, message: "names the other fix");
    final wide = verdictWith(goodTitle, body: sized(210), f: shipping(3, lines: 250));
    std\assert(wide.decision == "allow", message: "three changes earn 210 words: {wide.reason}");
    std\assert(verdictWith(goodTitle, body: sized(80) + "\n\n```\n" + "code ".repeat(200) + "\n```", f: small).decision == "allow", message: "fenced code is not counted");
    final longLead = "word ".repeat(55) + "\n\n" + sized(100).sub(sized(0).len() + 1);
    std\assert(verdictWith(goodTitle, body: longLead, f: small).decision == "allow", message: "the lead is not counted");
}

test "a budget the diff could not settle is advice, told once" {
    final body = sized(120);
    final v = verdictWith(goodTitle, body: body, f: unknownFacts());
    std\assert(v.decision == "advise", message: v.reason);
    std\assert(v.reason.indexOf("could not be read, so it counts as 1 and this is advice") != null, message: v.reason);

    final once = helpers\counter();
    final edit = helpers\request([["gh", "pr", "edit", "412", "--body", body]]);
    final big = facts(shipping(100, lines: 5000));
    std\assert(decidePullRequest(edit, line: "", files: {<str: str>}, diff: big, judge: passing(), once: once).decision == "advise", message: "another pull request's diff is never read");
    std\assert(decidePullRequest(edit, line: "", files: {<str: str>}, diff: big, judge: passing(), once: once).decision == "allow", message: "said once per pull request");
}

test "the diff is read once, and only for the checkout's own pull request" {
    final reads = mut [<str>];
    final counting = fun (base: str) > Facts {
        reads.append(base);
        return shipping(1, lines: 40);
    };
    decidePullRequest(create(goodTitle, body: "Pins the key."), line: "", files: {<str: str>}, diff: counting, judge: passing(), once: helpers\counter());
    std\assert(reads.len() == 1 and reads[0] == "main", message: "one read, against the pull request's base");
    final headed = helpers\request([["gh", "pr", "create", "--head", "other", "--title", goodTitle, "--body", sized(100)]]);
    decidePullRequest(headed, line: "", files: {<str: str>}, diff: counting, judge: passing(), once: helpers\counter());
    std\assert(reads.len() == 1, message: "another branch's diff is not this checkout's");
    decidePullRequest(helpers\request([["gh", "pr", "comment", "--body", "Done."]]), line: "", files: {<str: str>}, diff: counting, judge: passing(), once: helpers\counter());
    std\assert(reads.len() == 1, message: "a reply reads no diff");
}

test "an area the diff touches and the description never names is a question, not a denial" {
    final touched = Facts{ known = true, fragments = 0, shipped = 2, lines = 40,
        paths = ["internal/guard/dir.go", "docs/guard.md"], areas = ["internal/guard", "docs", "libs/conventions"] };
    final v = verdictWith(goodTitle, body: "The guard keeps the key; the docs say so.", f: touched);
    std\assert(v.decision == "advise", message: v.reason);
    std\assert(v.reason.indexOf("why does this touch libs/conventions?") != null, message: v.reason);
    std\assert(v.reason.indexOf("touch internal/guard") == null and v.reason.indexOf("touch docs") == null, message: "named areas ask nothing: {v.reason}");
    final named = verdictWith(goodTitle, body: "The guard keeps the key, the docs say so, and conventions pin it.", f: touched);
    std\assert(named.decision == "allow", message: named.reason);
}

test "touchedAreas names projects and top-level packages, generated files and fragments aside" {
    final files: [any] = [
        {"path": "internal/guard/dir.go", "project": ".", "role": "source"},
        {"path": "internal/guard/rules/x.go", "project": ".", "role": "source"},
        {"path": "libs/conventions/proofread/voice.go", "project": "libs/conventions", "role": "source"},
        {"path": "magusfile.buzz", "project": ".", "role": "source"},
        {"path": "MAGUS.md", "project": ".", "role": "output"},
        {"path": ".gitattributes", "project": ".", "role": "maintained"},
        {"path": "docs/pnpm-lock.yaml", "project": "docs", "role": "source"},
        {"path": "changes/unreleased/writing-rules.md", "project": ".", "role": "source"},
    ];
    final got = touchedAreas(files);
    std\assert(got.join(",") == "internal/guard,libs/conventions,magusfile.buzz", message: got.join(","));
    std\assert(unnamedAreas(got, text: "The Guard and the magusfile.").join(",") == "libs/conventions", message: "named by last segment, any case");
}

test "classify reads outputs from the managed attributes and owners from project roots" {
    final ws = fs\tempDir("areas") catch "";
    std\assert(ws != "", message: "a temp dir");
    fs\mkdirAll("{ws}/libs/lib/gen") catch void;
    fs\mkdirAll("{ws}/tools/magusfiles") catch void;
    fs\mkdirAll("{ws}/vendor/dep") catch void;
    fs\mkdirAll("{ws}/internal/guard") catch void;
    fs\writeFile("{ws}/libs/lib/magusfile.buzz", content: "") catch void;
    fs\writeFile("{ws}/tools/magusfiles/a.buzz", content: "") catch void;
    fs\writeFile("{ws}/vendor/dep/magusfile.buzz", content: "") catch void;
    fs\writeFile("{ws}/.gitattributes", content: "*.go diff=golang\n"
        + "{attributesBegin} - do not edit\n"
        + "*.go diff=golang\n"
        + "/MAGUS.md merge=magus linguist-generated\n"
        + "libs/lib/gen/** merge=magus linguist-generated\n"
        + "libs/lib/gen/keep.go !merge !linguist-generated\n"
        + "notes/*.md merge=magus\n"
        + "{attributesEnd}\n"
        + "docs/*.svg linguist-generated\n") catch void;

    final got = mut [<str>];
    foreach (f in classify(ws, paths: ["MAGUS.md", "docs/MAGUS.md", "libs/lib/gen/a.go", "libs/lib/gen/keep.go",
        "libs/lib/x.go", "tools/t.go", "vendor/dep/d.go", "internal/guard/dir.go", ".gitattributes",
        "notes/n.md", "docs/a.svg"])) {
        got.append("{f["path"] ?? ""}={f["project"] ?? ""}:{f["role"] ?? ""}");
    }
    std\assert(got.join(" ") == "MAGUS.md=.:output docs/MAGUS.md=.:source libs/lib/gen/a.go=libs/lib:output "
        + "libs/lib/gen/keep.go=libs/lib:source libs/lib/x.go=libs/lib:source tools/t.go=tools:source "
        + "vendor/dep/d.go=.:source internal/guard/dir.go=.:source .gitattributes=.:maintained "
        + "notes/n.md=.:source docs/a.svg=.:source", message: got.join(" "));
    std\assert(changedAreas(ws, paths: ["MAGUS.md", "libs/lib/x.go", "internal/guard/dir.go", "libs/lib/gen/a.go"]).join(",")
        == "libs/lib,internal/guard", message: "outputs ask nothing");

    fs\writeFile("{ws}/.gitattributes", content: "*.go diff=golang\n") catch void;
    std\assert(classify(ws, paths: [".gitattributes"])[0]["role"] == "source", message: "no managed section, nothing magus maintains");
    fs\removeAll(ws) catch void;
}

test "statFacts counts fragments, shipped files and lines, generated files aside" {
    final f = statFacts([
        FileStat{ path = "changes/unreleased/a.md", added = 6, deleted = 0, binary = false },
        FileStat{ path = "changes/unreleased/folded.md", added = 0, deleted = 6, binary = false },
        FileStat{ path = "internal/cache/key.go", added = 10, deleted = 2, binary = false },
        FileStat{ path = "internal/cache/key_test.go", added = 30, deleted = 0, binary = false },
        FileStat{ path = "docs/guide.md", added = 5, deleted = 5, binary = false },
        FileStat{ path = "internal/spell/gen/go.bo", added = 400, deleted = 400, binary = false },
        FileStat{ path = "MAGUS.md", added = 1, deleted = 1, binary = false },
        FileStat{ path = "assets/logo.png", added = 0, deleted = 0, binary = true },
    ]);
    std\assert(f.known, message: "a diff was read");
    std\assert(f.fragments == 1, message: "a folded fragment is not a change: {f.fragments}");
    std\assert(f.shipped == 2, message: "key.go and the logo ship: {f.shipped}");
    std\assert(f.lines == 64, message: "every line outside generated files: {f.lines}");
    std\assert(f.paths.len() == 6 and f.paths.indexOf("MAGUS.md") == null, message: "the paths outside generated files: {f.paths}");
    std\assert(!statFacts([<FileStat>]).known, message: "an empty diff is unknown");
}

test "the shape is a lead, bullets, at most one closing sentence, then headed sections" {
    final lead = "The key drifted between runs.";
    foreach (body in [
        lead,
        lead + "\n\n- Pins it to the source digest.\n- Drops the old key.",
        lead + "\n\nInside the key:\n- The digest.\n- The platform.\n\nA test pins both.",
        lead + "\n\n- Pins it.\n\n```\nmagus run build\n```",
        lead + "\n\n- Pins it.\n\n## Why this approach\n\nA per-process cache suited one worker. It stops holding at eight.\n\n"
            + "## Not verified\n\nLinux, which CI runs.",
    ]) {
        final v = verdictWith(goodTitle, body: body, f: unknownFacts());
        std\assert(v.decision == "allow", message: "{body}: {v.reason}");
    }
    final advised = {
        lead + "\n\nIt now pins the digest.": "prose between the lead and the first heading",
        lead + "\n\n- Pins it.\n\nA test pins it. Another test drops it.": "prose between the lead and the first heading",
        lead + "\n\nFirst.\n\n- Pins it.": "prose between the lead and the first heading",
        lead + "\n\n- " + "word ".repeat(61): "a bullet of 61 words",
        "word ".repeat(61): "a lead of 61 words",
    };
    foreach (body, want in advised) {
        final v = verdictWith(goodTitle, body: body, f: shipping(5, lines: 500));
        std\assert(v.decision == "advise", message: "{body}: {v.decision}");
        std\assert(v.reason.indexOf(want) != null and v.reason.indexOf("The shape:") != null, message: v.reason);
    }
}

test "a description read from a heredoc or a body file is judged" {
    final line = "gh pr create --title \"fix: pin the key\" --body \"$(cat <<'EOF'\nClaude pinned the key.\nEOF\n)\"";
    final programs = helpers\request([["gh", "pr", "create", "--title", "fix: pin the key", "--body", ""], ["cat"]]);
    final slots = mut [<[int]>];
    foreach (p in programs) {
        slots.append(textSlots(p));
    }
    final filled = helpers\fillSlots(programs, slots: slots, texts: helpers\substitutedHeredocs(line));
    final seen = mut [<str>];
    final recording = fun (text: str, kind: str) > [Judged] {
        seen.append(text);
        return [<Judged>];
    };
    decidePullRequest(filled, line: line, files: {<str: str>}, diff: facts(unknownFacts()), judge: recording, once: helpers\counter());
    std\assert(seen.len() == 1 and seen[0] == "fix: pin the key\nClaude pinned the key.", message: "{seen}");

    final fromFile = helpers\request([["gh", "pr", "create", "--title", goodTitle, "--body-file", "pr.md"]]);
    std\assert(bodyFiles(fromFile)[0] == "pr.md", message: "the file to read");
    decidePullRequest(fromFile, line: "", files: {"pr.md": "Claude wanted this."}, diff: facts(unknownFacts()), judge: recording, once: helpers\counter());
    std\assert(seen.len() == 2 and seen[1] == goodTitle + "\nClaude wanted this.", message: "{seen}");
}

test "an unreadable description is judged from the whole line for credit and typography alone" {
    final programs = helpers\request([["gh", "pr", "create", "--title", goodTitle, "--body", ""]]);
    final line = "gh pr create --title \"{goodTitle}\" --body \"$BODY by Claude\"";
    final both = fun (text: str, kind: str) > [Judged] {
        return [Judged{ rule = "attribution", line = 1, message = "Drop 'Claude': describe the change." },
            Judged{ rule = "lead-context", line = 2, message = "Open with the outcome." }];
    };
    final v = decidePullRequest(programs, line: line, files: {<str: str>}, diff: facts(unknownFacts()), judge: both, once: helpers\counter());
    std\assert(v.reason.indexOf("Drop 'Claude': describe the change. [attribution]") != null, message: v.reason);
    std\assert(v.reason.indexOf("lead-context") == null, message: "a line has no lead: {v.reason}");
    final long = "gh pr create --body \"$BODY\" " + "x".repeat(3000);
    std\assert(judged(programs, line: long, files: {<str: str>}).reason.indexOf("the command runs") != null, message: "a long line");
}

test "other commands and a line that only mentions gh pr create stay silent" {
    foreach (argv in [
        ["rg", "gh pr create --title"],
        ["gh", "pr", "view", "412", "--json", "title,body"],
        ["gh", "pr", "create", "--fill"],
        ["gh", "pr", "edit", "412", "--add-label", "merge-queue: squash"],
        ["gh", "pr", "review", "412", "--approve"],
        ["gh", "issue", "create", "--title", "a bug", "--body", "x"],
        ["gh", "api", "repos/o/r/pulls/412/comments"],
        ["gh", "api", "repos/o/r/labels", "-f", "body=x"],
        ["glab", "mr", "view", "12"],
    ]) {
        final v = judged(helpers\request([argv]), line: argv.join(" "), files: {<str: str>});
        std\assert(v.decision == "allow", message: argv.join(" "));
    }
}

test "no message sends the reader to a skill" {
    final reason = judgedReason("Pin the key", body: "Pins the key - for now.");
    std\assert(reason != "" and reason.indexOf("Skill(") == null, message: reason);
}

test "the example a denial teaches passes proofread and this rule" {
    final lines = example.split("\n");
    final body = mut [<str>];
    foreach (i, l in lines) {
        if (i > 0) {
            body.append(if (l.startsWith("    ")) l.sub(4) else l);
        }
    }
    final found = judgeText(Text{ kind = "change-description", title = lines[0].trim(), body = body.join("\n") },
        facts: fun () > Facts => shipping(1, lines: 40), judge: judgeRunner("."), cited: skipCited);
    std\assert(found.denies.len() == 0 and found.advice.len() == 0, message: "{found.denies} {found.advice}");
}

// Fixture is a merged or closed pull request's title and description, the Facts its diff
// gives, and the verdict the rule must reach on it.
object Fixture {
    number: int,
    title: str,
    facts: Facts,
    verdict: str,
    body: str,
}

test "the ten pull requests the budget was calibrated on keep their verdicts" {
    foreach (fx in calibration()) {
        final v = verdictWith(fx.title, body: fx.body, f: fx.facts);
        std\assert(v.decision == fx.verdict, message: "#{fx.number}: want {fx.verdict}, got {v.decision}: {v.reason}");
        if (fx.verdict == "advise") {
            std\assert(v.reason.indexOf("prose between the lead and the first heading") != null, message: "#{fx.number}: {v.reason}");
        }
    }
}

// calibration holds #422 through #431 as they were opened, with the Facts of each diff:
// fragments added, shipped source files and lines outside generated files, per parseNumstat.
fun calibration() > [Fixture] {
    return [
        Fixture{
            number = 431,
            title = "feat(cache): carry the caches spells declare; drop config cache --toolchain and --used-within",
            facts = Facts{ known = true, fragments = 2, shipped = 16, lines = 2742 },
            verdict = "allow",
            body = "On a magus miss, a fresh CI runner recompiled the whole tree because Go's own caches were empty. Carrying them took a flag per tool (`--toolchain go`, a proposed `--go-cache`), each naming a fact magus already holds.\n"
                + "\n"
                + "- A spell declares which of its sandbox grants are caches; the go spell declares GOCACHE and GOMODCACHE.\n"
                + "- `config cache export --remote` signs each spell's declared caches; only a holder of the signing key writes, every `import --remote` verifies, and a refusal leaves the build cold.\n"
                + "- Pruning entries the run never used is the default.\n"
                + "- `queue gate --cache <dir>` places those caches under that directory with exactly their declared grants; `validate` and `apply` keep them boxed.\n"
                + "- ci.yaml restores before the gate and saves after it, on main only.\n"
                + "- Removed: `--toolchain` and `--used-within`. Nothing added.",
        },
        Fixture{
            number = 430,
            title = "feat(guard): bind job exec callers in the guard; drop job exec --session and --vacate",
            facts = Facts{ known = true, fragments = 1, shipped = 23, lines = 2251 },
            verdict = "allow",
            body = "`magus job exec` without `--session` bound the whole checkout, even for a read-only job, and the guard then applied that lease's denies to the orchestrator that forked it. A host that gives a subagent its parent's session id made the documented `--session` advice bind the parent too.\n"
                + "\n"
                + "- The guard now records the binding when it lets `magus job exec` or `magus_job op=exec` through, keyed exactly on the caller's host, session and subagent ids, with no fallback between keys.\n"
                + "- `job exec` records only the base and checkout root. Rebinding after an ended job is part of exec.\n"
                + "- Removed: `--session`, `--vacate`, the session marker files, and the session-to-checkout fallback.\n"
                + "- Callers that report no identity keep a per-checkout record.\n"
                + "- `TestASubagentsExecNeverBindsItsParent` reproduces the incident.",
        },
        Fixture{
            number = 429,
            title = "docs(decisions): ADR 0003, running an invocation on another operating system",
            facts = Facts{ known = true, fragments = 0, shipped = 0, lines = 201 },
            verdict = "allow",
            body = "Records whether magus should run an invocation on a kernel other than the host's, so a Mac can reproduce Linux-only failures (landlock, /proc, socket path limits) before CI.\n"
                + "\n"
                + "- Decided, proposed status: a prefix script in this repository only, `tools/on-linux magus ...`, with a stated contract (read-only mount, explicit environment, no implicit pulls or VM starts, honest exit codes, kernel scope only).\n"
                + "- An execution-platform flag is recorded as considered and not planned; any proposal needs its own ADR and the listed preconditions.\n"
                + "- A `:linux` charm and a documented raw command are rejected.\n"
                + "\n"
                + "Six reviewer archetypes read the first draft; their findings and two corrected claims are in the Review section.",
        },
        Fixture{
            number = 428,
            title = "fix(vcs): settle hook stages only what the regeneration wrote",
            facts = Facts{ known = true, fragments = 0, shipped = 1, lines = 40 },
            verdict = "advise",
            body = "A merge that deleted a generated file stopped every merge commit after it. The settle hook listed paths from `git status --porcelain`, including one already staged as deleted and gone from disk, and `git add -- <path>` refused it: \"pathspec did not match any files\". Merging main after #422 retired `docs/reference/rules/cd.md` hit this on every open branch.\n"
                + "\n"
                + "`HookDirtyFiles` now lists only paths whose working tree differs from the operation's index, which is what a regeneration wrote and what staging has left to add. A generator that deletes an output still shows as ` D` and is still staged.\n"
                + "\n"
                + "A test pins a merge that deletes a file: the hook stages the regenerated file and leaves the deletion as the merge staged it.",
        },
        Fixture{
            number = 427,
            title = "revert: gate ci shards in the merge queue's candidate box (#412)",
            facts = Facts{ known = true, fragments = 0, shipped = 7, lines = 661 },
            verdict = "advise",
            body = "#412 landed with shard 0 and the docs shard red, and every main run since has failed them.\n"
                + "\n"
                + "Inside the box:\n"
                + "- Unix socket paths under the box's temp dir exceed the 108-byte `sun_path` limit.\n"
                + "- `/proc` reads are denied.\n"
                + "- Project locks collide.\n"
                + "- `site-generate` is denied its temp dir.\n"
                + "\n"
                + "This reverts the whole change, including `magus queue gate`, whose parity tests pin the workflow wiring. It re-lands once those causes are fixed and its shards are green.",
        },
        Fixture{
            number = 426,
            title = "feat(vcs): refuse shared-state writes from an older magus; write no keys from init",
            facts = Facts{ known = true, fragments = 1, shipped = 17, lines = 1372 },
            verdict = "allow",
            body = "An older magus overwrote hook sections a newer one had installed, and `init` dumped a full default config whose removed key then broke the newer binary.\n"
                + "\n"
                + "- Shared state is stamped with its writer: managed sections (`.gitattributes`, git hooks, hg/sl config), the merge-driver registration, and user and repo config. An older build refuses to overwrite a newer stamp. The error names both builds and how to update.\n"
                + "- Installed skills refuse a downgrade of their schema versions.\n"
                + "- `init` writes a header and stamp with no keys, and leaves an existing config alone.\n"
                + "- Guard `stale-write`: denies state-writing verbs (`init`, `server start`, `config set`, `agent install`, `agent harness`) from a stale `./magus`. For writes outside the checkout, it also denies a binary built off the base branch.\n"
                + "- A test reproduces the downgrade and shows the newer build repairing it.",
        },
        Fixture{
            number = 425,
            title = "fix(config): make MGS1040 a readable list without dropping a key or line",
            facts = Facts{ known = true, fragments = 1, shipped = 3, lines = 701 },
            verdict = "allow",
            body = "MGS1040 printed one line per occurrence and repeated its stale-binary paragraph for every unknown key.\n"
                + "\n"
                + "- Each unknown key prints once, by dotted path (`watch.env`), with every line it appears on and any suggestion or rename.\n"
                + "- The version gap is stated once, with the running version and the workspace floor, followed by runnable fixes: self update, the checkout's go-build, and the `GOEXPERIMENT=jsonv2 go run -trimpath ./cmd/magus run go-build --no-cache .` bootstrap for a dev build.\n"
                + "- The workspace that holds the file decides the relative path and the source-tree fixes, not the cwd, so `--root` and user-global files render correctly.\n"
                + "- `config.UnknownKeysError` carries the keys and lines as data.\n"
                + "- A test pins that 20 keys on 60 lines all reach both the message and the struct.",
        },
        Fixture{
            number = 424,
            title = "feat(queue): add queue gate --go-cache; carry the go toolchain cache around ci's boxed gate",
            facts = Facts{ known = true, fragments = 1, shipped = 4, lines = 262 },
            verdict = "allow",
            body = "The boxed CI gate withheld the runner's Go caches, so every shard compiled cold.\n"
                + "\n"
                + "- `magus queue gate --go-cache <dir>` makes `<dir>/go-build` and `<dir>/pkg/mod` the gate's GOCACHE and GOMODCACHE. The box grants those two paths only, in the go spell's modes.\n"
                + "- ci.yaml restores the signed Go bundle before the gate. The root shard saves it after a green run on main only (`--used-within 12h`).\n"
                + "- Trust: a pull request may write the directory, but nothing it writes is saved. Only main holds the signing key, and every restore verifies the signature.\n"
                + "- validate and apply take no such flag, so a queue candidate's caches stay in its box.\n"
                + "\n"
                + "Only CI proves the Linux side: landlock creating both directories, and a warm shard after the first save on main.",
        },
        Fixture{
            number = 423,
            title = "fix(guard): ask the workspace command rule on a built-in ask",
            facts = Facts{ known = true, fragments = 1, shipped = 3, lines = 100 },
            verdict = "allow",
            body = "A push chained with an admin merge (`git push ... && gh pr merge <n> --admin`) only asked: the built-in push-ungated rule answered ask, and the workspace command rule was consulted only on pass or advise. Approving the push ran the admin merge.\n"
                + "\n"
                + "- The workspace command and write rules now run on anything but a built-in deny.\n"
                + "- A workspace deny replaces a built-in ask. A workspace advise on an ask is dropped, like every other notice on an ask.\n"
                + "- Tests: a Go test pins the chained line becoming a deny, and gh.buzz pins an admin merge anywhere on the line, joined by `;`, `&&` or `||` or inside a subshell. A queued merge stays silent.",
        },
        Fixture{
            number = 422,
            title = "fix(guard): narrow the rules that deny correct commands",
            facts = Facts{ known = true, fragments = 1, shipped = 8, lines = 1231 },
            verdict = "allow",
            body = "Measured precision put several guard rules well under half: most of their denials blocked correct commands.\n"
                + "\n"
                + "- cd: rule deleted, page retired\n"
                + "- capture-filter and piped graph reads: advise instead of deny\n"
                + "- output-redirect: stderr redirects that lose nothing pass; a run's discarded stderr still denies\n"
                + "- raw-tool: gofmt that lists or diffs passes; `gofmt -w` still denies\n"
                + "- scripted-rewrite: appends pass; a data heredoc reads as text\n"
                + "- filter-without-input: recursive grep with no path passes\n"
                + "- token state: a bare listing that reaches no reader passes\n"
                + "\n"
                + "A test pins each changed rule beside git's global options (`-C`, `-c`, `--git-dir`, `--no-pager`).",
        },
    ];
}
