// The pull-request-text rule: the title and description `gh pr create` and `gh pr edit` write.
//
// A description gets a word budget that grows with the change: W = leadWords +
// wordsPerChange * U, where U, the distinct changes the branch proves, is at least 1 and
// the largest of:
//   the changelog fragments it adds or edits, plus one for a title marked breaking;
//   the clauses its title joins with `;`;
//   1 + floor(log2(1 + shipped source files));
//   1 + floor(log2(1 + changed lines / linesPerChange)), over every path not generated.
// Each term is a lower bound on what a reviewer must check. The paths and lines come from
// one `git diff --numstat` against the base, read for a description of the checkout's own
// branch. When the diff cannot be read (no base, a failed or empty diff, or a call about
// another branch's pull request) its terms count as 1 and a description over the budget
// is advised, never denied: the denial would rest on a fact nobody read. A hook that runs
// out of time fails open as a whole, as every rule does.
//
// The words are judged by libs/conventions/prose, the judge the pr-description CI step
// runs too, so the guard and CI cannot disagree: the title and description go to
// judge-docs as one pull request, and every finding is denied. That covers the lead (a
// paragraph naming the goal behind the change), headings, reply voice, tense, hedges,
// filler, the spelling of subagent, and credit to a tool or an agent. This rule keeps
// what the judge does not read: plain ASCII, the spaced hyphen, selling words, the budget
// and the title. When the description cannot be read, the whole line is searched for
// credit instead.
//
// The shape past the lead: bullets (a list may follow a one-line lead-in ending in `:`)
// and at most one closing sentence after them. Prose outside that shape, a lead or
// bullet past blockWords, and an area the diff touches that the description never names
// are advised, once per pull request.
namespace agentpolicy\pullRequests;

import "std";
import "magus";
import "vcs";
import "proc";
import "encoding/json";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/commits" as subjects;
import "./hack/magusfile/commits" as conventional;
import "./hack/magusfile/changelog" as entries;

final fixLine = "Rewrite it: a conventional title (`fix(cache): keep the key stable`), then a paragraph "
    + "naming the goal behind the change and why this code stands in its way, one bullet per change "
    + "and at most one closing sentence, no headings, within the budget the change earns; in plain "
    + "ASCII and the present tense, with no names, no credit to a tool or an agent, no attribution "
    + "line, and no account of how it was made.";
final shapeLine = "The shape: a lead paragraph with the goal and the change, one bullet per change, "
    + "at most one closing sentence, no headings. This is said once per pull request.";

// The budget's constants, each a norm this repository or its sources already set.
// wordsPerChange is the 60-word changelog fragment cap (changelogEntryWordCap in
// cmd/magus-utils/release.go) less its bold headline; linesPerChange is Google's "100
// lines is usually a reasonable size" for one change (eng-practices, small CLs).
// leadWords is blockWords: the lead names the goal and why this code stands in its way
// as well as the change, and the 60 pull requests before #557 led with 12 to 63 words.
final leadWords = 60;
final wordsPerChange = 50;
final linesPerChange = 100;
// A lead or bullet past the fragment cap is carrying more than one change.
final blockWords = 60;
// A line whose description could not be read past this length is judged long anyway.
final maxLine = 3000;

// Credit for the work, searched for only in a line whose description could not be read:
// the judge's attribution rule reads a description that could. A tool name after `.`, `/`,
// `-` or a word character is a path (`.claude/worktrees`), and "agent" alone is a word
// this repository's code uses, so only an agent as the subject of the work counts.
final credit = $"(?i)(^|[^./\w-])(claude|anthropic|copilot)\b|\b(sub)?agent('s)?\s+(found|implemented|built|fixed|reported|wrote|discovered|verified|measured)|\bbranch report\b";
final narrative = $"(?i)\b(this session|this week's session|the report above|as reported)\b";
final attribution = $"(?i)co-authored-by|generated with";
final nonASCII = $"[^ -~\n\t]";
final spacedHyphen = $"\S - \S";
final word = $"\S+";
final heading = $"^ {0,3}#{1,6}(\s|$)";
final bullet = $"^\s*([-*+]|[0-9]+[.)])\s";
final codeSpan = $"`[^`]*`";
final sentenceEnd = $"[.!?]+(\s|$)";

// The flags whose value is text this rule reads, long form first.
final titleFlags = ["--title", "-t"];
final bodyFlags = ["--body", "-b"];
final bodyFileFlags = ["--body-file", "-F"];
final baseFlags = ["--base", "-B"];
final headFlags = ["--head", "-H"];
// Every `gh pr create|edit` flag that takes a value, so what remains is a pull request
// named by number, URL or branch.
final valueFlags = titleFlags + bodyFlags + bodyFileFlags + baseFlags + headFlags + [
    "-R", "--repo", "-a", "--assignee", "-l", "--label", "-m", "--milestone", "-p", "--project",
    "-r", "--reviewer", "-T", "--template", "--add-label", "--remove-label", "--add-reviewer",
    "--remove-reviewer", "--add-assignee", "--remove-assignee", "--add-project", "--remove-project",
];

// writesText reports whether p is `gh pr create` or `gh pr edit` carrying a title or a
// description.
export fun writesText(p: helpers\Program) > bool {
    if (p.name != "gh") {
        return false;
    }
    final ops = helpers\stripFlags(p.args, valueFlags: ["-R", "--repo"]);
    if (ops.len() < 2 or ops[0] != "pr" or (ops[1] != "create" and ops[1] != "edit")) {
        return false;
    }
    foreach (arg in p.args) {
        foreach (flag in titleFlags + bodyFlags + bodyFileFlags) {
            if (arg == flag or arg.startsWith(flag + "=")) {
                return true;
            }
        }
    }
    return false;
}

// Value is one text flag's value and, when it is the next argument, that argument's index.
object Value {
    text: str,
    slot: int?,
}

// flagValues are the values given to any of flags, in order.
fun flagValues(args: [str], flags: [str]) > [Value] {
    final found = mut [<Value>];
    foreach (i, arg in args) {
        foreach (flag in flags) {
            if (arg == flag and i + 1 < args.len()) {
                found.append(Value{ text = args[i + 1], slot = i + 1 });
            } else if (arg.startsWith(flag + "=")) {
                found.append(Value{ text = arg.sub(flag.len() + 1), slot = null });
            }
        }
    }
    return found;
}

// textSlots are the arguments of p holding a title or description the parser rendered
// empty, a substitution such as `--body "$(cat <<'EOF' ...)"`.
export fun textSlots(p: helpers\Program) > [int] {
    final slots = mut [<int>];
    if (!writesText(p)) {
        return slots;
    }
    foreach (v in flagValues(p.args, flags: titleFlags + bodyFlags)) {
        if (v.text == "" and v.slot != null) {
            slots.append(v.slot!);
        }
    }
    return slots;
}

// bodyFiles are the --body-file paths the line's pull request calls read, `-` (stdin) left out.
export fun bodyFiles(programs: [helpers\Program]) > [str] {
    final paths = mut [<str>];
    foreach (p in programs) {
        if (writesText(p)) {
            foreach (v in flagValues(p.args, flags: bodyFileFlags)) {
                if (v.text != "" and v.text != "-") {
                    paths.append(v.text);
                }
            }
        }
    }
    return paths;
}

fun last(values: [Value]) > str? {
    if (values.len() == 0) {
        return null;
    }
    return values[values.len() - 1].text;
}

// Facts is what the branch a pull request is opened from changed against its base: the
// changelog fragments it adds or edits, the shipped source files it touches, and the lines
// it adds and deletes outside generated files. known is false when the diff could not be
// read, and the counts are then zero. paths are the changed paths outside generated
// files, and areas the projects and top-level packages they sit in (see touchedAreas),
// which only branchDiff fills.
export object Facts {
    known: bool,
    fragments: int,
    shipped: int,
    lines: int,
    paths: [str] = [<str>],
    areas: [str] = [<str>],
}

export fun unknownFacts() > Facts {
    return Facts{ known = false, fragments = 0, shipped = 0, lines = 0 };
}

// generated reports a path a generator writes, which proves nothing about what changed:
// one under a gen/ directory, or an index or lockfile regenerated with its sources.
fun generated(path: str) > bool {
    if (path.startsWith("gen/") or path.indexOf("/gen/") != null) {
        return true;
    }
    final parts = path.split("/");
    return ["MAGUS.md", "go.sum", "magus.lock", "pnpm-lock.yaml"].indexOf(parts[parts.len() - 1]) != null;
}

// parseNumstat reads `git diff --numstat --no-renames` output. A fragment counts only when lines
// were added to it, so one a release folds and deletes does not; a binary file is a path
// with no lines. An empty diff is unknown, since a pull request always changes something.
export fun parseNumstat(numstat: str) > Facts {
    var paths = 0;
    var fragments = 0;
    var shipped = 0;
    var lines = 0;
    final sources = mut [<str>];
    foreach (row in numstat.split("\n")) {
        final cols = row.split("\t");
        if (cols.len() < 3) {
            continue;
        }
        final path = cols[2];
        final added = std\parseInt(cols[0]) ?? 0;
        paths = paths + 1;
        if (entries\fragments([path]).len() > 0 and added > 0) {
            fragments = fragments + 1;
        }
        if (!generated(path)) {
            sources.append(path);
            lines = lines + added + (std\parseInt(cols[1]) ?? 0);
            if (entries\ships(path)) {
                shipped = shipped + 1;
            }
        }
    }
    if (paths == 0) {
        return unknownFacts();
    }
    return Facts{ known = true, fragments = fragments, shipped = shipped, lines = lines, paths = sources };
}

// describedAreas asks magus which project owns each path and whether it is generated, and
// returns the areas touchedAreas finds in the answer. An answer magus could not give is no
// areas: the areas only ever advise.
export fun describedAreas(paths: [str]) > [str] {
    if (paths.len() == 0) {
        return [<str>];
    }
    final described = magus\describe.file(paths, opts: {"quiet": true}) catch null;
    if (described == null) {
        return [<str>];
    }
    final files: [any] = described!["files"] ?? [<any>];
    return touchedAreas(files);
}

// touchedAreas names the areas a change touches, from `magus describe file` records: the
// owning project, or for the root project the top two directories of the path (a
// top-level package such as `internal/guard`). Generated outputs, files magus maintains,
// lockfiles and changelog fragments are left out: each follows from another change, so
// none asks a question of its own.
export fun touchedAreas(files: [any]) > [str] {
    final areas = mut [<str>];
    foreach (f in files) {
        final path: str = f["path"] ?? "";
        final role: str = f["role"] ?? "";
        final project: str = f["project"] ?? ".";
        if (path == "" or role == "output" or role == "maintained" or generated(path)
            or entries\fragments([path]).len() > 0) {
            continue;
        }
        var area = project;
        if (project == "." or project == "") {
            final parts = path.split("/");
            if (parts.len() > 2) {
                area = parts[0] + "/" + parts[1];
            } else {
                area = parts[0];
            }
        }
        if (areas.indexOf(area) == null) {
            areas.append(area);
        }
    }
    return areas;
}

// unnamedAreas are the areas text never names, by their path or by their last segment
// without its extension, so "the guard" names internal/guard.
export fun unnamedAreas(areas: [str], text: str) > [str] {
    final lower = text.lower();
    final unnamed = mut [<str>];
    foreach (area in areas) {
        final parts = area.split("/");
        final base = parts[parts.len() - 1].split(".")[0];
        if (lower.indexOf(area.lower()) == null and (base == "" or lower.indexOf(base.lower()) == null)) {
            unnamed.append(area);
        }
    }
    return unnamed;
}

// areaQuestions asks of each unnamed area what a reviewer asks first.
export fun areaQuestions(unnamed: [str]) > [str] {
    final asked = mut [<str>];
    foreach (area in unnamed) {
        asked.append("why does this touch {area}? The description never names it; say why, or ignore this if it is plain");
    }
    return asked;
}

// branchDiff reads the Facts of the checkout's branch: one `git diff --numstat` over the
// commits a pull request carries. vcs\changedFiles is not used because it diffs the working
// tree, costs three processes and may fetch in a shallow clone. base is the pull request's
// --base, "" when it names none; one other than the repository's base is unknown rather
// than guessed.
export fun branchDiff(workspace: str) > fun (base: str) > Facts {
    return fun (base: str) > Facts {
        final ref = vcs\base() catch "";
        if (ref == "" or (base != "" and ref != base and !ref.endsWith("/" + base))) {
            return unknownFacts();
        }
        final res = vcs\cmd(["diff", "--numstat", "--no-renames", "{ref}...HEAD"],
            opts: {"quiet": true, "allow_failure": true, "dir": workspace}) catch null;
        if (res == null or res!.code != 0) {
            return unknownFacts();
        }
        final facts = parseNumstat(res!.stdout);
        return Facts{ known = facts.known, fragments = facts.fragments, shipped = facts.shipped,
            lines = facts.lines, paths = facts.paths, areas = describedAreas(facts.paths) };
    };
}

// Judged is one finding of the prose judge, libs/conventions/prose.
export object Judged {
    rule: str,
    line: int,
    message: str,
    matched: str = "",
}

// judgeRunner returns a judge that runs libs/conventions/cmd/judge-docs over a pull
// request's text, the title on the first line. The judge lives in Go, where the Markdown
// lint and the CI step reach the same rules; a judge that did not run is a finding, since
// silence would read as a pass.
export fun judgeRunner(workspace: str) > fun (text: str) > [Judged] {
    return fun (text: str) > [Judged] {
        final run = proc\exec("go", args: ["run", "./cmd/judge-docs", "-surface", "pull-request"],
            dir: workspace + "/libs/conventions", opts: {"stdin": text, "quiet": true, "allow_failure": true}) catch null;
        if (run == null or run!.code != 0) {
            final why = if (run == null) "go did not start" else run!.stderr.trim();
            return [Judged{ rule = "judge", line = 0,
                message = "the prose judge did not run ({why}); run `go run ./cmd/judge-docs -surface pull-request` "
                    + "in libs/conventions with the title and description on stdin, and read why" }];
        }
        return parseJudged(run!.stdout);
    };
}

// parseJudged reads judge-docs's findings, whose source is `pull-request:<line>`.
export fun parseJudged(stdout: str) > [Judged] {
    final rows: [any] = json\parse(stdout) catch [<any>];
    final found = mut [<Judged>];
    foreach (r in rows) {
        final source: str = r["source"] ?? "";
        final colon = source.indexOf(":");
        var line = 0;
        if (colon != null) {
            line = std\parseInt(source.sub(colon! + 1)) ?? 0;
        }
        found.append(Judged{ rule = r["rule"] ?? "", line = line, message = r["message"] ?? "", matched = r["match"] ?? "" });
    }
    return found;
}

// judgedProblem renders a finding as a denial line: the title for line 1, the
// description's line otherwise, counted from the description's first line.
export fun judgedProblem(f: Judged) > str {
    if (f.line == 1) {
        return "the title: {f.message} [{f.rule}]";
    }
    if (f.line > 1) {
        return "description line {f.line - 1}: {f.message} [{f.rule}]";
    }
    return "{f.message} [{f.rule}]";
}

// Units is the count of distinct changes a pull request proves, with each term it is the
// largest of, so a verdict can say why.
export object Units {
    count: int,
    breaking: bool,
    clauses: int,
    files: int,
    lines: int,
    facts: Facts,
}

// floorLog2 is floor(log2(n)) for n >= 1.
fun floorLog2(n: int) > int {
    var k = 0;
    var v = n;
    while (v > 1) {
        v = v / 2;
        k = k + 1;
    }
    return k;
}

// countUnits counts the changes a pull request titled title proves. An unknown diff's terms
// count as 1.
export fun countUnits(title: str, facts: Facts) > Units {
    final breaking = conventional\isBreaking(title);
    var fragments = facts.fragments;
    if (breaking) {
        fragments = fragments + 1;
    }
    final clauses = title.split(";").len();
    final files = 1 + floorLog2(1 + facts.shipped);
    // Integer division keeps the floor exact: every power of two is a whole number.
    final lines = 1 + floorLog2((linesPerChange + facts.lines) / linesPerChange);
    var count = 1;
    foreach (term in [fragments, clauses, files, lines]) {
        if (term > count) {
            count = term;
        }
    }
    return Units{ count = count, breaking = breaking, clauses = clauses, files = files, lines = lines, facts = facts };
}

export fun wordBudget(units: Units) > int {
    return leadWords + wordsPerChange * units.count;
}

fun plural(n: int, noun: str) > str {
    if (n == 1) {
        return "1 {noun}";
    }
    return "{n} {noun}s";
}

// overBudget names a description of words words past its budget, and what U counted.
fun overBudget(words: int, units: Units) > str {
    final u = units.count;
    final f = units.facts;
    var breaking = "";
    if (units.breaking) {
        breaking = " plus 1 for the breaking title";
    }
    var terms = "{plural(units.clauses, noun: "title clause")}";
    if (f.known) {
        terms = "{plural(f.fragments, noun: "changelog fragment")}{breaking}, " + terms
            + ", {plural(f.shipped, noun: "shipped source file")} (counting {units.files}) and "
            + "{plural(f.lines, noun: "changed line")} outside generated files (counting {units.lines})";
    } else if (units.breaking) {
        terms = terms + ", 1 for the breaking title";
    }
    var read = "";
    if (!f.known) {
        read = "; the branch's diff against its base could not be read, so it counts as 1 and this is advice, not a denial";
    }
    return "{words} words, past this pull request's budget of {wordBudget(units)} "
        + "({leadWords} + {wordsPerChange} for each of {plural(u, noun: "change")}, "
        + "the most of {terms}){read}. Cut it to what a reviewer needs to review it, or split the "
        + "pull request if it carries more changes than that";
}

// Block is one blank-line-separated block of a description: a paragraph, a list, a
// heading or a code fence.
object Block {
    kind: str,
    lines: [str],
}

// splitBlocks splits body into blocks. A heading is its own block, a list may follow a
// paragraph line directly (`Inside the box:` then `- ...`), and a line after a bullet
// continues it until a blank line.
fun splitBlocks(body: str) > [Block] {
    final blocks = mut [<Block>];
    var current = mut [<str>];
    var kind = "";
    var fence = "";
    final flush = fun () > void {
        if (current.len() > 0) {
            blocks.append(Block{ kind = kind, lines = current });
            current = mut [<str>];
        }
    };
    foreach (line in body.split("\n")) {
        final trimmed = line.trim();
        if (fence != "") {
            if (trimmed.startsWith(fence)) {
                fence = "";
            }
        } else if (trimmed.startsWith("```") or trimmed.startsWith("~~~")) {
            flush();
            blocks.append(Block{ kind = "code", lines = [trimmed] });
            fence = trimmed.sub(0, len: 3);
        } else if (trimmed == "") {
            flush();
        } else if (heading.match(line) != null) {
            flush();
            blocks.append(Block{ kind = "heading", lines = [trimmed] });
        } else if (bullet.match(line) != null and kind != "list") {
            flush();
            kind = "list";
            current.append(line);
        } else {
            if (current.len() == 0) {
                kind = "paragraph";
            }
            current.append(line);
        }
    }
    flush();
    return blocks;
}

fun wordsIn(text: str) > int {
    return (word.matchAll(text) ?? [<[str]>]).len();
}

// listItems are a list block's bullets, each with its continuation lines, marker left out.
fun listItems(list: Block) > [str] {
    final items = mut [<str>];
    foreach (line in list.lines) {
        if (bullet.match(line) != null or items.len() == 0) {
            final marker = bullet.match(line);
            var text = line.trim();
            if (marker != null) {
                text = line.sub(marker![0].len()).trim();
            }
            items.append(text);
        } else {
            items[items.len() - 1] = items[items.len() - 1] + " " + line.trim();
        }
    }
    return items;
}

// sentencesIn counts sentence ends outside code spans, so `v0.4.3` or `a.b` is not one.
fun sentencesIn(text: str) > int {
    final n = (sentenceEnd.matchAll(codeSpan.replaceAll(text, with: "")) ?? [<[str]>]).len();
    if (n == 0) {
        return 1;
    }
    return n;
}

// Findings are the problems with one description, split by verdict.
export object Findings {
    denies: [str],
    advice: [str],
}

// judgeShape advises on body's shape past the lead: bullets and at most one closing
// sentence after them. A fenced code block may sit anywhere after the lead. A missing lead
// and a heading are the prose judge's (lead-context and reply-voice), so this denies
// nothing.
export fun judgeShape(body: str) > Findings {
    final denies = mut [<str>];
    final advice = mut [<str>];
    final blocks = splitBlocks(body);
    if (blocks.len() == 0) {
        return Findings{ denies = denies, advice = advice };
    }
    if (blocks[0].kind == "paragraph") {
        final lead = wordsIn(blocks[0].lines.join(" "));
        if (lead > blockWords) {
            advice.append("a lead of {lead} words, past {blockWords}: state the goal and the change, and move the rest into bullets");
        }
    }
    var lastList = -1;
    foreach (i, b in blocks) {
        if (b.kind == "list") {
            lastList = i;
            foreach (item in listItems(b)) {
                final n = wordsIn(item);
                if (n > blockWords) {
                    advice.append("a bullet of {n} words, past {blockWords}: a bullet that long carries two changes, so split it");
                }
            }
        }
    }
    var walls = 0;
    foreach (i, b in blocks) {
        if (i > 0 and b.kind == "paragraph") {
            final leadIn = i + 1 < blocks.len() and blocks[i + 1].kind == "list" and b.lines.len() == 1
                and b.lines[0].trim().endsWith(":");
            final coda = lastList >= 0 and i > lastList and i == blocks.len() - 1
                and sentencesIn(b.lines.join(" ")) == 1;
            if (!leadIn and !coda) {
                walls = walls + 1;
            }
        }
    }
    if (walls > 0) {
        advice.append("prose past the lead outside the bullets ({plural(walls, noun: "paragraph")}): make each change a "
            + "bullet, and keep what follows the bullets to one sentence");
    }
    return Findings{ denies = denies, advice = advice };
}

// descriptionWording judges the words of body outside its code blocks and code spans for
// the first selling adjective the prose judge has not already reported: judged holds the
// words it reported, lowercased. Filler and the spelling of subagent are the judge's.
export fun descriptionWording(body: str, judged: [str]) > [str] {
    final prose = mut [<str>];
    foreach (b in splitBlocks(body)) {
        if (b.kind != "code") {
            prose.append(codeSpan.replaceAll(b.lines.join(" "), with: ""));
        }
    }
    foreach (selling in subjects\puffery.matchAll(prose.join("\n")) ?? [<[str]>]) {
        if (judged.indexOf(selling[0].lower()) == null) {
            return ["\"{selling[0]}\": drop it and say what changed"];
        }
    }
    return [<str>];
}

// alreadyJudged reports whether problem quotes a word the prose judge reported.
fun alreadyJudged(problem: str, judged: [str]) > bool {
    foreach (w in judged) {
        if (problem.lower().indexOf("\"{w}\"") != null) {
            return true;
        }
    }
    return false;
}

// describesBranch reports whether p's pull request is the checkout's branch's, the only one
// whose diff the rule can read: `gh pr create` without --head, or `gh pr edit` naming no
// pull request.
fun describesBranch(p: helpers\Program) > bool {
    return helpers\stripFlags(p.args, valueFlags: valueFlags).len() == 2 and flagValues(p.args, flags: headFlags).len() == 0;
}

// textProblems names what is wrong with one call's title and description. files holds the
// contents of the body files the guard could read; diff reads the branch's Facts against a
// base (see branchDiff), and is called only for the checkout's own pull request; judge is
// the prose judge (see judgeRunner). A value the parser could not render is unknown, and
// then the whole line is read in its place.
export fun textProblems(p: helpers\Program, line: str, files: {str: str}, diff: fun (base: str) > Facts, judge: fun (text: str) > [Judged]) > Findings {
    final problems = mut [<str>];
    final advice = mut [<str>];
    final title = last(flagValues(p.args, flags: titleFlags));
    var body = last(flagValues(p.args, flags: bodyFlags));
    final file = last(flagValues(p.args, flags: bodyFileFlags));
    var known = title != "" and body != "";
    if (file != null) {
        final content = files[file!];
        if (content == null) {
            known = false;
        } else {
            body = content!;
        }
    }
    var text = line;
    if (known) {
        text = "{title ?? ""}\n{body ?? ""}";
    }
    final judgedWords = mut [<str>];
    if (known and body != null) {
        foreach (f in judge(text)) {
            problems.append(judgedProblem(f));
            if (f.matched != "") {
                judgedWords.append(f.matched.lower());
            }
        }
    } else {
        if (credit.match(text) != null) {
            problems.append("it credits a tool or an agent: describe the change, not how it was produced");
        }
        if (narrative.match(text) != null) {
            problems.append("it narrates the session that wrote it, which a description outlives");
        }
        if (attribution.match(text) != null) {
            problems.append("an attribution line: a description credits nobody");
        }
    }
    if (nonASCII.match(text) != null) {
        problems.append("a character outside plain ASCII (an em dash, a curly quote, an emoji)");
    }
    if (spacedHyphen.match(text) != null) {
        problems.append("a spaced hyphen used as a dash: restructure the sentence");
    }
    if (known and body != null) {
        foreach (problem in descriptionWording(body!, judged: judgedWords)) {
            problems.append(problem);
        }
        final shape = judgeShape(body!);
        foreach (problem in shape.denies) {
            problems.append(problem);
        }
        foreach (note in shape.advice) {
            advice.append(note);
        }
        final prose = mut [<str>];
        foreach (b in splitBlocks(body!)) {
            if (b.kind == "list") {
                prose.append(listItems(b).join(" "));
            } else if (b.kind != "code") {
                prose.append(b.lines.join(" "));
            }
        }
        final words = wordsIn(prose.join(" "));
        var facts = unknownFacts();
        if (describesBranch(p)) {
            facts = diff(last(flagValues(p.args, flags: baseFlags)) ?? "");
        }
        final units = countUnits(title ?? "", facts: facts);
        if (words > wordBudget(units)) {
            if (units.facts.known) {
                problems.append(overBudget(words, units: units));
            } else {
                advice.append(overBudget(words, units: units));
            }
        }
        foreach (question in areaQuestions(unnamedAreas(facts.areas, text: text))) {
            advice.append(question);
        }
    } else if (!known and line.len() > maxLine) {
        problems.append("the command runs {line.len()} characters: cut the description to what a reviewer needs");
    }
    if (title != null and title! != "") {
        final problem = conventional\problem(title!);
        if (problem != "") {
            problems.append("the title fails the check CI runs on it: pr-title: \"{title!}\": {problem}");
        }
        foreach (problem in subjects\wordingProblems(title!, conventional: true)) {
            if (!alreadyJudged(problem, judged: judgedWords)) {
                problems.append("the title: {problem}");
            }
        }
    }
    return Findings{ denies = problems, advice = advice };
}

// adviceKey names the pull request p writes, so its advice is given once: the one it names,
// else its title, else the checkout's branch's.
fun adviceKey(p: helpers\Program) > str {
    final ops = helpers\stripFlags(p.args, valueFlags: valueFlags);
    if (ops.len() > 2) {
        return "pull-request-text:" + ops[2];
    }
    return "pull-request-text:" + (last(flagValues(p.args, flags: titleFlags)) ?? "branch");
}

// decidePullRequest denies any pull request title or description that breaks the rules, and
// advises, once per pull request, a description that departs from the shape or leaves a
// touched area unnamed. The title answers to the conventional-commit rule the pr-title check
// applies in CI, and the description to the judge the pr-description check runs, so the
// guard and CI cannot disagree.
export fun decidePullRequest(programs: [helpers\Program], line: str, files: {str: str}, diff: fun (base: str) > Facts, judge: fun (text: str) > [Judged], once: fun (key: str) > bool) > GuardVerdict {
    final problems = mut [<str>];
    final advice = mut [<str>];
    var key = "";
    foreach (p in programs) {
        if (writesText(p)) {
            final found = textProblems(p, line: line, files: files, diff: diff, judge: judge);
            foreach (problem in found.denies) {
                if (problems.indexOf(problem) == null) {
                    problems.append(problem);
                }
            }
            if (found.advice.len() > 0 and key == "") {
                key = adviceKey(p);
            }
            foreach (note in found.advice) {
                advice.append(note);
            }
        }
    }
    if (problems.len() > 0) {
        return magus\guard.deny("This pull request text breaks the description rules:\n  - " + problems.join("\n  - ") + "\n" + fixLine);
    }
    if (advice.len() > 0 and once(key)) {
        return magus\guard.advise("This pull request description could read better:\n  - " + advice.join("\n  - ") + "\n" + shapeLine);
    }
    return magus\guard.allow();
}

final goodTitle = "fix(guard): keep the key stable";

fun create(title: str, body: str) > [helpers\Program] {
    return helpers\request([["gh", "pr", "create", "--base", "main", "--title", title, "--body", body]]);
}

// facts is a diff reader that answers f and never touches a repository.
fun facts(f: Facts) > fun (base: str) > Facts {
    return fun (base: str) > Facts {
        return f;
    };
}

// passing is a prose judge that finds nothing, so a case sees only this rule's own verdicts;
// libs/conventions/prose tests the judge itself.
fun passing() > fun (text: str) > [Judged] {
    return fun (text: str) > [Judged] {
        return [<Judged>];
    };
}

// reporting is a prose judge that reports f whatever it reads.
fun reporting(f: Judged) > fun (text: str) > [Judged] {
    return fun (text: str) > [Judged] {
        return [f];
    };
}

fun judged(programs: [helpers\Program], line: str, files: {str: str}) > GuardVerdict {
    return decidePullRequest(programs, line: line, files: files, diff: facts(unknownFacts()), judge: passing(), once: helpers\counter());
}

fun judgedReason(title: str, body: str) > str {
    return judged(create(title, body: body), line: "", files: {<str: str>}).reason;
}

fun verdictWith(title: str, body: str, f: Facts) > GuardVerdict {
    return decidePullRequest(create(title, body: body), line: "", files: {<str: str>}, diff: facts(f), judge: passing(), once: helpers\counter());
}

// sized is a well-shaped description of n words, n >= 20: a 20-word lead, then bullets of
// at most 20 words.
fun sized(n: int) > str {
    final lines = mut ["word ".repeat(20)];
    var left = n - 20;
    while (left > 0) {
        var take = left;
        if (take > 20) {
            take = 20;
        }
        lines.append("- " + "word ".repeat(take));
        left = left - take;
    }
    return lines.join("\n");
}

fun shipping(shipped: int, lines: int) > Facts {
    return Facts{ known = true, fragments = 0, shipped = shipped, lines = lines };
}

test "a conventional title and a plain description pass" {
    foreach (argv in [
        ["gh", "pr", "create", "--title", goodTitle, "--body", "The key drifted between runs; this pins it to the source digest."],
        ["gh", "pr", "create", "-t", "feat: add a commit-msg hook", "-b", "Adds the hook.", "--base", "main"],
        ["gh", "pr", "edit", "412", "--body", "Moves the rule under .claude/skills/ and hack/policy; an agent reads it at spawn."],
        ["gh", "-R", "egladman/magus", "pr", "edit", "412", "--title=docs: README framing; one line per audience"],
    ]) {
        final v = judged(helpers\request([argv]), line: argv.join(" "), files: {<str: str>});
        std\assert(v.decision == "allow", message: "{argv.join(" ")}: {v.reason}");
    }
}

test "each description rule is named when broken" {
    final cases = {
        "Pins the key — for good.": "plain ASCII",
        "Pins the key - for good.": "spaced hyphen",
        "Adds a cutting-edge cache.": "\"cutting-edge\"",
    };
    foreach (body, want in cases) {
        final reason = judgedReason(goodTitle, body: body);
        std\assert(reason.indexOf(want) != null, message: "{body}: {reason}");
        std\assert(reason.indexOf("naming the goal behind the change") != null, message: "states the fix");
    }
}

test "every finding of the prose judge is denied with where it sits" {
    final lead = Judged{ rule = "lead-context", line = 2, message = "It opens with a heading: open with a paragraph." };
    final v = decidePullRequest(create(goodTitle, body: "## Summary"), line: "", files: {<str: str>},
        diff: facts(unknownFacts()), judge: reporting(lead), once: helpers\counter());
    std\assert(v.decision == "deny", message: v.reason);
    std\assert(v.reason.indexOf("description line 1: It opens with a heading: open with a paragraph. [lead-context]") != null, message: v.reason);
    final title = Judged{ rule = "filler", line = 1, message = "Drop 'robust': state the fact.", matched = "robust" };
    final t = decidePullRequest(create("fix(cache): add a robust key", body: "Pins the key."), line: "", files: {<str: str>},
        diff: facts(unknownFacts()), judge: reporting(title), once: helpers\counter());
    std\assert(t.reason.indexOf("the title: Drop 'robust': state the fact. [filler]") != null, message: t.reason);
    std\assert(t.reason.indexOf("\"robust\": drop it") == null, message: "a word the judge reported is not reported twice: {t.reason}");
}

test "the judge reads the title and the description as one pull request" {
    final seen = mut [<str>];
    final recording = fun (text: str) > [Judged] {
        seen.append(text);
        return [<Judged>];
    };
    decidePullRequest(create(goodTitle, body: "Pins the key."), line: "", files: {<str: str>},
        diff: facts(unknownFacts()), judge: recording, once: helpers\counter());
    std\assert(seen.len() == 1 and seen[0] == goodTitle + "\nPins the key.", message: "{seen}");
    final unread = helpers\request([["gh", "pr", "create", "--title", goodTitle, "--body", ""]]);
    decidePullRequest(unread, line: "gh pr create --body \"$BODY\"", files: {<str: str>},
        diff: facts(unknownFacts()), judge: recording, once: helpers\counter());
    std\assert(seen.len() == 1, message: "a description nobody could read is not judged");
}

test "parseJudged reads each finding's line from its source" {
    final got = parseJudged("[\{\"node\":\"pull-request\",\"source\":\"pull-request:3\",\"language\":\"pull-request\","
        + "\"rule\":\"hedge\",\"message\":\"Drop 'might fix'.\",\"match\":\"might fix\"}]");
    std\assert(got.len() == 1 and got[0].rule == "hedge" and got[0].line == 3 and got[0].matched == "might fix", message: "{got.len()}");
    std\assert(judgedProblem(got[0]) == "description line 2: Drop 'might fix'. [hedge]", message: judgedProblem(got[0]));
    std\assert(parseJudged("[]").len() == 0, message: "no finding");
}

test "a description is judged for the selling words the prose judge leaves" {
    final cases = {
        "Adds a powerful spell.": "\"powerful\": drop it and say what changed",
        "Adds a cutting-edge cache.": "\"cutting-edge\"",
        "Adds an Elegant key.": "\"Elegant\"",
    };
    foreach (body, want in cases) {
        final problems = descriptionWording(body, judged: [<str>]);
        std\assert(problems.len() == 1 and problems[0].indexOf(want) != null, message: "{body}: {problems}");
        std\assert(judgedReason(goodTitle, body: body).indexOf(want) != null, message: "denied in the guard: {body}");
    }
    std\assert(descriptionWording("The elegance of the key.", judged: [<str>]).len() == 0, message: "a noun is not puffery");
    final rest = descriptionWording("Adds a robust and powerful cache.", judged: ["robust"]);
    std\assert(rest.len() == 1 and rest[0].indexOf("\"powerful\"") != null, message: "the judge reported robust: {rest}");
}

test "code in a description is not judged for wording" {
    foreach (body in [
        "Keeps the `powerful` flag and the `elegant` key.",
        "Pins the key.\n\n```\nit is a powerful key\n```\n\n- Drops the old key.",
        "Pins the key.\n\n- Keeps `powerful` as the name.\n- Keeps `a\nrobust` split over lines.",
    ]) {
        std\assert(descriptionWording(body, judged: [<str>]).len() == 0, message: "{body}: {descriptionWording(body, judged: [<str>])}");
        std\assert(judgedReason(goodTitle, body: body) == "", message: body);
    }
    std\assert(descriptionWording("Pins the key.\n\n```\npowerful\n```\n\nIt is a powerful key.", judged: [<str>]).len() == 1, message: "prose after a fence is judged");
}

test "a title is judged for the imperative and puffery after its prefix" {
    foreach (title, want in {
        "feat(prose): adds a vale spell": "not 'added' or 'adds'",
        "feat(prose)!: added a vale spell": "not 'added' or 'adds'",
        "fix: updated the key": "not 'added' or 'adds'",
        "fix(cache): add a robust key": "drop it and say what changed",
        "feat(cache): add a powerful cache": "\"powerful\"",
    }) {
        final reason = judgedReason(title, body: "Pins the key.");
        std\assert(reason.indexOf("the title: ") != null and reason.indexOf(want) != null, message: "{title}: {reason}");
    }
    std\assert(judgedReason("fix(cache): keep the key stable", body: "Pins the key.") == "", message: "imperative title");
    std\assert(judgedReason(goodTitle, body: "Adds the hook.") == "", message: "a body is not held to the imperative");
}

test "the budget counts the changes the diff proves" {
    final one = countUnits(goodTitle, facts: shipping(1, lines: 40));
    std\assert(one.count == 2 and wordBudget(one) == 160, message: "one shipped file earns a second change: {one.count}");
    std\assert(countUnits(goodTitle, facts: shipping(0, lines: 0)).count == 1, message: "nothing proven is still one change");
    std\assert(countUnits("fix: a; b; c", facts: shipping(0, lines: 0)).count == 3, message: "each title clause");
    std\assert(countUnits("feat!: drop x", facts: Facts{ known = true, fragments = 1, shipped = 0, lines = 0 }).count == 2, message: "a breaking title adds to the fragments");
    foreach (shipped, want in {1: 2, 3: 3, 6: 3, 7: 4, 15: 5, 31: 6}) {
        std\assert(countUnits(goodTitle, facts: shipping(shipped, lines: 0)).files == want, message: "{shipped} files");
    }
    foreach (lines, want in {99: 1, 100: 2, 300: 3, 700: 4, 1500: 5}) {
        std\assert(countUnits(goodTitle, facts: shipping(0, lines: lines)).lines == want, message: "{lines} lines");
    }
    std\assert(wordBudget(countUnits(goodTitle, facts: unknownFacts())) == 110, message: "the title alone earns 110 words");
}

test "a description past its budget is denied with the budget and why" {
    final small = shipping(0, lines: 10);
    std\assert(verdictWith(goodTitle, body: sized(110), f: small).decision == "allow", message: "110 is the budget for one change");
    final over = verdictWith(goodTitle, body: sized(111), f: small);
    std\assert(over.decision == "deny", message: over.reason);
    std\assert(over.reason.indexOf("111 words, past this pull request's budget of 110 (60 + 50 for each of 1 change, the most of 0 changelog fragments, 1 title clause, 0 shipped source files (counting 1) and 10 changed lines outside generated files (counting 1))") != null, message: over.reason);
    std\assert(over.reason.indexOf("split the pull request") != null, message: "names the other fix");
    final wide = verdictWith(goodTitle, body: sized(210), f: shipping(3, lines: 250));
    std\assert(wide.decision == "allow", message: "three changes earn 210 words: {wide.reason}");
    std\assert(verdictWith(goodTitle, body: sized(80) + "\n\n```\n" + "code ".repeat(200) + "\n```", f: small).decision == "allow", message: "fenced code is not counted");
}

test "a budget the diff could not settle is advice, told once" {
    final body = sized(120);
    final v = verdictWith(goodTitle, body: body, f: unknownFacts());
    std\assert(v.decision == "advise", message: v.reason);
    std\assert(v.reason.indexOf("could not be read, so it counts as 1 and this is advice") != null, message: v.reason);

    final once = helpers\counter();
    final edit = helpers\request([["gh", "pr", "edit", "412", "--body", body]]);
    final big = facts(shipping(100, lines: 5000));
    std\assert(decidePullRequest(edit, line: "", files: {<str: str>}, diff: big, judge: passing(), once: once).decision == "advise", message: "another pull request's diff is never read");
    std\assert(decidePullRequest(edit, line: "", files: {<str: str>}, diff: big, judge: passing(), once: once).decision == "allow", message: "said once per pull request");
}

test "the diff is read once, and only for the checkout's own pull request" {
    final reads = mut [<str>];
    final counting = fun (base: str) > Facts {
        reads.append(base);
        return shipping(1, lines: 40);
    };
    decidePullRequest(create(goodTitle, body: "Pins the key."), line: "", files: {<str: str>}, diff: counting, judge: passing(), once: helpers\counter());
    std\assert(reads.len() == 1 and reads[0] == "main", message: "one read, against the pull request's base");
    final headed = helpers\request([["gh", "pr", "create", "--head", "other", "--title", goodTitle, "--body", sized(100)]]);
    decidePullRequest(headed, line: "", files: {<str: str>}, diff: counting, judge: passing(), once: helpers\counter());
    std\assert(reads.len() == 1, message: "another branch's diff is not this checkout's");
}

test "an area the diff touches and the description never names is a question, not a denial" {
    final touched = Facts{ known = true, fragments = 0, shipped = 2, lines = 40,
        paths = ["internal/guard/dir.go", "docs/guard.md"], areas = ["internal/guard", "docs", "libs/conventions"] };
    final v = verdictWith(goodTitle, body: "The guard keeps the key; the docs say so.", f: touched);
    std\assert(v.decision == "advise", message: v.reason);
    std\assert(v.reason.indexOf("why does this touch libs/conventions?") != null, message: v.reason);
    std\assert(v.reason.indexOf("touch internal/guard") == null and v.reason.indexOf("touch docs") == null, message: "named areas ask nothing: {v.reason}");
    final named = verdictWith(goodTitle, body: "The guard keeps the key, the docs say so, and conventions pin it.", f: touched);
    std\assert(named.decision == "allow", message: named.reason);
}

test "touchedAreas names projects and top-level packages, generated files and fragments aside" {
    final files: [any] = [
        {"path": "internal/guard/dir.go", "project": ".", "role": "source"},
        {"path": "internal/guard/rules/x.go", "project": ".", "role": "source"},
        {"path": "libs/conventions/prose/voice.go", "project": "libs/conventions", "role": "source"},
        {"path": "magusfile.buzz", "project": ".", "role": "source"},
        {"path": "MAGUS.md", "project": ".", "role": "output"},
        {"path": ".gitattributes", "project": ".", "role": "maintained"},
        {"path": "docs/pnpm-lock.yaml", "project": "docs", "role": "source"},
        {"path": "changes/unreleased/writing-rules.md", "project": ".", "role": "source"},
    ];
    final got = touchedAreas(files);
    std\assert(got.join(",") == "internal/guard,libs/conventions,magusfile.buzz", message: got.join(","));
    std\assert(unnamedAreas(got, text: "The Guard and the magusfile.").join(",") == "libs/conventions", message: "named by last segment, any case");
}

test "parseNumstat counts fragments, shipped files and lines, generated files aside" {
    final f = parseNumstat("6\t0\tchanges/unreleased/a.md\n0\t6\tchanges/unreleased/folded.md\n"
        + "10\t2\tinternal/cache/key.go\n30\t0\tinternal/cache/key_test.go\n5\t5\tdocs/guide.md\n"
        + "400\t400\tinternal/spell/gen/go.bo\n1\t1\tMAGUS.md\n-\t-\tassets/logo.png\n");
    std\assert(f.known, message: "a diff was read");
    std\assert(f.fragments == 1, message: "a folded fragment is not a change: {f.fragments}");
    std\assert(f.shipped == 2, message: "key.go and the logo ship: {f.shipped}");
    std\assert(f.lines == 64, message: "every line outside generated files: {f.lines}");
    std\assert(f.paths.len() == 6 and f.paths.indexOf("MAGUS.md") == null, message: "the paths outside generated files: {f.paths}");
    std\assert(!parseNumstat("").known, message: "an empty diff is unknown");
}

test "the shape is a lead, bullets, and at most one closing sentence" {
    final lead = "The key drifted between runs.";
    foreach (body in [
        lead,
        lead + "\n\n- Pins it to the source digest.\n- Drops the old key.",
        lead + "\n\nInside the key:\n- The digest.\n- The platform.\n\nA test pins both.",
        lead + "\n\n- Pins it.\n\n```\nmagus run build\n```",
    ]) {
        final v = verdictWith(goodTitle, body: body, f: unknownFacts());
        std\assert(v.decision == "allow", message: "{body}: {v.reason}");
    }
    final advised = {
        lead + "\n\nIt now pins the digest.": "prose past the lead",
        lead + "\n\n- Pins it.\n\nA test pins it. Another test drops it.": "prose past the lead",
        lead + "\n\nFirst.\n\n- Pins it.": "prose past the lead",
        lead + "\n\n- " + "word ".repeat(61): "a bullet of 61 words",
        "word ".repeat(61): "a lead of 61 words",
    };
    foreach (body, want in advised) {
        final v = verdictWith(goodTitle, body: body, f: shipping(5, lines: 500));
        std\assert(v.decision == "advise", message: "{body}: {v.decision}");
        std\assert(v.reason.indexOf(want) != null and v.reason.indexOf("The shape:") != null, message: v.reason);
    }
}

test "a description read from a heredoc or a body file is judged" {
    final line = "gh pr create --title \"fix: pin the key\" --body \"$(cat <<'EOF'\nClaude pinned the key.\nEOF\n)\"";
    final programs = helpers\request([["gh", "pr", "create", "--title", "fix: pin the key", "--body", ""], ["cat"]]);
    final slots = mut [<[int]>];
    foreach (p in programs) {
        slots.append(textSlots(p));
    }
    final filled = helpers\fillSlots(programs, slots: slots, texts: helpers\substitutedHeredocs(line));
    final seen = mut [<str>];
    final recording = fun (text: str) > [Judged] {
        seen.append(text);
        return [<Judged>];
    };
    decidePullRequest(filled, line: line, files: {<str: str>}, diff: facts(unknownFacts()), judge: recording, once: helpers\counter());
    std\assert(seen.len() == 1 and seen[0] == "fix: pin the key\nClaude pinned the key.", message: "{seen}");

    final fromFile = helpers\request([["gh", "pr", "create", "--title", goodTitle, "--body-file", "pr.md"]]);
    std\assert(bodyFiles(fromFile)[0] == "pr.md", message: "the file to read");
    decidePullRequest(fromFile, line: "", files: {"pr.md": "Claude wanted this."}, diff: facts(unknownFacts()), judge: recording, once: helpers\counter());
    std\assert(seen.len() == 2 and seen[1] == goodTitle + "\nClaude wanted this.", message: "{seen}");
}

test "an unreadable description is judged from the whole line" {
    final programs = helpers\request([["gh", "pr", "create", "--title", goodTitle, "--body", ""]]);
    final line = "gh pr create --title \"{goodTitle}\" --body \"$BODY by Claude\"";
    std\assert(judged(programs, line: line, files: {<str: str>}).reason.indexOf("credits a tool") != null, message: "the line");
    final long = "gh pr create --body \"$BODY\" " + "x".repeat(3000);
    std\assert(judged(programs, line: long, files: {<str: str>}).reason.indexOf("the command runs") != null, message: "a long line");
}

test "other gh calls and a line that only mentions gh pr create stay silent" {
    foreach (argv in [
        ["rg", "gh pr create --title"],
        ["gh", "pr", "view", "412", "--json", "title,body"],
        ["gh", "pr", "create", "--fill"],
        ["gh", "pr", "edit", "412", "--add-label", "merge-queue: squash"],
        ["gh", "issue", "create", "--title", "a bug", "--body", "x"],
    ]) {
        final v = judged(helpers\request([argv]), line: argv.join(" "), files: {<str: str>});
        std\assert(v.decision == "allow", message: argv.join(" "));
    }
}

test "no message sends the reader to a skill" {
    final reason = judgedReason("Pin the key", body: "Claude pinned the key.");
    std\assert(reason != "" and reason.indexOf("Skill(") == null, message: reason);
}

// Fixture is a merged or closed pull request's title and description, the Facts its diff
// gives, and the verdict the rule must reach on it.
object Fixture {
    number: int,
    title: str,
    facts: Facts,
    verdict: str,
    body: str,
}

test "the ten pull requests the budget was calibrated on keep their verdicts" {
    foreach (fx in calibration()) {
        final v = verdictWith(fx.title, body: fx.body, f: fx.facts);
        std\assert(v.decision == fx.verdict, message: "#{fx.number}: want {fx.verdict}, got {v.decision}: {v.reason}");
        if (fx.verdict == "advise") {
            std\assert(v.reason.indexOf("prose past the lead") != null, message: "#{fx.number}: {v.reason}");
        }
    }
}

// calibration holds #422 through #431 as they were opened, with the Facts of each diff:
// fragments added, shipped source files and lines outside generated files, per parseNumstat.
fun calibration() > [Fixture] {
    return [
        Fixture{
            number = 431,
            title = "feat(cache): carry the caches spells declare; drop config cache --toolchain and --used-within",
            facts = Facts{ known = true, fragments = 2, shipped = 16, lines = 2742 },
            verdict = "allow",
            body = "On a magus miss, a fresh CI runner recompiled the whole tree because Go's own caches were empty. Carrying them took a flag per tool (`--toolchain go`, a proposed `--go-cache`), each naming a fact magus already holds.\n"
                + "\n"
                + "- A spell declares which of its sandbox grants are caches; the go spell declares GOCACHE and GOMODCACHE.\n"
                + "- `config cache export --remote` signs each spell's declared caches; only a holder of the signing key writes, every `import --remote` verifies, and a refusal leaves the build cold.\n"
                + "- Pruning entries the run never used is the default.\n"
                + "- `queue gate --cache <dir>` places those caches under that directory with exactly their declared grants; `validate` and `apply` keep them boxed.\n"
                + "- ci.yaml restores before the gate and saves after it, on main only.\n"
                + "- Removed: `--toolchain` and `--used-within`. Nothing added.",
        },
        Fixture{
            number = 430,
            title = "feat(guard): bind job exec callers in the guard; drop job exec --session and --vacate",
            facts = Facts{ known = true, fragments = 1, shipped = 23, lines = 2251 },
            verdict = "allow",
            body = "`magus job exec` without `--session` bound the whole checkout, even for a read-only job, and the guard then applied that lease's denies to the orchestrator that forked it. A host that gives a subagent its parent's session id made the documented `--session` advice bind the parent too.\n"
                + "\n"
                + "- The guard now records the binding when it lets `magus job exec` or `magus_job op=exec` through, keyed exactly on the caller's host, session and subagent ids, with no fallback between keys.\n"
                + "- `job exec` records only the base and checkout root. Rebinding after an ended job is part of exec.\n"
                + "- Removed: `--session`, `--vacate`, the session marker files, and the session-to-checkout fallback.\n"
                + "- Callers that report no identity keep a per-checkout record.\n"
                + "- `TestASubagentsExecNeverBindsItsParent` reproduces the incident.",
        },
        Fixture{
            number = 429,
            title = "docs(decisions): ADR 0003, running an invocation on another operating system",
            facts = Facts{ known = true, fragments = 0, shipped = 0, lines = 201 },
            verdict = "allow",
            body = "Records whether magus should run an invocation on a kernel other than the host's, so a Mac can reproduce Linux-only failures (landlock, /proc, socket path limits) before CI.\n"
                + "\n"
                + "- Decided, proposed status: a prefix script in this repository only, `tools/on-linux magus ...`, with a stated contract (read-only mount, explicit environment, no implicit pulls or VM starts, honest exit codes, kernel scope only).\n"
                + "- An execution-platform flag is recorded as considered and not planned; any proposal needs its own ADR and the listed preconditions.\n"
                + "- A `:linux` charm and a documented raw command are rejected.\n"
                + "\n"
                + "Six reviewer archetypes read the first draft; their findings and two corrected claims are in the Review section.",
        },
        Fixture{
            number = 428,
            title = "fix(vcs): settle hook stages only what the regeneration wrote",
            facts = Facts{ known = true, fragments = 0, shipped = 1, lines = 40 },
            verdict = "advise",
            body = "A merge that deleted a generated file stopped every merge commit after it. The settle hook listed paths from `git status --porcelain`, including one already staged as deleted and gone from disk, and `git add -- <path>` refused it: \"pathspec did not match any files\". Merging main after #422 retired `docs/reference/rules/cd.md` hit this on every open branch.\n"
                + "\n"
                + "`HookDirtyFiles` now lists only paths whose working tree differs from the operation's index, which is what a regeneration wrote and what staging has left to add. A generator that deletes an output still shows as ` D` and is still staged.\n"
                + "\n"
                + "A test pins a merge that deletes a file: the hook stages the regenerated file and leaves the deletion as the merge staged it.",
        },
        Fixture{
            number = 427,
            title = "revert: gate ci shards in the merge queue's candidate box (#412)",
            facts = Facts{ known = true, fragments = 0, shipped = 7, lines = 661 },
            verdict = "advise",
            body = "#412 landed with shard 0 and the docs shard red, and every main run since has failed them.\n"
                + "\n"
                + "Inside the box:\n"
                + "- Unix socket paths under the box's temp dir exceed the 108-byte `sun_path` limit.\n"
                + "- `/proc` reads are denied.\n"
                + "- Project locks collide.\n"
                + "- `site-generate` is denied its temp dir.\n"
                + "\n"
                + "This reverts the whole change, including `magus queue gate`, whose parity tests pin the workflow wiring. It re-lands once those causes are fixed and its shards are green.",
        },
        Fixture{
            number = 426,
            title = "feat(vcs): refuse shared-state writes from an older magus; write no keys from init",
            facts = Facts{ known = true, fragments = 1, shipped = 17, lines = 1372 },
            verdict = "allow",
            body = "An older magus overwrote hook sections a newer one had installed, and `init` dumped a full default config whose removed key then broke the newer binary.\n"
                + "\n"
                + "- Shared state is stamped with its writer: managed sections (`.gitattributes`, git hooks, hg/sl config), the merge-driver registration, and user and repo config. An older build refuses to overwrite a newer stamp. The error names both builds and how to update.\n"
                + "- Installed skills refuse a downgrade of their schema versions.\n"
                + "- `init` writes a header and stamp with no keys, and leaves an existing config alone.\n"
                + "- Guard `stale-write`: denies state-writing verbs (`init`, `server start`, `config set`, `agent install`, `agent harness`) from a stale `./magus`. For writes outside the checkout, it also denies a binary built off the base branch.\n"
