// The rules for one checkout's build tools run against another checkout of magus:
// foreign-binary and go-into-checkout; worker-builds-magus for a caller holding a worker lease;
// and worker-bootstrap, any caller but the main session running the bootstrap.
namespace agentpolicy\binaries;

import "std";
import "fs";
import "path";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/verdict" as verdict;
import "./hack/policy/builds" as builds;
import "./hack/policy/stale" as stale;

// Where is where a command runs: the directory the host reported, and the workspace root
// holding it. Either is "" when unknown. lease is the job the caller works under, "" for the
// main session or a person; integrator is true when that caller integrates this checkout.
// owned are the checkouts forks made for jobs the caller may work in, and writePaths the
// lease's write paths. leaseRoot is the checkout the lease's row stands in.
export object Where {
    dir: str,
    workspace: str,
    lease: str = "",
    integrator: bool = false,
    owned: [str] = [<str>],
    leaseRoot: str = "",
    writePaths: [str] = [<str>],
}

// Disk answers the questions the binary rules ask the filesystem and the Go toolchain,
// passed in so the tests below can describe a tree without building one.
export object Disk {
    // isCheckout: dir is the root of a checkout of magus.
    isCheckout: fun (dir: str) > bool,
    // hasBinary: dir holds a file named magus.
    hasBinary: fun (dir: str) > bool,
    // sameFile: a and b name one file, however each is spelled.
    sameFile: fun (a: str, b: str) > bool,
}

// The first line of go.mod in a checkout of magus, and in nothing else.
final moduleLine = "module github.com/egladman/magus";

export fun onDisk() > Disk {
    return Disk{
        isCheckout = fun (dir: str) > bool {
            final mod = fs\readFile("{dir}/go.mod") catch "";
            return mod.split("\n")[0].trim() == moduleLine;
        },
        hasBinary = fun (dir: str) > bool {
            return fs\exists("{dir}/magus") catch true;
        },
        sameFile = fun (a: str, b: str) > bool { return stale\sameFile(a, b: b); },
    };
}

// decideBinaries is the denial for a line that runs one checkout's build tools against
// another checkout of magus, "" when nothing on the line does. Every fact it needs must be
// known before the line runs: a path held in a variable, or a relative one with no
// directory to resolve it against, is unknown and passes. A leased worker's build of magus is
// refused first. That includes the bootstrap goIntoCheckout lets the
// main session and a person run into a checkout with no binary. A worker
// is placed one, even in a checkout its job owns: no row pins its build.
// Both refusals carry the same verdict and command. worker is true for a caller other than
// the main session, leased or not.
export fun decideBinaries(programs: [helpers\Program], where: Where, disk: Disk, worker: bool) > str {
    foreach (p in programs) {
        final building = builds\workerBuildDenial(p, lease: where.lease, integrator: where.integrator);
        if (building != "") { return building; }
        final bootstrapping = p.name == "go" and bootstrap(helpers\goCall(p.args).args);
        if (worker and bootstrapping) {
            return builds\workerPlacement("", lease: "");
        }
        final denial = foreignBinary(p, where: where, disk: disk);
        if (denial != "") { return denial; }
        final goDenial = goIntoCheckout(p, where: where, disk: disk);
        if (goDenial != "") { return goDenial; }
    }
    return "";
}

// foreignBinary: `<checkout A>/magus` run against checkout B, both checkouts of magus. The
// binary carries A's guard rules, host declarations and spell bytecode, so its verdicts
// describe A and what it regenerates lands in B unmarked. A magus run against a workspace
// that is not a checkout of magus (a benchmark tree, a fixture) is magus used as a tool,
// and passes. So does the binary in a checkout the caller's job owns: the fork placed it
// there from the forking checkout, and the holder runs it wherever its host's cwd stands.
fun foreignBinary(p: helpers\Program, where: Where, disk: Disk) > str {
    if (p.name != "magus" or p.path == "") { return ""; }
    final built = path\clean(fs\dirname(p.path));
    if (where.owned.indexOf(built) != null) { return ""; }
    final isCheckout = disk.isCheckout;
    if (!isCheckout(built)) { return ""; }
    var target = where.workspace;
    final root = helpers\flagValue(p.args, long: "--root", short: "");
    if (root != null) {
        target = absolute(root!, dir: where.dir);
    }
    if (target == "" or target == built or !isCheckout(target)) { return ""; }
    final sameFile = disk.sameFile;
    if (sameFile("{target}/magus", b: p.path)) { return ""; }
    final hasBinary = disk.hasBinary;
    if (places(p.args, built: built, dir: where.dir) and !hasBinary(target)) { return ""; }
    final aim = remedyRoot(target, where: where);
    var run = "another checkout of magus; run {target}'s own binary";
    if (aim != target) {
        final lease = where.lease;
        run = "a checkout lease {lease} does not hold; run the binary of the one it holds";
    }
    return ("a binary from another checkout runs here; use `{aim}/magus`\n"
        + "`{p.path}` was built in {built} and runs against {target}, {run}: `{aim}/magus --root {aim} ...`. "
        + "A binary carries the guard rules, host declarations and spell bytecode of the tree "
        + "it was built from, so its verdicts describe {built}, and what it regenerates lands in {target} "
        + "unmarked. " + ownBinaryHint(aim, disk: disk, lease: where.lease)).trim();
}

// heldCheckout is the checkout a leased worker runs magus in:
// the owned one holding where.dir, else the lease's own,
// else the only one owned. An integrator is not held to one checkout.
fun heldCheckout(where: Where) > str {
    if (where.lease == "" or where.integrator) { return ""; }
    foreach (root in where.owned) {
        if (where.dir == root or where.dir.startsWith(root + "/")) { return root; }
    }
    if (where.leaseRoot != "") { return where.leaseRoot; }
    if (where.owned.len() == 1) { return where.owned[0]; }
    return "";
}

// remedyRoot is the checkout a remedy aimed at target names.
// lease-checkout refuses a leased worker's call outside its
// checkout, so naming target there would be refused in turn.
fun remedyRoot(target: str, where: Where) > str {
    final held = heldCheckout(where);
    if (held == "" or where.owned.indexOf(target) != null) { return target; }
    return held;
}

// goIntoCheckout: `go -C <dir>` out of this workspace and into a checkout of magus, for a
// verb one of that checkout's targets covers. The pure raw-tool rule passes a -C that
// leaves the workspace, since a foreign tree is not its to funnel; a checkout of magus is.
// The bootstrap is internal/guard's to judge: it refuses one over a binary that loads the
// tree and allows one over a binary that cannot (MGS1021), which this rule cannot tell apart.
fun goIntoCheckout(p: helpers\Program, where: Where, disk: Disk) > str {
    if (p.name != "go") { return ""; }
    final call = helpers\goCall(p.args);
    if (call.chdir == "" or !escapes(call.chdir) or call.args.len() == 0) { return ""; }
    final verb = call.args[0];
    final covered = ["build", "test", "vet", "run", "generate"].indexOf(verb) != null
        or (verb == "mod" and call.args.len() > 1 and call.args[1] == "tidy");
    if (!covered) { return ""; }
    final root = absolute(call.chdir, dir: where.dir);
    final isCheckout = disk.isCheckout;
    if (root == "" or !isCheckout(root) or root == where.workspace) { return ""; }
    if (bootstrap(call.args)) { return ""; }
    final aim = remedyRoot(root, where: where);
    var there = "that checkout";
    if (aim != root) {
        final lease = where.lease;
        there = "the checkout lease {lease} holds";
    }
    return ("go -C into another checkout of magus runs outside its cache and its drift tracking\n"
        + "`go -C {root} {verb}` runs a toolchain command in another checkout of magus; run the target from {there}: "
        + "`{aim}/magus --root {aim} run <target> .`. " + ownBinaryHint(aim, disk: disk, lease: where.lease)).trim();
}

// placementScript copies an eligible ./magus into a fresh worktree and refuses any other.
final placementScript = stale\placementScript;

// places: the line runs placementScript with --from naming the checkout the binary was built
// in. The script proves the binary is the one the worktree would build, so this rule lets it
// through; a worker has no other way to get one.
fun places(args: [str], built: str, dir: str) > bool {
    if (args.len() < 2 or args[0] != "buzz" or path\clean(args[1]) != placementScript) { return false; }
    var source = helpers\flagValue(args, long: "--from", short: "");
    if (source == null) {
        source = helpers\flagValue(args, long: "--build-from", short: "");
    }
    return source != null and absolute(source!, dir: dir) == built;
}

// ownBinaryHint is how to get root a binary of its own, "" when it has one. A leased worker
// is told to ask for it: it is placed, never built.
fun ownBinaryHint(root: str, disk: Disk, lease: str) > str {
    final hasBinary = disk.hasBinary;
    if (hasBinary(root)) { return ""; }
    if (lease != "") {
        return "It has none yet: ask the main session to place one with {placementScript}, which builds it first "
            + "when none is built, with `--build-from <main checkout>`. A worker never builds magus.";
    }
    return "It has none yet: `{bootstrapIn(root)}` builds one with the real go-build target, "
        + "past a magus cache that cannot key it, while Go's build cache stays on.";
}

// bootstrapArgs is the bootstrap after `go`: a magus compiled on the fly runs the go-build
// target. -trimpath matches the target's own build so packages compile once, and
// --no-cache because that target's key cannot express the embedded-spell ordering.
final bootstrapArgs = ["run", "-trimpath", "./cmd/magus", "run", "go-build", "--no-cache", "."];

// bootstrapIn is the bootstrap run from outside root. GOEXPERIMENT=jsonv2 because magus
// refuses to compile without it, and a fresh checkout cannot count on mise to set it.
fun bootstrapIn(root: str) > str {
    return "GOEXPERIMENT=jsonv2 go -C {root} " + bootstrapArgs.join(" ");
}

// bootstrap: bootstrapArgs exactly, the package spelled `cmd/magus` with or without `./`
// or a trailing slash.
fun bootstrap(args: [str]) > bool {
    if (args.len() != bootstrapArgs.len()) { return false; }
    foreach (i, a in args) {
        if (i == 2) {
            if (path\clean(a) != "cmd/magus") { return false; }
        } else if (a != bootstrapArgs[i]) {
            return false;
        }
    }
    return true;
}

// escapes: a -C naming a directory outside the workspace, read textually as the raw-tool
// rule reads it.
fun escapes(dir: str) > bool {
    final clean = path\clean(dir);
    return path\isAbs(clean) or clean == ".." or clean.startsWith("../");
}

// absolute is p made absolute against dir and cleaned, "" when p is relative and dir is
// unknown, or p itself is unknown.
fun absolute(p: str, dir: str) > str {
    if (p == "") { return ""; }
    if (path\isAbs(p)) { return path\clean(p); }
    if (dir == "") { return ""; }
    return path\clean("{dir}/{p}");
}

// fakeDisk is a tree where checkouts are checkouts of magus, binaries hold a ./magus, and
// two paths are one file only when spelled alike.
fun fakeDisk(checkouts: [str], binaries: [str]) > Disk {
    return Disk{
        isCheckout = fun (dir: str) > bool { return checkouts.indexOf(dir) != null; },
        hasBinary = fun (dir: str) > bool { return binaries.indexOf(dir) != null; },
        sameFile = fun (a: str, b: str) > bool { return a == b; },
    };
}

// Two checkouts of magus side by side, each with its own binary, and a benchmark tree.
final twoCheckouts = fakeDisk(["/w/a", "/w/b"], binaries: ["/w/a", "/w/b"]);
final inB = Where{ dir = "/w/b", workspace = "/w/b" };

fun binaryDenial(argvs: [[str]], where: Where, disk: Disk) > str {
    final denial = decideBinaries(helpers\request(argvs), where: where, disk: disk, worker: false);
    if (denial != "") {
        verdict\assertVerdict(denial, label: argvs.map(fun (index: int, argv: [str]) > str => argv.join(" ")).join(" ; "));
    }
    return denial;
}

test "another checkout's binary run against this one is denied, naming this one's binary" {
    foreach (argv in [
        ["/w/a/magus", "describe", "projects"],
        ["/w/a/magus", "run", "go-build", "."],
        ["/w/a/magus", "--root", ".", "ls"],
        ["/w/a/magus", "--root", "/w/b", "ls"],
    ]) {
        final denial = binaryDenial([argv], where: inB, disk: twoCheckouts);
        std\assert(denial.indexOf("was built in /w/a") != null, message: argv.join(" "));
        std\assert(denial.indexOf("`/w/b/magus --root /w/b ...`") != null, message: "names the right binary");
    }
    final bare = binaryDenial([["/w/a/magus", "ls"]], where: inB, disk: fakeDisk(["/w/a", "/w/b"], binaries: ["/w/a"]));
    std\assert(bare.indexOf("GOEXPERIMENT=jsonv2 go -C /w/b run -trimpath ./cmd/magus run go-build --no-cache .") != null, message: "names the bootstrap when there is no binary");
}

test "a binary run against its own checkout, on PATH, unknown, or on a non-magus tree stays silent" {
    foreach (argv in [
        ["/w/a/magus", "--root", "/w/a", "run", "go-build", "."],
        ["/w/a/magus", "--root", "../a", "ls"],
        ["/w/b/magus", "run", "lint", "."],
        ["magus", "ls"],
        ["/w/a/magus", "--root", "", "ls"],
    ]) {
        std\assert(binaryDenial([argv], where: inB, disk: twoCheckouts) == "", message: argv.join(" "));
    }
    final bench = Where{ dir = "/w/b/benchmarks/repo", workspace = "/w/b/benchmarks/repo" };
    std\assert(binaryDenial([["/w/b/magus", "affected", "ci", "--plan"]], where: bench, disk: twoCheckouts) == "", message: "magus as a tool on another workspace");
    std\assert(binaryDenial([["/opt/bin/magus", "ls"]], where: inB, disk: twoCheckouts) == "", message: "a binary outside any checkout");
    std\assert(binaryDenial([["/w/a/magus", "--root", "b", "ls"]], where: Where{ dir = "", workspace = "/w/b" }, disk: twoCheckouts) == "", message: "a relative root with no directory is unknown");
    final aliased = Disk{
        isCheckout = twoCheckouts.isCheckout,
        hasBinary = twoCheckouts.hasBinary,
        sameFile = fun (a: str, b: str) > bool { return true; },
    };
    std\assert(binaryDenial([["/w/a/magus", "--root", "/w/b", "ls"]], where: inB, disk: aliased) == "", message: "two spellings of one file");
}

test "the binary in a checkout the caller's job owns runs from any cwd" {
    final holder = Where{ dir = "/w/b", workspace = "/w/b", lease = "scout", owned = ["/w/a"] };
    std\assert(binaryDenial([["/w/a/magus", "job", "exec", "scout"]], where: holder, disk: twoCheckouts) == "", message: "the owned checkout's binary");
    std\assert(binaryDenial([["/w/a/magus", "ls"]], where: Where{ dir = "/w/b", workspace = "/w/b", lease = "scout", owned = ["/w/c"] }, disk: twoCheckouts) != "",
        message: "a checkout another job owns");
}

test "a leased worker is sent to the checkout it holds, which lease-checkout lets it run in" {
    final three = fakeDisk(["/w/a", "/w/b", "/w/c"], binaries: ["/w/a", "/w/b", "/w/c"]);
    final worker = Where{ dir = "/w/b", workspace = "/w/b", lease = "scout", owned = ["/w/c"] };
    final foreign = binaryDenial([["/w/a/magus", "ls"]], where: worker, disk: three);
    std\assert(foreign.indexOf("`/w/c/magus --root /w/c ...`") != null, message: "names the held checkout: " + foreign);
    std\assert(foreign.indexOf("/w/b/magus") == null, message: "never a checkout the lease does not hold: " + foreign);
    final goC = binaryDenial([["go", "-C", "/w/a", "test", "./..."]], where: worker, disk: three);
    std\assert(goC.indexOf("`/w/c/magus --root /w/c run <target> .`") != null, message: "names the held checkout: " + goC);
    std\assert(goC.indexOf("/w/a/magus") == null, message: "never a checkout the lease does not hold: " + goC);
    final forked = Where{ dir = "/w/c/docs", workspace = "/w/c", lease = "scout", owned = ["/w/d", "/w/c"] };
    std\assert(binaryDenial([["/w/a/magus", "--root", "/w/b", "ls"]], where: forked, disk: three).indexOf("`/w/c/magus --root /w/c ...`") != null,
        message: "of several owned checkouts, the one the call runs in");
    final adopted = Where{ dir = "/w/b", workspace = "/w/b", lease = "scout", owned = ["/w/d", "/w/e"], leaseRoot = "/w/c" };
    std\assert(binaryDenial([["/w/a/magus", "ls"]], where: adopted, disk: three).indexOf("`/w/c/magus --root /w/c ...`") != null,
        message: "the lease's own checkout, when the call runs in none it owns");
    final integrator = Where{ dir = "/w/b", workspace = "/w/b", lease = "scout", integrator = true, owned = ["/w/c"] };
    std\assert(binaryDenial([["/w/a/magus", "ls"]], where: integrator, disk: three).indexOf("`/w/b/magus --root /w/b ...`") != null,
        message: "an integrator is not held to one checkout");
}

test "go -C into another checkout of magus is denied for a verb its targets cover" {
    foreach (argv in [
        ["go", "-C", "/w/a", "test", "./..."],
        ["go", "test", "-C", "../a", "./..."],
        ["go", "-C=/w/a", "vet", "./..."],
        ["go", "-C", "/w/a", "mod", "tidy"],
    ]) {
        final denial = binaryDenial([argv], where: inB, disk: twoCheckouts);
        std\assert(denial.indexOf("/w/a/magus --root /w/a run <target> .") != null, message: argv.join(" "));
    }
}

test "go -C into a foreign tree, inside the workspace, or for an uncovered verb stays silent" {
    final disk = fakeDisk(["/w/a", "/w/b"], binaries: ["/w/a", "/w/b"]);
    foreach (argv in [
        ["go", "-C", "/elsewhere", "test", "./..."],
        ["go", "-C", "sub", "test", "./..."],
        ["go", "-C", "/w/a", "version"],
        ["go", "-C", "/w/a", "env", "GOPATH"],
        ["go", "-C", "/w/b", "test", "./..."],
        ["go", "test", "./..."],
    ]) {
        std\assert(binaryDenial([argv], where: inB, disk: disk) == "", message: argv.join(" "));
    }
}

test "the bootstrap into another checkout is left to internal/guard, binary or not" {
    final fresh = fakeDisk(["/w/a", "/w/b"], binaries: ["/w/b"]);
    foreach (argv in [
        ["go", "-C", "/w/a", "run", "-trimpath", "./cmd/magus", "run", "go-build", "--no-cache", "."],
        ["go", "run", "-C", "/w/a", "-trimpath", "cmd/magus/", "run", "go-build", "--no-cache", "."],
    ]) {
        std\assert(binaryDenial([argv], where: inB, disk: fresh) == "", message: argv.join(" "));
    }
    final built = binaryDenial([["go", "-C", "/w/a", "run", "-trimpath", "./cmd/magus", "run", "go-build", "--no-cache", "."]], where: inB, disk: twoCheckouts);
    std\assert(built == "", message: "a binary already there: internal/guard tells a stale one from a live one");
    foreach (argv in [
        ["go", "-C", "/w/a", "build", "-o", "magus", "./cmd/magus"],
        ["go", "-C", "/w/a", "run", "-trimpath", "./cmd/magus", "run", "go-build", "."],
        ["go", "-C", "/w/a", "run", "./cmd/magus", "run", "go-build", "--no-cache", "."],
    ]) {
        final denial = binaryDenial([argv], where: inB, disk: fresh);
        std\assert(denial.indexOf("run <target>") != null, message: "not the bootstrap: " + argv.join(" "));
        std\assert(denial.indexOf("GOEXPERIMENT=jsonv2 go -C /w/a run -trimpath ./cmd/magus run go-build --no-cache .") != null, message: "serves the bootstrap");
    }
}

test "a leased worker is placed a binary and never builds one, bootstrap included" {
    final fresh = fakeDisk(["/w/a", "/w/b"], binaries: ["/w/b"]);
    final worker = Where{ dir = "/w/b", workspace = "/w/b", lease = "ui-logs" };
    foreach (argv in [
        ["go", "-C", "/w/a", "run", "-trimpath", "./cmd/magus", "run", "go-build", "--no-cache", "."],
        ["go", "run", "-trimpath", "./cmd/magus", "run", "go-build", "--no-cache", "."],
        ["go", "build", "./cmd/magus"],
        ["/w/b/magus", "run", "go-build", "."],
    ]) {
        final denial = decideBinaries(helpers\request([argv]), where: worker, disk: fresh, worker: true);
        verdict\assertVerdict(denial, label: argv.join(" "));
        std\assert(denial.indexOf("a worker does not build magus; ask the main session to place ./magus") == 0, message: argv.join(" "));
        std\assert(denial.split("\n")[1].indexOf("buzz hack/dev/bootstrap-worktree.buzz -- --job <id> --from <main checkout>`") != null, message: "names the placement: " + argv.join(" "));
        std\assert(denial.indexOf("one binary per base commit") != null, message: "says who places it: " + argv.join(" "));
        std\assert(denial.indexOf("not a bootstrap") == null, message: "not the deadlock advice");
        std\assert(binaryDenial([argv], where: Where{ dir = "/w/b", workspace = "/w/b" }, disk: fresh).indexOf("one binary per base commit") == null,
            message: "the main session and a person are not told so: " + argv.join(" "));
    }
    final noBinary = decideBinaries(helpers\request([["/w/a/magus", "ls"]]), where: worker, disk: fakeDisk(["/w/a", "/w/b"], binaries: ["/w/a"]), worker: true);
    verdict\assertVerdict(noBinary, label: "no binary to run");
    std\assert(noBinary.indexOf("ask the main session to place one") != null, message: "the hint asks for placement");
    std\assert(noBinary.indexOf("go -C /w/b run") == null, message: "and never serves the bootstrap");
    std\assert(decideBinaries(helpers\request([["/w/b/magus", "run", "lint", "."]]), where: worker, disk: fresh, worker: true) == "", message: "other targets pass");
}

test "a worker places another checkout's binary through the bootstrap script only" {
    final fresh = fakeDisk(["/w/a", "/w/b"], binaries: ["/w/a"]);
    final place = ["/w/a/magus", "buzz", "hack/dev/bootstrap-worktree.buzz", "--", "--job", "j", "--from", "/w/a"];
    std\assert(binaryDenial([place], where: inB, disk: fresh) == "", message: "placement into a fresh worktree");
    std\assert(binaryDenial([place], where: inB, disk: twoCheckouts) != "", message: "a worktree with a binary runs its own");
    final elsewhere = ["/w/a/magus", "buzz", "hack/dev/bootstrap-worktree.buzz", "--", "--job", "j", "--from", "/w/c"];
    std\assert(binaryDenial([elsewhere], where: inB, disk: fresh) != "", message: "--from names the binary's checkout");
    std\assert(binaryDenial([["/w/a/magus", "buzz", "other.buzz", "--from", "/w/a"]], where: inB, disk: fresh) != "", message: "only the placement script");
    final build = ["/w/a/magus", "buzz", "hack/dev/bootstrap-worktree.buzz", "--", "--job", "j", "--build-from", "/w/a"];
    std\assert(binaryDenial([build], where: inB, disk: fresh) == "", message: "--build-from names the binary's checkout too");
    final noneBuilt = decideBinaries(helpers\request([["/w/a/magus", "ls"]]), where: Where{ dir = "/w/b", workspace = "/w/b", lease = "j" }, disk: fresh, worker: true);
    std\assert(noneBuilt.indexOf("--build-from <main checkout>") != null, message: "a worker with no binary is told the reachable build: " + noneBuilt);
}

test "only the main session bootstraps" {
    final fresh = fakeDisk(["/w/a", "/w/b"], binaries: []);
    final line = [["go", "run", "-trimpath", "./cmd/magus", "run", "go-build", "--no-cache", "."]];
    final denial = decideBinaries(helpers\request(line), where: inB, disk: fresh, worker: true);
    verdict\assertVerdict(denial, label: "the bootstrap");
    std\assert(denial.indexOf("a worker does not build magus") == 0, message: denial);
    std\assert(denial.indexOf("--from") != null, message: "names the placement");
    std\assert(decideBinaries(helpers\request(line), where: inB, disk: fresh, worker: false) == "", message: "the main session builds");
}

test "a worker builds nothing, in a checkout its job owns too" {
    final disk = fakeDisk(["/w/a", "/w/b"], binaries: ["/w/a", "/w/b"]);
    final owner = Where{ dir = "/w/b", workspace = "/w/b", lease = "iso", owned = ["/w/b"] };
    foreach (argv in [
        ["/w/b/magus", "run", "go-build", "."],
        ["/w/b/magus", "--root", "/w/b", "run", "go::go-build"],
        ["go", "run", "-trimpath", "./cmd/magus", "run", "go-build", "--no-cache", "."],
        ["go", "build", "-o", "magus", "./cmd/magus"],
        ["/w/b/magus", "run", "build", "."],
    ]) {
        final denial = decideBinaries(helpers\request([argv]), where: owner, disk: disk, worker: true);
        verdict\assertVerdict(denial, label: argv.join(" "));
        std\assert(denial.indexOf("a worker does not build magus") == 0, message: argv.join(" ") + ": " + denial);
    }
    final foreign = decideBinaries(helpers\request([["/w/a/magus", "ls"]]), where: owner, disk: disk, worker: true);
    std\assert(foreign.indexOf("a binary from another checkout runs here") == 0, message: "foreign-binary still holds: " + foreign);
}
