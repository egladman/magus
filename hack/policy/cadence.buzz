// The rules for when a line may gate or push: worker-runs-gate and detached-push-unqualified.
namespace agentpolicy\cadence;

import "std";
import "magus";
import "fs";
import "path";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/verdict" as verdict;

final gateDenial = "a worker mid-change does not run the gate; finish with the narrow validation your brief names and report.\n"
    + "The gate runs once per branch, by the orchestrator or by a worker spawned as "
    + "`<parent>/integrate <job>` in the checkout its row was taken in, once your branch is integrated. "
    + "`magus affected ci --plan` stays open to you: it runs nothing. "
    + "Report with `magus job exit <job> --stdin`; the orchestrator runs the gate. "
    + "If you were spawned as the integrator and are refused, `magus describe job <job>` names the checkout "
    + "your row was taken in; the gate runs only from there. "
    + "A worker whose row was taken with `job fork --checkout` gates in that checkout, whatever its title.";

// Caller is who runs a command: role is root, worker (a lease binds it) or integrator, and title is
// the description it was itself spawned with, empty for a person or the orchestrator. holdsCheckout
// is true for the holder of a live `job fork --checkout` row whose gate calls all run in that
// row's own checkout (gatesInHeldCheckout). dir is the host's directory and workspace the root
// holding it, "" when the host names none.
export object Caller {
    role: magus\AgentRole,
    title: str,
    holdsCheckout: bool = false,
    dir: str = "",
    workspace: str = "",
}

final ciUnderDenial = "this ci run skips projects the change reaches; run `magus affected ci` instead.\n"
    + "`magus run ci .`, and `magus run ci` with no project from the workspace root, run the root project alone, though `.` reads as everything; "
    + "a project after `magus affected ci` narrows the gate below what the diff reaches. "
    + "`magus affected ci` runs ci on every project the diff reaches, the set pull request CI runs, "
    + "and `magus run ci <project>` stays open for a project you name.";

final ciOverAdvice = "this ci run spends time on projects the change cannot reach: "
    + "`magus run ci /` runs every project, and `/` after `magus affected ci` adds nothing to the set the diff reaches. "
    + "`magus affected ci` runs ci on every project the diff reaches, the set pull request CI runs.";

// Checkout is the git state a push leaves from, handed over only for a line that pushes.
export object Checkout {
    detached: bool,
    remoteBranches: [str],
}

// decideCadence denies the gate run by a caller that may not gate, then a detached push git
// would refuse. checkout is null for a line that does not push.
export fun decideCadence(programs: [helpers\Program], caller: Caller, checkout: Checkout?) > GuardVerdict {
    if (runsGate(programs) and !mayGate(caller)) {
        return magus\guard.deny(gateDenial);
    }
    final scope = ciScope(programs, dir: caller.dir, workspace: caller.workspace);
    if (scope == "under") {
        return magus\guard.deny(ciUnderDenial);
    }
    if (checkout != null) {
        final denial = unqualifiedPush(programs, checkout: checkout!);
        if (denial != "") {
            return magus\guard.deny(denial);
        }
    }
    if (scope == "over") {
        return magus\guard.advise(ciOverAdvice);
    }
    return magus\guard.defer();
}

// mayGate: a person or the orchestrator (no lease, no spawn title), or the checkout's
// integrator, which the guard computes from the spawn title, the lease and the checkout its
// row was taken in, or the holder of a `job fork --checkout` row in that checkout. The holder
// is a separate predicate: the integrator role also lets a caller build and bootstrap.
fun mayGate(caller: Caller) > bool {
    if (caller.role != magus\AgentRole.worker and caller.title == "") {
        return true;
    }
    return caller.role == magus\AgentRole.integrator or caller.holdsCheckout;
}

// liveCheckoutRoot: the checkout of a live row (declared, running or exited) taken with
// `job fork --checkout`, "" for any other.
fun liveCheckoutRoot(lease: magus\Job?) > str {
    if (lease == null or lease!.worktree == null) {
        return "";
    }
    final live = lease!.state == magus\JobState.declared or lease!.state == magus\JobState.running or lease!.state == magus\JobState.exited;
    if (!live) {
        return "";
    }
    return lease!.checkoutRoot;
}

// holdsCheckout: a live row taken with `job fork --checkout` in the workspace given.
export fun holdsCheckout(lease: magus\Job?, workspace: str) > bool {
    final root = liveCheckoutRoot(lease);
    return root != "" and workspace != "" and root == workspace;
}

// gatesInHeldCheckout: the row holds a checkout and every gate call on the line runs inside
// it, judged where the call runs (a cd earlier on the line, then its -C or --root) and not
// where the host started. dir is the host's directory, workspace the root holding it.
// A line with no gate call is judged by workspace alone.
export fun gatesInHeldCheckout(lease: magus\Job?, programs: [helpers\Program], dir: str, workspace: str) > bool {
    final root = liveCheckoutRoot(lease);
    if (root == "") {
        return false;
    }
    var cwd = dir;
    if (cwd == "") {
        cwd = workspace;
    }
    var gates = 0;
    foreach (p in programs) {
        if (p.name == "cd" or p.name == "pushd") {
            final ops = helpers\stripFlags(p.args, valueFlags: [<str>]);
            if (ops.len() == 1) {
                cwd = moved(cwd, to: ops[0]);
            } else {
                cwd = "";
            }
        } else if (p.name == "popd") {
            cwd = "";
        } else if (runsGate([p])) {
            gates = gates + 1;
            if (!within(root, dir: relocated(cwd, args: p.args))) {
                return false;
            }
        }
    }
    if (gates == 0) {
        return holdsCheckout(lease, workspace: workspace);
    }
    return true;
}

// moved is to taken from cwd, "" when either is unknown.
fun moved(cwd: str, to: str) > str {
    if (to == "" or to.startsWith("~") or to.startsWith("$")) {
        return "";
    }
    if (path\isAbs(to)) {
        return path\clean(to);
    }
    if (cwd == "") {
        return "";
    }
    return path\clean("{cwd}/{to}");
}

// relocated is cwd moved by each -C or --root among a magus call's args, in order.
fun relocated(cwd: str, args: [str]) > str {
    var at = cwd;
    var next = false;
    foreach (a in args) {
        if (next) {
            at = moved(at, to: a);
            next = false;
        } else if (a == "-C" or a == "--root") {
            next = true;
        } else if (a.startsWith("--root=")) {
            at = moved(at, to: a.sub(7));
        }
    }
    return at;
}

fun within(root: str, dir: str) > bool {
    return dir != "" and (dir == root or dir.startsWith(root + "/"));
}

// runsGate: `magus affected ci`, or `magus run ci`, with or without a charm, and not the --plan form, which runs nothing.
fun runsGate(programs: [helpers\Program]) > bool {
    foreach (p in programs) {
        if (p.name == "magus") {
            final ops = helpers\magusOperands(withoutDirFlag(p.args));
            if (ops.len() > 1 and (ops[0] == "affected" or ops[0] == "run")
                and (ops[1] == "ci" or ops[1].startsWith("ci:"))
                and !helpers\hasFlag(p.args, long: "--plan")) {
                return true;
            }
        }
    }
    return false;
}

// ciScope says how a line's ci runs miss the set the diff reaches: "under" when one skips
// projects the diff reaches, "over" when one only adds projects it cannot reach, "" when none
// does. Under is `magus run ci` with `.` among its projects and no `/`, or with none from the
// workspace root, where the root is the cwd project; and `magus affected ci` with any project
// but `/`, `--plan` included, since a project there narrows the set. Over is `magus run ci`
// with `/` among its projects, and `magus affected ci /`. A charm counts as ci. A ci run with
// no project whose directory is unknown is under, since nothing says it is not the root. Each
// call is placed where it runs: a cd earlier on the line, then its -C or --root.
fun ciScope(programs: [helpers\Program], dir: str, workspace: str) > str {
    var cwd = dir;
    if (cwd == "") {
        cwd = workspace;
    }
    var scope = "";
    foreach (p in programs) {
        if (p.name == "cd" or p.name == "pushd") {
            final ops = helpers\stripFlags(p.args, valueFlags: [<str>]);
            if (ops.len() == 1) {
                cwd = moved(cwd, to: ops[0]);
            } else {
                cwd = "";
            }
        } else if (p.name == "popd") {
            cwd = "";
        } else if (p.name == "magus") {
            final ops = helpers\magusOperands(withoutDirFlag(beforeDashDash(p.args)));
            if (ops.len() > 1 and (ops[1] == "ci" or ops[1].startsWith("ci:"))) {
                final projects = ops.sub(2);
                final all = projects.indexOf("/") != null;
                if (ops[0] == "affected") {
                    foreach (project in projects) {
                        if (project != "/") {
                            return "under";
                        }
                    }
                    if (all) {
                        scope = "over";
                    }
                } else if (ops[0] == "run") {
                    if (all) {
                        scope = "over";
                    } else if (projects.indexOf(".") != null) {
                        return "under";
                    } else if (projects.len() == 0) {
                        final at = relocated(cwd, args: p.args);
                        if (at == "" or workspace == "" or at == workspace) {
                            return "under";
                        }
                    }
                }
            }
        }
    }
    return scope;
}

// beforeDashDash is args up to a `--`, whose rest the target receives, never magus.
fun beforeDashDash(args: [str]) > [str] {
    final kept = mut [<str>];
    foreach (a in args) {
        if (a == "--") {
            return kept;
        }
        kept.append(a);
    }
    return kept;
}

// withoutDirFlag is args with each -C and its value left out, which magusOperands does not know.
fun withoutDirFlag(args: [str]) > [str] {
    final kept = mut [<str>];
    var skip = false;
    foreach (a in args) {
        if (skip) {
            skip = false;
        } else if (a == "-C") {
            skip = true;
        } else {
            kept.append(a);
        }
    }
    return kept;
}

// The git push flags that take the next word as their value.
final pushValueFlags = ["-C", "-o", "--push-option", "--repo", "--receive-pack", "--exec"];

// unqualifiedPush names what is wrong with a `git push <remote> HEAD:<name>` from a detached
// HEAD whose <name> the checkout has no remote-tracking branch for, "" when nothing is. Git
// refuses that push: with no branch behind HEAD it cannot tell a branch from a tag.
fun unqualifiedPush(programs: [helpers\Program], checkout: Checkout) > str {
    if (!checkout.detached) {
        return "";
    }
    foreach (p in programs) {
        if (p.name == "git") {
            final ops = helpers\stripFlags(p.args, valueFlags: pushValueFlags);
            if (ops.len() > 2 and ops[0] == "push") {
                final remote = ops[1];
                foreach (spec in ops.sub(2)) {
                    var ref = spec;
                    if (ref.startsWith("+")) { ref = ref.sub(1); }
                    if (ref.startsWith("HEAD:")) {
                        final name = ref.sub(5);
                        if (!name.startsWith("refs/") and checkout.remoteBranches.indexOf("{remote}/{name}") == null) {
                            return "a detached HEAD cannot tell {remote}/{name} from a tag; name the branch in full: "
                                + "`git push {remote} HEAD:refs/heads/{name}`\n"
                                + "{remote} has no branch {name} this checkout knows of. Without the full ref git cannot tell a branch from a tag and refuses the push; a `;` or a "
                                + "background run hides that.";
                        }
                    }
                }
            }
        }
    }
    return "";
}

// judged is decideCadence with every denial held to the verdict shape.
fun judged(programs: [helpers\Program], caller: Caller, checkout: Checkout?) > GuardVerdict {
    final label = programs.map(fun (index: int, p: helpers\Program) > str => p.name + " " + p.args.join(" ")).join(" ; ");
    return verdict\checked(decideCadence(programs, caller: caller, checkout: checkout), label: label);
}

// person is an unattributed caller: no lease binds it and no spawn titled it.
fun person() > Caller {
    return Caller{ role = magus\AgentRole.root, title = "" };
}

// personAt is a person whose host runs in dir, inside the workspace at /w.
fun personAt(dir: str) > Caller {
    return Caller{ role = magus\AgentRole.root, title = "", dir = dir, workspace = "/w" };
}

// offTheDiff is the decision on argvs run by a person in dir.
fun offTheDiff(argvs: [[str]], dir: str) > magus\GuardDecision {
    return judged(helpers\request(argvs), caller: personAt(dir), checkout: null).decision;
}

test "magus run ci . is denied, naming magus affected ci" {
    foreach (argv in [
        ["magus", "run", "ci", "."],
        ["magus", "run", "ci:rw", "."],
        ["magus", "run", "ci", "web", "."],
        ["magus", "-j", "4", "run", "ci", "."],
    ]) {
        final v = judged(helpers\request([argv]), caller: personAt("/w/web"), checkout: null);
        std\assert(v.decision == magus\GuardDecision.deny, message: argv.join(" "));
        std\assert(v.reason.indexOf("run `magus affected ci` instead") != null, message: v.reason);
    }
}

test "a bare magus run ci is denied where it selects the root" {
    std\assert(offTheDiff([["magus", "run", "ci"]], dir: "/w") == magus\GuardDecision.deny, message: "from the workspace root");
    std\assert(offTheDiff([["magus", "run", "ci:rw"]], dir: "/w") == magus\GuardDecision.deny, message: "a charm, from the root");
    std\assert(offTheDiff([["cd", "/w"], ["magus", "run", "ci"]], dir: "/w/web") == magus\GuardDecision.deny, message: "a cd to the root");
    std\assert(offTheDiff([["magus", "-C", "/w", "run", "ci"]], dir: "/w/web") == magus\GuardDecision.deny, message: "a -C to the root");
    std\assert(judged(helpers\request([["magus", "run", "ci"]]), caller: person(), checkout: null).decision == magus\GuardDecision.deny,
        message: "nothing places the call");
    std\assert(offTheDiff([["magus", "run", "ci"]], dir: "/w/web") == magus\GuardDecision.defer, message: "from a project's directory");
    std\assert(offTheDiff([["magus", "-C", "/w/web", "run", "ci"]], dir: "/w") == magus\GuardDecision.defer, message: "a -C into a project");
}

test "magus affected ci . is denied, the plan form included" {
    foreach (argv in [
        ["magus", "affected", "ci", "."],
        ["magus", "affected", "ci:rw", "."],
        ["magus", "affected", "ci", ".", "--plan"],
    ]) {
        final v = judged(helpers\request([argv]), caller: personAt("/w"), checkout: null);
        std\assert(v.decision == magus\GuardDecision.deny, message: argv.join(" "));
        std\assert(v.reason.indexOf("narrows the gate") != null, message: v.reason);
    }
}

test "magus affected ci with a named project is denied" {
    foreach (argv in [
        ["magus", "affected", "ci", "libs/codec"],
        ["magus", "affected", "ci", "web", "/"],
    ]) {
        std\assert(offTheDiff([argv], dir: "/w") == magus\GuardDecision.deny, message: argv.join(" "));
    }
}

test "magus run ci / is advised, naming magus affected ci" {
    foreach (argv in [
        ["magus", "run", "ci", "/"],
        ["magus", "run", "ci:rw", "/"],
        ["magus", "run", "ci", "web", "/"],
    ]) {
        final v = judged(helpers\request([argv]), caller: personAt("/w"), checkout: null);
        std\assert(v.decision == magus\GuardDecision.advise, message: argv.join(" "));
        std\assert(v.reason.indexOf("`magus affected ci` runs ci on every project the diff reaches") != null, message: v.reason);
    }
}

test "magus affected ci / is advised" {
    final v = judged(helpers\request([["magus", "affected", "ci", "/"]]), caller: personAt("/w"), checkout: null);
    std\assert(v.decision == magus\GuardDecision.advise, message: v.reason);
    std\assert(v.reason.indexOf("adds nothing") != null, message: v.reason);
}

test "named projects, the bare gate and every other target keep their projects" {
    foreach (argv in [
        ["magus", "run", "ci", "web"],
        ["magus", "run", "ci", "web", "libs/codec"],
        ["magus", "affected", "ci"],
        ["magus", "affected", "ci", "--plan"],
        ["magus", "affected", "ci", "--", "."],
        ["magus", "run", "test", "."],
        ["magus", "run", "lint", "/"],
        ["magus", "run", "test"],
        ["magus", "affected", "test", "."],
    ]) {
        std\assert(offTheDiff([argv], dir: "/w") == magus\GuardDecision.defer, message: argv.join(" "));
    }
}

test "a worker whose role is not integrate may not run the gate" {
    final gate = helpers\request([["magus", "affected", "ci", "--no-default-charms"]]);
    foreach (caller in [
        Caller{ role = magus\AgentRole.worker, title = "orchestrator/feat guard-command" },
        Caller{ role = magus\AgentRole.root, title = "v050-prep/fix naming-advisory" },
        Caller{ role = magus\AgentRole.worker, title = "" },
    ]) {
        final v = judged(gate, caller: caller, checkout: null);
        std\assert(v.decision == magus\GuardDecision.deny, message: "{caller.role} {caller.title}");
        std\assert(v.reason.indexOf("integrate") != null, message: "names who may gate");
        std\assert(v.reason.indexOf("`magus job exit <job> --stdin`") != null and v.reason.indexOf("`magus describe job <job>`") != null,
            message: "names commands the refused role can run");
    }
    final worker = Caller{ role = magus\AgentRole.worker, title = "orchestrator/review guard-command" };
    foreach (argv in [
        ["magus", "run", "ci", "."],
        ["magus", "affected", "ci:rw"],
        ["magus", "-j", "4", "affected", "ci"],
    ]) {
        std\assert(judged(helpers\request([argv]), caller: worker, checkout: null).decision == magus\GuardDecision.deny, message: argv.join(" "));
    }
}

test "the orchestrator, a person, an integrate worker and the plan form may gate" {
    final gate = helpers\request([["magus", "affected", "ci", "--no-default-charms"]]);
    std\assert(judged(gate, caller: person(), checkout: null).decision == magus\GuardDecision.defer, message: "an unattributed caller");
    final integrator = Caller{ role = magus\AgentRole.integrator, title = "orchestrator/integrate local-command-policy" };
    std\assert(judged(gate, caller: integrator, checkout: null).decision == magus\GuardDecision.defer, message: "the checkout's integrator");
    final elsewhere = Caller{ role = magus\AgentRole.worker, title = "orchestrator/integrate local-command-policy" };
    std\assert(judged(gate, caller: elsewhere, checkout: null).decision == magus\GuardDecision.deny, message: "an integrate title outside the checkout its row was taken in");
    final worker = Caller{ role = magus\AgentRole.worker, title = "orchestrator/feat guard-command" };
    final plan = helpers\request([["magus", "affected", "ci", "--plan", "--no-default-charms"]]);
    std\assert(judged(plan, caller: worker, checkout: null).decision == magus\GuardDecision.defer, message: "the plan runs nothing");
    final narrow = helpers\request([["magus", "run", "go-test", ".", "--", "-run", "Guard"]]);
    std\assert(judged(narrow, caller: worker, checkout: null).decision == magus\GuardDecision.defer, message: "narrow validation");
}

test "the holder of a checkout row may gate whatever its title" {
    final gate = helpers\request([["magus", "affected", "ci", "--no-default-charms"]]);
    final holder = Caller{ role = magus\AgentRole.worker, title = "orchestrator/feat guard-command", holdsCheckout = true };
    std\assert(judged(gate, caller: holder, checkout: null).decision == magus\GuardDecision.defer, message: "a --checkout holder");
}

test "a row is held in its checkout only when live, with a worktree, and run from its root" {
    final worktree = magus\JobWorktree{ root = "/w/a" };
    final row = magus\Job{ id = "a", state = magus\JobState.running, checkoutRoot = "/w/a", worktree = worktree };
    std\assert(holdsCheckout(row, workspace: "/w/a"), message: "the holder's own checkout");
    std\assert(!holdsCheckout(row, workspace: "/w/b"), message: "another checkout");
    std\assert(!holdsCheckout(magus\Job{ id = "a", state = magus\JobState.running, checkoutRoot = "/w/a" }, workspace: "/w/a"), message: "no worktree");
    std\assert(!holdsCheckout(magus\Job{ id = "a", state = magus\JobState.fail, checkoutRoot = "/w/a", worktree = worktree }, workspace: "/w/a"), message: "not live");
    std\assert(!holdsCheckout(null, workspace: "/w/a"), message: "no lease");
}

test "a holder's gate is judged where the call runs, not where the host started" {
    final worktree = magus\JobWorktree{ root = "/w/a" };
    final row = magus\Job{ id = "a", state = magus\JobState.running, checkoutRoot = "/w/a", worktree = worktree };
    final held = fun (argvs: [[str]], dir: str) > bool {
        return gatesInHeldCheckout(row, programs: helpers\request(argvs), dir: dir, workspace: dir);
    };
    std\assert(held([["magus", "affected", "ci"]], dir: "/w/a"), message: "from the checkout");
    std\assert(held([["magus", "affected", "ci"]], dir: "/w/a/docs"), message: "from a directory inside it");
    std\assert(!held([["magus", "affected", "ci"]], dir: "/w/b"), message: "from another checkout");
    std\assert(held([["cd", "/w/a"], ["magus", "affected", "ci"]], dir: "/w/b"), message: "a cd into it");
    std\assert(held([["cd", "../a"], ["magus", "affected", "ci"]], dir: "/w/b"), message: "a relative cd into it");
    std\assert(!held([["cd", "/w/b"], ["magus", "affected", "ci"]], dir: "/w/a"), message: "a cd out of it");
    std\assert(held([["magus", "-C", "/w/a", "affected", "ci"]], dir: "/w/b"), message: "a -C into it");
    std\assert(held([["magus", "--root=/w/a", "run", "ci", "."]], dir: "/w/b"), message: "a --root into it");
    std\assert(!held([["magus", "-C", "/w/b", "affected", "ci"]], dir: "/w/a"), message: "a -C out of it");
    std\assert(!held([["magus", "-C", "", "affected", "ci"]], dir: "/w/a"), message: "a -C naming nothing known");
    std\assert(!held([["cd", "/w/a"], ["magus", "affected", "ci"], ["cd", "/w/b"], ["magus", "affected", "ci"]], dir: "/w/a"), message: "every gate call counts");
    std\assert(held([["magus", "run", "go-test", "."]], dir: "/w/a"), message: "no gate call falls back to the workspace");
    std\assert(!gatesInHeldCheckout(null, programs: helpers\request([["magus", "affected", "ci"]]), dir: "/w/a", workspace: "/w/a"), message: "no lease");
}

test "a detached push to a branch the remote lacks is denied, naming the full ref" {
    final detached = Checkout{ detached = true, remoteBranches = ["origin/main", "origin/naming-advisory"] };
    final v = judged(helpers\request([["git", "push", "origin", "HEAD:local-command-policy"]]), caller: person(), checkout: detached);
    std\assert(v.decision == magus\GuardDecision.deny, message: "an unknown branch");
    std\assert(v.reason.indexOf("git push origin HEAD:refs/heads/local-command-policy") != null, message: "names the fix");
    final forced = judged(helpers\request([["git", "-C", "../wt", "push", "-u", "origin", "+HEAD:topic"]]), caller: person(), checkout: detached);
    std\assert(forced.decision == magus\GuardDecision.deny, message: "a forced push, a -C and a flag");
}

test "a push the remote can place stays silent" {
    final detached = Checkout{ detached = true, remoteBranches = ["origin/main", "origin/naming-advisory"] };
    foreach (argv in [
        ["git", "push", "-q", "origin", "HEAD:naming-advisory"],
        ["git", "push", "origin", "HEAD:refs/heads/x"],
        ["git", "push", "origin", "main"],
    ]) {
        std\assert(judged(helpers\request([argv]), caller: person(), checkout: detached).decision == magus\GuardDecision.defer, message: argv.join(" "));
    }
    final onBranch = Checkout{ detached = false, remoteBranches = [<str>] };
    std\assert(judged(helpers\request([["git", "push", "origin", "HEAD:new-branch"]]), caller: person(), checkout: onBranch).decision == magus\GuardDecision.defer, message: "HEAD names a branch");
}

test "no policy example runs the go spell's op in place of the go-test target" {
    // The target builds what its tests read first; the bare op skips that step.
    final op = "go::" + "go-test";
    foreach (file in fs\glob("hack/policy/*.buzz") catch [<Path>]) {
        final body = fs\readFile(file.value) catch "";
        std\assert(body.indexOf(op) == null, message: "{file.value} runs {op}; name the go-test target");
    }
}
