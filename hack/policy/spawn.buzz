// The spawn rules the root magusfile registers: spawn-without-job-row,
// change-role-spawn-not-isolated and brief-builds-magus.
namespace agentpolicy\spawn;

import "std";
import "magus";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/builds" as builds;
import "./hack/policy/verdict" as verdict;

final isolationDenial = "a worker that changes code would share this checkout; spawn it with "
    + "`isolation: \"worktree\"`.\n"
    + "A worker that changes code gets its own checkout, and detaches onto its branch "
    + "(`git switch --detach <branch>`) as its first act. Measured 09-22: 312 writes from 7 workers sharing a checkout landed in the "
    + "orchestrator's tree, and no isolated writer's did. Thinking roles (plan, review, research, "
    + "scout) may share it, and so does integrate, which lands the work in this checkout.";

// The roles a spawn title names for work that changes the tree: the conventional commit types.
final changeRoles = ["feat", "fix", "refactor", "perf", "docs", "test", "chore"];

// The roles that read and report, forked as read-only jobs.
final thinkingRoles = ["plan", "review", "research", "scout"];

// The role that integrates the checkout it shares: it builds magus, regenerates and commits.
final integrateRole = "integrate";

// Spawn is what the rules read of one spawn, copied out of the request because a Buzz test
// cannot build the host's SpawnRequest: constructing its Job fails on a nested default.
export object Spawn {
    kind: magus\SpawnKind,
    title: str,
    isolated: bool,
    model: str = "",
    // lease is the job the spawner acts under, "" for the orchestrator or a person.
    lease: str = "",
    // prompt is the brief handed to the spawned worker.
    prompt: str = "",
    // checkout is the checkout the spawn runs in, "" when unread.
    checkout: str = "",
    // ownBuild: the spawned job owns its checkout and its write paths cover a build input of
    // ./cmd/magus there, so its worker builds ./magus (see builds\OwnBuild).
    ownBuild: bool = false,
}

// Lineage is a `<parent>/<role> <job>` title taken apart, or null for any other form.
object Lineage {
    parent: str,
    role: str,
    job: str,
}

fun lineage(title: str) > Lineage? {
    final role = helpers\titleRole(title);
    if (role == "") {
        return null;
    }
    final words = title.split(" ");
    final head = words[0];
    return Lineage{ parent = head.sub(0, len: head.len() - role.len() - 1), role = role, job = words[1] };
}

// decideSpawn denies a spawn that names no live job row, then a code-changing worker that
// would share the spawning checkout, then a brief that tells its worker to build magus. rows is null when the store could not be read, which
// unreadable says why: the row rule then advises and never denies. A continue starts
// nothing, so it passes both.
export fun decideSpawn(spawn: Spawn, rows: [helpers\JobRow]?, unreadable: str) > GuardVerdict {
    if (spawn.kind != magus\SpawnKind.spawn) {
        return magus\guard.allow();
    }
    final row = decideJobRow(spawn, rows: rows, unreadable: unreadable);
    if (row.decision == magus\GuardDecision.deny) {
        return row;
    }
    if (!spawn.isolated and changeRoles.indexOf(helpers\titleRole(spawn.title)) != null) {
        return magus\guard.deny(isolationDenial);
    }
    if (helpers\titleRole(spawn.title) == integrateRole) {
        return row;
    }
    final building = builds\briefDenial(spawn.prompt, ownBuild: spawn.ownBuild);
    if (building != "") {
        return magus\guard.deny(building);
    }
    return row;
}

// decideJobRow is spawn-without-job-row: the title must name a live row the spawner may hand
// out, or the guard cannot bind the child to its lease. The job is the row `<job>`, else
// `<parent>/<job>`, the same resolution the guard binds with.
fun decideJobRow(spawn: Spawn, rows: [helpers\JobRow]?, unreadable: str) > GuardVerdict {
    if (rows == null) {
        return magus\guard.advise("The job store could not be read ({unreadable}), so whether this spawn "
            + "names a live job row went unchecked and it passes. Its child will not be bound to a lease. "
            + "Run `magus doctor` and `magus ls jobs` to see why the store fails to load.");
    }
    final line = lineage(spawn.title);
    if (line == null) {
        return magus\guard.deny("this spawn's description names no job; it must read `<parent>/<role> <job>`\n"
            + "The description is `{spawn.title}`, and <job> is a live row in this workspace's job store. "
            + remedy(spawn, line: null));
    }
    var found: helpers\JobRow? = null;
    foreach (id in [line!.job, "{line!.parent}/{line!.job}"]) {
        foreach (r in rows!) {
            if (found == null and r.id == id) {
                found = r;
            }
        }
    }
    if (found == null) {
        return magus\guard.deny("no row `{line!.job}` is in this workspace's job store; fork it before the spawn\n"
            + "Neither `{line!.job}` nor `{line!.parent}/{line!.job}` is a row, so the guard has no lease "
            + "to bind this spawn's child to. " + remedy(spawn, line: line));
    }
    if ([magus\JobState.declared, magus\JobState.running, magus\JobState.exited].indexOf(found!.state) == null) {
        return magus\guard.deny("the row `{found!.id}` has ended ({found!.state.value}); fork a live one\n"
            + "A child bound to an ended row is graded by nothing. " + remedy(spawn, line: line));
    }
    if (spawn.lease != "" and !descends(rows!, job: found!.id, ancestor: spawn.lease)) {
        return magus\guard.deny("the row `{found!.id}` is not under your lease, so the guard will not bind the child to it\n"
            + "You act under the lease `{spawn.lease}`, and `{found!.id}` is neither it nor forked beneath it. "
            + remedy(spawn, line: line));
    }
    if (line!.role == integrateRole and spawn.checkout != "" and found!.checkoutRoot != "" and found!.checkoutRoot != spawn.checkout) {
        return magus\guard.deny("the row `{found!.id}` is bound to another checkout; spawn its integrator from there\n"
            + "The integrator shares the spawning checkout, `{spawn.checkout}`, but the row is bound to "
            + "`{found!.checkoutRoot}`, where the guard takes its lease and the child would find no lease to hold. "
            + "The holder of a `--checkout` row runs the gate in that checkout itself, so it needs no integrator from here. "
            + "Otherwise spawn it from a session in `{found!.checkoutRoot}`, or fork a row bound to this checkout: "
            + "`magus job fork {found!.id}-here --write-paths <paths> --criteria \"<what done means>\"` (no --checkout), "
            + "then spawn with `{line!.parent}/integrate {found!.id}-here`.");
    }
    return magus\guard.allow();
}

// descends reports whether job is ancestor or has ancestor in its parent chain.
fun descends(rows: [helpers\JobRow], job: str, ancestor: str) > bool {
    final parents = mut {<str: str>};
    foreach (r in rows) {
        parents[r.id] = r.parent;
    }
    final seen = mut {<str: bool>};
    var at = job;
    while (at != "" and !(seen[at] ?? false)) {
        if (at == ancestor) {
            return true;
        }
        seen[at] = true;
        at = parents[at] ?? "";
    }
    return false;
}

// remedy is the fork and retitle this spawn needs, with every value the request carries
// filled in.
fun remedy(spawn: Spawn, line: Lineage?) > str {
    var id = "<job>";
    var role = "<role>";
    var parent = "orchestrator";
    if (line != null) {
        id = line!.job;
        role = line!.role;
        parent = line!.parent;
    }
    if (spawn.lease != "") {
        parent = spawn.lease;
    }
    var model = "<tier or model>";
    if (spawn.model != "") {
        model = spawn.model;
    }
    var fork = "magus job fork {id}";
    var tool = "magus\\job.put(\"{id}\", .\{ ";
    if (parent != "orchestrator") {
        fork = fork + " --parent {parent}";
        tool = tool + "parent = \"{parent}\", ";
    }
    fork = fork + " --model {model}";
    tool = tool + "model = \"{model}\"";
    if (thinkingRoles.indexOf(role) != null) {
        fork = fork + " --read-only";
        tool = tool + ", read_only = true";
    } else {
        fork = fork + " --write-paths <paths>";
        tool = tool + ", write_paths = [\"<paths>\"]";
    }
    fork = fork + " --criteria \"<what done means>\"";
    tool = tool + ", criteria = \"<what done means>\" })";
    var scope = "";
    if (spawn.lease != "") {
        scope = " Under your lease the row is a child of `{spawn.lease}`: its write paths are ones "
            + "your row already holds, and the job store refuses anything wider.";
    }
    return "Fork the row first: `{fork}` (or the client tool: `{tool}`), then spawn with the "
        + "description `{parent}/{role} {id}`. A thinking role (plan, review, research, scout) "
        + "forks `--read-only`; integrate and a change role declare `--write-paths`.{scope}";
}

fun request(title: str, isolated: bool) > Spawn {
    return Spawn{ kind = magus\SpawnKind.spawn, title = title, isolated = isolated, model = "opus" };
}

final store = [
    helpers\JobRow{ id = "guard-command", state = magus\JobState.running },
    helpers\JobRow{ id = "naming-advisory", state = magus\JobState.declared },
    helpers\JobRow{ id = "changelog-fragments", state = magus\JobState.exited },
    helpers\JobRow{ id = "v050-prep", state = magus\JobState.running },
    helpers\JobRow{ id = "v050-prep/scout-callers", state = magus\JobState.declared, parent = "v050-prep" },
    helpers\JobRow{ id = "drop-improve", state = magus\JobState.pass, parent = "v050-prep" },
    helpers\JobRow{ id = "footprint", state = magus\JobState.noReturn },
    helpers\JobRow{ id = "elsewhere", state = magus\JobState.running },
];

// judged is decideSpawn with every denial held to the verdict shape.
fun judged(spawn: Spawn, rows: [helpers\JobRow]?, unreadable: str) > GuardVerdict {
    return verdict\checked(decideSpawn(spawn, rows: rows, unreadable: unreadable), label: spawn.title);
}

test "a live row passes" {
    foreach (title in ["orchestrator/review naming-advisory", "orchestrator/feat guard-command", "orchestrator/docs changelog-fragments"]) {
        final v = judged(request(title, isolated: true), rows: store, unreadable: "");
        std\assert(v.decision == magus\GuardDecision.allow, message: title);
    }
}

test "a spawn with no lineage title is denied, naming the fork" {
    final v = judged(Spawn{ kind = magus\SpawnKind.spawn, title = "audit the store", isolated = true }, rows: store, unreadable: "");
    std\assert(v.decision == magus\GuardDecision.deny, message: "no title grammar");
    std\assert(v.reason.indexOf("magus job fork <job> --model <tier or model> --write-paths <paths>") != null, message: "names the fork");
    std\assert(v.reason.indexOf("`orchestrator/<role> <job>`") != null, message: "names the retitle");
    std\assert(v.reason.indexOf("magus\\job.put(\"<job>\"") != null, message: "names the client tool write");
    std\assert(v.reason.indexOf("magus_job") == null, message: "names no retired MCP tool");
}

test "a title naming a missing row is denied with the real command" {
    final v = judged(request("v050-prep/scout nothing-here", isolated: false), rows: store, unreadable: "");
    std\assert(v.decision == magus\GuardDecision.deny, message: "missing row");
    std\assert(v.reason.indexOf("magus job fork nothing-here --parent v050-prep --model opus --read-only") != null, message: v.reason);
    std\assert(v.reason.indexOf("magus\\job.put(\"nothing-here\", .\{ parent = \"v050-prep\"") != null, message: "names the client write");
    std\assert(v.reason.indexOf("read_only = true") != null, message: "names the read-only field");
    std\assert(v.reason.indexOf("`v050-prep/scout nothing-here`") != null, message: "names the retitle");
}

test "an ended row is denied" {
    foreach (title in ["v050-prep/refactor drop-improve", "orchestrator/fix footprint"]) {
        final v = judged(request(title, isolated: true), rows: store, unreadable: "");
        std\assert(v.decision == magus\GuardDecision.deny, message: title);
        std\assert(v.reason.indexOf("has ended") != null, message: "says why");
    }
}

test "a nested id resolves under the title's parent" {
    final v = judged(request("v050-prep/scout scout-callers", isolated: false), rows: store, unreadable: "");
    std\assert(v.decision == magus\GuardDecision.allow, message: "v050-prep/scout-callers");
}

test "a leased spawner hands out only its own tree" {
    final mine = Spawn{ kind = magus\SpawnKind.spawn, title = "v050-prep/scout scout-callers", isolated = false, lease = "v050-prep" };
    std\assert(judged(mine, rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "a child of the lease");
    final other = Spawn{ kind = magus\SpawnKind.spawn, title = "v050-prep/review elsewhere", isolated = false, lease = "v050-prep" };
    final v = judged(other, rows: store, unreadable: "");
    std\assert(v.decision == magus\GuardDecision.deny, message: "a row outside the lease");
    std\assert(v.reason.indexOf("--parent v050-prep") != null, message: "forks beneath the lease");
    std\assert(v.reason.indexOf("a child of `v050-prep`") != null, message: "says the fork is a child the store grades");
    final unleased = judged(request("v050-prep/scout nothing-here", isolated: false), rows: store, unreadable: "");
    std\assert(unleased.reason.indexOf("a child of") == null, message: "an orchestrator's remedy names no lease");
}

test "an unreadable store advises and never denies" {
    final v = judged(request("orchestrator/review anything", isolated: false), rows: null, unreadable: "job store schema 10 is newer than 9");
    std\assert(v.decision == magus\GuardDecision.advise, message: "fails open");
    std\assert(v.reason.indexOf("schema 10") != null, message: "names the cause");
    std\assert(judged(request("orchestrator/feat anything", isolated: false), rows: null, unreadable: "x").decision == magus\GuardDecision.deny, message: "isolation still denies");
}

test "a code-changing spawn without its own checkout is denied" {
    foreach (title in ["orchestrator/feat guard-command", "v050-prep/fix naming-advisory", "orchestrator/docs changelog-fragments"]) {
        final v = judged(request(title, isolated: false), rows: store, unreadable: "");
        std\assert(v.decision == magus\GuardDecision.deny, message: title);
        std\assert(v.reason.indexOf("isolation: \"worktree\"") != null, message: "names the fix");
    }
}

test "an integrate spawn is refused for a row bound to another checkout, naming where to spawn it" {
    final rows = [
        helpers\JobRow{ id = "land", state = magus\JobState.declared, checkoutRoot = "/w/other" },
        helpers\JobRow{ id = "here", state = magus\JobState.declared, checkoutRoot = "/w/main" },
        helpers\JobRow{ id = "unbound", state = magus\JobState.declared },
    ];
    final at = fun (title: str) > Spawn {
        return Spawn{ kind = magus\SpawnKind.spawn, title = title, isolated = false, checkout = "/w/main" };
    };
    final denied = judged(at("orchestrator/integrate land"), rows: rows, unreadable: "");
    std\assert(denied.decision == magus\GuardDecision.deny, message: "bound elsewhere");
    std\assert(denied.reason.indexOf("`/w/other`") != null and denied.reason.indexOf("magus job fork land-here") != null, message: denied.reason);
    std\assert(judged(at("orchestrator/integrate here"), rows: rows, unreadable: "").decision == magus\GuardDecision.allow, message: "bound here");
    std\assert(judged(at("orchestrator/integrate unbound"), rows: rows, unreadable: "").decision == magus\GuardDecision.allow, message: "bound to none");
    std\assert(judged(Spawn{ kind = magus\SpawnKind.spawn, title = "orchestrator/integrate land", isolated = false }, rows: rows, unreadable: "").decision == magus\GuardDecision.allow,
        message: "a spawn whose checkout is unread");
}

test "a thinking role, an isolated worker and a continue pass" {
    std\assert(judged(request("v050-prep/review naming-advisory", isolated: false), rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "a review");
    std\assert(judged(request("orchestrator/feat guard-command", isolated: true), rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "isolated");
    std\assert(judged(Spawn{ kind = magus\SpawnKind.continuation, title = "", isolated = false }, rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "a continue");
}

fun briefed(prompt: str) > Spawn {
    return Spawn{ kind = magus\SpawnKind.spawn, title = "orchestrator/feat guard-command", isolated = true, prompt = prompt };
}

test "a brief that tells the worker to build magus is denied, naming the script" {
    foreach (prompt in [
        "SETUP:\n1. `GOEXPERIMENT=jsonv2 go run -trimpath ./cmd/magus run go-build --no-cache .`\n2. Work.",
        "Run `magus run go-build .` first.",
        "```sh\ngo build -o magus ./cmd/magus\n```",
    ]) {
        final v = judged(briefed(prompt), rows: store, unreadable: "");
        std\assert(v.decision == magus\GuardDecision.deny, message: prompt);
        std\assert(v.reason.indexOf("hack/dev/bootstrap-worktree.buzz") != null, message: "names the script");
        std\assert(v.reason.indexOf("one binary per base commit") != null, message: "says the orchestrator places it");
    }
    final unreadable = judged(briefed("Run `magus run go-build .` first."), rows: null, unreadable: "x");
    std\assert(unreadable.decision == magus\GuardDecision.deny, message: "an unreadable store does not excuse the brief");
}

test "an integrate spawn shares the checkout and its brief may build magus" {
    final integrate = Spawn{ kind = magus\SpawnKind.spawn, title = "orchestrator/integrate guard-command", isolated = false, prompt = "Run `magus run go-build .` once the units land." };
    final v = judged(integrate, rows: store, unreadable: "");
    std\assert(v.decision != magus\GuardDecision.deny, message: v.reason);
}

test "a brief that forbids the build or builds something else passes" {
    foreach (prompt in [
        "Never run `go build ./cmd/magus`; the orchestrator places ./magus.",
        "Do not build magus:\n\n```sh\nmagus run go-build .\n```\n",
        "Run `go run ./cmd/magus-utils` and `./magus run buzz-test .`.",
        "",
    ]) {
        std\assert(judged(briefed(prompt), rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: prompt);
    }
    final continued = Spawn{ kind = magus\SpawnKind.continuation, title = "", isolated = false, prompt = "Run `magus run go-build .`" };
    std\assert(judged(continued, rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "a continue starts nothing");
}

test "a spawn whose job builds its own binary may brief the build" {
    final prompt = "Run `magus run go-build .` first.";
    final own = Spawn{ kind = magus\SpawnKind.spawn, title = "orchestrator/feat guard-command", isolated = true, prompt = prompt, ownBuild = true };
    std\assert(judged(own, rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "its own build");
    std\assert(judged(briefed(prompt), rows: store, unreadable: "").decision == magus\GuardDecision.deny, message: "the same brief for any other job");
}
