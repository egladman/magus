// The spawn rules the root magusfile registers: spawn-without-job-row,
// change-role-spawn-not-isolated and brief-builds-magus.
namespace agentpolicy\spawn;

import "std";
import "magus";
import "vcs";
import "result";
import "./hack/policy/helpers" as helpers;
import "./hack/policy/builds" as builds;
import "./hack/policy/verdict" as verdict;
import "./hack/policy/mandate" as mandate;

final isolationDenial = "a worker that changes code would share this checkout; spawn it with "
    + "`isolation: \"worktree\"`.\n"
    + "A worker that changes code gets its own checkout, and detaches onto its branch "
    + "(`git switch --detach <branch>`) as its first act. Measured 09-22: 312 writes from 7 workers sharing a checkout landed in the "
    + "orchestrator's tree, and no isolated writer's did. Thinking roles (plan, review, research, "
    + "scout) may share it, and so does integrate, which lands the work in this checkout.";

// The roles a spawn title names for work that changes the tree: the conventional commit types.
final changeRoles = ["feat", "fix", "refactor", "perf", "docs", "test", "chore"];

// The roles that read and report, forked as read-only jobs.
final thinkingRoles = ["plan", "review", "research", "scout"];

// The role that integrates the checkout it shares: it builds magus, regenerates and commits.
final integrateRole = "integrate";

// Spawn is what the rules read of one spawn, copied out of the request because a Buzz test
// cannot build the host's SpawnRequest: constructing its Job fails on a nested default.
export object Spawn {
    kind: magus\SpawnKind,
    title: str,
    isolated: bool,
    model: str = "",
    // lease is the job the spawner acts under, "" for the orchestrator or a person.
    lease: str = "",
    // prompt is the brief handed to the spawned worker.
    prompt: str = "",
    // checkout is the checkout the spawn runs in, "" when unread.
    checkout: str = "",
    // ownBuild: the spawned job owns its checkout and its write paths cover a build input of
    // ./cmd/magus there, so its worker builds ./magus (see builds\OwnBuild).
    ownBuild: bool = false,
    // agentType is the host's subagent type. No rule reads it: the type is the
    // orchestrator's choice, and the host enforces the tools it carries.
    agentType: str = "",
}

// Lineage is a `<parent>/<role> <job>` title taken apart, or null for any other form.
object Lineage {
    parent: str,
    role: str,
    job: str,
}

fun lineage(title: str) > Lineage? {
    final role = helpers\titleRole(title);
    if (role == "") {
        return null;
    }
    final words = title.split(" ");
    final head = words[0];
    return Lineage{ parent = head.sub(0, len: head.len() - role.len() - 1), role = role, job = words[1] };
}

// decideSpawn denies a spawn that names no live job row, then a code-changing worker that
// would share the spawning checkout, then a brief that tells its worker to build magus. rows is null when the store could not be read, which
// unreadable says why: the row rule then advises and never denies. A continue starts
// nothing, so it passes both.
export fun decideSpawn(spawn: Spawn, rows: [helpers\JobRow]?, unreadable: str) > GuardVerdict {
    if (spawn.kind != magus\SpawnKind.spawn) {
        return magus\guard.allow();
    }
    final row = decideJobRow(spawn, rows: rows, unreadable: unreadable);
    if (row.decision == magus\GuardDecision.deny) {
        return row;
    }
    if (!spawn.isolated and changeRoles.indexOf(helpers\titleRole(spawn.title)) != null) {
        return magus\guard.deny(isolationDenial);
    }
    if (helpers\titleRole(spawn.title) == integrateRole) {
        return row;
    }
    final building = builds\briefDenial(spawn.prompt, ownBuild: spawn.ownBuild);
    if (building != "") {
        return magus\guard.deny(building);
    }
    return row;
}

// decideJobRow is spawn-without-job-row: the title must name a live row the spawner may hand
// out, or the guard cannot bind the child to its lease. The job is the row `<job>`, else
// `<parent>/<job>`, the same resolution the guard binds with.
fun decideJobRow(spawn: Spawn, rows: [helpers\JobRow]?, unreadable: str) > GuardVerdict {
    if (rows == null) {
        return magus\guard.advise("The job store could not be read ({unreadable}), so whether this spawn "
            + "names a live job row went unchecked and it passes. Its child will not be bound to a lease. "
            + "Run `magus doctor` and `magus ls jobs` to see why the store fails to load.");
    }
    final line = lineage(spawn.title);
    if (line == null) {
        return magus\guard.deny("this spawn's description names no job; it must read `<parent>/<role> <job>`\n"
            + "The description is `{spawn.title}`, and <job> is a live row in this workspace's job store. "
            + remedy(spawn, line: null));
    }
    var found: helpers\JobRow? = null;
    foreach (id in [line!.job, "{line!.parent}/{line!.job}"]) {
        foreach (r in rows!) {
            if (found == null and r.id == id) {
                found = r;
            }
        }
    }
    if (found == null) {
        return magus\guard.deny("no row `{line!.job}` is in this workspace's job store; fork it before the spawn\n"
            + "Neither `{line!.job}` nor `{line!.parent}/{line!.job}` is a row, so the guard has no lease "
            + "to bind this spawn's child to. " + remedy(spawn, line: line));
    }
    if ([magus\JobState.declared, magus\JobState.running, magus\JobState.exited].indexOf(found!.state) == null) {
        return magus\guard.deny("the row `{found!.id}` has ended ({found!.state.value}); fork a live one\n"
            + "A child bound to an ended row is graded by nothing. " + remedy(spawn, line: line));
    }
    if (spawn.lease != "" and !descends(rows!, job: found!.id, ancestor: spawn.lease)) {
        return magus\guard.deny("the row `{found!.id}` is not under your lease, so the guard will not bind the child to it\n"
            + "You act under the lease `{spawn.lease}`, and `{found!.id}` is neither it nor forked beneath it. "
            + remedy(spawn, line: line));
    }
    if (line!.role == integrateRole and spawn.checkout != "" and found!.checkoutRoot != "" and found!.checkoutRoot != spawn.checkout) {
        return magus\guard.deny("the row `{found!.id}` is bound to another checkout; spawn its integrator from there\n"
            + "The integrator shares the spawning checkout, `{spawn.checkout}`, but the row is bound to "
            + "`{found!.checkoutRoot}`, where the guard takes its lease and the child would find no lease to hold. "
            + "The holder of a `--checkout` row runs the gate in that checkout itself, so it needs no integrator from here. "
            + "Otherwise spawn it from a session in `{found!.checkoutRoot}`, or fork a row bound to this checkout: "
            + "`magus job fork {found!.id}-here --write-paths <paths> --instructions \"<what done means>\"` (no --checkout), "
            + "then spawn with `{line!.parent}/integrate {found!.id}-here`.");
    }
    return magus\guard.allow();
}

// descends reports whether job is ancestor or has ancestor in its parent chain.
fun descends(rows: [helpers\JobRow], job: str, ancestor: str) > bool {
    final parents = mut {<str: str>};
    foreach (r in rows) {
        parents[r.id] = r.parent;
    }
    final seen = mut {<str: bool>};
    var at = job;
    while (at != "" and !(seen[at] ?? false)) {
        if (at == ancestor) {
            return true;
        }
        seen[at] = true;
        at = parents[at] ?? "";
    }
    return false;
}

// remedy is the fork and retitle this spawn needs, with every value the request carries
// filled in.
fun remedy(spawn: Spawn, line: Lineage?) > str {
    var id = "<job>";
    var role = "<role>";
    var parent = "orchestrator";
    if (line != null) {
        id = line!.job;
        role = line!.role;
        parent = line!.parent;
    }
    if (spawn.lease != "") {
        parent = spawn.lease;
    }
    var model = "<tier or model>";
    if (spawn.model != "") {
        model = spawn.model;
    }
    var fork = "magus job fork {id}";
    var tool = "magus\\workspace().putJob(\"{id}\", .\{ ";
    if (parent != "orchestrator") {
        fork = fork + " --parent {parent}";
        tool = tool + "parent = \"{parent}\", ";
    }
    fork = fork + " --model {model}";
    final modelKey = if (spawn.model != "") "id" else "tier";
    if (thinkingRoles.indexOf(role) != null) {
        fork = fork + " --read-only";
        tool = tool + "read_only = true";
    } else {
        fork = fork + " --write-paths <paths>";
        tool = tool + "write_paths = [\"<paths>\"]";
    }
    fork = fork + " --instructions \"<what done means>\"";
    tool = tool + ", agent = \{\"model\": \{\"{modelKey}\": \"{model}\"}, \"instructions\": \"<what done means>\", \"worker\": \{\"type\": \"resume\"}} })";
    var scope = "";
    if (spawn.lease != "") {
        scope = " Under your lease the row is a child of `{spawn.lease}`: its write paths are ones "
            + "your row already holds, and the job store refuses anything wider.";
    }
    return "Fork the row first: `{fork}` (or the client tool: `{tool}`), then spawn with the "
        + "description `{parent}/{role} {id}`. A thinking role (plan, review, research, scout) "
        + "forks `--read-only`; integrate and a change role declare `--write-paths`.{scope}";
}

fun request(title: str, isolated: bool) > Spawn {
    return Spawn{ kind = magus\SpawnKind.spawn, title = title, isolated = isolated, model = "opus" };
}

final store = [
    helpers\JobRow{ id = "guard-command", state = magus\JobState.running },
    helpers\JobRow{ id = "naming-advisory", state = magus\JobState.declared },
    helpers\JobRow{ id = "changelog-fragments", state = magus\JobState.exited },
    helpers\JobRow{ id = "v050-prep", state = magus\JobState.running },
    helpers\JobRow{ id = "v050-prep/scout-callers", state = magus\JobState.declared, parent = "v050-prep" },
    helpers\JobRow{ id = "drop-improve", state = magus\JobState.pass, parent = "v050-prep" },
    helpers\JobRow{ id = "footprint", state = magus\JobState.noReturn },
    helpers\JobRow{ id = "elsewhere", state = magus\JobState.running },
];

// judged is decideSpawn with every denial held to the verdict shape.
fun judged(spawn: Spawn, rows: [helpers\JobRow]?, unreadable: str) > GuardVerdict {
    return verdict\checked(decideSpawn(spawn, rows: rows, unreadable: unreadable), label: spawn.title);
}

test "a live row passes" {
    foreach (title in ["orchestrator/review naming-advisory", "orchestrator/feat guard-command", "orchestrator/docs changelog-fragments"]) {
        final v = judged(request(title, isolated: true), rows: store, unreadable: "");
        std\assert(v.decision == magus\GuardDecision.allow, message: title);
    }
}

test "a spawn with no lineage title is denied, naming the fork" {
    final v = judged(Spawn{ kind = magus\SpawnKind.spawn, title = "audit the store", isolated = true }, rows: store, unreadable: "");
    std\assert(v.decision == magus\GuardDecision.deny, message: "no title grammar");
    std\assert(v.reason.indexOf("magus job fork <job> --model <tier or model> --write-paths <paths>") != null, message: "names the fork");
    std\assert(v.reason.indexOf("`orchestrator/<role> <job>`") != null, message: "names the retitle");
    std\assert(v.reason.indexOf("magus\\workspace().putJob(\"<job>\"") != null, message: "names the client tool write");
    std\assert(v.reason.indexOf("magus_job") == null, message: "names no retired MCP tool");
}

test "a title naming a missing row is denied with the real command" {
    final v = judged(request("v050-prep/scout nothing-here", isolated: false), rows: store, unreadable: "");
    std\assert(v.decision == magus\GuardDecision.deny, message: "missing row");
    std\assert(v.reason.indexOf("magus job fork nothing-here --parent v050-prep --model opus --read-only") != null, message: v.reason);
    std\assert(v.reason.indexOf("magus\\workspace().putJob(\"nothing-here\", .\{ parent = \"v050-prep\"") != null, message: "names the client write");
    std\assert(v.reason.indexOf("read_only = true") != null, message: "names the read-only field");
    std\assert(v.reason.indexOf("`v050-prep/scout nothing-here`") != null, message: "names the retitle");
}

test "an ended row is denied" {
    foreach (title in ["v050-prep/refactor drop-improve", "orchestrator/fix footprint"]) {
        final v = judged(request(title, isolated: true), rows: store, unreadable: "");
        std\assert(v.decision == magus\GuardDecision.deny, message: title);
        std\assert(v.reason.indexOf("has ended") != null, message: "says why");
    }
}

test "a nested id resolves under the title's parent" {
    final v = judged(request("v050-prep/scout scout-callers", isolated: false), rows: store, unreadable: "");
    std\assert(v.decision == magus\GuardDecision.allow, message: "v050-prep/scout-callers");
}

test "a leased spawner hands out only its own tree" {
    final mine = Spawn{ kind = magus\SpawnKind.spawn, title = "v050-prep/scout scout-callers", isolated = false, lease = "v050-prep" };
    std\assert(judged(mine, rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "a child of the lease");
    final other = Spawn{ kind = magus\SpawnKind.spawn, title = "v050-prep/review elsewhere", isolated = false, lease = "v050-prep" };
    final v = judged(other, rows: store, unreadable: "");
    std\assert(v.decision == magus\GuardDecision.deny, message: "a row outside the lease");
    std\assert(v.reason.indexOf("--parent v050-prep") != null, message: "forks beneath the lease");
    std\assert(v.reason.indexOf("a child of `v050-prep`") != null, message: "says the fork is a child the store grades");
    final unleased = judged(request("v050-prep/scout nothing-here", isolated: false), rows: store, unreadable: "");
    std\assert(unleased.reason.indexOf("a child of") == null, message: "an orchestrator's remedy names no lease");
}

test "an unreadable store advises and never denies" {
    final v = judged(request("orchestrator/review anything", isolated: false), rows: null, unreadable: "job store schema 10 is newer than 9");
    std\assert(v.decision == magus\GuardDecision.advise, message: "fails open");
    std\assert(v.reason.indexOf("schema 10") != null, message: "names the cause");
    std\assert(judged(request("orchestrator/feat anything", isolated: false), rows: null, unreadable: "x").decision == magus\GuardDecision.deny, message: "isolation still denies");
}

test "a code-changing spawn without its own checkout is denied" {
    foreach (title in ["orchestrator/feat guard-command", "v050-prep/fix naming-advisory", "orchestrator/docs changelog-fragments"]) {
        final v = judged(request(title, isolated: false), rows: store, unreadable: "");
        std\assert(v.decision == magus\GuardDecision.deny, message: title);
        std\assert(v.reason.indexOf("isolation: \"worktree\"") != null, message: "names the fix");
    }
}

test "an integrate spawn is refused for a row bound to another checkout, naming where to spawn it" {
    final rows = [
        helpers\JobRow{ id = "land", state = magus\JobState.declared, checkoutRoot = "/w/other" },
        helpers\JobRow{ id = "here", state = magus\JobState.declared, checkoutRoot = "/w/main" },
        helpers\JobRow{ id = "unbound", state = magus\JobState.declared },
    ];
    final at = fun (title: str) > Spawn {
        return Spawn{ kind = magus\SpawnKind.spawn, title = title, isolated = false, checkout = "/w/main" };
    };
    final denied = judged(at("orchestrator/integrate land"), rows: rows, unreadable: "");
    std\assert(denied.decision == magus\GuardDecision.deny, message: "bound elsewhere");
    std\assert(denied.reason.indexOf("`/w/other`") != null and denied.reason.indexOf("magus job fork land-here") != null, message: denied.reason);
    std\assert(judged(at("orchestrator/integrate here"), rows: rows, unreadable: "").decision == magus\GuardDecision.allow, message: "bound here");
    std\assert(judged(at("orchestrator/integrate unbound"), rows: rows, unreadable: "").decision == magus\GuardDecision.allow, message: "bound to none");
    std\assert(judged(Spawn{ kind = magus\SpawnKind.spawn, title = "orchestrator/integrate land", isolated = false }, rows: rows, unreadable: "").decision == magus\GuardDecision.allow,
        message: "a spawn whose checkout is unread");
}

test "a thinking role, an isolated worker and a continue pass" {
    std\assert(judged(request("v050-prep/review naming-advisory", isolated: false), rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "a review");
    std\assert(judged(request("orchestrator/feat guard-command", isolated: true), rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "isolated");
    std\assert(judged(Spawn{ kind = magus\SpawnKind.continuation, title = "", isolated = false }, rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "a continue");
}

test "a spawn differing only in agent type gets the same verdict" {
    final rows = [helpers\JobRow{ id = "guard-command", state = magus\JobState.running }];
    foreach (title in ["orchestrator/review guard-command", "orchestrator/feat guard-command", "orchestrator/review nothing-here"]) {
        foreach (isolated in [true, false]) {
            final plain = judged(Spawn{ kind = magus\SpawnKind.spawn, title = title, isolated = isolated }, rows: rows, unreadable: "");
            foreach (agentType in ["general-purpose", "Explore", "magus-scout", "a-type-nobody-ships"]) {
                final typed = judged(Spawn{ kind = magus\SpawnKind.spawn, title = title, isolated = isolated, agentType = agentType }, rows: rows, unreadable: "");
                std\assert(typed.decision == plain.decision, message: "{title} {isolated} {agentType}");
                std\assert(typed.reason == plain.reason, message: "reason for {title} {agentType}");
            }
        }
    }
}

fun briefed(prompt: str) > Spawn {
    return Spawn{ kind = magus\SpawnKind.spawn, title = "orchestrator/feat guard-command", isolated = true, prompt = prompt };
}

test "a brief that tells the worker to build magus is denied, naming the script" {
    foreach (prompt in [
        "SETUP:\n1. `GOEXPERIMENT=jsonv2 go run -trimpath ./cmd/magus run go-build --no-cache .`\n2. Work.",
        "Run `magus run go-build .` first.",
        "```sh\ngo build -o magus ./cmd/magus\n```",
    ]) {
        final v = judged(briefed(prompt), rows: store, unreadable: "");
        std\assert(v.decision == magus\GuardDecision.deny, message: prompt);
        std\assert(v.reason.indexOf("hack/dev/bootstrap-worktree.buzz") != null, message: "names the script");
        std\assert(v.reason.indexOf("one binary per base commit") != null, message: "says the orchestrator places it");
    }
    final unreadable = judged(briefed("Run `magus run go-build .` first."), rows: null, unreadable: "x");
    std\assert(unreadable.decision == magus\GuardDecision.deny, message: "an unreadable store does not excuse the brief");
}

test "an integrate spawn shares the checkout and its brief may build magus" {
    final integrate = Spawn{ kind = magus\SpawnKind.spawn, title = "orchestrator/integrate guard-command", isolated = false, prompt = "Run `magus run go-build .` once the units land." };
    final v = judged(integrate, rows: store, unreadable: "");
    std\assert(v.decision != magus\GuardDecision.deny, message: v.reason);
}

test "a brief that forbids the build or builds something else passes" {
    foreach (prompt in [
        "Never run `go build ./cmd/magus`; the orchestrator places ./magus.",
        "Do not build magus:\n\n```sh\nmagus run go-build .\n```\n",
        "Run `go run ./cmd/magus-utils` and `./magus run buzz-test .`.",
        "",
    ]) {
        std\assert(judged(briefed(prompt), rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: prompt);
    }
    final continued = Spawn{ kind = magus\SpawnKind.continuation, title = "", isolated = false, prompt = "Run `magus run go-build .`" };
    std\assert(judged(continued, rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "a continue starts nothing");
}

test "a spawn whose job builds its own binary may brief the build" {
    final prompt = "Run `magus run go-build .` first.";
    final own = Spawn{ kind = magus\SpawnKind.spawn, title = "orchestrator/feat guard-command", isolated = true, prompt = prompt, ownBuild = true };
    std\assert(judged(own, rows: store, unreadable: "").decision == magus\GuardDecision.allow, message: "its own build");
    std\assert(judged(briefed(prompt), rows: store, unreadable: "").decision == magus\GuardDecision.deny, message: "the same brief for any other job");
}

// A starting guess, not a measurement: change it here when it stops fitting.
// magus only reports this count. Refusing on it is this repository's call.
export final finishedBranchLimit = 10;

// ForkCounts is what the rules read of magus\workspace().forkFacts().
// It is copied out like Spawn.
// An unknown side says why it went unread, and never refuses.
export object ForkCounts {
    finishedBranches: [str] = [],
    branchesUnknown: str = "",
    // publishedSkipped counts finished branches left out of finishedBranches
    // because a remote ref holds their head.
    publishedSkipped: int = 0,
    // publishedUnread says why some branches could not be checked against the
    // remotes; they stay counted.
    publishedUnread: str = "",
    // landedSkipped counts finished branches whose change the base already
    // holds, as a squash merge leaves it.
    landedSkipped: int = 0,
    landedUnread: str = "",
    integrateRecord: str = "",
    commitsSinceTest: int = 0,
    lastTest: str = "",
    testUnknown: str = "",
}

// decideFork refuses a top-level fork at limit. Integrating and child forks
// pass, since they clear the backlog. A record no reader could see passes with
// a note, because refusing on its shape would stop forks that integrate.
export fun decideFork(fork: mandate\Fork, counts: ForkCounts, limit: int) > GuardVerdict {
    if (counts.branchesUnknown != "" or counts.finishedBranches.len() < limit) {
        return magus\guard.allow();
    }
    if (fork.known and (fork.integrates.len() > 0 or fork.parent != "")) {
        return magus\guard.allow();
    }
    final facts = "{counts.finishedBranches.len()} finished branch(es) off the base: {counts.finishedBranches.join(", ")}; "
        + "{describePublished(counts)}{describeTest(counts)}. The limit is {limit} branches, a starting guess: "
        + "change finishedBranchLimit in hack/policy/spawn.buzz if it is wrong.";
    if (!fork.known) {
        return magus\guard.advise("this fork's record could not be read, so it passes unjudged, though it would be refused if it does not integrate. {facts}");
    }
    return magus\guard.deny("too many finished branches wait off the base, so this fork is refused\n{facts} "
        + "Integrate them first with `./magus job fork --stdin --checkout <dir>`, given this record: {counts.integrateRecord}");
}

fun describePublished(counts: ForkCounts) > str {
    var said = "{counts.publishedSkipped} branch(es) skipped as published (their head is on a remote ref); ";
    if (counts.publishedUnread != "") {
        said = said + "the remote refs could not be read for some, which stay counted: {counts.publishedUnread}; ";
    }
    if (counts.landedSkipped > 0) {
        said = said + "{counts.landedSkipped} skipped as landed (the base already holds their change); ";
    }
    if (counts.landedUnread != "") {
        said = said + "some could not be checked against the base, which stay counted: {counts.landedUnread}; ";
    }
    return said;
}

// onRemoteRef is whether a remote ref holds branch's head. A branch git does
// not know, or a git that fails, is the Result's error.
export fun onRemoteRef(branch: str) > result\Result::<bool> {
    try {
        final found = vcs\cmd(["branch", "--remotes", "--contains", branch], opts: vcs\CommandOptions{ quiet = true, allowFailure = true });
        if (!found.ok) {
            return result\fail::<bool>("git branch --remotes --contains {branch}: {found.stderr.trim()}");
        }
        return result\ok::<bool>(found.stdout.trim() != "");
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "git branch --remotes --contains {branch}");
    }
}

// withoutPublished drops each finished branch whose head a remote ref holds:
// a pull request carries that work, so it waits on nothing off the base. When
// published fails the branch stays counted and the first failure is named.
export fun withoutPublished(counts: ForkCounts, published: fun (branch: str) > result\Result::<bool>) > ForkCounts {
    if (counts.branchesUnknown != "") {
        return counts;
    }
    final s = sift(counts.finishedBranches, held: published);
    return ForkCounts{
        finishedBranches = s.kept,
        branchesUnknown = counts.branchesUnknown,
        publishedSkipped = s.skipped,
        publishedUnread = s.unread,
        landedSkipped = counts.landedSkipped,
        landedUnread = counts.landedUnread,
        integrateRecord = counts.integrateRecord,
        commitsSinceTest = counts.commitsSinceTest,
        lastTest = counts.lastTest,
        testUnknown = counts.testUnknown,
    };
}

// withoutLanded drops each finished branch whose change the base already
// holds. A squash merge copies no commit, so the core still counts it.
export fun withoutLanded(counts: ForkCounts, landed: fun (branch: str) > result\Result::<bool>) > ForkCounts {
    if (counts.branchesUnknown != "") {
        return counts;
    }
    final s = sift(counts.finishedBranches, held: landed);
    return ForkCounts{
        finishedBranches = s.kept,
        branchesUnknown = counts.branchesUnknown,
        publishedSkipped = counts.publishedSkipped,
        publishedUnread = counts.publishedUnread,
        landedSkipped = s.skipped,
        landedUnread = s.unread,
        integrateRecord = counts.integrateRecord,
        commitsSinceTest = counts.commitsSinceTest,
        lastTest = counts.lastTest,
        testUnknown = counts.testUnknown,
    };
}

object Sifted {
    kept: [str],
    skipped: int = 0,
    unread: str = "",
}

// sift drops each entry whose branch held answers true. One held cannot
// answer stays counted, and the first failure is named.
fun sift(entries: [str], held: fun (branch: str) > result\Result::<bool>) > Sifted {
    final kept = mut [<str>];
    var skipped = 0;
    var unread = "";
    foreach (entry in entries) {
        final answer = held(entry.split(" ")[0]);
        if (answer.error != null) {
            if (unread == "") {
                unread = answer.error!.message;
            }
        } else if (answer.value!) {
            skipped = skipped + 1;
            continue;
        }
        kept.append(entry);
    }
    return Sifted{ kept = kept, skipped = skipped, unread = unread };
}

// landedOnBase is whether merging branch into HEAD, and into the VCS base,
// leaves either tree unchanged. A conflict reads as not landed.
export fun landedOnBase(branch: str) > result\Result::<bool> {
    try {
        final bases = mut ["HEAD"];
        final base = vcs\base();
        if (base != "" and base != "HEAD") {
            bases.append(base);
        }
        foreach (b in bases) {
            final tree = vcs\cmd(["rev-parse", "{b}^\{tree\}"], opts: vcs\CommandOptions{ quiet = true, allowFailure = true });
            if (!tree.ok) {
                return result\fail::<bool>("git rev-parse {b}: {tree.stderr.trim()}");
            }
            final merged = vcs\cmd(["merge-tree", "--write-tree", b, branch], opts: vcs\CommandOptions{ quiet = true, allowFailure = true });
            if (merged.code > 1) {
                return result\fail::<bool>("git merge-tree {b} {branch}: {merged.stderr.trim()}");
            }
            if (merged.code == 0 and merged.stdout.trim() == tree.stdout.trim()) {
                return result\ok::<bool>(true);
            }
        }
        return result\ok::<bool>(false);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "git merge-tree {branch}");
    }
}

fun describeTest(counts: ForkCounts) > str {
    if (counts.testUnknown != "") {
        return "commits since the last full test: unknown, {counts.testUnknown}";
    }
    return "{counts.commitsSinceTest} commit(s) since the last full test, {counts.lastTest}";
}

// decideForkLine judges each `magus job fork` on a line. facts runs only for a
// fork that could be refused, since it reads the version control per row.
export fun decideForkLine(programs: [helpers\Program], line: str, read: fun (path: str) > str, facts: fun () > ForkCounts, limit: int) > GuardVerdict {
    foreach (index, p in programs) {
        final ops = helpers\magusOperands(p.args);
        if (p.name != "magus" or ops.len() < 2 or ops[0] != "job" or ops[1] != "fork") {
            continue;
        }
        final fork = mandate\readFork(p, body: forkRecord(programs, at: index, line: line, read: read));
        if (fork.known and (fork.integrates.len() > 0 or fork.parent != "")) {
            continue;
        }
        var counts = withoutPublished(facts(), published: onRemoteRef);
        // Each landed check merges trees, so only a count at the limit pays.
        if (counts.finishedBranches.len() >= limit) {
            counts = withoutLanded(counts, landed: landedOnBase);
        }
        final judged = decideFork(fork, counts: counts, limit: limit);
        if (judged.decision != magus\GuardDecision.allow) {
            return judged;
        }
    }
    return magus\guard.allow();
}

// forkRecord is the --stdin record of the fork at programs[at], from a heredoc,
// a redirected file, or an `echo` or `cat` piped to it. "" when none is
// readable.
fun forkRecord(programs: [helpers\Program], at: int, line: str, read: fun (path: str) > str) > str {
    final bodies = mandate\plainHeredocs(line);
    if (bodies.len() > 0) {
        return bodies[0];
    }
    final redirect = line.indexOf(" < ");
    if (redirect != null) {
        final rest = line.sub(redirect! + 3).trim().split(" ")[0];
        return read(rest.replace("'", with: "").replace("\"", with: ""));
    }
    if (at == 0 or line.indexOf("|") == null) {
        return "";
    }
    final before = programs[at - 1];
    if (before.name == "echo") {
        return before.args.join(" ");
    }
    if (before.name == "cat" and before.args.len() == 1) {
        return read(before.args[0]);
    }
    return "";
}

fun waiting(branches: int, commits: int = 3) > ForkCounts {
    final names = mut [<str>];
    for (var i = 0; i < branches; i = i + 1) {
        names.append("done-{i} (job done-{i}, 1 commit(s))");
    }
    return ForkCounts{
        finishedBranches = names,
        integrateRecord = "\{\"api_version\":\"magus.job/v1alpha1\",\"id\":\"integrate-branches\"\}",
        commitsSinceTest = commits,
        lastTest = "out1a2b3c at abc123",
    };
}

fun forkProgram(args: [str]) > helpers\Program {
    return helpers\Program{ name = "magus", args = ["job", "fork"] + args, repeats = false };
}

fun noFile(path: str) > str {
    return "";
}

test "a top-level fork at the limit is refused, printing both counts, the last test and the file" {
    final v = verdict\checked(decideFork(mandate\Fork{ id = "next" }, counts: waiting(10), limit: finishedBranchLimit), label: "at the limit");
    std\assert(v.decision == magus\GuardDecision.deny, message: "at the branch limit");
    foreach (want in ["10 finished branch(es)", "done-9 (job done-9", "3 commit(s)", "out1a2b3c at abc123", "hack/policy/spawn.buzz", "integrate-branches"]) {
        std\assert(v.reason.indexOf(want) != null, message: "{want} in {v.reason}");
    }
}

test "a branch a remote ref holds stops counting, and the denial says how many were skipped" {
    final onRemote = fun (branch: str) > result\Result::<bool> {
        return result\ok::<bool>(branch != "done-0" and branch != "done-1");
    };
    final trimmed = withoutPublished(waiting(12), published: onRemote);
    std\assert(trimmed.finishedBranches.len() == 2 and trimmed.publishedSkipped == 10, message: "{trimmed.finishedBranches}");
    std\assert(decideFork(mandate\Fork{ id = "next" }, counts: trimmed, limit: finishedBranchLimit).decision == magus\GuardDecision.allow, message: "published work waits on nothing");
    final stillOver = withoutPublished(waiting(12), published: fun (branch: str) > result\Result::<bool> {
        return result\ok::<bool>(branch == "done-0");
    });
    final v = decideFork(mandate\Fork{ id = "next" }, counts: stillOver, limit: finishedBranchLimit);
    std\assert(v.decision == magus\GuardDecision.deny, message: "eleven unpublished");
    std\assert(v.reason.indexOf("1 branch(es) skipped as published") != null, message: v.reason);
}

test "a branch the base already holds stops counting, and the denial says how many were skipped" {
    final squashed = fun (branch: str) > result\Result::<bool> {
        return result\ok::<bool>(branch != "done-0");
    };
    final trimmed = withoutLanded(waiting(12), landed: squashed);
    std\assert(trimmed.finishedBranches.len() == 1 and trimmed.landedSkipped == 11, message: "{trimmed.finishedBranches}");
    std\assert(decideFork(mandate\Fork{ id = "next" }, counts: trimmed, limit: finishedBranchLimit).decision == magus\GuardDecision.allow, message: "landed work waits on nothing");
    final stillOver = withoutLanded(waiting(12), landed: fun (branch: str) > result\Result::<bool> {
        return result\ok::<bool>(branch == "done-0");
    });
    final v = decideFork(mandate\Fork{ id = "next" }, counts: stillOver, limit: finishedBranchLimit);
    std\assert(v.decision == magus\GuardDecision.deny, message: "eleven not landed");
    std\assert(v.reason.indexOf("1 skipped as landed") != null, message: v.reason);
}

test "a branch the base cannot be checked against stays counted, and says why" {
    final broken = withoutLanded(waiting(10), landed: fun (branch: str) > result\Result::<bool> {
        return result\fail::<bool>("git merge-tree HEAD {branch}: bad object");
    });
    std\assert(broken.finishedBranches.len() == 10 and broken.landedSkipped == 0, message: "counted");
    final v = decideFork(mandate\Fork{ id = "next" }, counts: broken, limit: finishedBranchLimit);
    std\assert(v.reason.indexOf("bad object") != null, message: v.reason);
}

test "a branch that is on no remote ref stays counted, and an unreadable one says why" {
    final none = withoutPublished(waiting(10), published: fun (branch: str) > result\Result::<bool> {
        return result\ok::<bool>(false);
    });
    std\assert(none.finishedBranches.len() == 10 and none.publishedSkipped == 0, message: "unpublished");
    final v = decideFork(mandate\Fork{ id = "next" }, counts: none, limit: finishedBranchLimit);
    std\assert(v.decision == magus\GuardDecision.deny and v.reason.indexOf("0 branch(es) skipped as published") != null, message: v.reason);
    final broken = withoutPublished(waiting(10), published: fun (branch: str) > result\Result::<bool> {
        return result\fail::<bool>("no remotes");
    });
    std\assert(broken.finishedBranches.len() == 10 and broken.publishedUnread == "no remotes", message: broken.publishedUnread);
}

test "raising the limit lets the same fork through" {
    final v = decideFork(mandate\Fork{ id = "next" }, counts: waiting(10), limit: finishedBranchLimit + 1);
    std\assert(v.decision == magus\GuardDecision.allow, message: v.reason);
}

test "commits alone never refuse" {
    final v = decideFork(mandate\Fork{ id = "next" }, counts: waiting(0, commits: 100000), limit: finishedBranchLimit);
    std\assert(v.decision == magus\GuardDecision.allow, message: v.reason);
}

test "below the limit, integrating, or a child of a job passes" {
    final over = waiting(10);
    std\assert(decideFork(mandate\Fork{ id = "next" }, counts: waiting(9), limit: 10).decision == magus\GuardDecision.allow, message: "below");
    std\assert(decideFork(mandate\Fork{ id = "land", integrates = ["done-0"] }, counts: over, limit: 10).decision == magus\GuardDecision.allow, message: "integrates");
    std\assert(decideFork(mandate\Fork{ id = "child", parent = "next" }, counts: over, limit: 10).decision == magus\GuardDecision.allow, message: "child");
}

test "a branch count that could not be read never refuses" {
    final unknown = ForkCounts{ branchesUnknown = "version control is disabled here" };
    std\assert(decideFork(mandate\Fork{ id = "next" }, counts: unknown, limit: 0).decision == magus\GuardDecision.allow, message: "unknown");
}

test "a line reads the fork's record from a heredoc, a redirect, an echo or a cat" {
    final over = fun () > ForkCounts {
        return waiting(10);
    };
    final integrating = "\{\"id\":\"land\",\"integrates\":[\"done-0\"]\}";
    final plain = "\{\"id\":\"next\"\}";
    final file = fun (path: str) > str {
        return if (path == "land.json") integrating else plain;
    };
    final stdin = forkProgram(["--stdin"]);
    final heredoc = "./magus job fork --stdin <<'EOF'\n{integrating}\nEOF";
    std\assert(decideForkLine([stdin], line: heredoc, read: noFile, facts: over, limit: 10).decision == magus\GuardDecision.allow, message: "heredoc");
    std\assert(decideForkLine([stdin], line: "./magus job fork --stdin < land.json", read: file, facts: over, limit: 10).decision == magus\GuardDecision.allow, message: "redirect");
    std\assert(decideForkLine([stdin], line: "./magus job fork --stdin < plain.json", read: file, facts: over, limit: 10).decision == magus\GuardDecision.deny, message: "a redirected plain fork");
    final echo = helpers\Program{ name = "echo", args = [integrating], repeats = false };
    std\assert(decideForkLine([echo, stdin], line: "echo x | ./magus job fork --stdin", read: noFile, facts: over, limit: 10).decision == magus\GuardDecision.allow, message: "echo");
    final cat = helpers\Program{ name = "cat", args = ["plain.json"], repeats = false };
    std\assert(decideForkLine([cat, stdin], line: "cat plain.json | ./magus job fork --stdin", read: file, facts: over, limit: 10).decision == magus\GuardDecision.deny, message: "cat");
}

test "a record no reader can see passes with a note past the limit" {
    final over = fun () > ForkCounts {
        return waiting(10);
    };
    final v = decideForkLine([forkProgram(["--stdin"])], line: "./magus job fork --stdin", read: noFile, facts: over, limit: 10);
    std\assert(v.decision == magus\GuardDecision.advise, message: v.reason);
    std\assert(v.reason.indexOf("hack/policy/spawn.buzz") != null, message: v.reason);
}

test "a named fork is judged, a child reads no facts, and another command passes" {
    final over = fun () > ForkCounts {
        return waiting(10);
    };
    final refused = decideForkLine([forkProgram(["next", "--read-only"])], line: "./magus job fork next --read-only", read: noFile, facts: over, limit: 10);
    std\assert(refused.decision == magus\GuardDecision.deny, message: "a named fork");
    final unread = fun () > ForkCounts {
        std\assert(false, message: "a child reads no facts");
        return ForkCounts{};
    };
    std\assert(decideForkLine([forkProgram(["kid", "--parent", "next"])], line: "./magus job fork kid --parent next", read: noFile, facts: unread, limit: 10).decision == magus\GuardDecision.allow, message: "a child");
    std\assert(decideForkLine([helpers\Program{ name = "magus", args = ["ls", "jobs"], repeats = false }], line: "./magus ls jobs", read: noFile, facts: unread, limit: 10).decision == magus\GuardDecision.allow, message: "another verb");
}
