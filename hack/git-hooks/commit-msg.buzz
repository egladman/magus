// commit-msg git hook: holds every commit message to the brevity rules Vale judges
// (hack/prose: a short lowercase imperative subject, no body, no attribution), and a
// commit on the base branch also to a conventional subject, by the rule the pr-title
// target applies to pull request titles.
//
// This directory is the worked example of adding your own hook: a Buzz file named for the
// git hook (pre-commit.buzz, pre-push.buzz, ...) with a main that receives git's
// arguments, then `magus run git-hooks-install .`. spells/git/hooks.buzz writes the shim
// that runs it; a non-zero exit blocks the git operation, and `--no-verify` skips it.
// The shim sets BUZZ_INCLUDE_PATH to the workspace root, which is how the imports of
// hack/magusfile/commits and hack/prose below resolve.
//
// Pull requests are squash merged, so only a commit made on the base branch lands as
// written and answers to the conventional rule. Without vale on PATH the brevity rules
// are skipped with a notice rather than blocking every commit.
import "fs";
import "io";
import "os";
import "vcs";
import "hack/magusfile/commits" as commits;
import "hack/prose/vale" as prosevale;
import "hack/prose/messages" as prosemessages;

// git runs commit-msg before it strips comment lines, so they are skipped here.
fun parseSubject(message: str) > str {
    foreach (line in message.split("\n")) {
        if (line.startsWith("#") or line.trim() == "") { continue; }
        return line.trim();
    }
    return "";
}

// vcs\ref raises on an unborn branch, and a repository's first commit is on one. A
// detached HEAD names no branch.
fun currentBranch() > str !> any {
    final ref = vcs\ref() catch vcs\cmd(["symbolic-ref", "--quiet", "--short", "HEAD"],
        opts: {"quiet": true, "allow_failure": true}).stdout.trim();
    return ref ?? "";
}

fun main(args: [str]) > void !> any {
    if (args.len() != 1) {
        throw "commit-msg: want the message file git passes, got {args.len()} argument(s)";
    }
    final message = fs\readFile(args[0]);
    final subject = parseSubject(message);
    if (subject == "" or prosemessages\exempt(subject)) { return; }
    final problems = mut [<str>];
    final base = vcs\base();
    if (commits\onBase(currentBranch(), base: base)) {
        final problem = commits\baseProblem(subject);
        if (problem != "") {
            problems.append("commits on {commits\branchName(base)} land as written, so the subject must be a "
                + "conventional commit, as pull request titles are.\n  \"{subject}\": {problem}");
        }
    }
    if (prosevale\available()) {
        final doc = prosemessages\commitDocument(message, label: "commit message");
        final judged = prosemessages\judge(vcs\root() + "/.magus/prose", docs: {"COMMIT_EDITMSG.commit": doc},
            vale: prosevale\run);
        foreach (f in judged.blocking) {
            problems.append(prosevale\render(f));
        }
    } else {
        io\stderr.write("commit-msg: vale is not on PATH, so the brevity rules did not run; `mise install` provides it.\n") catch void;
    }
    if (problems.len() == 0) { return; }
    io\stderr.write("commit-msg:\n  " + problems.join("\n  ") + "\n") catch void;
    os\exit(1);
}
