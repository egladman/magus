namespace bootstrapworktree;

import "encoding/json";
import "flags";
import "fs";
import "path";
import "proc";
import "std";
import "vcs";

import "assert";

final USAGE = "usage: magus buzz hack/dev/bootstrap-worktree.buzz -- (--job <id> [--from <checkout>] | --check --from <checkout>)";
final HELP = "cost: a Go build of ./magus and a graph build, about two minutes cold; with --from an eligible binary is copied instead, in seconds\n{USAGE}\n\n"
    + "Makes a fresh worktree of this repository usable for the worker holding <id>: builds ./magus with the magus on\n"
    + "PATH, refreshes the wired harness skills, builds the graph, takes the job's lease, then refuses unless the row names this worktree as its checkout\n"
    + "and the base it recorded matches the row's checkpoint. Writes ./magus, the graph, harness skills and the job row.\n\n"
    + "--from <checkout> reuses that checkout's ./magus instead of building, only when it is provably the binary this\n"
    + "worktree would build: built at this worktree's HEAD, and no path the workspace declares a source of project .\n"
    + "differs from that commit, neither in the uncommitted changes it was built from nor in this worktree. Anything\n"
    + "else refuses with the reason. --check prints that verdict and writes nothing.";
final MODULE = "module github.com/egladman/magus";

// Row is what bootstrap reads back from `./magus describe job <id> -o json`.
export object Row {
    id: str,
    state: str,
    checkpoint: str,
    reportedBase: str,
    baseVerdict: str,
    checkoutRoot: str,
}

export fun parseRow(described: str) > Row !> any {
    final j = json\parse(described)["job"] ?? {<str: any>};
    return Row{
        id = j["id"] ?? "",
        state = j["state"] ?? "",
        checkpoint = j["checkpoint"] ?? "",
        reportedBase = j["reported_base"] ?? "",
        baseVerdict = j["base_verdict"] ?? "",
        checkoutRoot = j["checkout_root"] ?? "",
    };
}

// BuildFacts is what `magus version -o json` says about how a binary was built: the commit,
// and whether uncommitted changes went into it.
export object BuildFacts {
    commit: str,
    dirty: bool,
}

export fun parseBuild(versionJSON: str) > BuildFacts !> any {
    final j = json\parse(versionJSON);
    final version: str = j["version"] ?? "";
    return BuildFacts{ commit = j["commit"] ?? "", dirty = version.endsWith("-dirty") };
}

// buildInputs is the paths in a `magus describe file -o json` report that the workspace
// declares as sources of project ".", the project go-build compiles. A change to one is a
// change to the binary, so a binary built without it is not this tree's.
export fun buildInputs(described: str) > [str] !> any {
    final inputs = mut [<str>];
    final files: [any] = json\parse(described)["files"] ?? [<any>];
    foreach (f in files) {
        final claims: [any] = f["claims"] ?? [<any>];
        var input = false;
        foreach (c in claims) {
            if (c["project"] == "." and c["target"] == null and c["role"] == "source") {
                input = true;
            }
        }
        if (input) {
            inputs.append(f["path"] ?? "");
        }
    }
    return inputs;
}

// raiseAll raises every reason as one error, one per line, and returns when there are none.
fun raiseAll(reasons: [str]) > void !> str {
    if (reasons.len() > 0) {
        throw reasons.join("\n  ");
    }
}

// checkReusable raises with every reason a binary with build is not the one a build in this
// worktree would produce. rootRev and sourceRev are the HEADs of this worktree and of the
// checkout holding the binary; the inputs are the declared build inputs that differ from
// build.commit in each.
export fun checkReusable(build: BuildFacts, rootRev: str, sourceRev: str, sourceInputs: [str], rootInputs: [str]) > void !> str {
    if (build.commit == "") {
        throw "it reports no commit, so nothing ties it to a tree";
    }
    final found = mut [<str>];
    if (!rootRev.startsWith(build.commit)) {
        found.append("it was built at {build.commit} and this worktree is at {rootRev}");
    }
    if (build.dirty and !sourceRev.startsWith(build.commit)) {
        found.append("it was built from uncommitted changes at {build.commit}, and its checkout has since moved to {sourceRev}, so what went into it is unknown");
    }
    if (build.dirty and sourceInputs.len() > 0) {
        found.append("it was built with {sourceInputs.len()} build input(s) changed from {build.commit}, first {sourceInputs[0]}");
    }
    if (rootInputs.len() > 0) {
        found.append("this worktree changes {rootInputs.len()} build input(s) from {rootRev}, first {rootInputs[0]}");
    }
    raiseAll(found);
}

// mainWorktree is the first stanza of `git worktree list --porcelain`, the checkout every
// other worktree hangs off.
export fun mainWorktree(porcelain: str) > str {
    foreach (line in porcelain.split("\n")) {
        if (line.startsWith("worktree ")) {
            return line.sub(9);
        }
    }
    return "";
}

// checkFit raises with every way the taken lease is unfit for a worker in root. A row with no
// checkpoint cannot be checked for its base, which render reports rather than refuses: there
// is nothing to compare against. trackedClean is whether root's tracked files match its HEAD:
// job exec digests a tree holding only untracked files as a dirty patch of nothing,
// revision-match, which is the checkpoint's tree all the same.
export fun checkFit(row: Row, root: str, main: str, trackedClean: bool) > void !> str {
    final found = mut [<str>];
    if (path\clean(row.checkoutRoot) != path\clean(root)) {
        final where = if (row.checkoutRoot == "") "no checkout" else row.checkoutRoot;
        final why = if (row.checkoutRoot != "" and path\clean(row.checkoutRoot) == path\clean(main))
            " (the main checkout: every write the worker makes here is graded against the wrong tree)" else "";
        found.append("job {row.id} names {where} as its checkout, not {root}{why}; rerun `./magus job exec {row.id}` from {root}");
    }
    final sameTree = row.baseVerdict == "match" or (row.baseVerdict == "revision-match" and trackedClean);
    if (row.checkpoint != "" and !sameTree) {
        found.append("job {row.id} recorded base {row.reportedBase}, verdict {row.baseVerdict}, but its checkpoint is {row.checkpoint}; "
            + "`git switch --detach {row.checkpoint}` (or the row's branch at it), then bootstrap again");
    }
    if (["declared", "running"].indexOf(row.state) == null) {
        found.append("job {row.id} is {row.state}, so nobody may work it; ask whoever declared it");
    }
    raiseAll(found);
}

// checkRepository refuses anything but a secondary worktree of this repository.
fun checkRepository(root: str) > str !> any {
    if (vcs\name() != "git") {
        throw "bootstrap-worktree: makes git worktrees usable, and this checkout is {vcs\name()}";
    }
    final gomod = fs\readFile("{root}/go.mod") catch "";
    if (!gomod.startsWith(MODULE + "\n")) {
        throw "bootstrap-worktree: {root} is not a checkout of magus ({MODULE}); this script builds magus itself";
    }
    final main = mainWorktree(vcs\cmd(["worktree", "list", "--porcelain"], opts: {"dir": root, "quiet": true}).stdout);
    if (path\clean(main) == path\clean(root)) {
        throw "bootstrap-worktree: {root} is the main checkout; a worker gets its own worktree, and building here replaces "
            + "the ./magus every other session in this checkout runs";
    }
    return main;
}

fun magusAt(bin: str, root: str, args: [str]) > str !> any {
    final r = proc\exec(bin, args: args, dir: root, opts: {"quiet": true, "allow_failure": true});
    if (r.code != 0) {
        final said = if (r.stderr.trim() != "") r.stderr.trim() else r.stdout.trim();
        throw "bootstrap-worktree: `{bin} {args.join(" ")}` exited {r.code}:\n{said}";
    }
    return r.stdout;
}

fun headOf(dir: str) > str !> any {
    return vcs\cmd(["rev-parse", "HEAD"], opts: {"dir": dir, "quiet": true}).stdout.trim();
}

// changedInputs is the declared build inputs in root that differ from rev, read with bin.
fun changedInputs(bin: str, root: str, rev: str) > [str] !> any {
    final args = mut ["describe", "file"];
    foreach (p in vcs\changedFiles(rev, dir: root)) {
        args.append(p.value);
    }
    if (args.len() == 2) {
        return [<str>];
    }
    args.append("-o");
    args.append("json");
    return buildInputs(magusAt(bin, root: root, args: args));
}

// reusable returns the binary in source and its build when it is provably root's own build,
// and raises with every reason it is not.
fun reusable(root: str, source: str) > obj{ bin: str, build: BuildFacts } !> any {
    final bin = "{source}/magus";
    if (!fs\isFile(bin)) {
        throw "bootstrap-worktree: {source} holds no ./magus to reuse";
    }
    final build = parseBuild(magusAt(bin, root: source, args: ["version", "-o", "json"]));
    final rootRev = headOf(root);
    final sourceInputs = if (build.dirty) changedInputs(bin, root: source, rev: build.commit) else [<str>];
    final rootInputs = changedInputs(bin, root: root, rev: rootRev);
    try {
        checkReusable(build, rootRev: rootRev, sourceRev: headOf(source), sourceInputs: sourceInputs, rootInputs: rootInputs);
    } catch (e: str) {
        throw "{bin} is not this worktree's build:\n  {e}";
    }
    return .{ bin = bin, build = build };
}

// bootstrap places ./magus in root, refreshes harness skills, builds the graph, takes job, and returns the row as the
// fresh binary reads it back. ./magus is reused from source when that binary is provably
// root's own build, and built with the magus on PATH otherwise. Raises on any step that fails
// and on a row unfit for a worker here, so a caller never starts work on a wrong binding.
export fun bootstrap(root: str, job: str, source: str) > Row !> any {
    final main = checkRepository(root);
    final local = "{root}/magus";
    if (source != "") {
        var v = .{ bin = "", build = BuildFacts{ commit = "", dirty = false } };
        try {
            v = reusable(root, source: source);
        } catch (e: str) {
            throw "bootstrap-worktree: REFUSED to reuse {e}";
        }
        fs\copyFile(v.bin, dst: local);
        fs\chmod(local, mode: 493);
        std\print("reused {v.bin}: built at {v.build.commit}, which {root} is at, with no build input changed on either side");
    } else {
        final onPath = proc\which("magus") catch "";
        if (onPath == "") {
            throw "bootstrap-worktree: no magus on PATH to build ./magus with, and the hooks run that same name: with none "
                + "they exit 127 and the guard is off. Install magus, then bootstrap again";
        }
        magusAt(onPath, root: root, args: ["run", "go-build", "."]);
        if (!fs\isFile(local)) {
            throw "bootstrap-worktree: `magus run go-build .` passed and left no {local}";
        }
        std\print("built {local} with {onPath}");
    }
    // A bound job cannot rewrite the skills that steer it, so refresh every wired
    // harness before job exec takes the lease. Do this before graph build so it
    // indexes the installed skill content when the installer updates it.
    magusAt(local, root: root, args: ["agent", "harness", "install"]);
    std\print("refreshed the wired harness skills");
    magusAt(local, root: root, args: ["graph", "build", "--silent"]);
    std\print("built the graph");
    final took = magusAt(local, root: root, args: ["job", "exec", job]);
    foreach (line in took.split("\n")) {
        if (line.trim() != "") {
            std\print("  {line.trim()}");
        }
    }
    final row = parseRow(magusAt(local, root: root, args: ["describe", "job", job, "-o", "json"]));
    final trackedClean = (vcs\cmd(["diff", "HEAD", "--quiet"], opts: {"dir": root, "quiet": true, "allow_failure": true}).code) == 0;
    try {
        checkFit(row, root: root, main: main, trackedClean: trackedClean);
    } catch (e: str) {
        throw "bootstrap-worktree: REFUSED, job {job} is not fit to work here:\n  {e}";
    }
    return row;
}

export fun render(row: Row, root: str) > [str] {
    var base = "base {row.reportedBase} matches the row's checkpoint";
    if (row.checkpoint == "") {
        base = "base {row.reportedBase} recorded; the row names no checkpoint, so nothing verified it";
    } else if (row.baseVerdict == "revision-match") {
        base = "base {row.checkpoint} is the row's checkpoint; the tree adds only untracked files, which job exec reads as a patch";
    }
    return [
        "took job {row.id} in {root}: checkout verified",
        base,
        "the guard sees this script, not the exec inside it: unless your spawn was titled for {row.id}, run `./magus job exec {row.id}` once so it binds your session",
        "read the terms: ./magus describe job {row.id}",
    ];
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--check"], valued: ["--job", "--from"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "bootstrap-worktree: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final root = vcs\root();
    final source = parsed.values["--from"] ?? "";
    if (parsed.values["--check"] != null) {
        if (source == "") {
            throw "bootstrap-worktree: --check needs --from, the checkout whose ./magus to judge\n{USAGE}";
        }
        var v = .{ bin = "", build = BuildFacts{ commit = "", dirty = false } };
        try {
            v = reusable(root, source: source);
        } catch (e: str) {
            std\print("not reusable: {e}");
            return;
        }
        std\print("reusable: {v.bin} was built at {v.build.commit}, which {root} is at, with no build input changed on either side");
        return;
    }
    final job = parsed.values["--job"] ?? "";
    if (job == "") {
        throw "bootstrap-worktree: --job is required: the lease is the point of a worker's worktree\n{USAGE}";
    }
    foreach (line in render(bootstrap(root, job: job, source: source), root: root)) {
        std\print(line);
    }
}

final WT = "/work/magus/.claude/worktrees/w1";
final MAIN = "/work/magus";

fun fixture(name: str) > Row !> any {
    return parseRow(fs\readFile("hack/testdata/{name}"));
}

// fitReasons is each reason checkFit raised, empty when the row is fit.
fun fitReasons(row: Row, root: str, main: str, trackedClean: bool) > [str] {
    try {
        checkFit(row, root: root, main: main, trackedClean: trackedClean);
    } catch (e: str) {
        return e.split("\n  ");
    }
    return [<str>];
}

// reuseReasons is each reason checkReusable raised, empty when the binary is reusable.
fun reuseReasons(build: BuildFacts, rootRev: str, sourceRev: str, sourceInputs: [str], rootInputs: [str]) > [str] {
    try {
        checkReusable(build, rootRev: rootRev, sourceRev: sourceRev, sourceInputs: sourceInputs, rootInputs: rootInputs);
    } catch (e: str) {
        return e.split("\n  ");
    }
    return [<str>];
}

test "a row taken here at its checkpoint is fit" {
    final row = fixture("bootstrap-match.json");
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "fit");
    assert\equal(render(row, root: WT)[1], want: "base 7472f16fc709ab3827cd38ff281fecc0a217ca88 matches the row's checkpoint", message: "base line");
}

test "a row bound to the main checkout is refused, naming it" {
    assert\equal(fitReasons(fixture("bootstrap-main.json"), root: WT, main: MAIN, trackedClean: true), want: [
        "job agent-scripts names /work/magus as its checkout, not /work/magus/.claude/worktrees/w1 (the main checkout: every write the worker makes here is graded against the wrong tree); rerun `./magus job exec agent-scripts` from /work/magus/.claude/worktrees/w1",
    ], message: "main");
}

test "a diverged base is refused with the checkpoint to switch to" {
    assert\equal(fitReasons(fixture("bootstrap-diverged.json"), root: WT, main: MAIN, trackedClean: true), want: [
        "job agent-scripts recorded base 1111111111111111111111111111111111111111, verdict diverged, but its checkpoint is 7472f16fc709ab3827cd38ff281fecc0a217ca88; `git switch --detach 7472f16fc709ab3827cd38ff281fecc0a217ca88` (or the row's branch at it), then bootstrap again",
    ], message: "diverged");
}

test "a row with no checkpoint passes and says nothing verified its base" {
    final row = Row{ id = "j", state = "declared", checkpoint = "", reportedBase = "abc", baseVerdict = "unknown", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "fit");
    assert\equal(render(row, root: WT)[1], want: "base abc recorded; the row names no checkpoint, so nothing verified it", message: "note");
}

test "an ended job is refused" {
    final row = Row{ id = "j", state = "pass", checkpoint = "", reportedBase = "", baseVerdict = "", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: ["job j is pass, so nobody may work it; ask whoever declared it"], message: "ended");
}

test "revision-match passes only while the tracked files are the checkpoint's" {
    final row = Row{ id = "j", state = "declared", checkpoint = "abc", reportedBase = "abc+e3b0", baseVerdict = "revision-match", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "untracked only");
    assert\equal(render(row, root: WT)[1], want: "base abc is the row's checkpoint; the tree adds only untracked files, which job exec reads as a patch", message: "note");
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: false).len(), want: 1, message: "tracked edits");
}

test "a binary is this worktree's build only at its HEAD with no build input changed" {
    final clean = BuildFacts{ commit = "166d3dabd", dirty = false };
    assert\equal(reuseReasons(clean, rootRev: "166d3dabd7d7", sourceRev: "aaaa", sourceInputs: [<str>], rootInputs: [<str>]), want: [<str>], message: "clean at HEAD");
    assert\equal(reuseReasons(clean, rootRev: "1111111", sourceRev: "aaaa", sourceInputs: [<str>], rootInputs: [<str>]),
        want: ["it was built at 166d3dabd and this worktree is at 1111111"], message: "another commit");
    assert\equal(reuseReasons(clean, rootRev: "166d3dabd7d7", sourceRev: "aaaa", sourceInputs: [<str>], rootInputs: ["run.go"]),
        want: ["this worktree changes 1 build input(s) from 166d3dabd7d7, first run.go"], message: "worktree edits");
    final dirty = BuildFacts{ commit = "166d3dabd", dirty = true };
    assert\equal(reuseReasons(dirty, rootRev: "166d3dabd7d7", sourceRev: "166d3dabd7d7", sourceInputs: [<str>], rootInputs: [<str>]),
        want: [<str>], message: "dirty only outside the build inputs");
    assert\equal(reuseReasons(dirty, rootRev: "166d3dabd7d7", sourceRev: "166d3dabd7d7", sourceInputs: ["symbol.go"], rootInputs: [<str>]),
        want: ["it was built with 1 build input(s) changed from 166d3dabd, first symbol.go"], message: "dirty inputs");
    assert\equal(reuseReasons(dirty, rootRev: "166d3dabd7d7", sourceRev: "2222222", sourceInputs: [<str>], rootInputs: [<str>]).len(),
        want: 1, message: "a dirty build whose checkout moved on is unknown");
    assert\equal(reuseReasons(BuildFacts{ commit = "", dirty = false }, rootRev: "x", sourceRev: "x", sourceInputs: [<str>], rootInputs: [<str>]),
        want: ["it reports no commit, so nothing ties it to a tree"], message: "no commit");
}

test "a build input is a declared source of project ." {
    final described = "\{\"files\":[\{\"path\":\"run.go\",\"claims\":[\{\"project\":\".\",\"target\":null,\"role\":\"source\"}]},"
        + "\{\"path\":\".gitattributes\",\"claims\":[]},"
        + "\{\"path\":\"docs/guides/jobs.md\",\"claims\":[\{\"project\":\"docs\",\"target\":null,\"role\":\"source\"},\{\"project\":\".\",\"target\":\"lint\",\"role\":\"source\"}]}]}";
    assert\equal(buildInputs(described), want: ["run.go"], message: "only project . sources");
    assert\equal(parseBuild("\{\"version\":\"v0.4.3-485-g166d3dabd-dirty\",\"commit\":\"166d3dabd\"}"), want: BuildFacts{ commit = "166d3dabd", dirty = true }, message: "dirty build");
}

test "the main worktree is the porcelain's first stanza" {
    assert\equal(mainWorktree("worktree /work/magus\nHEAD 1\nbranch refs/heads/main\n\nworktree /work/magus/.claude/worktrees/w1\nHEAD 2\ndetached\n"),
        want: "/work/magus", message: "main");
}
