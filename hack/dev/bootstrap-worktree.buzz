namespace bootstrapworktree;

import "encoding/json";
import "env";
import "flags";
import "fs";
import "path";
import "proc";
import "std";
import "vcs";

import "assert";

final SUMMARY = "place ./magus and a lease in a job's worktree";
final SERVES = ["rule:stale-binary"];

final USAGE = "usage: magus buzz hack/dev/bootstrap-worktree.buzz -- (--job <id> [--from <checkout> | --build-from <checkout>] | --check --from <checkout>)";
final HELP = "cost: a binary copy, a graph build and a lease, in seconds; this script compiles magus only under --build-from\n{USAGE}\n\n"
    + "Makes a fresh worktree of this repository usable for the worker holding <id>: places the root checkout's ./magus\n"
    + "(the main checkout, or the one --from names), refreshes the wired harness skills, takes the job's lease, refuses\n"
    + "unless the row names this worktree as its checkout and the base it recorded matches the row's checkpoint, and builds\n"
    + "the graph last. The lease comes first so an edit made while the graph builds lands after the base is recorded. A\n"
    + "graph build that fails prints a line naming `./magus graph build` and does not fail the bootstrap. The last line\n"
    + "printed says the worktree is ready: act on that line, never on partial output. Writes ./magus, harness skills,\n"
    + "the job row and the graph.\n\n"
    + "The orchestrator builds one ./magus per base commit, in the root, and every worker checkout receives a copy. A copy is\n"
    + "placed only when it is provably the binary this worktree would build: go-build stamps it with a digest of its Go\n"
    + "build inputs (each file `go list -deps ./cmd/magus` compiles or embeds, and the root go.mod, go.sum or go.work), and\n"
    + "that digest must be this worktree's. Docs, console, tests, a package nothing links and a separate module such as\n"
    + "libs/embed/train do not count, so a base commit later than the binary's usually qualifies, and so does a binary built\n"
    + "from uncommitted changes. Otherwise the script refuses and names what to build in the root.\n"
    + "--build-from <checkout> is --from after building: it runs `<checkout>/magus --root <checkout> run go-build .` first, then\n"
    + "judges that binary the same way. A session holding a job lease is refused, since a worker never compiles magus.\n"
    + "--check prints that verdict and writes nothing.";
final MODULE = "module github.com/egladman/magus";

// Row is what bootstrap reads back from `./magus describe job <id> -o json`.
export object Row {
    id: str,
    state: str,
    checkpoint: str,
    reportedBase: str,
    baseVerdict: str,
    checkoutRoot: str,
}

export fun parseRow(described: str) > Row !> any {
    final j = json\parse(described)["job"] ?? {<str: any>};
    return Row{
        id = j["id"] ?? "",
        state = j["state"] ?? "",
        checkpoint = j["checkpoint"] ?? "",
        reportedBase = j["reported_base"] ?? "",
        baseVerdict = j["base_verdict"] ?? "",
        checkoutRoot = j["checkout_root"] ?? "",
    };
}


// raiseAll raises every reason as one error, one per line, and returns when there are none.
fun raiseAll(reasons: [str]) > void !> str {
    if (reasons.len() > 0) {
        throw reasons.join("\n  ");
    }
}

// checkReusable raises unless stamped, the Go input digest go-build linked into a binary, is
// digest, this worktree's. The worktree may sit at any commit, and the binary may have been
// built from uncommitted changes: equal inputs build the same binary either way.
export fun checkReusable(stamped: str, digest: str) > void !> str {
    if (stamped == "") {
        throw "it carries no Go input digest: a bare `go build` linked it, or a go-build from before the digest";
    }
    if (stamped != digest) {
        throw "its Go build inputs (digest {stamped}) differ from this worktree's ({digest})";
    }
}

// digestProbe prints two lines: the Go input digest stamped into the magus running it, then
// root's. It runs in the binary's own checkout, so the digest it computes is the definition
// that stamped the binary. hack/policy/stale.buzz holds both, and this script cannot import
// it: the policy parses under the --embedded rules and a script under the strict ones.
export fun digestProbe(root: str) > str {
    return `import "std"; import "magus"; import "./hack/policy/stale" as stale; `
        + `fun main(args: [str]) > void !> any \{ std\print(stale\stampedInputs(magus\guard.binary().stamp)); `
        + "std\\print(stale\\goInputsDigest(`" + root + "`)); }";
}

// mainWorktree is the first stanza of `git worktree list --porcelain`, the checkout every
// other worktree hangs off.
export fun mainWorktree(porcelain: str) > str {
    foreach (line in porcelain.split("\n")) {
        if (line.startsWith("worktree ")) {
            return line.sub(9);
        }
    }
    return "";
}

// needsDetach is whether the recorded base diverged from the checkpoint on a tree with no
// tracked edits, where moving onto the checkpoint loses nothing.
export fun needsDetach(row: Row, trackedClean: bool) > bool {
    final sameTree = row.baseVerdict == "match" or (row.baseVerdict == "revision-match" and trackedClean);
    return row.checkpoint != "" and !sameTree and trackedClean;
}

// checkFit raises with every way the taken lease is unfit for a worker in root. A row with no
// checkpoint cannot be checked for its base, which render reports rather than refuses: there
// is nothing to compare against. trackedClean is whether root's tracked files match its HEAD:
// job exec digests a tree holding only untracked files as a dirty patch of nothing,
// revision-match, which is the checkpoint's tree all the same.
export fun checkFit(row: Row, root: str, main: str, trackedClean: bool) > void !> str {
    final found = mut [<str>];
    if (path\clean(row.checkoutRoot) != path\clean(root)) {
        final where = if (row.checkoutRoot == "") "no checkout" else row.checkoutRoot;
        final why = if (row.checkoutRoot != "" and path\clean(row.checkoutRoot) == path\clean(main))
            " (the main checkout: every write the worker makes here is graded against the wrong tree)" else "";
        found.append("job {row.id} names {where} as its checkout, not {root}{why}; rerun `./magus job exec {row.id}` from {root}");
    }
    final sameTree = row.baseVerdict == "match" or (row.baseVerdict == "revision-match" and trackedClean);
    if (row.checkpoint != "" and !sameTree) {
        found.append("job {row.id} recorded base {row.reportedBase}, verdict {row.baseVerdict}, but its checkpoint is {row.checkpoint}; "
            + "`git switch --detach {row.checkpoint}` (or the row's branch at it), then bootstrap again");
    }
    if (["declared", "running"].indexOf(row.state) == null) {
        found.append("job {row.id} is {row.state}, so nobody may work it; ask whoever declared it");
    }
    raiseAll(found);
}

// checkRepository refuses anything but a secondary worktree of this repository.
fun checkRepository(root: str) > str !> any {
    if (vcs\name() != "git") {
        throw "bootstrap-worktree: makes git worktrees usable, and this checkout is {vcs\name()}";
    }
    final gomod = fs\readFile("{root}/go.mod") catch "";
    if (!gomod.startsWith(MODULE + "\n")) {
        throw "bootstrap-worktree: {root} is not a checkout of magus ({MODULE}); this script places magus's own binary";
    }
    final main = mainWorktree(vcs\cmd(["worktree", "list", "--porcelain"], opts: vcs\CommandOptions{ dir = root, quiet = true }).stdout);
    if (path\clean(main) == path\clean(root)) {
        throw "bootstrap-worktree: {root} is the main checkout; a worker gets its own worktree, and placing here replaces "
            + "the ./magus every other session in this checkout runs";
    }
    return main;
}

fun magusAt(bin: str, root: str, args: [str]) > str !> any {
    final r = proc\exec(bin, args: args, dir: root, opts: proc\ExecOptions{ quiet = true, allowFailure = true });
    if (r.code != 0) {
        throw "bootstrap-worktree: `{bin} {args.join(" ")}` failed: {failureCause(r.code, stdout: r.stdout, stderr: r.stderr)}";
    }
    return r.stdout;
}

// failureCause is what a failed command said, or, when it said nothing, how it ended.
export fun failureCause(code: int, stdout: str, stderr: str) > str {
    final said = if (stderr.trim() != "") stderr.trim() else stdout.trim();
    if (said != "") {
        return "exit {code}:\n{said}";
    }
    if (code == -1) {
        return "it never started, or was killed, and printed nothing";
    }
    return "exit {code}, and it printed nothing";
}

// reusable returns the binary in source and root's Go input digest when the binary's stamp
// records that digest, and raises naming why it is not root's build otherwise.
fun reusable(root: str, source: str) > obj{ bin: str, digest: str } !> any {
    final bin = "{source}/magus";
    if (!fs\isFile(bin)) {
        throw "bootstrap-worktree: {source} holds no ./magus to place";
    }
    var probed = "";
    try {
        probed = magusAt(bin, root: source, args: ["buzz", "-e", digestProbe(root)]);
    } catch (e: str) {
        throw "{bin} is not this worktree's build:\n  {source} cannot compute a Go input digest, so it predates go-build stamping one: {e}";
    }
    final said = probed.trim().split("\n");
    final stamped = if (said.len() == 2) said[0].trim() else "";
    final digest = said[said.len() - 1].trim();
    try {
        checkReusable(stamped, digest: digest);
    } catch (e: str) {
        throw "{bin} is not this worktree's build:\n  {e}";
    }
    return .{ bin = bin, digest = digest };
}

// placed says what bootstrap did with the binary, for stdout.
export fun placed(bin: str, digest: str) > str {
    return "{bin} was built from this worktree's Go build inputs (digest {digest})";
}

// syncHarnesses merges the wired harnesses' host config through hack/dev/bootstrap-harnesses.buzz and
// returns what it printed. A leased session skips it, as it does the skill install.
export fun syncHarnesses(run: fun (args: [str]) > str !> any, lease: str) > str !> any {
    if (lease != "") {
        return "skipped the harness config sync; this session holds the lease `{lease}`";
    }
    return run(["buzz", "hack/dev/bootstrap-harnesses.buzz"]).trim();
}

// refusal is the error for a source with no placeable binary: what the orchestrator builds, once, in the root.
export fun refusal(why: str, source: str) > str {
    return "bootstrap-worktree: REFUSED to place {why}\n"
        + "A worker checkout never compiles magus. The orchestrator builds ./magus once for this base, in {source} "
        + "(`{source}/magus --root {source} run go-build .`), then reruns this with `--from {source}`. "
        + "Or a session holding no lease does both: rerun this with `--build-from {source}`; a leased worker asks the main session to.";
}

// leaseOf is the job named by a W3C baggage header's magus.lease entry, "" when it holds none.
export fun leaseOf(baggage: str) > str {
    foreach (entry in baggage.split(",")) {
        final pair = entry.trim();
        if (pair.startsWith("magus.lease=")) {
            return pair.sub("magus.lease=".len());
        }
    }
    return "";
}

// buildArgs is the go-build run in source that --build-from makes before it judges the binary.
export fun buildArgs(source: str) > [str] {
    return ["--root", source, "run", "go-build", "."];
}

// buildRefusal is what a leased worker is told for --build-from: it never compiles magus.
export fun buildRefusal(lease: str, source: str) > str {
    return "bootstrap-worktree: --build-from compiles magus, and this session holds the lease `{lease}`; a worker never compiles magus\n"
        + "Ask the main session to run `<main checkout>/magus buzz hack/dev/bootstrap-worktree.buzz -- --job {lease} --build-from {source}`, "
        + "or to place a built binary with `--from {source}`.";
}

// buildFrom compiles magus in source with the checkout's own ./magus, so the go-build target stamps it.
fun buildFrom(source: str) > void !> any {
    final bin = "{source}/magus";
    if (!fs\isFile(bin)) {
        throw "bootstrap-worktree: {source} holds no ./magus to build with; `GOEXPERIMENT=jsonv2 go -C {source} run -trimpath ./cmd/magus run go-build --no-cache .` makes the first one";
    }
    proc\exec(bin, args: buildArgs(source));
}

// bootstrap places ./magus in root, refreshes harness skills, takes job, checks the row fits, builds the graph, and
// returns the row as the fresh binary reads it back. ./magus is copied from source, the main checkout when source is "",
// and only when that binary is provably root's own build; otherwise it raises, since a worker
// checkout never compiles magus. Raises on any step that fails and on a row unfit for a worker
// here, so a caller never starts work on a wrong binding. The graph build runs last, after the
// lease records the base on a clean tree; its failure is printed, not raised.
export fun bootstrap(root: str, job: str, source: str) > Row !> any {
    final main = checkRepository(root);
    final origin = if (source == "") main else source;
    final local = "{root}/magus";
    var v = .{ bin = "", digest = "" };
    try {
        v = reusable(root, source: origin);
    } catch (e: str) {
        throw refusal(e, source: origin);
    }
    // Copy beside it, then rename over it: a copy truncates ./magus in place, and this script
    // is often running from that file (magus re-execs into a workspace's own ./magus). On
    // darwin every later exec of an executable rewritten in place is SIGKILLed.
    fs\copyFile(v.bin, dst: "{local}.bootstrap");
    fs\chmod("{local}.bootstrap", mode: 493);
    fs\rename("{local}.bootstrap", dst: local);
    std\print("placed " + placed(v.bin, digest: v.digest));
    final lease = leaseOf(env\getOr("BAGGAGE", def: "") catch "");
    final runLocal = fun (args: [str]) > str !> any => magusAt(local, root: root, args: args);
    std\print(refreshSkills(runLocal, lease: lease));
    std\print(syncHarnesses(runLocal, lease: lease));
    return claimThenIndex(
        fun (args: [str]) > str !> any => magusAt(local, root: root, args: args),
        root: root,
        job: job,
        main: main,
        trackedClean: fun () > bool !> any => (vcs\cmd(["diff", "HEAD", "--quiet"], opts: vcs\CommandOptions{ dir = root, quiet = true, allowFailure = true }).code) == 0,
        detach: fun (checkpoint: str) > void !> any {
            vcs\cmd(["switch", "--detach", checkpoint], opts: vcs\CommandOptions{ dir = root, quiet = true });
        },
    );
}

// refreshSkills refreshes every wired harness's skills and returns the line to print. A bound job
// cannot rewrite the skills that steer it ("bound job cannot change a harness skill tree"), so a
// session already under a lease skips the install.
export fun refreshSkills(run: fun (args: [str]) > str !> any, lease: str) > str !> any {
    if (lease != "") {
        return "skipped the harness skill install; this session holds the lease `{lease}`, and a bound job cannot change a harness skill tree";
    }
    run(["agent", "harness", "install"]);
    return "refreshed the wired harness skills";
}

// claimThenIndex takes the job's lease, refuses a row unfit for root, and only then builds the
// graph: the lease records the base, so an edit made while the graph builds lands after it.
// run executes a magus subcommand and returns its output.
export fun claimThenIndex(run: fun (args: [str]) > str !> any, root: str, job: str, main: str, trackedClean: fun () > bool !> any, detach: fun (checkpoint: str) > void !> any) > Row !> any {
    final took = run(["job", "exec", job]);
    foreach (line in took.split("\n")) {
        if (line.trim() != "") {
            std\print("  {line.trim()}");
        }
    }
    var row = parseRow(run(["describe", "job", job, "-o", "json"]));
    if (needsDetach(row, trackedClean: trackedClean())) {
        detach(row.checkpoint);
        std\print("detached onto the checkpoint {row.checkpoint}; the base had diverged and the tracked files were clean");
        run(["job", "exec", job]);
        row = parseRow(run(["describe", "job", job, "-o", "json"]));
    }
    try {
        checkFit(row, root: root, main: main, trackedClean: trackedClean());
    } catch (e: str) {
        throw "bootstrap-worktree: REFUSED, job {job} is not fit to work here:\n  {e}";
    }
    try {
        run(["graph", "build", "--silent"]);
        std\print("built the graph");
    } catch (e: str) {
        std\print(graphBuildFailed(e));
    }
    return row;
}

// graphBuildFailed is the line printed when the graph build fails after the lease is taken: the
// job is bound and usable, only the graph is cold.
export fun graphBuildFailed(cause: str) > str {
    return "the graph did not build; the lease is taken and the worktree works, but run `./magus graph build` before querying: {cause}";
}

// readyLine is the last line the bootstrap prints.
export fun readyLine(row: Row, root: str) > str {
    return "ready: job {row.id} is taken in {root}; setup is finished and edits may begin";
}

export fun render(row: Row, root: str) > [str] {
    var base = "base {row.reportedBase} matches the row's checkpoint";
    if (row.checkpoint == "") {
        base = "base {row.reportedBase} recorded; the row names no checkpoint, so nothing verified it";
    } else if (row.baseVerdict == "revision-match") {
        base = "base {row.checkpoint} is the row's checkpoint; the tree adds only untracked files, which job exec reads as a patch";
    }
    return [
        "took job {row.id} in {root}: checkout verified",
        base,
        "the guard sees this script, not the exec inside it: unless your spawn was titled for {row.id}, run `./magus job exec {row.id}` once so it binds your session",
        "read the terms: ./magus describe job {row.id}",
    ];
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--check"], valued: ["--job", "--from", "--build-from"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "bootstrap-worktree: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final root = vcs\root();
    var source = parsed.values["--from"] ?? "";
    final built = parsed.values["--build-from"] ?? "";
    if (built != "") {
        if (source != "" and source != built) {
            throw "bootstrap-worktree: --from and --build-from name different checkouts\n{USAGE}";
        }
        final lease = leaseOf(env\getOr("BAGGAGE", def: "") catch "");
        if (lease != "") {
            throw buildRefusal(lease, source: built);
        }
        source = built;
        if (parsed.values["--check"] != null) {
            throw "bootstrap-worktree: --check writes nothing, so it cannot build; use --from\n{USAGE}";
        }
        buildFrom(source);
    }
    if (parsed.values["--check"] != null) {
        if (source == "") {
            throw "bootstrap-worktree: --check needs --from, the checkout whose ./magus to judge\n{USAGE}";
        }
        var v = .{ bin = "", digest = "" };
        try {
            v = reusable(root, source: source);
        } catch (e: str) {
            std\print("not placeable: {e}");
            return;
        }
        std\print("placeable: " + placed(v.bin, digest: v.digest));
        return;
    }
    final job = parsed.values["--job"] ?? "";
    if (job == "") {
        throw "bootstrap-worktree: --job is required: the lease is the point of a worker's worktree\n{USAGE}";
    }
    final row = bootstrap(root, job: job, source: source);
    foreach (line in render(row, root: root)) {
        std\print(line);
    }
    std\print(readyLine(row, root: root));
}

final WT = "/work/magus/.claude/worktrees/w1";
final MAIN = "/work/magus";

fun fixture(name: str) > Row !> any {
    return parseRow(fs\readFile("hack/testdata/{name}"));
}

// fitReasons is each reason checkFit raised, empty when the row is fit.
fun fitReasons(row: Row, root: str, main: str, trackedClean: bool) > [str] {
    try {
        checkFit(row, root: root, main: main, trackedClean: trackedClean);
    } catch (e: str) {
        return e.split("\n  ");
    }
    return [<str>];
}

// reuseReason is what checkReusable raised, "" when the binary is reusable.
fun reuseReason(stamped: str, digest: str) > str {
    try {
        checkReusable(stamped, digest: digest);
    } catch (e: str) {
        return e;
    }
    return "";
}

test "a row taken here at its checkpoint is fit" {
    final row = fixture("bootstrap-match.json");
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "fit");
    assert\equal(render(row, root: WT)[1], want: "base 7472f16fc709ab3827cd38ff281fecc0a217ca88 matches the row's checkpoint", message: "base line");
}

test "a row bound to the main checkout is refused, naming it" {
    assert\equal(fitReasons(fixture("bootstrap-main.json"), root: WT, main: MAIN, trackedClean: true), want: [
        "job agent-scripts names /work/magus as its checkout, not /work/magus/.claude/worktrees/w1 (the main checkout: every write the worker makes here is graded against the wrong tree); rerun `./magus job exec agent-scripts` from /work/magus/.claude/worktrees/w1",
    ], message: "main");
}

test "bootstrap names the graph build as the fix when it fails after the lease" {
    final line = graphBuildFailed("exit 1:\nMGS3009");
    assert\equal(line.indexOf("`./magus graph build`") != null, want: true, message: "names the command");
    assert\equal(line.indexOf("lease is taken") != null, want: true, message: "says the lease held");
    assert\equal(line.indexOf("MGS3009") != null, want: true, message: "keeps the cause");
}

test "bootstrap ends on a line that says the worktree is ready" {
    final row = fixture("bootstrap-match.json");
    assert\equal(readyLine(row, root: WT), want: "ready: job {row.id} is taken in {WT}; setup is finished and edits may begin", message: "ready");
}

test "a diverged base is refused with the checkpoint to switch to" {
    assert\equal(fitReasons(fixture("bootstrap-diverged.json"), root: WT, main: MAIN, trackedClean: true), want: [
        "job agent-scripts recorded base 1111111111111111111111111111111111111111, verdict diverged, but its checkpoint is 7472f16fc709ab3827cd38ff281fecc0a217ca88; `git switch --detach 7472f16fc709ab3827cd38ff281fecc0a217ca88` (or the row's branch at it), then bootstrap again",
    ], message: "diverged");
}

test "a row with no checkpoint passes and says nothing verified its base" {
    final row = Row{ id = "j", state = "declared", checkpoint = "", reportedBase = "abc", baseVerdict = "unknown", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "fit");
    assert\equal(render(row, root: WT)[1], want: "base abc recorded; the row names no checkpoint, so nothing verified it", message: "note");
}

test "the harness skill install is skipped under a lease and run without one" {
    final ran = mut [<str>];
    final run = fun (args: [str]) > str !> any {
        ran.append(args.join(" "));
        return "";
    };
    refreshSkills(run, lease: "policy-bootstrap");
    assert\equal(ran.len(), want: 0, message: "no install under a lease");
    assert\equal(refreshSkills(run, lease: ""), want: "refreshed the wired harness skills", message: "line without a lease");
    assert\equal(ran.join("|"), want: "agent harness install", message: "install without a lease");
}

test "the harness config sync is skipped under a lease and run without one" {
    final ran = mut [<str>];
    final run = fun (args: [str]) > str !> any {
        ran.append(args.join(" "));
        return "no change\n";
    };
    assert\equal(syncHarnesses(run, lease: "policy-bootstrap").startsWith("skipped"), want: true, message: "line under a lease");
    assert\equal(ran.len(), want: 0, message: "no sync under a lease");
    assert\equal(syncHarnesses(run, lease: ""), want: "no change", message: "sync output");
    assert\equal(ran.join("|"), want: "buzz hack/dev/bootstrap-harnesses.buzz", message: "sync without a lease");
}

test "the lease is taken before the graph is built" {
    final described = fs\readFile("hack/testdata/bootstrap-match.json");
    final ran = mut [<str>];
    claimThenIndex(
        fun (args: [str]) > str !> any {
            ran.append(args.join(" "));
            return if (args[0] == "describe") described else "";
        },
        root: "/work/magus/.claude/worktrees/w1",
        job: "agent-scripts",
        main: "/work/magus",
        trackedClean: fun () > bool !> any => true,
        detach: fun (checkpoint: str) > void !> any {
            ran.append("detach " + checkpoint);
        },
    );
    assert\equal(ran.join("|"), want: "job exec agent-scripts|describe job agent-scripts -o json|graph build --silent", message: "step order");
}

test "a diverged clean worktree is detached onto the checkpoint and the lease retaken" {
    final diverged = fs\readFile("hack/testdata/bootstrap-diverged.json");
    final matched = fs\readFile("hack/testdata/bootstrap-match.json");
    final ran = mut [<str>];
    var described = 0;
    final row = claimThenIndex(
        fun (args: [str]) > str !> any {
            ran.append(args.join(" "));
            if (args[0] == "describe") {
                described += 1;
                return if (described == 1) diverged else matched;
            }
            return "";
        },
        root: WT,
        job: "agent-scripts",
        main: MAIN,
        trackedClean: fun () > bool !> any => true,
        detach: fun (checkpoint: str) > void !> any {
            ran.append("detach " + checkpoint);
        },
    );
    assert\equal(row.baseVerdict, want: "match", message: "row read after the retake");
    assert\equal(ran.join("|"), want: "job exec agent-scripts|describe job agent-scripts -o json|detach 7472f16fc709ab3827cd38ff281fecc0a217ca88|job exec agent-scripts|describe job agent-scripts -o json|graph build --silent", message: "step order");
}

test "a diverged worktree with tracked edits is still refused and not detached" {
    final diverged = fs\readFile("hack/testdata/bootstrap-diverged.json");
    final ran = mut [<str>];
    var said = "";
    try {
        claimThenIndex(
            fun (args: [str]) > str !> any {
                ran.append(args.join(" "));
                return if (args[0] == "describe") diverged else "";
            },
            root: WT,
            job: "agent-scripts",
            main: MAIN,
            trackedClean: fun () > bool !> any => false,
            detach: fun (checkpoint: str) > void !> any {
                ran.append("detach " + checkpoint);
            },
        );
    } catch (e: str) {
        said = e;
    }
    assert\equal(said.indexOf("verdict diverged") != null, want: true, message: said);
    assert\equal(ran.indexOf("detach 7472f16fc709ab3827cd38ff281fecc0a217ca88"), want: null, message: "no detach");
}

test "an ended job is refused" {
    final row = Row{ id = "j", state = "pass", checkpoint = "", reportedBase = "", baseVerdict = "", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: ["job j is pass, so nobody may work it; ask whoever declared it"], message: "ended");
}

test "revision-match passes only while the tracked files are the checkpoint's" {
    final row = Row{ id = "j", state = "declared", checkpoint = "abc", reportedBase = "abc+e3b0", baseVerdict = "revision-match", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "untracked only");
    assert\equal(render(row, root: WT)[1], want: "base abc is the row's checkpoint; the tree adds only untracked files, which job exec reads as a patch", message: "note");
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: false).len(), want: 1, message: "tracked edits");
}

test "a binary is this worktree's build while its stamped Go input digest is this worktree's" {
    assert\equal(reuseReason("0123456789abcdef", digest: "0123456789abcdef"), want: "",
        message: "equal inputs, at any commit and from any dirty tree");
    assert\equal(reuseReason("fedcba9876543210", digest: "0123456789abcdef"),
        want: "its Go build inputs (digest fedcba9876543210) differ from this worktree's (0123456789abcdef)", message: "an input moved");
    assert\equal(reuseReason("", digest: "0123456789abcdef"),
        want: "it carries no Go input digest: a bare `go build` linked it, or a go-build from before the digest", message: "no digest");
    assert\equal(placed("/r/magus", digest: "0123456789abcdef"),
        want: "/r/magus was built from this worktree's Go build inputs (digest 0123456789abcdef)", message: "placed");
}

test "the refusal names who builds" {
    assert\equal(refusal("x", source: "/r"), want: "bootstrap-worktree: REFUSED to place x\nA worker checkout never compiles magus. The orchestrator builds ./magus once for this base, in /r (`/r/magus --root /r run go-build .`), then reruns this with `--from /r`. Or a session holding no lease does both: rerun this with `--build-from /r`; a leased worker asks the main session to.", message: "refusal");
}

test "--build-from builds in the source checkout and is refused under a lease, naming who builds" {
    assert\equal(buildArgs("/r"), want: ["--root", "/r", "run", "go-build", "."], message: "the build runs in the source checkout");
    assert\equal(leaseOf("a=b, magus.lease=policy-bootstrap ,c=d"), want: "policy-bootstrap", message: "the lease entry of a baggage header");
    assert\equal(leaseOf("a=b"), want: "", message: "no lease");
    assert\equal(leaseOf(""), want: "", message: "no baggage");
    final refused = buildRefusal("job-a", source: "/r");
    assert\equal(refused.indexOf("a worker never compiles magus") != null and refused.indexOf("--job job-a --build-from /r`") != null, want: true,
        message: "a leased worker is refused and told who builds: " + refused);
}

test "a command killed by a signal names the signal, not exit -1" {
    var said = "";
    try {
        magusAt("/bin/sh", root: ".", args: ["-c", "kill -9 $$"]);
    } catch (e: str) {
        said = e;
    }
    assert\equal(said.startsWith("bootstrap-worktree: `/bin/sh -c kill -9 $$` failed: exit -1:\n"), want: true, message: said);
    assert\equal(said.endsWith("signal: killed"), want: true, message: said);
    assert\equal(failureCause(1, stdout: "", stderr: ""), want: "exit 1, and it printed nothing", message: "silent exit");
    assert\equal(failureCause(2, stdout: "out", stderr: " err\n"), want: "exit 2:\nerr", message: "stderr first");
}

test "the main worktree is the porcelain's first stanza" {
    assert\equal(mainWorktree("worktree /work/magus\nHEAD 1\nbranch refs/heads/main\n\nworktree /work/magus/.claude/worktrees/w1\nHEAD 2\ndetached\n"),
        want: "/work/magus", message: "main");
}
