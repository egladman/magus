namespace bootstrapworktree;

import "encoding/json";
import "flags";
import "fs";
import "path";
import "proc";
import "std";
import "vcs";

import "assert";

final USAGE = "usage: magus buzz hack/dev/bootstrap-worktree.buzz -- (--job <id> [--from <checkout>] | --check --from <checkout>)";
final HELP = "cost: a binary copy, a graph build and a lease, in seconds; this script never compiles magus\n{USAGE}\n\n"
    + "Makes a fresh worktree of this repository usable for the worker holding <id>: places the root checkout's ./magus\n"
    + "(the main checkout, or the one --from names), refreshes the wired harness skills, builds the graph, takes the job's\n"
    + "lease, then refuses unless the row names this worktree as its checkout and the base it recorded matches the row's\n"
    + "checkpoint. Writes ./magus, the graph, harness skills and the job row.\n\n"
    + "The orchestrator builds one ./magus per base commit, in the root, and every worker checkout receives a copy. A copy is\n"
    + "placed only when it is provably the binary this worktree would build: no Go build input (a file under a package\n"
    + "./cmd/magus compiles, or a go.mod, go.sum or go.work) differs between the commit the binary was built at and this\n"
    + "worktree, and none went into it uncommitted. Docs, console and other non-Go changes do not count, so a base commit\n"
    + "later than the binary's usually qualifies. Otherwise the script refuses and names what to build in the root.\n"
    + "--check prints that verdict and writes nothing.";
final MODULE = "module github.com/egladman/magus";

// Row is what bootstrap reads back from `./magus describe job <id> -o json`.
export object Row {
    id: str,
    state: str,
    checkpoint: str,
    reportedBase: str,
    baseVerdict: str,
    checkoutRoot: str,
}

export fun parseRow(described: str) > Row !> any {
    final j = json\parse(described)["job"] ?? {<str: any>};
    return Row{
        id = j["id"] ?? "",
        state = j["state"] ?? "",
        checkpoint = j["checkpoint"] ?? "",
        reportedBase = j["reported_base"] ?? "",
        baseVerdict = j["base_verdict"] ?? "",
        checkoutRoot = j["checkout_root"] ?? "",
    };
}

// BuildFacts is what `magus version -o json` says about how a binary was built: the commit,
// and whether uncommitted changes went into it.
export object BuildFacts {
    commit: str,
    dirty: bool,
}

export fun parseBuild(versionJSON: str) > BuildFacts !> any {
    final j = json\parse(versionJSON);
    final version: str = j["version"] ?? "";
    return BuildFacts{ commit = j["commit"] ?? "", dirty = version.endsWith("-dirty") };
}

// The files that decide the module graph a Go build resolves, wherever they sit.
final MODULE_FILES = ["go.mod", "go.sum", "go.work", "go.work.sum"];

// packageScopes are where a file other than Go source can reach the binary, root-relative:
// "dir/" for everything under a package directory below root, a bare path for one file the
// root package embeds. listed is `go list -deps` output, one package per line as its
// absolute directory then each go:embed file after a "|". A standard-library or module-cache
// directory is not under root and drops out. The root package contributes only its embedded
// files, since a "dir/" for root would take in MAGUS.md and every doc.
export fun packageScopes(listed: str, root: str) > [str] {
    final scopes = mut [<str>];
    final base = path\clean(root);
    foreach (line in listed.split("\n")) {
        if (line.trim() == "") {
            continue;
        }
        final fields = line.trim().split("|");
        final dir = path\clean(fields[0]);
        if (dir == base) {
            foreach (embedded in fields.sub(1)) {
                scopes.append(embedded);
            }
        } else if (dir.startsWith(base + "/")) {
            scopes.append(dir.sub(base.len() + 1) + "/");
        }
    }
    return scopes;
}

// buildInputs are the changed root-relative paths that can change the compiled binary: a
// non-test Go file anywhere, a module file, or a file inside a scope, which is where go:embed
// reads from. The Go file rule keeps a package deleted since the listing counted. A test file
// is not linked in, and docs, console and changelog fragments sit outside every scope.
export fun buildInputs(changed: [str], scopes: [str]) > [str] {
    final inputs = mut [<str>];
    foreach (p in changed) {
        if (isBuildInput(p, scopes: scopes)) {
            inputs.append(p);
        }
    }
    return inputs;
}

fun isBuildInput(p: str, scopes: [str]) > bool {
    final name = fs\basename(p);
    if (MODULE_FILES.indexOf(name) != null) {
        return true;
    }
    if (name.endsWith("_test.go")) {
        return false;
    }
    if (name.endsWith(".go")) {
        return true;
    }
    foreach (s in scopes) {
        if (s == p or (s.endsWith("/") and p.startsWith(s))) {
            return true;
        }
    }
    return false;
}

// raiseAll raises every reason as one error, one per line, and returns when there are none.
fun raiseAll(reasons: [str]) > void !> str {
    if (reasons.len() > 0) {
        throw reasons.join("\n  ");
    }
}

// checkReusable raises with every reason a binary with build is not the one a build in this
// worktree would produce. sourceRev is the HEAD of the checkout holding the binary; the
// inputs are the build inputs that differ from build.commit in that checkout and in this
// worktree. The worktree may sit at any commit: what decides is whether a build input
// differs, not whether the commits are equal.
export fun checkReusable(build: BuildFacts, sourceRev: str, sourceInputs: [str], rootInputs: [str]) > void !> str {
    if (build.commit == "") {
        throw "it reports no commit, so nothing ties it to a tree";
    }
    final found = mut [<str>];
    if (build.dirty and !sourceRev.startsWith(build.commit)) {
        found.append("it was built from uncommitted changes at {build.commit}, and its checkout has since moved to {sourceRev}, so what went into it is unknown");
    }
    if (build.dirty and sourceInputs.len() > 0) {
        found.append("it was built with {sourceInputs.len()} build input(s) changed from {build.commit}, first {sourceInputs[0]}");
    }
    if (rootInputs.len() > 0) {
        found.append("this worktree differs from {build.commit} in {rootInputs.len()} build input(s), first {rootInputs[0]}");
    }
    raiseAll(found);
}

// mainWorktree is the first stanza of `git worktree list --porcelain`, the checkout every
// other worktree hangs off.
export fun mainWorktree(porcelain: str) > str {
    foreach (line in porcelain.split("\n")) {
        if (line.startsWith("worktree ")) {
            return line.sub(9);
        }
    }
    return "";
}

// checkFit raises with every way the taken lease is unfit for a worker in root. A row with no
// checkpoint cannot be checked for its base, which render reports rather than refuses: there
// is nothing to compare against. trackedClean is whether root's tracked files match its HEAD:
// job exec digests a tree holding only untracked files as a dirty patch of nothing,
// revision-match, which is the checkpoint's tree all the same.
export fun checkFit(row: Row, root: str, main: str, trackedClean: bool) > void !> str {
    final found = mut [<str>];
    if (path\clean(row.checkoutRoot) != path\clean(root)) {
        final where = if (row.checkoutRoot == "") "no checkout" else row.checkoutRoot;
        final why = if (row.checkoutRoot != "" and path\clean(row.checkoutRoot) == path\clean(main))
            " (the main checkout: every write the worker makes here is graded against the wrong tree)" else "";
        found.append("job {row.id} names {where} as its checkout, not {root}{why}; rerun `./magus job exec {row.id}` from {root}");
    }
    final sameTree = row.baseVerdict == "match" or (row.baseVerdict == "revision-match" and trackedClean);
    if (row.checkpoint != "" and !sameTree) {
        found.append("job {row.id} recorded base {row.reportedBase}, verdict {row.baseVerdict}, but its checkpoint is {row.checkpoint}; "
            + "`git switch --detach {row.checkpoint}` (or the row's branch at it), then bootstrap again");
    }
    if (["declared", "running"].indexOf(row.state) == null) {
        found.append("job {row.id} is {row.state}, so nobody may work it; ask whoever declared it");
    }
    raiseAll(found);
}

// checkRepository refuses anything but a secondary worktree of this repository.
fun checkRepository(root: str) > str !> any {
    if (vcs\name() != "git") {
        throw "bootstrap-worktree: makes git worktrees usable, and this checkout is {vcs\name()}";
    }
    final gomod = fs\readFile("{root}/go.mod") catch "";
    if (!gomod.startsWith(MODULE + "\n")) {
        throw "bootstrap-worktree: {root} is not a checkout of magus ({MODULE}); this script builds magus itself";
    }
    final main = mainWorktree(vcs\cmd(["worktree", "list", "--porcelain"], opts: {"dir": root, "quiet": true}).stdout);
    if (path\clean(main) == path\clean(root)) {
        throw "bootstrap-worktree: {root} is the main checkout; a worker gets its own worktree, and building here replaces "
            + "the ./magus every other session in this checkout runs";
    }
    return main;
}

fun magusAt(bin: str, root: str, args: [str]) > str !> any {
    final r = proc\exec(bin, args: args, dir: root, opts: {"quiet": true, "allow_failure": true});
    if (r.code != 0) {
        throw "bootstrap-worktree: `{bin} {args.join(" ")}` failed: {failureCause(r.code, stdout: r.stdout, stderr: r.stderr)}";
    }
    return r.stdout;
}

// failureCause is what a failed command said, or, when it said nothing, how it ended.
export fun failureCause(code: int, stdout: str, stderr: str) > str {
    final said = if (stderr.trim() != "") stderr.trim() else stdout.trim();
    if (said != "") {
        return "exit {code}:\n{said}";
    }
    if (code == -1) {
        return "it never started, or was killed, and printed nothing";
    }
    return "exit {code}, and it printed nothing";
}

fun readHead(dir: str) > str !> any {
    return vcs\cmd(["rev-parse", "HEAD"], opts: {"dir": dir, "quiet": true}).stdout.trim();
}

// scopesOf asks the Go toolchain which packages under root ./cmd/magus compiles. go list
// loads packages without compiling any; magus refuses to load without jsonv2.
fun scopesOf(root: str) > [str] !> any {
    final listed = proc\exec("env", args: ["GOEXPERIMENT=jsonv2", "go", "list", "-deps", "-f",
        `{{if not .Standard}}{{.Dir}}{{range .EmbedFiles}}|{{.}}{{end}}{{end}}`, "./cmd/magus"],
        dir: root, opts: {"quiet": true, "allow_failure": true});
    if (listed.code != 0) {
        throw "bootstrap-worktree: `go list -deps ./cmd/magus` in {root} exited {listed.code}:\n{listed.stderr.trim()}";
    }
    return packageScopes(listed.stdout, root: root);
}

// changedSince is every path in root, root-relative, whose content differs from rev: files
// committed since, edited in the tree, or untracked and not ignored.
fun changedSince(root: str, rev: str) > [str] !> any {
    final paths = mut [<str>];
    final diffed = vcs\cmd(["-c", "core.quotepath=false", "diff", "--name-only", rev], opts: {"dir": root, "quiet": true}).stdout;
    final fresh = vcs\cmd(["-c", "core.quotepath=false", "ls-files", "--others", "--exclude-standard"], opts: {"dir": root, "quiet": true}).stdout;
    foreach (line in (diffed + "\n" + fresh).split("\n")) {
        if (line.trim() != "") {
            paths.append(line.trim());
        }
    }
    return paths;
}

// reusable returns the binary in source and its build when it is provably root's own build,
// and raises with every reason it is not.
fun reusable(root: str, source: str) > obj{ bin: str, build: BuildFacts, scopes: int } !> any {
    final bin = "{source}/magus";
    if (!fs\isFile(bin)) {
        throw "bootstrap-worktree: {source} holds no ./magus to place";
    }
    final build = parseBuild(magusAt(bin, root: source, args: ["version", "-o", "json"]));
    if (build.commit == "") {
        throw "{bin} is not this worktree's build:\n  it reports no commit, so nothing ties it to a tree";
    }
    final scopes = scopesOf(root);
    final sourceInputs = if (build.dirty) buildInputs(changedSince(source, rev: build.commit), scopes: scopes) else [<str>];
    final rootInputs = buildInputs(changedSince(root, rev: build.commit), scopes: scopes);
    try {
        checkReusable(build, sourceRev: readHead(source), sourceInputs: sourceInputs, rootInputs: rootInputs);
    } catch (e: str) {
        throw "{bin} is not this worktree's build:\n  {e}";
    }
    return .{ bin = bin, build = build, scopes = scopes.len() };
}

// placed says what bootstrap did with the binary, for stdout.
export fun placed(bin: str, commit: str, rootRev: str, scopes: int) > str {
    final where = if (rootRev.startsWith(commit)) "at {commit}, which this worktree is at" else "at {commit}, while this worktree is at {rootRev}";
    return "{bin} was built {where}; no Go build input under {scopes} package scopes differs";
}

// refusal is the error for a source with no placeable binary: what the orchestrator builds, once, in the root.
export fun refusal(why: str, source: str) > str {
    return "bootstrap-worktree: REFUSED to place {why}\n"
        + "A worker checkout never compiles magus. The orchestrator builds ./magus once for this base, in {source} "
        + "(`{source}/magus --root {source} run go-build .`), then reruns this with `--from {source}`.";
}

// bootstrap places ./magus in root, refreshes harness skills, builds the graph, takes job, and returns the row as the
// fresh binary reads it back. ./magus is copied from source, the main checkout when source is "",
// and only when that binary is provably root's own build; otherwise it raises, since a worker
// checkout never compiles magus. Raises on any step that fails and on a row unfit for a worker
// here, so a caller never starts work on a wrong binding.
export fun bootstrap(root: str, job: str, source: str) > Row !> any {
    final main = checkRepository(root);
    final origin = if (source == "") main else source;
    final local = "{root}/magus";
    var v = .{ bin = "", build = BuildFacts{ commit = "", dirty = false }, scopes = 0 };
    try {
        v = reusable(root, source: origin);
    } catch (e: str) {
        throw refusal(e, source: origin);
    }
    // Copy beside it, then rename over it: a copy truncates ./magus in place, and this script
    // is often running from that file (magus re-execs into a workspace's own ./magus). On
    // darwin every later exec of an executable rewritten in place is SIGKILLed.
    fs\copyFile(v.bin, dst: "{local}.bootstrap");
    fs\chmod("{local}.bootstrap", mode: 493);
    fs\rename("{local}.bootstrap", dst: local);
    std\print("placed " + placed(v.bin, commit: v.build.commit, rootRev: readHead(root), scopes: v.scopes));
    // A bound job cannot rewrite the skills that steer it, so refresh every wired
    // harness before job exec takes the lease. Do this before graph build so it
    // indexes the installed skill content when the installer updates it.
    magusAt(local, root: root, args: ["agent", "harness", "install"]);
    std\print("refreshed the wired harness skills");
    magusAt(local, root: root, args: ["graph", "build", "--silent"]);
    std\print("built the graph");
    final took = magusAt(local, root: root, args: ["job", "exec", job]);
    foreach (line in took.split("\n")) {
        if (line.trim() != "") {
            std\print("  {line.trim()}");
        }
    }
    final row = parseRow(magusAt(local, root: root, args: ["describe", "job", job, "-o", "json"]));
    final trackedClean = (vcs\cmd(["diff", "HEAD", "--quiet"], opts: {"dir": root, "quiet": true, "allow_failure": true}).code) == 0;
    try {
        checkFit(row, root: root, main: main, trackedClean: trackedClean);
    } catch (e: str) {
        throw "bootstrap-worktree: REFUSED, job {job} is not fit to work here:\n  {e}";
    }
    return row;
}

export fun render(row: Row, root: str) > [str] {
    var base = "base {row.reportedBase} matches the row's checkpoint";
    if (row.checkpoint == "") {
        base = "base {row.reportedBase} recorded; the row names no checkpoint, so nothing verified it";
    } else if (row.baseVerdict == "revision-match") {
        base = "base {row.checkpoint} is the row's checkpoint; the tree adds only untracked files, which job exec reads as a patch";
    }
    return [
        "took job {row.id} in {root}: checkout verified",
        base,
        "the guard sees this script, not the exec inside it: unless your spawn was titled for {row.id}, run `./magus job exec {row.id}` once so it binds your session",
        "read the terms: ./magus describe job {row.id}",
    ];
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--check"], valued: ["--job", "--from"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "bootstrap-worktree: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final root = vcs\root();
    final source = parsed.values["--from"] ?? "";
    if (parsed.values["--check"] != null) {
        if (source == "") {
            throw "bootstrap-worktree: --check needs --from, the checkout whose ./magus to judge\n{USAGE}";
        }
        var v = .{ bin = "", build = BuildFacts{ commit = "", dirty = false }, scopes = 0 };
        try {
            v = reusable(root, source: source);
        } catch (e: str) {
            std\print("not placeable: {e}");
            return;
        }
        std\print("placeable: " + placed(v.bin, commit: v.build.commit, rootRev: readHead(root), scopes: v.scopes));
        return;
    }
    final job = parsed.values["--job"] ?? "";
    if (job == "") {
        throw "bootstrap-worktree: --job is required: the lease is the point of a worker's worktree\n{USAGE}";
    }
    foreach (line in render(bootstrap(root, job: job, source: source), root: root)) {
        std\print(line);
    }
}

final WT = "/work/magus/.claude/worktrees/w1";
final MAIN = "/work/magus";

fun fixture(name: str) > Row !> any {
    return parseRow(fs\readFile("hack/testdata/{name}"));
}

// fitReasons is each reason checkFit raised, empty when the row is fit.
fun fitReasons(row: Row, root: str, main: str, trackedClean: bool) > [str] {
    try {
        checkFit(row, root: root, main: main, trackedClean: trackedClean);
    } catch (e: str) {
        return e.split("\n  ");
    }
    return [<str>];
}

// reuseReasons is each reason checkReusable raised, empty when the binary is reusable.
fun reuseReasons(build: BuildFacts, sourceRev: str, sourceInputs: [str], rootInputs: [str]) > [str] {
    try {
        checkReusable(build, sourceRev: sourceRev, sourceInputs: sourceInputs, rootInputs: rootInputs);
    } catch (e: str) {
        return e.split("\n  ");
    }
    return [<str>];
}

test "a row taken here at its checkpoint is fit" {
    final row = fixture("bootstrap-match.json");
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "fit");
    assert\equal(render(row, root: WT)[1], want: "base 7472f16fc709ab3827cd38ff281fecc0a217ca88 matches the row's checkpoint", message: "base line");
}

test "a row bound to the main checkout is refused, naming it" {
    assert\equal(fitReasons(fixture("bootstrap-main.json"), root: WT, main: MAIN, trackedClean: true), want: [
        "job agent-scripts names /work/magus as its checkout, not /work/magus/.claude/worktrees/w1 (the main checkout: every write the worker makes here is graded against the wrong tree); rerun `./magus job exec agent-scripts` from /work/magus/.claude/worktrees/w1",
    ], message: "main");
}

test "a diverged base is refused with the checkpoint to switch to" {
    assert\equal(fitReasons(fixture("bootstrap-diverged.json"), root: WT, main: MAIN, trackedClean: true), want: [
        "job agent-scripts recorded base 1111111111111111111111111111111111111111, verdict diverged, but its checkpoint is 7472f16fc709ab3827cd38ff281fecc0a217ca88; `git switch --detach 7472f16fc709ab3827cd38ff281fecc0a217ca88` (or the row's branch at it), then bootstrap again",
    ], message: "diverged");
}

test "a row with no checkpoint passes and says nothing verified its base" {
    final row = Row{ id = "j", state = "declared", checkpoint = "", reportedBase = "abc", baseVerdict = "unknown", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "fit");
    assert\equal(render(row, root: WT)[1], want: "base abc recorded; the row names no checkpoint, so nothing verified it", message: "note");
}

test "an ended job is refused" {
    final row = Row{ id = "j", state = "pass", checkpoint = "", reportedBase = "", baseVerdict = "", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: ["job j is pass, so nobody may work it; ask whoever declared it"], message: "ended");
}

test "revision-match passes only while the tracked files are the checkpoint's" {
    final row = Row{ id = "j", state = "declared", checkpoint = "abc", reportedBase = "abc+e3b0", baseVerdict = "revision-match", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "untracked only");
    assert\equal(render(row, root: WT)[1], want: "base abc is the row's checkpoint; the tree adds only untracked files, which job exec reads as a patch", message: "note");
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: false).len(), want: 1, message: "tracked edits");
}

test "a binary is this worktree's build while no Go build input differs, at any commit" {
    final clean = BuildFacts{ commit = "166d3dabd", dirty = false };
    assert\equal(reuseReasons(clean, sourceRev: "166d3dabd7d7", sourceInputs: [<str>], rootInputs: [<str>]), want: [<str>],
        message: "a worktree at another commit with identical Go sources");
    assert\equal(reuseReasons(clean, sourceRev: "aaaa", sourceInputs: [<str>], rootInputs: ["run.go", "go.mod"]),
        want: ["this worktree differs from 166d3dabd in 2 build input(s), first run.go"], message: "worktree changes a Go file");
    final dirty = BuildFacts{ commit = "166d3dabd", dirty = true };
    assert\equal(reuseReasons(dirty, sourceRev: "166d3dabd7d7", sourceInputs: [<str>], rootInputs: [<str>]),
        want: [<str>], message: "dirty only outside the build inputs");
    assert\equal(reuseReasons(dirty, sourceRev: "166d3dabd7d7", sourceInputs: ["symbol.go"], rootInputs: [<str>]),
        want: ["it was built with 1 build input(s) changed from 166d3dabd, first symbol.go"], message: "dirty inputs");
    assert\equal(reuseReasons(dirty, sourceRev: "2222222", sourceInputs: [<str>], rootInputs: [<str>]).len(),
        want: 1, message: "a dirty build whose checkout moved on is unknown");
    assert\equal(reuseReasons(BuildFacts{ commit = "", dirty = false }, sourceRev: "x", sourceInputs: [<str>], rootInputs: [<str>]),
        want: ["it reports no commit, so nothing ties it to a tree"], message: "no commit");
}

test "package scopes are the package directories below the root and the files the root embeds" {
    final listed = "/work/magus|assets/a.txt\n/work/magus/internal/guard\n/work/magus/libs/figure|figure.buzz\n"
        + "/home/me/go/pkg/mod/dario.cat/mergo@v1.0.2\n/work/magus-other/x\n\n";
    assert\equal(packageScopes(listed, root: "/work/magus"), want: ["assets/a.txt", "internal/guard/", "libs/figure/"],
        message: "module-cache and sibling directories drop out; the root contributes only what it embeds");
}

test "a build input is a Go file, a module file, or a file in a package scope" {
    final scopes = ["assets/a.txt", "internal/guard/", "libs/figure/"];
    assert\equal(buildInputs([
        "run.go", "run_test.go", "go.mod", "libs/figure/go.sum", "internal/guard/brief.go", "internal/guard/brief_test.go",
        "internal/guard/builtin/builtin.go", "spells/go/go.buzz", "internal/guard/rules/embedded.txt", "libs/figure/figure.buzz",
        "assets/a.txt", "assets/b.txt", "docs/guides/jobs.md", "MAGUS.md", "README.md", "console/src/theme.ts",
        "changes/unreleased/x.md", "hack/dev/bootstrap-worktree.buzz", "internal/guardian/x.txt",
    ], scopes: scopes), want: [
        "run.go", "go.mod", "libs/figure/go.sum", "internal/guard/brief.go", "internal/guard/builtin/builtin.go",
        "internal/guard/rules/embedded.txt", "libs/figure/figure.buzz", "assets/a.txt",
    ], message: "docs, console, hack, tests and root-level files outside the embeds are not inputs");
    assert\equal(buildInputs(["docs/x.md", "run_test.go"], scopes: scopes), want: [<str>], message: "a docs-and-tests commit changes no input");
    assert\equal(placed("/r/magus", commit: "166d3dabd", rootRev: "166d3dabd7d7", scopes: 3),
        want: "/r/magus was built at 166d3dabd, which this worktree is at; no Go build input under 3 package scopes differs", message: "same commit");
    assert\equal(placed("/r/magus", commit: "166d3dabd", rootRev: "1111111", scopes: 3),
        want: "/r/magus was built at 166d3dabd, while this worktree is at 1111111; no Go build input under 3 package scopes differs", message: "another commit");
    assert\equal(refusal("x", source: "/r"), want: "bootstrap-worktree: REFUSED to place x\nA worker checkout never compiles magus. The orchestrator builds ./magus once for this base, in /r (`/r/magus --root /r run go-build .`), then reruns this with `--from /r`.", message: "refusal");
    assert\equal(parseBuild("\{\"version\":\"v0.4.3-485-g166d3dabd-dirty\",\"commit\":\"166d3dabd\"}"), want: BuildFacts{ commit = "166d3dabd", dirty = true }, message: "dirty build");
}

test "a command killed by a signal names the signal, not exit -1" {
    var said = "";
    try {
        magusAt("/bin/sh", root: ".", args: ["-c", "kill -9 $$"]);
    } catch (e: str) {
        said = e;
    }
    assert\equal(said.startsWith("bootstrap-worktree: `/bin/sh -c kill -9 $$` failed: exit -1:\n"), want: true, message: said);
    assert\equal(said.endsWith("signal: killed"), want: true, message: said);
    assert\equal(failureCause(1, stdout: "", stderr: ""), want: "exit 1, and it printed nothing", message: "silent exit");
    assert\equal(failureCause(2, stdout: "out", stderr: " err\n"), want: "exit 2:\nerr", message: "stderr first");
}

test "the main worktree is the porcelain's first stanza" {
    assert\equal(mainWorktree("worktree /work/magus\nHEAD 1\nbranch refs/heads/main\n\nworktree /work/magus/.claude/worktrees/w1\nHEAD 2\ndetached\n"),
        want: "/work/magus", message: "main");
}
