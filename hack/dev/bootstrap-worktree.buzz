namespace bootstrapworktree;

import "encoding/json";
import "env";
import "flags";
import "fs";
import "io";
import "path";
import "proc";
import "result";
import "std";
import "vcs";
import "./hack/policy/stale" as stale;
import "./hack/dev/bootstrap-checkout" as checkout;

import "assert";

final SUMMARY = "place ./magus and a lease in a job's worktree";
final SERVES = ["rule:stale-binary -- --job \{lease} --from \{checkout}"];

final USAGE = "usage: magus buzz hack/dev/bootstrap-worktree.buzz -- (--job <id> [--from <checkout> | --build-from <checkout>] | --check --from <checkout>)";
final HELP = "cost: a binary copy, a graph build and a lease, in seconds; this script compiles magus only under --build-from\n{USAGE}\n\n"
    + "Makes a fresh worktree of this repository usable for the worker holding <id>: places the root checkout's ./magus\n"
    + "(the main checkout, or the one --from names), seeds its symbol index from there, takes the job's lease, refuses\n"
    + "unless the row names this worktree as its checkout and the base it recorded matches the row's checkpoint, and builds\n"
    + "the graph last. The lease comes first so an edit made while the graph builds lands after the base is recorded. A\n"
    + "graph build that fails prints a line naming `./magus graph build` and does not fail the bootstrap. The last line\n"
    + "printed says the worktree is ready: act on that line, never on partial output. Writes ./magus, the job row and\n"
    + "the graph, and never the harness wiring: hack/dev/bootstrap-harnesses.buzz is the person's run for that.\n\n"
    + "The orchestrator builds one ./magus per base commit, in the root, and every worker checkout receives a copy. A copy is\n"
    + "placed only when it is provably the binary this worktree would build: go-build stamps it with a digest of its Go\n"
    + "build inputs (each file the go spell's mgs_getScopes names for ./cmd/magus: what it compiles or embeds, and its\n"
    + "modules' go.mod, go.sum or go.work), and that digest must be this worktree's. Docs, console, tests, a package nothing links and a separate module such as\n"
    + "libs/train do not count, so a base commit later than the binary's usually qualifies, and so does a binary built\n"
    + "from uncommitted changes. Otherwise the script refuses and names what to build in the root.\n"
    + "--build-from <checkout> is --from after building: it links <checkout>/magus with `go build`, stamped as go-build stamps it, then\n"
    + "judges that binary the same way. It runs after the main-checkout refusal and never loads <checkout>'s magusfile, so a checkout whose\n"
    + "own change its old ./magus cannot load still builds; it links the checked-in generated files, and regenerating a stale one is the\n"
    + "integrator's `go-build`. A session holding a job lease is refused, since a worker never compiles magus.\n"
    + "--check prints that verdict and writes nothing.";
final MODULE = "module github.com/egladman/magus";

// Row is what bootstrap reads back from `./magus describe job <id> -o json`.
export object Row {
    id: str,
    state: str,
    checkpoint: str,
    reportedBase: str,
    baseVerdict: str,
    checkoutRoot: str,
}

export fun parseRow(described: str) > result\Result::<Row> {
    try {
        final j = json\parse(described)["job"] ?? {<str: any>};
        return result\ok::<Row>(Row{
            id = j["id"] ?? "",
            state = j["state"] ?? "",
            checkpoint = j["checkpoint"] ?? "",
            reportedBase = j["reported_base"] ?? "",
            baseVerdict = j["base_verdict"] ?? "",
            checkoutRoot = j["checkout_root"] ?? "",
        });
    } catch (err: any) {
        return result\caught::<Row>(err, doing: "bootstrap-worktree: read the job row");
    }
}

// failAll fails with every reason, one per line, and succeeds when none.
fun failAll(reasons: [str]) > result\Result::<bool> {
    if (reasons.len() > 0) {
        return result\fail::<bool>(reasons.join("\n  "));
    }
    return result\ok::<bool>(true);
}

// checkReusable fails unless stamped, the Go input digest linked into a
// binary, is digest, this worktree's.
// Equal inputs build the same binary at any commit, even from uncommitted
// changes.
export fun checkReusable(stamped: str, digest: str) > result\Result::<bool> {
    if (stamped == "") {
        return result\fail::<bool>("it carries no Go input digest: a bare `go build` linked it, or a go-build from before the digest");
    }
    if (stamped != digest) {
        return result\fail::<bool>("its Go build inputs (digest {stamped}) differ from this worktree's ({digest})");
    }
    return result\ok::<bool>(true);
}

// stampProbe prints the build stamp of the magus running it, from which hack/policy/stale.buzz
// reads the Go input digest the binary was built with.
final stampProbe = `import "std"; import "magus"; std\print(magus\guard.binary().stamp);`;

// buildStampProbe prints the stamp go-build would link for the tree it runs in, from that tree's own
// hack/policy/stale.buzz. The binary running it only has to run a script, never to load the magusfile.
final buildStampProbe = `import "std"; import "./hack/policy/stale" as stale; std\print(stale\buildStamp(".") catch "");`;

// A previous claim's reported base can predate this worktree.
// isOwnCheckout is whether source is the checkout the job row names.
fun isOwnCheckout(row: Row, source: str) > bool {
    return source != "" and row.checkoutRoot != "" and path\clean(source) == path\clean(row.checkoutRoot);
}

// A job's own checkout is exempt: the worker has moved it past the checkpoint.
fun checkHead(row: Row, head: str, source: str = "") > result\Result::<bool> {
    if (isOwnCheckout(row, source: source)) {
        return result\ok::<bool>(true);
    }
    if (row.checkpoint != "" and row.checkpoint.split("+")[0] != head) {
        final named = if (row.checkoutRoot == "") "" else "; or build from the job's own checkout with `--build-from {row.checkoutRoot}`";
        return result\fail::<bool>("bootstrap-worktree: job {row.id} has checkpoint {row.checkpoint}, but this checkout is at {head}; bootstrap in a worktree at the checkpoint{named}");
    }
    return result\ok::<bool>(true);
}

// checkFit fails with every way the taken lease is unfit for a worker in root.
// A row with no checkpoint has no base to check, which render reports.
// trackedClean is whether root's tracked files match its HEAD.
export fun checkFit(row: Row, root: str, main: str, trackedClean: bool) > result\Result::<bool> {
    final found = mut [<str>];
    if (path\clean(row.checkoutRoot) != path\clean(root)) {
        final where = if (row.checkoutRoot == "") "no checkout" else row.checkoutRoot;
        final why = if (row.checkoutRoot != "" and path\clean(row.checkoutRoot) == path\clean(main))
            " (the main checkout: every write the worker makes here is graded against the wrong tree)" else "";
        found.append("job {row.id} names {where} as its checkout, not {root}{why}; rerun `./magus job exec {row.id}` from {root}");
    }
    final sameTree = row.baseVerdict == "match" or (row.baseVerdict == "revision-match" and trackedClean);
    if (row.checkpoint != "" and !sameTree) {
        found.append("job {row.id} recorded base {row.reportedBase}, verdict {row.baseVerdict}, but its checkpoint is {row.checkpoint}; "
            + "`git switch --detach {row.checkpoint}` (or the row's branch at it), then bootstrap again");
    }
    if (["declared", "running"].indexOf(row.state) == null) {
        found.append("job {row.id} is {row.state}, so nobody may work it; ask whoever declared it");
    }
    return failAll(found);
}

// checkRepository refuses anything but a secondary worktree of this repository.
fun checkRepository(root: str) > result\Result::<str> {
    try {
        if (vcs\name() != "git") {
            return result\fail::<str>("bootstrap-worktree: makes git worktrees usable, and this checkout is {vcs\name()}");
        }
        final gomod = fs\readFile("{root}/go.mod") catch "";
        if (!gomod.startsWith(MODULE + "\n")) {
            return result\fail::<str>("bootstrap-worktree: {root} is not a checkout of magus ({MODULE}); this script places magus's own binary");
        }
        final main = checkout\mainWorktree(vcs\cmd(["worktree", "list", "--porcelain"], opts: vcs\CommandOptions{ dir = root, quiet = true }).stdout);
        if (path\clean(main) == path\clean(root)) {
            return result\fail::<str>("bootstrap-worktree: {root} is the main checkout; a worker gets its own worktree, and placing here replaces "
                + "the ./magus every other session in this checkout runs");
        }
        return result\ok::<str>(main);
    } catch (err: any) {
        return result\caught::<str>(err, doing: "bootstrap-worktree: find the main checkout");
    }
}

fun magusAt(bin: str, root: str, args: [str]) > result\Result::<str> {
    try {
        final r = proc\exec(bin, args: args, dir: root, opts: proc\ExecOptions{ quiet = true, allowFailure = true });
        if (r.code != 0) {
            return result\fail::<str>("bootstrap-worktree: `{bin} {args.join(" ")}` failed: {failureCause(r.code, stdout: r.stdout, stderr: r.stderr)}");
        }
        return result\ok::<str>(r.stdout);
    } catch (err: any) {
        return result\caught::<str>(err, doing: "bootstrap-worktree: run `{bin} {args.join(" ")}`");
    }
}

// failureCause is what a failed command said, or, when it said nothing, how it ended.
export fun failureCause(code: int, stdout: str, stderr: str) > str {
    final said = if (stderr.trim() != "") stderr.trim() else stdout.trim();
    if (said != "") {
        return "exit {code}:\n{said}";
    }
    if (code == -1) {
        return "it never started, or was killed, and printed nothing";
    }
    return "exit {code}, and it printed nothing";
}

// Binary is a placeable ./magus and the Go input digest it carries.
export object Binary {
    bin: str,
    digest: str,
}

// reusable is the binary in source and root's Go input digest when the
// binary's stamp records that digest. Otherwise it fails naming why.
fun reusable(root: str, source: str) > result\Result::<Binary> {
    final bin = "{source}/magus";
    var present = false;
    try {
        present = fs\isFile(bin);
    } catch (err: any) {
        return result\caught::<Binary>(err, doing: "bootstrap-worktree: look for {bin}");
    }
    if (!present) {
        return result\fail::<Binary>("bootstrap-worktree: {source} holds no ./magus to place");
    }
    final printed = magusAt(bin, root: source, args: ["buzz", "-e", stampProbe]);
    if (printed.error -> e) {
        return result\fail::<Binary>("{bin} is not this worktree's build:\n  {source} cannot print its build stamp, so it predates go-build stamping one: {e.message}");
    }
    final stamped = stale\stampedInputs(printed.value!.trim());
    final digested = stale\goInputsDigest(root);
    if (digested.error -> e) {
        return result\fail::<Binary>("bootstrap-worktree: digest the Go build inputs of {root}: {e.message}");
    }
    final digest = digested.value!;
    final matched = checkReusable(stamped, digest: digest);
    if (matched.error -> e) {
        return result\fail::<Binary>("{bin} is not this worktree's build:\n  {e.message}");
    }
    return result\ok::<Binary>(Binary{ bin = bin, digest = digest });
}

// placed says what bootstrap did with the binary, for stdout.
export fun placed(bin: str, digest: str) > str {
    return "{bin} was built from this worktree's Go build inputs (digest {digest})";
}

// refusal is the error for a source with no placeable binary: what the orchestrator builds, once, in the root.
export fun refusal(why: str, source: str) > str {
    return "bootstrap-worktree: REFUSED to place {why}\n"
        + "A worker checkout never compiles magus. The orchestrator builds ./magus once for this base, in {source} "
        + "(`{source}/magus --root {source} run go-build .`), then reruns this with `--from {source}`. "
        + "Or a session holding no lease does both: rerun this with `--build-from {source}`; a leased worker asks the main session to.";
}

// leaseOf is the job named by a W3C baggage header's magus.lease entry, "" when it holds none.
export fun leaseOf(baggage: str) > str {
    foreach (entry in baggage.split(",")) {
        final pair = entry.trim();
        if (pair.startsWith("magus.lease=")) {
            return pair.sub("magus.lease=".len());
        }
    }
    return "";
}

// Link is what --build-from hands to go: the stamp and the build identity go-build links.
export object Link {
    stamp: str,
    version: str,
    commit: str,
    commitDate: str,
    builtBy: str,
}

// ldFlags are go-build's linker flags plus the build stamp. A copy of ld_flags in magusfile.buzz,
// kept because that magusfile may not load under the stale binary this build exists to replace.
export fun ldFlags(link: Link) > str {
    return "-w -s"
        + " -X github.com/egladman/magus/internal/buildinfo.version=" + link.version
        + " -X github.com/egladman/magus/internal/buildinfo.commit=" + link.commit
        + " -X github.com/egladman/magus/internal/buildinfo.commitDate=" + link.commitDate
        + " -X main.builtBy=" + link.builtBy
        + " -X github.com/egladman/magus/internal/interp/bindings.buildStamp=" + link.stamp;
}

// buildArgs is the `env` run that links out from source, as go-build's link_magus does.
export fun buildArgs(source: str, link: Link, dest: str) > [str] {
    return ["GOEXPERIMENT=jsonv2", "go", "-C", source, "build", "-trimpath", "-ldflags", ldFlags(link), "-o", dest, "./cmd/magus"];
}

// buildRefusal is what a leased worker is told for --build-from: it never compiles magus. It
// is "" when described, `describe job <lease> -o json`, is a live integration row taken in
// source, and source is root.
export fun buildRefusal(lease: str, source: str, root: str = "", described: str = "") > str {
    var j = {<str: any>};
    try {
        j = json\parse(described)["job"] ?? {<str: any>};
    } catch (e: any) {
        j = {<str: any>};
    }
    final integrates: [any] = j["integrates"] ?? [<any>];
    final state: str = j["state"] ?? "";
    final checkout: str = j["checkout_root"] ?? "";
    final ownCheckout = checkout != "" and path\clean(checkout) == path\clean(source) and path\clean(source) == path\clean(root);
    // The integrator builds in its own checkout, as the guard's actingIntegrator allows.
    // Refusing it here sent every rebuild of an integration through the root's context.
    if (integrates.len() > 0 and ["declared", "running", "exited"].indexOf(state) != null and ownCheckout) {
        return "";
    }
    return "bootstrap-worktree: --build-from compiles magus, and this session holds the lease `{lease}`; a worker never compiles magus\n"
        + "Ask the main session to run `<main checkout>/magus buzz hack/dev/bootstrap-worktree.buzz -- --job {lease} --build-from {source}`, "
        + "or to place a built binary with `--from {source}`.";
}

// buildFrom compiles magus in source with the checkout's own ./magus, so the go-build target
// stamps it, for placing in root. A lease that may not build is refused.
fun buildFrom(source: str, root: str) > result\Result::<bool> {
    final bin = "{source}/magus";
    var present = false;
    try {
        present = fs\isFile(bin);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "bootstrap-worktree: look for {bin}");
    }
    if (!present) {
        return result\fail::<bool>("bootstrap-worktree: {source} holds no ./magus to build with; `GOEXPERIMENT=jsonv2 go -C {source} run -trimpath ./cmd/magus run go-build --no-cache .` makes the first one");
    }
    final lease = leaseOf(env\getOr("BAGGAGE", def: "") catch "");
    if (lease != "") {
        final described = magusAt(bin, root: source, args: ["describe", "job", lease, "-o", "json"]);
        final refused = buildRefusal(lease, source: source, root: root, described: described.value ?? "");
        if (refused != "") {
            return result\fail::<bool>(refused);
        }
    }
    final stamped = magusAt(bin, root: source, args: ["buzz", "-e", buildStampProbe]);
    if (stamped.error -> e) {
        return result\fail::<bool>("bootstrap-worktree: stamp the build of {source}: {e.message}");
    }
    if (stamped.value!.trim() == "") {
        return result\fail::<bool>("bootstrap-worktree: {source}'s hack/policy/stale.buzz could not stamp its tree, so nothing was built");
    }
    try {
        final at = vcs\CommandOptions{ dir = source, quiet = true };
        final described = vcs\cmd(["describe", "--tags", "--always", "--dirty", "--match", "v[0-9]*"], opts: at).stdout.trim();
        final link = Link{
            stamp = stamped.value!.trim(),
            version = if (described == "") "unknown" else described,
            commit = vcs\cmd(["rev-parse", "HEAD"], opts: at).stdout.trim(),
            commitDate = vcs\cmd(["show", "-s", "--format=%cI", "HEAD"], opts: at).stdout.trim(),
            builtBy = env\getOr("BUILT_BY", def: "") catch "",
        };
        // Link beside ./magus and rename over it, as bootstrap places its copy.
        final built = "{bin}.build";
        _ = proc\exec("env", args: buildArgs(source, link: link, dest: built));
        // The first exec of a new executable is slow on macOS; pay for it here.
        _ = proc\exec(built, args: ["version"], dir: source, opts: proc\ExecOptions{ quiet = true });
        fs\rename(built, dst: bin);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "bootstrap-worktree: build {source}/magus");
    }
    return result\ok::<bool>(true);
}

// bootstrap places ./magus in root, takes job and checks the row fits.
// It builds the graph and returns the row as the fresh binary reads it.
// ./magus is copied from source, the main checkout when source is "",
// and only when that binary is provably root's own build.
// A failed step fails the call, as does a row unfit for a worker here.
// The graph build runs last, and its failure is printed, not returned.
export fun bootstrap(root: str, job: str, source: str) > result\Result::<Row> {
    final found = checkRepository(root);
    if (found.error -> err) {
        return result\Result::<Row>{ error = err };
    }
    final main = found.value!;
    final origin = if (source == "") main else source;
    final jobRow = rowOf(fun (args: [str]) > result\Result::<str> => magusAt("{origin}/magus", root: origin, args: args), job: job);
    if (jobRow.error -> err) {
        return result\Result::<Row>{ error = err };
    }
    // The job's own checkout already holds its built binary. Judge that tree, not this script's.
    final own = isOwnCheckout(jobRow.value!, source: source);
    final at = if (own) source else root;
    try {
        final head = vcs\cmd(["rev-parse", "HEAD"], opts: vcs\CommandOptions{ dir = at, quiet = true }).stdout.trim();
        final checked = checkHead(jobRow.value!, head: head, source: source);
        if (checked.error -> err) {
            return result\Result::<Row>{ error = err };
        }
    } catch (err: any) {
        return result\caught::<Row>(err, doing: "bootstrap-worktree: read HEAD in {at}");
    }
    final local = "{at}/magus";
    final binary = reusable(at, source: origin);
    if (binary.error -> why) {
        return result\fail::<Row>(refusal(why.message, source: origin));
    }
    final v = binary.value!;
    if (own) {
        std\print("kept " + placed(v.bin, digest: v.digest));
    } else {
        // Copy beside it, then rename over it: a copy truncates ./magus in place.
        // On darwin every later exec of an executable rewritten in place is SIGKILLed.
        try {
            fs\copyFile(v.bin, dst: "{local}.bootstrap");
            fs\chmod("{local}.bootstrap", mode: 493);
            fs\rename("{local}.bootstrap", dst: local);
            std\print("placed " + placed(v.bin, digest: v.digest));
            final headOf = fun (dir: str) > str => vcs\cmd(["rev-parse", "HEAD"], opts: vcs\CommandOptions{ dir = dir, quiet = true, allowFailure = true }).stdout.trim() catch "";
            std\print(checkout\seedLine([origin, main], dir: root, headOf: headOf));
        } catch (err: any) {
            return result\caught::<Row>(err, doing: "bootstrap-worktree: place ./magus in {root}");
        }
    }
    // The root's hook runs only a ./magus a live row pins.
    final pinned = magusAt(v.bin, root: origin, args: ["job", "pin", job]);
    if (pinned.error -> e) {
        io\stderr.write("bootstrap-worktree: placed ./magus, and no row pins it, so the root's hook judges with its own binary: {e.message}\n");
    }
    return settle(
        fun (args: [str]) > result\Result::<str> => magusAt(local, root: at, args: args),
        own: own,
        root: at,
        job: job,
        main: main,
        trackedClean: fun () > result\Result::<bool> {
            try {
                return result\ok::<bool>((vcs\cmd(["diff", "HEAD", "--quiet"], opts: vcs\CommandOptions{ dir = at, quiet = true, allowFailure = true }).code) == 0);
            } catch (err: any) {
                return result\caught::<bool>(err, doing: "bootstrap-worktree: diff the tracked files against HEAD");
            }
        },
    );
}

// rowOf reads job's row through run.
fun rowOf(run: fun (args: [str]) > result\Result::<str>, job: str) > result\Result::<Row> {
    final described = run(["describe", "job", job, "-o", "json"]);
    if (described.error -> err) {
        return result\Result::<Row>{ error = err };
    }
    return parseRow(described.value!);
}

fun heldElsewhere(run: fun (args: [str]) > result\Result::<str>, job: str, execError: result\Diagnostic) > result\Result::<Row> {
    final heldRow = rowOf(run, job: job);
    if (heldRow.error -> err) {
        return result\Result::<Row>{ error = err };
    }
    final held = heldRow.value!;
    if (held.state != "running") {
        return result\Result::<Row>{ error = execError };
    }
    // ./magus is placed and the lease is where it belongs. Raising here
    // exited 1 on a success, so callers learned to ignore the exit status.
    try {
        io\stderr.write("bootstrap-worktree: placed ./magus; job {job} is running, its lease held by its holder in {held.checkoutRoot}, "
            + "so this session took no lease and built no graph. The exec said: {execError.message}\n");
    } catch (err: any) {
        return result\caught::<Row>(err, doing: "bootstrap-worktree: write to stderr");
    }
    return result\ok::<Row>(Row{ id = "", state = held.state, checkpoint = held.checkpoint, reportedBase = held.reportedBase, baseVerdict = held.baseVerdict, checkoutRoot = held.checkoutRoot });
}

// claimThenIndex takes the job's lease, refuses a row unfit for root, and only then builds the
// graph: the lease records the base, so an edit made while the graph builds lands after it.
// run executes a magus subcommand and returns its output. When the exec fails on a running
// job, its holder already holds the lease: that is said on stderr, and the row comes back
// with no id, taken by nobody here.
export fun claimThenIndex(run: fun (args: [str]) > result\Result::<str>, root: str, job: str, main: str, trackedClean: fun () > result\Result::<bool>) > result\Result::<Row> {
    final took = run(["job", "exec", job]);
    if (took.error -> e) {
        return heldElsewhere(run, job: job, execError: e);
    }
    foreach (line in took.value!.split("\n")) {
        if (line.trim() != "") {
            std\print("  {line.trim()}");
        }
    }
    final first = rowOf(run, job: job);
    if (first.error -> err) {
        return result\Result::<Row>{ error = err };
    }
    final row = first.value!;
    final cleanNow = trackedClean();
    if (cleanNow.error -> err) {
        return result\Result::<Row>{ error = err };
    }
    final fit = checkFit(row, root: root, main: main, trackedClean: cleanNow.value!);
    if (fit.error -> e) {
        return result\fail::<Row>("bootstrap-worktree: REFUSED, job {job} is not fit to work here:\n  {e.message}");
    }
    final graph = run(["graph", "build", "--silent"]);
    if (graph.error -> e) {
        std\print(graphBuildFailed(e.message));
    } else {
        std\print("built the graph");
    }
    return result\ok::<Row>(row);
}

// settle takes the job in root, unless own: a job's own checkout is taken by its worker's job exec.
// An empty row says nothing was taken.
export fun settle(run: fun (args: [str]) > result\Result::<str>, own: bool, root: str, job: str, main: str, trackedClean: fun () > result\Result::<bool>) > result\Result::<Row> {
    if (own) {
        std\print("built and kept ./magus in {root}; take job {job} there with `./magus job exec {job}`");
        return result\ok::<Row>(Row{ id = "", state = "", checkpoint = "", reportedBase = "", baseVerdict = "", checkoutRoot = root });
    }
    return claimThenIndex(run, root: root, job: job, main: main, trackedClean: trackedClean);
}

// graphBuildFailed is the line printed when the graph build fails after the lease is taken: the
// job is bound and usable, only the graph is cold.
export fun graphBuildFailed(cause: str) > str {
    return "the graph did not build; the lease is taken and the worktree works, but run `./magus graph build` before querying: {cause}";
}

// readyLine is the last line the bootstrap prints.
export fun readyLine(row: Row, root: str) > str {
    return "ready: job {row.id} is taken in {root}; setup is finished and edits may begin";
}

export fun render(row: Row, root: str) > [str] {
    var base = "base {row.reportedBase} matches the row's checkpoint";
    if (row.checkpoint == "") {
        base = "base {row.reportedBase} recorded; the row names no checkpoint, so nothing verified it";
    } else if (row.baseVerdict == "revision-match") {
        base = "base {row.checkpoint} is the row's checkpoint; the tree adds only untracked files, which job exec reads as a patch";
    }
    return [
        "took job {row.id} in {root}: checkout verified",
        base,
        "the guard sees this script, not the exec inside it: unless your spawn was titled for {row.id}, run `./magus job exec {row.id}` once so it binds your session",
        "read the spec: ./magus describe job {row.id}",
    ];
}

// sourceChecked is the checkout whose ./magus to judge. --build-from compiles it, and only after
// refuse allows root, so a refused checkout is never regenerated or rebuilt.
export fun sourceChecked(values: {str: str}, root: str, refuse: fun () > result\Result::<bool>, build: fun (source: str) > result\Result::<bool>) > result\Result::<str> {
    final source = values["--from"] ?? "";
    final built = values["--build-from"] ?? "";
    if (built == "") {
        return result\ok::<str>(source);
    }
    if (source != "" and source != built) {
        return result\fail::<str>("bootstrap-worktree: --from and --build-from name different checkouts\n{USAGE}");
    }
    if (values["--check"] != null) {
        return result\fail::<str>("bootstrap-worktree: --check writes nothing, so it cannot build; use --from\n{USAGE}");
    }
    final allowed = refuse();
    if (allowed.error -> err) {
        return result\Result::<str>{ error = err };
    }
    final compiled = build(built);
    if (compiled.error -> err) {
        return result\Result::<str>{ error = err };
    }
    return result\ok::<str>(built);
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--check"], valued: ["--job", "--from", "--build-from"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "bootstrap-worktree: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final root = vcs\root();
    final chosen = sourceChecked(
        parsed.values,
        root: root,
        refuse: fun () > result\Result::<bool> {
            final found = checkRepository(root);
            if (found.error -> err) {
                return result\Result::<bool>{ error = err };
            }
            return result\ok::<bool>(true);
        },
        build: fun (built: str) > result\Result::<bool> => buildFrom(built, root: root),
    );
    if (chosen.error -> err) {
        throw err.message;
    }
    final source = chosen.value!;
    if (parsed.values["--check"] != null) {
        if (source == "") {
            throw "bootstrap-worktree: --check needs --from, the checkout whose ./magus to judge\n{USAGE}";
        }
        final judged = reusable(root, source: source);
        if (judged.error -> why) {
            std\print("not placeable: {why.message}");
            return;
        }
        std\print("placeable: " + placed(judged.value!.bin, digest: judged.value!.digest));
        return;
    }
    final job = parsed.values["--job"] ?? "";
    if (job == "") {
        throw "bootstrap-worktree: --job is required: the lease is the point of a worker's worktree\n{USAGE}";
    }
    final taken = bootstrap(root, job: job, source: source);
    if (taken.error -> err) {
        throw err.message;
    }
    final row = taken.value!;
    if (row.id == "") {
        return;
    }
    foreach (line in render(row, root: root)) {
        std\print(line);
    }
    std\print(readyLine(row, root: root));
}

final WT = "/work/magus/.claude/worktrees/w1";
final MAIN = "/work/magus";

fun fixture(name: str) > Row {
    return parseRow(fs\readFile("hack/testdata/{name}") catch "").value!;
}

// fitReasons is each reason checkFit failed with, empty when the row fits.
fun fitReasons(row: Row, root: str, main: str, trackedClean: bool) > [str] {
    final fit = checkFit(row, root: root, main: main, trackedClean: trackedClean);
    if (fit.error -> e) {
        return e.message.split("\n  ");
    }
    return [<str>];
}

// reuseReason is what checkReusable failed with, "" when reusable.
fun reuseReason(stamped: str, digest: str) > str {
    final matched = checkReusable(stamped, digest: digest);
    if (matched.error -> e) {
        return e.message;
    }
    return "";
}

test "a row taken here at its checkpoint is fit" {
    final row = fixture("bootstrap-match.json");
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "fit");
    assert\equal(render(row, root: WT)[1], want: "base 7472f16fc709ab3827cd38ff281fecc0a217ca88 matches the row's checkpoint", message: "base line");
}

test "a row bound to the main checkout is refused, naming it" {
    assert\equal(fitReasons(fixture("bootstrap-main.json"), root: WT, main: MAIN, trackedClean: true), want: [
        "job agent-scripts names /work/magus as its checkout, not /work/magus/.claude/worktrees/w1 (the main checkout: every write the worker makes here is graded against the wrong tree); rerun `./magus job exec agent-scripts` from /work/magus/.claude/worktrees/w1",
    ], message: "main");
}

test "bootstrap names the graph build as the fix when it fails after the lease" {
    final line = graphBuildFailed("exit 1:\nMGS3009");
    assert\equal(line.indexOf("`./magus graph build`") != null, want: true, message: "names the command");
    assert\equal(line.indexOf("lease is taken") != null, want: true, message: "says the lease held");
    assert\equal(line.indexOf("MGS3009") != null, want: true, message: "keeps the cause");
}

test "bootstrap ends on a line that says the worktree is ready" {
    final row = fixture("bootstrap-match.json");
    assert\equal(readyLine(row, root: WT), want: "ready: job {row.id} is taken in {WT}; setup is finished and edits may begin", message: "ready");
}

test "a diverged base is refused with the checkpoint to switch to" {
    assert\equal(fitReasons(fixture("bootstrap-diverged.json"), root: WT, main: MAIN, trackedClean: true), want: [
        "job agent-scripts recorded base 1111111111111111111111111111111111111111, verdict diverged, but its checkpoint is 7472f16fc709ab3827cd38ff281fecc0a217ca88; `git switch --detach 7472f16fc709ab3827cd38ff281fecc0a217ca88` (or the row's branch at it), then bootstrap again",
    ], message: "diverged");
}

test "a row with no checkpoint passes and says nothing verified its base" {
    final row = Row{ id = "j", state = "declared", checkpoint = "", reportedBase = "abc", baseVerdict = "unknown", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "fit");
    assert\equal(render(row, root: WT)[1], want: "base abc recorded; the row names no checkpoint, so nothing verified it", message: "note");
}

test "the lease is taken before the graph is built" {
    final described = fs\readFile("hack/testdata/bootstrap-match.json");
    final ran = mut [<str>];
    final taken = claimThenIndex(
        fun (args: [str]) > result\Result::<str> {
            ran.append(args.join(" "));
            return result\ok::<str>(if (args[0] == "describe") described else "");
        },
        root: "/work/magus/.claude/worktrees/w1",
        job: "agent-scripts",
        main: "/work/magus",
        trackedClean: fun () > result\Result::<bool> => result\ok::<bool>(true),
    );
    assert\isTrue(taken.error == null, message: "the bootstrap succeeds");
    assert\equal(ran.join("|"), want: "job exec agent-scripts|describe job agent-scripts -o json|graph build --silent", message: "step order");
}

test "bootstrap refuses a checkout ahead of the job before placing its binary" {
    final row = fixture("bootstrap-diverged.json");
    final refused = checkHead(row, head: row.reportedBase);
    assert\isTrue(refused.error!.message.indexOf(row.checkpoint) != null, message: "name the checkpoint");
    assert\isTrue(checkHead(row, head: row.checkpoint).error == null, message: "a fresh checkout at the checkpoint passes despite a previous divergent claim");
}

test "a source that is the job's own checkout is not held to the checkpoint" {
    final row = Row{ id = "j", state = "declared", checkpoint = "abc", reportedBase = "abc", baseVerdict = "match", checkoutRoot = "/j" };
    assert\isTrue(checkHead(row, head: "def", source: "/j/").error == null, message: "own checkout");
    final refused = checkHead(row, head: "def", source: "/other");
    assert\isTrue(refused.error!.message.indexOf("checkpoint abc") != null and refused.error!.message.indexOf("at def") != null and refused.error!.message.indexOf("--build-from /j") != null, message: "names both commits and the build-from");
}

test "an orchestrator root differing from the job checkout is judged by the job checkout" {
    final row = Row{ id = "j", state = "running", checkpoint = "abc", reportedBase = "def", baseVerdict = "diverged", checkoutRoot = "/j" };
    assert\isTrue(isOwnCheckout(row, source: "/j/"), message: "own checkout");
    assert\isTrue(!isOwnCheckout(row, source: "/o"), message: "another checkout");
    final ran = mut [<str>];
    final taken = settle(
        fun (args: [str]) > result\Result::<str> {
            ran.append(args.join(" "));
            return result\ok::<str>("");
        },
        own: true,
        root: "/j",
        job: "j",
        main: MAIN,
        trackedClean: fun () > result\Result::<bool> => result\ok::<bool>(false),
    );
    assert\isTrue(taken.error == null, message: "the own-checkout path succeeds");
    assert\equal(taken.value!.id, want: "", message: "no row is taken, so main prints no took-job lines");
    assert\equal(ran.len(), want: 0, message: "no job exec, describe or graph build: the worker takes the job in its checkout");
}

test "a diverged worktree with tracked edits is still refused and not detached" {
    final diverged = fs\readFile("hack/testdata/bootstrap-diverged.json");
    final ran = mut [<str>];
    final refused = claimThenIndex(
        fun (args: [str]) > result\Result::<str> {
            ran.append(args.join(" "));
            return result\ok::<str>(if (args[0] == "describe") diverged else "");
        },
        root: WT,
        job: "agent-scripts",
        main: MAIN,
        trackedClean: fun () > result\Result::<bool> => result\ok::<bool>(false),
    );
    final said = refused.error!.message;
    assert\equal(said.indexOf("verdict diverged") != null, want: true, message: said);
    assert\equal(ran.join("|"), want: "job exec agent-scripts|describe job agent-scripts -o json", message: "refuse before indexing");
}

test "an ended job is refused" {
    final row = Row{ id = "j", state = "pass", checkpoint = "", reportedBase = "", baseVerdict = "", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: ["job j is pass, so nobody may work it; ask whoever declared it"], message: "ended");
}

test "revision-match passes only while the tracked files are the checkpoint's" {
    final row = Row{ id = "j", state = "declared", checkpoint = "abc", reportedBase = "abc+e3b0", baseVerdict = "revision-match", checkoutRoot = WT };
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: true), want: [<str>], message: "untracked only");
    assert\equal(render(row, root: WT)[1], want: "base abc is the row's checkpoint; the tree adds only untracked files, which job exec reads as a patch", message: "note");
    assert\equal(fitReasons(row, root: WT, main: MAIN, trackedClean: false).len(), want: 1, message: "tracked edits");
}

test "a binary is this worktree's build while its stamped Go input digest is this worktree's" {
    assert\equal(reuseReason("0123456789abcdef", digest: "0123456789abcdef"), want: "",
        message: "equal inputs, at any commit and from any dirty tree");
    assert\equal(reuseReason("fedcba9876543210", digest: "0123456789abcdef"),
        want: "its Go build inputs (digest fedcba9876543210) differ from this worktree's (0123456789abcdef)", message: "an input moved");
    assert\equal(reuseReason("", digest: "0123456789abcdef"),
        want: "it carries no Go input digest: a bare `go build` linked it, or a go-build from before the digest", message: "no digest");
    assert\equal(placed("/r/magus", digest: "0123456789abcdef"),
        want: "/r/magus was built from this worktree's Go build inputs (digest 0123456789abcdef)", message: "placed");
}

test "the refusal names who builds" {
    assert\equal(refusal("x", source: "/r"), want: "bootstrap-worktree: REFUSED to place x\nA worker checkout never compiles magus. The orchestrator builds ./magus once for this base, in /r (`/r/magus --root /r run go-build .`), then reruns this with `--from /r`. Or a session holding no lease does both: rerun this with `--build-from /r`; a leased worker asks the main session to.", message: "refusal");
}

test "--build-from builds in the source checkout and is refused under a lease, naming who builds" {
    assert\equal(leaseOf("a=b, magus.lease=policy-bootstrap ,c=d"), want: "policy-bootstrap", message: "the lease entry of a baggage header");
    assert\equal(leaseOf("a=b"), want: "", message: "no lease");
    assert\equal(leaseOf(""), want: "", message: "no baggage");
    final refused = buildRefusal("job-a", source: "/r");
    assert\equal(refused.indexOf("a worker never compiles magus") != null and refused.indexOf("--job job-a --build-from /r`") != null, want: true,
        message: "a leased worker is refused and told who builds: " + refused);
}

test "a command killed by a signal names the signal, not exit -1" {
    final said = magusAt("/bin/sh", root: ".", args: ["-c", "kill -9 $$"]).error!.message;
    assert\equal(said.startsWith("bootstrap-worktree: `/bin/sh -c kill -9 $$` failed: exit -1:\n"), want: true, message: said);
    assert\equal(said.endsWith("signal: killed"), want: true, message: said);
    assert\equal(failureCause(1, stdout: "", stderr: ""), want: "exit 1, and it printed nothing", message: "silent exit");
    assert\equal(failureCause(2, stdout: "out", stderr: " err\n"), want: "exit 2:\nerr", message: "stderr first");
}

test "the main worktree is the porcelain's first stanza" {
    assert\equal(checkout\mainWorktree("worktree /work/magus\nHEAD 1\nbranch refs/heads/main\n\nworktree /work/magus/.claude/worktrees/w1\nHEAD 2\ndetached\n"),
        want: "/work/magus", message: "main");
}

test "--build-from refuses the main checkout before it builds anything" {
    final ran = mut [<str>];
    final refuse = fun () > result\Result::<bool> {
        ran.append("refuse");
        return result\fail::<bool>("is the main checkout");
    };
    final build = fun (source: str) > result\Result::<bool> {
        ran.append("build {source}");
        return result\ok::<bool>(true);
    };
    final refused = sourceChecked({"--build-from": "/m"}, root: "/m", refuse: refuse, build: build);
    assert\equal(refused.error!.message, want: "is the main checkout", message: "the refusal is the error");
    assert\equal(ran.join("|"), want: "refuse", message: "nothing built");
}

test "--build-from builds only after the checkout is allowed; --from builds nothing" {
    final ran = mut [<str>];
    final refuse = fun () > result\Result::<bool> {
        ran.append("refuse");
        return result\ok::<bool>(true);
    };
    final build = fun (source: str) > result\Result::<bool> {
        ran.append("build {source}");
        return result\ok::<bool>(true);
    };
    final chosen = sourceChecked({"--build-from": "/j"}, root: "/w", refuse: refuse, build: build);
    assert\equal(chosen.value!, want: "/j", message: "the built checkout is the source");
    assert\equal(ran.join("|"), want: "refuse|build /j", message: "refusal first");
    final plain = sourceChecked({"--from": "/j"}, root: "/w", refuse: refuse, build: build);
    assert\equal(plain.value!, want: "/j", message: "the source is --from");
    assert\equal(ran.len(), want: 2, message: "no further step ran");
}

test "--build-from rejects differing checkouts and --check before refusing or building" {
    final ran = mut [<str>];
    final refuse = fun () > result\Result::<bool> {
        ran.append("refuse");
        return result\ok::<bool>(true);
    };
    final build = fun (source: str) > result\Result::<bool> {
        ran.append("build");
        return result\ok::<bool>(true);
    };
    assert\equal(sourceChecked({"--build-from": "/a", "--from": "/b"}, root: "/w", refuse: refuse, build: build).error != null, want: true, message: "differing checkouts");
    assert\equal(sourceChecked({"--build-from": "/a", "--check": "true"}, root: "/w", refuse: refuse, build: build).error != null, want: true, message: "--check");
    assert\equal(ran.len(), want: 0, message: "nothing ran");
}

test "the build links with go directly, stamped as go-build stamps, without loading the magusfile" {
    final link = Link{ stamp = "a=1,@inputs=ff", version = "v1-dirty", commit = "abc", commitDate = "2026-11-25T00:00:00Z", builtBy = "" };
    assert\equal(buildArgs("/j", link: link, dest: "/j/magus.build"), want: [
        "GOEXPERIMENT=jsonv2", "go", "-C", "/j", "build", "-trimpath", "-ldflags",
        "-w -s -X github.com/egladman/magus/internal/buildinfo.version=v1-dirty -X github.com/egladman/magus/internal/buildinfo.commit=abc"
            + " -X github.com/egladman/magus/internal/buildinfo.commitDate=2026-11-25T00:00:00Z -X main.builtBy="
            + " -X github.com/egladman/magus/internal/interp/bindings.buildStamp=a=1,@inputs=ff",
        "-o", "/j/magus.build", "./cmd/magus",
    ], message: "go build argv");
    assert\equal(buildStampProbe.indexOf("stale\\buildStamp(") != null, want: true, message: "the stamp is the tree's own buildStamp");
    assert\equal(buildStampProbe.indexOf("run") == null, want: true, message: "no target run, so no magusfile load");
}

// flagNames lists the `-X name=` linker symbols in text, in order.
fun flagNames(text: str) > [str] {
    final names: mut [str] = mut [];
    final parts = text.split("-X ");
    var i = 1;
    while (i < parts.len()) {
        final eq = parts[i].indexOf("=");
        if (eq != null) {
            names.append(parts[i].sub(0, len: eq!));
        }
        i = i + 1;
    }
    return names;
}

test "ldFlags names the symbols magusfile.buzz ld_flags does, plus the build stamp" {
    final source = fs\readFile("magusfile.buzz");
    final start = source.indexOf("fun ld_flags()");
    assert\equal(start != null, want: true, message: "magusfile.buzz still defines ld_flags");
    final body = source.sub(start!, len: source.len() - start!);
    final end = body.indexOf("\n}\n");
    final want = flagNames(body.sub(0, len: end!)).cloneMutable();
    want.append("github.com/egladman/magus/internal/interp/bindings.buildStamp");
    final link = Link{stamp = "s", version = "v", commit = "c", commitDate = "d", builtBy = "b"};
    assert\equal(flagNames(ldFlags(link)), want: want, message: "the copy names the same -X symbols in the same order");
    assert\equal(ldFlags(link).startsWith("-w -s "), want: true, message: "the copy strips the same way");
}
