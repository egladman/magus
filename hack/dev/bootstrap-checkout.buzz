final ROWS = `{"jobs":[{"id":"merged-work","state":"running","checkout_root":"/r","worktree":{"base":"b0"}},{"id":"done","state":"exited","checkout_root":"/x","worktree":{"base":"b0"}}]}`;

fun adoptOf(answers: {str: Ran}, calls: mut [str], did: mut [str]) > result\Result::<bool> {
    final h = stubHost(answers, stamps: {}, calls: calls);
    return adopt(h, dir: "/c", onto: "feat", did: did, install: "none");
}

test "adopt refuses a dirty tree and moves nothing" {
    final calls = mut [<str>];
    final did = mut [<str>];
    final res = adoptOf({"git status --porcelain": Ran{ stdout = " M a.go\n" }}, calls: calls, did: did);
    assert\isTrue(res.error != null, message: "refused");
    assert\isTrue(res.error!.message.indexOf("uncommitted change") != null, message: "names the reason");
    assert\equal(calls.indexOf("git merge --ff-only bbb"), want: null, message: "no move");
    assert\equal(did.len(), want: 0, message: "nothing done");
}

test "adopt refuses a move that is not a fast-forward and resets nothing" {
    final calls = mut [<str>];
    final did = mut [<str>];
    final res = adoptOf({
        "git rev-parse --verify feat^\{commit}": Ran{ stdout = "bbb\n" },
        "git rev-parse HEAD": Ran{ stdout = "aaa\n" },
        "git merge-base --is-ancestor HEAD bbb": Ran{ code = 1 },
    }, calls: calls, did: did);
    assert\isTrue(res.error != null, message: "refused");
    assert\isTrue(res.error!.message.indexOf("not a fast-forward") != null, message: "names the reason");
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("git merge --ff-only") or c.startsWith("git reset")).len(), want: 0, message: "no move");
    assert\equal(calls.indexOf("build /c"), want: null, message: "no build");
}

test "adopt fast-forwards, places the binary, installs, then settles rows" {
    final calls = mut [<str>];
    final did = mut [<str>];
    final res = adoptOf({
        "git rev-parse --verify feat^\{commit}": Ran{ stdout = "bbbbbbbbbbbbbbbb\n" },
        "git rev-parse HEAD": Ran{ stdout = "aaaaaaaaaaaaaaaa\n" },
        "magus ls jobs -o json": Ran{ stdout = `{"jobs":[]}` },
        "magus job prune": Ran{ stdout = "ended 2 job(s)\n" },
    }, calls: calls, did: did);
    assert\isTrue(res.error == null, message: "adopted");
    assert\equal(did[0], want: "fast-forwarded /c from aaaaaaaaaaaa to feat (bbbbbbbbbbbb)", message: "moved");
    assert\equal(did[did.len() - 1], want: "job prune: ended 2 job(s)", message: "pruned last");
    assert\equal(calls.indexOf("git merge --ff-only bbbbbbbbbbbbbbbb") != null, want: true, message: "ff-only");
    assert\equal(calls.indexOf("build /c") != null, want: true, message: "binary placed");
    assert\equal(calls.indexOf("magus buzz hack/dev/bootstrap-harnesses.buzz") != null, want: true, message: "harnesses");
}

test "adopt at the target moves nothing and says so" {
    final calls = mut [<str>];
    final did = mut [<str>];
    _ = adoptOf({
        "git rev-parse --verify feat^\{commit}": Ran{ stdout = "bbbbbbbbbbbbbbbb\n" },
        "git rev-parse HEAD": Ran{ stdout = "bbbbbbbbbbbbbbbb\n" },
    }, calls: calls, did: did);
    assert\equal(did[0], want: "already at feat (bbbbbbbbbbbb)", message: "said");
    assert\equal(calls.indexOf("git merge --ff-only bbbbbbbbbbbbbbbb"), want: null, message: "no move");
}

test "a running row whose head is already in the target is ended" {
    final calls = mut [<str>];
    final did = mut [<str>];
    final h = stubHost({
        "magus ls jobs -o json": Ran{ stdout = ROWS },
        "/r: git rev-parse HEAD": Ran{ stdout = "h1h1h1h1h1h1h1h1\n" },
    }, stamps: {}, calls: calls);
    final kept = endMergedRows(h, dir: "/c", onto: "bbb", did: did);
    assert\isTrue(kept.error == null, message: "settled");
    assert\equal(kept.value!.len(), want: 0, message: "none left");
    assert\equal(did, want: ["ended running row merged-work: its head h1h1h1h1h1h1 is already in bbb"], message: "said");
    assert\equal(calls.indexOf("magus job exit merged-work") != null, want: true, message: "ended");
    assert\equal(calls.indexOf("magus job exit done"), want: null, message: "exited rows are the prune's");
}

test "a running row whose work the target holds as a squash is ended" {
    final calls = mut [<str>];
    final did = mut [<str>];
    final noWorktree = `{"jobs":[{"id":"merged-work","state":"running","checkout_root":"/r","checkpoint":"b0+d1","worktree":null}]}`;
    final h = stubHost({
        "magus ls jobs -o json": Ran{ stdout = noWorktree },
        "/r: git rev-parse HEAD": Ran{ stdout = "h1\n" },
        "/r: git merge-base --is-ancestor h1 bbb": Ran{ code = 1 },
        "/r: git merge-tree --write-tree --merge-base b0 bbb h1": Ran{ stdout = "t1\n" },
        "/r: git rev-parse bbb^\{tree}": Ran{ stdout = "t1\n" },
    }, stamps: {}, calls: calls);
    final kept = endMergedRows(h, dir: "/c", onto: "bbb", did: did);
    assert\isTrue(kept.error == null, message: "settled");
    assert\equal(kept.value!.len(), want: 0, message: "none left");
    assert\equal(did, want: ["ended running row merged-work: its work since b0 is already in bbb, merged as other commits"], message: "said");
    assert\equal(calls.indexOf("magus job exit merged-work") != null, want: true, message: "ended");
}

test "a merge the checkout's git cannot run fails loudly" {
    final calls = mut [<str>];
    final did = mut [<str>];
    final h = stubHost({
        "magus ls jobs -o json": Ran{ stdout = ROWS },
        "/r: git rev-parse HEAD": Ran{ stdout = "h1\n" },
        "/r: git merge-base --is-ancestor h1 bbb": Ran{ code = 1 },
        "/r: git merge-tree --write-tree --merge-base b0 bbb h1": Ran{ code = 129, stderr = "unknown option" },
    }, stamps: {}, calls: calls);
    final res = endMergedRows(h, dir: "/c", onto: "bbb", did: did);
    assert\isTrue(res.error != null and res.error!.message.indexOf("unknown option") != null, message: "named");
}

test "a running row not yet in the target, at its base, or unreadable stays running" {
    final calls = mut [<str>];
    final did = mut [<str>];
    final notYet = stubHost({
        "magus ls jobs -o json": Ran{ stdout = ROWS },
        "/r: git rev-parse HEAD": Ran{ stdout = "h1\n" },
        "/r: git merge-base --is-ancestor h1 bbb": Ran{ code = 1 },
        "/r: git merge-tree --write-tree --merge-base b0 bbb h1": Ran{ code = 1, stdout = "t9\n" },
    }, stamps: {}, calls: calls);
    assert\equal(endMergedRows(notYet, dir: "/c", onto: "bbb", did: did).value!, want: ["merged-work (its head is not in the target yet)"], message: "not yet");
    final moreWork = stubHost({
        "magus ls jobs -o json": Ran{ stdout = ROWS },
        "/r: git rev-parse HEAD": Ran{ stdout = "h1\n" },
        "/r: git merge-base --is-ancestor h1 bbb": Ran{ code = 1 },
        "/r: git merge-tree --write-tree --merge-base b0 bbb h1": Ran{ stdout = "t9\n" },
        "/r: git rev-parse bbb^\{tree}": Ran{ stdout = "t1\n" },
    }, stamps: {}, calls: calls);
    assert\equal(endMergedRows(moreWork, dir: "/c", onto: "bbb", did: did).value!, want: ["merged-work (its head is not in the target yet)"], message: "work the target lacks");
    final atBase = stubHost({
        "magus ls jobs -o json": Ran{ stdout = ROWS },
        "/r: git rev-parse HEAD": Ran{ stdout = "b0\n" },
    }, stamps: {}, calls: calls);
    assert\equal(endMergedRows(atBase, dir: "/c", onto: "bbb", did: did).value!, want: ["merged-work (it has committed nothing yet)"], message: "at base");
    final gone = stubHost({
        "magus ls jobs -o json": Ran{ stdout = ROWS },
        "/r: git rev-parse HEAD": Ran{ code = 128, stderr = "not a git repository" },
    }, stamps: {}, calls: calls);
    assert\equal(endMergedRows(gone, dir: "/c", onto: "bbb", did: did).value!, want: ["merged-work (its checkout /r cannot be read)"], message: "unreadable");
    assert\equal(calls.indexOf("magus job exit merged-work"), want: null, message: "none ended");
}

test "a row that will not end fails loudly" {
    final calls = mut [<str>];
    final did = mut [<str>];
    final h = stubHost({
        "magus ls jobs -o json": Ran{ stdout = ROWS },
        "/r: git rev-parse HEAD": Ran{ stdout = "h1\n" },
        "magus job exit merged-work": Ran{ code = 1, stderr = "holds uncommitted work" },
    }, stamps: {}, calls: calls);
    final res = endMergedRows(h, dir: "/c", onto: "bbb", did: did);
    assert\isTrue(res.error != null and res.error!.message.indexOf("holds uncommitted work") != null, message: "named");
}
