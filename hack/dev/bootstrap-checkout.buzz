// Cost: two Go compiles of magus in the checkout, a minute or more on a cold build cache.
//
// Builds ./magus in a job's checkout at the checkout's own revision, for a fork made at a
// checkpoint no built binary matches. It runs the go-run bootstrap inside the checkout, so
// the binary carries the guard rules and spells of that revision, then checks that
// `./magus version` names the checkout's HEAD.
//
//	magus buzz hack/dev/bootstrap-checkout.buzz -- (--checkout <dir> | --here) [--restart | --gate-ready]
//
// --gate-ready makes the checkout ready to gate instead (gateReady): the build only when ./magus
// is not at HEAD, then pools, untracked skill installs the placed ./magus would write differently,
// the graph and the symbol digest. run-gate, rebase-branches-onto-base, merge-base-into-branches
// and land-commits call it before they gate.
//
// The daemon stops before a build, so a project lock it holds cannot fail the build with exit 75.
// --here builds in the current checkout, which must be clean. --restart ends with the daemon
// started on the new binary (and, outside --gate-ready, checks `version` again), since the
// daemon has no hot reload. When the checkout has a mise.toml and mise is on PATH, it runs
// `mise trust <dir>/mise.toml` first, because untrusted config fails the build without
// naming mise.
namespace bootstrapcheckout;

import "encoding/json";
import "flags";
import "fs";
import "proc";
import "std";
import "vcs";

import "assert";

final USAGE = "usage: magus buzz hack/dev/bootstrap-checkout.buzz -- (--checkout <dir> | --here) [--restart | --gate-ready]";
final HELP = "cost: two Go compiles of magus in the checkout\n{USAGE}";

final SKILL_DIRS = [".claude/skills", ".agents/skills", ".opencode/skills"];
final STAMP = "generated by: magus agent install";

// bootstrapArgv is ward.BootstrapCommand as argv for env, which sets the experiment
// internal/json needs without a shell.
export fun bootstrapArgv() > [str] {
    return ["GOEXPERIMENT=jsonv2", "go", "run", "-trimpath", "./cmd/magus", "run", "go-build", "--no-cache", "."];
}

// miseTrustArgv is the argv that trusts the checkout's mise.toml, [] when mise has nothing to trust.
export fun miseTrustArgv(dir: str, hasMise: bool, hasConfig: bool) > [str] {
    if (!hasMise or !hasConfig) {
        return [];
    }
    return ["trust", "{dir}/mise.toml"];
}

// targetProblem is why the flags name no single checkout, "" when they name one.
export fun targetProblem(checkout: str, here: bool) > str {
    if (here and checkout != "") {
        return "bootstrap-checkout: --here and --checkout are exclusive";
    }
    if (!here and checkout == "") {
        return "bootstrap-checkout: --checkout or --here is required";
    }
    return "";
}

// dirtyRefusal is why a checkout holding uncommitted changes gets no binary, "" when it
// holds none: the binary would carry changes its HEAD does not.
export fun dirtyRefusal(dir: str, porcelain: str) > str {
    final changed = mut [<str>];
    foreach (line in porcelain.split("\n")) {
        if (line.trim() != "") {
            changed.append(line.trim());
        }
    }
    if (changed.len() == 0) {
        return "";
    }
    return "bootstrap-checkout: {dir} holds {changed.len()} uncommitted change(s) ({changed.join(", ")}), which a binary stamped with its HEAD would carry unrecorded: commit or drop them first";
}

// versionMismatch is why the built binary is not the checkout's, "" when its commit is head
// and nothing uncommitted went into it.
export fun versionMismatch(versionJSON: str, head: str) > str !> any {
    final j = json\parse(versionJSON);
    final commit: str = j["commit"] ?? "";
    final version: str = j["version"] ?? "";
    if (commit == "" or !(commit.startsWith(head) or head.startsWith(commit))) {
        return "bootstrap-checkout: the built ./magus names commit {commit}, not the checkout's HEAD {head}";
    }
    if (version.endsWith("-dirty")) {
        return "bootstrap-checkout: the built ./magus is {version}, built from uncommitted changes";
    }
    return "";
}

// builtAt reports whether `magus version -o json` names head as the binary's commit. A -dirty
// build at head counts: the gate's own go-build makes one from the tree it gates.
export fun builtAt(versionJSON: str, head: str) > bool !> any {
    final commit: str = json\parse(versionJSON)["commit"] ?? "";
    return commit != "" and (commit.startsWith(head) or head.startsWith(commit));
}

// skillInstalls are the skill directories an untracked SKILL.md under SKILL_DIRS names, from
// `git ls-files --others`.
export fun skillInstalls(untracked: [str]) > [str] {
    final found = mut [<str>];
    foreach (path in untracked) {
        foreach (root in SKILL_DIRS) {
            if (!path.startsWith("{root}/")) {
                continue;
            }
            final rest = path.sub(root.len() + 1);
            if (rest.endsWith("/SKILL.md") and rest.indexOf("/") == rest.len() - 9) {
                found.append(fs\dirname(path));
            }
        }
    }
    return found;
}

// Ran is one command's result, what a stubbed Host answers.
export object Ran {
    stdout: str = "",
    stderr: str = "",
    code: int = 0,
}

// Host is every call gateReady makes, so a test answers them. git and magus never raise on a
// failed command; gateReady reads code. magus runs the checkout's own ./magus.
export object Host {
    git: fun (dir: str, args: [str]) > Ran !> any,
    magus: fun (dir: str, args: [str]) > Ran !> any,
    build: fun (dir: str) > str !> any,
    stampOf: fun (path: str) > str !> any,
    freshSkills: fun (dir: str) > str !> any,
    removeDir: fun (path: str) > void !> any,
}

// stampLine is the generated-by line of a skill file's text, "" when it carries none.
export fun stampLine(text: str) > str {
    foreach (line in text.split("\n")) {
        if (line.indexOf(STAMP) != null) {
            return line.trim();
        }
    }
    return "";
}

fun lines(text: str) > [str] {
    final acc = mut [<str>];
    foreach (line in text.split("\n")) {
        if (line.trim() != "") {
            acc.append(line.trim());
        }
    }
    return acc;
}

fun must(r: Ran, what: str) > str !> any {
    if (r.code != 0) {
        throw "gate-ready: {what}: exit {r.code}: {r.stderr}{r.stdout}";
    }
    return r.stdout;
}

// stopDaemon stops the checkout's daemon when one runs, so a project lock it holds cannot fail
// the build with exit 75. It raises when a running daemon will not stop.
fun stopDaemon(h: Host, dir: str) > str !> any {
    if (h.magus(dir, args: ["server", "status"]).code != 0) {
        return "no daemon was running";
    }
    must(h.magus(dir, args: ["server", "stop"]), what: "magus server stop");
    return "stopped the daemon";
}

fun startDaemon(h: Host, dir: str) > str !> any {
    must(h.magus(dir, args: ["server", "start"]), what: "magus server start");
    return "started the daemon";
}

// gateReady makes the checkout at dir ready to gate, and returns a line per thing it did. A
// ./magus built at another commit than the tree fails the gate's symbol index with MGS7003, so
// it builds one at HEAD when the binary is not, stops the pool parents other builds left, removes
// the untracked skill installs whose stamp differs from the one the placed ./magus writes (never
// a tracked file, never a current install), then builds the graph and the symbol digest. Running
// it twice does the build and the removals once. The daemon stops before a build, and with
// restart it is running again at the end.
export fun gateReady(h: Host, dir: str, restart: bool = false) > [str] !> any {
    final did = mut [<str>];
    final head = must(h.git(dir, args: ["rev-parse", "HEAD"]), what: "git rev-parse HEAD").trim();
    final version = h.magus(dir, args: ["version", "-o", "json"]);
    final built = version.code == 0 and (builtAt(version.stdout, head: head) catch false);
    if (restart or !built) {
        did.append(stopDaemon(h, dir: dir));
    }
    if (built) {
        did.append("./magus is built at HEAD {head}");
    } else {
        did.append(h.build(dir));
    }
    must(h.magus(dir, args: ["server", "stop", "--pools"]), what: "magus server stop --pools");
    did.append("stopped the pool parents of other builds");
    final others = lines(must(h.git(dir, args: ["ls-files", "--others", "--"] + SKILL_DIRS), what: "git ls-files --others"));
    var fresh = "";
    foreach (skill in skillInstalls(others)) {
        final tracked = lines(must(h.git(dir, args: ["ls-files", "--", skill]), what: "git ls-files {skill}"));
        final stamp = h.stampOf(fs\join(dir, name: "{skill}/SKILL.md"));
        if (tracked.len() > 0 or stamp == "") {
            continue;
        }
        if (fresh == "") {
            fresh = h.freshSkills(dir);
        }
        if (stamp != h.stampOf(fs\join(fresh, name: "{skill}/SKILL.md"))) {
            h.removeDir(fs\join(dir, name: skill));
            did.append("removed the stale untracked skill install {skill}");
        }
    }
    must(h.magus(dir, args: ["graph", "build"]), what: "magus graph build");
    did.append("built the graph");
    must(h.magus(dir, args: ["run", "symbol-digest-generate", "."]), what: "magus run symbol-digest-generate .");
    did.append("generated the symbol digest");
    if (restart) {
        did.append(startDaemon(h, dir: dir));
    }
    return did;
}

export fun liveHost() > Host {
    return Host{
        git = fun (dir: str, args: [str]) > Ran !> any {
            final r = vcs\cmd(args, opts: {"dir": dir, "quiet": true, "allow_failure": true});
            return Ran{ stdout = r.stdout, stderr = r.stderr, code = r.code };
        },
        magus = fun (dir: str, args: [str]) > Ran !> any {
            final bin = fs\join(dir, name: "magus");
            if (!fs\isFile(bin)) {
                return Ran{ stderr = "{bin} does not exist", code = 127 };
            }
            final r = proc\exec(bin, args: args, dir: dir, opts: {"quiet": true, "allow_failure": true});
            return Ran{ stdout = r.stdout, stderr = r.stderr, code = r.code };
        },
        build = fun (dir: str) > str !> any {
            return build(dir);
        },
        stampOf = fun (path: str) > str !> any {
            if (!fs\isFile(path)) {
                return "";
            }
            return stampLine(fs\readFile(path));
        },
        freshSkills = fun (dir: str) > str !> any {
            final root = fs\tempDir("fresh-skills-");
            final r = proc\exec(fs\join(dir, name: "magus"), args: ["agent", "install", "--dir", root] + SKILL_DIRS, dir: dir, opts: {"quiet": true, "allow_failure": true});
            if (r.code != 0) {
                throw "gate-ready: magus agent install into {root}: exit {r.code}: {r.stderr}{r.stdout}";
            }
            return root;
        },
        removeDir = fun (path: str) > void !> any {
            fs\removeAll(path);
        },
    };
}

fun hasMise() > bool {
    try {
        proc\which("mise");
        return true;
    } catch (err: any) {
        return false;
    }
}

fun build(dir: str) > str !> any {
    if (!fs\isDir(dir)) {
        throw "bootstrap-checkout: {dir} is not a directory\n{USAGE}";
    }
    if (vcs\name() != "git") {
        throw "bootstrap-checkout: builds in git checkouts, and this one is {vcs\name()}";
    }
    final refused = dirtyRefusal(dir, porcelain: vcs\cmd(["status", "--porcelain"], opts: {"dir": dir, "quiet": true}).stdout);
    if (refused != "") {
        throw refused;
    }
    final head = vcs\cmd(["rev-parse", "HEAD"], opts: {"dir": dir, "quiet": true}).stdout.trim();
    final trust = miseTrustArgv(dir, hasMise: hasMise(), hasConfig: fs\isFile(fs\join(dir, name: "mise.toml")));
    if (trust.len() > 0) {
        proc\exec("mise", args: trust, dir: dir);
    }
    proc\exec("env", args: bootstrapArgv(), dir: dir);
    final bin = fs\join(dir, name: "magus");
    final mismatch = versionMismatch(proc\exec(bin, args: ["version", "-o", "json"], dir: dir, opts: {"quiet": true}).stdout, head: head);
    if (mismatch != "") {
        throw mismatch;
    }
    return "placed {bin}, built at {head}";
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--here", "--restart", "--gate-ready"], valued: ["--checkout"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "bootstrap-checkout: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final here = parsed.values["--here"] != null;
    final checkout = parsed.values["--checkout"] ?? "";
    final unnamed = targetProblem(checkout, here: here);
    if (unnamed != "") {
        throw "{unnamed}\n{USAGE}";
    }
    final dir = if (here) vcs\root() else checkout;
    final restart = parsed.values["--restart"] != null;
    final h = liveHost();
    if (parsed.values["--gate-ready"] != null) {
        foreach (line in gateReady(h, dir: dir, restart: restart)) {
            std\print(line);
        }
        return;
    }
    std\print(stopDaemon(h, dir: dir));
    std\print(build(dir));
    if (restart) {
        std\print(startDaemon(h, dir: dir));
        final head = vcs\cmd(["rev-parse", "HEAD"], opts: {"dir": dir, "quiet": true}).stdout.trim();
        final stale = versionMismatch(h.magus(dir, args: ["version", "-o", "json"]).stdout, head: head);
        if (stale != "") {
            throw stale;
        }
    }
}

// stubHost answers gateReady from a table keyed by the command line and records each call;
// a command the table lacks exits 0 with no output, so a daemon is running unless the table
// says `server status` fails. stamps maps a SKILL.md path to its generated-by line.
fun stubHost(answers: {str: Ran}, stamps: {str: str}, calls: mut [str]) > Host {
    return Host{
        git = fun (dir: str, args: [str]) > Ran !> any {
            final line = "git {args.join(" ")}";
            calls.append(line);
            return answers[line] ?? Ran{};
        },
        magus = fun (dir: str, args: [str]) > Ran !> any {
            final line = "magus {args.join(" ")}";
            calls.append(line);
            return answers[line] ?? Ran{};
        },
        build = fun (dir: str) > str !> any {
            calls.append("build {dir}");
            return "placed {dir}/magus";
        },
        stampOf = fun (path: str) > str !> any {
            return stamps[path] ?? "";
        },
        freshSkills = fun (dir: str) > str !> any {
            calls.append("fresh {dir}");
            return "/fresh";
        },
        removeDir = fun (path: str) > void !> any {
            calls.append("remove {path}");
        },
    };
}

test "a binary at HEAD is kept, a binary elsewhere or missing is rebuilt" {
    assert\equal(builtAt(`{"commit": "abc123def"}`, head: "abc123def") catch false, want: true, message: "match");
    assert\equal(builtAt(`{"commit": "abc123", "version": "v0.5.0-dirty"}`, head: "abc123def") catch false, want: true, message: "dirty at head");
    assert\equal(builtAt(`{"commit": "def456"}`, head: "abc123") catch false, want: false, message: "other commit");
    assert\equal(builtAt("not json", head: "abc123") catch false, want: false, message: "unreadable");
}

test "skill installs are the directories of an untracked SKILL.md one level under a skill root" {
    final got = skillInstalls([".claude/skills/magus-run/SKILL.md", ".claude/skills/magus-run/ref.md",
        ".agents/skills/magus-query/SKILL.md", "docs/skills/x/SKILL.md", ".claude/skills/a/b/SKILL.md"]);
    assert\equal(got, want: [".claude/skills/magus-run", ".agents/skills/magus-query"], message: "dirs");
}

test "the stamp is the generated-by line, and a file without one has none" {
    assert\equal(stampLine("body\n<!-- generated by: magus agent install; skill-content: abc -->\n"), want: "<!-- generated by: magus agent install; skill-content: abc -->", message: "stamp");
    assert\equal(stampLine("body only\n"), want: "", message: "none");
}

test "gate-ready stops the daemon, rebuilds a skewed binary, removes only untracked installs the placed binary would write differently, then builds the graph and digest" {
    final calls = mut [<str>];
    final h = stubHost({
        "git rev-parse HEAD": Ran{ stdout = "abc123\n" },
        "magus version -o json": Ran{ stdout = `{"commit": "def456"}` },
        "git ls-files --others -- .claude/skills .agents/skills .opencode/skills": Ran{ stdout = ".claude/skills/magus-run/SKILL.md\n.claude/skills/fresh/SKILL.md\n.claude/skills/plain/SKILL.md\n.claude/skills/kept/SKILL.md\n" },
        "git ls-files -- .claude/skills/kept": Ran{ stdout = ".claude/skills/kept/ref.md\n" },
    }, stamps: {
        "/c/.claude/skills/magus-run/SKILL.md": "v1",
        "/fresh/.claude/skills/magus-run/SKILL.md": "v2",
        "/c/.claude/skills/fresh/SKILL.md": "v2",
        "/fresh/.claude/skills/fresh/SKILL.md": "v2",
        "/c/.claude/skills/kept/SKILL.md": "v1",
    }, calls: calls);
    final did = gateReady(h, dir: "/c", restart: false);
    assert\equal(did, want: [
        "stopped the daemon",
        "placed /c/magus",
        "stopped the pool parents of other builds",
        "removed the stale untracked skill install .claude/skills/magus-run",
        "built the graph",
        "generated the symbol digest",
    ], message: "did");
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("remove")), want: ["remove /c/.claude/skills/magus-run"], message: "one removal");
    assert\equal(calls.indexOf("magus server stop")! < calls.indexOf("build /c")!, want: true, message: "daemon stops before the build");
    assert\equal(calls[calls.len() - 1], want: "magus run symbol-digest-generate .", message: "digest last");
}

test "gate-ready keeps a binary at HEAD and says so" {
    final calls = mut [<str>];
    final h = stubHost({
        "git rev-parse HEAD": Ran{ stdout = "abc123\n" },
        "magus version -o json": Ran{ stdout = `{"commit": "abc123"}` },
    }, stamps: {}, calls: calls);
    assert\equal(gateReady(h, dir: "/c", restart: false)[0], want: "./magus is built at HEAD abc123", message: "kept");
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("build")).len(), want: 0, message: "no build");
    assert\equal(calls.indexOf("magus server stop"), want: null, message: "daemon left alone");
}

test "gate-ready with restart stops the daemon, and ends with it running, saying so" {
    final calls = mut [<str>];
    final h = stubHost({
        "git rev-parse HEAD": Ran{ stdout = "abc123\n" },
        "magus version -o json": Ran{ stdout = `{"commit": "abc123"}` },
        "magus server status": Ran{ code = 1 },
    }, stamps: {}, calls: calls);
    final did = gateReady(h, dir: "/c", restart: true);
    assert\equal(did[0], want: "no daemon was running", message: "first");
    assert\equal(did[did.len() - 1], want: "started the daemon", message: "last");
    assert\equal(calls[calls.len() - 1], want: "magus server start", message: "start last");
}

test "a daemon that will not start fails gate-ready loudly" {
    final h = stubHost({
        "git rev-parse HEAD": Ran{ stdout = "abc123\n" },
        "magus version -o json": Ran{ stdout = `{"commit": "abc123"}` },
        "magus server start": Ran{ code = 1, stderr = "no socket" },
    }, stamps: {}, calls: mut [<str>]);
    var why = "";
    try {
        gateReady(h, dir: "/c", restart: true);
    } catch (e: str) {
        why = e;
    }
    assert\equal(why, want: "gate-ready: magus server start: exit 1: no socket", message: why);
}

test "a failed graph build stops gate-ready, naming the command" {
    final h = stubHost({
        "git rev-parse HEAD": Ran{ stdout = "abc123\n" },
        "magus version -o json": Ran{ stdout = `{"commit": "abc123"}` },
        "magus graph build": Ran{ code = 1, stderr = "boom" },
    }, stamps: {}, calls: mut [<str>]);
    var why = "";
    try {
        gateReady(h, dir: "/c", restart: false);
    } catch (e: str) {
        why = e;
    }
    assert\equal(why, want: "gate-ready: magus graph build: exit 1: boom", message: why);
}

test "the build is the go-run bootstrap, run through env rather than a shell" {
    assert\equal(bootstrapArgv().join(" "), want: "GOEXPERIMENT=jsonv2 go run -trimpath ./cmd/magus run go-build --no-cache .", message: "argv");
}

test "a clean checkout is not refused" {
    assert\equal(dirtyRefusal("/w/c", porcelain: "\n"), want: "", message: "clean");
}

test "a dirty checkout is refused, naming each change" {
    final why = dirtyRefusal("/w/c", porcelain: " M a.go\n?? b.go\n");
    assert\equal(why.indexOf("/w/c holds 2 uncommitted change(s) (M a.go, ?? b.go)") != null, want: true, message: why);
}

test "the built binary must name the checkout's HEAD" {
    assert\equal(versionMismatch(`{"commit": "abc123", "version": "v0.5.0-1-gabc123"}`, head: "abc123") catch "x", want: "", message: "match");
    final other = versionMismatch(`{"commit": "def456", "version": "v0.5.0"}`, head: "abc123") catch "x";
    assert\equal(other.indexOf("names commit def456") != null, want: true, message: other);
    final dirty = versionMismatch(`{"commit": "abc123", "version": "v0.5.0-dirty"}`, head: "abc123") catch "x";
    assert\equal(dirty.indexOf("uncommitted") != null, want: true, message: dirty);
}

test "mise trust names the checkout's mise.toml, and only when mise and the file are there" {
    assert\equal(miseTrustArgv("/w/c", hasMise: true, hasConfig: true), want: ["trust", "/w/c/mise.toml"], message: "both");
    assert\equal(miseTrustArgv("/w/c", hasMise: false, hasConfig: true), want: [], message: "no mise");
    assert\equal(miseTrustArgv("/w/c", hasMise: true, hasConfig: false), want: [], message: "no config");
}

test "exactly one of --checkout and --here names the target" {
    assert\equal(targetProblem("/w/c", here: false), want: "", message: "checkout");
    assert\equal(targetProblem("", here: true), want: "", message: "here");
    assert\equal(targetProblem("/w/c", here: true), want: "bootstrap-checkout: --here and --checkout are exclusive", message: "both");
    assert\equal(targetProblem("", here: false), want: "bootstrap-checkout: --checkout or --here is required", message: "neither");
}
