// Cost: two Go compiles of magus in the checkout, a minute or more on a cold build cache.
//
// Builds ./magus in a job's checkout at the checkout's own revision, for a fork made at a
// checkpoint no built binary matches. It runs the go-run bootstrap inside the checkout, so
// the binary carries the guard rules and spells of that revision, then checks that
// `./magus version` names the checkout's HEAD.
//
//	magus buzz hack/dev/bootstrap-checkout.buzz -- (--checkout <dir> | --here) [--restart]
//
// --here builds in the current checkout, which must be clean. --restart then stops and
// starts the daemon with the new binary and checks `version` again, since the daemon has
// no hot reload. When the checkout has a mise.toml and mise is on PATH, it runs
// `mise trust <dir>/mise.toml` first, because untrusted config fails the build without
// naming mise.
namespace bootstrapcheckout;

import "encoding/json";
import "flags";
import "fs";
import "proc";
import "std";
import "vcs";

import "assert";

final USAGE = "usage: magus buzz hack/dev/bootstrap-checkout.buzz -- (--checkout <dir> | --here) [--restart]";
final HELP = "cost: two Go compiles of magus in the checkout\n{USAGE}";

// bootstrapArgv is ward.BootstrapCommand as argv for env, which sets the experiment
// internal/json needs without a shell.
export fun bootstrapArgv() > [str] {
    return ["GOEXPERIMENT=jsonv2", "go", "run", "-trimpath", "./cmd/magus", "run", "go-build", "--no-cache", "."];
}

// miseTrustArgv is the argv that trusts the checkout's mise.toml, [] when mise has nothing to trust.
export fun miseTrustArgv(dir: str, hasMise: bool, hasConfig: bool) > [str] {
    if (!hasMise or !hasConfig) {
        return [];
    }
    return ["trust", "{dir}/mise.toml"];
}

// targetProblem is why the flags name no single checkout, "" when they name one.
export fun targetProblem(checkout: str, here: bool) > str {
    if (here and checkout != "") {
        return "bootstrap-checkout: --here and --checkout are exclusive";
    }
    if (!here and checkout == "") {
        return "bootstrap-checkout: --checkout or --here is required";
    }
    return "";
}

// dirtyRefusal is why a checkout holding uncommitted changes gets no binary, "" when it
// holds none: the binary would carry changes its HEAD does not.
export fun dirtyRefusal(dir: str, porcelain: str) > str {
    final changed = mut [<str>];
    foreach (line in porcelain.split("\n")) {
        if (line.trim() != "") {
            changed.append(line.trim());
        }
    }
    if (changed.len() == 0) {
        return "";
    }
    return "bootstrap-checkout: {dir} holds {changed.len()} uncommitted change(s) ({changed.join(", ")}), which a binary stamped with its HEAD would carry unrecorded: commit or drop them first";
}

// versionMismatch is why the built binary is not the checkout's, "" when its commit is head
// and nothing uncommitted went into it.
export fun versionMismatch(versionJSON: str, head: str) > str !> any {
    final j = json\parse(versionJSON);
    final commit: str = j["commit"] ?? "";
    final version: str = j["version"] ?? "";
    if (commit == "" or !(commit.startsWith(head) or head.startsWith(commit))) {
        return "bootstrap-checkout: the built ./magus names commit {commit}, not the checkout's HEAD {head}";
    }
    if (version.endsWith("-dirty")) {
        return "bootstrap-checkout: the built ./magus is {version}, built from uncommitted changes";
    }
    return "";
}

fun hasMise() > bool {
    try {
        proc\which("mise");
        return true;
    } catch (err: any) {
        return false;
    }
}

fun build(dir: str, restart: bool) > str !> any {
    if (!fs\isDir(dir)) {
        throw "bootstrap-checkout: {dir} is not a directory\n{USAGE}";
    }
    if (vcs\name() != "git") {
        throw "bootstrap-checkout: builds in git checkouts, and this one is {vcs\name()}";
    }
    final refused = dirtyRefusal(dir, porcelain: vcs\cmd(["status", "--porcelain"], opts: {"dir": dir, "quiet": true}).stdout);
    if (refused != "") {
        throw refused;
    }
    final head = vcs\cmd(["rev-parse", "HEAD"], opts: {"dir": dir, "quiet": true}).stdout.trim();
    final trust = miseTrustArgv(dir, hasMise: hasMise(), hasConfig: fs\isFile(fs\join(dir, name: "mise.toml")));
    if (trust.len() > 0) {
        proc\exec("mise", args: trust, dir: dir);
    }
    proc\exec("env", args: bootstrapArgv(), dir: dir);
    final bin = fs\join(dir, name: "magus");
    final mismatch = versionMismatch(proc\exec(bin, args: ["version", "-o", "json"], dir: dir, opts: {"quiet": true}).stdout, head: head);
    if (mismatch != "") {
        throw mismatch;
    }
    if (restart) {
        proc\exec(bin, args: ["server", "stop"], dir: dir);
        proc\exec(bin, args: ["server", "start"], dir: dir);
        final stale = versionMismatch(proc\exec(bin, args: ["version", "-o", "json"], dir: dir, opts: {"quiet": true}).stdout, head: head);
        if (stale != "") {
            throw stale;
        }
        return "placed {bin}, built at {head}, daemon restarted";
    }
    return "placed {bin}, built at {head}";
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--here", "--restart"], valued: ["--checkout"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "bootstrap-checkout: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final here = parsed.values["--here"] != null;
    final checkout = parsed.values["--checkout"] ?? "";
    final unnamed = targetProblem(checkout, here: here);
    if (unnamed != "") {
        throw "{unnamed}\n{USAGE}";
    }
    std\print(build(if (here) vcs\root() else checkout, restart: parsed.values["--restart"] != null));
}

test "the build is the go-run bootstrap, run through env rather than a shell" {
    assert\equal(bootstrapArgv().join(" "), want: "GOEXPERIMENT=jsonv2 go run -trimpath ./cmd/magus run go-build --no-cache .", message: "argv");
}

test "a clean checkout is not refused" {
    assert\equal(dirtyRefusal("/w/c", porcelain: "\n"), want: "", message: "clean");
}

test "a dirty checkout is refused, naming each change" {
    final why = dirtyRefusal("/w/c", porcelain: " M a.go\n?? b.go\n");
    assert\equal(why.indexOf("/w/c holds 2 uncommitted change(s) (M a.go, ?? b.go)") != null, want: true, message: why);
}

test "the built binary must name the checkout's HEAD" {
    assert\equal(versionMismatch(`{"commit": "abc123", "version": "v0.5.0-1-gabc123"}`, head: "abc123") catch "x", want: "", message: "match");
    final other = versionMismatch(`{"commit": "def456", "version": "v0.5.0"}`, head: "abc123") catch "x";
    assert\equal(other.indexOf("names commit def456") != null, want: true, message: other);
    final dirty = versionMismatch(`{"commit": "abc123", "version": "v0.5.0-dirty"}`, head: "abc123") catch "x";
    assert\equal(dirty.indexOf("uncommitted") != null, want: true, message: dirty);
}

test "mise trust names the checkout's mise.toml, and only when mise and the file are there" {
    assert\equal(miseTrustArgv("/w/c", hasMise: true, hasConfig: true), want: ["trust", "/w/c/mise.toml"], message: "both");
    assert\equal(miseTrustArgv("/w/c", hasMise: false, hasConfig: true), want: [], message: "no mise");
    assert\equal(miseTrustArgv("/w/c", hasMise: true, hasConfig: false), want: [], message: "no config");
}

test "exactly one of --checkout and --here names the target" {
    assert\equal(targetProblem("/w/c", here: false), want: "", message: "checkout");
    assert\equal(targetProblem("", here: true), want: "", message: "here");
    assert\equal(targetProblem("/w/c", here: true), want: "bootstrap-checkout: --here and --checkout are exclusive", message: "both");
    assert\equal(targetProblem("", here: false), want: "bootstrap-checkout: --checkout or --here is required", message: "neither");
}
