test "the seed source is the first other checkout holding an index" {
    final holds = fun (path: str) > bool => path != "/empty";
    assert\equal(seedSource(["/c", "/empty", "/base", "/main"], dir: "/c", holdsIndex: holds), want: "/base", message: "skips itself and an empty one");
    assert\equal(seedSource(["", "/c"], dir: "/c", holdsIndex: holds), want: null, message: "none");
}

test "a seed copies the index, drops a backoff record, and keeps what the checkout holds" {
    final base = fs\tempDir("seed-base-");
    final dir = fs\tempDir("seed-dir-");
    fs\mkdirAll("{base}/{SYMBOLS}/abc");
    fs\writeFile("{base}/{SYMBOLS}/abc/scip.pack", content: "pack");
    fs\writeFile("{base}/{SYMBOLS}/abc/scip.pack.refresh-failed", content: "boom");

    assert\equal(seedSymbolIndex(base, dir: dir).value, want: "seeded the symbol index from {base}", message: "seeded");
    assert\equal(fs\readFile("{dir}/{SYMBOLS}/abc/scip.pack"), want: "pack", message: "pack copied");
    assert\equal(fs\exists("{dir}/{SYMBOLS}/abc/scip.pack.refresh-failed"), want: false, message: "record dropped");
    assert\equal(fs\exists("{dir}/{SYMBOLS}.seeding"), want: false, message: "landed");

    fs\writeFile("{base}/{SYMBOLS}/abc/scip.pack", content: "newer");
    assert\equal(seedSymbolIndex(base, dir: dir).value, want: "kept the symbol index {dir} already holds", message: "kept");
    assert\equal(fs\readFile("{dir}/{SYMBOLS}/abc/scip.pack"), want: "pack", message: "not overwritten");
}

test "a seed that cannot copy returns the error" {
    final dir = fs\tempDir("seed-dir-");
    final seeded = seedSymbolIndex("/nonexistent-seed-base", dir: dir);
    assert\equal(seeded.value, want: null, message: "no line");
    assert\equal(seeded.error != null, want: true, message: "error");
}

