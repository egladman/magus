// Cost: two Go compiles of magus in the checkout, a minute or more on a cold build cache.
//
// Builds ./magus in a job's checkout at the checkout's own revision, for a fork made at a
// checkpoint no built binary matches. It runs the go-run bootstrap inside the checkout, so
// the binary carries the guard rules and spells of that revision, then checks that
// `./magus version` names the checkout's HEAD, and installs every project's dependencies with it.
// It seeds the symbol index from the forking checkout.
//
//	magus buzz hack/dev/bootstrap-checkout.buzz --
//	    (--checkout <dir> | --here) [--restart | --verify-ready]
//
// --verify-ready (verifyReady) builds only when ./magus is not at HEAD. It
// then refreshes pools, stale skill installs, the graph and symbol digest.
// The rebase, merge and land scripts call it before they verify.
//
// The daemon stops before a build, so a project lock it holds cannot fail the build with exit 75.
// --here builds in the current checkout, which must be clean. --restart ends with the daemon
// started on the new binary (outside --verify-ready, it checks `version`
// again), since the
// daemon has no hot reload. When the checkout has a mise.toml and mise is on PATH, it runs
// `mise trust <dir>/mise.toml` first, because untrusted config fails the build without
// naming mise.
//
// A build that fails to compile may only need its generated bindings refreshed, which no
// magus can do while none builds: it then runs the //go:generate lines of
// cmd/magus-utils/boundary_types.go and builds once more, leaving the regenerated paths
// uncommitted and naming them (compile).
namespace bootstrapcheckout;

import "encoding/json";
import "flags";
import "fs";
import "os";
import "proc";
import "result";
import "std";
import "vcs";

import "assert";

final USAGE = "usage: magus buzz hack/dev/bootstrap-checkout.buzz -- (--checkout <dir> | --here) [--restart | --verify-ready | --recover | --onto <ref>] [--install <p,q|none>]";
final HELP = "cost: two Go compiles of magus in the checkout\n{USAGE}\n\n--onto <ref> resumes work in a checkout made for something else: it fast-forwards the clean checkout onto <ref> (a dirty tree or a non-fast-forward refuses, and nothing is reset), places ./magus (built when it cannot load the tree), installs dependencies and every harness, ends running rows whose head is already in <ref>, then prunes rows nobody collected like `magus job prune`. It prints a line per thing done. It never fetches.\n--recover only places ./magus from a dirty tree: nothing moves and no row changes. --onto shares its daemon stop and build, and refuses a dirty tree.";
final SUMMARY = "build ./magus in a checkout at its own revision";
final SERVES = ["code:MGS1021 -- --checkout \{checkout}"];

final SKILL_DIRS = [".claude/skills", ".agents/skills", ".opencode/skills"];
final STAMP = "generated by: magus agent install";

final SYMBOLS = ".magus/symbols";

final GENERATE_SOURCES = ["cmd/magus-utils/boundary_types.go", "cmd/magus/main.go"];

// bootstrapArgv is ward.BootstrapCommand as argv for env, which sets the experiment
// internal/json needs without a shell.
export fun bootstrapArgv() > [str] {
    return ["GOEXPERIMENT=jsonv2", "go", "run", "-trimpath", "./cmd/magus", "run", "go-build", "--no-cache", "."];
}

// generateArgv is each //go:generate line of a Go source as argv for env, with the experiment
// internal/json needs. They are read rather than listed here, so a directive added to the
// source is run too.
export fun generateArgv(source: str) > [[str]] {
    final found: mut [[str]] = mut [];
    foreach (line in source.split("\n")) {
        final trimmed = line.trim();
        if (!trimmed.startsWith("//go:generate ")) {
            continue;
        }
        final argv = mut ["GOEXPERIMENT=jsonv2"];
        foreach (field in trimmed.sub(14).split(" ")) {
            if (field != "") {
                argv.append(field);
            }
        }
        found.append(argv);
    }
    return found;
}

// miseTrustArgv is the argv that trusts the checkout's mise.toml, [] when mise has nothing to trust.
export fun miseTrustArgv(dir: str, hasMise: bool, hasConfig: bool) > [str] {
    if (!hasMise or !hasConfig) {
        return [];
    }
    return ["trust", "{dir}/mise.toml"];
}

// targetProblem is why the flags name no single checkout, "" when they name one.
export fun targetProblem(checkout: str, here: bool) > str {
    if (here and checkout != "") {
        return "bootstrap-checkout: --here and --checkout are exclusive";
    }
    if (!here and checkout == "") {
        return "bootstrap-checkout: --checkout or --here is required";
    }
    return "";
}

// dirtyRefusal is why a checkout holding uncommitted changes gets no binary, "" when it
// holds none: the binary would carry changes its HEAD does not.
export fun dirtyRefusal(dir: str, porcelain: str, recovery: bool = false) > str {
    if (recovery) { return ""; }
    final changed = mut [<str>];
    foreach (line in porcelain.split("\n")) {
        if (line.trim() != "") {
            changed.append(line.trim());
        }
    }
    if (changed.len() == 0) {
        return "";
    }
    return "bootstrap-checkout: {dir} holds {changed.len()} uncommitted change(s) ({changed.join(", ")}), which a binary stamped with its HEAD would carry unrecorded: commit or drop them first";
}

// versionMismatch is why the built binary is not the checkout's, "" when its commit is head
// and nothing uncommitted went into it.
export fun versionMismatch(versionJSON: str, head: str, recovery: bool = false) > str !> any {
    final j = json\parse(versionJSON);
    final commit: str = j["commit"] ?? "";
    final version: str = j["version"] ?? "";
    if (commit == "" or !(commit.startsWith(head) or head.startsWith(commit))) {
        return "bootstrap-checkout: the built ./magus names commit {commit}, not the checkout's HEAD {head}";
    }
    if (version.endsWith("-dirty") and !recovery) {
        return "bootstrap-checkout: the built ./magus is {version}, built from uncommitted changes";
    }
    return "";
}

// regeneratedRefusal is why a build from a clean checkout came out -dirty: the bootstrap's
// generators rewrote tracked outputs the HEAD commit holds stale. It names each path and the
// commit that records them, "" when porcelain lists none.
export fun regeneratedRefusal(dir: str, porcelain: str) > str {
    final paths = regeneratedPaths(porcelain);
    if (paths.len() == 0) {
        return "";
    }
    return "bootstrap-checkout: the build regenerated {paths.len()} output(s) the commit holds stale ({paths.join(", ")}), so the binary is -dirty. The row may commit them when a target declares them as outputs of a source it wrote; any other path stays refused. Record them on the job's branch: git -C {dir} add {paths.join(" ")} && git -C {dir} commit -m '<msg>', then rerun the bootstrap";
}

// regeneratedPaths are the paths `git status --porcelain` lists. Each path follows the first
// space after the status, since a captured output can arrive with its leading blank status
// column trimmed, so a fixed offset would cut into the path.
fun regeneratedPaths(porcelain: str) > [str] {
    final paths = mut [<str>];
    foreach (line in porcelain.split("\n")) {
        final entry = line.trim();
        if (entry == "") {
            continue;
        }
        final space = entry.indexOf(" ");
        if (space == null) {
            paths.append(entry);
        } else {
            paths.append(entry.sub(space! + 1).trim());
        }
    }
    return paths;
}

// builtAt reports whether `magus version -o json` names head as the binary's commit. A -dirty
// build at head counts: the gate's own go-build makes one from the tree it gates.
export fun builtAt(versionJSON: str, head: str) > bool !> any {
    final commit: str = json\parse(versionJSON)["commit"] ?? "";
    return commit != "" and (commit.startsWith(head) or head.startsWith(commit));
}

// skillInstalls are the skill directories an untracked SKILL.md under SKILL_DIRS names, from
// `git ls-files --others`.
export fun skillInstalls(untracked: [str]) > [str] {
    final found = mut [<str>];
    foreach (path in untracked) {
        foreach (root in SKILL_DIRS) {
            if (!path.startsWith("{root}/")) {
                continue;
            }
            final rest = path.sub(root.len() + 1);
            if (rest.endsWith("/SKILL.md") and rest.indexOf("/") == rest.len() - 9) {
                found.append(fs\dirname(path));
            }
        }
    }
    return found;
}

// Ran is one command's result, what a stubbed Host answers.
export object Ran {
    stdout: str = "",
    stderr: str = "",
    code: int = 0,
}

// Host is every call verifyReady makes, so a test answers them. git and magus
// never raise on a
// failed command; verifyReady reads code. magus runs the checkout's own
// ./magus.
export object Host {
    git: fun (dir: str, args: [str]) > Ran !> any,
    magus: fun (dir: str, args: [str]) > Ran !> any,
    build: fun (dir: str) > str !> any,
    seed: fun (dir: str) > str !> any,
    stampOf: fun (path: str) > str !> any,
    freshSkills: fun (dir: str) > str !> any,
    removeDir: fun (path: str) > void !> any,
    exec: fun (dir: str, argv: [str]) > Ran !> any,
    readFile: fun (path: str) > str !> any,
    say: fun (line: str) > void,
    clock: fun () > double,
}

// stampLine is the generated-by line of a skill file's text, "" when it carries none.
export fun stampLine(text: str) > str {
    foreach (line in text.split("\n")) {
        if (line.indexOf(STAMP) != null) {
            return line.trim();
        }
    }
    return "";
}

fun lines(text: str) > [str] {
    final acc = mut [<str>];
    foreach (line in text.split("\n")) {
        if (line.trim() != "") {
            acc.append(line.trim());
        }
    }
    return acc;
}

fun must(r: Ran, what: str) > str !> any {
    if (r.code != 0) {
        throw "verify-ready: {what}: exit {r.code}: {r.stderr}{r.stdout}";
    }
    return r.stdout;
}

// note says a step as it happens, so a long bootstrap never looks hung.
fun note(h: Host, did: mut [str], line: str) > void {
    did.append(line);
    h.say(line);
}

// timed says what a slow step will do before it runs, and its time after.
fun timed(h: Host, start: str, run: fun () > str !> any) > str !> any {
    h.say(start);
    final began = h.clock();
    final line = run();
    final ms = std\toInt(h.clock() - began);
    final took = if (ms < 1000) "{ms}ms" else "{ms / 1000}s";
    h.say("{line} ({took})");
    return line;
}

// stopDaemon stops the checkout's daemon when one runs, so a project lock it holds cannot fail
// the build with exit 75. It raises when a running daemon will not stop.
fun stopDaemon(h: Host, dir: str) > str !> any {
    if (h.magus(dir, args: ["server", "status"]).code != 0) {
        return "no daemon was running";
    }
    // status exits 0 while only the broker is up, so stop can still find
    // no server to stop.
    final stopped = h.magus(dir, args: ["server", "stop"]);
    if (stopped.code != 0 and stopped.stderr.indexOf("no server is running") != null) {
        return "no daemon was running";
    }
    _ = must(stopped, what: "magus server stop");
    return "stopped the daemon";
}

fun startDaemon(h: Host, dir: str) > str !> any {
    _ = must(h.magus(dir, args: ["server", "start"]), what: "magus server start");
    return "started the daemon";
}

// installDependencies runs every project's install with the checkout's ./magus: a fresh checkout
// has no node_modules, and the TypeScript symbol index needs tsc. It raises naming the command.
fun installDependencies(h: Host, dir: str) > str !> any {
    final r = h.magus(dir, args: ["run", "install", "/"]);
    if (r.code != 0) {
        throw "bootstrap-checkout: {dir}/magus run install /: exit {r.code}: {r.stderr}{r.stdout}";
    }
    return "installed every project's dependencies";
}

// mainWorktree is the first stanza of `git worktree list --porcelain`,
// the checkout every other worktree hangs off.
export fun mainWorktree(porcelain: str) > str {
    foreach (line in porcelain.split("\n")) {
        if (line.startsWith("worktree ")) {
            return line.sub(9);
        }
    }
    return "";
}

// SeedResult is the line a seed prints, or why it failed.
export object SeedResult {
    value: str? = null,
    error: str? = null,
}

// seedSource is the first of candidates, other than dir, holding an index.
export fun seedSource(candidates: [str], dir: str, holdsIndex: fun (path: str) > bool) > str? {
    foreach (candidate in candidates) {
        if (candidate != "" and candidate != dir and holdsIndex(candidate)) {
            return candidate;
        }
    }
    return null;
}

// seedSymbolIndex copies base's symbol index into dir, so the first read
// updates it instead of building it. It lands by rename: a half-copied
// index would read as built. A backoff record is another checkout's, so
// it stays behind.
export fun seedSymbolIndex(base: str, dir: str) > SeedResult {
    final target = fs\join(dir, name: SYMBOLS);
    final landing = "{target}.seeding";
    try {
        if (fs\exists(target)) {
            return SeedResult{ value = "kept the symbol index {dir} already holds" };
        }
        fs\removeAll(landing);
        fs\copyDir(fs\join(base, name: SYMBOLS), dst: landing);
        foreach (record in fs\glob("{landing}/*/*.refresh-failed")) {
            fs\remove(record.value);
        }
        fs\rename(landing, dst: target);
    } catch (e: any) {
        return SeedResult{ error = "{e}" };
    }
    return SeedResult{ value = "seeded the symbol index from {base}" };
}

// seedLine seeds dir from the first candidate holding an index. A failure
// is a line, never a raise: the first read builds a missing index.
export fun seedLine(candidates: [str], dir: str) > str {
    final holdsIndex = fun (path: str) > bool => fs\isDir(fs\join(path, name: SYMBOLS)) catch false;
    final base = seedSource(candidates, dir: dir, holdsIndex: holdsIndex);
    if (base == null) {
        return "no checkout holds a symbol index to seed from; the first read builds it";
    }
    final seeded = seedSymbolIndex(base!, dir: dir);
    return seeded.value ?? "the symbol index was not seeded from {base!}, so the first read builds it: {seeded.error ?? "unknown"}";
}

// installProjects installs the projects install names, comma-joined, or none.
// It raises naming the command.
fun installProjects(h: Host, dir: str, install: str) > str !> any {
    if (install == "none") {
        return "installed no dependencies: the job touches no project that has an install target";
    }
    foreach (project in install.split(",")) {
        final r = h.magus(dir, args: ["run", "install", project]);
        if (r.code != 0) {
            throw "bootstrap-checkout: {dir}/magus run install {project}: exit {r.code}: {r.stderr}{r.stdout}";
        }
    }
    return "installed the dependencies of {install}";
}

// Installing integrations is part of preparing a checkout, including when it
// already has a current binary or no language dependencies need installation.
fun installHarnesses(h: Host, dir: str) > str !> any {
    _ = must(h.magus(dir, args: ["buzz", "hack/dev/bootstrap-harnesses.buzz"]), what: "magus buzz hack/dev/bootstrap-harnesses.buzz");
    return "installed every declared harness";
}

// binaryAtHead reports whether dir's ./magus is a clean build of its HEAD.
export fun binaryAtHead(h: Host, dir: str) > bool !> any {
    final head = must(h.git(dir, args: ["rev-parse", "HEAD"]), what: "git rev-parse HEAD").trim();
    final version = h.magus(dir, args: ["version", "-o", "json"]);
    return version.code == 0 and head != "" and (versionMismatch(version.stdout, head: head) catch "unreadable") == "";
}

// placeBinary builds ./magus in dir at its HEAD unless one stands there, seeds
// its index, installs dependencies, and returns a line per thing it did. The
// daemon stops before a build. With restart it starts on the new binary, which
// must then name HEAD. install "" installs every project's.
export fun placeBinary(h: Host, dir: str, restart: bool = false, install: str = "") > [str] !> any {
    final did = mut [<str>];
    if (binaryAtHead(h, dir: dir)) {
        note(h, did: did, line: "kept {dir}/magus, already built at HEAD");
    } else {
        note(h, did: did, line: stopDaemon(h, dir: dir));
        did.append(timed(h, start: "building {dir}/magus at its HEAD with go; a cold build cache takes a minute or more", run: fun () > str !> any => h.build(dir)));
    }
    did.append(timed(h, start: "seeding the symbol index of {dir}", run: fun () > str !> any => h.seed(dir)));
    if (install == "") {
        did.append(timed(h, start: "installing every project's dependencies with {dir}/magus", run: fun () > str !> any => installDependencies(h, dir: dir)));
    } else {
        did.append(timed(h, start: "installing the dependencies of {install} with {dir}/magus", run: fun () > str !> any => installProjects(h, dir: dir, install: install)));
    }
    did.append(timed(h, start: "installing every declared harness", run: fun () > str !> any => installHarnesses(h, dir: dir)));
    if (restart) {
        note(h, did: did, line: startDaemon(h, dir: dir));
        final head = must(h.git(dir, args: ["rev-parse", "HEAD"]), what: "git rev-parse HEAD").trim();
        final stale = versionMismatch(h.magus(dir, args: ["version", "-o", "json"]).stdout, head: head);
        if (stale != "") {
            throw stale;
        }
    }
    return did;
}

// verifyReady makes the checkout at dir ready to verify, and returns a line per
// thing it did. A ./magus built at another commit fails the symbol index
// (MGS7003), so it builds one at HEAD. It also clears stale pool parents and
// skill installs, installs dependencies, and builds the graph, digest and
// proofread. Running it twice does the build and the removals once. The
// daemon stops before a build, and with restart it is running again at the end.
export fun verifyReady(h: Host, dir: str, restart: bool = false) > [str] !> any {
    final did = mut [<str>];
    final head = must(h.git(dir, args: ["rev-parse", "HEAD"]), what: "git rev-parse HEAD").trim();
    final version = h.magus(dir, args: ["version", "-o", "json"]);
    final built = version.code == 0 and (builtAt(version.stdout, head: head) catch false);
    if (restart or !built) {
        note(h, did: did, line: stopDaemon(h, dir: dir));
    }
    if (built) {
        note(h, did: did, line: "./magus is built at HEAD {head}");
    } else {
        did.append(timed(h, start: "building {dir}/magus at its HEAD with go; a cold build cache takes a minute or more", run: fun () > str !> any => h.build(dir)));
    }
    _ = must(h.magus(dir, args: ["server", "stop", "--pools"]), what: "magus server stop --pools");
    note(h, did: did, line: "stopped the pool parents of other builds");
    final others = lines(must(h.git(dir, args: ["ls-files", "--others", "--"] + SKILL_DIRS), what: "git ls-files --others"));
    var fresh = "";
    foreach (skill in skillInstalls(others)) {
        final tracked = lines(must(h.git(dir, args: ["ls-files", "--", skill]), what: "git ls-files {skill}"));
        final stamp = h.stampOf(fs\join(dir, name: "{skill}/SKILL.md"));
        if (tracked.len() > 0 or stamp == "") {
            continue;
        }
        if (fresh == "") {
            fresh = h.freshSkills(dir);
        }
        if (stamp != h.stampOf(fs\join(fresh, name: "{skill}/SKILL.md"))) {
            h.removeDir(fs\join(dir, name: skill));
            note(h, did: did, line: "removed the stale untracked skill install {skill}");
        }
    }
    did.append(timed(h, start: "installing every project's dependencies with {dir}/magus", run: fun () > str !> any => installDependencies(h, dir: dir)));
    did.append(timed(h, start: "installing every declared harness", run: fun () > str !> any => installHarnesses(h, dir: dir)));
    did.append(timed(h, start: "building the graph", run: fun () > str !> any {
        _ = must(h.magus(dir, args: ["graph", "build"]), what: "magus graph build");
        return "built the graph";
    }));
    did.append(timed(h, start: "generating the symbol digest", run: fun () > str !> any {
        _ = must(h.magus(dir, args: ["run", "symbol-digest-generate", "."]), what: "magus run symbol-digest-generate .");
        return "generated the symbol digest";
    }));
    did.append(timed(h, start: "building the proofread binary", run: fun () > str !> any {
        _ = must(h.magus(dir, args: ["run", "proofread-build", "libs/proofread"]), what: "magus run proofread-build libs/proofread");
        return "built the proofread binary";
    }));
    if (restart) {
        note(h, did: did, line: startDaemon(h, dir: dir));
    }
    return did;
}

fun gitRan(h: Host, dir: str, args: [str]) > result\Result::<Ran> {
    try {
        return result\ok::<Ran>(h.git(dir, args: args));
    } catch (err: any) {
        return result\caught::<Ran>(err, doing: "bootstrap-checkout: git {args.join(" ")}");
    }
}

fun magusRan(h: Host, dir: str, args: [str]) > result\Result::<Ran> {
    try {
        return result\ok::<Ran>(h.magus(dir, args: args));
    } catch (err: any) {
        return result\caught::<Ran>(err, doing: "bootstrap-checkout: magus {args.join(" ")}");
    }
}

// Row is a running job, with the checkout it works in and that checkout's base.
export object Row {
    id: str,
    root: str,
    base: str,
}

// runningRows are the rows of `magus ls jobs -o json` in state running.
export fun runningRows(jobsJSON: str) > result\Result::<[Row]> {
    try {
        final jobs: [any] = json\parse(jobsJSON)["jobs"] ?? [];
        final found = mut [<Row>];
        foreach (job in jobs) {
            final state: str = job["state"] ?? "";
            if (state != "running") {
                continue;
            }
            final id: str = job["id"] ?? "";
            final root: str = job["checkout_root"] ?? "";
            final worktree: {str: any} = job["worktree"] ?? {};
            final checkpoint: str = job["checkpoint"] ?? "";
            final base: str = worktree["base"] ?? checkpoint.split("+")[0];
            found.append(Row{ id = id, root = root, base = base });
        }
        return result\ok::<[Row]>(found);
    } catch (err: any) {
        return result\caught::<[Row]>(err, doing: "bootstrap-checkout: read `magus ls jobs -o json`");
    }
}

// endMergedRows ends each running row whose HEAD or work is already in onto.
// It returns the rows it left running, each with the reason.
// A row at its base, an unreadable checkout and dir itself stay running.
export fun endMergedRows(h: Host, dir: str, onto: str, did: mut [str]) > result\Result::<[str]> {
    final listed = magusRan(h, dir: dir, args: ["ls", "jobs", "-o", "json"]);
    if (listed.error -> err) {
        return result\Result::<[str]>{ error = err };
    }
    if (listed.value!.code != 0) {
        return result\fail::<[str]>("bootstrap-checkout: magus ls jobs -o json: exit {listed.value!.code}: {listed.value!.stderr}{listed.value!.stdout}");
    }
    final rows = runningRows(listed.value!.stdout);
    if (rows.error -> err) {
        return result\Result::<[str]>{ error = err };
    }
    final kept = mut [<str>];
    foreach (row in rows.value!) {
        if (row.root == "" or row.root == dir) {
            kept.append("{row.id} (its checkout is this one or unknown)");
            continue;
        }
        final head = gitRan(h, dir: row.root, args: ["rev-parse", "HEAD"]);
        if (head.error -> err) {
            return result\Result::<[str]>{ error = err };
        }
        final sha = head.value!.stdout.trim();
        if (head.value!.code != 0 or sha == "") {
            kept.append("{row.id} (its checkout {row.root} cannot be read)");
            continue;
        }
        if (sha == row.base) {
            kept.append("{row.id} (it has committed nothing yet)");
            continue;
        }
        final inside = gitRan(h, dir: row.root, args: ["merge-base", "--is-ancestor", sha, onto]);
        if (inside.error -> err) {
            return result\Result::<[str]>{ error = err };
        }
        if (inside.value!.code != 0 and inside.value!.code != 1) {
            return result\fail::<[str]>("bootstrap-checkout: git merge-base --is-ancestor {sha} {onto} in {row.root}: exit {inside.value!.code}: {inside.value!.stderr}");
        }
        var how = "its head {sha.sub(0, len: 12)} is already in {onto}";
        if (inside.value!.code == 1) {
            final squashed = holdsWork(h, row: row, head: sha, onto: onto);
            if (squashed.error -> err) {
                return result\Result::<[str]>{ error = err };
            }
            if (!squashed.value!) {
                kept.append("{row.id} (its head is not in the target yet)");
                continue;
            }
            how = "its work since {row.base.sub(0, len: 12)} is already in {onto}, merged as other commits";
        }
        final ended = endRow(h, dir: dir, id: row.id);
        if (ended.error -> err) {
            return result\Result::<[str]>{ error = err };
        }
        note(h, did: did, line: "ended running row {row.id}: {how}");
    }
    return result\ok::<[str]>(kept);
}

// holdsWork reports whether onto holds what row committed since its base.
// A squash merge leaves the head out of onto's history, so the trees decide:
// merging the work onto onto must change nothing.
fun holdsWork(h: Host, row: Row, head: str, onto: str) > result\Result::<bool> {
    if (row.base == "") {
        return result\ok::<bool>(false);
    }
    final merged = gitRan(h, dir: row.root, args: ["merge-tree", "--write-tree", "--merge-base", row.base, onto, head]);
    if (merged.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    if (merged.value!.code == 1) {
        return result\ok::<bool>(false);
    }
    if (merged.value!.code != 0) {
        return result\fail::<bool>("bootstrap-checkout: git merge-tree --write-tree --merge-base {row.base} {onto} {head} in {row.root}: exit {merged.value!.code}: {merged.value!.stderr}");
    }
    final target = gitRan(h, dir: row.root, args: ["rev-parse", "{onto}^\{tree}"]);
    if (target.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    if (target.value!.code != 0) {
        return result\fail::<bool>("bootstrap-checkout: git rev-parse {onto}^\{tree} in {row.root}: exit {target.value!.code}: {target.value!.stderr}");
    }
    final tree = lines(merged.value!.stdout);
    final want = target.value!.stdout.trim();
    return result\ok::<bool>(want != "" and tree.len() > 0 and tree[0] == want);
}

fun endRow(h: Host, dir: str, id: str) > result\Result::<bool> {
    final ended = magusRan(h, dir: dir, args: ["job", "exit", id]);
    if (ended.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    if (ended.value!.code != 0) {
        return result\fail::<bool>("bootstrap-checkout: magus job exit {id}: exit {ended.value!.code}: {ended.value!.stderr}{ended.value!.stdout}");
    }
    return result\ok::<bool>(true);
}

// settleRows ends the merged running rows, then prunes like `magus job prune`.
// Merged rows go first, so a prune that waited on them as ancestors passes.
export fun settleRows(h: Host, dir: str, onto: str, did: mut [str]) > result\Result::<bool> {
    final kept = endMergedRows(h, dir: dir, onto: onto, did: did);
    if (kept.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    final pruned = magusRan(h, dir: dir, args: ["job", "prune"]);
    if (pruned.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    if (pruned.value!.code != 0) {
        return result\fail::<bool>("bootstrap-checkout: magus job prune: exit {pruned.value!.code}: {pruned.value!.stderr}{pruned.value!.stdout}");
    }
    final said = lines(pruned.value!.stdout);
    if (said.len() == 0) {
        note(h, did: did, line: "job prune: no row to end");
    }
    foreach (line in said) {
        note(h, did: did, line: "job prune: {line}");
    }
    foreach (why in kept.value!) {
        note(h, did: did, line: "left running: {why}");
    }
    return result\ok::<bool>(true);
}

// adopt fast-forwards a clean checkout onto onto, places ./magus, settles rows.
// It never resets or discards. Each thing done lands in did, even on failure.
export fun adopt(h: Host, dir: str, onto: str, did: mut [str], restart: bool = false, install: str = "") > result\Result::<bool> {
    final status = gitRan(h, dir: dir, args: ["status", "--porcelain"]);
    if (status.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    if (status.value!.code != 0) {
        return result\fail::<bool>("bootstrap-checkout: git status --porcelain: exit {status.value!.code}: {status.value!.stderr}");
    }
    final dirty = dirtyRefusal(dir, porcelain: status.value!.stdout);
    if (dirty != "") {
        return result\fail::<bool>("{dirty}\nrefused: --onto moves nothing in a dirty tree");
    }
    final target = gitRan(h, dir: dir, args: ["rev-parse", "--verify", "{onto}^\{commit}"]);
    if (target.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    final ontoSha = target.value!.stdout.trim();
    if (target.value!.code != 0 or ontoSha == "") {
        return result\fail::<bool>("bootstrap-checkout: {onto} names no commit in {dir} (fetch it first; --onto never fetches)");
    }
    final head = gitRan(h, dir: dir, args: ["rev-parse", "HEAD"]);
    if (head.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    final moved = fastForward(h, dir: dir, onto: onto, ontoSha: ontoSha, headSha: head.value!.stdout.trim());
    if (moved.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    note(h, did: did, line: moved.value!);
    try {
        foreach (line in placeBinary(h, dir: dir, restart: restart, install: install)) {
            did.append(line);
        }
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "bootstrap-checkout: place ./magus");
    }
    return settleRows(h, dir: dir, onto: ontoSha, did: did);
}

// fastForward refuses unless ontoSha descends from HEAD: it never discards.
fun fastForward(h: Host, dir: str, onto: str, ontoSha: str, headSha: str) > result\Result::<str> {
    if (headSha == ontoSha) {
        return result\ok::<str>("already at {onto} ({ontoSha.sub(0, len: 12)})");
    }
    final ancestor = gitRan(h, dir: dir, args: ["merge-base", "--is-ancestor", "HEAD", ontoSha]);
    if (ancestor.error -> err) {
        return result\Result::<str>{ error = err };
    }
    if (ancestor.value!.code != 0) {
        return result\fail::<str>("bootstrap-checkout: {onto} is not a fast-forward of {dir}'s HEAD {headSha.sub(0, len: 12)}: refused, nothing was reset or discarded");
    }
    final moved = gitRan(h, dir: dir, args: ["merge", "--ff-only", ontoSha]);
    if (moved.error -> err) {
        return result\Result::<str>{ error = err };
    }
    if (moved.value!.code != 0) {
        return result\fail::<str>("bootstrap-checkout: git merge --ff-only {onto}: exit {moved.value!.code}: {moved.value!.stderr}{moved.value!.stdout}");
    }
    return result\ok::<str>("fast-forwarded {dir} from {headSha.sub(0, len: 12)} to {onto} ({ontoSha.sub(0, len: 12)})");
}

export fun liveHost() > Host {
    return Host{
        git = fun (dir: str, args: [str]) > Ran !> any {
            final r = vcs\cmd(args, opts: vcs\CommandOptions{dir = dir, quiet = true, allowFailure = true});
            return Ran{ stdout = r.stdout, stderr = r.stderr, code = r.code };
        },
        magus = fun (dir: str, args: [str]) > Ran !> any {
            final bin = fs\join(dir, name: "magus");
            if (!fs\isFile(bin)) {
                return Ran{ stderr = "{bin} does not exist", code = 127 };
            }
            final r = proc\exec(bin, args: args, dir: dir, opts: proc\ExecOptions{quiet = true, allowFailure = true});
            return Ran{ stdout = r.stdout, stderr = r.stderr, code = r.code };
        },
        build = fun (dir: str) > str !> any {
            return build(dir);
        },
        // The forking checkout first: the fork runs this script from it.
        seed = fun (dir: str) > str !> any {
            final list = vcs\cmd(["worktree", "list", "--porcelain"], opts: vcs\CommandOptions{dir = dir, quiet = true, allowFailure = true});
            return seedLine([vcs\root(), mainWorktree(list.stdout)], dir: dir);
        },
        stampOf = fun (path: str) > str !> any {
            if (!fs\isFile(path)) {
                return "";
            }
            return stampLine(fs\readFile(path));
        },
        freshSkills = fun (dir: str) > str !> any {
            final root = fs\tempDir("fresh-skills-");
            final r = proc\exec(fs\join(dir, name: "magus"), args: ["agent", "install", "--dir", root] + SKILL_DIRS, dir: dir, opts: proc\ExecOptions{quiet = true, allowFailure = true});
            if (r.code != 0) {
                throw "verify-ready: magus agent install into {root}: exit {r.code}: {r.stderr}{r.stdout}";
            }
            return root;
        },
        removeDir = fun (path: str) > void !> any {
            fs\removeAll(path);
        },
        exec = fun (dir: str, argv: [str]) > Ran !> any {
            final r = proc\exec("env", args: argv, dir: dir, opts: proc\ExecOptions{quiet = true, allowFailure = true});
            return Ran{ stdout = r.stdout, stderr = r.stderr, code = r.code };
        },
        readFile = fun (path: str) > str !> any {
            return fs\readFile(path);
        },
        say = fun (line: str) > void {
            std\print(line);
        },
        clock = fun () > double {
            return os\time();
        },
    };
}

// compile runs the bootstrap build in dir, and returns the porcelain its regeneration left,
// "" when the first build passed. A failed build may only need generated bindings the commit
// holds older than the types they bind, which only a built magus regenerates.
// So it runs each GENERATE_SOURCES file's //go:generate lines in its directory.
// Then it builds once more.
// It never commits what they rewrote, and a failure after it raises with the compiler output
// and the regenerated paths.
export fun compile(h: Host, dir: str) > str !> any {
    final first = h.exec(dir, argv: bootstrapArgv());
    if (first.code == 0) {
        return "";
    }
    var ran = 0;
    foreach (source in GENERATE_SOURCES) {
        final sourceDir = fs\dirname(source);
        foreach (argv in generateArgv(h.readFile(fs\join(dir, name: source)))) {
            ran = ran + 1;
            final r = h.exec(fs\join(dir, name: sourceDir), argv: argv);
            if (r.code != 0) {
                throw "bootstrap-checkout: the build failed, and `{argv.join(" ")}` in {sourceDir} failed too: exit {r.code}: {r.stderr}{r.stdout}\nthe build said:\n{first.stderr}{first.stdout}";
            }
        }
    }
    if (ran == 0) {
        throw "bootstrap-checkout: the build failed and {GENERATE_SOURCES.join(", ")} name no //go:generate line to refresh: exit {first.code}:\n{first.stderr}{first.stdout}";
    }
    final status = h.git(dir, args: ["status", "--porcelain"]);
    if (status.code != 0) {
        throw "bootstrap-checkout: git status --porcelain after regenerating: exit {status.code}: {status.stderr}";
    }
    final paths = regeneratedPaths(status.stdout);
    final second = h.exec(dir, argv: bootstrapArgv());
    if (second.code != 0) {
        final rewrote = if (paths.len() > 0) paths.join(", ") else "nothing";
        throw "bootstrap-checkout: the build failed, the bootstrap generators rewrote {rewrote}, and the build failed again: exit {second.code}:\n{second.stderr}{second.stdout}";
    }
    return status.stdout;
}

fun hasMise() > bool {
    try {
        _ = proc\which("mise");
        return true;
    } catch (err: any) {
        return false;
    }
}

fun build(dir: str, recovery: bool = false) > str !> any {
    if (!fs\isDir(dir)) {
        throw "bootstrap-checkout: {dir} is not a directory\n{USAGE}";
    }
    if (vcs\name() != "git") {
        throw "bootstrap-checkout: builds in git checkouts, and this one is {vcs\name()}";
    }
    final refused = dirtyRefusal(dir, porcelain: vcs\cmd(["status", "--porcelain"], opts: vcs\CommandOptions{dir = dir, quiet = true}).stdout, recovery: recovery);
    if (refused != "") {
        throw refused;
    }
    final head = vcs\cmd(["rev-parse", "HEAD"], opts: vcs\CommandOptions{dir = dir, quiet = true}).stdout.trim();
    final trust = miseTrustArgv(dir, hasMise: hasMise(), hasConfig: fs\isFile(fs\join(dir, name: "mise.toml")));
    if (trust.len() > 0) {
        _ = proc\exec("mise", args: trust, dir: dir);
    }
    final rewrote = compile(liveHost(), dir: dir);
    final bin = fs\join(dir, name: "magus");
    final mismatch = versionMismatch(proc\exec(bin, args: ["version", "-o", "json"], dir: dir, opts: proc\ExecOptions{quiet = true}).stdout, head: head, recovery: recovery);
    if (mismatch != "") {
        final regenerated = regeneratedRefusal(dir, porcelain: vcs\cmd(["status", "--porcelain"], opts: vcs\CommandOptions{dir = dir, quiet = true}).stdout);
        if (regenerated != "" and mismatch.endsWith("uncommitted changes")) {
            if (rewrote != "") {
                return "placed {bin} after its build failed and the bootstrap generators ran\n{regenerated}";
            }
            throw regenerated;
        }
        throw mismatch;
    }
    if (recovery) {
        return "placed {bin} for recovery from the working tree at {head}; commit and validate before using it as a clean build";
    }
    return "placed {bin}, built at {head}";
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--here", "--restart", "--verify-ready", "--recover"], valued: ["--checkout", "--install", "--onto"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "bootstrap-checkout: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final here = parsed.values["--here"] != null;
    final checkout = parsed.values["--checkout"] ?? "";
    final unnamed = targetProblem(checkout, here: here);
    if (unnamed != "") {
        throw "{unnamed}\n{USAGE}";
    }
    final dir = if (here) vcs\root() else checkout;
    final restart = parsed.values["--restart"] != null;
    final h = liveHost();
    final onto = parsed.values["--onto"] ?? "";
    if (onto != "") {
        if (parsed.values["--recover"] != null or parsed.values["--verify-ready"] != null) {
            throw "bootstrap-checkout: --onto cannot combine with --recover or --verify-ready";
        }
        final did = mut [<str>];
        final adopted = adopt(h, dir: dir, onto: onto, did: did, restart: restart, install: parsed.values["--install"] ?? "");
        if (adopted.error -> err) {
            throw err.message;
        }
        return;
    }
    if (parsed.values["--recover"] != null) {
        if (restart or parsed.values["--verify-ready"] != null or parsed.values["--install"] != null) {
            throw "bootstrap-checkout: --recover cannot combine with --restart, --verify-ready or --install";
        }
        h.say(stopDaemon(h, dir: dir));
        _ = timed(h, start: "building {dir}/magus from the working tree; a cold build cache takes a minute or more", run: fun () > str !> any => build(dir, recovery: true));
        return;
    }
    if (parsed.values["--verify-ready"] != null) {
        _ = verifyReady(h, dir: dir, restart: restart);
        return;
    }
    _ = placeBinary(h, dir: dir, restart: restart, install: parsed.values["--install"] ?? "");
}

// stubHost answers verifyReady from a table keyed by command line, recording
// each call. A missing command exits 0 silently, so a daemon runs unless the
// table fails `server status`. An exec line's nth run reads "<line> #n" first.
// stamps maps a SKILL.md path to its generated-by line, and any other path to its text.
fun stubHost(answers: {str: Ran}, stamps: {str: str}, calls: mut [str]) > Host {
    return stubHostSaying(answers, stamps: stamps, calls: calls, said: mut [<str>]);
}

// stubHostSaying is stubHost that records each line the bootstrap says in said.
fun stubHostSaying(answers: {str: Ran}, stamps: {str: str}, calls: mut [str], said: mut [str]) > Host {
    return Host{
        say = fun (line: str) > void {
            said.append(line);
        },
        clock = fun () > double {
            return 0.0;
        },
        git = fun (dir: str, args: [str]) > Ran !> any {
            final line = "git {args.join(" ")}";
            calls.append(line);
            return answers["{dir}: {line}"] ?? answers[line] ?? Ran{};
        },
        magus = fun (dir: str, args: [str]) > Ran !> any {
            final line = "magus {args.join(" ")}";
            calls.append(line);
            return answers[line] ?? Ran{};
        },
        build = fun (dir: str) > str !> any {
            calls.append("build {dir}");
            return "placed {dir}/magus";
        },
        seed = fun (dir: str) > str !> any {
            calls.append("seed {dir}");
            return "seeded {dir}";
        },
        stampOf = fun (path: str) > str !> any {
            return stamps[path] ?? "";
        },
        freshSkills = fun (dir: str) > str !> any {
            calls.append("fresh {dir}");
            return "/fresh";
        },
        removeDir = fun (path: str) > void !> any {
            calls.append("remove {path}");
        },
        exec = fun (dir: str, argv: [str]) > Ran !> any {
            final line = "exec {dir}: {argv.join(" ")}";
            final nth = calls.filter(fun (index: int, c: str) > bool => c == line).len() + 1;
            calls.append(line);
            return answers["{line} #{nth}"] ?? answers[line] ?? Ran{};
        },
        readFile = fun (path: str) > str !> any {
            return stamps[path] ?? "";
        },
    };
}

final BUILD_LINE = "exec /c: GOEXPERIMENT=jsonv2 go run -trimpath ./cmd/magus run go-build --no-cache .";
final DIRECTIVES = "package main\n\n//go:generate go run . boundarylist -out a.go -pkg bindgen\n//go:generate go run . boundaryobjects -out b.go -pkg bindgen\n";

test "the generators are the source's //go:generate lines, with the json experiment" {
    assert\equal(generateArgv(DIRECTIVES), want: [
        ["GOEXPERIMENT=jsonv2", "go", "run", ".", "boundarylist", "-out", "a.go", "-pkg", "bindgen"],
        ["GOEXPERIMENT=jsonv2", "go", "run", ".", "boundaryobjects", "-out", "b.go", "-pkg", "bindgen"],
    ], message: "argv");
    assert\equal(generateArgv("package main\n").len(), want: 0, message: "none");
}

test "a build that compiles never regenerates" {
    final calls = mut [<str>];
    final h = stubHost({}, stamps: {"/c/cmd/magus-utils/boundary_types.go": DIRECTIVES}, calls: calls);
    assert\equal(compile(h, dir: "/c"), want: "", message: "nothing rewritten");
    assert\equal(calls, want: [BUILD_LINE], message: "one build");
}

test "a failed build runs the generators, then builds again, and names what they rewrote" {
    final calls = mut [<str>];
    final h = stubHost({
        "{BUILD_LINE} #1": Ran{ code = 1, stderr = "undefined: ObjectJobClaim" },
        "git status --porcelain": Ran{ stdout = " M internal/interp/bindings/gen/boundary_objects.go\n" },
    }, stamps: {"/c/cmd/magus-utils/boundary_types.go": DIRECTIVES}, calls: calls);
    final rewrote = compile(h, dir: "/c");
    assert\equal(calls, want: [
        BUILD_LINE,
        "exec /c/cmd/magus-utils: GOEXPERIMENT=jsonv2 go run . boundarylist -out a.go -pkg bindgen",
        "exec /c/cmd/magus-utils: GOEXPERIMENT=jsonv2 go run . boundaryobjects -out b.go -pkg bindgen",
        "git status --porcelain",
        BUILD_LINE,
    ], message: "order");
    final why = regeneratedRefusal("/c", porcelain: rewrote);
    assert\equal(why.indexOf("git -C /c add internal/interp/bindings/gen/boundary_objects.go") != null, want: true, message: why);
}

test "the generators of every source run from that source's directory, in order" {
    final calls = mut [<str>];
    final h = stubHost({
        "{BUILD_LINE} #1": Ran{ code = 1, stderr = "undefined: FlagThing" },
    }, stamps: {
        "/c/cmd/magus-utils/boundary_types.go": DIRECTIVES,
        "/c/cmd/magus/main.go": "package main\n\n//go:generate go run ../magus-utils cliflags -out gen/cli_flags.go\n",
    }, calls: calls);
    _ = compile(h, dir: "/c");
    assert\equal(calls, want: [
        BUILD_LINE,
        "exec /c/cmd/magus-utils: GOEXPERIMENT=jsonv2 go run . boundarylist -out a.go -pkg bindgen",
        "exec /c/cmd/magus-utils: GOEXPERIMENT=jsonv2 go run . boundaryobjects -out b.go -pkg bindgen",
        "exec /c/cmd/magus: GOEXPERIMENT=jsonv2 go run ../magus-utils cliflags -out gen/cli_flags.go",
        "git status --porcelain",
        BUILD_LINE,
    ], message: "order");
}

test "a failed generator names the directory it ran in" {
    final h = stubHost({
        "{BUILD_LINE} #1": Ran{ code = 1, stderr = "undefined: FlagThing" },
        "exec /c/cmd/magus: GOEXPERIMENT=jsonv2 go run ../magus-utils cliflags": Ran{ code = 3, stderr = "no" },
    }, stamps: {"/c/cmd/magus/main.go": "//go:generate go run ../magus-utils cliflags\n"}, calls: mut [<str>]);
    var why = "";
    try {
        _ = compile(h, dir: "/c");
    } catch (e: str) {
        why = e;
    }
    assert\equal(why.startsWith("bootstrap-checkout: the build failed, and `GOEXPERIMENT=jsonv2 go run ../magus-utils cliflags` in cmd/magus failed too: exit 3: no"), want: true, message: why);
}

test "a build that fails again after the generators reports the compiler and the rewritten paths" {
    final h = stubHost({
        "{BUILD_LINE} #1": Ran{ code = 1, stderr = "undefined: ObjectJobClaim" },
        "{BUILD_LINE} #2": Ran{ code = 2, stderr = "undefined: Other" },
        "git status --porcelain": Ran{ stdout = " M internal/interp/bindings/gen/boundary_list.go\n" },
    }, stamps: {"/c/cmd/magus-utils/boundary_types.go": DIRECTIVES}, calls: mut [<str>]);
    var why = "";
    try {
        _ = compile(h, dir: "/c");
    } catch (e: str) {
        why = e;
    }
    assert\equal(why, want: "bootstrap-checkout: the build failed, the bootstrap generators rewrote internal/interp/bindings/gen/boundary_list.go, and the build failed again: exit 2:\nundefined: Other", message: why);
}

test "a binary at HEAD is kept, a binary elsewhere or missing is rebuilt" {
    assert\equal(builtAt(`{"commit": "abc123def"}`, head: "abc123def") catch false, want: true, message: "match");
    assert\equal(builtAt(`{"commit": "abc123", "version": "v0.5.0-dirty"}`, head: "abc123def") catch false, want: true, message: "dirty at head");
    assert\equal(builtAt(`{"commit": "def456"}`, head: "abc123") catch false, want: false, message: "other commit");
    assert\equal(builtAt("not json", head: "abc123") catch false, want: false, message: "unreadable");
}

test "skill installs are the directories of an untracked SKILL.md one level under a skill root" {
    final got = skillInstalls([".claude/skills/magus-run/SKILL.md", ".claude/skills/magus-run/ref.md",
        ".agents/skills/magus-query/SKILL.md", "docs/skills/x/SKILL.md", ".claude/skills/a/b/SKILL.md"]);
    assert\equal(got, want: [".claude/skills/magus-run", ".agents/skills/magus-query"], message: "dirs");
}

test "the stamp is the generated-by line, and a file without one has none" {
    assert\equal(stampLine("body\n<!-- generated by: magus agent install; skill-content: abc -->\n"), want: "<!-- generated by: magus agent install; skill-content: abc -->", message: "stamp");
    assert\equal(stampLine("body only\n"), want: "", message: "none");
}

test "verify-ready stops the daemon, rebuilds a skewed binary, removes only untracked installs the placed binary would write differently, then builds the graph, digest and proofread binary" {
    final calls = mut [<str>];
    final h = stubHost({
        "git rev-parse HEAD": Ran{ stdout = "abc123\n" },
        "magus version -o json": Ran{ stdout = `{"commit": "def456"}` },
        "git ls-files --others -- .claude/skills .agents/skills .opencode/skills": Ran{ stdout = ".claude/skills/magus-run/SKILL.md\n.claude/skills/fresh/SKILL.md\n.claude/skills/plain/SKILL.md\n.claude/skills/kept/SKILL.md\n" },
        "git ls-files -- .claude/skills/kept": Ran{ stdout = ".claude/skills/kept/ref.md\n" },
    }, stamps: {
        "/c/.claude/skills/magus-run/SKILL.md": "v1",
        "/fresh/.claude/skills/magus-run/SKILL.md": "v2",
        "/c/.claude/skills/fresh/SKILL.md": "v2",
        "/fresh/.claude/skills/fresh/SKILL.md": "v2",
        "/c/.claude/skills/kept/SKILL.md": "v1",
    }, calls: calls);
    final did = verifyReady(h, dir: "/c", restart: false);
    assert\equal(did, want: [
        "stopped the daemon",
        "placed /c/magus",
        "stopped the pool parents of other builds",
        "removed the stale untracked skill install .claude/skills/magus-run",
        "installed every project's dependencies",
        "installed every declared harness",
        "built the graph",
        "generated the symbol digest",
        "built the proofread binary",
    ], message: "did");
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("remove")), want: ["remove /c/.claude/skills/magus-run"], message: "one removal");
    assert\equal(calls.indexOf("magus server stop")! < calls.indexOf("build /c")!, want: true, message: "daemon stops before the build");
    assert\equal(calls.indexOf("magus run install /")! < calls.indexOf("magus graph build")!, want: true, message: "install before the graph build");
    assert\equal(calls[calls.len() - 1], want: "magus run proofread-build libs/proofread", message: "proofread binary last");
}

