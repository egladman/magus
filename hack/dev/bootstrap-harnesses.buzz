namespace bootstrapharnesses;

import "encoding/json";
import "flags";
import "fs";
import "magus";
import "result";
import "std";
import "vcs";
import "assert";

final USAGE = "usage: magus buzz hack/dev/bootstrap-harnesses.buzz -- [--id <harness>]";
final HELP = "cost: one managed harness installation, then local source links\n{USAGE}\n\n"
    + "Installs the wired harnesses through `magus agent harness install`, then links authored\n"
    + "neutral skills into the skill roots that installation reports. Generated skills stay managed\n"
    + "by the installer. Claude Code Mod also receives the neutral pull-request loop.\n"
    + "Refuses while harness spells, integration docs, guard policy, neutral skills or loops differ from HEAD;\n"
    + "only committed wiring is installed. Existing unrelated files and links are preserved.";
final GUARDED = ["spells/harness", "docs/guides/integrations/agents", "hack/policy", ".agents/skills", ".agents/loops"];
final STAMP = "generated by: magus agent install";

object Installed {
    ids: [str],
    skillRoots: [str],
}

export fun refuseDirty(dirty: [str]) > result\Result::<bool> {
    if (dirty.len() > 0) {
        return result\fail::<bool>("harness-sync: REFUSED; {dirty.join(", ")} differ from HEAD, and only committed wiring is installed; commit or revert them, then rerun");
    }
    return result\ok::<bool>(true);
}

fun dirtyGuarded() > result\Result::<[str]> {
    try {
        final paths = mut [<str>];
        foreach (file in vcs\status(GUARDED).files) {
            paths.append(file.value);
        }
        return result\ok::<[str]>(paths);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "harness-sync: read the status of the guarded paths");
    }
}

fun loadedHarnesses() > result\Result::<[str]> {
    try {
        final names = magus\cmd("describe", args: ["harness", "-o", "name"], opts: magus\CommandOptions{ quiet = true }).stdout.trim();
        return result\ok::<[str]>(if (names == "") [<str>] else names.split("\n"));
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "harness-sync: list the loaded harnesses");
    }
}

export fun pickHarnesses(id: str?, loaded: [str]) > result\Result::<[str]> {
    if (id == null) {
        return result\ok::<[str]>(loaded);
    }
    if (loaded.indexOf(id!) == null) {
        return result\fail::<[str]>("harness-sync: --id {id!} names no harness this workspace loads; one of {loaded.join(", ")}");
    }
    return result\ok::<[str]>([id!]);
}

fun installArgs(id: str?) > [str] {
    final args = mut ["harness", "install", "-o", "json"];
    if (id -> selected) {
        args.append("--id");
        args.append(selected);
    }
    return args;
}

fun relativePath(name: str) > bool {
    return name != "" and !name.startsWith("/") and !name.startsWith("\\")
        and name.indexOf(":") == null and name.split("/").indexOf("..") == null
        and name.indexOf("\\") == null;
}

// The installer owns the host inventory. Its installed SKILL.md paths name the
// actual destination roots, including roots shared by several harnesses.
export fun installedSources(text: str) > result\Result::<Installed> {
    try {
        final record: {str: any} = json\parse(text);
        final harnesses: [{str: any}] = record["harnesses"];
        final ids = mut [<str>];
        final roots = mut [<str>];
        foreach (harness in harnesses) {
            final id: str = harness["id"];
            if (ids.indexOf(id) == null) { ids.append(id); }
            final skills: [str] = harness["skills"];
            foreach (file in skills) {
                if (!relativePath(file) or !file.endsWith("/SKILL.md")) {
                    return result\fail::<Installed>("harness-sync: installer returned an invalid skill path: {file}");
                }
                final dir = fs\dirname(fs\dirname(file));
                if (dir != ".agents/skills" and roots.indexOf(dir) == null) { roots.append(dir); }
            }
        }
        return result\ok::<Installed>(Installed{ids = ids, skillRoots = roots});
    } catch (err: any) {
        return result\caught::<Installed>(err, doing: "harness-sync: read the installer's harness and skill paths");
    }
}

fun installHarnesses(id: str?) > result\Result::<Installed> {
    try {
        final installed = magus\cmd("agent", args: installArgs(id), opts: magus\CommandOptions{quiet = true});
        return installedSources(installed.stdout);
    } catch (err: any) {
        return result\caught::<Installed>(err, doing: "harness-sync: install the managed harness files");
    }
}

// readlink sees dangling links too. A wrong link is a conflict even when exists
// follows its missing target and reports false; it is never removed or replaced.
export fun linkSource(source: str, destination: str) > result\Result::<bool> {
    try {
        if (!fs\exists(source)) {
            return result\fail::<bool>("harness-sync: authored source is missing: {source}");
        }
        final target = fs\readlink(destination) catch "";
        if (target != "") {
            final resolved = if (target.startsWith("/") or target.startsWith("\\") or target.indexOf(":") != null)
                target else fs\join(fs\dirname(destination), name: target);
            if (fs\join(resolved, clean: ".") == fs\join(source, clean: ".")) {
                return result\ok::<bool>(false);
            }
            return result\fail::<bool>("harness-sync: {destination} links to {target}, not {source}; preserve or move the local link before installing");
        }
        if (fs\exists(destination)) {
            return result\fail::<bool>("harness-sync: {destination} already exists and is not the authored source link; preserve or move the local file before installing");
        }
        fs\mkdirAll(fs\dirname(destination));
        fs\symlink(source, link: destination);
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "harness-sync: link {source} at {destination}");
    }
}

// Untracking the old loop leaves its regular file in an existing checkout.
// Equal bytes already install the loop; a different local file stays a conflict.
fun installLoop(source: str, destination: str) > result\Result::<bool> {
    try {
        final symbolic = fs\readlink(destination) catch "";
        if (symbolic == "" and fs\isFile(destination)
            and fs\readFile(destination) == fs\readFile(source)) {
            return result\ok::<bool>(false);
        }
        return linkSource(source, destination: destination);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "harness-sync: install the neutral loop at {destination}");
    }
}

fun generatedSkill(text: str) > bool {
    foreach (line in text.split("\n")) {
        if (line.trim().startsWith("<!-- {STAMP};")) { return true; }
    }
    return false;
}

export fun linkAuthored(installed: Installed, root: str) > result\Result::<[str]> {
    try {
        final lines = mut [<str>];
        final skills = fs\join(root, name: ".agents/skills");
        final names = fs\listDir(skills).cloneMutable();
        _ = names.sort(fun (a: str, b: str) > bool => a < b);
        foreach (name in names) {
            final source = fs\join(skills, name: name);
            final markdown = fs\join(source, name: "SKILL.md");
            if (!fs\isDir(source) or !fs\exists(markdown)) { continue; }
            if (generatedSkill(fs\readFile(markdown))) { continue; }
            foreach (dir in installed.skillRoots) {
                final destination = fs\join(root, dir: dir, name: name);
                final linked = linkSource(source, destination: destination);
                if (linked.error -> err) { return result\fail::<[str]>(err.message); }
                if (linked.value!) { lines.append("linked {dir}/{name}"); }
            }
        }
        if (installed.ids.indexOf("claude-code-mod") != null) {
            final linked = installLoop(fs\join(root, name: ".agents/loops/pull-requests.md"),
                destination: fs\join(root, name: ".claude/loop.md"));
            if (linked.error -> err) { return result\fail::<[str]>(err.message); }
            if (linked.value!) { lines.append("linked .claude/loop.md"); }
        }
        return result\ok::<[str]>(lines);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "harness-sync: link authored neutral skills and loops");
    }
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help"], valued: ["--id"]);
    if (parsed.values["--help"] != null) { std\print(HELP); return; }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "harness-sync: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final dirty = dirtyGuarded();
    if (dirty.error -> err) { throw err.message; }
    final refused = refuseDirty(dirty.value!);
    if (refused.error -> err) { throw err.message; }
    final id = parsed.values["--id"];
    final loaded = loadedHarnesses();
    if (loaded.error -> err) { throw err.message; }
    final picked = pickHarnesses(id, loaded: loaded.value!);
    if (picked.error -> err) { throw err.message; }
    final installed = installHarnesses(id);
    if (installed.error -> err) { throw err.message; }
    final linked = linkAuthored(installed.value!, root: vcs\root());
    if (linked.error -> err) { throw err.message; }
    foreach (line in linked.value!) { std\print(line); }
    std\print("harness installation is current");
}

test "no id selects all loaded harnesses" {
    assert\equal(pickHarnesses(null, loaded: ["alpha", "beta"]).value!, want: ["alpha", "beta"], message: "all");
    assert\equal(installArgs(null), want: ["harness", "install", "-o", "json"], message: "one installation");
}

test "an id selects one loaded harness" {
    assert\equal(pickHarnesses("beta", loaded: ["alpha", "beta"]).value!, want: ["beta"], message: "selected");
    assert\equal(installArgs("beta"), want: ["harness", "install", "-o", "json", "--id", "beta"], message: "selection forwarded");
}

test "an unknown id is refused" {
    assert\isTrue(pickHarnesses("missing", loaded: ["alpha"]).error != null, message: "unknown");
}

test "dirty committed wiring is refused" {
    assert\isTrue(refuseDirty(["spells/harness/x/spell.buzz"]).error != null, message: "dirty");
    assert\isTrue(refuseDirty([<str>]).value!, message: "clean");
}

test "installed paths discover and deduplicate arbitrary skill roots" {
    final parsed = installedSources(`{"harnesses":[{"id":"custom","skills":[".custom/deep/skills/x/SKILL.md",".custom/deep/skills/y/SKILL.md",".agents/skills/x/SKILL.md"]},{"id":"another","skills":[".custom/deep/skills/z/SKILL.md",".other/skills/x/SKILL.md"]}]}`);
    assert\equal(parsed.value!.skillRoots, want: [".custom/deep/skills", ".other/skills"], message: "discovered roots");
}

test "an installer path escaping the repository is refused" {
    assert\isTrue(installedSources(`{"harnesses":[{"id":"bad","skills":["../skills/x/SKILL.md"]}]}`).error != null, message: "escape");
}

test "authored skill links are idempotent and generated skills stay managed" {
    final root = fs\tempDir("harness-authored");
    fs\mkdirAll(fs\join(root, name: ".agents/skills/local"));
    fs\mkdirAll(fs\join(root, name: ".agents/skills/generated"));
    fs\writeFile(fs\join(root, name: ".agents/skills/local/SKILL.md"), content: "authored");
    fs\writeFile(fs\join(root, name: ".agents/skills/generated/SKILL.md"), content: "<!-- generated by: magus agent install; skill-content: abc -->");
    fs\mkdirAll(fs\join(root, name: ".host/skills"));
    fs\writeFile(fs\join(root, name: ".host/skills/unrelated"), content: "keep");
    final installed = Installed{ids = ["custom"], skillRoots = [".host/skills"]};
    assert\equal(linkAuthored(installed, root: root).value!, want: ["linked .host/skills/local"], message: "first");
    assert\equal(linkAuthored(installed, root: root).value!, want: [<str>], message: "repeat");
    assert\equal(fs\readFile(fs\join(root, name: ".host/skills/local/SKILL.md")), want: "authored", message: "source reached");
    assert\isTrue(!fs\exists(fs\join(root, name: ".host/skills/generated")), message: "generated skipped");
    assert\equal(fs\readFile(fs\join(root, name: ".host/skills/unrelated")), want: "keep", message: "unrelated preserved");
    fs\removeAll(root);
}

test "an existing relative link to the authored source is accepted" {
    final root = fs\tempDir("harness-relative");
    final source = fs\join(root, name: ".agents/skills/local");
    final destination = fs\join(root, name: ".host/skills/local");
    fs\mkdirAll(source);
    fs\mkdirAll(fs\dirname(destination));
    fs\symlink("../../.agents/skills/local", link: destination);
    assert\equal(linkSource(source, destination: destination).value!, want: false, message: "same target");
    fs\removeAll(root);
}

test "a conflicting local file is preserved and refused" {
    final root = fs\tempDir("harness-conflict-file");
    final source = fs\join(root, name: "source");
    final destination = fs\join(root, name: "destination");
    fs\writeFile(source, content: "authored");
    fs\writeFile(destination, content: "local");
    assert\isTrue(linkSource(source, destination: destination).error != null, message: "refused");
    assert\equal(fs\readFile(destination), want: "local", message: "preserved");
    fs\removeAll(root);
}

test "a conflicting dangling link is preserved and refused" {
    final root = fs\tempDir("harness-conflict-link");
    final source = fs\join(root, name: "source");
    final destination = fs\join(root, name: "destination");
    fs\writeFile(source, content: "authored");
    fs\symlink("missing-local-source", link: destination);
    assert\isTrue(linkSource(source, destination: destination).error != null, message: "refused");
    assert\equal(fs\readlink(destination), want: "missing-local-source", message: "preserved");
    fs\removeAll(root);
}

test "Claude mod receives the neutral pull request loop once" {
    final root = fs\tempDir("harness-loop");
    fs\mkdirAll(fs\join(root, name: ".agents/loops"));
    fs\writeFile(fs\join(root, name: ".agents/loops/pull-requests.md"), content: "authored loop");
    final installed = Installed{ids = ["claude-code-mod"], skillRoots = [<str>]};
    assert\equal(linkAuthored(installed, root: root).value!, want: ["linked .claude/loop.md"], message: "first");
    assert\equal(linkAuthored(installed, root: root).value!, want: [<str>], message: "repeat");
    assert\equal(fs\readFile(fs\join(root, name: ".claude/loop.md")), want: "authored loop", message: "source reached");
    fs\removeAll(root);
}

test "another selected harness does not install the Claude loop" {
    final root = fs\tempDir("harness-no-loop");
    final installed = Installed{ids = ["custom"], skillRoots = [<str>]};
    assert\equal(linkAuthored(installed, root: root).value!, want: [<str>], message: "nothing linked");
    assert\isTrue(!fs\exists(fs\join(root, name: ".claude/loop.md")), message: "not selected");
    fs\removeAll(root);
}


test "neutral skill and loop sources are guarded before installation" {
    assert\isTrue(GUARDED.indexOf(".agents/skills") != null, message: "skills guarded");
    assert\isTrue(GUARDED.indexOf(".agents/loops") != null, message: "loops guarded");
    assert\isTrue(refuseDirty([".agents/skills/local/SKILL.md", ".agents/loops/pull-requests.md"]).error != null, message: "uncommitted sources refused");
}

test "mentioning the generated stamp does not make an authored skill generated" {
    assert\equal(generatedSkill("A generated by: magus agent install marker belongs to generated output."), want: false, message: "authored prose");
    assert\equal(generatedSkill("body\n<!-- generated by: magus agent install; skill-content: abc -->\n"), want: true, message: "actual stamp");
}


test "migration preserves an equal legacy regular loop" {
    final root = fs\tempDir("harness-legacy-loop");
    fs\mkdirAll(fs\join(root, name: ".agents/loops"));
    fs\mkdirAll(fs\join(root, name: ".claude"));
    fs\writeFile(fs\join(root, name: ".agents/loops/pull-requests.md"), content: "authored loop\n");
    final legacy = fs\join(root, name: ".claude/loop.md");
    fs\writeFile(legacy, content: "authored loop\n");
    final installed = Installed{ids = ["claude-code-mod"], skillRoots = [<str>]};
    assert\equal(linkAuthored(installed, root: root).value!, want: [<str>], message: "already current");
    assert\equal(fs\readFile(legacy), want: "authored loop\n", message: "legacy bytes preserved");
    assert\equal(fs\readlink(legacy) catch "regular", want: "regular", message: "regular file preserved");
    fs\removeAll(root);
}

test "a differing legacy regular loop is preserved and refused" {
    final root = fs\tempDir("harness-local-loop");
    fs\mkdirAll(fs\join(root, name: ".agents/loops"));
    fs\mkdirAll(fs\join(root, name: ".claude"));
    fs\writeFile(fs\join(root, name: ".agents/loops/pull-requests.md"), content: "authored loop\n");
    final legacy = fs\join(root, name: ".claude/loop.md");
    fs\writeFile(legacy, content: "local loop\n");
    final installed = Installed{ids = ["claude-code-mod"], skillRoots = [<str>]};
    assert\isTrue(linkAuthored(installed, root: root).error != null, message: "conflict refused");
    assert\equal(fs\readFile(legacy), want: "local loop\n", message: "local bytes preserved");
    fs\removeAll(root);
}
