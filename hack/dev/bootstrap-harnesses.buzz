namespace bootstrapharnesses;

import "encoding/json";
import "flags";
import "fs";
import "magus";
import "merge";
import "result";
import "std";
import "vcs";

import "assert";

final USAGE = "usage: magus buzz hack/dev/bootstrap-harnesses.buzz -- [--id <harness>]";
final HELP = "cost: a skill install and one plan read per harness\n{USAGE}\n\n"
    + "Installs the skill trees of the wired harnesses, then merges each harness's host config the way\n"
    + "`magus describe harness <id>` plans it: a file's content is written whole, a fragment is deep-merged into\n"
    + "the file on disk, or written as a new file. Prints one line per file changed, or `no change`.\n"
    + "Refuses, naming the files, while anything under the harness spells, the agent integration docs or the\n"
    + "guard policy differs from HEAD: only committed, reviewed wiring is installed. Writes host config.";
final GUARDED = ["spells/harness", "docs/guides/integrations/agents", "hack/policy"];

export fun refuseDirty(dirty: [str]) > result\Result::<bool> {
    if (dirty.len() > 0) {
        return result\fail::<bool>("harness-sync: REFUSED; {dirty.join(", ")} differ from HEAD, and only committed wiring is installed; commit or revert them, then rerun");
    }
    return result\ok::<bool>(true);
}

fun dirtyGuarded() > result\Result::<[str]> {
    try {
        final paths = mut [<str>];
        foreach (file in vcs\status(GUARDED).files) {
            paths.append(file.value);
        }
        return result\ok::<[str]>(paths);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "harness-sync: read the status of the guarded paths");
    }
}

// loadedHarnesses are the ids of the harnesses this workspace loads.
// A harness is a spell anyone registers, so there is no list to keep.
fun loadedHarnesses() > result\Result::<[str]> {
    try {
        final names = magus\cmd("describe", args: ["harness", "-o", "name"], opts: magus\CommandOptions{ quiet = true }).stdout.trim();
        return result\ok::<[str]>(if (names == "") [<str>] else names.split("\n"));
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "harness-sync: list the loaded harnesses");
    }
}

// pickHarnesses is every loaded harness, or the one --id names. An id no
// loaded harness has is refused, listing the ones there are.
export fun pickHarnesses(id: str?, loaded: [str]) > result\Result::<[str]> {
    if (id == null) {
        return result\ok::<[str]>(loaded);
    }
    if (loaded.indexOf(id!) == null) {
        return result\fail::<[str]>("harness-sync: --id {id!} names no harness this workspace loads; one of {loaded.join(", ")}");
    }
    return result\ok::<[str]>([id!]);
}

// applyPlan writes what plan says each file lacks under root and returns one line per file it changed.
// A merge that reproduces the file on disk writes nothing, so a rerun reports no change.
export fun applyPlan(plan: magus\HarnessInstallation, root: str) > result\Result::<[str]> {
    try {
        final lines = mut [<str>];
        final names = plan.files.keys().cloneMutable();
        names.sort(fun (a: str, b: str) > bool => a < b);
        foreach (name in names) {
            final file = plan.files[name]!;
            final target = fs\join(root, name: name);
            final present = fs\exists(target);
            var text = file.content;
            if (text == "") {
                final base = if (present) fs\readFile(target) else "\{}";
                text = merge\json(base, overlay: json\stringify(file.fragment));
            }
            if (present and fs\readFile(target) == text) {
                continue;
            }
            fs\mkdirAll(fs\dirname(target));
            fs\writeFileAtomic(target, content: text);
            final verb = if (present) "merged" else "created";
            lines.append("{verb} {name} ({plan.id})");
        }
        return result\ok::<[str]>(lines);
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "harness-sync: apply the plan of {plan.id}");
    }
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help"], valued: ["--id"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "harness-sync: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final dirty = dirtyGuarded();
    if (dirty.error -> err) {
        throw err.message;
    }
    final refused = refuseDirty(dirty.value!);
    if (refused.error -> err) {
        throw err.message;
    }
    final id = parsed.values["--id"];
    final loaded = loadedHarnesses();
    if (loaded.error -> err) {
        throw err.message;
    }
    final picked = pickHarnesses(id, loaded: loaded.value!);
    if (picked.error -> err) {
        throw err.message;
    }
    final ids = picked.value!;
    final install = mut ["harness", "install"];
    if (id != null) {
        install.append("--id");
        install.append(id!);
    }
    _ = magus\cmd("agent", args: install, opts: magus\CommandOptions{ quiet = true });
    std\print("harness installation is current");\n}\n", message: "indented");
    fs\removeAll(root);
}

test "a second run changes nothing" {
    final root = fs\tempDir("harness-sync");
    final fragment: {str: any} = json\parse("\{\"a\": 1\}");
    final files = {
        "x.json": magus\HarnessFile{ exists = false, fragment = fragment },
        "y.md": magus\HarnessFile{ exists = false, content = "y\n" },
    };
    assert\equal(applyPlan(plan(files), root: root).value!.len(), want: 2, message: "first run");
    assert\equal(applyPlan(plan(files), root: root).value!, want: [<str>], message: "second run");
    fs\removeAll(root);
}
