// Cost: one merge and one regeneration per branch, and a push each.
//
// Brings a list of branches up to date, in order. Each branch is made
// verify-ready
// (bootstrap-checkout.buzz) so ./magus is built at its head. It is merged with
// --base, `magus vcs resolve --against` settling generated conflicts, and
// committed. ./magus is rebuilt at the merged head before the push. A failed
// rebuild stops the run. The branches are independent by default; --stack makes
// each merge the branch before it instead. A branch another worktree has checked out is merged
// in that worktree; any other is switched to here. It stops at the first branch holding a
// conflict in a source file and lists the files. Every tree it touches must be clean. --dry-run
// prints the steps and runs none.
//
//	magus buzz hack/dev/merge-base-into-branches.buzz -- --branches <a,b,c> [--base <ref>] [--stack] [--dry-run]
namespace mergebaseintobranches;

import "flags";
import "fs";
import "magus";
import "proc";
import "result";
import "std";
import "vcs";
import "hack/dev/bootstrap-checkout" as bootstrap;

import "assert";

final SUMMARY = "bring the base into each branch";
final SERVES = ["replaces:git merge"];

final USAGE = "usage: magus buzz hack/dev/merge-base-into-branches.buzz -- --branches <a,b,c> [--base <ref>] [--stack] [--push] [--dry-run]";
final HELP = "cost: one merge and regeneration per branch, and with --push a push each\n{USAGE}";

export object Step {
    branch: str,
    against: str,
    push: bool = false,
}

// Ran is one command's result, what a stubbed Shell answers.
export object Ran {
    stdout: str = "",
    stderr: str = "",
    code: int = 0,
}

// Shell is every git, magus and verify-ready call the script makes, so a test
// answers them. git
// and run never raise on a failed command; the caller reads code. dir "" is this checkout.
export object Shell {
    git: fun (dir: str, args: [str]) > result\Result::<Ran>,
    run: fun (dir: str, sub: str, args: [str]) > result\Result::<Ran>,
    ready: fun (dir: str) > result\Result::<[str]>,
    atHead: fun (dir: str) > result\Result::<bool>,
}

// steps pairs each branch with what it merges: base for every branch, or with stacked the
// previous branch after the first.
export fun steps(branches: [str], base: str, stacked: bool, push: bool = false) > [Step] {
    final found = mut [<Step>];
    var previous = base;
    foreach (branch in branches) {
        found.append(Step{ branch = branch, against = previous, push = push });
        if (stacked) {
            previous = branch;
        }
    }
    return found;
}

// branchesProblem is why the list names no branches, "" when it does; the caller prefixes its own name.
export fun branchesProblem(branches: [str]) > str {
    if (branches.len() == 0) {
        return "--branches is required";
    }
    final seen = mut {"": true};
    foreach (branch in branches) {
        if (branch == "") {
            return "--branches holds an empty name";
        }
        if (seen[branch] ?? false) {
            return "{branch} appears twice in --branches";
        }
        seen[branch] = true;
    }
    return "";
}

// fetchArgv brings each origin ref the stack merges up to date, [] for
// none. A merge of a stale ref changes nothing.
export fun fetchArgv(stack: [Step]) > [str] {
    final refs = mut [<str>];
    foreach (s in stack) {
        if (s.against.startsWith("origin/") and refs.indexOf(s.against.sub(7)) == null) {
            refs.append(s.against.sub(7));
        }
    }
    if (refs.len() == 0) {
        return [<str>];
    }
    return ["fetch", "--no-tags", "--quiet", "origin"] + refs;
}

fun fetchBases(sh: Shell, stack: [Step]) > result\Result::<str> {
    final argv = fetchArgv(stack);
    if (argv.len() == 0) {
        return result\ok::<str>("");
    }
    return must(sh.git("", args: argv), what: "git {argv.join(" ")}");
}

export fun resolveArgv(against: str) > [str] {
    return ["vcs", "resolve", "--against", against];
}

// worktreeOf is the path of the other worktree that has branch checked out, from
// `git worktree list --porcelain`; "" when none does or only here does.
export fun worktreeOf(porcelain: str, branch: str, here: str) > str {
    var path = "";
    foreach (line in porcelain.split("\n")) {
        if (line.startsWith("worktree ")) {
            path = line.sub(9).trim();
        } else if (line.trim() == "branch refs/heads/{branch}" and path != here) {
            return path;
        }
    }
    return "";
}

// plan is the commands of a step, as the lines --dry-run prints; dir is the worktree that has
// the branch checked out, "" when this one switches to it.
export fun plan(s: Step, dir: str) > [str] {
    var where = "git switch {s.branch}";
    if (dir != "") {
        where = "run in {dir}, where {s.branch} is checked out";
    }
    final found = mut [
        where,
        "magus buzz hack/dev/bootstrap-checkout.buzz -- --here --verify-ready",
        "magus {resolveArgv(s.against).join(" ")}",
        "git commit --no-edit (when the merge is in progress)",
        "magus buzz hack/dev/bootstrap-checkout.buzz -- --here --verify-ready (again, at the merged head)",
    ];
    if (s.push) {
        found.append("git push origin {s.branch}");
    }
    return found;
}

// conflictRefusal names the source files a merge left conflicted, "" when it left none.
export fun conflictRefusal(s: Step, unmerged: [str]) > str {
    if (unmerged.len() == 0) {
        return "";
    }
    return "merge-base-into-branches: merging {s.against} into {s.branch} left {unmerged.len()} source conflict(s): {unmerged.join(", ")}; "
        + "settle each with `magus buzz hack/dev/resolve-conflicts.buzz -- --file <path>` and stage it, then run this again from {s.branch}: it commits the settled merge (git commit --no-edit), pushes when given --push, and carries on";
}

fun lines(text: str) > [str] {
    final acc = mut [<str>];
    foreach (line in text.split("\n")) {
        if (line.trim() != "") {
            acc.append(line.trim());
        }
    }
    return acc;
}

// must is the stdout of a command that exited 0.
fun must(r: result\Result::<Ran>, what: str) > result\Result::<str> {
    if (r.error -> err) {
        return result\Result::<str>{ error = err };
    }
    final ran = r.value!;
    if (ran.code != 0) {
        return result\fail::<str>("merge-base-into-branches: {what}: exit {ran.code}: {ran.stderr}{ran.stdout}");
    }
    return result\ok::<str>(ran.stdout);
}

// locate is the worktree that has the branch checked out other than here, "" when none.
export fun locate(sh: Shell, branch: str, here: str) > result\Result::<str> {
    final listed = must(sh.git("", args: ["worktree", "list", "--porcelain"]), what: "git worktree list");
    if (listed.error -> err) {
        return result\Result::<str>{ error = err };
    }
    return result\ok::<str>(worktreeOf(listed.value!, branch: branch, here: here));
}

export fun update(sh: Shell, s: Step, dir: str) > result\Result::<bool> {
    if (dir == "") {
        final switched = must(sh.git("", args: ["switch", s.branch]), what: "git switch {s.branch}");
        if (switched.error -> err) {
            return result\Result::<bool>{ error = err };
        }
    } else {
        std\print("{s.branch} is checked out in {dir}; merging there");
    }
    final atHead = sh.atHead(dir);
    if (atHead.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    if (!atHead.value!) {
        final ready = sh.ready(dir);
        if (ready.error -> err) {
            return result\Result::<bool>{ error = err };
        }
        foreach (line in ready.value!) {
            std\print("verify-ready: {line}");
        }
    }
    final resolved = sh.run(dir, sub: "vcs", args: resolveArgv(s.against).sub(1));
    if (resolved.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    final diffed = must(sh.git(dir, args: ["diff", "--name-only", "--diff-filter=U"]), what: "git diff --diff-filter=U");
    if (diffed.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    final refused = conflictRefusal(s, unmerged: lines(diffed.value!));
    if (refused != "") {
        return result\fail::<bool>(refused);
    }
    if (resolved.value!.code != 0) {
        return result\fail::<bool>("merge-base-into-branches: `magus {resolveArgv(s.against).join(" ")}` failed on {s.branch}:\n{resolved.value!.stdout}{resolved.value!.stderr}");
    }
    return finish(sh, s: s, dir: dir);
}

fun finish(sh: Shell, s: Step, dir: str) > result\Result::<bool> {
    final head = sh.git(dir, args: ["rev-parse", "-q", "--verify", "MERGE_HEAD"]);
    if (head.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    if (head.value!.code == 0) {
        final committed = must(sh.git(dir, args: ["commit", "--no-edit"]), what: "git commit --no-edit");
        if (committed.error -> err) {
            return result\Result::<bool>{ error = err };
        }
    }
    final rebuilt = sh.ready(dir);
    if (rebuilt.error -> err) {
        return result\fail::<bool>("merge-base-into-branches: rebuilding ./magus at the merged head of {s.branch} failed, so nothing was pushed; rebuild it by hand (bootstrap-checkout.buzz --here --verify-ready) before any other call there: {err.message}");
    }
    foreach (line in rebuilt.value!) {
        std\print("verify-ready: {line}");
    }
    if (!s.push) {
        std\print("updated {s.branch} against {s.against}; not pushed, pass --push to publish it");
        return result\ok::<bool>(true);
    }
    final pushed = must(sh.git(dir, args: ["push", "origin", s.branch]), what: "git push origin {s.branch}");
    if (pushed.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    std\print("updated {s.branch} against {s.against}");
    return result\ok::<bool>(true);
}

// mergeResolved is whether dir holds the branch's own merge with every conflict settled, left
// uncommitted by an earlier run that stopped on a source conflict.
export fun mergeResolved(sh: Shell, branch: str, dir: str) > result\Result::<bool> {
    final head = sh.git(dir, args: ["rev-parse", "-q", "--verify", "MERGE_HEAD"]);
    if (head.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    if (head.value!.code != 0) {
        return result\ok::<bool>(false);
    }
    final current = must(sh.git(dir, args: ["rev-parse", "--abbrev-ref", "HEAD"]), what: "git rev-parse --abbrev-ref HEAD");
    if (current.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    if (current.value!.trim() != branch) {
        return result\ok::<bool>(false);
    }
    final diffed = must(sh.git(dir, args: ["diff", "--name-only", "--diff-filter=U"]), what: "git diff --diff-filter=U");
    if (diffed.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    return result\ok::<bool>(lines(diffed.value!).len() == 0);
}

// execute refuses before any merge when a tree it will touch holds uncommitted changes, then
// updates each branch in its own tree. A branch holding a settled merge is committed and pushed
// instead of refused.
export fun execute(sh: Shell, stack: [Step], here: str) > result\Result::<bool> {
    final dirs = mut [<str>];
    final settled = mut [<bool>];
    foreach (s in stack) {
        final located = locate(sh, branch: s.branch, here: here);
        if (located.error -> err) {
            return result\Result::<bool>{ error = err };
        }
        final dir = located.value!;
        dirs.append(dir);
        final merged = mergeResolved(sh, branch: s.branch, dir: dir);
        if (merged.error -> err) {
            return result\Result::<bool>{ error = err };
        }
        final isSettled = merged.value!;
        settled.append(isSettled);
        if (!isSettled) {
            final status = must(sh.git(dir, args: ["status", "--porcelain"]), what: "git status");
            if (status.error -> err) {
                return result\Result::<bool>{ error = err };
            }
            if (lines(status.value!).len() > 0) {
                var tree = here;
                if (dir != "") {
                    tree = dir;
                }
                return result\fail::<bool>("merge-base-into-branches: the tree at {tree} holds uncommitted changes; commit or drop them first");
            }
        }
    }
    final fetched = fetchBases(sh, stack: stack);
    if (fetched.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    foreach (i, s in stack) {
        if (settled[i]) {
            std\print("{s.branch} holds a settled merge of {s.against}; committing it");
            final finished = finish(sh, s: s, dir: dirs[i]);
            if (finished.error -> err) {
                return result\Result::<bool>{ error = err };
            }
        } else {
            final updated = update(sh, s: s, dir: dirs[i]);
            if (updated.error -> err) {
                return result\Result::<bool>{ error = err };
            }
        }
    }
    return result\ok::<bool>(true);
}

fun liveShell() > Shell {
    return Shell{
        git = fun (dir: str, args: [str]) > result\Result::<Ran> {
            try {
                final r = vcs\cmd(args, opts: vcs\CommandOptions{ quiet = true, allowFailure = true, dir = dir });
                return result\ok::<Ran>(Ran{ stdout = r.stdout, stderr = r.stderr, code = r.code });
            } catch (err: any) {
                return result\caught::<Ran>(err, doing: "merge-base-into-branches: git {args.join(" ")}");
            }
        },
        run = fun (dir: str, sub: str, args: [str]) > result\Result::<Ran> {
            try {
                if (dir != "") {
                    final ran = proc\exec(fs\join(dir, name: "magus"), args: [sub] + args, dir: dir, opts: proc\ExecOptions{ allowFailure = true });
                    return result\ok::<Ran>(Ran{ stdout = ran.stdout, stderr = ran.stderr, code = ran.code });
                }
                final r = magus\cmd(sub, args: args, opts: magus\CommandOptions{ quiet = true, allowFailure = true });
                return result\ok::<Ran>(Ran{ stdout = r.stdout, stderr = r.stderr, code = r.code });
            } catch (err: any) {
                return result\caught::<Ran>(err, doing: "merge-base-into-branches: magus {sub}");
            }
        },
        ready = fun (dir: str) > result\Result::<[str]> {
            try {
                return result\ok::<[str]>(bootstrap\verifyReady(bootstrap\liveHost(), dir: if (dir == "") vcs\root() else dir));
            } catch (err: any) {
                return result\caught::<[str]>(err, doing: "merge-base-into-branches: ready the checkout for the gate");
            }
        },
        atHead = fun (dir: str) > result\Result::<bool> {
            try {
                return result\ok::<bool>(bootstrap\binaryAtHead(bootstrap\liveHost(), dir: if (dir == "") vcs\root() else dir));
            } catch (err: any) {
                return result\caught::<bool>(err, doing: "merge-base-into-branches: check ./magus is at HEAD");
            }
        },
    };
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--dry-run", "--stack", "--push"], valued: ["--branches", "--base"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "merge-base-into-branches: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final named = parsed.values["--branches"] ?? "";
    final branches = if (named == "") [<str>] else named.split(",").map(fun (index: int, b: str) > str => b.trim());
    final problem = branchesProblem(branches);
    if (problem != "") {
        throw "merge-base-into-branches: {problem}\n{USAGE}";
    }
    final stack = steps(branches, base: parsed.values["--base"] ?? "origin/main", stacked: parsed.values["--stack"] != null, push: parsed.values["--push"] != null);
    final sh = liveShell();
    final here = vcs\root();
    if (parsed.values["--dry-run"] != null) {
        std\print("dry run: nothing changes");
        final fetch = fetchArgv(stack);
        if (fetch.len() > 0) {
            std\print("git {fetch.join(" ")}");
        }
        foreach (s in stack) {
            final located = locate(sh, branch: s.branch, here: here);
            if (located.error -> err) {
                throw err.message;
            }
            foreach (line in plan(s, dir: located.value!)) {
                std\print(line);
            }
        }
        return;
    }
    final done = execute(sh, stack: stack, here: here);
    if (done.error -> err) {
        throw err.message;
    }
}

// fake answers git and magus from a table keyed by the command line and records each call in
// calls; a command the table lacks exits 0 with no output.
fun at(dir: str) > str {
    if (dir == "") {
        return "";
    }
    return "@{dir}";
}

fun fake(answers: {str: Ran}, calls: mut [str]) > Shell {
    return fakeReady(answers, calls: calls, buildFails: false);
}

// fakeReady fails the build made after the merge commits, when buildFails.
fun fakeReady(answers: {str: Ran}, calls: mut [str], buildFails: bool, atHead: bool = false) > Shell {
    return Shell{
        atHead = fun (dir: str) > result\Result::<bool> {
            return result\ok::<bool>(atHead);
        },
        git = fun (dir: str, args: [str]) > result\Result::<Ran> {
            final line = "git{at(dir)} {args.join(" ")}";
            calls.append(line);
            return result\ok::<Ran>(answers[line] ?? Ran{});
        },
        run = fun (dir: str, sub: str, args: [str]) > result\Result::<Ran> {
            final line = "magus{at(dir)} {sub} {args.join(" ")}";
            calls.append(line);
            return result\ok::<Ran>(answers[line] ?? Ran{});
        },
        ready = fun (dir: str) > result\Result::<[str]> {
            calls.append("ready {dir}");
            if (buildFails and calls.indexOf("git commit --no-edit") != null) {
                return result\fail::<[str]>("go build failed");
            }
            return result\ok::<[str]>(["built"]);
        },
    };
}

final WORKTREES = "worktree /repo\nHEAD abc\nbranch refs/heads/main\n\nworktree /other\nHEAD def\nbranch refs/heads/b\n";

test "independent branches each merge the base; a stack merges the branch before" {
    final alone = steps(["a", "b", "c"], base: "origin/main", stacked: false);
    assert\equal(alone.map(fun (index: int, s: Step) > str => "{s.branch}<-{s.against}"), want: ["a<-origin/main", "b<-origin/main", "c<-origin/main"], message: "independent");
    final chained = steps(["a", "b", "c"], base: "origin/main", stacked: true);
    assert\equal(chained.map(fun (index: int, s: Step) > str => "{s.branch}<-{s.against}"), want: ["a<-origin/main", "b<-a", "c<-b"], message: "stack");
}

test "an empty, blank or repeated branch list is refused" {
    assert\equal(branchesProblem(["a", "b"]), want: "", message: "ok");
    assert\equal(branchesProblem([]), want: "--branches is required", message: "none");
    assert\equal(branchesProblem(["a", ""]), want: "--branches holds an empty name", message: "blank");
    assert\equal(branchesProblem(["a", "a"]), want: "a appears twice in --branches", message: "twice");
}

test "a branch another worktree holds is found there, this worktree's own is not" {
    assert\equal(worktreeOf(WORKTREES, branch: "b", here: "/repo"), want: "/other", message: "other");
    assert\equal(worktreeOf(WORKTREES, branch: "main", here: "/repo"), want: "", message: "here");
    assert\equal(worktreeOf(WORKTREES, branch: "local-only", here: "/repo"), want: "", message: "nowhere");
}

test "a step's argv and plan name the branch and what it merges" {
    assert\equal(resolveArgv("origin/main"), want: ["vcs", "resolve", "--against", "origin/main"], message: "argv");
    assert\equal(plan(Step{ branch = "b", against = "a", push = true }, dir: ""), want: [
        "git switch b",
        "magus buzz hack/dev/bootstrap-checkout.buzz -- --here --verify-ready",
        "magus vcs resolve --against a",
        "git commit --no-edit (when the merge is in progress)",
        "magus buzz hack/dev/bootstrap-checkout.buzz -- --here --verify-ready (again, at the merged head)",
        "git push origin b",
    ], message: "plan");
    assert\equal(plan(Step{ branch = "b", against = "a" }, dir: "/other")[0], want: "run in /other, where b is checked out", message: "worktree");
}

test "source conflicts stop the run, listing each file and the way forward" {
    final s = Step{ branch = "b", against = "a" };
    assert\equal(conflictRefusal(s, unmerged: []), want: "", message: "clean");
    final why = conflictRefusal(s, unmerged: ["x.go", "y.go"]);
    assert\equal(why.indexOf("left 2 source conflict(s): x.go, y.go") != null, want: true, message: why);
    assert\equal(why.indexOf("resolve-conflicts.buzz") != null, want: true, message: why);
    assert\equal(why.indexOf("it commits the settled merge") != null, want: true, message: why);
}

test "a local branch is switched to here, merged and pushed" {
    final calls = mut [<str>];
    final sh = fake({ "git worktree list --porcelain": Ran{ stdout = WORKTREES }, "git rev-parse -q --verify MERGE_HEAD": Ran{} }, calls: calls);
    assert\isTrue(execute(sh, stack: [Step{ branch = "local-only", against = "origin/main", push = true }], here: "/repo").error == null, message: "executes");
    assert\equal(calls, want: [
        "git worktree list --porcelain",
        "git rev-parse -q --verify MERGE_HEAD",
        "git rev-parse --abbrev-ref HEAD",
        "git status --porcelain",
        "git fetch --no-tags --quiet origin main",
        "git switch local-only",
        "ready ",
        "magus vcs resolve --against origin/main",
        "git diff --name-only --diff-filter=U",
        "git rev-parse -q --verify MERGE_HEAD",
        "git commit --no-edit",
        "ready ",
        "git push origin local-only",
    ], message: "calls");
}

test "each origin ref the stack merges is fetched once, before any merge" {
    assert\equal(fetchArgv(steps(["a", "b"], base: "origin/main", stacked: false)), want: ["fetch", "--no-tags", "--quiet", "origin", "main"], message: "one fetch for a shared base");
    assert\equal(fetchArgv(steps(["a", "b"], base: "origin/main", stacked: true)), want: ["fetch", "--no-tags", "--quiet", "origin", "main"], message: "a stack's later steps merge local branches");
    assert\equal(fetchArgv(steps(["a"], base: "main", stacked: false)), want: [<str>], message: "a local base fetches nothing");

    final calls = mut [<str>];
    final sh = fake({ "git worktree list --porcelain": Ran{ stdout = WORKTREES } }, calls: calls);
    assert\isTrue(execute(sh, stack: steps(["a", "b"], base: "origin/main", stacked: false), here: "/repo").error == null, message: "executes");
    final fetched = calls.indexOf("git fetch --no-tags --quiet origin main");
    final merged = calls.indexOf("magus vcs resolve --against origin/main");
    assert\isTrue(fetched != null and merged != null and fetched! < merged!, message: "fetched before the merge: {calls.join("; ")}");
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("git fetch")).len(), want: 1, message: "once");

    final failing = fake({ "git fetch --no-tags --quiet origin main": Ran{ code = 128, stderr = "no network" } }, calls: mut [<str>]);
    final why = execute(failing, stack: steps(["a"], base: "origin/main", stacked: false), here: "/repo").error!.message;
    assert\isTrue(why.indexOf("no network") != null, message: "a failed fetch stops the run: {why}");
}

test "a branch checked out in another worktree is merged there, never switched to" {
    final calls = mut [<str>];
    final sh = fake({ "git worktree list --porcelain": Ran{ stdout = WORKTREES } }, calls: calls);
    assert\isTrue(execute(sh, stack: [Step{ branch = "b", against = "origin/main", push = true }], here: "/repo").error == null, message: "executes");
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("git switch")).len(), want: 0, message: "no switch");
    assert\equal(calls.indexOf("magus@/other vcs resolve --against origin/main") != null, want: true, message: "ran there");
    assert\equal(calls.indexOf("git@/other push origin b") != null, want: true, message: "pushed from there");
}

test "a rerun commits and pushes a settled merge instead of refusing the dirty tree" {
    final calls = mut [<str>];
    final sh = fake({
        "git rev-parse --abbrev-ref HEAD": Ran{ stdout = "a\n" },
        "git status --porcelain": Ran{ stdout = "M  x.go\n" },
    }, calls: calls);
    assert\isTrue(execute(sh, stack: [Step{ branch = "a", against = "origin/main", push = true }], here: "/repo").error == null, message: "executes");
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("git commit") or c.startsWith("git push")), want: ["git commit --no-edit", "git push origin a"], message: "commit then push");
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("git switch") or c.startsWith("magus")).len(), want: 0, message: "no switch or resolve");
}

test "a merge still holding conflicts, or on another branch, is a dirty tree" {
    final sh = fake({
        "git rev-parse --abbrev-ref HEAD": Ran{ stdout = "a\n" },
        "git diff --name-only --diff-filter=U": Ran{ stdout = "x.go\n" },
        "git status --porcelain": Ran{ stdout = "UU x.go\n" },
    }, calls: mut [<str>]);
    final why = execute(sh, stack: [Step{ branch = "a", against = "origin/main" }], here: "/repo").error!.message;
    assert\equal(why.indexOf("holds uncommitted changes") != null, want: true, message: why);
}

test "a failed git call fails with its stderr" {
    final sh = fake({ "git switch b": Ran{ code = 128, stderr = "fatal: 'b' is already used by worktree" } }, calls: mut [<str>]);
    final why = update(sh, s: Step{ branch = "b", against = "origin/main" }, dir: "").error!.message;
    assert\equal(why.indexOf("exit 128: fatal: 'b' is already used by worktree") != null, want: true, message: why);
}

test "a dirty tree refuses before any merge" {
    final calls = mut [<str>];
    final sh = fake({ "git status --porcelain": Ran{ stdout = " M x.go\n" } }, calls: calls);
    final why = execute(sh, stack: [Step{ branch = "a", against = "origin/main" }], here: "/repo").error!.message;
    assert\equal(why.indexOf("holds uncommitted changes") != null, want: true, message: why);
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("magus")).len(), want: 0, message: "no merge");
}

test "./magus is rebuilt after the merge commits and before the push" {
    final calls = mut [<str>];
    final sh = fake({ "git rev-parse -q --verify MERGE_HEAD": Ran{} }, calls: calls);
    assert\isTrue(update(sh, s: Step{ branch = "b", against = "origin/main", push = true }, dir: "").error == null, message: "updates");
    final marks = calls.filter(fun (index: int, c: str) > bool => c == "ready " or c == "magus vcs resolve --against origin/main" or c == "git commit --no-edit" or c.startsWith("git push"));
    assert\equal(marks, want: ["ready ", "magus vcs resolve --against origin/main", "git commit --no-edit", "ready ", "git push origin b"], message: "order");
}

test "a branch whose ./magus is already at its head is not rebuilt before the merge" {
    final calls = mut [<str>];
    final sh = fakeReady({ "git rev-parse -q --verify MERGE_HEAD": Ran{} }, calls: calls, buildFails: false, atHead: true);
    assert\isTrue(update(sh, s: Step{ branch = "b", against = "origin/main", push = true }, dir: "").error == null, message: "updates");
    final marks = calls.filter(fun (index: int, c: str) > bool => c == "ready " or c == "magus vcs resolve --against origin/main" or c == "git commit --no-edit" or c.startsWith("git push"));
    assert\equal(marks, want: ["magus vcs resolve --against origin/main", "git commit --no-edit", "ready ", "git push origin b"], message: "order");
}

test "a failed rebuild after the merge stops the run before the push" {
    final calls = mut [<str>];
    final sh = fakeReady({ "git rev-parse -q --verify MERGE_HEAD": Ran{} }, calls: calls, buildFails: true);
    final why = update(sh, s: Step{ branch = "b", against = "origin/main", push = true }, dir: "").error!.message;
    assert\equal(why.indexOf("rebuilding ./magus at the merged head of b failed") != null, want: true, message: why);
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("git push")).len(), want: 0, message: "no push");
}

test "a merge is not pushed unless the step asks for it" {
    final calls = mut [<str>];
    final sh = fake({ "git rev-parse -q --verify MERGE_HEAD": Ran{} }, calls: calls);
    assert\isTrue(update(sh, s: Step{ branch = "b", against = "origin/main" }, dir: "").error == null, message: "updates");
    assert\equal(calls.filter(fun (index: int, c: str) > bool => c.startsWith("git push")).len(), want: 0, message: "no push");
    assert\equal(plan(Step{ branch = "b", against = "a" }, dir: "").filter(fun (index: int, c: str) > bool => c.startsWith("git push")).len(), want: 0, message: "plan");
    assert\equal(steps(["a"], base: "origin/main", stacked: false)[0].push, want: false, message: "default");
    assert\equal(steps(["a"], base: "origin/main", stacked: false, push: true)[0].push, want: true, message: "--push");
}
