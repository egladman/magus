// Cost: a fetch, the pr-title, pr-description and pr-changelog targets, a push and a pull request.
//
// Lands commits as a pull request: a new branch from a fresh origin/main, the commits
// cherry-picked onto it, the checkout made gate-ready (bootstrap-checkout.buzz), CI's three pull
// request hygiene checks run locally, then the push and `gh pr create`. It refuses a branch name that exists locally or on origin, and stops at the
// first failed step, leaving the branch where it stood. --dry-run prints the steps and runs none.
//
//	magus buzz hack/dev/land-commits.buzz -- --branch <name> --from <sha,...|ref> --title <text> --body-file <file> [--dry-run]
//
// --from is a comma-separated list of commit ids, or a ref (a job's branch) whose commits past
// origin/main are taken oldest first. Never enables auto-merge; only the main session may push.
namespace landcommits;

import "flags";
import "fs";
import "magus";
import "proc";
import "std";
import "vcs";
import "hack/dev/bootstrap-checkout" as bootstrap;

import "assert";

final USAGE = "usage: magus buzz hack/dev/land-commits.buzz -- --branch <name> --from <sha,...|ref> --title <text> --body-file <file> [--dry-run]";
final HELP = "cost: a fetch, three local checks, a push and a pull request\n{USAGE}";

final BRANCH_NAME = std\pattern(`^[a-z][a-z0-9]*(-[a-z0-9]+)*$`);
final COMMIT_ID = std\pattern(`^[0-9a-f]{7,40}$`);

export object Landing {
    branch: str,
    commits: [str],
    title: str,
    body: str,
    bodyFile: str,
}

// nameProblem is why branch cannot be created, "" when it is free everywhere.
export fun nameProblem(branch: str, local: bool, remote: bool) > str {
    if (BRANCH_NAME.match(branch) == null or branch == "main") {
        return "land-commits: {branch} is not a short lowercase topic name (letters, digits and hyphens)";
    }
    if (local) {
        return "land-commits: branch {branch} already exists locally";
    }
    if (remote) {
        return "land-commits: branch {branch} already exists on origin";
    }
    return "";
}

// isCommitList reports whether source names commit ids rather than a ref.
export fun isCommitList(source: str) > bool {
    foreach (part in source.split(",")) {
        if (COMMIT_ID.match(part.trim()) == null) {
            return false;
        }
    }
    return source != "";
}

// checkArgvs are the three hygiene checks CI runs on a pull request, as `magus` arguments.
export fun checkArgvs(title: str, body: str) > [[str]] {
    return [
        ["run", "pr-title", ".", "--", "--title={title}"],
        ["run", "pr-description", ".", "--", "--title={title}", "--body={body}"],
        ["run", "pr-changelog", ".", "--", "--title={title}"],
    ];
}

export fun pushArgv(branch: str) > [str] {
    return ["push", "-u", "origin", branch];
}

export fun createArgv(branch: str, title: str, bodyFile: str) > [str] {
    return ["pr", "create", "--base", "main", "--head", branch, "--title", title, "--body-file", bodyFile];
}

// plan is the steps of a landing, in order, as the lines --dry-run prints.
export fun plan(l: Landing) > [str] {
    final steps = mut ["git fetch origin main", "git switch -c {l.branch} origin/main"];
    steps.append("git cherry-pick {l.commits.join(" ")}");
    steps.append("magus buzz hack/dev/bootstrap-checkout.buzz -- --here --gate-ready");
    foreach (argv in checkArgvs(l.title, body: "<{l.bodyFile}>")) {
        steps.append("magus {argv.join(" ")}");
    }
    steps.append("git {pushArgv(l.branch).join(" ")}");
    steps.append("gh {createArgv(l.branch, title: l.title, bodyFile: l.bodyFile).join(" ")}");
    return steps;
}

fun git(args: [str]) > str !> any {
    return vcs\cmd(args, opts: {"quiet": true}).stdout;
}

fun commitsOf(source: str) > [str] !> any {
    if (isCommitList(source)) {
        return source.split(",").map(fun (index: int, part: str) > str => part.trim());
    }
    final listed = git(["rev-list", "--reverse", "origin/main..{source}"]).split("\n");
    final commits = mut [<str>];
    foreach (id in listed) {
        if (id.trim() != "") {
            commits.append(id.trim());
        }
    }
    if (commits.len() == 0) {
        throw "land-commits: {source} has no commits past origin/main";
    }
    return commits;
}

fun land(l: Landing) > void !> any {
    git(["fetch", "origin", "main"]);
    git(["switch", "-c", l.branch, "origin/main"]);
    final picked = vcs\cmd(["cherry-pick"] + l.commits, opts: {"quiet": true, "allow_failure": true});
    if (!picked.ok) {
        throw "land-commits: the cherry-pick of {l.commits.join(" ")} conflicted on {l.branch}: settle it with `magus buzz hack/dev/resolve-conflicts.buzz -- --file <path>`, then `git cherry-pick --continue`";
    }
    foreach (line in bootstrap\gateReady(bootstrap\liveHost(), dir: vcs\root())) {
        std\print("gate-ready: {line}");
    }
    foreach (argv in checkArgvs(l.title, body: l.body)) {
        final check = magus\cmd(argv[0], args: argv.sub(1), opts: {"quiet": true, "allow_failure": true});
        if (!check.ok) {
            throw "land-commits: `magus {argv[1]}` failed on {l.branch}: fix it and amend before pushing; nothing was pushed\n{check.stdout}{check.stderr}";
        }
    }
    git(pushArgv(l.branch));
    std\print(proc\exec("gh", args: createArgv(l.branch, title: l.title, bodyFile: l.bodyFile), opts: {"quiet": true}).stdout.trim());
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--dry-run"], valued: ["--branch", "--from", "--title", "--body-file"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "land-commits: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final branch = parsed.values["--branch"] ?? "";
    final source = parsed.values["--from"] ?? "";
    final title = parsed.values["--title"] ?? "";
    final bodyFile = parsed.values["--body-file"] ?? "";
    if (branch == "" or source == "" or title == "" or bodyFile == "") {
        throw "land-commits: --branch, --from, --title and --body-file are required\n{USAGE}";
    }
    if (!fs\isFile(bodyFile)) {
        throw "land-commits: {bodyFile} is not a file";
    }
    final local = git(["branch", "--list", branch]).trim() != "";
    final remote = git(["ls-remote", "--heads", "origin", branch]).trim() != "";
    final refused = nameProblem(branch, local: local, remote: remote);
    if (refused != "") {
        throw refused;
    }
    final landing = Landing{ branch = branch, commits = commitsOf(source), title = title, body = fs\readFile(bodyFile), bodyFile = bodyFile };
    if (parsed.values["--dry-run"] != null) {
        std\print("dry run: nothing changes");
        foreach (step in plan(landing)) {
            std\print(step);
        }
        return;
    }
    land(landing);
}

test "a free short topic name passes; a taken or malformed one is refused, naming why" {
    assert\equal(nameProblem("hack-landing", local: false, remote: false), want: "", message: "free");
    assert\equal(nameProblem("hack-landing", local: true, remote: false), want: "land-commits: branch hack-landing already exists locally", message: "local");
    assert\equal(nameProblem("hack-landing", local: false, remote: true), want: "land-commits: branch hack-landing already exists on origin", message: "remote");
    foreach (bad in ["Feat/Thing", "main", "x_y", "a--b", ""]) {
        assert\equal(nameProblem(bad, local: false, remote: false).indexOf("not a short lowercase topic name") != null, want: true, message: bad);
    }
}

test "--from reads a list of commit ids, and anything else is a ref" {
    assert\equal(isCommitList("abc1234,def56789"), want: true, message: "ids");
    assert\equal(isCommitList("hack-gate-and-bootstrap"), want: false, message: "ref");
    assert\equal(isCommitList("abc1234,main"), want: false, message: "mixed");
}

test "the checks, push and pull request are built as argv with the title and body in one word each" {
    final checks = checkArgvs("add the thing", body: "why it is");
    assert\equal(checks[0], want: ["run", "pr-title", ".", "--", "--title=add the thing"], message: "title");
    assert\equal(checks[1], want: ["run", "pr-description", ".", "--", "--title=add the thing", "--body=why it is"], message: "description");
    assert\equal(checks[2], want: ["run", "pr-changelog", ".", "--", "--title=add the thing"], message: "changelog");
    assert\equal(pushArgv("topic"), want: ["push", "-u", "origin", "topic"], message: "push");
    assert\equal(createArgv("topic", title: "t", bodyFile: "b.md"), want: ["pr", "create", "--base", "main", "--head", "topic", "--title", "t", "--body-file", "b.md"], message: "create");
}

test "the dry run lists every step in order and never enables auto-merge" {
    final steps = plan(Landing{ branch = "topic", commits = ["abc1234", "def5678"], title = "t", body = "b", bodyFile = "b.md" });
    assert\equal(steps.len(), want: 9, message: "steps");
    assert\equal(steps[0], want: "git fetch origin main", message: "fetch");
    assert\equal(steps[1], want: "git switch -c topic origin/main", message: "switch");
    assert\equal(steps[2], want: "git cherry-pick abc1234 def5678", message: "pick");
    assert\equal(steps[3], want: "magus buzz hack/dev/bootstrap-checkout.buzz -- --here --gate-ready", message: "gate-ready before the checks");
    assert\equal(steps[8].indexOf("--auto") == null, want: true, message: "no auto-merge");
}
