// Cost: a fetch, the pr-title, pr-description and pr-changelog targets, a push and a pull request.
//
// Lands commits as a pull request on a new branch from a fresh origin/main.
// It cherry-picks the commits and makes the checkout verify-ready.
// Then it runs CI's three hygiene checks, pushes and runs `gh pr create`.
// It refuses a branch name on origin, or local with other commits. It stops
// at the first failed step, leaving the branch where it stood. A rerun switches
// to that branch and checks again. --dry-run prints the steps and runs none.
//
//	magus buzz hack/dev/land-commits.buzz -- --branch <name> --from <sha,...|ref> --title <text> --body-file <file> [--dry-run]
//
// --from is a comma-separated list of commit ids, or a ref (a job's branch) whose commits past
// origin/main are taken oldest first. Never enables auto-merge; only the main session may push.
namespace landcommits;

import "flags";
import "fs";
import "magus";
import "proc";
import "result";
import "std";
import "vcs";
import "hack/dev/bootstrap-checkout" as bootstrap;

import "assert";

final USAGE = "usage: magus buzz hack/dev/land-commits.buzz -- --branch <name> --from <sha,...|ref> --title <text> --body-file <file> [--dry-run]";
final HELP = "cost: a fetch, three local checks, a push and a pull request\n{USAGE}";

final BRANCH_NAME = std\pattern(`^[a-z][a-z0-9]*(-[a-z0-9]+)*$`);
final COMMIT_ID = std\pattern(`^[0-9a-f]{7,40}$`);

export object Landing {
    branch: str,
    commits: [str],
    title: str,
    body: str,
    bodyFile: str,
    continuing: bool = false,
}

// ownBranch reports whether have, the subjects past origin/main on a branch,
// are exactly want, those of the commits to pick: an earlier run made it.
export fun ownBranch(have: [str], want: [str]) > bool {
    return have.len() > 0 and have.join("\n") == want.join("\n");
}

// nameProblem is why branch cannot be created, "" when it is free everywhere.
export fun nameProblem(branch: str, local: bool, remote: bool) > str {
    if (BRANCH_NAME.match(branch) == null or branch == "main") {
        return "land-commits: {branch} is not a short lowercase topic name (letters, digits and hyphens)";
    }
    if (local) {
        return "land-commits: branch {branch} already exists locally";
    }
    if (remote) {
        return "land-commits: branch {branch} already exists on origin";
    }
    return "";
}

// isCommitList reports whether source names commit ids rather than a ref.
export fun isCommitList(source: str) > bool {
    foreach (part in source.split(",")) {
        if (COMMIT_ID.match(part.trim()) == null) {
            return false;
        }
    }
    return source != "";
}

// checkArgvs are the three hygiene checks CI runs on a pull request, as `magus` arguments.
export fun checkArgvs(title: str, body: str) > [[str]] {
    return [
        ["run", "pr-title", ".", "--", title],
        ["run", "pr-description", ".", "--", "--title={title}", "--body={body}"],
        ["run", "pr-changelog", ".", "--", title],
    ];
}

export fun pushArgv(branch: str) > [str] {
    return ["push", "-u", "origin", branch];
}

export fun createArgv(branch: str, title: str, bodyFile: str) > [str] {
    return ["pr", "create", "--base", "main", "--head", branch, "--title", title, "--body-file", bodyFile];
}

// plan is the steps of a landing, in order, as the lines --dry-run prints.
export fun plan(l: Landing) > [str] {
    final steps = mut [<str>];
    if (l.continuing) {
        steps.append("git switch {l.branch}");
    } else {
        steps.append("git fetch origin main");
        steps.append("git switch -c {l.branch} origin/main");
        steps.append("git cherry-pick {l.commits.join(" ")}");
    }
    steps.append("magus buzz hack/dev/bootstrap-checkout.buzz -- --here --verify-ready");
    foreach (argv in checkArgvs(l.title, body: "<{l.bodyFile}>")) {
        steps.append("magus {argv.join(" ")}");
    }
    steps.append("git {pushArgv(l.branch).join(" ")}");
    steps.append("gh {createArgv(l.branch, title: l.title, bodyFile: l.bodyFile).join(" ")}");
    return steps;
}

fun git(args: [str]) > result\Result::<str> {
    try {
        return result\ok::<str>(vcs\cmd(args, opts: vcs\CommandOptions{ quiet = true }).stdout);
    } catch (err: any) {
        return result\caught::<str>(err, doing: "land-commits: git {args[0]}");
    }
}

fun commitsOf(source: str) > result\Result::<[str]> {
    if (isCommitList(source)) {
        return result\ok::<[str]>(source.split(",").map(fun (index: int, part: str) > str => part.trim()));
    }
    final listed = git(["rev-list", "--reverse", "origin/main..{source}"]);
    if (listed.error -> err) {
        return result\Result::<[str]>{ error = err };
    }
    final commits = mut [<str>];
    foreach (id in listed.value!.split("\n")) {
        if (id.trim() != "") {
            commits.append(id.trim());
        }
    }
    if (commits.len() == 0) {
        return result\fail::<[str]>("land-commits: {source} has no commits past origin/main");
    }
    return result\ok::<[str]>(commits);
}

fun madeByEarlierRun(branch: str, commits: [str]) > result\Result::<bool> {
    final have = git(["log", "--reverse", "--format=%s", "origin/main..{branch}"]);
    if (have.error -> err) {
        return result\Result::<bool>{ error = err };
    }
    final want = mut [<str>];
    foreach (id in commits) {
        final subject = git(["log", "-1", "--format=%s", id]);
        if (subject.error -> err) {
            return result\Result::<bool>{ error = err };
        }
        want.append(subject.value!.trim());
    }
    final lines = mut [<str>];
    foreach (line in have.value!.split("\n")) {
        if (line.trim() != "") {
            lines.append(line.trim());
        }
    }
    return result\ok::<bool>(ownBranch(lines, want: want));
}

fun land(l: Landing) > result\Result::<bool> {
    final setup = if (l.continuing) [["switch", l.branch]] else [["fetch", "origin", "main"], ["switch", "-c", l.branch, "origin/main"]];
    foreach (args in setup) {
        final ran = git(args);
        if (ran.error -> err) {
            return result\Result::<bool>{ error = err };
        }
    }
    try {
        if (!l.continuing) {
            final picked = vcs\cmd(["cherry-pick"] + l.commits, opts: vcs\CommandOptions{ quiet = true, allowFailure = true });
            if (!picked.ok) {
                return result\fail::<bool>("land-commits: the cherry-pick of {l.commits.join(" ")} conflicted on {l.branch}: settle it with `magus buzz hack/dev/resolve-conflicts.buzz -- --file <path>`, then `git cherry-pick --continue`");
            }
        }
        foreach (line in bootstrap\verifyReady(bootstrap\liveHost(), dir: vcs\root())) {
            std\print("verify-ready: {line}");
        }
        foreach (argv in checkArgvs(l.title, body: l.body)) {
            final check = magus\cmd(argv[0], args: argv.sub(1), opts: magus\CommandOptions{ quiet = true, allowFailure = true });
            if (!check.ok) {
                return result\fail::<bool>("land-commits: `magus {argv[1]}` failed on {l.branch}: fix it and amend before pushing; nothing was pushed\n{check.stdout}{check.stderr}");
            }
        }
        final pushed = git(pushArgv(l.branch));
        if (pushed.error -> err) {
            return result\Result::<bool>{ error = err };
        }
        std\print(proc\exec("gh", args: createArgv(l.branch, title: l.title, bodyFile: l.bodyFile), opts: proc\ExecOptions{ quiet = true }).stdout.trim());
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "land-commits: {l.branch}");
    }
    return result\ok::<bool>(true);
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--dry-run"], valued: ["--branch", "--from", "--title", "--body-file"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "land-commits: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final branch = parsed.values["--branch"] ?? "";
    final source = parsed.values["--from"] ?? "";
    final title = parsed.values["--title"] ?? "";
    final bodyFile = parsed.values["--body-file"] ?? "";
    if (branch == "" or source == "" or title == "" or bodyFile == "") {
        throw "land-commits: --branch, --from, --title and --body-file are required\n{USAGE}";
    }
    if (!fs\isFile(bodyFile)) {
        throw "land-commits: {bodyFile} is not a file";
    }
    final local = git(["branch", "--list", branch]);
    if (local.error -> err) {
        throw err.message;
    }
    final remote = git(["ls-remote", "--heads", "origin", branch]);
    if (remote.error -> err) {
        throw err.message;
    }
    final commits = commitsOf(source);
    if (commits.error -> err) {
        throw err.message;
    }
    final onRemote = remote.value!.trim() != "";
    var onLocal = local.value!.trim() != "";
    var continuing = false;
    if (onLocal and !onRemote) {
        final own = madeByEarlierRun(branch, commits: commits.value!);
        if (own.error -> err) {
            throw err.message;
        }
        continuing = own.value!;
        onLocal = !continuing;
    }
    final refused = nameProblem(branch, local: onLocal, remote: onRemote);
    if (refused != "") {
        throw refused;
    }
    final landing = Landing{ branch = branch, commits = commits.value!, title = title, body = fs\readFile(bodyFile), bodyFile = bodyFile, continuing = continuing };
    if (parsed.values["--dry-run"] != null) {
        std\print("dry run: nothing changes");
        foreach (step in plan(landing)) {
            std\print(step);
        }
        return;
    }
    final landed = land(landing);
    if (landed.error -> err) {
        throw err.message;
    }
}

test "a free short topic name passes; a taken or malformed one is refused, naming why" {
    assert\equal(nameProblem("hack-landing", local: false, remote: false), want: "", message: "free");
    assert\equal(nameProblem("hack-landing", local: true, remote: false), want: "land-commits: branch hack-landing already exists locally", message: "local");
    assert\equal(nameProblem("hack-landing", local: false, remote: true), want: "land-commits: branch hack-landing already exists on origin", message: "remote");
    foreach (bad in ["Feat/Thing", "main", "x_y", "a--b", ""]) {
        assert\equal(nameProblem(bad, local: false, remote: false).indexOf("not a short lowercase topic name") != null, want: true, message: bad);
    }
}

test "--from reads a list of commit ids, and anything else is a ref" {
    assert\equal(isCommitList("abc1234,def56789"), want: true, message: "ids");
    assert\equal(isCommitList("hack-gate-and-bootstrap"), want: false, message: "ref");
    assert\equal(isCommitList("abc1234,main"), want: false, message: "mixed");
}

test "the checks, push and pull request are built as argv with the title and body in one word each" {
    final checks = checkArgvs("add the thing", body: "why it is");
    assert\equal(checks[0], want: ["run", "pr-title", ".", "--", "add the thing"], message: "title");
    assert\equal(checks[1], want: ["run", "pr-description", ".", "--", "--title=add the thing", "--body=why it is"], message: "description");
    assert\equal(checks[2], want: ["run", "pr-changelog", ".", "--", "add the thing"], message: "changelog");
    assert\equal(pushArgv("topic"), want: ["push", "-u", "origin", "topic"], message: "push");
    assert\equal(createArgv("topic", title: "t", bodyFile: "b.md"), want: ["pr", "create", "--base", "main", "--head", "topic", "--title", "t", "--body-file", "b.md"], message: "create");
}

test "a branch holding exactly the commits to pick is a rerun's own" {
    assert\equal(ownBranch(["a", "b"], want: ["a", "b"]), want: true, message: "same");
    assert\equal(ownBranch([<str>], want: [<str>]), want: false, message: "empty is a fresh name clash");
    assert\equal(ownBranch(["a"], want: ["a", "b"]), want: false, message: "short");
    assert\equal(ownBranch(["a", "x"], want: ["a", "b"]), want: false, message: "other work");
}

test "a rerun switches to its branch and picks nothing" {
    final steps = plan(Landing{ branch = "topic", commits = ["abc1234"], title = "t", body = "b", bodyFile = "b.md", continuing = true });
    assert\equal(steps.len(), want: 7, message: "steps");
    assert\equal(steps[0], want: "git switch topic", message: "switch");
    assert\equal(steps[1].startsWith("magus buzz"), want: true, message: "verify-ready next");
}

test "the dry run lists every step in order and never enables auto-merge" {
    final steps = plan(Landing{ branch = "topic", commits = ["abc1234", "def5678"], title = "t", body = "b", bodyFile = "b.md" });
    assert\equal(steps.len(), want: 9, message: "steps");
    assert\equal(steps[0], want: "git fetch origin main", message: "fetch");
    assert\equal(steps[1], want: "git switch -c topic origin/main", message: "switch");
    assert\equal(steps[2], want: "git cherry-pick abc1234 def5678", message: "pick");
    assert\equal(steps[3], want: "magus buzz hack/dev/bootstrap-checkout.buzz -- --here --verify-ready", message: "verify-ready before the checks");
    assert\equal(steps[8].indexOf("--auto") == null, want: true, message: "no auto-merge");
}
