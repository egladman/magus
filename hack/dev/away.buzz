// Opens, closes and reports on an away window (ADR 0019), run by the person, never an agent:
// the guard denies start and end to one.
//
//	magus buzz hack/dev/away.buzz -- start --until HH:MM --tolerance <tier> --rows a,b
//	magus buzz hack/dev/away.buzz -- end
//	magus buzz hack/dev/away.buzz -- report
//
// start appends the contract to the repository's away file (hack/policy/away.buzz says
// where) and prints its terms back; end appends the line that closes it; report prints what
// the window did from the job store and the contract.
namespace awaywindow;

import "std";
import "fs";
import "proc";
import "vcs";
import "flags";
import "magus";
import "./hack/policy/away" as away;

final USAGE = "usage: magus buzz hack/dev/away.buzz -- start --until HH:MM --tolerance <tier> --rows a,b | end | report";

final dayMs = 86400000;

// reserved is what the window keeps for the person, printed back at start.
final reserved = [
    "new scope: `job fork` of a row the contract does not name, and any `job apply`",
    "reversing a decision: writes under docs/decisions/ and docs/design/",
    "hook and permission config: writes to .claude/, .codex/, hack/policy/, spells/harness/, magus.yaml",
    "a job grant",
    "merge and push",
    "deleting work the window did not create: `job rm`, `git branch -D`, `git worktree remove`",
];

// parseClock reads HH:MM as minutes past midnight, null for anything else.
export fun parseClock(text: str) > int? {
    final parts = text.split(":");
    if (parts.len() != 2 or parts[0].len() != 2 or parts[1].len() != 2) {
        return null;
    }
    final hours = std\parseInt(parts[0]);
    final minutes = std\parseInt(parts[1]);
    if (hours == null or minutes == null or hours! < 0 or hours! > 23 or minutes! < 0 or minutes! > 59) {
        return null;
    }
    return hours! * 60 + minutes!;
}

// parseOffset reads `date +%z` (+0130, -0400) as milliseconds east of UTC, null for anything
// else.
export fun parseOffset(text: str) > int? {
    final t = text.trim();
    if (t.len() != 5 or (t.sub(0, len: 1) != "+" and t.sub(0, len: 1) != "-")) {
        return null;
    }
    final hours = std\parseInt(t.sub(1, len: 2));
    final minutes = std\parseInt(t.sub(3, len: 2));
    if (hours == null or minutes == null) {
        return null;
    }
    final ms = (hours! * 60 + minutes!) * 60000;
    return if (t.sub(0, len: 1) == "-") -ms else ms;
}

// nextAt is the first moment after now at minutes past local midnight, local being offset
// milliseconds east of UTC. A daylight-saving change inside the window moves it by the change.
export fun nextAt(minutes: int, now: int, offset: int) > int {
    final local = now + offset;
    final midnight = local - local % dayMs - offset;
    var at = midnight + minutes * 60000;
    if (at <= now) {
        at = at + dayMs;
    }
    return at;
}

fun localOffset() > int !> any {
    final printed = proc\exec("date", args: ["+%z"], opts: {"quiet": true}).stdout;
    if (parseOffset(printed) -> offset) {
        return offset;
    }
    throw "away: `date +%z` printed {printed.trim()}, which is no UTC offset; the end time cannot be placed";
}

fun contractFile(root: str) > str !> any {
    if (away\contractFile(root) -> file) {
        return file;
    }
    throw "away: {root} is not a git checkout, so there is no repository directory to keep the contract in";
}

fun append(root: str, c: away\Contract) > void !> any {
    final file = contractFile(root);
    fs\mkdirAll(fs\dirname(file));
    fs\appendFile(file, content: away\encodeContract(c) + "\n");
}

fun start(root: str, args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: [<str>], valued: ["--until", "--tolerance", "--rows", "--tokens"]);
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "away start: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    if (parsed.values["--tokens"] != null) {
        throw "away start: --tokens is refused: magus counts no session tokens, so no budget could be obeyed; the end time is the cap";
    }
    final clock = parsed.values["--until"] ?? "";
    final minutes = parseClock(clock);
    if (minutes == null) {
        throw "away start: --until takes the local end time as HH:MM, and got {shown(clock)}\n{USAGE}";
    }
    final tolerance = parsed.values["--tolerance"] ?? "";
    if (away\tiers.indexOf(tolerance) == null) {
        throw "away start: --tolerance takes one of {away\tiers.join(", ")}, and got {shown(tolerance)}";
    }
    if (away\rank(tolerance) > away\rank(away\ceiling)) {
        throw "away start: --tolerance {tolerance} is above this repository's ceiling, {away\ceiling} (hack/policy/away.buzz)";
    }
    final named = (parsed.values["--rows"] ?? "").split(",").filter(fun (index: int, id: str) > bool => id.trim() != "");
    if (named.len() == 0) {
        throw "away start: --rows names the approved job rows, comma-separated; a window with none has nothing to carry out";
    }
    final jobs = away\rows(magus\job.list().jobs);
    final missing = named.filter(fun (index: int, id: str) > bool {
        foreach (r in jobs) {
            if (r.id == id) {
                return false;
            }
        }
        return true;
    });
    if (missing.len() > 0) {
        throw "away start: the job store holds no row {missing.join(", ")}; `job apply` the plan before the window opens";
    }
    final now = away\now();
    if (away\isOpen(away\loadContract(root), now: now)) {
        throw "away start: a window is already open; `magus buzz hack/dev/away.buzz -- end` closes it first";
    }
    final ends = nextAt(minutes!, now: now, offset: localOffset());
    append(root, c: away\Contract{ action = "start", at = now, endClock = clock, ends = ends, tolerance = tolerance, rows = named });
    std\print("away window open until {clock} local ({(ends - now) / 60000} minutes from now)");
    std\print("rows: {named.join(", ")} and the children forked from them");
    std\print("tolerance: an unsettled job lands only at {tolerance} or below; above it, it parks");
    std\print("stop condition: the end time passes, every approved row is paused or done, or one refusal repeats {3} stops running");
    std\print("reserved for you:");
    foreach (r in reserved) {
        std\print("  - {r}");
    }
}

fun end(root: str) > void !> any {
    final now = away\now();
    if (!away\isOpen(away\loadContract(root), now: now)) {
        std\print("no away window is open; nothing to end");
        return;
    }
    append(root, c: away\Contract{ action = "end", at = now });
    std\print("away window closed");
}

fun report(root: str) > void !> any {
    var last: away\Contract? = null;
    var started: away\Contract? = null;
    foreach (line in (fs\readFile(contractFile(root)) catch "").split("\n")) {
        if (away\parseContract(line) -> c) {
            last = c;
            if (c.action == "start") {
                started = c;
            }
        }
    }
    if (started == null) {
        std\print("no away window was ever opened in this repository");
        return;
    }
    final window = started!;
    final list = magus\job.list();
    final jobs = away\rows(list.jobs);
    final now = away\now();
    if (last!.action == "end") {
        std\print("the last away window, until {window.endClock} with tolerance {window.tolerance}, was closed by hand");
    } else {
        final state = if (away\isOpen(window, now: now)) "open" else "past its end time";
        std\print("away window until {window.endClock}, {state}; tolerance {window.tolerance}");
    }
    final blocked = mut [<str>];
    foreach (b in list.blocked) {
        blocked.append(b.job);
    }
    final landed = mut [<str>];
    final parked = mut [<str>];
    final left = mut [<str>];
    foreach (r in jobs) {
        if (!away\approved(r.id, c: window, jobs: jobs)) {
            continue;
        }
        if (away\settled(r)) {
            landed.append(r.id);
        } else if (r.state == "pass" or r.state == "exited" or r.state == "fail") {
            final got = away\unproven(r.id);
            parked.append("{r.id}: {r.state}, tier {got.tier}; {got.evidence.join("; ")}");
        } else if (r.paused) {
            left.append("{r.id}: paused");
        } else if (blocked.indexOf(r.id) != null) {
            left.append("{r.id}: blocked");
        } else if (now >= window.ends) {
            left.append("{r.id}: {r.state}, past the cap");
        } else {
            left.append("{r.id}: {r.state}");
        }
    }
    section("parked, for you to read first", rows: parked);
    section("landed", rows: landed);
    section("left", rows: left);
    final attention = away\attentionFile(root) ?? "";
    final filed = if (attention != "") (fs\readLines(attention) catch [<str>]) else [<str>];
    section("attention", rows: filed);
    section("left for you", rows: [
        "push each landed branch: `git push origin <branch>`",
        "merge: `gh pr merge <n>` once its checks pass",
        "grants a parked row needs: `./magus job grant <job> <rule>`",
        "hook wiring: the root magusfile registers `magus\\guard.stop(agentpolicy\\judgeStop);` once this magus has the seam",
    ]);
}

fun shown(value: str) > str {
    return if (value == "") "nothing" else value;
}

fun section(title: str, rows: [str]) > void {
    std\print("{title} ({rows.len()})");
    foreach (r in rows) {
        std\print("  {r}");
    }
}

export fun main(args: [str]) > void !> any {
    if (args.len() == 0) {
        throw "away: {USAGE}";
    }
    if (vcs\name() != "git") {
        throw "away: the contract lives in the git common directory, and this checkout is {vcs\name()}";
    }
    final root = vcs\root();
    final rest = args.sub(1);
    if (args[0] == "start") {
        start(root, args: rest);
    } else if (args[0] == "end") {
        end(root);
    } else if (args[0] == "report") {
        report(root);
    } else {
        throw "away: unknown subcommand {args[0]}\n{USAGE}";
    }
}

test "an end time is HH:MM on a 24-hour clock" {
    std\assert(parseClock("07:30") == 450, message: "07:30");
    std\assert(parseClock("7:30") == null, message: "one hour digit");
    std\assert(parseClock("24:00") == null, message: "hour 24");
    std\assert(parseClock("07:60") == null, message: "minute 60");
    std\assert(parseClock("") == null, message: "empty");
}

test "an offset reads date's +HHMM, west of UTC negative" {
    std\assert(parseOffset("+0100\n") == 3600000, message: "east");
    std\assert(parseOffset("-0430") == -16200000, message: "west");
    std\assert(parseOffset("UTC") == null, message: "not an offset");
}

test "the end is the next time the local clock reads HH:MM" {
    final hour = 3600000;
    // 2026-10-28T22:00Z, local UTC+1 reads 23:00.
    final now = 1793224800000;
    std\assert(nextAt(450, now: now, offset: hour) == now + 7 * hour + 30 * 60000 + hour, message: "07:30 local tomorrow");
    std\assert(nextAt(23 * 60 + 30, now: now, offset: hour) == now + 30 * 60000, message: "23:30 local tonight");
    std\assert(nextAt(23 * 60, now: now, offset: hour) == now + 24 * hour, message: "the minute now is tomorrow's");
}
