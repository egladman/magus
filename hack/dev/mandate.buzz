// Issues, revokes and reports on a mandate (ADR 0019), run by the person, never by the root
// or a worker: the guard denies issue and revoke to every agent.
//
//	magus buzz hack/dev/mandate.buzz -- issue --until HH:MM --tolerance <tier> --rows a,b
//	magus buzz hack/dev/mandate.buzz -- revoke
//	magus buzz hack/dev/mandate.buzz -- report
//
// issue appends the mandate to the repository's mandate file (hack/policy/mandate.buzz says
// where) and prints its terms back; revoke appends the line that ends it; report prints what
// was done under it from the job store and the mandate.
namespace mandatescript;

import "std";
import "fs";
import "proc";
import "vcs";
import "flags";
import "magus";
import "./hack/policy/mandate" as mandate;

final USAGE = "usage: magus buzz hack/dev/mandate.buzz -- issue --until HH:MM --tolerance <tier> --rows a,b | revoke | report";

final dayMs = 86400000;

// reserved is what a mandate keeps for the person, printed back at issue.
final reserved = [
    "new scope: `job fork` of a row the mandate does not name, and any `job apply`",
    "reversing a decision: writes under docs/decisions/ and docs/design/",
    "hook and permission config: writes to .claude/, .codex/, hack/policy/, spells/harness/, magus.yaml",
    "a grant",
    "merge and push",
    "deleting work not made under the mandate: `job rm`, `git branch -D`, `git worktree remove`",
];

// parseClock reads HH:MM as minutes past midnight, null for anything else.
export fun parseClock(text: str) > int? {
    final parts = text.split(":");
    if (parts.len() != 2 or parts[0].len() != 2 or parts[1].len() != 2) {
        return null;
    }
    final hours = std\parseInt(parts[0]);
    final minutes = std\parseInt(parts[1]);
    if (hours == null or minutes == null or hours! < 0 or hours! > 23 or minutes! < 0 or minutes! > 59) {
        return null;
    }
    return hours! * 60 + minutes!;
}

// parseOffset reads `date +%z` (+0130, -0400) as milliseconds east of UTC, null for anything
// else.
export fun parseOffset(text: str) > int? {
    final t = text.trim();
    if (t.len() != 5 or (t.sub(0, len: 1) != "+" and t.sub(0, len: 1) != "-")) {
        return null;
    }
    final hours = std\parseInt(t.sub(1, len: 2));
    final minutes = std\parseInt(t.sub(3, len: 2));
    if (hours == null or minutes == null) {
        return null;
    }
    final ms = (hours! * 60 + minutes!) * 60000;
    return if (t.sub(0, len: 1) == "-") -ms else ms;
}

// nextAt is the first moment after now at minutes past local midnight, local being offset
// milliseconds east of UTC. A daylight-saving change inside the mandate moves it by the change.
export fun nextAt(minutes: int, now: int, offset: int) > int {
    final local = now + offset;
    final midnight = local - local % dayMs - offset;
    var at = midnight + minutes * 60000;
    if (at <= now) {
        at = at + dayMs;
    }
    return at;
}

fun localOffset() > int !> any {
    final printed = proc\exec("date", args: ["+%z"], opts: {"quiet": true}).stdout;
    if (parseOffset(printed) -> offset) {
        return offset;
    }
    throw "mandate: `date +%z` printed {printed.trim()}, which is no UTC offset; the end time cannot be placed";
}

fun mandateFile(root: str) > str !> any {
    if (mandate\mandateFile(root) -> file) {
        return file;
    }
    throw "mandate: {root} is not a git checkout, so there is no repository directory to keep the mandate in";
}

fun append(root: str, m: mandate\Mandate) > void !> any {
    final file = mandateFile(root);
    fs\mkdirAll(fs\dirname(file));
    fs\appendFile(file, content: mandate\encodeMandate(m) + "\n");
}

fun issue(root: str, args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: [<str>], valued: ["--until", "--tolerance", "--rows", "--tokens"]);
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "mandate issue: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    if (parsed.values["--tokens"] != null) {
        throw "mandate issue: --tokens is refused: magus counts no session tokens, so no budget could be obeyed; the end time is the cap";
    }
    final clock = parsed.values["--until"] ?? "";
    final minutes = parseClock(clock);
    if (minutes == null) {
        throw "mandate issue: --until takes the local end time as HH:MM, and got {shown(clock)}\n{USAGE}";
    }
    final tolerance = parsed.values["--tolerance"] ?? "";
    if (mandate\tiers.indexOf(tolerance) == null) {
        throw "mandate issue: --tolerance takes one of {mandate\tiers.join(", ")}, and got {shown(tolerance)}";
    }
    if (mandate\rank(tolerance) > mandate\rank(mandate\ceiling)) {
        throw "mandate issue: --tolerance {tolerance} is above this repository's ceiling, {mandate\ceiling} (hack/policy/mandate.buzz)";
    }
    final named = (parsed.values["--rows"] ?? "").split(",").filter(fun (index: int, id: str) > bool => id.trim() != "");
    if (named.len() == 0) {
        throw "mandate issue: --rows names the plan's job rows, comma-separated; a mandate with none has nothing to carry out";
    }
    final jobs = mandate\rows(magus\job.list().jobs);
    final missing = named.filter(fun (index: int, id: str) > bool {
        foreach (r in jobs) {
            if (r.id == id) {
                return false;
            }
        }
        return true;
    });
    if (missing.len() > 0) {
        throw "mandate issue: the job store holds no row {missing.join(", ")}; `job apply` the plan before the mandate is issued";
    }
    final now = mandate\now();
    if (mandate\inForce(mandate\loadMandate(root), now: now)) {
        throw "mandate issue: a mandate is already in force; `magus buzz hack/dev/mandate.buzz -- revoke` ends it first";
    }
    final ends = nextAt(minutes!, now: now, offset: localOffset());
    append(root, m: mandate\Mandate{ action = "issue", at = now, endClock = clock, ends = ends, tolerance = tolerance, rows = named });
    std\print("mandate in force until {clock} local ({(ends - now) / 60000} minutes from now)");
    std\print("rows: {named.join(", ")} and the children forked from them");
    std\print("tolerance: an unsettled job's work is integrated only at {tolerance} or below; above it, it is held for review");
    std\print("stop condition: the end time passes, every mandated row is paused or done, or one refusal repeats {mandate\loopLimit} stops running");
    std\print("reserved for you:");
    foreach (r in reserved) {
        std\print("  - {r}");
    }
}

fun revoke(root: str) > void !> any {
    final now = mandate\now();
    if (!mandate\inForce(mandate\loadMandate(root), now: now)) {
        std\print("no mandate is in force; nothing to revoke");
        return;
    }
    append(root, m: mandate\Mandate{ action = "revoke", at = now });
    std\print("mandate revoked");
}

fun report(root: str) > void !> any {
    var last: mandate\Mandate? = null;
    var issued: mandate\Mandate? = null;
    foreach (line in (fs\readFile(mandateFile(root)) catch "").split("\n")) {
        if (mandate\parseMandate(line) -> m) {
            last = m;
            if (m.action == "issue") {
                issued = m;
            }
        }
    }
    if (issued == null) {
        std\print("no mandate was ever issued in this repository");
        return;
    }
    final terms = issued!;
    final list = magus\job.list();
    final jobs = mandate\rows(list.jobs);
    final now = mandate\now();
    if (last!.action == "revoke") {
        std\print("the last mandate, until {terms.endClock} with tolerance {terms.tolerance}, was revoked");
    } else {
        final state = if (mandate\inForce(terms, now: now)) "in force" else "past its end time";
        std\print("mandate until {terms.endClock}, {state}; tolerance {terms.tolerance}");
    }
    final blocked = mut [<str>];
    foreach (b in list.blocked) {
        blocked.append(b.job);
    }
    final integrated = mut [<str>];
    final held = mut [<str>];
    final left = mut [<str>];
    foreach (r in jobs) {
        if (!mandate\mandated(r.id, m: terms, jobs: jobs)) {
            continue;
        }
        if (mandate\settled(r)) {
            integrated.append(r.id);
        } else if (r.state == "pass" or r.state == "exited" or r.state == "fail") {
            final got = mandate\unproven(r.id);
            held.append("{r.id}: {r.state}, tier {got.tier}; {got.evidence.join("; ")}");
        } else if (r.paused) {
            left.append("{r.id}: paused");
        } else if (blocked.indexOf(r.id) != null) {
            left.append("{r.id}: blocked");
        } else if (now >= terms.ends) {
            left.append("{r.id}: {r.state}, past the cap");
        } else {
            left.append("{r.id}: {r.state}");
        }
    }
    section("held for review, for you to read first", rows: held);
    section("integrated", rows: integrated);
    section("left", rows: left);
    final attention = mandate\attentionFile(root) ?? "";
    final filed = if (attention != "") (fs\readLines(attention) catch [<str>]) else [<str>];
    section("attention", rows: filed);
    section("left for you", rows: [
        "push each integrated branch: `git push origin <branch>`",
        "merge: `gh pr merge <n>` once its checks pass",
        "a grant a held row needs: `./magus job grant <job> <rule>`",
        "hook wiring: the root magusfile registers `magus\\guard.stop(agentpolicy\\judgeStop);`",
    ]);
}

fun shown(value: str) > str {
    return if (value == "") "nothing" else value;
}

fun section(title: str, rows: [str]) > void {
    std\print("{title} ({rows.len()})");
    foreach (r in rows) {
        std\print("  {r}");
    }
}

export fun main(args: [str]) > void !> any {
    if (args.len() == 0) {
        throw "mandate: {USAGE}";
    }
    if (vcs\name() != "git") {
        throw "mandate: the mandate lives in the git common directory, and this checkout is {vcs\name()}";
    }
    final root = vcs\root();
    final rest = args.sub(1);
    if (args[0] == "issue") {
        issue(root, args: rest);
    } else if (args[0] == "revoke") {
        revoke(root);
    } else if (args[0] == "report") {
        report(root);
    } else {
        throw "mandate: unknown subcommand {args[0]}\n{USAGE}";
    }
}

test "an end time is HH:MM on a 24-hour clock" {
    std\assert(parseClock("07:30") == 450, message: "07:30");
    std\assert(parseClock("7:30") == null, message: "one hour digit");
    std\assert(parseClock("24:00") == null, message: "hour 24");
    std\assert(parseClock("07:60") == null, message: "minute 60");
    std\assert(parseClock("") == null, message: "empty");
}

test "an offset reads date's +HHMM, west of UTC negative" {
    std\assert(parseOffset("+0100\n") == 3600000, message: "east");
    std\assert(parseOffset("-0430") == -16200000, message: "west");
    std\assert(parseOffset("UTC") == null, message: "not an offset");
}

test "the end is the next time the local clock reads HH:MM" {
    final hour = 3600000;
    // 2026-10-28T22:00Z, local UTC+1 reads 23:00.
    final now = 1793224800000;
    std\assert(nextAt(450, now: now, offset: hour) == now + 7 * hour + 30 * 60000 + hour, message: "07:30 local tomorrow");
    std\assert(nextAt(23 * 60 + 30, now: now, offset: hour) == now + 30 * 60000, message: "23:30 local tonight");
    std\assert(nextAt(23 * 60, now: now, offset: hour) == now + 24 * hour, message: "the minute now is tomorrow's");
}
