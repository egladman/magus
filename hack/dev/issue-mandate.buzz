// Issues, revokes and reports on a mandate (ADR 0019), run by the person, never by the root
// or a worker: the guard denies issue and revoke to every agent.
//
//	magus buzz hack/dev/issue-mandate.buzz -- issue --until HH:MM --tolerance <tier> --rows a,b
//	magus buzz hack/dev/issue-mandate.buzz -- revoke
//	magus buzz hack/dev/issue-mandate.buzz -- report
//
// issue appends the mandate to the repository's mandate file (hack/policy/mandate.buzz says
// where) and prints its terms back; revoke appends the line that ends it; report prints what
// was done under it from the job store and the mandate.
namespace mandatescript;

import "result";
import "std";
import "fs";
import "proc";
import "vcs";
import "flags";
import "magus";
import "./hack/policy/mandate" as mandate;
import "./hack/magusfile/branch-stack" as branchstack;

final USAGE = "usage: magus buzz hack/dev/issue-mandate.buzz -- issue --until HH:MM --tolerance <tier> --rows a,b [--review-budget <lines>] | revoke | report";

final dayMs = 86400000;

// reserved is what a mandate keeps for the person, printed back at issue.
final reserved = [
    "new scope: `job fork` of a row the mandate does not name, and any `job apply`",
    "reversing a decision: writes under docs/decisions/ and docs/design/",
    "hook and permission config: writes to .claude/, .codex/, hack/policy/, spells/harness/, magus.yaml",
    "a grant",
    "merge and push",
    "deleting work not made under the mandate: `job rm`, `git branch -D`, `git worktree remove`",
];

// parseClock reads HH:MM as minutes past midnight, null for anything else.
export fun parseClock(text: str) > int? {
    final parts = text.split(":");
    if (parts.len() != 2 or parts[0].len() != 2 or parts[1].len() != 2) {
        return null;
    }
    final hours = std\parseInt(parts[0]);
    final minutes = std\parseInt(parts[1]);
    if (hours == null or minutes == null or hours! < 0 or hours! > 23 or minutes! < 0 or minutes! > 59) {
        return null;
    }
    return hours! * 60 + minutes!;
}

// parseOffset reads `date +%z` (+0130, -0400) as milliseconds east of UTC, null for anything
// else.
export fun parseOffset(text: str) > int? {
    final t = text.trim();
    if (t.len() != 5 or (t.sub(0, len: 1) != "+" and t.sub(0, len: 1) != "-")) {
        return null;
    }
    final hours = std\parseInt(t.sub(1, len: 2));
    final minutes = std\parseInt(t.sub(3, len: 2));
    if (hours == null or minutes == null) {
        return null;
    }
    final ms = (hours! * 60 + minutes!) * 60000;
    return if (t.sub(0, len: 1) == "-") -ms else ms;
}

// nextAt is the first moment after now at minutes past local midnight, local being offset
// milliseconds east of UTC. A daylight-saving change inside the mandate moves it by the change.
export fun nextAt(minutes: int, now: int, offset: int) > int {
    final local = now + offset;
    final midnight = local - local % dayMs - offset;
    var at = midnight + minutes * 60000;
    if (at <= now) {
        at = at + dayMs;
    }
    return at;
}

fun localOffset() > result\Result::<int> {
    try {
        final printed = proc\exec("date", args: ["+%z"], opts: proc\ExecOptions{ quiet = true }).stdout;
        if (parseOffset(printed) -> offset) {
            return result\ok::<int>(offset);
        }
        return result\fail::<int>("mandate: `date +%z` printed {printed.trim()}, which is no UTC offset; the end time cannot be placed");
    } catch (err: any) {
        return result\caught::<int>(err, doing: "mandate: run date");
    }
}

fun mandateFile(root: str) > result\Result::<str> {
    try {
        if (mandate\mandateFile(root) -> file) {
            return result\ok::<str>(file);
        }
    } catch (err: any) {
        return result\caught::<str>(err, doing: "mandate: find the repository directory of {root}");
    }
    return result\fail::<str>("mandate: {root} is not a git checkout, so there is no repository directory to keep the mandate in");
}

fun append(root: str, m: mandate\Mandate) > result\Result::<bool> {
    final file = mandateFile(root);
    if (file.error != null) {
        return result\Result::<bool>{ error = file.error };
    }
    try {
        fs\mkdirAll(fs\dirname(file.value!));
        fs\appendFile(file.value!, content: mandate\encodeMandate(m) + "\n");
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "mandate: write {file.value!}");
    }
    return result\ok::<bool>(true);
}

fun unknownRows(named: [str], jobs: [mandate\Row]) > [str] {
    return named.filter(fun (index: int, id: str) > bool {
        foreach (r in jobs) {
            if (r.id == id) {
                return false;
            }
        }
        return true;
    });
}

fun printTerms(named: [str], tolerance: str, budget: int) > void {
    std\print("rows: {named.join(", ")} and the children forked from them");
    std\print("tolerance: an unsettled job's work is integrated only at {tolerance} or below; above it, it is held for review");
    std\print("review budget: a settled job changing more than {budget} lines in scoped or full paths is held for review (--review-budget)");
    std\print("stop condition: the end time passes, every mandated row is paused or done, or one refusal repeats {mandate\loopLimit} stops running");
    std\print("reserved for you:");
    foreach (r in reserved) {
        std\print("  - {r}");
    }
}

// reviewBudget reads --review-budget: a positive line count no larger than
// the lines one review reads well.
fun reviewBudget(text: str) > result\Result::<int> {
    final budget = std\parseInt(text);
    if (budget == null or budget! < 1) {
        return result\fail::<int>("mandate issue: --review-budget takes a positive number of lines, and got {shown(text)}");
    }
    if (budget! > branchstack\reviewBudget) {
        return result\fail::<int>("mandate issue: --review-budget {budget!} is above the {branchstack\reviewBudget} lines one review reads well (hack/magusfile/branch-stack.buzz)");
    }
    return result\ok::<int>(budget!);
}

fun toleranceFrom(value: str) > result\Result::<str> {
    if (mandate\tiers.indexOf(value) == null) {
        return result\fail::<str>("mandate issue: --tolerance takes one of {mandate\tiers.join(", ")}, and got {shown(value)}");
    }
    if (mandate\rank(value) > mandate\rank(mandate\ceiling)) {
        return result\fail::<str>("mandate issue: --tolerance {value} is above this repository's ceiling, {mandate\ceiling} (hack/policy/mandate.buzz)");
    }
    return result\ok::<str>(value);
}

fun issue(root: str, args: [str]) > result\Result::<bool> {
    try {
        final parsed = flags\parse(args, switches: [<str>], valued: ["--until", "--tolerance", "--rows", "--tokens", "--review-budget"]);
        if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
            return result\fail::<bool>("mandate issue: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}");
        }
        if (parsed.values["--tokens"] != null) {
            return result\fail::<bool>("mandate issue: --tokens is refused: magus counts no session tokens, so no budget could be obeyed; the end time is the cap");
        }
        final clock = parsed.values["--until"] ?? "";
        final minutes = parseClock(clock);
        if (minutes == null) {
            return result\fail::<bool>("mandate issue: --until takes the local end time as HH:MM, and got {shown(clock)}\n{USAGE}");
        }
        final checked = toleranceFrom(parsed.values["--tolerance"] ?? "");
        if (checked.error != null) {
            return result\Result::<bool>{ error = checked.error };
        }
        final tolerance = checked.value!;
        final budget = reviewBudget(parsed.values["--review-budget"] ?? "{branchstack\reviewBudget}");
        if (budget.error != null) {
            return result\Result::<bool>{ error = budget.error };
        }
        final named = (parsed.values["--rows"] ?? "").split(",").filter(fun (index: int, id: str) > bool => id.trim() != "");
        if (named.len() == 0) {
            return result\fail::<bool>("mandate issue: --rows names the plan's job rows, comma-separated; a mandate with none has nothing to carry out");
        }
        final jobs = mandate\rows(magus\workspace().jobs().jobs);
        final missing = unknownRows(named, jobs: jobs);
        if (missing.len() > 0) {
            return result\fail::<bool>("mandate issue: the job store holds no row {missing.join(", ")}; `job apply` the plan before the mandate is issued");
        }
        final now = mandate\now();
        if (mandate\inForce(mandate\loadMandate(root), now: now)) {
            return result\fail::<bool>("mandate issue: a mandate is already in force; `magus buzz hack/dev/issue-mandate.buzz -- revoke` ends it first");
        }
        final offset = localOffset();
        if (offset.error != null) {
            return result\Result::<bool>{ error = offset.error };
        }
        final ends = nextAt(minutes!, now: now, offset: offset.value!);
        final appended = append(root, m: mandate\Mandate{ action = "issue", at = now, endClock = clock, ends = ends, tolerance = tolerance, rows = named, budget = budget.value! });
        if (appended.error != null) {
            return appended;
        }
        std\print("mandate in force until {clock} local ({(ends - now) / 60000} minutes from now)");
        printTerms(named, tolerance: tolerance, budget: budget.value!);
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "mandate issue");
    }
}

fun revoke(root: str) > result\Result::<bool> {
    try {
        final now = mandate\now();
        if (!mandate\inForce(mandate\loadMandate(root), now: now)) {
            std\print("no mandate is in force; nothing to revoke");
            return result\ok::<bool>(true);
        }
        final appended = append(root, m: mandate\Mandate{ action = "revoke", at = now });
        if (appended.error != null) {
            return appended;
        }
        std\print("mandate revoked");
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "mandate revoke");
    }
}

fun report(root: str) > result\Result::<bool> {
    var last: mandate\Mandate? = null;
    var issued: mandate\Mandate? = null;
    final file = mandateFile(root);
    if (file.error != null) {
        return result\Result::<bool>{ error = file.error };
    }
    foreach (line in (fs\readFile(file.value!) catch "").split("\n")) {
        if (mandate\parseMandate(line) -> m) {
            last = m;
            if (m.action == "issue") {
                issued = m;
            }
        }
    }
    if (issued == null) {
        std\print("no mandate was ever issued in this repository");
        return result\ok::<bool>(true);
    }
    final terms = issued!;
    try {
        final list = magus\workspace().jobs();
        final jobs = mandate\rows(list.jobs);
        final now = mandate\now();
        if (last!.action == "revoke") {
            std\print("the last mandate, until {terms.endClock} with tolerance {terms.tolerance}, was revoked");
        } else {
            final state = if (mandate\inForce(terms, now: now)) "in force" else "past its end time";
            std\print("mandate until {terms.endClock}, {state}; tolerance {terms.tolerance}");
        }
        final blocked = mut [<str>];
        foreach (b in list.blocked) {
            blocked.append(b.job);
        }
        rowSections(jobs, terms: terms, blocked: blocked, now: now);
        final attention = mandate\attentionFile(root) ?? "";
        final filed = if (attention != "") (fs\readLines(attention) catch [<str>]) else [<str>];
        section("attention", rows: filed);
        section("left for you", rows: [
            "push each integrated branch: `git push origin <branch>`",
            "merge: `gh pr merge <n>` once its checks pass",
            "a grant a held row needs: `./magus job grant <job> <rule>`",
            "hook wiring: the root magusfile registers `magus\\guard.stop(agentpolicy\\judgeStop);`",
        ]);
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "mandate report");
    }
}

// rowSections prints the mandated rows held for review first, then integrated, then left.
fun rowSections(jobs: [mandate\Row], terms: mandate\Mandate, blocked: [str], now: int) > void {
    final integrated = mut [<str>];
    final held = mut [<str>];
    final left = mut [<str>];
    foreach (r in jobs) {
        if (!mandate\mandated(r.id, m: terms, jobs: jobs)) {
            continue;
        }
        if (mandate\settled(r)) {
            integrated.append(r.id);
        } else if (r.state == magus\JobState.pass or r.state == magus\JobState.exited or r.state == magus\JobState.fail) {
            final got = mandate\assess(r.id, jobs: jobs, measure: mandate\measured, count: mandate\counted);
            held.append("{r.id}: {r.state.value}, tier {got.tier}; {got.evidence.join("; ")}");
        } else if (r.paused) {
            left.append("{r.id}: paused");
        } else if (blocked.indexOf(r.id) != null) {
            left.append("{r.id}: blocked");
        } else if (now >= terms.ends) {
            left.append("{r.id}: {r.state.value}, past the cap");
        } else {
            left.append("{r.id}: {r.state.value}");
        }
    }
    section("held for review, for you to read first", rows: held);
    section("integrated", rows: integrated);
    section("left", rows: left);
}

fun shown(value: str) > str {
    return if (value == "") "nothing" else value;
}

fun section(title: str, rows: [str]) > void {
    std\print("{title} ({rows.len()})");
    foreach (r in rows) {
        std\print("  {r}");
    }
}

export fun main(args: [str]) > void !> any {
    if (args.len() == 0) {
        throw "mandate: {USAGE}";
    }
    if (vcs\name() != "git") {
        throw "mandate: the mandate lives in the git common directory, and this checkout is {vcs\name()}";
    }
    final root = vcs\root();
    final rest = args.sub(1);
    var done = result\ok::<bool>(true);
    if (args[0] == "issue") {
        done = issue(root, args: rest);
    } else if (args[0] == "revoke") {
        done = revoke(root);
    } else if (args[0] == "report") {
        done = report(root);
    } else {
        throw "mandate: unknown subcommand {args[0]}\n{USAGE}";
    }
    if (done.error != null) {
        throw done.error!.message;
    }
}

test "an end time is HH:MM on a 24-hour clock" {
    std\assert(parseClock("07:30") == 450, message: "07:30");
    std\assert(parseClock("7:30") == null, message: "one hour digit");
    std\assert(parseClock("24:00") == null, message: "hour 24");
    std\assert(parseClock("07:60") == null, message: "minute 60");
    std\assert(parseClock("") == null, message: "empty");
}

test "an offset reads date's +HHMM, west of UTC negative" {
    std\assert(parseOffset("+0100\n") == 3600000, message: "east");
    std\assert(parseOffset("-0430") == -16200000, message: "west");
    std\assert(parseOffset("UTC") == null, message: "not an offset");
}

test "the end is the next time the local clock reads HH:MM" {
    final hour = 3600000;
    // 2026-10-28T22:00Z, local UTC+1 reads 23:00.
    final now = 1793224800000;
    std\assert(nextAt(450, now: now, offset: hour) == now + 7 * hour + 30 * 60000 + hour, message: "07:30 local tomorrow");
    std\assert(nextAt(23 * 60 + 30, now: now, offset: hour) == now + 30 * 60000, message: "23:30 local tonight");
    std\assert(nextAt(23 * 60, now: now, offset: hour) == now + 24 * hour, message: "the minute now is tomorrow's");
}
