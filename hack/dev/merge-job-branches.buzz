namespace mergejobbranches;

import "flags";
import "fs";
import "io";
import "magus";
import "proc";
import "result";
import "serialize";
import "std";
import "vcs";
import "hack/magusfile/branch-stack" as stack;
import "hack/dev/bootstrap-checkout" as bootstrap;
import "hack/magusfile/recompose" as rc;
import "hack/magusfile/load-contract" as lc;

import "assert";

final USAGE = "usage: magus buzz hack/dev/merge-job-branches.buzz -- (--jobs <id,...> | --branches <name,...> | --stack <file|->) [--base <rev>] [--into <branch>] [-o json] [--apply] [--verify]";
final HELP = "cost: a temporary worktree and one merge per branch; --apply also regenerates once, --verify runs every merged job's checks, and so does --apply once a file settled by job claims\n{USAGE}";

final PRIMARY = "check";

// JobRow is what the merge reads of a job row.
export object JobRow {
    id: str,
    dependsOn: [str],
    checkoutRoot: str = "",
    check: str = "",
    goals: [stack\CheckGoal],
}

// Candidate is one branch to merge, with the job it carries out when there is one.
export object Candidate {
    branch: str,
    job: str = "",
    dependsOn: [str],
    check: str = "",
    goals: [stack\CheckGoal],
    paths: [str],
}

object Edge {
    before: str,
    why: str,
}

// Conflict is one source file a merge could not settle, with the commits on each side
// since the two diverged.
export object Conflict {
    path: str,
    ours: [str],
    theirs: [str],
}

fun findCycle(names: [str], after: {str: [Edge]}) > str {
    foreach (start in names) {
        final path = mut [start];
        var cur = start;
        var guard = 0;
        while (guard < names.len() + 1) {
            guard = guard + 1;
            var next = "";
            foreach (e in after[cur] ?? [<Edge>]) {
                if (names.indexOf(e.before) != null) { next = e.before; break; }
            }
            if (next == "") { break; }
            final at = path.indexOf(next);
            if (at != null) {
                final loop = mut [<str>];
                for (i: int = at!; i < path.len(); i = i + 1) { loop.append(path[i]); }
                loop.append(next);
                return loop.reverse().join(" -> ");
            }
            path.append(next);
            cur = next;
        }
    }
    return names.join(", ");
}

// order puts each candidate after the candidates whose job its job depends_on and after
// every candidate its branch contains (contains maps a branch to the others it is based
// on). Candidates ready at the same step keep their input order. The result is a chain on
// base, since an integration branch is one line of merges: each layer's parent is the
// layer merged before it, and its reason says what put it there. A cycle is an error
// naming it.
export fun order(cands: [Candidate], contains: {str: [str]}, base: str) > result\Result::<stack\BranchStack> {
    final byJob = mut {<str: str>};
    final names = mut [<str>];
    foreach (c in cands) {
        if (names.indexOf(c.branch) != null) { return result\fail::<stack\BranchStack>("merge-job-branches: {c.branch} is named twice"); }
        names.append(c.branch);
        if (c.job != "") { byJob[c.job] = c.branch; }
    }
    final after = mut {<str: [Edge]>};
    final notes = mut {<str: [str]>};
    foreach (c in cands) {
        final edges = mut [<Edge>];
        final own = mut [<str>];
        foreach (d in c.dependsOn) {
            final b = byJob[d];
            if (b == null) {
                own.append("depends_on {d}, which this merge leaves out");
            } else if (b! != c.branch) {
                edges.append(Edge{ before = b!, why = "after {b!}: its job depends_on {d}" });
            }
        }
        foreach (a in contains[c.branch] ?? [<str>]) {
            if (a != c.branch and names.indexOf(a) != null) {
                edges.append(Edge{ before = a, why = "after {a}: based on it" });
            }
        }
        after[c.branch] = edges;
        notes[c.branch] = own;
    }
    final placed = mut {<str: bool>};
    final layers = mut [<stack\StackLayer>];
    var parent = base;
    while (layers.len() < cands.len()) {
        var pick = -1;
        foreach (i, c in cands) {
            if (placed[c.branch] != null) { continue; }
            var ready = true;
            foreach (e in after[c.branch]!) {
                if (placed[e.before] == null) { ready = false; }
            }
            if (ready) { pick = i; break; }
        }
        if (pick < 0) {
            final left = mut [<str>];
            foreach (c in cands) {
                if (placed[c.branch] == null) { left.append(c.branch); }
            }
            return result\fail::<stack\BranchStack>("merge-job-branches: the branches order in a cycle: {findCycle(left, after: after)}");
        }
        final c = cands[pick];
        placed[c.branch] = true;
        final why = mut [<str>];
        foreach (e in after[c.branch]!) {
            if (why.indexOf(e.why) == null) { why.append(e.why); }
        }
        foreach (n in notes[c.branch]!) { why.append(n); }
        layers.append(stack\StackLayer{ branch = c.branch, parent = parent, job = c.job, paths = c.paths,
            declarations = [<str>], check = c.check, goals = c.goals, status = "planned", reason = why.join("; ") });
        parent = c.branch;
    }
    return result\ok::<stack\BranchStack>(stack\BranchStack{ base = base, layers = layers });
}

// stripType is a branch name without a conventional-commit type prefix (feat/x is x).
fun stripType(branch: str) > str {
    final slash = branch.indexOf("/");
    if (slash == null) { return branch; }
    final head = branch.sub(0, len: slash!);
    if (["build", "chore", "ci", "docs", "feat", "fix", "perf", "refactor", "revert", "test"].indexOf(head) == null) {
        return branch;
    }
    return branch.sub(slash! + 1);
}

fun rowNamed(rows: [JobRow], id: str) > JobRow? {
    foreach (r in rows) {
        if (r.id == id) { return r; }
    }
    return null;
}

// candidatesFromJobs is one candidate per job id, on the branch branchOf names for it. An
// id no row holds, and a job with no branch, is an error naming it.
export fun candidatesFromJobs(ids: [str], rows: [JobRow], branchOf: fun (row: JobRow) > result\Result::<str>) > result\Result::<[Candidate]> {
    final acc = mut [<Candidate>];
    foreach (id in ids) {
        final row = rowNamed(rows, id: id);
        if (row == null) { return result\fail::<[Candidate]>("merge-job-branches: no job {id} in the job store"); }
        final branch = branchOf(row!);
        if (branch.error -> err) { return result\Result::<[Candidate]>{ error = err }; }
        acc.append(Candidate{ branch = branch.value!, job = id, dependsOn = row!.dependsOn, check = row!.check,
            goals = row!.goals, paths = [<str>] });
    }
    return result\ok::<[Candidate]>(acc);
}

// jobForBranch is the row whose id is the branch, or the branch without its type prefix,
// or whose checkout has the branch checked out; null when none does.
export fun jobForBranch(branch: str, rows: [JobRow], checkedOut: fun (row: JobRow) > result\Result::<str>) > result\Result::<JobRow?> {
    foreach (id in [branch, stripType(branch)]) {
        final row = rowNamed(rows, id: id);
        if (row != null) { return result\ok::<JobRow?>(row); }
    }
    foreach (r in rows) {
        if (r.checkoutRoot == "") { continue; }
        final held = checkedOut(r);
        if (held.error -> err) { return result\Result::<JobRow?>{ error = err }; }
        if (held.value! == branch) { return result\ok::<JobRow?>(r); }
    }
    return result\ok::<JobRow?>(null);
}

export fun candidatesFromBranches(branches: [str], rows: [JobRow], checkedOut: fun (row: JobRow) > result\Result::<str>) > result\Result::<[Candidate]> {
    final acc = mut [<Candidate>];
    foreach (b in branches) {
        final found = jobForBranch(b, rows: rows, checkedOut: checkedOut);
        if (found.error -> err) { return result\Result::<[Candidate]>{ error = err }; }
        final row = found.value;
        if (row == null) {
            acc.append(Candidate{ branch = b, dependsOn = [<str>], goals = [<stack\CheckGoal>], paths = [<str>] });
        } else {
            acc.append(Candidate{ branch = b, job = row!.id, dependsOn = row!.dependsOn, check = row!.check,
                goals = row!.goals, paths = [<str>] });
        }
    }
    return result\ok::<[Candidate]>(acc);
}

// requireBranch accepts any ref that resolves to a commit, a remote-tracking one included,
// and returns the line naming what it resolved to.
fun requireBranch(root: str, branch: str) > result\Result::<str> {
    try {
        final found = vcs\cmd(["rev-parse", "--verify", "--quiet", "{branch}^\{commit\}"], opts: vcs\CommandOptions{ quiet = true, dir = root, allowFailure = true });
        if (found.code != 0) {
            return result\fail::<str>("merge-job-branches: unknown branch {branch}: it resolves to no commit");
        }
        return result\ok::<str>("{branch} resolves to {found.stdout.trim()}");
    } catch (err: any) {
        return result\caught::<str>(err, doing: "resolve {branch}");
    }
}

// containsMap is, for each branch, the others whose tip it contains and that are not
// already in base.
fun containsMap(root: str, branches: [str], base: str) > result\Result::<{str: [str]}> {
    final args = mut ["rev-parse"];
    foreach (b in branches) { args.append(b); }
    final parsed = rc\git(root, args: args);
    if (parsed.error -> err) { return result\Result::<{str: [str]}>{ error = err }; }
    final tips = rc\lines(parsed.value!);
    final ahead = mut {<str: [str]>};
    foreach (b in branches) {
        final listed = rc\git(root, args: ["rev-list", "{base}..{b}"]);
        if (listed.error -> err) { return result\Result::<{str: [str]}>{ error = err }; }
        ahead[b] = rc\lines(listed.value!);
    }
    final found = mut {<str: [str]>};
    foreach (i, b in branches) {
        final within = mut [<str>];
        foreach (j, a in branches) {
            if (i == j or tips[j] == tips[i] or ahead[a]!.len() == 0) { continue; }
            if (ahead[b]!.indexOf(tips[j]) != null) { within.append(a); }
        }
        found[b] = within;
    }
    return result\ok::<{str: [str]}>(found);
}

fun changedPaths(root: str, branch: str, base: str) > result\Result::<[str]> {
    final mb = rc\git(root, args: ["merge-base", base, branch]);
    if (mb.error -> err) { return result\Result::<[str]>{ error = err }; }
    final diffed = rc\git(root, args: ["diff", "--name-only", "{mb.value!}..{branch}"]);
    if (diffed.error -> err) { return result\Result::<[str]>{ error = err }; }
    return result\ok::<[str]>(rc\lines(diffed.value!));
}

fun checkCommand(c: LeaseCheck?) > str {
    if (c == null) { return ""; }
    var cmd = "magus run {c!.target} {c!.project}";
    if (c!.args.len() > 0) { cmd = cmd + " -- " + c!.args.join(" "); }
    return cmd;
}

// parseCheck reads a row check back from the command checkCommand renders.
export fun parseCheck(cmd: str) > result\Result::<stack\CheckGoal> {
    final words = mut [<str>];
    foreach (w in cmd.split(" ")) {
        if (w != "") { words.append(w); }
    }
    if (words.len() < 3 or words[0] != "magus" or words[1] != "run") {
        return result\fail::<stack\CheckGoal>("merge-job-branches: the check `{cmd}` is not a `magus run <target> [<project>]` command");
    }
    var project = ".";
    var at = 3;
    if (words.len() > 3 and words[3] != "--") { project = words[3]; at = 4; }
    final args = mut [<str>];
    if (at < words.len() and words[at] == "--") {
        for (i: int = at + 1; i < words.len(); i = i + 1) { args.append(words[i]); }
    }
    return result\ok::<stack\CheckGoal>(stack\CheckGoal{ id = PRIMARY, target = words[2], project = project, args = args });
}

fun storeRows() > result\Result::<[JobRow]> {
    try {
        final acc = mut [<JobRow>];
        foreach (j in magus\workspace().jobs().jobs) {
            final goals = mut [<stack\CheckGoal>];
            foreach (g in j.goals) {
                if (g.kind == magus\GoalKind.check) {
                    goals.append(stack\CheckGoal{ id = g.id, target = g.check.target, project = g.check.project, args = g.check.args });
                }
            }
            acc.append(JobRow{ id = j.id, dependsOn = j.dependsOn, checkoutRoot = j.checkoutRoot, check = checkCommand(j.check), goals = goals });
        }
        return result\ok::<[JobRow]>(acc);
    } catch (err: any) {
        return result\caught::<[JobRow]>(err, doing: "merge-job-branches: list the jobs");
    }
}

fun checkedOutIn(row: JobRow) > result\Result::<str> {
    try {
        if (row.checkoutRoot == "" or !fs\isDir(row.checkoutRoot)) { return result\ok::<str>(""); }
        final res = vcs\cmd(["branch", "--show-current"], opts: vcs\CommandOptions{ quiet = true, dir = row.checkoutRoot, allowFailure = true });
        if (res.code != 0) { return result\ok::<str>(""); }
        return result\ok::<str>(res.stdout.trim());
    } catch (err: any) {
        return result\caught::<str>(err, doing: "read the branch checked out in {row.checkoutRoot}");
    }
}

fun branchOfJob(root: str, row: JobRow) > result\Result::<str> {
    final here = checkedOutIn(row);
    if (here.error -> err) { return result\Result::<str>{ error = err }; }
    if (here.value! != "") { return here; }
    final named = rc\gitOK(root, args: ["show-ref", "--verify", "--quiet", "refs/heads/{row.id}"]);
    if (named.error -> err) { return result\Result::<str>{ error = err }; }
    if (named.value!) { return result\ok::<str>(row.id); }
    return result\fail::<str>("merge-job-branches: job {row.id} names no branch: its checkout {row.checkoutRoot} is gone or detached, and no branch is named {row.id}");
}

// shortlog is each commit in range touching path, as `<short> <subject>`.
fun shortlog(dir: str, range: str, path: str) > result\Result::<[str]> {
    final logged = rc\git(dir, args: ["log", "--no-merges", "--format=%h %s", range, "--", path]);
    if (logged.error -> err) { return result\Result::<[str]>{ error = err }; }
    return result\ok::<[str]>(rc\lines(logged.value!));
}

// conflicts reads the files a merge in progress in dir left unsettled, each with the
// commits on both sides since they diverged.
fun conflicts(dir: str) > result\Result::<[Conflict]> {
    final unmerged = rc\git(dir, args: ["diff", "--name-only", "--diff-filter=U"]);
    if (unmerged.error -> err) { return result\Result::<[Conflict]>{ error = err }; }
    final files = rc\lines(unmerged.value!);
    if (files.len() == 0) { return result\ok::<[Conflict]>([<Conflict>]); }
    final mb = rc\git(dir, args: ["merge-base", "HEAD", "MERGE_HEAD"]);
    if (mb.error -> err) { return result\Result::<[Conflict]>{ error = err }; }
    final acc = mut [<Conflict>];
    foreach (f in files) {
        final ours = shortlog(dir, range: "{mb.value!}..HEAD", path: f);
        if (ours.error -> err) { return result\Result::<[Conflict]>{ error = err }; }
        final theirs = shortlog(dir, range: "{mb.value!}..MERGE_HEAD", path: f);
        if (theirs.error -> err) { return result\Result::<[Conflict]>{ error = err }; }
        acc.append(Conflict{ path = f, ours = ours.value!, theirs = theirs.value! });
    }
    return result\ok::<[Conflict]>(acc);
}

// fromLayer annotates a commit on the integration side with the layer that brought it.
fun fromLayer(dir: str, commit: str, merged: [str]) > result\Result::<str> {
    final sha = commit.split(" ")[0];
    foreach (b in merged) {
        final inside = rc\gitOK(dir, args: ["merge-base", "--is-ancestor", sha, b]);
        if (inside.error -> err) { return result\Result::<str>{ error = err }; }
        if (inside.value!) { return result\ok::<str>("{commit} (from {b})"); }
    }
    return result\ok::<str>(commit);
}

export fun conflictReason(branch: str, into: str, found: [Conflict]) > str {
    final parts = mut ["a source conflict merging {branch} into {into}; resolve it by hand and run again"];
    foreach (c in found) {
        parts.append("{c.path}: {into} has {c.ours.join(", ")}; {branch} has {c.theirs.join(", ")}");
    }
    return parts.join("\n");
}

// CLAIMS_SETTLED starts the line `magus vcs resolve` prints for a file it settled because
// two jobs that both passed wrote it through disjoint claims.
final CLAIMS_SETTLED = "vcs resolve: settled ";

// settleWithMagus merges branch into dir with `magus vcs resolve`, returning the files it
// settled by job claims as resolve names them.
fun settleWithMagus(dir: str, branch: str) > result\Result::<[str]> {
    // vcs resolve raises when a conflict it does not settle is left; what is left is read
    // from the tree either way, and the layer stops there, so its settles do not matter.
    var said = "";
    try {
        said = magus\cmd("vcs", args: ["resolve", "--against", branch], opts: magus\CommandOptions{ dir = dir, root = dir, quiet = true }).stdout;
    } catch (err: any) {
        final merging = rc\gitOK(dir, args: ["rev-parse", "-q", "--verify", "MERGE_HEAD"]);
        if (merging.error -> failed) { return result\Result::<[str]>{ error = failed }; }
        if (!merging.value!) {
            final tree = rc\git(dir, args: ["status", "--porcelain"]);
            if (tree.error -> failed) { return result\Result::<[str]>{ error = failed }; }
            return result\fail::<[str]>("merge-job-branches: merging {branch} did not start: {result\caught::<[str]>(err).error!.message}; the tree holds {rc\lines(tree.value!).join(", ")}");
        }
    }
    final settled = mut [<str>];
    foreach (l in rc\lines(said)) {
        if (l.startsWith(CLAIMS_SETTLED)) { settled.append(l); }
    }
    return result\ok::<[str]>(settled);
}

// settledByClaims reports whether a layer of s merged with a file settled by job claims,
// which no merged branch's own check ran against.
export fun settledByClaims(s: stack\BranchStack) > bool {
    foreach (l in s.layers) {
        if (l.status == "merged" and l.reason.indexOf(CLAIMS_SETTLED) != null) { return true; }
    }
    return false;
}

// KEPT starts the error of a run that left its tree in place for inspection; withTree
// removes every other failing tree.
final KEPT = "merge-job-branches: kept the merged tree ";

// causeLine is the one line of text that says why a command failed: the first line naming
// an error code or the word error or fail, else the first line that is not a JSON dump.
export fun causeLine(text: str) > str {
    var first = "";
    foreach (l in rc\lines(text)) {
        if (l.startsWith("\{") or l.startsWith("[\{") or l.startsWith("}")) { continue; }
        if (first == "") { first = l; }
        final low = l.lower();
        if (l.indexOf("MGS") != null or l.indexOf("BZZ") != null or low.indexOf("error") != null or low.indexOf("fail") != null) {
            return clip(l);
        }
    }
    return clip(first);
}

fun clip(line: str) > str {
    if (line.len() <= 240) { return line; }
    return line.sub(0, len: 240) + "...";
}

// keptTree is the error that leaves the tree at dir for inspection: where it is, which
// target failed, where that target's full log is and the one line that says why.
export fun keptTree(dir: str, target: str, text: str) > str {
    var ref = refIn(text);
    if (ref == "") { ref = "none printed"; }
    return "{KEPT}{dir}\n  failed target: {target}\n  output ref: {ref} (magus query output {ref})\n  cause: {causeLine(text)}\n  remove it with: git worktree remove --force {dir}";
}

// readyFailure names the target a verifyReady error stopped at: its
// `verify-ready: <what>: exit
// N: ...` prefix, else the build that precedes the first of them.
export fun readyFailure(text: str) > str {
    final head = "verify-ready: ";
    if (text.startsWith(head)) {
        final stop = text.indexOf(": exit ");
        if (stop != null) { return text.sub(head.len(), len: stop! - head.len()); }
    }
    return "go-build (the ./magus bootstrap)";
}

// readyAt builds a ./magus at the tree's own HEAD, plus the graph and symbol digest it
// needs, with the steps every gate uses.
fun readyAt(dir: str) > result\Result::<[str]> {
    try {
        return result\ok::<[str]>(bootstrap\verifyReady(bootstrap\liveHost(), dir: dir));
    } catch (err: any) {
        return result\caught::<[str]>(err, doing: "merge-job-branches: ready {dir}");
    }
}

// regenerateWithMagus regenerates with the ./magus ready builds at the tree, since the
// caller's binary is not at the tree's revision. Any failure keeps the tree.
fun regenerateWithMagus(base: str, ready: fun (dir: str) > result\Result::<[str]>) > fun (dir: str) > result\Result::<bool> {
    return fun (dir: str) > result\Result::<bool> {
        final built = ready(dir);
        if (built.error -> err) {
            return result\fail::<bool>(keptTree(dir, target: readyFailure(err.message), text: err.message));
        }
        try {
            final ran = proc\exec(fs\join(dir, name: "magus"), args: ["affected", "generate:rw", "--vcs-base-ref", base], dir: dir,
                opts: proc\ExecOptions{ quiet = true, allowFailure = true });
            if (ran.code != 0) {
                return result\fail::<bool>(keptTree(dir, target: "affected generate:rw", text: "{ran.stderr}\n{ran.stdout}"));
            }
            final left = rc\unstaged(dir);
            if (left.error -> err) { return result\Result::<bool>{ error = err }; }
            final changed = left.value!;
            if (changed.len() == 0) { return result\ok::<bool>(true); }
            final undeclared = mut [<str>];
            foreach (f in magus\describe.file(changed, opts: magus\CommandOptions{ dir = dir, root = dir }).files) {
                if (f.role != "output" and f.role != "maintained") { undeclared.append(f.path); }
            }
            if (undeclared.len() > 0) {
                return result\fail::<bool>("merge-job-branches: regenerating changed {undeclared.join(", ")}, which no target declares as its output");
            }
            final add = mut ["add", "--"];
            foreach (p in changed) { add.append(p); }
            final staged = rc\git(dir, args: add);
            if (staged.error -> err) { return result\Result::<bool>{ error = err }; }
            return result\ok::<bool>(true);
        } catch (err: any) {
            return result\caught::<bool>(err, doing: "merge-job-branches: regenerate in {dir}");
        }
    };
}

// requirePolicyLoads asks the ./magus built at dir to judge a write there and fails, keeping
// the tree, when the guard policy does not load: landing it would leave every write waiting.
fun requirePolicyLoads(dir: str) > result\Result::<bool> {
    try {
        final judged = proc\exec(fs\join(dir, name: "magus"), args: ["shell", "-o", "json", "touch .merge-job-branches-probe"], dir: dir,
            opts: proc\ExecOptions{ quiet = true, allowFailure = true });
        final read = lc\policyFailure(judged.stdout);
        var why = "it printed no verdict: {judged.stderr}";
        if (read.error == null) { why = read.value!; }
        if (why != "") {
            return result\fail::<bool>(keptTree(dir, target: "the guard policy under the merged ./magus", text: why));
        }
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "merge-job-branches: judge a write under the merged ./magus");
    }
}

fun conflictsByLayer(dir: str, found: [Conflict], merged: [str]) > result\Result::<[Conflict]> {
    final annotated = mut [<Conflict>];
    foreach (c in found) {
        final ours = mut [<str>];
        foreach (o in c.ours) {
            final brought = fromLayer(dir, commit: o, merged: merged);
            if (brought.error -> err) { return result\Result::<[Conflict]>{ error = err }; }
            ours.append(brought.value!);
        }
        annotated.append(Conflict{ path = c.path, ours = ours, theirs = c.theirs });
    }
    return result\ok::<[Conflict]>(annotated);
}

fun sealMerge(dir: str, settled: [str]) > result\Result::<str> {
    final merging = rc\gitOK(dir, args: ["rev-parse", "-q", "--verify", "MERGE_HEAD"]);
    if (merging.error -> err) { return result\Result::<str>{ error = err }; }
    if (merging.value!) {
        final committed = rc\git(dir, args: ["commit", "--no-edit", "--no-verify"]);
        if (committed.error -> err) { return result\Result::<str>{ error = err }; }
    }
    final head = rc\git(dir, args: ["rev-parse", "--short", "HEAD"]);
    if (head.error -> err) { return result\Result::<str>{ error = err }; }
    final said = mut ["merged as {head.value!}"];
    foreach (line in settled) { said.append(line); }
    return result\ok::<str>(said.join("\n"));
}

// mergeLayers merges each layer of s, in order, into the detached tree at dir. It stops at
// the first source conflict, aborting that merge so the tree holds only the layers before
// it; the conflicting layer says why and every later one stays planned. It returns the
// layers with their statuses. settle merges a branch into dir and settles what it can,
// leaving the merge in progress with only the conflicts nothing could settle, and returns
// the files it settled by job claims, which the merged layer's reason lists.
export fun mergeLayers(dir: str, s: stack\BranchStack, into: str, settle: fun (dir: str, branch: str) > result\Result::<[str]>) > result\Result::<stack\BranchStack> {
    final acc = mut [<stack\StackLayer>];
    final merged = mut [<str>];
    var stopped = "";
    foreach (l in s.layers) {
        var status = "merged";
        var reason = l.reason;
        if (stopped != "") {
            status = "planned";
            reason = "not merged: {stopped} stopped the merge";
        } else {
            final inTree = rc\gitOK(dir, args: ["merge-base", "--is-ancestor", l.branch, "HEAD"]);
            if (inTree.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
            if (inTree.value!) {
                reason = "already in the tree";
            } else {
                final settledRun = settle(dir, branch: l.branch);
                if (settledRun.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
                final settled = settledRun.value!;
                final foundRun = conflicts(dir);
                if (foundRun.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
                final found = foundRun.value!;
                if (found.len() > 0) {
                    final annotated = conflictsByLayer(dir, found: found, merged: merged);
                    if (annotated.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
                    final aborted = rc\git(dir, args: ["merge", "--abort"]);
                    if (aborted.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
                    status = "conflict";
                    reason = conflictReason(l.branch, into: into, found: annotated.value!);
                    stopped = l.branch;
                } else {
                    final sealed = sealMerge(dir, settled: settled);
                    if (sealed.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
                    merged.append(l.branch);
                    reason = sealed.value!;
                }
            }
        }
        acc.append(stack\StackLayer{ branch = l.branch, parent = l.parent, job = l.job, paths = l.paths,
            declarations = l.declarations, check = l.check, goals = l.goals, status = status, reason = reason });
    }
    return result\ok::<stack\BranchStack>(stack\BranchStack{ schema = s.schema, base = s.base, layers = acc });
}

fun allMerged(s: stack\BranchStack) > bool {
    foreach (l in s.layers) {
        if (l.status != "merged") { return false; }
    }
    return true;
}

// commitRegenerated regenerates the tree at dir once and commits the change, if any, on
// its own, so the merges and the regeneration review apart. regenerate rewrites and
// stages the output. It returns the commit, or "" when nothing changed.
export fun commitRegenerated(dir: str, s: stack\BranchStack, regenerate: fun (dir: str) > result\Result::<bool>) > result\Result::<str> {
    final regenerated = regenerate(dir);
    if (regenerated.error -> err) { return result\Result::<str>{ error = err }; }
    final unstagedRun = rc\unstaged(dir);
    if (unstagedRun.error -> err) { return result\Result::<str>{ error = err }; }
    final left = unstagedRun.value!;
    if (left.len() > 0) {
        return result\fail::<str>("merge-job-branches: regenerating left {left.join(", ")} unstaged");
    }
    final clean = rc\gitOK(dir, args: ["diff", "--cached", "--quiet"]);
    if (clean.error -> err) { return result\Result::<str>{ error = err }; }
    if (clean.value!) { return result\ok::<str>(""); }
    final committed = rc\git(dir, args: ["commit", "--no-verify", "-m", "regenerate after merging {s.layers.len()} branches"]);
    if (committed.error -> err) { return result\Result::<str>{ error = err }; }
    return rc\git(dir, args: ["rev-parse", "HEAD"]);
}

// dropTree removes dir, which may not exist.
fun dropTree(dir: str) > result\Result::<bool> {
    try {
        fs\removeAll(dir);
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "merge-job-branches: remove {dir}");
    }
}

// removeWorktree is the live host's cleanup, which integration rows may run.
fun removeWorktree(root: str, dir: str) > result\Result::<bool> {
    final removed = rc\git(root, args: ["worktree", "remove", "--force", dir]);
    if (removed.error -> err) { return result\Result::<bool>{ error = err }; }
    return dropTree(dir);
}

// withTree runs body in a detached worktree of root at rev made at dir, and removes the
// worktree however body ends. dir comes from the caller because the scratch checkout dir
// lives under XDG_CACHE_HOME, which a CI gate puts inside its own checkout, where the
// buzz-test sandbox denies writes.
fun withTree(root: str, rev: str, dir: str, remove: fun (root: str, dir: str) > result\Result::<bool>, body: fun (dir: str) > result\Result::<bool>) > result\Result::<bool> {
    final added = rc\git(root, args: ["worktree", "add", "--detach", "--quiet", dir, rev]);
    if (added.error -> err) {
        _ = dropTree(dir);
        return result\Result::<bool>{ error = err };
    }
    var outcome = requireTrusted(dir, checkouts: fs\dirname(fs\dirname(dir)));
    if (outcome.error == null) { outcome = body(dir); }
    if (outcome.error -> err) {
        if (err.message.startsWith(KEPT)) { return result\Result::<bool>{ error = err }; }
        final removed = remove(root, dir: dir);
        if (removed.error -> failed) {
            return result\fail::<bool>("{err.message}\n  the tree {dir} was not removed: {failed.message}");
        }
        return result\Result::<bool>{ error = err };
    }
    return remove(root, dir: dir);
}

// requireTrusted fails before a run in dir does: mise refuses an untrusted config, and
// magus reports that only as a version probe failing (MGS3035).
fun requireTrusted(dir: str, checkouts: str) > result\Result::<bool> {
    try {
        _ = proc\which("mise");
    } catch {
        return result\ok::<bool>(true);
    }
    try {
        final shown = proc\exec("mise", args: ["trust", "--show"], dir: dir, opts: proc\ExecOptions{ quiet = true, allowFailure = true });
        if ("{shown.stdout}{shown.stderr}".indexOf(": untrusted") != null) {
            return result\fail::<bool>("merge-job-branches: mise does not trust {dir}; run `mise settings add trusted_config_paths {checkouts}` once");
        }
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "merge-job-branches: ask mise about {dir}");
    }
}

fun refIn(text: str) > str {
    final words = text.replace("\n", with: " ").split(" ");
    for (i: int = 0; i + 1 < words.len(); i = i + 1) {
        if ((words[i] == "ref" or words[i] == "output:") ) {
            for (j: int = i + 1; j < words.len(); j = j + 1) {
                if (words[j] == "") { continue; }
                if (words[j].startsWith("out")) { return words[j]; }
                break;
            }
        }
    }
    return "";
}

// Verdict is one merged job's checks run in the merged tree.
export object Verdict {
    job: str,
    pass: bool,
    lines: [str],
}

// runCheck runs one check in dir, returning its output ref and whether it
// passed. The run waits for the build budget itself.
fun runCheck(dir: str, g: stack\CheckGoal) > result\Result::<[str]> {
    final args = mut [g.target, g.project, "--concurrency", "1"];
    if (g.args.len() > 0) {
        args.append("--");
        foreach (a in g.args) { args.append(a); }
    }
    try {
        final res = magus\run(args, opts: magus\CommandOptions{ dir = dir, root = dir, quiet = true });
        return result\ok::<[str]>(["pass", refIn(res.stdout + " " + res.stderr)]);
    } catch (err: any) {
        return result\ok::<[str]>(["fail", refIn(result\caught::<[str]>(err).error!.message)]);
    }
}

// verifyLayers runs each merged job's check and check goals in dir, serially, then records
// the grade with `magus job wait --integration`. A job passes only when every run and the
// recorded grade pass.
export fun verifyLayers(dir: str, s: stack\BranchStack) > result\Result::<[Verdict]> {
    final acc = mut [<Verdict>];
    foreach (l in s.layers) {
        if (l.job == "" or l.status != "merged") { continue; }
        final checks = mut [<stack\CheckGoal>];
        if (l.check != "") {
            final parsed = parseCheck(l.check);
            if (parsed.error -> err) { return result\Result::<[Verdict]>{ error = err }; }
            checks.append(parsed.value!);
        }
        foreach (g in l.goals) { checks.append(g); }
        if (checks.len() == 0) {
            acc.append(Verdict{ job = l.job, pass = false, lines = ["declares no check and no check goal, so nothing here can grade it"] });
            continue;
        }
        var pass = true;
        final said = mut [<str>];
        var primary = "";
        final evidence = mut [<any>];
        foreach (g in checks) {
            final ran = runCheck(dir, g: g);
            if (ran.error -> err) { return result\Result::<[Verdict]>{ error = err }; }
            final r = ran.value!;
            pass = pass and r[0] == "pass";
            said.append("{r[0]} {g.id}: magus run {g.target} {g.project} {r[1]}");
            if (g.id == PRIMARY) { primary = r[1]; } else { evidence.append({"gate_id": g.id, "output_ref": r[1]}); }
        }
        try {
            final rep = serialize\jsonEncode(serialize\Boxed.init({"api_version": "magus.job-result/v1alpha1", "job": l.job, "changed_paths": [<str>],
                "validation": {"command": l.check, "output_ref": primary}, "verification_evidence": evidence, "unresolved_risks": [<str>]}));
            try {
                _ = magus\cmd("job", args: ["wait", l.job, "--integration", "--stdin"], opts: magus\CommandOptions{ dir = dir, root = dir, quiet = true, stdin = rep });
                said.append("recorded: job wait --integration passed");
            } catch (e: any) {
                pass = false;
                said.append("recorded: job wait --integration did not pass: {result\caught::<[Verdict]>(e).error!.message}");
            }
        } catch (err: any) {
            return result\caught::<[Verdict]>(err, doing: "merge-job-branches: encode the grade of {l.job}");
        }
        acc.append(Verdict{ job = l.job, pass = pass, lines = said });
    }
    return result\ok::<[Verdict]>(acc);
}

fun branches(n: int) > str {
    if (n == 1) { return "1 branch"; }
    return "{n} branches";
}

export fun render(s: stack\BranchStack) > str {
    final acc = mut ["{branches(s.layers.len())} onto {s.base}, in merge order:"];
    foreach (n, l in s.layers) {
        var job = "";
        if (l.job != "") { job = " (job {l.job})"; }
        acc.append("{n + 1}. {l.branch}{job}  [{l.status}]");
        foreach (r in l.reason.split("\n")) {
            if (r != "") { acc.append("     {r}"); }
        }
    }
    return acc.join("\n");
}

export fun pushHint(into: str) > [str] {
    return ["to publish: git push -u origin {into}",
        "the branch name must pass the branch-name rule: short and topical, no type prefix such as feat/, no hash"];
}

fun splitList(v: str?) > [str] {
    final acc = mut [<str>];
    foreach (p in (v ?? "").split(",")) {
        if (p.trim() != "") { acc.append(p.trim()); }
    }
    return acc;
}

fun readSource(path: str) > result\Result::<str> {
    try {
        if (path == "-") { return result\ok::<str>(io\stdin.readAll() ?? ""); }
        return result\ok::<str>(fs\readFile(path));
    } catch (err: any) {
        return result\caught::<str>(err, doing: "merge-job-branches: read {path}");
    }
}

fun plannedFromStack(root: str, values: {str: str}) > result\Result::<stack\BranchStack> {
    if (values["--base"] != null) { return result\fail::<stack\BranchStack>("merge-job-branches: a stack names its own base, so --base is not taken with --stack"); }
    final source = readSource(values["--stack"]!);
    if (source.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
    var s = stack\BranchStack{ base = "", layers = [<stack\StackLayer>] };
    try {
        s = stack\orderLayers(stack\readStack(source.value!));
    } catch (err: any) {
        return result\caught::<stack\BranchStack>(err, doing: "merge-job-branches: read the stack");
    }
    final storeRun = storeRows();
    if (storeRun.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
    final rows = storeRun.value!;
    final resolved = mut [<str>];
    final layers = mut [<stack\StackLayer>];
    foreach (l in s.layers) {
        final named = requireBranch(root, branch: l.branch);
        if (named.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
        resolved.append(named.value!);
        var check = l.check;
        var goals = l.goals;
        if (l.job != "" and check == "" and goals.len() == 0) {
            final row = rowNamed(rows, id: l.job);
            if (row != null) { check = row!.check; goals = row!.goals; }
        }
        layers.append(stack\StackLayer{ branch = l.branch, parent = l.parent, job = l.job, paths = l.paths,
            declarations = l.declarations, check = check, goals = goals, status = "planned", reason = l.reason });
    }
    nameResolved(resolved, values: values);
    return result\ok::<stack\BranchStack>(stack\BranchStack{ schema = s.schema, base = s.base, layers = layers });
}

// planned resolves the source the flags name into an ordered stack, every branch checked
// to exist.
fun planned(root: str, values: {str: str}) > result\Result::<stack\BranchStack> {
    final given = mut [<str>];
    foreach (k in ["--jobs", "--branches", "--stack"]) {
        if (values[k] != null) { given.append(k); }
    }
    if (given.len() != 1) {
        return result\fail::<stack\BranchStack>("merge-job-branches: name the branches one way, with --jobs, --branches or --stack\n{USAGE}");
    }
    if (values["--stack"] != null) {
        return plannedFromStack(root, values: values);
    }
    final resolved = mut [<str>];
    var base = "";
    try {
        base = values["--base"] ?? vcs\base();
    } catch (err: any) {
        return result\caught::<stack\BranchStack>(err, doing: "merge-job-branches: find the base");
    }
    final storeRun = storeRows();
    if (storeRun.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
    final rows = storeRun.value!;
    var candRun = result\ok::<[Candidate]>([<Candidate>]);
    if (values["--jobs"] != null) {
        candRun = candidatesFromJobs(splitList(values["--jobs"]), rows: rows, branchOf: fun (row: JobRow) > result\Result::<str> => branchOfJob(root, row: row));
    } else {
        candRun = candidatesFromBranches(splitList(values["--branches"]), rows: rows, checkedOut: checkedOutIn);
    }
    if (candRun.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
    final cands = candRun.value!;
    if (cands.len() == 0) { return result\fail::<stack\BranchStack>("merge-job-branches: no branches to merge\n{USAGE}"); }
    final names = mut [<str>];
    final withPaths = mut [<Candidate>];
    foreach (c in cands) {
        final named = requireBranch(root, branch: c.branch);
        if (named.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
        resolved.append(named.value!);
        names.append(c.branch);
        final changed = changedPaths(root, branch: c.branch, base: base);
        if (changed.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
        withPaths.append(Candidate{ branch = c.branch, job = c.job, dependsOn = c.dependsOn, check = c.check,
            goals = c.goals, paths = changed.value! });
    }
    nameResolved(resolved, values: values);
    final contains = containsMap(root, branches: names, base: base);
    if (contains.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
    return order(withPaths, contains: contains.value!, base: base);
}

// nameResolved prints what each ref resolved to, except under -o json, whose output is the stack.
fun nameResolved(resolved: [str], values: {str: str}) > void {
    if ((values["-o"] ?? "text") == "json") { return; }
    foreach (r in resolved) { std\print(r); }
}

fun requireNewBranch(root: str, into: str) > result\Result::<bool> {
    final formatted = rc\git(root, args: ["check-ref-format", "--branch", into]);
    if (formatted.error -> err) { return result\Result::<bool>{ error = err }; }
    final exists = rc\gitOK(root, args: ["show-ref", "--verify", "--quiet", "refs/heads/{into}"]);
    if (exists.error -> err) { return result\Result::<bool>{ error = err }; }
    if (exists.value!) {
        return result\fail::<bool>("merge-job-branches: branch {into} already exists; to merge more branches into it run merge-base-into-branches.buzz --branches {into}");
    }
    return result\ok::<bool>(true);
}

// sh is the output of a git command a test expects to succeed.
fun sh(dir: str, args: [str]) > str => rc\git(dir, args: args).value!;

test "requireBranch resolves a remote-tracking ref and refuses a name that is no commit" {
    final root = fs\tempDir("merge-job-branches-test-");
    _ = sh(root, args: ["init", "-q", "-b", "main"]);
    foreach (kv in [["user.email", "t@example.com"], ["user.name", "t"], ["commit.gpgsign", "false"], ["core.hooksPath", "/dev/null"]]) {
        _ = sh(root, args: ["config", kv[0], kv[1]]);
    }
    _ = put(root, path: "a.txt", content: "a\n");
    _ = commitAll(root, subject: "base");
    final tip = sh(root, args: ["rev-parse", "HEAD"]);
    _ = sh(root, args: ["update-ref", "refs/remotes/origin/main", tip]);
    assert\equal(requireBranch(root, branch: "origin/main").value!, want: "origin/main resolves to {tip}", message: "a remote-tracking ref resolves");
    assert\equal(requireBranch(root, branch: "main").value!, want: "main resolves to {tip}", message: "a local branch still resolves");
    final refused = requireBranch(root, branch: "nope").error!.message;
    assert\equal(refused.indexOf("unknown branch nope") != null, want: true, message: "a missing ref is refused: {refused}");
    final existing = requireNewBranch(root, into: "main").error!.message;
    assert\equal(existing.indexOf("merge-base-into-branches.buzz --branches main") != null, want: true, message: "an existing --into names the updater: {existing}");
    fs\removeAll(root);
}

fun printVerdicts(verdicts: [Verdict]) > bool {
    var all = true;
    foreach (v in verdicts) {
        var mark = "pass";
        if (!v.pass) { mark = "fail"; all = false; }
        std\print("{mark} {v.job}");
        foreach (l in v.lines) { std\print("     {l}"); }
    }
    return all;
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--apply", "--verify", "--help"],
        valued: ["--jobs", "--branches", "--stack", "--base", "--into", "-o"]);
    if (parsed.values["--help"] != null) { std\print(HELP); return; }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) { throw "merge-job-branches: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}"; }
    final format = parsed.values["-o"] ?? "text";
    if (format != "text" and format != "json") { throw "merge-job-branches: -o takes text or json\n{USAGE}"; }
    final apply = parsed.values["--apply"] != null;
    final verify = parsed.values["--verify"] != null;
    final into = parsed.values["--into"] ?? "";
    if ((apply or verify) and into == "") { throw "merge-job-branches: --apply and --verify name the integration branch with --into <branch>\n{USAGE}"; }
    final root = vcs\root();
    final planRun = planned(root, values: parsed.values);
    if (planRun.error -> err) { throw err.message; }
    final plan = planRun.value!;

    if (!apply and !verify) {
        if (format == "json") { std\print(stack\writeStack(plan)); return; }
        std\print("dry run: nothing changed; pass --apply --into <branch> to write");
        std\print(render(plan));
        return;
    }

    var merged = plan;
    var verdicts = [<Verdict>];
    var regenerated = "";
    var commits = [<str>];
    if (apply) {
        final fresh = requireNewBranch(root, into: into);
        if (fresh.error -> err) { throw err.message; }
        final applied = withTree(root, rev: plan.base, dir: fs\scratchCheckoutDir("merge-job-branches"), remove: removeWorktree, body: fun (dir: str) > result\Result::<bool> {
            final layered = mergeLayers(dir, s: plan, into: into, settle: settleWithMagus);
            if (layered.error -> err) { return result\Result::<bool>{ error = err }; }
            merged = layered.value!;
            if (!allMerged(merged)) { return result\ok::<bool>(true); }
            final committed = commitRegenerated(dir, s: merged, regenerate: regenerateWithMagus(plan.base, ready: readyAt));
            if (committed.error -> err) { return result\Result::<bool>{ error = err }; }
            regenerated = committed.value!;
            final landed = merged.layers.map(fun (index: int, l: stack\StackLayer) > str => l.branch);
            final recomposed = rc\recompose(dir, base: plan.base, into: into, branches: landed, describe: rc\describeAt);
            if (recomposed.error -> err) { return result\Result::<bool>{ error = err }; }
            commits = recomposed.value!;
            // About one merge in five changes the load contract; only those pay for the probe.
            final changed = rc\git(dir, args: ["diff", "--name-only", plan.base, "HEAD"]);
            if (changed.error -> err) { return result\Result::<bool>{ error = err }; }
            if (lc\contractPaths(rc\lines(changed.value!)).len() > 0) {
                final loads = requirePolicyLoads(dir);
                if (loads.error -> err) { return result\Result::<bool>{ error = err }; }
            }
            final tip = rc\git(dir, args: ["rev-parse", "HEAD"]);
            if (tip.error -> err) { return result\Result::<bool>{ error = err }; }
            final made = rc\git(root, args: ["branch", into, tip.value!]);
            if (made.error -> err) { return result\Result::<bool>{ error = err }; }
            // A file settled by job claims is a merge no job's check has seen, so every
            // merged job's checks run on it whether or not --verify asked.
            if (verify or settledByClaims(merged)) {
                final graded = verifyLayers(dir, s: merged);
                if (graded.error -> err) { return result\Result::<bool>{ error = err }; }
                verdicts = graded.value!;
            }
            return result\ok::<bool>(true);
        });
        if (applied.error -> err) { throw err.message; }
    } else {
        final named = requireBranch(root, branch: into);
        if (named.error -> err) { throw err.message; }
        final layers = mut [<stack\StackLayer>];
        foreach (l in plan.layers) {
            var status = "planned";
            var reason = "not in {into}";
            final inside = rc\gitOK(root, args: ["merge-base", "--is-ancestor", l.branch, into]);
            if (inside.error -> err) { throw err.message; }
            if (inside.value!) { status = "merged"; reason = "in {into}"; }
            layers.append(stack\StackLayer{ branch = l.branch, parent = l.parent, job = l.job, paths = l.paths,
                declarations = l.declarations, check = l.check, goals = l.goals, status = status, reason = reason });
        }
        merged = stack\BranchStack{ schema = plan.schema, base = plan.base, layers = layers };
        final checked = withTree(root, rev: into, dir: fs\scratchCheckoutDir("merge-job-branches"), remove: removeWorktree, body: fun (dir: str) > result\Result::<bool> {
            final graded = verifyLayers(dir, s: merged);
            if (graded.error -> err) { return result\Result::<bool>{ error = err }; }
            verdicts = graded.value!;
            return result\ok::<bool>(true);
        });
        if (checked.error -> err) { throw err.message; }
    }

    final isMerged = allMerged(merged);
    if (format == "json") {
        std\print(stack\writeStack(merged));
    } else {
        if (apply and isMerged) {
            std\print("merged {branches(merged.layers.len())} into {into}; nothing was pushed");
        } else if (apply) {
            std\print("stopped at a source conflict; nothing was written and {into} was not created");
        } else {
            std\print("verified {into} in a temporary worktree; nothing was written");
        }
        std\print(render(merged));
        if (regenerated != "") { std\print("regenerated the merged tree; its output joins the commits below"); }
        if (commits.len() > 0) {
            std\print("recomposed the unpushed commits above the base into:");
            foreach (c in commits) { std\print("  {c}"); }
        }
    }
    var passed = true;
    if (verdicts.len() > 0) {
        if (format == "text") { std\print(""); }
        passed = printVerdicts(verdicts);
    }
    if (apply and isMerged and format == "text") {
        std\print("");
        foreach (h in pushHint(into)) { std\print(h); }
    }
    if (!isMerged and apply) { throw "merge-job-branches: a source conflict stopped the merge"; }
    if (!passed) { throw "merge-job-branches: a merged job's checks did not pass, so the merge is not done"; }
}

fun fixtureRows() > result\Result::<[JobRow]> {
    try {
        final doc = serialize\jsonDecode(fs\readFile("hack/testdata/merge-job-branches-jobs.json"));
        final rows = mut [<JobRow>];
        foreach (j in doc.q("jobs").listValue()) {
            final deps = mut [<str>];
            foreach (d in j.q("depends_on").listValue()) { deps.append(d.stringValue()); }
            final goals = mut [<stack\CheckGoal>];
            foreach (g in j.q("goals").listValue()) {
                goals.append(stack\CheckGoal{ id = g.q("id").stringValue(), target = g.q("target").stringValue(),
                    project = g.q("project").stringValue() });
            }
            rows.append(JobRow{ id = j.q("id").stringValue(), dependsOn = deps, checkoutRoot = j.q("checkout_root").string() ?? "",
                check = j.q("check").stringValue(), goals = goals });
        }
        return result\ok::<[JobRow]>(rows);
    } catch (err: any) {
        return result\caught::<[JobRow]>(err, doing: "read the job fixture");
    }
}

fun featBranch(row: JobRow) > result\Result::<str> { return result\ok::<str>("feat/{row.id}"); }

fun joinBranches(s: stack\BranchStack) > str {
    final names = mut [<str>];
    foreach (l in s.layers) { names.append(l.branch); }
    return names.join(" ");
}

test "jobs merge after the jobs they depend_on, and a dependency left out is named" {
    final rows = fixtureRows().value!;
    final cands = candidatesFromJobs(["docs", "api", "core"], rows: rows, branchOf: featBranch).value!;
    final s = order(cands, contains: {<str: [str]>}, base: "main").value!;
    assert\equal(joinBranches(s), want: "feat/core feat/api feat/docs", message: "order");
    assert\equal(s.layers[0].parent, want: "main", message: "the first layer goes on the base");
    assert\equal(s.layers[2].parent, want: "feat/api", message: "each later layer goes on the one merged before it");
    assert\equal(s.layers[2].reason, want: "after feat/api: its job depends_on api; depends_on elsewhere, which this merge leaves out", message: "reason");
    assert\equal(s.layers[1].goals[0].id, want: "lint", message: "the row's check goals travel with the layer");
    assert\equal(stack\orderLayers(s).layers.len(), want: 3, message: "the plan is a stack the module orders");
}

test "a branch based on another merges after it, and ready branches keep their input order" {
    final cands = [
        Candidate{ branch = "dep", dependsOn = [<str>], goals = [<stack\CheckGoal>], paths = [<str>] },
        Candidate{ branch = "gen-b", dependsOn = [<str>], goals = [<stack\CheckGoal>], paths = [<str>] },
        Candidate{ branch = "gen-c", dependsOn = [<str>], goals = [<stack\CheckGoal>], paths = [<str>] },
    ];
    final s = order(cands, contains: {"dep": ["gen-b"]}, base: "main").value!;
    assert\equal(joinBranches(s), want: "gen-b dep gen-c", message: "order");
    assert\equal(s.layers[1].reason, want: "after gen-b: based on it", message: "reason");
}

test "a cycle, an unknown job and a branch named twice are errors naming them" {
    final rows = fixtureRows().value!;
    final looped = candidatesFromJobs(["loop-a", "loop-b"], rows: rows, branchOf: featBranch).value!;
    assert\equal(order(looped, contains: {<str: [str]>}, base: "main").error!.message,
        want: "merge-job-branches: the branches order in a cycle: feat/loop-a -> feat/loop-b -> feat/loop-a", message: "cycle");
    assert\equal(candidatesFromJobs(["nope"], rows: rows, branchOf: featBranch).error!.message,
        want: "merge-job-branches: no job nope in the job store", message: "unknown job");
    final twice = Candidate{ branch = "x", dependsOn = [<str>], goals = [<stack\CheckGoal>], paths = [<str>] };
    assert\equal(order([twice, twice], contains: {<str: [str]>}, base: "main").error!.message,
        want: "merge-job-branches: x is named twice", message: "twice");
}

test "a branch finds its job by id, by id without a type prefix, or by the checkout holding it" {
    final rows = fixtureRows().value!;
    fun held(row: JobRow) > result\Result::<str> {
        if (row.checkoutRoot == "/checkouts/held") { return result\ok::<str>("topic"); }
        return result\ok::<str>("");
    }
    final cands = candidatesFromBranches(["feat/api", "topic", "loose"], rows: rows, checkedOut: held).value!;
    assert\equal([cands[0].job, cands[1].job, cands[2].job], want: ["api", "held", ""], message: "jobs");
}

test "a row check reads back from the command the plan carries" {
    final g = parseCheck("magus run test api -- -run Api").value!;
    assert\equal([g.id, g.target, g.project], want: ["check", "test", "api"], message: "check");
    assert\equal(g.args, want: ["-run", "Api"], message: "args");
    assert\equal(parseCheck("magus run lint").value!.project, want: ".", message: "the project defaults to the root");
    assert\equal(parseCheck("go test ./...").error!.message,
        want: "merge-job-branches: the check `go test ./...` is not a `magus run <target> [<project>]` command", message: "not magus");
}

final FIXTURE_MAGUSFILE = `import "magus";
import "fs";
import "sort";

final SUMMARY = "merge job branches, settling generated conflicts";
final SERVES = ["replaces:git merge", "replaces:git cherry-pick"];

magus\project({});

export fun generate(ctx: magus\Context, args: [str]) > void !> any {
    ctx.readsFiles(["src/*.txt"]);
    ctx.writesFiles(["gen/list.txt"]);
    final names = mut [<str>];
    foreach (n in fs\listDir("src")) { names.append(n); }
    fs\mkdirAll("gen");
    fs\writeFile("gen/list.txt", content: sort\strings(names).join("\n") + "\n");
}
`;

fun put(root: str, path: str, content: str) > result\Result::<bool> {
    try {
        fs\mkdirAll(fs\dirname("{root}/{path}"));
        fs\writeFile("{root}/{path}", content: content);
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "write {path}");
    }
}

fun commitAll(root: str, subject: str) > result\Result::<bool> {
    final added = rc\git(root, args: ["add", "-A"]);
    if (added.error -> err) { return result\Result::<bool>{ error = err }; }
    final committed = rc\git(root, args: ["commit", "-q", "--no-verify", "-m", subject]);
    if (committed.error -> err) { return result\Result::<bool>{ error = err }; }
    return result\ok::<bool>(true);
}

fun branchFrom(root: str, name: str, start: str, files: {str: str}, subject: str) > result\Result::<bool> {
    final made = rc\git(root, args: ["checkout", "-q", "-b", name, start]);
    if (made.error -> err) { return result\Result::<bool>{ error = err }; }
    foreach (p, c in files) {
        final wrote = put(root, path: p, content: c);
        if (wrote.error -> err) { return result\Result::<bool>{ error = err }; }
    }
    return commitAll(root, subject: subject);
}

// fixtureRepo is a magus workspace whose one target lists src/ into gen/list.txt, with five
// branches: gen-b and gen-c each add a source and regenerate the list, so the list
// conflicts and the merge driver settles it; dep builds on gen-b and adds a source without
// regenerating; edit-a and clash both rewrite src/a.txt.
fun fixtureRepo() > result\Result::<str> {
    try {
        final root = fs\tempDir("merge-job-branches-test-");
        _ = sh(root, args: ["init", "-q", "-b", "main"]);
        foreach (kv in [["user.email", "t@example.com"], ["user.name", "t"], ["commit.gpgsign", "false"], ["core.hooksPath", "/dev/null"]]) {
            _ = sh(root, args: ["config", kv[0], kv[1]]);
        }
        // magus.yaml puts the store in the fixture, which the test removes.
        foreach (p, c in {".gitignore": ".magus/\n", "magusfile.buzz": FIXTURE_MAGUSFILE, "magus.yaml": "cache:\n  dir: \"{root}/.magus/cache\"\n", "src/a.txt": "a\n", "gen/list.txt": "a.txt\n"}) { _ = put(root, path: p, content: c); }
        // Loading the workspace writes the merge driver's .gitattributes, which the base has to
        // carry, or every merge would find the tree dirty.
        // The flag outranks MAGUS_CACHE_DIR, which CI sets, and the yaml above.
        _ = magus\cmd("ls", args: ["--cache-dir", "{root}/.magus/cache"], opts: magus\CommandOptions{ dir = root, root = root, quiet = true });
        _ = commitAll(root, subject: "base");
        _ = branchFrom(root, name: "gen-b", start: "main", files: {"src/b.txt": "b\n", "gen/list.txt": "a.txt\nb.txt\n"}, subject: "add b");
        _ = branchFrom(root, name: "gen-c", start: "main", files: {"src/c.txt": "c\n", "gen/list.txt": "a.txt\nc.txt\n"}, subject: "add c");
        _ = branchFrom(root, name: "dep", start: "gen-b", files: {"src/d.txt": "d\n"}, subject: "add d on b");
        _ = branchFrom(root, name: "edit-a", start: "main", files: {"src/a.txt": "a1\n"}, subject: "edit a one way");
        _ = branchFrom(root, name: "clash", start: "main", files: {"src/a.txt": "a2\n"}, subject: "edit a another way");
        _ = sh(root, args: ["checkout", "-q", "main"]);
        return result\ok::<str>(root);
    } catch (err: any) {
        return result\caught::<str>(err, doing: "build the fixture repository");
    }
}

// fixtureRegenerate is the fixture's generate target done in Buzz. Under `magus run test` a
// nested `magus affected` against the fixture is refused MGS3007, as though it re-entered
// the outer run's lock on its own project ".", so the tests drive the regeneration commit
// with this and leave regenerateWithMagus to a standalone `magus buzz -t` run.
fun fixtureRegenerate(dir: str) > result\Result::<bool> {
    try {
        final names = fs\listDir("{dir}/src").cloneMutable();
        _ = names.sort(fun (a: str, b: str) > bool => a < b);
        final wrote = put(dir, path: "gen/list.txt", content: names.join("\n") + "\n");
        if (wrote.error -> err) { return result\Result::<bool>{ error = err }; }
        final staged = rc\git(dir, args: ["add", "gen/list.txt"]);
        if (staged.error -> err) { return result\Result::<bool>{ error = err }; }
        return result\ok::<bool>(true);
    } catch (err: any) {
        return result\caught::<bool>(err, doing: "regenerate the fixture list");
    }
}

// testTree is a dir for withTree that the test owns, outside every checkout the
// buzz-test sandbox guards.
fun testTree() > result\Result::<str> {
    try {
        return result\ok::<str>(fs\tempDir("merge-job-branches-tree-"));
    } catch (err: any) {
        return result\caught::<str>(err, doing: "make a scratch tree");
    }
}

// dropTestTree removes the test's own scratch root with fs, never with git.
fun dropTestTree(root: str, dir: str) > result\Result::<bool> => dropTree(dir);

fun planStack(root: str, names: [str]) > result\Result::<stack\BranchStack> {
    final cands = mut [<Candidate>];
    foreach (n in names) {
        final paths = changedPaths(root, branch: n, base: "main");
        if (paths.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
        cands.append(Candidate{ branch = n, dependsOn = [<str>], goals = [<stack\CheckGoal>], paths = paths.value! });
    }
    final contains = containsMap(root, branches: names, base: "main");
    if (contains.error -> err) { return result\Result::<stack\BranchStack>{ error = err }; }
    return order(cands, contains: contains.value!, base: "main");
}

test "the fixture keeps its store inside itself, never in the user's cache" {
    final root = fixtureRepo().value!;
    final stores = if (fs\isDir("{root}/.magus/cache")) fs\listDir("{root}/.magus/cache") else [<str>];
    assert\equal(stores.len() > 0, want: true, message: "the setup run wrote its store under the fixture");
    fs\removeAll(root);
}

test "a merge orders by ancestry, lets the driver settle generated output, and stops whole at a source conflict" {
    final root = fixtureRepo().value!;
    final plan = planStack(root, names: ["dep", "gen-b", "gen-c", "edit-a", "clash"]).value!;
    assert\equal(joinBranches(plan), want: "gen-b dep gen-c edit-a clash", message: "dep goes after the branch it is based on");

    final mainBefore = sh(root, args: ["rev-parse", "main"]);
    var outcome = plan;
    final tree = testTree().value!;
    final ran = withTree(root, rev: "main", dir: tree, remove: dropTestTree, body: fun (dir: str) > result\Result::<bool> {
        final layered = mergeLayers(dir, s: plan, into: "integration", settle: settleWithMagus);
        if (layered.error -> err) { return result\Result::<bool>{ error = err }; }
        outcome = layered.value!;
        return result\ok::<bool>(true);
    });
    assert\isTrue(ran.error == null, message: "the tree runs");
    final statuses = mut [<str>];
    foreach (l in outcome.layers) { statuses.append("{l.branch}={l.status}"); }
    assert\equal(statuses.join(" "), want: "gen-b=merged dep=merged gen-c=merged edit-a=merged clash=conflict",
        message: "gen-c's list conflict is settled; clash's source conflict stops: {outcome.layers[2].reason}");
    final why = outcome.layers[4].reason;
    foreach (want in ["a source conflict merging clash into integration", "src/a.txt",
                      "edit a one way (from edit-a)", "edit a another way"]) {
        assert\equal(why.indexOf(want) != null, want: true, message: "the stop names {want}: {why}");
    }
    assert\equal(sh(root, args: ["rev-parse", "main"]), want: mainBefore, message: "the base is untouched");
    assert\equal(fs\isDir(tree), want: false, message: "the temporary tree is gone");
    assert\equal(rc\gitOK(root, args: ["show-ref", "--verify", "--quiet", "refs/heads/integration"]).value!, want: false, message: "no branch is written");
    fs\removeAll(root);
}

test "a clean merge regenerates once and commits the output apart" {
    final root = fixtureRepo().value!;
    final plan = planStack(root, names: ["gen-b", "gen-c", "dep", "edit-a"]).value!;
    var listed = "";
    var dirty = [<str>];
    var subjects = [<str>];
    var regenerated = "";
    final ran = withTree(root, rev: "main", dir: testTree().value!, remove: dropTestTree, body: fun (dir: str) > result\Result::<bool> {
        final merged = mergeLayers(dir, s: plan, into: "integration", settle: settleWithMagus);
        if (merged.error -> err) { return result\Result::<bool>{ error = err }; }
        if (!allMerged(merged.value!)) { return result\fail::<bool>("a layer did not merge"); }
        final committed = commitRegenerated(dir, s: merged.value!, regenerate: fixtureRegenerate);
        if (committed.error -> err) { return result\Result::<bool>{ error = err }; }
        regenerated = committed.value!;
        listed = fs\readFile("{dir}/gen/list.txt") catch "";
        dirty = rc\lines(sh(dir, args: ["status", "--porcelain"]));
        subjects = rc\lines(sh(dir, args: ["log", "--format=%s", "-2"]));
        return result\ok::<bool>(true);
    });
    assert\isTrue(ran.error == null, message: "every layer merges: {ran.error?.message ?? ""}");
    assert\equal(listed, want: "a.txt\nb.txt\nc.txt\nd.txt\n", message: "the list names every merged source");
    assert\equal(dirty, want: [<str>], message: "regeneration leaves nothing unstaged or uncommitted");
    assert\equal(regenerated != "", want: true, message: "dep merged a source without its output, so regeneration commits");
    assert\equal(subjects[0], want: "regenerate after merging 4 branches", message: "the regeneration is its own commit");
    assert\equal(subjects[1].startsWith("Merge branch 'edit-a'"), want: true, message: "below it, the last merge: {subjects[1]}");
    fs\removeAll(root);
}

// The round trip split-into-branches and this script make: a change cut into a stack and
// merged back is the change, byte for byte. The stack is written by hand here, as split
// would write it, and read back through the shared module.
test "a split stack merged back yields the original change's tree" {
    final root = fixtureRepo().value!;
    _ = branchFrom(root, name: "change", start: "main", files: {"src/x.txt": "x\n", "src/a.txt": "a3\n", "gen/list.txt": "a.txt\nx.txt\n"},
        subject: "the whole change");
    _ = branchFrom(root, name: "part-1", start: "main", files: {"src/x.txt": "x\n", "gen/list.txt": "a.txt\nx.txt\n"}, subject: "part 1");
    _ = branchFrom(root, name: "part-2", start: "part-1", files: {"src/a.txt": "a3\n"}, subject: "part 2");
    _ = sh(root, args: ["checkout", "-q", "main"]);
    final written = stack\writeStack(stack\BranchStack{ base = "main", layers = [
        stack\StackLayer{ branch = "part-2", parent = "part-1", paths = ["src/a.txt"], declarations = [<str>], goals = [<stack\CheckGoal>], status = "created" },
        stack\StackLayer{ branch = "part-1", parent = "main", paths = ["src/x.txt", "gen/list.txt"], declarations = [<str>], goals = [<stack\CheckGoal>], status = "created" },
    ] });
    final plan = stack\orderLayers(stack\readStack(written));
    var tree = "";
    final ran = withTree(root, rev: plan.base, dir: testTree().value!, remove: dropTestTree, body: fun (dir: str) > result\Result::<bool> {
        final merged = mergeLayers(dir, s: plan, into: "integration", settle: settleWithMagus);
        if (merged.error -> err) { return result\Result::<bool>{ error = err }; }
        if (!allMerged(merged.value!)) { return result\fail::<bool>("a layer did not merge"); }
        _ = commitRegenerated(dir, s: merged.value!, regenerate: fixtureRegenerate);
        tree = sh(dir, args: ["rev-parse", "HEAD^\{tree\}"]);
        return result\ok::<bool>(true);
    });
    assert\isTrue(ran.error == null, message: "every layer merges: {ran.error?.message ?? ""}");
    assert\equal(tree, want: sh(root, args: ["rev-parse", "change^\{tree\}"]), message: "the merged tree is the change's");
    fs\removeAll(root);
}

test "a layer settled by job claims says so, and only then does the merge owe a verify" {
    final root = fixtureRepo().value!;
    final plan = planStack(root, names: ["gen-b", "edit-a"]).value!;
    final line = "{CLAIMS_SETTLED}src/a.txt by job claims: src/a.txt#A (job a) against src/a.txt#B (job b); every job passed";
    var plain = plan;
    var claimed = plan;
    _ = withTree(root, rev: "main", dir: testTree().value!, remove: dropTestTree, body: fun (dir: str) > result\Result::<bool> {
        final merged = mergeLayers(dir, s: plan, into: "integration", settle: settleWithMagus);
        if (merged.error -> err) { return result\Result::<bool>{ error = err }; }
        plain = merged.value!;
        return result\ok::<bool>(true);
    });
    _ = withTree(root, rev: "main", dir: testTree().value!, remove: dropTestTree, body: fun (dir: str) > result\Result::<bool> {
        final merged = mergeLayers(dir, s: plan, into: "integration", settle: fun (d: str, branch: str) > result\Result::<[str]> {
            _ = settleWithMagus(d, branch: branch);
            if (branch == "edit-a") { return result\ok::<[str]>([line]); }
            return result\ok::<[str]>([<str>]);
        });
        if (merged.error -> err) { return result\Result::<bool>{ error = err }; }
        claimed = merged.value!;
        return result\ok::<bool>(true);
    });
    assert\equal(settledByClaims(plain), want: false, message: "no file settled by claims");
    assert\equal(settledByClaims(claimed), want: true, message: "edit-a settled one");
    assert\equal(claimed.layers[1].reason.split("\n")[1], want: line, message: "the layer lists the settle under its merge");
    fs\removeAll(root);
}

test "a failed readiness keeps the tree and names its path, target, ref and one cause line" {
    final root = fixtureRepo().value!;
    final dump = `{"findings": [{"rule": "x"}, {"rule": "y"}]}` + "\n";
    final kept = testTree().value!;
    final ran = withTree(root, rev: "main", dir: kept, remove: dropTestTree, body: fun (dir: str) > result\Result::<bool> {
        return regenerateWithMagus("main", ready: fun (d: str) > result\Result::<[str]> {
            return result\fail::<[str]>("verify-ready: magus run symbol-digest-generate .: exit 1: {dump}MGS8001 digest failed, output: out123abc\n{dump}");
        })(dir);
    });
    final said = ran.error!.message;
    assert\equal(fs\isDir(kept), want: true, message: "the tree stays");
    assert\equal(said.startsWith("{KEPT}{kept}\n"), want: true, message: "it names the path: {said}");
    assert\equal(said.indexOf("failed target: magus run symbol-digest-generate .\n") != null, want: true, message: "the target: {said}");
    assert\equal(said.indexOf("output ref: out123abc (") != null, want: true, message: "the ref: {said}");
    assert\equal(said.indexOf("cause: MGS8001 digest failed, output: out123abc\n") != null, want: true, message: "the cause: {said}");
    assert\equal(said.indexOf("findings") == null, want: true, message: "no JSON dump: {said}");
    fs\removeAll(kept);
    fs\removeAll(root);
}

test "any other failure still removes the tree" {
    final root = fixtureRepo().value!;
    final gone = testTree().value!;
    var ran = false;
    final outcome = withTree(root, rev: "main", dir: gone, remove: dropTestTree, body: fun (dir: str) > result\Result::<bool> {
        ran = true;
        return result\fail::<bool>("boom");
    });
    assert\equal(ran, want: true, message: "the body ran: {outcome.error?.message ?? ""}");
    assert\equal(outcome.error!.message, want: "boom", message: "the body's error comes through");
    assert\equal(fs\isDir(gone), want: false, message: "the tree is gone");
    fs\removeAll(root);
}

// mergedFixture merges the named fixture branches onto a detached main in
// root itself and regenerates. A worker's lease refuses `git worktree remove`.
fun mergedFixture(root: str, names: [str]) > result\Result::<str> {
    final planRun = planStack(root, names: names);
    if (planRun.error -> err) { return result\Result::<str>{ error = err }; }
    final detached = rc\git(root, args: ["checkout", "-q", "--detach", "main"]);
    if (detached.error -> err) { return result\Result::<str>{ error = err }; }
    final merged = mergeLayers(root, s: planRun.value!, into: "integration", settle: settleWithMagus);
    if (merged.error -> err) { return result\Result::<str>{ error = err }; }
    if (!allMerged(merged.value!)) { return result\fail::<str>("a layer did not merge: {render(merged.value!)}"); }
    final committed = commitRegenerated(root, s: merged.value!, regenerate: fixtureRegenerate);
    if (committed.error -> err) { return result\Result::<str>{ error = err }; }
    return result\ok::<str>(root);
}

final FOUR_JOBS = ["gen-b", "dep", "gen-c", "edit-a"];

test "recomposing makes one commit per merged job, in merge order, with no merge and the merged tree byte for byte" {
    final root = fixtureRepo().value!;
    final fixture = mergedFixture(root, names: FOUR_JOBS);
    assert\isTrue(fixture.error == null, message: "the fixture merges: {fixture.error?.message ?? ""}");
    final dir = fixture.value!;
    final before = sh(dir, args: ["rev-parse", "HEAD^\{tree\}"]);
    assert\equal(sh(dir, args: ["rev-list", "--merges", "--count", "main..HEAD"]) != "0", want: true, message: "the merge made merge commits");
    final made = rc\recompose(dir, base: "main", into: "integration", branches: FOUR_JOBS, describe: rc\describeAt);
    assert\isTrue(made.error == null, message: "it recomposes: {made.error?.message ?? ""}");
    assert\equal(sh(dir, args: ["rev-parse", "HEAD^\{tree\}"]), want: before, message: "the tree is unchanged");
    assert\equal(sh(dir, args: ["rev-list", "--count", "main..HEAD"]), want: "4", message: "one commit per job above the base");
    assert\equal(sh(dir, args: ["rev-list", "--merges", "--count", "main..HEAD"]), want: "0", message: "no merge is left");
    assert\equal(sh(dir, args: ["log", "--reverse", "--format=%s", "main..HEAD"]).split("\n"),
        want: ["add b", "add d on b", "add c", "edit a one way"], message: "subjects follow the merge order");
    assert\equal(sh(dir, args: ["rev-parse", "HEAD~4"]), want: sh(root, args: ["rev-parse", "main"]), message: "on the base");
    assert\equal(sh(dir, args: ["show", "--name-only", "--format=", "HEAD~3"]).split("\n").indexOf("gen/list.txt") != null, want: true,
        message: "the regenerated list travels with the first job that invalidated it");
    fs\removeAll(root);
}

test "a two-job landing becomes two commits with the same final tree" {
    final root = fixtureRepo().value!;
    final jobs = ["gen-b", "edit-a"];
    final fixture = mergedFixture(root, names: jobs);
    assert\isTrue(fixture.error == null, message: "the fixture merges: {fixture.error?.message ?? ""}");
    final dir = fixture.value!;
    final before = sh(dir, args: ["rev-parse", "HEAD^\{tree\}"]);
    final made = rc\recompose(dir, base: "main", into: "integration", branches: jobs, describe: rc\describeAt);
    assert\isTrue(made.error == null, message: "it recomposes: {made.error?.message ?? ""}");
    assert\equal(sh(dir, args: ["rev-parse", "HEAD^\{tree\}"]), want: before, message: "the tree is unchanged");
    assert\equal(sh(dir, args: ["rev-list", "--count", "main..HEAD"]), want: "2", message: "two commits above the base");
    assert\equal(sh(dir, args: ["log", "--reverse", "--format=%s", "main..HEAD"]).split("\n"),
        want: ["add b", "edit a one way"], message: "one subject per job");
    fs\removeAll(root);
}

test "recomposing keeps every commit a remote ref of the branch already holds" {
    final root = fixtureRepo().value!;
    final fixture = mergedFixture(root, names: FOUR_JOBS);
    assert\isTrue(fixture.error == null, message: "the fixture merges: {fixture.error?.message ?? ""}");
    final dir = fixture.value!;
    final pushed = sh(dir, args: ["rev-parse", "HEAD~1"]);
    _ = sh(root, args: ["update-ref", "refs/remotes/origin/integration", pushed]);
    assert\equal(rc\pushedFloor(dir, base: "main", into: "integration").value!, want: pushed, message: "the floor is the pushed commit");
    final made = rc\recompose(dir, base: "main", into: "integration", branches: FOUR_JOBS, describe: rc\describeAt);
    assert\isTrue(made.error == null, message: "it recomposes: {made.error?.message ?? ""}");
    assert\equal(sh(dir, args: ["rev-parse", "HEAD~1"]), want: pushed, message: "the pushed commit stays the parent");
    _ = sh(root, args: ["update-ref", "refs/remotes/origin/integration", sh(dir, args: ["rev-parse", "HEAD"])]);
    final tip = sh(dir, args: ["rev-parse", "HEAD"]);
    assert\equal(rc\recompose(dir, base: "main", into: "integration", branches: FOUR_JOBS, describe: rc\describeAt).value!, want: [<str>], message: "all pushed: nothing to do");
    assert\equal(sh(dir, args: ["rev-parse", "HEAD"]), want: tip, message: "the pushed tip is untouched");
    fs\removeAll(root);
}

test "the cause line skips JSON and takes the first error line, else the first plain line" {
    assert\equal(causeLine(`{"a": 1}` + "\nstep one\nMGS1 broke\nlater"), want: "MGS1 broke", message: "coded");
    assert\equal(causeLine(`[{"a": 1}]` + "\nplain words\nmore"), want: "plain words", message: "plain");
    assert\equal(readyFailure("go run: exit status 2"), want: "go-build (the ./magus bootstrap)", message: "build");
}

test "the push hint names the branch rule" {
    final hint = pushHint("merged-wave");
    assert\equal(hint[0], want: "to publish: git push -u origin merged-wave", message: "push");
    assert\equal(hint[1].indexOf("no type prefix") != null, want: true, message: "rule");
}
