namespace markfeedback;

import "flags";
import "fs";
import "magus";
import "std";
import "strings";
import "hack/dev/show-feedback" as show;

import "assert";

final USAGE = "usage: magus buzz hack/dev/mark-feedback.buzz -- --verdict should-deny|should-advise|wrong-deny|fine [--note <text>] [--session <id>] [--since <duration|RFC3339>] [--until <RFC3339>] [--apply] -- <label|id>...";
final HELP = "cost: reads the session's trails the way show-feedback does; with --apply, appends one line per row to this repository's feedback store\n{USAGE}\n"
    + "Prints the plan and writes nothing unless --apply. Pass the window show-feedback printed, so a label resolves to the row you read;\n"
    + "each mark is stored under the row's stable id, so it holds across pages, re-renders and later sessions.";

final VERDICTS = ["should-deny", "should-advise", "wrong-deny", "fine"];

// plan resolves each label (C3) or id (fb...) against the report's rows and builds the
// marks to store. A label names a position in this report only; the mark carries the
// row's id, so it outlives the position.
export fun plan(r: show\Report, refs: [str], verdict: str, note: str) > [FeedbackMark] !> any {
    if (VERDICTS.indexOf(verdict) == null) {
        throw "mark-feedback: --verdict is one of {VERDICTS.join(", ")}, not `{verdict}`\n{USAGE}";
    }
    if (refs.len() == 0) {
        throw "mark-feedback: name at least one row by its label (C3) or id\n{USAGE}";
    }
    final marks = mut [<FeedbackMark>];
    foreach (ref in refs) {
        var found: show\Row? = null;
        foreach (row in r.rows + r.once) {
            if ((row.label != "" and row.label == strings\upperFirst(ref)) or row.id == ref) {
                found = row;
            }
        }
        if (found == null) {
            final labels = mut [<str>];
            foreach (row in r.rows) {
                labels.append(row.label);
            }
            throw "mark-feedback: {ref} is not a row of session {r.session} in this window; its rows are {labels.join(" ")}";
        }
        final row = found!;
        marks.append(FeedbackMark{
            id = row.id, section = row.section, key = row.key, rule = row.rule, verdict = verdict, note = note,
            session = r.session, at = 0, examples = row.examples,
        });
    }
    return marks;
}

fun planLine(m: FeedbackMark, r: show\Report) > str {
    var label = "";
    foreach (row in r.rows) {
        if (row.id == m.id) {
            label = row.label;
        }
    }
    return "  {label}  {m.id}  {m.section}  {m.key}";
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--apply"], valued: ["--verdict", "--note", "--session", "--since", "--until"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0) {
        throw "mark-feedback: unknown {parsed.unknown.join(" ")}\n{USAGE}";
    }
    final verdict = parsed.values["--verdict"] ?? "";
    final r = show\report(parsed.values["--session"] ?? "", since: parsed.values["--since"] ?? "", through: parsed.values["--until"] ?? "");
    final marks = plan(r, refs: parsed.positionals, verdict: verdict, note: parsed.values["--note"] ?? "");
    final apply = parsed.values["--apply"] != null;
    if (!apply) {
        std\print("dry run: would mark {marks.len()} row(s) {verdict} in this repository's feedback store; rerun with --apply to write");
    } else {
        foreach (m in marks) {
            magus\trail.mark(m);
        }
        std\print("marked {marks.len()} row(s) {verdict} in this repository's feedback store");
    }
    foreach (m in marks) {
        std\print(planLine(m, r: r));
    }
    if (apply) {
        std\print("backlog: magus buzz hack/dev/count-feedback.buzz");
    }
}

fun fixture() > show\Report !> any {
    return show\fold(show\trailFromJSON(fs\readFile("hack/testdata/feedback-trail.json")), marks: [<FeedbackMark>]);
}

test "a label resolves to the row's stable id, not its position" {
    final marks = plan(fixture(), refs: ["C1", "a2"], verdict: "should-deny", note: "guard it");
    assert\equal(marks.len(), want: 2, message: "two marks");
    assert\equal(marks[0].id, want: show\rowID("unguarded", key: "grep -rn <arg>"), message: "C1 id");
    assert\equal(marks[0].key, want: "grep -rn <arg>", message: "C1 key");
    assert\equal(marks[1].id, want: show\rowID("refused", key: "output-pipe"), message: "lowercase label");
    assert\equal(marks[1].rule, want: "output-pipe", message: "rule");
    assert\equal(marks[0].session, want: "s-fixture", message: "session");
}

test "an id resolves like its label, including a shape that ran once and has no label" {
    final id = show\rowID("advised", key: "lease-state");
    assert\equal(plan(fixture(), refs: [id], verdict: "fine", note: "")[0].key, want: "lease-state", message: "by id");
    final once = show\rowID("unguarded", key: "make <arg>");
    assert\equal(plan(fixture(), refs: [once], verdict: "should-advise", note: "")[0].key, want: "make <arg>", message: "unlabelled");
}

test "an unknown label or verdict is refused, naming what exists" {
    var refused = "";
    try {
        plan(fixture(), refs: ["C9"], verdict: "fine", note: "");
    } catch (e: str) {
        refused = e;
    }
    assert\equal(refused, want: "mark-feedback: C9 is not a row of session s-fixture in this window; its rows are A1 A2 B1 C1 C2 D1", message: "label");
    refused = "";
    try {
        plan(fixture(), refs: ["C1"], verdict: "bad", note: "");
    } catch (e: str) {
        refused = e;
    }
    assert\equal(refused.startsWith("mark-feedback: --verdict is one of should-deny"), want: true, message: "verdict");
}
