// Tests that bootstrap-checkout names every step that runs past its bound, on a clock that
// moves tick milliseconds per read. It never refuses: the build path still finishes.
namespace bootstrapslowsteps;

import "assert";
import "./hack/dev/bootstrap-checkout" as checkout;

fun ticking(said: mut [str], tick: double) > checkout\Host {
    final now = mut [0.0];
    return checkout\Host{
        git = fun (dir: str, args: [str]) > checkout\Ran !> any => checkout\Ran{},
        magus = fun (dir: str, args: [str]) > checkout\Ran !> any => checkout\Ran{},
        build = fun (dir: str) > str !> any => "placed {dir}/magus",
        seed = fun (dir: str) > str !> any => "seeded {dir}",
        stampOf = fun (path: str) > str !> any => "",
        freshSkills = fun (dir: str) > str !> any => dir,
        removeDir = fun (path: str) > void !> any {},
        exec = fun (dir: str, argv: [str]) > checkout\Ran !> any => checkout\Ran{},
        readFile = fun (path: str) > str !> any => "",
        say = fun (line: str) > void {
            said.append(line);
        },
        clock = fun () > double {
            now[0] = now[0] + tick;
            return now[0];
        },
    };
}

fun names(said: [str]) > [str] {
    final slows = said.filter(fun (index: int, line: str) > bool => line.startsWith("slow: "));
    return slows.map(fun (index: int, line: str) > str => line.sub(6, len: line.indexOf(" took ")! - 6));
}

test "a build path whose every step runs past its bound names each one and still finishes" {
    final said = mut [<str>];
    final did = checkout\placeBinary(ticking(said, tick: 200000.0), dir: "/c", install: "docs");
    assert\equal(names(said), want: ["server stop", "go build", "harness install", "ls jobs", "symbol index seed", "dependency install", "proofread build"], message: "slow steps");
    assert\equal(did.len(), want: 6, message: "never refuses");
}

test "bootstrap-verification names its slow graph, digest, proofread, pool and skill steps" {
    final said = mut [<str>];
    _ = checkout\readyCheckout(ticking(said, tick: 500000.0), dir: "/c");
    assert\equal(names(said), want: ["server stop", "go build", "harness install", "ls jobs", "server stop --pools", "skill cleanup", "dependency install", "graph build", "symbol digest", "proofread build"], message: "slow steps");
}

test "steps within their bounds say nothing of being slow" {
    final said = mut [<str>];
    _ = checkout\readyCheckout(ticking(said, tick: 0.0), dir: "/c");
    assert\equal(names(said), want: [], message: "slow steps");
}
