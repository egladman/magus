// Warm-cache bounds of the bootstrap steps, and the line a step past one prints. A slow step is
// reported, never refused: slowness is not wrongness, and a refusal would strand the checkout.
namespace bootstraptiming;

import "std";
import "assert";

// Step is a timed bootstrap step: bound is seconds on a warm cache, cause what a slow run
// most likely waited on.
export object Step {
    name: str,
    bound: int,
    cause: str,
}

final RUN = "cache misses, a project lock another magus holds (exit 75) or a broker seat wait; magus server status names the holder";

export final BUILD = Step{ name = "go build", bound = 120, cause = "a cold go build cache, or another build holding the cache lock" };
export final STOP = Step{ name = "server stop", bound = 30, cause = "a daemon or broker seat holder that has not let go" };
export final STOP_POOLS = Step{ name = "server stop --pools", bound = 30, cause = STOP.cause };
export final STORE = Step{ name = "ls jobs", bound = 10, cause = "the job store sweep running landing probes" };
export final SKILLS = Step{ name = "skill cleanup", bound = 30, cause = "an agent install that has to regenerate every skill" };
export final SEED = Step{ name = "symbol index seed", bound = 30, cause = "a symbol index too large to copy from a warm checkout" };
export final INSTALL = Step{ name = "dependency install", bound = 60, cause = RUN };
export final HARNESS = Step{ name = "harness install", bound = 60, cause = RUN };
export final GRAPH = Step{ name = "graph build", bound = 60, cause = RUN };
export final DIGEST = Step{ name = "symbol digest", bound = 90, cause = RUN };
export final PROOFREAD = Step{ name = "proofread build", bound = 60, cause = RUN };

// slow is the one line a step past its bound prints, "" when it ran within it.
export fun slow(step: Step, ms: int) > str {
    if (ms <= step.bound * 1000) {
        return "";
    }
    return "slow: {step.name} took {ms / 1000}s against a {step.bound}s bound; likely {step.cause}";
}

// report says the slow line of a step that ran ms, when it has one.
export fun report(say: fun (line: str) > void, step: Step, ms: int) > void {
    final line = slow(step, ms: ms);
    if (line != "") {
        say(line);
    }
}

// watched times a step that says nothing of its own, and names it only when it ran past its bound.
export fun watched(say: fun (line: str) > void, clock: fun () > double, step: Step, run: fun () > void !> any) > void !> any {
    final began = clock();
    run();
    report(say, step: step, ms: std\toInt(clock() - began));
}

// timed says what a slow step will do before it runs, and its time after. Past its bound a
// second line names the step, the time against the bound and the likely cause.
export fun timed(say: fun (line: str) > void, clock: fun () > double, start: str, step: Step, run: fun () > str !> any) > str !> any {
    say(start);
    final began = clock();
    final line = run();
    final ms = std\toInt(clock() - began);
    final took = if (ms < 1000) "{ms}ms" else "{ms / 1000}s";
    say("{line} ({took})");
    report(say, step: step, ms: ms);
    return line;
}

test "a step within its bound says nothing of being slow, and one past it names the step, its time, the bound and the cause" {
    assert\equal(slow(GRAPH, ms: 60000), want: "", message: "at the bound");
    assert\equal(slow(GRAPH, ms: 412000), want: "slow: graph build took 412s against a 60s bound; likely {RUN}", message: "past it");
}

test "a slow step still returns its result, and a quiet one prints only its two lines" {
    final said = mut [<str>];
    final ticks = mut [0.0];
    final clock = fun () > double {
        ticks[0] = ticks[0] + 70000.0;
        return ticks[0];
    };
    final say = fun (line: str) > void {
        said.append(line);
    };
    final got = timed(say, clock: clock, start: "building the graph", step: GRAPH, run: fun () > str !> any => "built the graph");
    assert\equal(got, want: "built the graph", message: "result");
    assert\equal(said, want: ["building the graph", "built the graph (70s)", "slow: graph build took 70s against a 60s bound; likely {RUN}"], message: "said");
}
