// Cost: the whole `magus affected ci` gate, bounded by --timeout, plus a wait for a broker seat.
//
// Runs the gate once and says what failed. It first makes the checkout gate-ready
// (bootstrap-checkout.buzz --gate-ready), so a ./magus built at another commit never reaches the
// gate as MGS7003. It then waits up to --wait seconds for the broker to
// have --slots free, runs `magus affected ci` under `magus job exec --timeout`, and on failure
// prints each failed member's output ref and the first failing lines of its log, so the next
// step is a fix and not a rerun. A Go test member is read by ls-test-failures. The whole log is
// `magus query output <ref>`.
//
//	magus buzz hack/dev/run-gate.buzz -- [--timeout <duration>] [--slots <n>] [--wait <seconds>] [--lines <n>]
//
// The guard judges this script as the gate: only who may run `magus affected ci` may run it.
namespace rungate;

import "encoding/json";
import "flags";
import "magus";
import "os";
import "std";
import "vcs";
import "hack/dev/bootstrap-checkout" as bootstrap;
import "hack/dev/ls-test-failures" as lsfail;

import "assert";

final USAGE = "usage: magus buzz hack/dev/run-gate.buzz -- [--timeout <duration>] [--slots <n>] [--wait <seconds>] [--lines <n>]";
final HELP = "cost: the whole gate, bounded by --timeout, plus a wait for a broker seat\n{USAGE}";

final TIMED_OUT = 124;
final POLL_MS = 5000.0;
final SIGNAL = std\pattern(`(?i)\b(error|fail|failed|panic)\b`);

export object Member {
    project: str,
    target: str,
    ref: str,
}

// seatsFree is how many budget slots the broker has unheld, from `magus broker status -o json`.
// The status omits held_slots while nothing holds any, which is zero held.
export fun seatsFree(statusJSON: str) > int !> any {
    final capacity = json\parse(statusJSON)["capacity"];
    if (capacity == null) {
        throw "run-gate: broker status names no capacity";
    }
    final budget: int = std\toInt(capacity["budget_slots"] ?? 0);
    final held: int = std\toInt(capacity["held_slots"] ?? 0);
    return budget - held;
}

// failedMembers is the failed targets of the newest invocation in `magus session ls -o json`
// that has any.
export fun failedMembers(listingJSON: str) > [Member] !> any {
    foreach (inv in json\parse(listingJSON)["invocations"] ?? []) {
        final failed = mut [<Member>];
        foreach (t in inv["targets"] ?? []) {
            if (t["outcome"] == "fail") {
                failed.append(Member{ project = t["project"] ?? "", target = t["target"] ?? "", ref = t["ref"] ?? "" });
            }
        }
        if (failed.len() > 0) {
            return failed;
        }
    }
    return [];
}

// signalLines is the first limit lines of a log that name an error, failure or panic.
export fun signalLines(output: str, limit: int) > [str] {
    final found = mut [<str>];
    foreach (line in output.split("\n")) {
        if (found.len() < limit and SIGNAL.match(line) != null) {
            found.append(line.trim());
        }
    }
    return found;
}

fun waitForSeats(slots: int, seconds: int) > void !> any {
    final deadline = os\time() + std\toDouble(seconds) * 1000.0;
    while (true) {
        final free = seatsFree(magus\cmd("broker", args: ["status", "-o", "json"], opts: {"quiet": true}).stdout);
        if (free >= slots) {
            return;
        }
        if (os\time() + POLL_MS > deadline) {
            throw "run-gate: the broker has {free} slot(s) free and the gate needs {slots}; none freed within {seconds}s: `magus status` names the holders";
        }
        os\sleep(POLL_MS);
    }
}

fun report(member: Member, limit: int) > void !> any {
    std\print("{member.ref} {member.project}:{member.target}");
    if (member.target.startsWith("test")) {
        final run = lsfail\testFailures(member.ref);
        foreach (f in run.failures) {
            std\print("  {lsfail\render(f)}");
        }
        if (run.failures.len() > 0) {
            return;
        }
    }
    final rec: magus\OutputRecord = magus\output(member.ref);
    foreach (line in signalLines(rec.output, limit: limit)) {
        std\print("  {line}");
    }
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help"], valued: ["--timeout", "--slots", "--wait", "--lines"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "run-gate: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final timeout = parsed.values["--timeout"] ?? "90m";
    final slots = std\parseInt(parsed.values["--slots"] ?? "2");
    final wait = std\parseInt(parsed.values["--wait"] ?? "300");
    final limit = std\parseInt(parsed.values["--lines"] ?? "8");
    if (slots == null or wait == null or limit == null) {
        throw "run-gate: --slots, --wait and --lines take whole numbers\n{USAGE}";
    }
    foreach (line in bootstrap\gateReady(bootstrap\liveHost(), dir: vcs\root())) {
        std\print("gate-ready: {line}");
    }
    waitForSeats(slots!, seconds: wait!);
    final gate = magus\cmd("job", args: ["exec", "--timeout", timeout, "--slots", "{slots!}", "--", "./magus", "affected", "ci"], opts: {"allow_failure": true});
    if (gate.ok) {
        std\print("run-gate: affected ci passed");
        return;
    }
    if (gate.code == TIMED_OUT) {
        throw "run-gate: affected ci did not finish within {timeout}; the broker stopped it";
    }
    final listing = magus\cmd("session", args: ["ls", "-o", "json"], opts: {"quiet": true}).stdout;
    final members = failedMembers(listing);
    foreach (member in members) {
        report(member, limit: limit!);
    }
    throw "run-gate: affected ci failed (exit {gate.code}) with {members.len()} failed member(s)";
}

test "seats free are the budget less what is held, a missing held count being none" {
    assert\equal(seatsFree(`{"capacity": {"budget_mb": 100, "budget_slots": 10}}`), want: 10, message: "idle");
    assert\equal(seatsFree(`{"capacity": {"budget_slots": 10, "held_slots": 8}}`), want: 2, message: "busy");
    assert\equal(seatsFree(`{"pid": 1}`) catch -1, want: -1, message: "no capacity is an error");
}

test "the failed members come from the newest invocation that has any" {
    final got = failedMembers(`{"invocations": [
        {"targets": [{"project": ".", "target": "lint", "outcome": "pass", "ref": "a"}]},
        {"targets": [{"project": "libs/x", "target": "test", "outcome": "fail", "ref": "b"},
                     {"project": ".", "target": "build", "outcome": "pass", "ref": "c"}]},
        {"targets": [{"project": ".", "target": "old", "outcome": "fail", "ref": "d"}]}]}`);
    assert\equal(got.len(), want: 1, message: "one member");
    assert\equal("{got[0].project}:{got[0].target} {got[0].ref}", want: "libs/x:test b", message: "member");
}

test "the first signal lines of a log are kept, up to the limit" {
    final log = "ok  a\nlint: error: bad name\nnote\nFAIL b\npanic: boom\n";
    assert\equal(signalLines(log, limit: 2), want: ["lint: error: bad name", "FAIL b"], message: "limit");
    assert\equal(signalLines("all fine\n", limit: 5), want: [], message: "none");
}
