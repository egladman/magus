    "<%/followUps%>",
].join("\n");

export object Deny {
    path: str,
    reason: str,
}

fun quoted(word: str) > str {
    foreach (i in 0..word.len()) {
        if (WORD.indexOf(word.sub(i, len: 1)) == null) {
            return "'" + word.replace("'", with: "'\\''") + "'";
        }
    }
    return if (word == "") "''" else word;
}

// checkCommand renders a check's target, project and tool args as the command
// a worker types. With no target it falls back to the validation line.
export fun checkCommand(target: str, project: str, args: [str], validation: str) > str {
    if (target == "") {
        if (validation.startsWith("magus ")) {
            return "./{validation}";
        }
        return validation;
    }
    final words = mut ["./magus", "run", target, if (project == "") "." else project, "--budget-wait", "0"];
    if (args.len() > 0) {
        words.append("--");
        foreach (a in args) {
            words.append(quoted(a));
        }
    }
    return words.join(" ");
}

fun leaseCheckCommand(check: magus\LeaseCheck?, validation: str) > str {
    if (check -> c) {
        return checkCommand(c.target, project: c.project, args: c.args, validation: validation);
    }
    return checkCommand("", project: "", args: [<str>], validation: validation);
}

// denyLines groups deny paths by reason, in first-seen order. A
// file#declaration claim is spelled out as the declarations it covers, so a
// worker does not read one claimed function as the whole file.
export fun denyLines(deny: [Deny]) > [str] {
    final reasons = mut [<str>];
    final byReason = mut {<str: mut [str]>};
    final decls = mut {<str: mut {str: mut [str]}>};
    final files = mut {<str: mut [str]>};
    foreach (d in deny) {
        if (byReason[d.reason] == null) {
            reasons.append(d.reason);
            byReason[d.reason] = mut [<str>];
            decls[d.reason] = mut {<str: mut [str]>};
            files[d.reason] = mut [<str>];
        }
        final hash = d.path.indexOf("#");
        if (hash == null) {
            byReason[d.reason]!.append("`{d.path}`");
            continue;
        }
        final file = d.path.sub(0, len: hash!);
        final decl = d.path.sub(hash! + 1);
        if (decls[d.reason]![file] == null) {
            decls[d.reason]![file] = mut [<str>];
            files[d.reason]!.append(file);
        }
        decls[d.reason]![file]!.append(decl);
    }
    final lines = mut [<str>];
    foreach (r in reasons) {
        final parts = mut [<str>];
        foreach (p in byReason[r]!) {
            parts.append(p);
        }
        foreach (f in files[r]!) {
            final names = decls[r]![f]!;
            final noun = if (names.len() == 1) "declaration" else "declarations";
            parts.append("`{f}` (only the {noun} `{names.join("`, `")}`; the rest of the file is not claimed)");
        }
        lines.append("- {r}: {parts.join(", ")}");
    }
    return lines;
}

// dependencyLines says what each job row depends on asks of the worker.
fun dependencyLines(row: magus\Job, list: magus\JobList) > [str] {
    final states = mut {<str: str>};
    foreach (j in list.jobs) {
        states[j.id] = j.state.value;
    }
    final lines = mut [<str>];
    foreach (d in row.dependsOn) {
        final state = states[d] ?? "missing";
        if (state == "pass") {
            lines.append("- depends on `{d}`, which passed: build on its result (`./magus describe job {d}`)");
        } else {
            lines.append("- depends on `{d}`, which is {state}: `./magus job wait {d}` before touching what it changes");
        }
    }
    return lines;
}

// overlapLines is each overlap naming row, seen from row, by the other job.
fun overlapLines(row: magus\Job, list: magus\JobList) > [str] {
    final found = mut [<[str]>];
    foreach (o in list.overlaps) {
        var other = "";
        var mine = [<str>];
        var theirs = [<str>];
        if (o.jobA == row.id) {
            other = o.jobB;
            mine = o.pathsA;
            theirs = o.pathsB;
        } else if (o.jobB == row.id) {
            other = o.jobA;
            mine = o.pathsB;
            theirs = o.pathsA;
        } else {
            continue;
        }
        var now = "nobody measured what either wrote";
        if (o.footprint -> f) {
            if (f.verdict == "shared") {
                now = "both have already written {f.shared.join(", ")}";
            } else if (f.verdict != "") {
                now = "neither has written into the overlap yet";
            }
        }
        found.append([other, "- overlaps live job `{other}`: your `{mine.join("`, `")}` against its `{theirs.join("`, `")}`; {now}. "
            + "Write only your own paths there; if the criteria need one of its, stop and name the conflict in unresolved_risks rather than work around it"]);
    }
    final ordered = found.sort(fun (a: [str], b: [str]) > bool => a[0] < b[0]);
    final lines = mut [<str>];
    foreach (o in ordered) {
        lines.append(o[1]);
    }
    return lines;
}

fun lineMaps(lines: [str]) > [{str: any}] {
    final maps = mut [<{str: any}>];
    foreach (l in lines) {
        maps.append({"line": l});
    }
    return maps;
}

// specView renders row's spec for its worker. list gives the states of what
// it depends on and the live jobs it overlaps.
export fun specView(row: magus\Job, list: magus\JobList) > result\Result::<str> {
    final check = leaseCheckCommand(row.check, validation: row.validation);
    final goals = mut [<{str: any}>];
    final gates = mut [<str>];
    foreach (g in row.goals) {
        if (g.id != "check" and g.description != "") {
            goals.append({"id": g.id, "description": g.description});
        }
        if (leaseCheckCommand(g.check, validation: "") != "") {
            gates.append(g.id);
        }
    }
    if (gates.len() == 0 and check != "") {
        gates.append("check");
    }
    final evidence = mut [<{str: any}>];
    foreach (i, id in gates) {
        evidence.append({"id": id, "sep": if (i + 1 < gates.len()) "," else ""});
    }
    final deny = mut [<Deny>];
    foreach (p in row.denyPaths) {
        deny.append(Deny{ path = p, reason = "denied by the spec" });
    }
    final dependencies = dependencyLines(row, list: list);
    final overlaps = overlapLines(row, list: list);
    final data: {str: any} = {
        "id": row.id,
        "criteria": row.criteria,
        "hasGoals": goals.len() > 0,
        "goals": goals,
        "base": if (row.checkpoint == "") "The spec names no checkpoint." else "Your worktree must sit at checkpoint `{row.checkpoint}`.",
        "readOnly": row.readOnly,
        "writePaths": if (row.readOnly) [<str>] else row.writePaths,
        "denyLines": denyLines(deny),
        "readPaths": row.readPaths,
        "alone": dependencies.len() == 0 and overlaps.len() == 0,
        "dependencies": lineMaps(dependencies),
        "overlaps": lineMaps(overlaps),
        "check": check,
        "checkJSON": check.replace("\"", with: "\\\""),
        "resultSchema": "{RESULT_SCHEMA}",
        "changed": if (row.readOnly) "[]" else "[\"<every path you changed>\"]",
        "evidence": evidence,
    };
    try {
        return result\ok::<str>(template\render(SPEC, data: data).trim() + "\n");
    } catch (err: any) {
        return result\caught::<str>(err, doing: "job-view: render the spec of job {row.id}");
    }
}

// refLine is one ref a result cites, or what is owed or unrun instead.
fun refLine(label: str, ref: str, owed: str, unrun: str) > str {
    if (ref != "") {
        return "{label}: `{ref}`";
    }
    if (owed != "") {
        return "{label}: owed, {owed}";
    }
    if (unrun != "") {
        return "{label}: not run, {unrun}";
    }
    return "{label}: no ref filed";
}

// resultView renders the JobResult row's holder filed. A row with none is an
// error: `magus job wait` says when there is one.
export fun resultView(row: magus\Job) > result\Result::<str> {
    if (row.result == null) {
        return result\fail::<str>("job-view: job {row.id} has no filed result yet; `./magus job wait {row.id}` waits for one");
    }
    final r = row.result!;
    var validation = "- no check was filed";
    if (r.validation.command != "") {
        validation = refLine("- `{r.validation.command}`", ref: r.validation.outputRef, owed: r.validation.owed, unrun: r.validation.unrun);
    }
    final evidence = mut [<str>];
    foreach (e in r.verificationEvidence) {
        evidence.append(refLine("- gate `{e.gateID}`", ref: e.outputRef, owed: e.owed, unrun: e.unrun));
    }
    final data: {str: any} = {
        "id": row.id,
        "state": row.state.value,
        "observed": "{r.observedGeneration}",
        "generation": "{row.generation}",
        "changedPaths": r.changedPaths,
        "validation": validation,
        "hasEvidence": evidence.len() > 0,
        "evidence": evidence,
        "risks": r.unresolvedRisks,
        "hasFollowUps": r.followUps.len() > 0,
        "followUps": r.followUps,
    };
    try {
        return result\ok::<str>(template\render(RESULT, data: data).trim() + "\n");
    } catch (err: any) {
        return result\caught::<str>(err, doing: "job-view: render the result of job {row.id}");
    }
}

export fun main(args: [str]) > void !> any {
    final parsed = flags\parse(args, switches: ["--help", "--result"], valued: ["--job"]);
    if (parsed.values["--help"] != null) {
        std\print(HELP);
        return;
    }
    if (parsed.unknown.len() > 0 or parsed.positionals.len() > 0) {
        throw "job-view: unknown {parsed.unknown.join(" ")}{parsed.positionals.join(" ")}\n{USAGE}";
    }
    final id = parsed.values["--job"] ?? "";
    if (id == "") {
        throw "job-view: --job is required\n{USAGE}";
    }
    final row = magus\job(id);
    var view = resultView(row);
    if (parsed.values["--result"] == null) {
        view = specView(row, list: magus\workspace().jobs());
    }
    if (view.error != null) {
        throw view.error!.message;
    }
    std\print(view.value!.trim());
}

// fixtureRow is the spec the golden view is rendered from.
export fun fixtureRow() > magus\Job {
    final check = magus\LeaseCheck{ target = "go::go-test", project = ".", args = ["-run", "Quote|Shell"] };
    return magus\Job{
        id = "guard-shell-quoting",
        criteria = "magus shell judges a quoted pipe as one word; a regression test pins it",
        checkpoint = "7472f16fc709ab3827cd38ff281fecc0a217ca88",
        writePaths = ["internal/guard/quote.go", "internal/guard/quote_test.go"],
        denyPaths = ["internal/guard/guard.go", "run.go#probeOne", "run.go#buildStep"],
        readPaths = ["internal/guard", "docs/reference/rules"],
        dependsOn = ["guard-tokenizer", "guard-catalog"],
        check = check,
        goals = [
            magus\Goal{ id = "check", kind = magus\GoalKind.check, expect = magus\GoalExpect.passed, check = check },
            magus\Goal{ id = "docs-untouched", description = "docs/ stays as it is", kind = magus\GoalKind.paths,
                expect = magus\GoalExpect.absent, paths = ["docs/**"] },
        ],
        state = magus\JobState.declared,
    };
}

// fixtureList is the job list beside fixtureRow. One dependency passed and
// one runs; two live jobs overlap it, one of them measured.
export fun fixtureList() > magus\JobList {
    return magus\JobList{
        jobs = [
            magus\Job{ id = "guard-tokenizer", state = magus\JobState.pass },
            magus\Job{ id = "guard-catalog", state = magus\JobState.running },
        ],
        overlaps = [
            magus\JobOverlap{ jobA = "guard-shell-quoting", jobB = "guard-wide", pathsA = ["internal/guard/quote.go"], pathsB = ["internal/guard/**"],
                footprint = magus\JobOverlapFootprint{ verdict = "disjoint" } },
            magus\JobOverlap{ jobA = "guard-docs", jobB = "guard-shell-quoting", pathsA = ["internal/guard/*_test.go"], pathsB = ["internal/guard/quote_test.go"] },
        ],
    };
}

test "the fixture spec renders the golden view" {
    final want: [str] = json\parse(fs\readFile("hack/testdata/job-view-golden.json"));
    final got = specView(fixtureRow(), list: fixtureList()).value!.trim().split("\n");
    assert\equal(got, want: want, message: "spec view");
}

test "a check renders with its project and quoted tool args; a bare validation gets ./" {
    assert\equal(checkCommand("go::go-test", project: ".", args: ["-run", "Guard|Shell"], validation: ""),
        want: "./magus run go::go-test . --budget-wait 0 -- -run 'Guard|Shell'", message: "args");
    assert\equal(checkCommand("", project: "", args: [<str>], validation: "magus run conventions ."),
        want: "./magus run conventions .", message: "validation");
}

test "declaration claims are spelled out per file, grouped by reason" {
    assert\equal(denyLines([
        Deny{ path = "run.go#probeOne", reason = "owned by live lease a" },
        Deny{ path = "symbol.go", reason = "owned by live lease a" },
        Deny{ path = "run.go#buildStep", reason = "owned by live lease a" },
        Deny{ path = "go.mod", reason = "shared build input" },
    ]), want: [
        "- owned by live lease a: `symbol.go`, `run.go` (only the declarations `probeOne`, `buildStep`; the rest of the file is not claimed)",
        "- shared build input: `go.mod`",
    ], message: "deny");
}

test "a filed result renders its refs and what is owed" {
    final row = fixtureRow();
    final filed = magus\Job{ id = row.id, state = magus\JobState.pass, generation = 2,
        result = magus\JobResult{
            job = row.id,
            changedPaths = ["internal/guard/quote.go"],
            validation = magus\JobResultValidation{ command = "magus run go::go-test .", outputRef = "out1a2b3c" },
            verificationEvidence = [magus\VerificationEvidence{ gateID = "lint", owed = "no seat" }],
            unresolvedRisks = [<str>],
            observedGeneration = 2,
        } };
    final got = resultView(filed).value!;
    assert\equal(got.indexOf("- `magus run go::go-test .`: `out1a2b3c`") != null, want: true, message: "validation ref");
    assert\equal(got.indexOf("- gate `lint`: owed, no seat") != null, want: true, message: "owed gate");
    assert\equal(got.indexOf("## Unresolved risks\n\n- none") != null, want: true, message: "no risks");
}

test "a spec with no filed result has no result view" {
    assert\equal(resultView(fixtureRow()).error != null, want: true, message: "unfiled");
}

test "the same records render the same bytes" {
    assert\equal(specView(fixtureRow(), list: fixtureList()).value!, want: specView(fixtureRow(), list: fixtureList()).value!, message: "deterministic");
}
