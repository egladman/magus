final SUMMARY = "render a job's spec or its filed result as Markdown, never stored";
final SERVES = ["replaces:cat jobs.jsonl"];
final EFFECT = "read";

final USAGE = "usage: magus buzz hack/dev/job-view.buzz -- --job <id> [--result]";
final HELP = "cost: two job-store reads\n{USAGE}\n\n"
    + "Prints a view of job <id>: its spec for the worker by default, or with --result the JobResult its holder filed.\n"
    + "Both are rendered from the typed records (magus\\Job and magus\\JobResult) through the template module, at read\n"
    + "time: nothing is stored and nothing reads the Markdown back. Read-only; the same records render the same view.";

// RESULT_SCHEMA is the job result schema the spec's skeleton is written to.
// `./magus job exit --schema` prints the shape a binary accepts.
final RESULT_SCHEMA = 2;
final WORD = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._/:=,+@%-";

// The templates switch Mustache's delimiters to <% %>, so a Buzz string
// needs no escaped braces. <%& x %> is an unescaped value.
final SPEC = [
    "\{\{=<% %>=\}\}# Job <%& id %>",
    "",
    "The spec: `./magus describe job <%& id %>`. It is the record; this view is rendered from it and never stored.",
    "",
    "## Criteria",
    "",
    "<%& criteria %>",
    "<%#hasGoals%>",
    "",
    "<%/hasGoals%>",
    "<%#goals%>",
    "- goal `<%& id %>`: <%& description %>",
    "<%/goals%>",
    "",
    "## Setup",
