import "std";
import "result";

fun parsePort(text: str) > result\Result::<int> {
    final port = std\parseInt(text);
    if (port == null) {
        return result\fail::<int>("invalid port: {text}");
    }
    if (port! < 1 or port! > 65535) {
        return result\fail::<int>("out of range: {text}");
    }
    return result\ok::<int>(port!);
}

fun main(args: [str]) > void {
    foreach (text in ["80", "x", "70000"]) {
        final parsed = parsePort(text);
        if (parsed.error != null) {
            std\print("error: {parsed.error!.message}");
        } else {
            std\print("port {parsed.value!}");
        }
    }
}
