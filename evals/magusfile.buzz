import "magus";
// The shared advisory gate; see tools/audit.buzz for why an exit code is the wrong question.
import "../tools/audit" as audit;
import "fs";
import "os";


// The skill-eval harness. Measures whether an installed skill actually changes
// agent behaviour, per permutation and per model, instead of leaving that to
// judgement. Live model runs are opt-in: `ci` is lint-only so `magus affected ci`
// stays offline and keyless.
magus\project({
    "sources": ["magusfile.buzz", "*.buzz",
                "tasks/**/*.yaml", "lib/**/*.mjs", "tools/**/*.mjs",
                "promptfooconfig.*.yaml",
                "fixtures/*/.gitkeep", "README.md", ".gitignore", ".npmrc", "package.json", "pnpm-lock.yaml",
                "pnpm-workspace.yaml"],
    // fixtures/*/.claude is rendered by render-fixtures, never committed: a
    // committed snapshot drifts the moment a skill changes (it happened - the
    // tree hit skill-version 23 while the fixtures still carried 22, minus a
    // whole skill), and a benchmark of stale content measures nothing.
    "outputs": ["results/**", "fixtures/*/.claude/**"],
    "no_language": "promptfoo harness: yaml tasks and .mjs libs/tools; no single language pack describes it, and the work runs through promptfoo rather than a toolchain",
    "targets": {
        "security": {"skip_cache": "reads the npm advisory database, which changes independently of this tree"},
        "analyze": {"skip_cache": "reads run output under results/, which is a declared output rather than a source"},
        "measure": {"skip_cache": "renders the repo-root skill sources through magus agent install, which live outside this project's sources"},
        "render-fixtures": {"skip_cache": "renders the skills embedded in the running binary, which no source fingerprint covers"},
        // These targets deliberately produce no result artifact. The live smoke
        // and grid targets retain the project output snapshot.
    },
});

export fun preflight(ctx: magus\Context, args: [str]) > void { install(); }

// pnpm, NOT npm: .npmrc's minimum-release-age supply-chain gate is the reason.
// Always let pnpm validate the install. A canceled install can leave a
// node_modules directory that exists but is incomplete, so isDir alone is not a
// valid readiness check.
fun install() > void {
    if (fs\isFile("pnpm-lock.yaml")) {
        os\exec("pnpm", ["install", "--frozen-lockfile"], ".", {});
    } else {
        // The first bootstrap establishes the committed lock. Every later
        // install is frozen, so CI cannot resolve a newer dependency graph.
        os\exec("pnpm", ["install"], ".", {});
    }
}

// lint validates every task file against the schema and checks that each named
// constraint predicate exists. No network, no API key.
export fun lint(ctx: magus\Context, args: [str]) > void {
    ctx.needs(preflight);
    os\exec("pnpm", ["run", "lint"], ".", {});
}

// MUTED 2026-08-03. smoke and grid are the only targets that call promptfoo and
// spend money on live model runs; they are commented out rather than deleted so the
// tasks, constraints, and lint gate keep working and this comes back by uncommenting.
// The weekly cron in .github/workflows/skill-evals.yaml is disabled to match.
//
// The key is resolved through magus\secret.read rather than letting promptfoo read
// ambient environment: resolving teaches magus the value, so anything promptfoo or a
// failing provider echoes back is redacted from captured output, and os\withEnv
// scopes the variable to this one command. In CI the workflow env block maps the
// repository secret onto ANTHROPIC_API_KEY, which is exactly what the built-in
// provider reads; on a laptop export the variable or select a provider spell.
