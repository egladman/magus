// security audits what actually ships against the npm advisory database. See
// console/magusfile.buzz for why it is --prod, why it is not folded into lint, and why the
// .npmrc cooling period is the stronger half of this.
export fun security(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(preflight);
    audit.audit();
}

// ci is LINT ONLY, deliberately. Live runs need credentials that CI does not have, and a
// keyless environment must not fail this gate.
//
// security is NOT wired in here either, and that is the same judgment the audit gate makes
// about a finding it cannot act on. Every high in this tree is transitive through promptfoo
// (mathjs, sharp, drizzle-orm) - packages this project does not depend on directly and
// cannot upgrade without overriding another tool's dependency graph. Attempting it cascades
// into a rollup build the cooling period blocks, so the "fix" does not install either.
// Run `magus run security evals` deliberately to see the report; do not gate CI on a tree
// this project does not own.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint);
}
