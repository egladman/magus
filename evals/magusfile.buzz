// render-fixtures writes the two permutation workspaces promptfoo points its
// agents at. Rendered fresh per run rather than committed, so the eval always
// measures the skills this tree actually ships. The renderer is the running
// binary for the same reason as measure: the embedded skills live in the
// binary, and a stale PATH magus would silently render last-generation content.
export fun render_fixtures(ctx: magus\Context, args: [str]) > void {
    final bin = os\executable();
    os\exec(bin, args: ["agent", "install", "--dir", "fixtures/full", "--force", ".claude/skills"], dir: ".");
    os\exec(bin, args: ["agent", "install", "--dir", "fixtures/simple", "--force", "--simple", ".claude/skills"], dir: ".");
}

// analyze reduces a results file to the paired full-vs-simple comparison table.
// No network, no API key; it reads what smoke or grid already wrote.
export fun analyze(ctx: magus\Context, args: [str]) > void {
    var results = "results/smoke.json";
    if (args.len() > 0) { results = args[0]; }
    os\exec("node", args: ["tools/analyze.mjs", results], dir: ".");
}

// measure reports compression stats for the embedded skills by rendering both
// permutations through `magus agent install`. Pass --json to regenerate the
// committed baseline snapshot.
export fun measure(ctx: magus\Context, args: [str]) > void {
    // The embedded skills live in the binary, so the renderer must be the same
    // magus that runs this target - a stale PATH magus would silently measure
    // content that does not match this tree.
    os\withEnv({"MAGUS_BIN": os\executable()}, fun () > void {
        os\exec("node", args: ["tools/measure_skills.mjs"] + args, dir: ".");
    });
}

// security audits what actually ships against the npm advisory database. See
// console/magusfile.buzz for why it is --prod, why it is not folded into lint, and why the
// .npmrc cooling period is the stronger half of this.
export fun security(ctx: magus\Context, args: [str]) > void {
    ctx.needs(preflight);
    audit.audit();
}

// ci is LINT ONLY, deliberately. Live runs need credentials that CI does not have, and a
// keyless environment must not fail this gate.
//
// security is NOT wired in here either, and that is the same judgment the audit gate makes
// about a finding it cannot act on. Every high in this tree is transitive through promptfoo
// (mathjs, sharp, drizzle-orm) - packages this project does not depend on directly and
// cannot upgrade without overriding another tool's dependency graph. Attempting it cascades
// into a rollup build the cooling period blocks, so the "fix" does not install either.
// Run `magus run security evals` deliberately to see the report; do not gate CI on a tree
// this project does not own.
export fun ci(ctx: magus\Context, args: [str]) > void {
    ctx.needs(lint);
}
