import "magus";
import "proc";
// The shared advisory gate; see tools/audit.buzz for why an exit code is the wrong question.
import "../tools/audit" as audit;
import "fs";
import "os";


import "proc";
// The skill-eval harness. Measures whether an installed skill actually changes
// agent behaviour, per permutation and per model, instead of leaving that to
// judgement. Live model runs are opt-in: `ci` is lint-only so `magus affected ci`
// stays offline and keyless.
magus\project({
    "sources": ["*.buzz",
                "tasks/**/*.yaml", "lib/**/*.mjs", "tools/**/*.mjs", "tools/**/*.py",
                "promptfooconfig.*.yaml",
                "fixtures/**", "README.md", ".gitignore", ".npmrc", "package.json", "pnpm-lock.yaml",
                "pnpm-workspace.yaml"],
    "outputs": ["results/**"],
    "no_language": "polyglot harness: promptfoo yaml tasks, .mjs libs, .py analysis tools; no single language pack describes it, and the work runs through promptfoo rather than a toolchain",
    "targets": {
        "security": {"skip_cache": "reads the npm advisory database, which changes independently of this tree"},
        // These targets deliberately produce no result artifact. The live smoke
        // and grid targets retain the project output snapshot.
    },
});

export fun preflight(ctx: magus\Context, args: [str]) > void !> any { install(); }

// pnpm, NOT npm: .npmrc's minimum-release-age supply-chain gate is the reason.
// Always let pnpm validate the install. A canceled install can leave a
// node_modules directory that exists but is incomplete, so isDir alone is not a
// valid readiness check.
fun install() > void !> any {
    if (fs\isFile("pnpm-lock.yaml")) {
        proc\exec("pnpm", ["install", "--frozen-lockfile"], ".", {});
    } else {
        // The first bootstrap establishes the committed lock. Every later
        // install is frozen, so CI cannot resolve a newer dependency graph.
        proc\exec("pnpm", ["install"], ".", {});
    }
}

// lint validates every task file against the schema and checks that each named
// constraint predicate exists. No network, no API key.
export fun lint(ctx: magus\Context, args: [str]) > void !> any {
    ctx.needs(preflight);
    proc\exec("pnpm", ["run", "lint"], ".", {});
}

